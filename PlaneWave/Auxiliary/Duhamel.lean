import PlaneWave.Certificate

/-!
# Auxiliary claims, part 3: the Duhamel identity (eq:duhamel)

* `duhamel_eq` (abstract): if `U` is the unitary group of a symmetric `T`
  (`d/dt U t x = -i U t (T x)`) and `a' = -i (T a + r)` with `r` continuous, then
  `a t - U t (a 0) = -i ∫₀ᵗ U (t - s) (r s) ds`;
* **`coulomb_duhamel_eq`** (`prop:duhamel`, eq:duhamel): for the propagator `U` of the periodic
  Coulomb system, a Galerkin propagator `U_N = e^{-i H_N t}` of the cube `n` and `u₀ ∈ D(H²)`,
  `η(t) = P ψ(t) - U_N(t) P ψ₀ = -i ∫₀ᵗ U_N(t - s) P W (1 - P) ψ(s) ds`, `ψ(t) = U t (S u₀)`;
  the integrand is continuous, and at every `s` it is `P W (1 - P) u'` for the `H²` representative
  `u'` of `ψ(s)`.

The norm bound `‖η(t)‖ ≤ t sup_s ‖P W (1 - P) ψ(s)‖` is `coulomb_duhamel` of the release.
-/

set_option autoImplicit false

open scoped InnerProductSpace ComplexConjugate Topology
open Filter Set

namespace PlaneWaveDynamics

section Generic

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

omit [CompleteSpace V] in
/-- The orbit `s ↦ U (f s) (r s)` of a strongly continuous family of isometries along continuous
`f` and `r` is continuous. -/
lemma continuous_isometry_apply (U : ℝ → V ≃ₗᵢ[ℂ] V) (hU : ∀ x, Continuous fun t => U t x)
    {f : ℝ → ℝ} (hf : Continuous f) {r : ℝ → V} (hr : Continuous r) :
    Continuous fun s => U (f s) (r s) := by
  rw [Metric.continuous_iff]
  intro s₀ ε hε
  have h1 := Metric.continuous_iff.mp ((hU (r s₀)).comp hf) s₀ (ε / 2) (by positivity)
  have h2 := Metric.continuous_iff.mp hr s₀ (ε / 2) (by positivity)
  obtain ⟨δ₁, hδ₁, hb₁⟩ := h1
  obtain ⟨δ₂, hδ₂, hb₂⟩ := h2
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun s hs => ?_⟩
  have hs₁ : dist s s₀ < δ₁ := lt_of_lt_of_le hs (min_le_left _ _)
  have hs₂ : dist s s₀ < δ₂ := lt_of_lt_of_le hs (min_le_right _ _)
  have e1 : dist (U (f s) (r s)) (U (f s) (r s₀)) = dist (r s) (r s₀) := by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, LinearIsometryEquiv.norm_map]
  calc dist (U (f s) (r s)) (U (f s₀) (r s₀))
      ≤ dist (U (f s) (r s)) (U (f s) (r s₀)) + dist (U (f s) (r s₀)) (U (f s₀) (r s₀)) :=
        dist_triangle _ _ _
    _ < ε / 2 + ε / 2 := by
        rw [e1]
        exact add_lt_add (hb₂ s hs₂) (hb₁ s hs₁)
    _ = ε := by ring

/-- **The Duhamel identity.** Let `U` be a unitary group generated by the symmetric `T`
(`d/dt U t x = -i U t (T x)`, `U t T = T U t`), and let `a` solve `a' = -i (T a + r)` with `r`
continuous. Then `a t - U t (a 0) = -i ∫₀ᵗ U (t - s) (r s) ds`. -/
theorem duhamel_eq {T : V →ₗ[ℂ] V} (hT : T.IsSymmetric) (U : ℝ → V ≃ₗᵢ[ℂ] V)
    (h0 : ∀ x, U 0 x = x) (hadd : ∀ s t x, U (s + t) x = U s (U t x))
    (hcomm : ∀ t x, U t (T x) = T (U t x))
    (hderiv : ∀ t x, HasDerivAt (fun s => U s x) (-(Complex.I • U t (T x))) t)
    {a r : ℝ → V} (ha : ∀ s, HasDerivAt a (-(Complex.I • (T (a s) + r s))) s)
    (hr : Continuous r) (t : ℝ) :
    a t - U t (a 0) = -(Complex.I • ∫ s in (0 : ℝ)..t, U (t - s) (r s)) := by
  have hU : ∀ x, Continuous fun s => U s x := fun x =>
    continuous_iff_continuousAt.mpr fun s => (hderiv s x).continuousAt
  have hinv : ∀ s x, U (-s) (U s x) = x := fun s x => by rw [← hadd, neg_add_cancel, h0]
  have hinv' : ∀ s x, U s (U (-s) x) = x := fun s x => by rw [← hadd, add_neg_cancel, h0]
  -- the integrand `f s = U (-s) (r s)`
  set f : ℝ → V := fun s => U (-s) (r s) with hf
  have hfc : Continuous f := continuous_isometry_apply U hU continuous_neg hr
  -- the weak form
  have hweak : ∀ w : V, ⟪w, U (-t) (a t) - a 0⟫_ℂ =
      ⟪w, -(Complex.I • ∫ s in (0 : ℝ)..t, f s)⟫_ℂ := by
    intro w
    set G : ℝ → ℂ := fun s => ⟪U s w, a s⟫_ℂ with hG
    have hGd : ∀ s, HasDerivAt G (-(Complex.I * ⟪U s w, r s⟫_ℂ)) s := by
      intro s
      have h := (hderiv s w).inner ℂ (ha s)
      have e : ⟪U s w, -(Complex.I • (T (a s) + r s))⟫_ℂ + ⟪-(Complex.I • U s (T w)), a s⟫_ℂ =
          -(Complex.I * ⟪U s w, r s⟫_ℂ) := by
        rw [inner_neg_left, inner_smul_left, inner_neg_right, inner_smul_right, inner_add_right,
          hcomm, ← hT, Complex.conj_I]
        ring
      rw [e] at h
      exact h
    have hshift : ∀ s, ⟪U s w, r s⟫_ℂ = ⟪w, f s⟫_ℂ := by
      intro s
      rw [hf]
      dsimp only
      rw [← LinearIsometryEquiv.inner_map_map (U (-s)) (U s w) (r s), hinv]
    have hgc : Continuous fun s => -(Complex.I * ⟪w, f s⟫_ℂ) :=
      (continuous_const.mul (continuous_const.inner hfc)).neg
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := t)
      (f := G) (f' := fun s => -(Complex.I * ⟪w, f s⟫_ℂ))
      (fun s _ => by rw [← hshift]; exact hGd s) (hgc.intervalIntegrable 0 t)
    have hint : ∫ s in (0 : ℝ)..t, -(Complex.I * ⟪w, f s⟫_ℂ) =
        ⟪w, -(Complex.I • ∫ s in (0 : ℝ)..t, f s)⟫_ℂ := by
      rw [intervalIntegral.integral_neg, intervalIntegral.integral_const_mul, inner_neg_right,
        inner_smul_right]
      congr 2
      have := (innerSL ℂ w).intervalIntegral_comp_comm (hfc.intervalIntegrable (μ := MeasureTheory.volume) 0 t)
      simpa only [innerSL_apply_apply] using this
    have hGt : G t - G 0 = ⟪w, U (-t) (a t) - a 0⟫_ℂ := by
      simp only [hG, h0]
      rw [inner_sub_right, ← LinearIsometryEquiv.inner_map_map (U (-t)) (U t w) (a t), hinv]
    rw [← hGt, ← hftc, hint]
  have hkey : U (-t) (a t) - a 0 = -(Complex.I • ∫ s in (0 : ℝ)..t, f s) :=
    ext_inner_left ℂ hweak
  -- apply `U t`
  have hcomm_int : U t (∫ s in (0 : ℝ)..t, f s) = ∫ s in (0 : ℝ)..t, U (t - s) (r s) := by
    have := (U t).toLinearIsometry.toContinuousLinearMap.intervalIntegral_comp_comm
      (hfc.intervalIntegrable (μ := MeasureTheory.volume) 0 t)
    simp only [LinearIsometry.coe_toContinuousLinearMap, LinearIsometryEquiv.coe_toLinearIsometry]
      at this
    rw [← this]
    refine intervalIntegral.integral_congr fun s _ => ?_
    simp only [hf]
    rw [← hadd, sub_eq_add_neg]
  calc a t - U t (a 0) = U t (U (-t) (a t) - a 0) := by rw [map_sub, hinv']
    _ = U t (-(Complex.I • ∫ s in (0 : ℝ)..t, f s)) := by rw [hkey]
    _ = -(Complex.I • ∫ s in (0 : ℝ)..t, U (t - s) (r s)) := by
        rw [map_neg, map_smul, hcomm_int]

end Generic

section Galerkin

open PlaneWaveCertificate

variable {eta : ℕ} {ν : Type} [Fintype ν]
variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)

include hKernel in
/-- **The Duhamel identity for a periodic Coulomb system** (`prop:duhamel`, eq:duhamel). Let `U` be
the propagator of `exists_coulombFourierPropagator`, `U_N` a propagator of the finite Hamiltonian
`H_N` of the cube `n` (`exists_finitePropagator`) and `u₀ ∈ H²`, `ψ(t) = U t (S u₀)`. There is a
continuous `r` with `r s = P W (1 - P) u'` for every `H²` representative `u'` of `ψ(s)`, and
`P ψ(t) - U_N(t) P ψ₀ = -i ∫₀ᵗ U_N(t - s) r(s) ds`. -/
theorem coulomb_duhamel_eq (n : ℕ)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hcont : ∀ x, Continuous fun t => U t x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (u₀ : MolecularFourierH2 eta) :
    ∃ r : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)), Continuous r ∧
      (∀ s (u' : MolecularFourierH2 eta),
        molecularH2StateMap eta (2 * Real.pi / L) u' =
          U s (molecularH2StateMap eta (2 * Real.pi / L) u₀) →
        r s = extractCLM n (coulombFourierPotentialH2 sys (2 * Real.pi / L) H
          (u' - molecularH2Truncate n u'))) ∧
      ∀ t, extractCLM n (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) -
          UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀)) =
        -(Complex.I • ∫ s in (0 : ℝ)..t, UN (t - s) (r s)) := by
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set W := coulombFourierPotentialH2 sys (2 * Real.pi / L) H
  set HN := finiteCoulombHamiltonian sys L n
  choose u hu1 hu2 using fun s => hgraph s u₀
  set r : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) :=
    fun s => extractCLM n (U s (H u₀)) - HN (extractCLM n (U s (S u₀))) with hrdef
  have hrW : ∀ s, r s = extractCLM n (W (u s - molecularH2Truncate n (u s))) := by
    intro s
    have h := extract_H_eq sys L H hKernel n (u s)
    rw [hu2 s, hu1 s] at h
    simp only [hrdef]
    rw [h]
    abel
  have hrc : Continuous r := by
    have h1 : Continuous fun s => extractCLM n (U s (H u₀)) :=
      (extractCLM n).continuous.comp (hcont (H u₀))
    have h2 : Continuous fun s => HN (extractCLM n (U s (S u₀))) :=
      (LinearMap.continuous_of_finiteDimensional HN).comp
        ((extractCLM n).continuous.comp (hcont (S u₀)))
    exact h1.sub h2
  refine ⟨r, hrc, fun s u' hu' => ?_, fun t => ?_⟩
  · have : u' = u s := molecularH2StateMap_injective eta (2 * Real.pi / L) (hu'.trans (hu1 s).symm)
    rw [this, hrW s]
  · set a : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) :=
      fun s => extractCLM n (U s (S u₀))
    have ha : ∀ s, HasDerivAt a (-(Complex.I • (HN (a s) + r s))) s := by
      intro s
      have h1 := ((extractCLM n).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt s (hderiv s u₀)
      have e : ((extractCLM n).restrictScalars ℝ) (-(Complex.I • U s (H u₀))) =
          -(Complex.I • (HN (a s) + r s)) := by
        rw [ContinuousLinearMap.coe_restrictScalars', map_neg, map_smul, hrW s, ← hu2 s,
          extract_H_eq sys L H hKernel n (u s), hu1 s]
      rw [e] at h1
      exact h1
    have h := duhamel_eq (finiteCoulombHamiltonian_isSymmetric sys L n) UN hN0 hNadd hNcomm
      hNderiv ha hrc t
    simpa [a, h0] using h

end Galerkin

end PlaneWaveDynamics
