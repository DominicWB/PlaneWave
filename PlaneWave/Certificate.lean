        lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
      (∀ N u q, H (molecularH2Truncate N u) q =
        fourierCubeKernelAction g kernel N u q) ∧
      (∀ u, ‖H u‖ ≤ C * ‖u‖) := by
  classical
  let S := lp2CoordinateCore (FourierConfig eta Lattice3)
  have hFixed : ∀ z : S, ∃ N, molecularH2Truncate N (z : MolecularFourierH2 eta) = z := by
    intro z
    have hz : (z : MolecularFourierH2 eta) ∈
        lp2CoordinateCore (FourierConfig eta Lattice3) := z.property
    exact exists_molecularH2Truncate_eq_of_mem_coordinateCore
      (eta := eta) (z : MolecularFourierH2 eta) hz
  choose cutoff hCutoff using hFixed
  choose output hOutput using hCore
  let AFun : S → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
    fun z => output (cutoff z) (z : MolecularFourierH2 eta)
  have hCoord (z : S) (N : ℕ) (u : MolecularFourierH2 eta)
      (hz : molecularH2Truncate N u = (z : MolecularFourierH2 eta))
      (q : FourierConfig eta Lattice3) :
      AFun z q = fourierCubeKernelAction g kernel N u q := by
    change output (cutoff z) (z : MolecularFourierH2 eta) q = _
    rw [(hOutput (cutoff z) (z : MolecularFourierH2 eta)).1 q]
    exact congrFun (fourierCubeKernelAction_eq_of_truncate_eq g kernel
      (cutoff z) N (z : MolecularFourierH2 eta) u
      ((hCutoff z).trans hz.symm)) q
  have hAdd (z w : S) : AFun (z + w) = AFun z + AFun w := by
    let N := max (cutoff z) (cutoff w)
    have hz : molecularH2Truncate N (z : MolecularFourierH2 eta) = z :=
      molecularH2Truncate_eq_of_le (cutoff z) N (le_max_left _ _)
        (z : MolecularFourierH2 eta) (hCutoff z)
    have hw : molecularH2Truncate N (w : MolecularFourierH2 eta) = w :=
      molecularH2Truncate_eq_of_le (cutoff w) N (le_max_right _ _)
        (w : MolecularFourierH2 eta) (hCutoff w)
