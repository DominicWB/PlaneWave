-- BEGIN RELEASE SOURCE 148a: position space, exchange sectors and kinetic energy
section ReleaseMilestone148a

/-!
# Milestone 148a: position space, exchange sectors and the kinetic energy

The Galerkin bridge of a Coulomb system on the torus `L²` space, its exchange sectors as
almost-everywhere sign identities, and the mass-weighted kinetic energy: the completed
operator on the `H²` domain, its classical coordinate form, and the weak kinetic equations
tested against Fourier polynomials, coordinate `C²` tests and `ContDiff` tests (milestones
131--136 for a general system).
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology BigOperators ComplexConjugate

noncomputable section

variable {eta : ℕ} {ν : Type*} [Fintype ν]

local instance unitAddCircleMeasureSpaceForCoulombPosition148a :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

local instance unitAddCircleProbabilityMeasureForCoulombPosition148a :
    IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  instIsProbabilityMeasureUnitAddCircleVolume

local instance molecularPositionTorusFiniteMeasureForCoulombPosition148a (eta : ℕ) :
    IsFiniteMeasure (volume : Measure (MolecularPositionTorus eta)) := by
  infer_instance

/-! ## Exchange sectors on the torus -/

/-- Coordinate exchange multiplies an `L²` class by `c` exactly when the coordinate
identity holds almost everywhere. -/
theorem molecularPositionSwapLp_eq_smul_iff (i j : Fin eta) (c : ℂ)
    (f : MolecularPositionL2 eta) :
    molecularPositionSwapLp i j f = c • f ↔
      ∀ᵐ x ∂(volume : Measure (MolecularPositionTorus eta)),
        f (molecularPositionSwap i j x) = c * f x := by
  constructor
  · intro h
    filter_upwards [molecularPositionSwapLp_coeFn i j f,
      MeasureTheory.Lp.coeFn_smul c f] with x hx hSmul
    rw [h] at hx
    exact hx.symm.trans hSmul
  · intro h
    apply MeasureTheory.Lp.ext
    filter_upwards [molecularPositionSwapLp_coeFn i j f,
      MeasureTheory.Lp.coeFn_smul c f, h] with x hx hSmul hSwap
    exact hx.trans (hSwap.trans hSmul.symm)

/-- The exchange sector `lab` with signs `sgn` on the torus: exchanging two distinct
particles with equal labels multiplies the wavefunction by the sign of the particle,
almost everywhere. -/
def IsPositionSector (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ)
    (f : MolecularPositionL2 eta) : Prop :=
  ∀ i j : Fin eta, i ≠ j → lab i = lab j →
    ∀ᵐ x ∂(volume : Measure (MolecularPositionTorus eta)),
      f (molecularPositionSwap i j x) = sgn i * f x

/-- Antisymmetry is the sector with every sign `-1`. -/
lemma isPositionFermionic_iff_isPositionSector (lab : Fin eta → ℕ)
    (f : MolecularPositionL2 eta) :
    IsPositionFermionic lab f ↔ IsPositionSector (fun _ => -1) lab f := by
  constructor
  · intro h i j hij hlab
    filter_upwards [h i j hij hlab] with x hx
    rw [hx, neg_one_mul]
  · intro h i j hij hlab
    filter_upwards [h i j hij hlab] with x hx
    rw [hx, neg_one_mul]

/-- The position sector is exactly the Fourier sector of the coefficients, for every
`L²` state. -/
theorem molecularPosition_sector_iff (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ)
    (f : MolecularPositionL2 eta) :
    IsPositionSector sgn lab f ↔
      IsSectorCoeff sgn lab (fun p => (molecularPositionSynthesis eta).symm f p) := by
  constructor
  · intro hS i j hij hlab p
    have hSwap := (molecularPositionSwapLp_eq_smul_iff i j (sgn i) f).mpr (hS i j hij hlab)
    calc
      (molecularPositionSynthesis eta).symm f (swapConfig i j p) =
          (molecularPositionSynthesis eta).symm (molecularPositionSwapLp i j f) p :=
        (molecularPositionSwapLp_fourier i j f p).symm
      _ = (molecularPositionSynthesis eta).symm (sgn i • f) p :=
        congrArg (fun v : MolecularPositionL2 eta =>
          (molecularPositionSynthesis eta).symm v p) hSwap
      _ = sgn i * ((molecularPositionSynthesis eta).symm f p) := by
        rw [map_smul]
        rfl
  · intro hS i j hij hlab
    apply (molecularPositionSwapLp_eq_smul_iff i j (sgn i) f).mp
    apply (molecularPositionSynthesis eta).symm.injective
    apply lp.ext
    funext p
    rw [molecularPositionSwapLp_fourier, map_smul]
    exact hS i j hij hlab p

/-! ## The Galerkin bridge on the torus -/

/-- The Galerkin bridge of a Coulomb system on the torus `L²` space, transported by
the Fourier synthesis unitary. -/
def coulombPositionGalerkinBridge (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ) (L : ℝ)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q) :
    ContinuumCoulombGalerkinBridge sys lab L (MolecularPositionL2 eta)
      (molecularPositionH2Domain eta (2 * Real.pi / L)) :=
  continuumCoulombGalerkinBridge_unitaryTransport
    (coulombFourierGalerkinBridge sys lab L hL H hKernel) (molecularPositionSynthesis eta)

/-- The sector of the torus bridge is the almost-everywhere sign identity. -/
theorem coulombPositionGalerkinBridge_sector_iff (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (f : MolecularPositionL2 eta) :
    (coulombPositionGalerkinBridge sys lab L hL H hKernel).sector f ↔
      IsPositionSector sys.sign lab f := by
  change IsSectorCoeff sys.sign lab (fun p => (molecularPositionSynthesis eta).symm f p) ↔ _
  exact (molecularPosition_sector_iff sys.sign lab f).symm

/-- The ground state and the cubic Ritz theorem on the torus `L²` space. -/
theorem coulomb_position_cubic_error (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ∃ H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
    ∃ hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
        fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q,
      (∀ u, ‖H u‖ ≤ ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) * ‖u‖) ∧
      ∃ E : ℝ, ∃ psi : molecularPositionH2Domain eta (2 * Real.pi / L),
        HasContinuumSectorGroundPair (coulombPositionGalerkinBridge sys lab L hL H hKernel)
          psi E ∧
        ∀ K rho Blow Cs Bker : ℝ,
          1 ≤ K → 0 ≤ rho → rho ^ 2 * K = 1 →
          0 ≤ Blow → 0 ≤ Cs → 0 ≤ Bker →
          2 * (2 * Real.pi / L) ≤ K →
          54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L) →
          432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2 →
          1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2 →
          4 * sys.maxMass * (|E| + 1) ≤ K ^ 2 →
          32 * sys.massMoment 2 *
            (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
              (continuumCoulombH2Constant sys E L Hunit)) ^ 2 ≤ K ^ 5 →
          ∀ m : ℕ, 1 ≤ m → K * L = 2 * Real.pi * (m : ℝ) →
            eta ≤ (2 * m + 1) ^ 3 →
          ∃ EN : ℝ, IsContinuumSectorCubicGroundEnergy
            (coulombPositionGalerkinBridge sys lab L hL H hKernel) K EN ∧
            (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
            0 ≤ EN - E ∧
            EN - E ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ∧
            continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ≤
              ((3 * L / (2 * Real.pi)) ^ 3 *
                continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker) /
                (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨H, hKernel, hNorm, E, psi, hPair, hCubic⟩ :=
    coulomb_fourier_cubic_error sys lab hlab L Hunit hL hPeriodic
  refine ⟨H, hKernel, hNorm, E,
    molecularPositionDomainEquiv eta (2 * Real.pi / L) psi, ?_, ?_⟩
  · exact (hasContinuumSectorGroundPair_unitaryTransport_iff
      (coulombFourierGalerkinBridge sys lab L hL H hKernel)
      (molecularPositionSynthesis eta) psi E).mpr hPair
  · intro K rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK
      hAmplitude hBkerScale hCsScale hAbsorb hLargeK m hm hCutoff hEnough
    obtain ⟨EN, hEN, hCount, hLower, hRate, hBasisRate⟩ :=
      hCubic K rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK
        hAmplitude hBkerScale hCsScale hAbsorb hLargeK m hm hCutoff hEnough
    refine ⟨EN, ?_, hCount, hLower, hRate, hBasisRate⟩
    exact (isContinuumSectorCubicGroundEnergy_unitaryTransport_iff
      (coulombFourierGalerkinBridge sys lab L hL H hKernel)
      (molecularPositionSynthesis eta) K EN).mpr hEN

/-! ## The mass-weighted kinetic energy -/

/-- The kinetic energy `(1/2) Σ_a g² |p_a|² / m_a` of a many-particle reciprocal mode. -/
def coulombKineticEnergySymbol (sys : CoulombSystem eta ν) (g : ℝ)
    (p : FourierConfig eta Lattice3) : ℝ :=
  (1 / 2 : ℝ) * ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i

omit [Fintype ν] in
lemma coulombKineticEnergySymbol_nonneg (sys : CoulombSystem eta ν) (g : ℝ)
    (p : FourierConfig eta Lattice3) : 0 ≤ coulombKineticEnergySymbol sys g p := by
  unfold coulombKineticEnergySymbol
  apply mul_nonneg (by norm_num)
  apply Finset.sum_nonneg
  intro i _hi
  exact div_nonneg (mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg (p i)))
    (sys.mass_pos i).le

omit [Fintype ν] in
/-- Twice the kinetic energy is at most the `H²` weight minus one: every mass is at
least one. -/
lemma two_mul_coulombKineticEnergySymbol_le (sys : CoulombSystem eta ν) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    2 * coulombKineticEnergySymbol sys g p ≤ molecularFourierH2Weight eta g p - 1 := by
  unfold coulombKineticEnergySymbol molecularFourierH2Weight
  have hTerm : ∀ i ∈ (Finset.univ : Finset (Fin eta)),
      g ^ 2 * latticeNormSq (p i) / sys.mass i ≤ g ^ 2 * latticeNormSq (p i) := by
    intro i _hi
    exact div_le_self (mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg (p i)))
      (sys.one_le_mass i)
  have hSum := Finset.sum_le_sum hTerm
  linarith

omit [Fintype ν] in
/-- The `H²` weight is controlled by the kinetic energy and the largest mass. -/
lemma molecularFourierH2Weight_le_maxMass_mul (sys : CoulombSystem eta ν) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    molecularFourierH2Weight eta g p ≤
      sys.maxMass * (1 + 2 * coulombKineticEnergySymbol sys g p) := by
  have hM := sys.one_le_maxMass
  have hTerm : ∀ i ∈ (Finset.univ : Finset (Fin eta)),
      g ^ 2 * latticeNormSq (p i) ≤
        sys.maxMass * (g ^ 2 * latticeNormSq (p i) / sys.mass i) := by
    intro i _hi
    have hm := sys.mass_pos i
    have hx : 0 ≤ g ^ 2 * latticeNormSq (p i) :=
      mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg (p i))
    rw [mul_div_assoc', le_div_iff₀ hm]
    calc
      g ^ 2 * latticeNormSq (p i) * sys.mass i ≤
          g ^ 2 * latticeNormSq (p i) * sys.maxMass :=
        mul_le_mul_of_nonneg_left (sys.mass_le_maxMass i) hx
      _ = sys.maxMass * (g ^ 2 * latticeNormSq (p i)) := by ring
  have hSum : (∑ i : Fin eta, g ^ 2 * latticeNormSq (p i)) ≤
      sys.maxMass * ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum hTerm
  have hExpand : sys.maxMass * (1 + 2 * ((1 / 2 : ℝ) *
      ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i)) =
      sys.maxMass + sys.maxMass * ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i := by
    ring
  unfold molecularFourierH2Weight coulombKineticEnergySymbol
  rw [hExpand]
  linarith

omit [Fintype ν] in
/-- The kinetic multiplier on weighted `H²` coordinates is a contraction. -/
lemma coulombKinetic_ratio_norm_le_one (sys : CoulombSystem eta ν) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    ‖((coulombKineticEnergySymbol sys g p / molecularFourierH2Weight eta g p : ℝ) : ℂ)‖ ≤ 1 := by
  have hw := molecularFourierH2Weight_pos eta g p
  have hk := coulombKineticEnergySymbol_nonneg sys g p
  have hle := two_mul_coulombKineticEnergySymbol_le sys g p
  rw [Complex.norm_of_nonneg (div_nonneg hk hw.le), div_le_one hw]
  linarith

/-- The kinetic energy on the complete weighted `H²` coordinate space. -/
def coulombFourierKineticH2 (sys : CoulombSystem eta ν) (g : ℝ) :
    MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  lp2DiagonalCLM
    (fun p => ((coulombKineticEnergySymbol sys g p / molecularFourierH2Weight eta g p : ℝ) : ℂ))
    (coulombKinetic_ratio_norm_le_one sys g)

omit [Fintype ν] in
@[simp] theorem coulombFourierKineticH2_apply (sys : CoulombSystem eta ν) (g : ℝ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    coulombFourierKineticH2 sys g u p =
      (coulombKineticEnergySymbol sys g p : ℂ) * molecularH2Coeff g u p := by
  rw [coulombFourierKineticH2, lp2DiagonalCLM_apply]
  unfold molecularH2Coeff
  push_cast
  ring

/-- The completed kinetic term on the torus. -/
def coulombPositionKineticH2 (sys : CoulombSystem eta ν) (g : ℝ) :
    MolecularFourierH2 eta →L[ℂ] MolecularPositionL2 eta :=
  molecularPositionHamiltonianH2 (coulombFourierKineticH2 sys g)

omit [Fintype ν] in
@[simp] theorem coulombPositionKineticH2_apply (sys : CoulombSystem eta ν) (g : ℝ)
    (u : MolecularFourierH2 eta) :
    coulombPositionKineticH2 sys g u =
      molecularPositionSynthesis eta (coulombFourierKineticH2 sys g u) := rfl

omit [Fintype ν] in
theorem coulombPositionKineticH2_fourierCoeff (sys : CoulombSystem eta ν) (g : ℝ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    (molecularPositionSynthesis eta).symm (coulombPositionKineticH2 sys g u) p =
      (coulombKineticEnergySymbol sys g p : ℂ) * molecularH2Coeff g u p := by
  rw [coulombPositionKineticH2_apply, (molecularPositionSynthesis eta).symm_apply_apply]
  exact coulombFourierKineticH2_apply sys g u p

omit [Fintype ν] in
/-- On every Fourier polynomial the completed kinetic operator is the diagonal kinetic
kernel. -/
theorem coulombFourierKineticH2_core (sys : CoulombSystem eta ν) (L : ℝ)
    (N : ℕ) (u : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    coulombFourierKineticH2 sys (2 * Real.pi / L) (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeKineticKernel sys L) N u q := by
  classical
  rw [coulombFourierKineticH2_apply, molecularH2Coeff_truncate]
  unfold coulombKineticEnergySymbol
  simp only [fourierCubeKernelAction, coulombLatticeKineticKernel,
    mul_ite, mul_zero, Finset.sum_ite_eq', cubicLatticeCoeffTruncate]
  by_cases hq : q ∈ fourierConfigCube eta N
  · simp only [if_pos hq]
    push_cast
    ring
  · simp only [if_neg hq]

/-- The potential part of a completed Fourier Hamiltonian. -/
def coulombFourierPotentialH2 (sys : CoulombSystem eta ν) (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  H - coulombFourierKineticH2 sys g

omit [Fintype ν] in
theorem coulombFourierHamiltonianH2_decomposition (sys : CoulombSystem eta ν) (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (u : MolecularFourierH2 eta) :
    H u = coulombFourierKineticH2 sys g u + coulombFourierPotentialH2 sys g H u := by
  change H u = coulombFourierKineticH2 sys g u + (H u - coulombFourierKineticH2 sys g u)
  abel

/-- The potential part has the charge-weighted nuclear and pair kernel on the Fourier
core. -/
theorem coulombFourierPotentialH2_core (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (N : ℕ) (u : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    coulombFourierPotentialH2 sys (2 * Real.pi / L) H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (fun q p => coulombLatticeNuclearKernel sys (coulombCellAmplitude L) q p +
          coulombLatticePairKernel sys (coulombCellAmplitude L) q p) N u q := by
  change H (molecularH2Truncate N u) q -
    coulombFourierKineticH2 sys (2 * Real.pi / L) (molecularH2Truncate N u) q = _
  rw [hKernel, coulombFourierKineticH2_core]
  simp only [fourierCubeKernelAction, coulombLatticeHamiltonianKernel,
    mul_add, Finset.sum_add_distrib]
  ring

/-- The potential part on the torus. -/
def coulombPositionPotentialH2 (sys : CoulombSystem eta ν) (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    MolecularFourierH2 eta →L[ℂ] MolecularPositionL2 eta :=
  molecularPositionHamiltonianH2 (coulombFourierPotentialH2 sys g H)

omit [Fintype ν] in
theorem coulombPositionHamiltonianH2_decomposition (sys : CoulombSystem eta ν) (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (u : MolecularFourierH2 eta) :
    molecularPositionHamiltonianH2 H u =
      coulombPositionKineticH2 sys g u + coulombPositionPotentialH2 sys g H u := by
  change molecularPositionSynthesis eta (H u) =
    molecularPositionSynthesis eta (coulombFourierKineticH2 sys g u) +
      molecularPositionSynthesis eta (coulombFourierPotentialH2 sys g H u)
  rw [← map_add]
  exact congrArg (molecularPositionSynthesis eta)
    (coulombFourierHamiltonianH2_decomposition sys g H u)

/-! ## The classical kinetic expression -/

/-- The kinetic symbol applied to a finite test polynomial. -/
def coulombPositionKineticTest (sys : CoulombSystem eta ν) (g : ℝ)
    (s : Finset (FourierConfig eta Lattice3))
    (c : FourierConfig eta Lattice3 → ℂ) : C(MolecularPositionTorus eta, ℂ) :=
  molecularPositionFourierTest eta s
    (fun p => (coulombKineticEnergySymbol sys g p : ℂ) * c p)

omit [Fintype ν] in
/-- The kinetic symbol as one sum over all particle and Cartesian coordinates. -/
lemma coulombKineticEnergySymbol_eq_flat_sum (sys : CoulombSystem eta ν) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    coulombKineticEnergySymbol sys g p =
      (g ^ 2 / 2) * ∑ a : Fin eta × Fin 3, (p a.1 a.2 : ℝ) ^ 2 / sys.mass a.1 := by
  have hPull : (∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i) =
      g ^ 2 * ∑ i : Fin eta, latticeNormSq (p i) / sys.mass i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  have hNorm : (∑ i : Fin eta, latticeNormSq (p i) / sys.mass i) =
      ∑ a : Fin eta × Fin 3, (p a.1 a.2 : ℝ) ^ 2 / sys.mass a.1 := by
    rw [Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro i _hi
    simp only [latticeNormSq, Fin.sum_univ_three, add_div]
  unfold coulombKineticEnergySymbol
  rw [hPull, hNorm]
  ring

omit [Fintype ν] in
/-- At the physical scale `2π/L` the kinetic symbol is `-1/(2 L²)` times the
mass-weighted second-derivative multipliers of the unit-torus coordinates. -/
lemma coulombKineticEnergySymbol_eq_coordinate_second_derivatives
    (sys : CoulombSystem eta ν) (L : ℝ) (p : FourierConfig eta Lattice3) :
    (coulombKineticEnergySymbol sys (2 * Real.pi / L) p : ℂ) =
      (-(1 / 2 : ℂ) / (L : ℂ) ^ 2) *
        ∑ a : Fin eta × Fin 3, ((sys.mass a.1 : ℂ))⁻¹ *
          -(4 * (Real.pi : ℂ) ^ 2 * (p a.1 a.2 : ℂ) ^ 2) := by
  rw [coulombKineticEnergySymbol_eq_flat_sum]
  push_cast
  rw [Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a _ha
  simp only [div_pow]
  ring

/-- The classical kinetic differential expression with masses, defined with ordinary
real derivatives along the coordinate lines. -/
def coulombPositionClassicalKinetic (sys : CoulombSystem eta ν) (L : ℝ)
    (f : MolecularPositionTorus eta → ℂ) (x : MolecularPositionTorus eta) : ℂ :=
  (-(1 / 2 : ℂ) / (L : ℂ) ^ 2) *
    ∑ a : Fin eta × Fin 3, ((sys.mass a.1 : ℂ))⁻¹ *
      deriv (deriv (fun t : ℝ => f (torusCoordinateLine x a t))) 0

omit [Fintype ν] in
/-- On finite Fourier tests the kinetic multiplier is the classical expression. -/
theorem coulombPositionKineticTest_eq_classicalKinetic (sys : CoulombSystem eta ν) (L : ℝ)
    (s : Finset (FourierConfig eta Lattice3))
    (c : FourierConfig eta Lattice3 → ℂ) (x : MolecularPositionTorus eta) :
    coulombPositionKineticTest sys (2 * Real.pi / L) s c x =
      coulombPositionClassicalKinetic sys L (molecularPositionFourierTest eta s c) x := by
  unfold coulombPositionClassicalKinetic coulombPositionKineticTest
  rw [molecularPositionFourierTest_apply]
  simp_rw [molecularPositionFourierTest_second_deriv_coordinateLine_zero]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro p _hp
  rw [coulombKineticEnergySymbol_eq_coordinate_second_derivatives, Finset.mul_sum,
    Finset.sum_mul, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro a _ha
  ring

/-! ## The weak kinetic equation on Fourier tests -/

omit [Fintype ν] in
theorem coulombPositionKineticTest_inner (sys : CoulombSystem eta ν) (g : ℝ)
    (s : Finset (FourierConfig eta Lattice3))
    (c : FourierConfig eta Lattice3 → ℂ) (f : MolecularPositionL2 eta) :
    inner ℂ ((ContinuousMap.toLp 2 volume ℂ) (coulombPositionKineticTest sys g s c)) f =
      ∑ p ∈ s, conj (c p) *
        ((coulombKineticEnergySymbol sys g p : ℂ) *
          ((molecularPositionSynthesis eta).symm f p)) := by
  rw [coulombPositionKineticTest, molecularPositionFourierTest_inner]
  apply Finset.sum_congr rfl
  intro p _hp
  rw [map_mul, Complex.conj_ofReal]
  ring

/-- The weak kinetic equation with masses, tested against all trigonometric
polynomials. -/
def HasCoulombWeakKinetic (sys : CoulombSystem eta ν) (g : ℝ)
    (f k : MolecularPositionL2 eta) : Prop :=
  ∀ (s : Finset (FourierConfig eta Lattice3)) (c : FourierConfig eta Lattice3 → ℂ),
    inner ℂ ((ContinuousMap.toLp 2 volume ℂ) (molecularPositionFourierTest eta s c)) k =
      inner ℂ ((ContinuousMap.toLp 2 volume ℂ) (coulombPositionKineticTest sys g s c)) f

omit [Fintype ν] in
theorem hasCoulombWeakKinetic_iff_coeff (sys : CoulombSystem eta ν) (g : ℝ)
    (f k : MolecularPositionL2 eta) :
    HasCoulombWeakKinetic sys g f k ↔
      ∀ p : FourierConfig eta Lattice3,
        (molecularPositionSynthesis eta).symm k p =
          (coulombKineticEnergySymbol sys g p : ℂ) *
            ((molecularPositionSynthesis eta).symm f p) := by
  classical
  constructor
  · intro h p
    have hp := h {p} (fun _ => 1)
    simpa only [molecularPositionFourierTest_inner, coulombPositionKineticTest_inner,
      Finset.sum_singleton, map_one, one_mul] using hp
  · intro h s c
    rw [molecularPositionFourierTest_inner, coulombPositionKineticTest_inner]
    apply Finset.sum_congr rfl
    intro p _hp
    rw [h p]

omit [Fintype ν] in
theorem coulombPositionKineticH2_weak (sys : CoulombSystem eta ν) (g : ℝ)
    (u : MolecularFourierH2 eta) :
    HasCoulombWeakKinetic sys g (molecularPositionH2StateMap eta g u)
      (coulombPositionKineticH2 sys g u) := by
  apply (hasCoulombWeakKinetic_iff_coeff sys g _ _).mpr
  intro p
  rw [coulombPositionKineticH2_fourierCoeff, molecularPositionH2StateMap_fourierCoeff]

omit [Fintype ν] in

omit [Fintype ν] in
/-- The weak kinetic domain is exactly the `H²` domain. Square integrability of the
state and of its weak kinetic output supplies the `H²` coordinates; the largest mass
controls the `H²` weight by the kinetic energy. -/
theorem hasCoulombWeakKinetic_iff_H2 (sys : CoulombSystem eta ν) (g : ℝ)
    (f k : MolecularPositionL2 eta) :
    HasCoulombWeakKinetic sys g f k ↔
      ∃ u : MolecularFourierH2 eta,
        molecularPositionH2StateMap eta g u = f ∧
        coulombPositionKineticH2 sys g u = k := by
  constructor
  · intro h
    have hCoeff := (hasCoulombWeakKinetic_iff_coeff sys g f k).mp h
    have hM : (0 : ℝ) < sys.maxMass := lt_of_lt_of_le one_pos sys.one_le_maxMass
    have hD : ∀ p, (0 : ℝ) < 1 + 2 * coulombKineticEnergySymbol sys g p := fun p => by
      linarith [coulombKineticEnergySymbol_nonneg sys g p]
    let a : FourierConfig eta Lattice3 → ℂ := fun p =>
      ((molecularFourierH2Weight eta g p /
        (sys.maxMass * (1 + 2 * coulombKineticEnergySymbol sys g p)) : ℝ) : ℂ)
    have ha : ∀ p, ‖a p‖ ≤ 1 := by
      intro p
      have hw := molecularFourierH2Weight_pos eta g p
      have hMD := mul_pos hM (hD p)
      change ‖((molecularFourierH2Weight eta g p /
        (sys.maxMass * (1 + 2 * coulombKineticEnergySymbol sys g p)) : ℝ) : ℂ)‖ ≤ 1
      rw [Complex.norm_of_nonneg (div_nonneg hw.le hMD.le), div_le_one hMD]
      exact molecularFourierH2Weight_le_maxMass_mul sys g p
    let u : MolecularFourierH2 eta := (sys.maxMass : ℂ) • lp2DiagonalCLM a ha
      ((molecularPositionSynthesis eta).symm f +
        (2 : ℂ) • (molecularPositionSynthesis eta).symm k)
    have hState : molecularH2StateMap eta g u = (molecularPositionSynthesis eta).symm f := by
      apply lp.ext
      funext p
      rw [molecularH2StateMap_apply]
      have hw : (molecularFourierH2Weight eta g p : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (ne_of_gt (molecularFourierH2Weight_pos eta g p))
      apply mul_left_cancel₀ hw
      rw [molecularH2Coeff_weight_mul]
      change (sys.maxMass : ℂ) * (a p * ((molecularPositionSynthesis eta).symm f p +
          (2 : ℂ) * ((molecularPositionSynthesis eta).symm k p))) =
        (molecularFourierH2Weight eta g p : ℂ) *
          ((molecularPositionSynthesis eta).symm f p)
      rw [hCoeff p]
      have hReal : sys.maxMass * (molecularFourierH2Weight eta g p /
          (sys.maxMass * (1 + 2 * coulombKineticEnergySymbol sys g p))) *
          (1 + 2 * coulombKineticEnergySymbol sys g p) = molecularFourierH2Weight eta g p := by
        have hMne := hM.ne'
        have hDne := (hD p).ne'
        field_simp
      calc
        (sys.maxMass : ℂ) * (a p * ((molecularPositionSynthesis eta).symm f p +
            (2 : ℂ) * ((coulombKineticEnergySymbol sys g p : ℂ) *
              ((molecularPositionSynthesis eta).symm f p)))) =
            ((sys.maxMass * (molecularFourierH2Weight eta g p /
              (sys.maxMass * (1 + 2 * coulombKineticEnergySymbol sys g p))) *
              (1 + 2 * coulombKineticEnergySymbol sys g p) : ℝ) : ℂ) *
              ((molecularPositionSynthesis eta).symm f p) := by
          simp only [a]
          push_cast
          ring
        _ = (molecularFourierH2Weight eta g p : ℂ) *
              ((molecularPositionSynthesis eta).symm f p) := by
          rw [hReal]
    refine ⟨u, ?_, ?_⟩
    · rw [molecularPositionH2StateMap_apply, hState,
        (molecularPositionSynthesis eta).apply_symm_apply]
    · apply (molecularPositionSynthesis eta).symm.injective
      apply lp.ext
      funext p
      rw [coulombPositionKineticH2_fourierCoeff]
      have hp := congrArg
        (fun v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 => v p) hState
      rw [molecularH2StateMap_apply] at hp
      rw [hp]
      exact (hCoeff p).symm
  · rintro ⟨u, rfl, rfl⟩
    exact coulombPositionKineticH2_weak sys g u

omit [Fintype ν] in
theorem molecularPositionFourierTest_coulombWeakKinetic (sys : CoulombSystem eta ν) (g : ℝ)
    (s : Finset (FourierConfig eta Lattice3)) (c : FourierConfig eta Lattice3 → ℂ) :
    HasCoulombWeakKinetic sys g
      ((ContinuousMap.toLp 2 volume ℂ) (molecularPositionFourierTest eta s c))
      ((ContinuousMap.toLp 2 volume ℂ) (coulombPositionKineticTest sys g s c)) := by
  classical
  apply (hasCoulombWeakKinetic_iff_coeff sys g _ _).mpr
  intro p
  unfold coulombPositionKineticTest
  rw [molecularPositionFourierTest_fourierCoeff, molecularPositionFourierTest_fourierCoeff]
  by_cases hp : p ∈ s <;> simp [hp]

omit [Fintype ν] in
/-- The kinetic operator is symmetric on its `H²` domain. -/
theorem coulombFourierKineticH2_inner_symmetry (sys : CoulombSystem eta ν) (g : ℝ)
    (u v : MolecularFourierH2 eta) :
    inner ℂ (molecularH2StateMap eta g u) (coulombFourierKineticH2 sys g v) =
      inner ℂ (coulombFourierKineticH2 sys g u) (molecularH2StateMap eta g v) := by
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
  apply tsum_congr
  intro p
  rw [molecularH2StateMap_apply, coulombFourierKineticH2_apply,
    coulombFourierKineticH2_apply, molecularH2StateMap_apply]
  change inner ℂ (molecularH2Coeff g u p)
      ((coulombKineticEnergySymbol sys g p : ℂ) • molecularH2Coeff g v p) =
    inner ℂ ((coulombKineticEnergySymbol sys g p : ℂ) • molecularH2Coeff g u p)
      (molecularH2Coeff g v p)
  rw [inner_smul_right, inner_smul_left]
  simp only [Complex.conj_ofReal]

omit [Fintype ν] in
theorem coulombPositionKineticH2_inner_symmetry (sys : CoulombSystem eta ν) (g : ℝ)
    (u v : MolecularFourierH2 eta) :
    inner ℂ (molecularPositionH2StateMap eta g u) (coulombPositionKineticH2 sys g v) =
      inner ℂ (coulombPositionKineticH2 sys g u) (molecularPositionH2StateMap eta g v) := by
  rw [molecularPositionH2StateMap_apply, coulombPositionKineticH2_apply,
    coulombPositionKineticH2_apply, molecularPositionH2StateMap_apply,
    molecularPositionSynthesis_inner, molecularPositionSynthesis_inner]
  exact coulombFourierKineticH2_inner_symmetry sys g u v

omit [Fintype ν] in
/-- Polynomial weak tests are equivalent to integration by parts against every `H²`
state. -/
theorem hasCoulombWeakKinetic_iff_allH2_inner (sys : CoulombSystem eta ν) (g : ℝ)
    (f k : MolecularPositionL2 eta) :
    HasCoulombWeakKinetic sys g f k ↔
      ∀ u : MolecularFourierH2 eta,
        inner ℂ (molecularPositionH2StateMap eta g u) k =
          inner ℂ (coulombPositionKineticH2 sys g u) f := by
  constructor
  · intro h u
    obtain ⟨v, hv, hk⟩ := (hasCoulombWeakKinetic_iff_H2 sys g f k).mp h
    rw [← hv, ← hk]
    exact coulombPositionKineticH2_inner_symmetry sys g u v
  · intro h s c
    obtain ⟨u, hu, hk⟩ := (hasCoulombWeakKinetic_iff_H2 sys g _ _).mp
      (molecularPositionFourierTest_coulombWeakKinetic sys g s c)
    have huInner := h u
    rw [hu, hk] at huInner
    exact huInner

/-! ## Tests with classical coordinate derivatives -/

/-- The classical kinetic output of a test with continuous coordinate derivatives. -/
def coulombPositionC2Kinetic (sys : CoulombSystem eta ν) (L : ℝ)
    (f : TorusCoordinateC2Test (Fin eta × Fin 3)) : C(MolecularPositionTorus eta, ℂ) :=
  (-(1 / 2 : ℂ) / (L : ℂ) ^ 2) •
    ∑ a : Fin eta × Fin 3, ((sys.mass a.1 : ℂ))⁻¹ • f.second a

omit [Fintype ν] in
theorem coulombPositionC2Kinetic_eq_classicalKinetic (sys : CoulombSystem eta ν) (L : ℝ)
    (f : TorusCoordinateC2Test (Fin eta × Fin 3)) (x : MolecularPositionTorus eta) :
    coulombPositionC2Kinetic sys L f x =
      coulombPositionClassicalKinetic sys L f.toContinuousMap x := by
  simp only [coulombPositionC2Kinetic, ContinuousMap.coe_smul, Pi.smul_apply,
    smul_eq_mul, ContinuousMap.coe_sum, Finset.sum_apply,
    coulombPositionClassicalKinetic]
  congr 1
  apply Finset.sum_congr rfl
  intro a _ha
  rw [f.second_eq_iteratedDeriv a x]

omit [Fintype ν] in
theorem coulombPositionC2Kinetic_fourierTest (sys : CoulombSystem eta ν) (L : ℝ)
    (s : Finset (FourierConfig eta Lattice3)) (c : FourierConfig eta Lattice3 → ℂ) :
    coulombPositionC2Kinetic sys L (molecularPositionFourierTestC2 eta s c) =
      coulombPositionKineticTest sys (2 * Real.pi / L) s c := by
  ext x
  rw [coulombPositionC2Kinetic_eq_classicalKinetic,
    molecularPositionFourierTestC2_toContinuousMap]
  exact (coulombPositionKineticTest_eq_classicalKinetic sys L s c x).symm

omit [Fintype ν] in
/-- Classical coordinate differentiation followed by Fourier analysis gives the
mass-weighted kinetic symbol. -/
theorem coulombPositionC2Kinetic_fourierCoeff (sys : CoulombSystem eta ν) (L : ℝ)
    (f : TorusCoordinateC2Test (Fin eta × Fin 3)) (p : FourierConfig eta Lattice3) :
    (molecularPositionSynthesis eta).symm
        ((ContinuousMap.toLp 2 volume ℂ) (coulombPositionC2Kinetic sys L f)) p =
      (coulombKineticEnergySymbol sys (2 * Real.pi / L) p : ℂ) *
        ((molecularPositionSynthesis eta).symm
          ((ContinuousMap.toLp 2 volume ℂ) f.toContinuousMap) p) := by
  have hCoeff (a : Fin eta × Fin 3) :
      (molecularPositionSynthesis eta).symm
          ((ContinuousMap.toLp 2 volume ℂ) (f.second a)) p =
        -(4 * (Real.pi : ℂ) ^ 2 * (p a.1 a.2 : ℂ) ^ 2) *
          ((molecularPositionSynthesis eta).symm
            ((ContinuousMap.toLp 2 volume ℂ) f.toContinuousMap) p) := by
    rw [molecularPositionSynthesis_symm_apply, molecularPositionSynthesis_symm_apply,
      UnitAddTorus.mFourierCoeff_toLp, UnitAddTorus.mFourierCoeff_toLp]
    simpa only [molecularFourierIndexEquiv_apply] using
      mFourierCoeff_coordinateSecondDerivative f.toContinuousMap (f.first a) (f.second a)
        a (molecularFourierIndexEquiv eta p) (f.hasFirst a) (f.hasSecond a)
  simp only [coulombPositionC2Kinetic, map_smul, map_sum, lp.coeFn_smul, Pi.smul_apply,
    smul_eq_mul, lp.coeFn_sum, Finset.sum_apply]
  simp_rw [hCoeff]
  rw [coulombKineticEnergySymbol_eq_coordinate_second_derivatives, mul_assoc, Finset.sum_mul]
  congr 1
  apply Finset.sum_congr rfl
  intro a _ha
  ring

omit [Fintype ν] in
theorem coulombPositionC2Test_weakKinetic (sys : CoulombSystem eta ν) (L : ℝ)
    (f : TorusCoordinateC2Test (Fin eta × Fin 3)) :
    HasCoulombWeakKinetic sys (2 * Real.pi / L)
      ((ContinuousMap.toLp 2 volume ℂ) f.toContinuousMap)
      ((ContinuousMap.toLp 2 volume ℂ) (coulombPositionC2Kinetic sys L f)) := by
  apply (hasCoulombWeakKinetic_iff_coeff sys (2 * Real.pi / L) _ _).mpr
  exact coulombPositionC2Kinetic_fourierCoeff sys L f

omit [Fintype ν] in
theorem coulombPositionC2Test_exists_H2 (sys : CoulombSystem eta ν) (L : ℝ)
    (f : TorusCoordinateC2Test (Fin eta × Fin 3)) :
    ∃ u : MolecularFourierH2 eta,
      molecularPositionH2StateMap eta (2 * Real.pi / L) u =
        (ContinuousMap.toLp 2 volume ℂ) f.toContinuousMap ∧
      coulombPositionKineticH2 sys (2 * Real.pi / L) u =
        (ContinuousMap.toLp 2 volume ℂ) (coulombPositionC2Kinetic sys L f) :=
