section DevU14

/-!
# Dynamics: `thm:dyn`, final form

`thm:dyn` for a periodic Coulomb system with the certificate's canonical choices of the auxiliary
constants (`molecularCanonicalTailConstants_spec`) and `ρ = K^{-1/2}`: the only conditions on the
cube of radius `n` are `n ≥ 4` and `K = 2πn/L ≥ 2`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveDynamics

open PlaneWaveCertificate

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-- **`thm:dyn` (periodic Coulomb system, final form).** There is a propagator `U` (`e^{-iHt}`) on
`L²((T³)^η)` — a strongly continuous unitary group that preserves the graph of the Coulomb
Hamiltonian, solves the Schrödinger equation on it and is the only evolution that does — and, for
every cube `n`, a Galerkin propagator `U_N` (`e^{-iH_N t}`), such that for `n ≥ 4` with
`K = 2πn/L ≥ 2`, every `ψ₀ ∈ D(H²)` (`H ψ₀ = h₀`, `H h₀ = h₁`), every register `a`, every real
continuous `χ` on the unit torus with `Σ_ν (1 + g²|ν|²) |χ̂(ν)| < ∞`, and every `t ≥ 0`,
`|⟪ψ(t), χ(x_a) ψ(t)⟫ - ⟪ψ_N(t), χ(x_a) ψ_N(t)⟫| ≤ A₁ K^{-5} + A₂ t K^{-3} + A₃ K^{-5/2} τ_χ(K/2)`
(`obsRateBound` at `ρ = K^{-1/2}`), with `A₁, A₂, A₃` independent of `K` and `t`. -/
theorem thm_dyn (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      ∀ n : ℕ, ∃ UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ x, UN 0 x = x) ∧ (∀ s t x, UN (s + t) x = UN s (UN t x)) ∧
        (∀ t x, HasDerivAt (fun s => UN s x)
          (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t) ∧
        (4 ≤ n → 2 ≤ (2 * Real.pi / L) * n →
          ∀ ψ₀ h₀ h₁ : MolecularPositionL2 eta, HasCoulombHamiltonian sys L ψ₀ h₀ →
          HasCoulombHamiltonian sys L h₀ h₁ →
          ∀ (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)),
          Summable (fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
            ‖UnitAddTorus.mFourierCoeff χ ν‖) →
          (∀ y, conj (χ y) = χ y) → ∀ t : ℝ, 0 ≤ t →
          let ψN := physMap eta (finiteFourierLpIsometry eta n
            (UN t (extractCLM n ((physMap eta).symm ψ₀))))
          ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
            obsRateBound sys L molecularCanonicalUnitHardyConstant
              (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
              (molecularCanonicalKernelConstant L) (Real.sqrt (1 / ((2 * Real.pi / L) * n))) n a
              (UnitAddTorus.mFourierCoeff χ) ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖ t) := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hrest⟩ :=
    coulomb_observable_propagators sys L hL
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, fun n => ?_⟩
  obtain ⟨UN, hN0, hNadd, hNderiv, hbound⟩ := hrest n
  refine ⟨UN, hN0, hNadd, hNderiv, ?_⟩
  intro hn hK2 ψ₀ h₀ h₁ hψ₀ hh₀ a χ hχ2 hreal t ht
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hKpos : 0 < (2 * Real.pi / L) * n := by linarith
  obtain ⟨hBlow, hCs, hBker, hLow, hKernelScale, hSobolev⟩ :=
    molecularCanonicalTailConstants_spec L hL
  have hRhoScale : Real.sqrt (1 / ((2 * Real.pi / L) * n)) ^ 2 * ((2 * Real.pi / L) * n) = 1 := by
    rw [Real.sq_sqrt (by positivity)]
    field_simp
  have h4g : 4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n := by
    have : (4 : ℝ) ≤ n := by exact_mod_cast hn
    nlinarith
  exact hbound (Real.sqrt (1 / ((2 * Real.pi / L) * n))) (molecularCanonicalLowConstant L)
    (molecularCanonicalSobolevConstant L) (molecularCanonicalKernelConstant L) hK2
    (Real.sqrt_nonneg _) hRhoScale hBlow hCs hBker h4g hLow hKernelScale hSobolev ψ₀ h₀ h₁ hψ₀ hh₀
    a χ hχ2 hreal t ht

/-- The constants `(A₁, A₂, A₃)` of `obsRateBound`; they do not depend on the cube, `ρ` or `t`. -/
noncomputable def obsConsts (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ) (a : Fin eta)
    (χ : Lattice3 → ℂ) (s0 hu hs hv : ℝ) : ℝ × ℝ × ℝ :=
  let g : ℝ := 2 * Real.pi / L
  let b : ℝ := relB sys L Hunit
  let S0 : ℝ := s0
  let Ξ₀ : ℝ := 2 * hu + 2 * b * S0
  let Ξ₁ : ℝ := 2 * hv + 2 * b * hs
  let Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
  let CO : ℝ := ‖convOp (eta := eta) a χ‖
  let Cχ : ℝ := ∑' ν, ‖χ ν‖
  let D : ℝ := commConst g a χ
  let Hw1 : ℝ := 2 * ((CO + 2 * D) * Ξ₀ + D * S0) + 2 * b * (CO * S0)
  let M1 : ℝ := sys.maxMass * (CO * S0 + 2 * (2 * Hw1 + 2 * b * (CO * S0)))
  let Tη : ℝ := 2 * (2 * (2 * Ξ₀ + 2 * b * S0)) + 2 * b * (2 * S0)
  let Hw2 : ℝ := 2 * ((CO + 2 * D) * Tη + D * (2 * S0)) + 2 * b * (CO * (2 * S0))
  let M2 : ℝ := sys.maxMass * (CO * (2 * S0) + 2 * (2 * Hw2 + 2 * b * (CO * (2 * S0))))
  let β : ℝ := 2 * sys.maxMass * Ξ₁ + Ct (sys.maxMass * (S0 + 2 * Ξ₀))
  let δ₁ : ℝ := eta * (2 * sys.maxMass * β)
  let τ₁ : ℝ := 8 * sys.maxMass * (8 * sys.maxMass * Ξ₁ + 2 * Ct (sys.maxMass * (S0 + 2 * Ξ₀)))
  let N₁ : ℝ := finiteCoulombPhysicalMassConstant sys L Hunit *
    Real.sqrt (δ₁ * (eta * ((2 * sys.maxMass + 2) * β)))
  (2 * δ₁ * (Cχ * τ₁ + CO * δ₁) + CO * δ₁ ^ 2,
    2 * δ₁ * (eta * Ct M1) + 2 * CO * δ₁ * N₁ + δ₁ * (eta * Ct M2),
    2 * δ₁ * S0)

/-- The coefficient tail `τ_χ(K/2) = Σ_{g|ν| > K/2} |χ̂(ν)|` of the cube of radius `n`. -/
noncomputable def obsTail (L : ℝ) (n : ℕ) (χ : Lattice3 → ℂ) : ℝ :=
  ∑' ν, if (2 * Real.pi / L) * n / 2 < (2 * Real.pi / L) * Real.sqrt (latticeNormSq ν) then
    ‖χ ν‖ else 0

lemma obsRateBound_eq (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ)
    (a : Fin eta) (χ : Lattice3 → ℂ) (s0 hu hs hv t : ℝ) :
    obsRateBound sys L Hunit Blow Cs Bker rho n a χ s0 hu hs hv t =
      (obsConsts sys L Hunit Blow Cs Bker a χ s0 hu hs hv).1 * rho ^ 10 +
        (obsConsts sys L Hunit Blow Cs Bker a χ s0 hu hs hv).2.1 * t * rho ^ 6 +
        (obsConsts sys L Hunit Blow Cs Bker a χ s0 hu hs hv).2.2 * rho ^ 5 * obsTail L n χ :=
  rfl

/-- **`thm:dyn` with constants independent of `K` and `t`** (`eq:dyn-main`). With the propagators
`e^{-iHt}` and `e^{-iH_N t}` of `thm_dyn`: for every `ψ₀ ∈ D(H²)` (`H ψ₀ = h₀`, `H h₀ = h₁`),
register `a` and real `χ` with `Σ_ν (1 + g²|ν|²) |χ̂(ν)| < ∞`, and with the constants
`(A₁, A₂, A₃) = obsConsts` at `(‖ψ₀‖, ‖h₀‖, ‖h₀‖, ‖h₁‖)`, fixed before the cube and the time: for
every cube `n ≥ 4` with `K = 2πn/L ≥ 2` and every `t ≥ 0`,
`|⟪ψ(t), χ(x_a) ψ(t)⟫ - ⟪ψ_N(t), χ(x_a) ψ_N(t)⟫| ≤ A₁ K^{-5} + A₂ t K^{-3} + A₃ K^{-5/2} τ_χ(K/2)`.
-/
theorem thm_dyn_rates (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ ψ₀ h₀ h₁ : MolecularPositionL2 eta, HasCoulombHamiltonian sys L ψ₀ h₀ →
          HasCoulombHamiltonian sys L h₀ h₁ →
          ∀ (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)),
          Summable (fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
            ‖UnitAddTorus.mFourierCoeff χ ν‖) →
          (∀ y, conj (χ y) = χ y) →
          let A := obsConsts sys L molecularCanonicalUnitHardyConstant
            (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
            (molecularCanonicalKernelConstant L) a (UnitAddTorus.mFourierCoeff χ)
            ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖
          ∀ n : ℕ, 4 ≤ n → 2 ≤ (2 * Real.pi / L) * n → ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            let ψN := physMap eta (finiteFourierLpIsometry eta n
              (UN n t (extractCLM n ((physMap eta).symm ψ₀))))
            ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
              A.1 * (1 / K) ^ 5 + A.2.1 * t * (1 / K) ^ 3 +
                A.2.2 * Real.sqrt (1 / K) ^ 5 * obsTail L n (UnitAddTorus.mFourierCoeff χ) := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hrest⟩ := thm_dyn sys L hL
  choose UN hN0 hNadd hNderiv hbound using hrest
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, UN, hN0, hNadd, hNderiv, ?_⟩
  intro ψ₀ h₀ h₁ hψ₀ hh₀ a χ hχ2 hreal A n hn hK2 t ht K ψN
  have h := hbound n hn hK2 ψ₀ h₀ h₁ hψ₀ hh₀ a χ hχ2 hreal t ht
  rw [obsRateBound_eq] at h
  have hKpos : 0 < K := by
    have : (0 : ℝ) < 2 := two_pos
    linarith
  have hρ2 : Real.sqrt (1 / K) ^ 2 = 1 / K := Real.sq_sqrt (by positivity)
  have e10 : Real.sqrt (1 / K) ^ 10 = (1 / K) ^ 5 := by
    rw [show (10 : ℕ) = 2 * 5 by norm_num, pow_mul, hρ2]
  have e6 : Real.sqrt (1 / K) ^ 6 = (1 / K) ^ 3 := by
    rw [show (6 : ℕ) = 2 * 3 by norm_num, pow_mul, hρ2]
  rw [e10, e6] at h
  exact h

/-- **The threshold of `cor:norm`.** For `‖ψ₀‖ = 1` and `ψ₀ ∈ D(H²)`, as soon as
`(δ₁ K^{-5/2})² ≤ 1/2` (`K ≥ K_norm`), `‖P ψ₀‖² ≥ 1/2`; in particular `P ψ₀ ≠ 0` and the
normalised Galerkin state of `coulomb_observable_normalised` is defined. -/
theorem coulomb_normalisation_threshold (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (n : ℕ)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁) (hnorm : ‖ψ₀‖ = 1)
    (hthr : (obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖ψ₀‖ ‖h₀‖ ‖h₀‖
      ‖h₁‖ * rho ^ 5) ^ 2 ≤ 1 / 2) :
    1 / 2 ≤ ‖molecularH2Truncate n ((physMap eta).symm ψ₀)‖ ^ 2 ∧
      molecularH2Truncate n ((physMap eta).symm ψ₀) ≠ 0 := by
  have hPeriodic := canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨H, hKernel, -⟩ := exists_coulombFourierH2Operator sys L
      molecularCanonicalUnitHardyConstant
    hL hPeriodic
  have hiff := hasCoulombHamiltonian_iff_phys sys L hL H hKernel
  obtain ⟨u₀, hu₀1, hu₀2⟩ := (hiff ψ₀ h₀).mp hψ₀
  obtain ⟨v₀, hv₀1, hv₀2⟩ := (hiff h₀ h₁).mp hh₀
  have huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀ :=
    (physMap eta).injective (hu₀2.trans hv₀1.symm)
  have htail := initial_tail_le sys L H hKernel molecularCanonicalUnitHardyConstant hL hPeriodic
    (finiteCoulombPhysicalMassConstant_nonneg _ _ _) n rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs
    hBker h2gK hAmplitude hBkerScale hCsScale u₀ v₀ huv
  have hx₀u : (physMap eta).symm ψ₀ = molecularH2StateMap eta (2 * Real.pi / L) u₀ := by
    rw [← hu₀1, LinearIsometryEquiv.symm_apply_apply]
  have e1 : ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ = ‖ψ₀‖ := by
    rw [← hu₀1, LinearIsometryEquiv.norm_map]
  have e2 : ‖H u₀‖ = ‖h₀‖ := by rw [← hu₀2, LinearIsometryEquiv.norm_map]
  have e3 : ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ = ‖h₀‖ := by
    rw [← hv₀1, LinearIsometryEquiv.norm_map]
  have e4 : ‖H v₀‖ = ‖h₁‖ := by rw [← hv₀2, LinearIsometryEquiv.norm_map]
  rw [e1, e2, e3, e4, ← hx₀u] at htail
  set x₀ := (physMap eta).symm ψ₀
  have hx₀ : ‖x₀‖ = 1 := by rw [LinearIsometryEquiv.norm_map]; exact hnorm
  have hpyth := norm_sq_truncate_add n x₀
  rw [hx₀] at hpyth
  have hsq : ‖x₀ - molecularH2Truncate n x₀‖ ^ 2 ≤ 1 / 2 :=
    (pow_le_pow_left₀ (norm_nonneg _) htail 2).trans hthr
  have hhalf : 1 / 2 ≤ ‖molecularH2Truncate n x₀‖ ^ 2 := by nlinarith
  refine ⟨hhalf, fun h0 => ?_⟩
  rw [h0, norm_zero] at hhalf
  norm_num at hhalf

end PlaneWaveDynamics

end DevU14
