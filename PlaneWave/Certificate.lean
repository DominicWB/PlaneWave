# Conditional Lean certificate for the BO plane-wave basis error

This file formalizes the algebraic/exponent-bookkeeping core of the proof of
Theorem 1 in the accompanying manuscript.  The two genuinely analytic inputs
are exposed rather than hidden:

* `hPT`: the potential-tail bound, represented as `Lambda <= CW * rho`, with
  `rho^2 * K <= 1` (instantiate `rho = K^(-1/2)`);
* `hKR_form`: the quadratic-form estimate used in the variational sandwich.

The first theorem keeps structural scalar interfaces explicit.  The second
milestone below eliminates the two bootstrap interfaces by representing a
finite Fourier tail as a complex Euclidean coefficient vector and deriving
Eqs. (30)--(31) directly from the pointwise Fourier eigenvalue equation and
cutoff multiplier bounds.  The remaining interfaces are the Fourier-tail
reduction and Rayleigh--Ritz.  The theorem checks the absorption and exponent
bookkeeping from these interfaces to the final `K^(-3)` energy rate.

The proof is deliberately polynomialized: instead of dividing by powers of K
or using `Real.sqrt`, it proves scaled inequalities such as
`K^5 * t^2 <= 16 * CW^2`.  This makes the kernel-checked part robust and keeps
all square-root/reciprocal facts at the interface boundary.
-/

open scoped BigOperators

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace PlaneWaveCertificate

private lemma sq_le_sq_of_nonneg {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    a ^ 2 ≤ b ^ 2 := by
  have hb : 0 ≤ b := le_trans ha hab
  have hprod : 0 ≤ (b - a) * (b + a) :=
    mul_nonneg (sub_nonneg.mpr hab) (add_nonneg hb ha)
  nlinarith

/-- The numerical content of the Rayleigh--Ritz/form-bound sandwich. -/
lemma rayleigh_form_sandwich
    {energyGap pnormSq q C1 deltaH1Sq : ℝ}
    (hGap0 : 0 ≤ energyGap)
    (hPnorm : (1 / 2 : ℝ) ≤ pnormSq)
    (hRayleigh : energyGap * pnormSq ≤ q)
    (hKR_form : q ≤ C1 * deltaH1Sq) :
    energyGap ≤ 2 * C1 * deltaH1Sq := by
  have hHalf : energyGap * (1 / 2 : ℝ) ≤ energyGap * pnormSq :=
    mul_le_mul_of_nonneg_left hPnorm hGap0
  nlinarith [hHalf, hRayleigh, hKR_form]

/-! ## Second milestone: derive the bootstrap inequalities from Fourier coefficients -/

/-- Coordinatewise multiplication of a finite complex Fourier vector by real weights. -/
def diagMul {ι : Type*} [Fintype ι]
    (a : ι → ℝ) (v : EuclideanSpace ℂ ι) : EuclideanSpace ℂ ι :=
  WithLp.toLp 2 (fun i => (a i : ℂ) * v.ofLp i)

@[simp] lemma diagMul_apply {ι : Type*} [Fintype ι]
    (a : ι → ℝ) (v : EuclideanSpace ℂ ι) (i : ι) :
    (diagMul a v).ofLp i = (a i : ℂ) * v.ofLp i := by
  rfl

/-- Squared Euclidean norm of a diagonal multiplier. -/
lemma diagMul_norm_sq {ι : Type*} [Fintype ι]
    (a : ι → ℝ) (v : EuclideanSpace ℂ ι) :
    ‖diagMul a v‖ ^ 2 = ∑ i, (a i) ^ 2 * ‖v.ofLp i‖ ^ 2 := by
  classical
  rw [EuclideanSpace.norm_sq_eq]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [diagMul_apply, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    mul_pow, sq_abs]

/-- A coordinatewise lower bound on a diagonal symbol gives the corresponding
lower bound on its Euclidean norm. -/
lemma const_mul_norm_le_diagMul_norm
    {ι : Type*} [Fintype ι]
    {a : ℝ} {b : ι → ℝ} (v : EuclideanSpace ℂ ι)
    (ha0 : 0 ≤ a) (hb0 : ∀ i, 0 ≤ b i) (hab : ∀ i, a ≤ b i) :
    a * ‖v‖ ≤ ‖diagMul b v‖ := by
  classical
  have hsum :
      a ^ 2 * (∑ i, ‖v.ofLp i‖ ^ 2) ≤
        ∑ i, (b i) ^ 2 * ‖v.ofLp i‖ ^ 2 := by
    calc
      a ^ 2 * (∑ i, ‖v.ofLp i‖ ^ 2) =
          ∑ i, a ^ 2 * ‖v.ofLp i‖ ^ 2 := by
            rw [Finset.mul_sum]
      _ ≤ ∑ i, (b i) ^ 2 * ‖v.ofLp i‖ ^ 2 := by
        apply Finset.sum_le_sum
        intro i hi
        have hsq : a ^ 2 ≤ (b i) ^ 2 :=
          sq_le_sq_of_nonneg ha0 (hab i)
        exact mul_le_mul_of_nonneg_right hsq (sq_nonneg ‖v.ofLp i‖)
  have hsq : (a * ‖v‖) ^ 2 ≤ ‖diagMul b v‖ ^ 2 := by
    rw [mul_pow, EuclideanSpace.norm_sq_eq, diagMul_norm_sq]
    exact hsum
  have hleft0 : 0 ≤ a * ‖v‖ := mul_nonneg ha0 (norm_nonneg v)
  have hright0 : 0 ≤ ‖diagMul b v‖ := norm_nonneg _
  nlinarith

/-- If `K * d_i <= A_i` coordinatewise, then multiplying a vector by the
`d_i` weights and then by `K` is bounded by multiplication by `A_i`.
This is the multiplier estimate behind Eq. (29) for derivative tails. -/
lemma K_mul_diagMul_norm_le
    {ι : Type*} [Fintype ι]
    {K : ℝ} {d A : ι → ℝ} (v : EuclideanSpace ℂ ι)
    (hK0 : 0 ≤ K) (hd0 : ∀ i, 0 ≤ d i) (hA0 : ∀ i, 0 ≤ A i)
    (hKA : ∀ i, K * d i ≤ A i) :
    K * ‖diagMul d v‖ ≤ ‖diagMul A v‖ := by
  classical
  have hsum :
      K ^ 2 * (∑ i, (d i) ^ 2 * ‖v.ofLp i‖ ^ 2) ≤
        ∑ i, (A i) ^ 2 * ‖v.ofLp i‖ ^ 2 := by
    calc
      K ^ 2 * (∑ i, (d i) ^ 2 * ‖v.ofLp i‖ ^ 2) =
          ∑ i, K ^ 2 * ((d i) ^ 2 * ‖v.ofLp i‖ ^ 2) := by
            rw [Finset.mul_sum]
      _ = ∑ i, (K * d i) ^ 2 * ‖v.ofLp i‖ ^ 2 := by
        apply Finset.sum_congr rfl
        intro i hi
        ring
      _ ≤ ∑ i, (A i) ^ 2 * ‖v.ofLp i‖ ^ 2 := by
        apply Finset.sum_le_sum
        intro i hi
        have hKd0 : 0 ≤ K * d i := mul_nonneg hK0 (hd0 i)
        have hsq : (K * d i) ^ 2 ≤ (A i) ^ 2 :=
          sq_le_sq_of_nonneg hKd0 (hKA i)
        exact mul_le_mul_of_nonneg_right hsq (sq_nonneg ‖v.ofLp i‖)
  have hsq : (K * ‖diagMul d v‖) ^ 2 ≤ ‖diagMul A v‖ ^ 2 := by
    rw [mul_pow, diagMul_norm_sq, diagMul_norm_sq]
    exact hsum
  have hleft0 : 0 ≤ K * ‖diagMul d v‖ :=
    mul_nonneg hK0 (norm_nonneg _)
  have hright0 : 0 ≤ ‖diagMul A v‖ := norm_nonneg _
  nlinarith

/-- Triangle estimate for the restricted Fourier-space right-hand side
`E c - widehat(W psi)`. -/
lemma eigen_rhs_norm_le
    {ι : Type*} [Fintype ι]
    {E Eabs : ℝ} (c w : EuclideanSpace ℂ ι)
    (hEabs : |E| ≤ Eabs) :
    ‖(E : ℂ) • c - w‖ ≤ Eabs * ‖c‖ + ‖w‖ := by
  calc
    ‖(E : ℂ) • c - w‖ ≤ ‖(E : ℂ) • c‖ + ‖w‖ := norm_sub_le _ _
    _ = |E| * ‖c‖ + ‖w‖ := by
      rw [norm_smul]
      simp [Complex.norm_real]
    _ ≤ Eabs * ‖c‖ + ‖w‖ := by
      simpa [add_comm] using
        (add_le_add_right
          (mul_le_mul_of_nonneg_right hEabs (norm_nonneg c)) ‖w‖)

/-- The pointwise Fourier eigenvalue equation, multiplied by two, identifies
application of the kinetic symbol with twice the restricted right-hand side. -/
lemma diagMul_eq_two_eigen_rhs
    {ι : Type*} [Fintype ι]
    {E : ℝ} (A : ι → ℝ) (c w : EuclideanSpace ℂ ι)
    (hEig : ∀ i,
      (A i : ℂ) * c.ofLp i =
        (2 : ℂ) * ((E : ℂ) * c.ofLp i - w.ofLp i)) :
    diagMul A c = (2 : ℂ) • ((E : ℂ) • c - w) := by
  apply PiLp.ext
  intro i
  simpa [diagMul] using hEig i

/-- Eq. (30) derived from the Fourier eigenvalue equation and the cutoff
lower bound `K^2 <= A_i` on every retained tail index. -/
lemma fourier_boot_t
    {ι : Type*} [Fintype ι]
    {K E Eabs : ℝ} (A : ι → ℝ) (c w : EuclideanSpace ℂ ι)
    (hK0 : 0 ≤ K) (hA0 : ∀ i, 0 ≤ A i)
    (hCut : ∀ i, K ^ 2 ≤ A i)
    (hEabs : |E| ≤ Eabs)
    (hEig : ∀ i,
      (A i : ℂ) * c.ofLp i =
        (2 : ℂ) * ((E : ℂ) * c.ofLp i - w.ofLp i)) :
    K ^ 2 * ‖c‖ ≤ 2 * (Eabs * ‖c‖ + ‖w‖) := by
  have hLower : K ^ 2 * ‖c‖ ≤ ‖diagMul A c‖ :=
    const_mul_norm_le_diagMul_norm c (sq_nonneg K) hA0 hCut
  have hVec := diagMul_eq_two_eigen_rhs A c w hEig
  have hNorm : ‖diagMul A c‖ = 2 * ‖(E : ℂ) • c - w‖ := by
    rw [hVec, norm_smul]
    norm_num
  have hRhs := eigen_rhs_norm_le c w hEabs
  calc
    K ^ 2 * ‖c‖ ≤ ‖diagMul A c‖ := hLower
    _ = 2 * ‖(E : ℂ) • c - w‖ := hNorm
    _ ≤ 2 * (Eabs * ‖c‖ + ‖w‖) := by nlinarith

/-- Eq. (31) derived from the same eigenvalue equation and the pointwise
multiplier estimate `K * k_m <= A`. -/
lemma fourier_boot_s
    {ι : Type*} [Fintype ι]
    {K E Eabs : ℝ} (A d : ι → ℝ) (c w : EuclideanSpace ℂ ι)
    (hK0 : 0 ≤ K) (hd0 : ∀ i, 0 ≤ d i) (hA0 : ∀ i, 0 ≤ A i)
    (hCut : ∀ i, K * d i ≤ A i)
    (hEabs : |E| ≤ Eabs)
    (hEig : ∀ i,
      (A i : ℂ) * c.ofLp i =
        (2 : ℂ) * ((E : ℂ) * c.ofLp i - w.ofLp i)) :
    K * ‖diagMul d c‖ ≤ 2 * (Eabs * ‖c‖ + ‖w‖) := by
  have hLower : K * ‖diagMul d c‖ ≤ ‖diagMul A c‖ :=
    K_mul_diagMul_norm_le c hK0 hd0 hA0 hCut
  have hVec := diagMul_eq_two_eigen_rhs A c w hEig
  have hNorm : ‖diagMul A c‖ = 2 * ‖(E : ℂ) • c - w‖ := by
    rw [hVec, norm_smul]
    norm_num
  have hRhs := eigen_rhs_norm_le c w hEabs
  calc
    K * ‖diagMul d c‖ ≤ ‖diagMul A c‖ := hLower
    _ = 2 * ‖(E : ℂ) • c - w‖ := hNorm
    _ ≤ 2 * (Eabs * ‖c‖ + ‖w‖) := by nlinarith

/-! ## Third milestone: derive the Step-2 tail reduction from finite set coverage -/

/--
A finite union bound for nonnegative Fourier weights.

If every discarded Fourier configuration lies in at least one of the
single-particle tail sets `tail a`, then its total nonnegative weight is at
most the sum of the weights of all single-particle tails.  Overlaps are
allowed and are deliberately over-counted.
-/
lemma sum_discarded_le_sum_particle_tails
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {eta : ℕ}
    (discarded : Finset ι) (tail : Fin eta → Finset ι)
    (f : ι → ℝ)
    (hf : ∀ i, 0 ≤ f i)
    (hCover : ∀ i ∈ discarded, ∃ a : Fin eta, i ∈ tail a) :
    Finset.sum discarded f ≤
      ∑ a : Fin eta, Finset.sum (tail a) f := by
  classical
  let g : ι → ℝ := fun i =>
    ∑ a : Fin eta, if i ∈ tail a then f i else 0

  have hpoint : ∀ i ∈ discarded, f i ≤ g i := by
    intro i hi
    rcases hCover i hi with ⟨a, ha⟩
    have hnonneg :
        ∀ b ∈ (Finset.univ : Finset (Fin eta)),
          0 ≤ (if i ∈ tail b then f i else 0) := by
      intro b hb
      by_cases hbi : i ∈ tail b
      · simp [hbi, hf i]
      · simp [hbi]
    have hsingle :
        (if i ∈ tail a then f i else 0) ≤
          ∑ b : Fin eta, if i ∈ tail b then f i else 0 :=
      Finset.single_le_sum hnonneg (Finset.mem_univ a)
    simpa [g, ha] using hsingle

  have hg0 : ∀ i, 0 ≤ g i := by
    intro i
    dsimp [g]
    exact Finset.sum_nonneg (fun a ha => by
      by_cases hai : i ∈ tail a
      · simp [hai, hf i]
      · simp [hai])

  calc
    Finset.sum discarded f
        ≤ Finset.sum discarded g := by
          exact Finset.sum_le_sum hpoint
    _ ≤ ∑ i : ι, g i := by
          exact Finset.sum_le_univ_sum_of_nonneg hg0
    _ = ∑ a : Fin eta, Finset.sum (tail a) f := by
          simp only [g]
          rw [Finset.sum_comm]
          apply Finset.sum_congr rfl
          intro a ha
          simp

/-! ## Fourth milestone: derive permutation-tail symmetry from antisymmetry -/

/--
A finite many-particle Fourier configuration.  The momentum label type `μ`
is deliberately abstract here; in the physical application it will be a
finite box in `ℤ^3`.
-/
abbrev FourierConfig (eta : ℕ) (μ : Type*) := Fin eta → μ

/--
Swap two particle registers in a Fourier configuration.
-/
def swapConfig {eta : ℕ} {μ : Type*}
    (a r : Fin eta) (p : FourierConfig eta μ) : FourierConfig eta μ :=
  fun m => p ((Equiv.swap a r) m)

@[simp] lemma swapConfig_reference {eta : ℕ} {μ : Type*}
    (a r : Fin eta) (p : FourierConfig eta μ) :
    swapConfig a r p r = p a := by
  simp [swapConfig]

/--
Squared Fourier-coefficient mass.
-/
noncomputable def coeffMass {eta : ℕ} {μ : Type*}
    (coeff : FourierConfig eta μ → ℂ) (p : FourierConfig eta μ) : ℝ :=
  ‖coeff p‖ ^ 2

/--
The derivative contribution from particle `m` to the `H^1` Fourier weight.
-/
noncomputable def coeffDerivMass {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (m : Fin eta) (p : FourierConfig eta μ) : ℝ :=
  (kabs (p m)) ^ 2 * coeffMass coeff p

/--
The sum of all derivative contributions in a Fourier configuration.
-/
noncomputable def coeffTotalDerivMass {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (p : FourierConfig eta μ) : ℝ :=
  ∑ m : Fin eta, coeffDerivMass kabs coeff m p

/--
The one-particle tail set for register `a`.
-/
noncomputable def particleTailFinset
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (a : Fin eta) :
    Finset (FourierConfig eta μ) :=
  Finset.univ.filter (fun p => K < kabs (p a))

/--
The discarded Galerkin configurations: at least one particle register lies
above the cutoff.
-/
noncomputable def discardedConfigFinset
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) :
    Finset (FourierConfig eta μ) :=
  Finset.univ.filter (fun p => ∃ a : Fin eta, K < kabs (p a))

lemma discardedConfig_covered
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) :
    ∀ p ∈ discardedConfigFinset K kabs,
      ∃ a : Fin eta, p ∈ particleTailFinset K kabs a := by
  classical
  intro p hp
  have hex : ∃ a : Fin eta, K < kabs (p a) := by
    simpa [discardedConfigFinset] using hp
  rcases hex with ⟨a, ha⟩
  refine ⟨a, ?_⟩
  simp [particleTailFinset, ha]

/-! ## Fifth milestone: identify the bootstrap vectors with the actual reference tail -/

/--
The Fourier coefficient vector restricted to the reference-particle tail,
represented on the full finite configuration space and set equal to zero
off the tail.
-/
noncomputable def referenceTailVector
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (f : FourierConfig eta μ → ℂ) :
    EuclideanSpace ℂ (FourierConfig eta μ) :=
  WithLp.toLp 2 (fun p => if K < kabs (p r) then f p else 0)

@[simp] lemma referenceTailVector_apply
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (f : FourierConfig eta μ → ℂ) (p : FourierConfig eta μ) :
    (referenceTailVector K kabs r f).ofLp p =
      if K < kabs (p r) then f p else 0 := by
  rfl

/--
The kinetic symbol used on the masked finite vector.  Off the reference
tail its value is immaterial to the eigenvalue equation, so we set it to
`K^2`; this makes the cutoff lower bound globally true.
-/
noncomputable def referenceTailKinetic
    {eta : ℕ} {μ : Type*}
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (kinetic : FourierConfig eta μ → ℝ)
    (p : FourierConfig eta μ) : ℝ :=
  if K < kabs (p r) then kinetic p else K ^ 2

/--
The derivative multiplier on the masked vector.  It is set to zero
off-tail, where the masked coefficient vector is already zero.
-/
noncomputable def referenceTailMomentum
    {eta : ℕ} {μ : Type*}
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (m : Fin eta) (p : FourierConfig eta μ) : ℝ :=
  if K < kabs (p r) then kabs (p m) else 0

/--
The squared Euclidean norm of the masked coefficient vector is exactly the
reference-particle tail mass.
-/
lemma referenceTailVector_norm_sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (f : FourierConfig eta μ → ℂ) :
    ‖referenceTailVector K kabs r f‖ ^ 2 =
      Finset.sum (particleTailFinset K kabs r) (coeffMass f) := by
  classical
  rw [EuclideanSpace.norm_sq_eq]
  simp only [referenceTailVector_apply]
  rw [particleTailFinset, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro p hp
  by_cases h : K < kabs (p r)
  · simp [h, coeffMass]
  · simp [h, coeffMass]

/--
For each particle `m`, the squared norm of the masked derivative vector is
exactly the corresponding derivative-weighted reference-tail sum.
-/
lemma referenceTailMomentum_norm_sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r m : Fin eta)
    (f : FourierConfig eta μ → ℂ) :
    ‖diagMul (referenceTailMomentum K kabs r m)
        (referenceTailVector K kabs r f)‖ ^ 2 =
      Finset.sum (particleTailFinset K kabs r)
        (coeffDerivMass kabs f m) := by
  classical
  rw [diagMul_norm_sq]
  simp only [referenceTailVector_apply]
  rw [particleTailFinset, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro p hp
  by_cases h : K < kabs (p r)
  · simp [referenceTailMomentum, h, coeffDerivMass, coeffMass]
  · simp [referenceTailMomentum, h, coeffDerivMass, coeffMass]

/--
Summing the preceding identity over particle labels identifies the total
derivative tail with the sum of the diagonal-multiplier norms used in the
bootstrap theorem.
-/
lemma referenceTail_totalDeriv_eq_diag_norms
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (f : FourierConfig eta μ → ℂ) :
    Finset.sum (particleTailFinset K kabs r)
        (coeffTotalDerivMass kabs f) =
      ∑ m : Fin eta,
        ‖diagMul (referenceTailMomentum K kabs r m)
          (referenceTailVector K kabs r f)‖ ^ 2 := by
  classical
  unfold coeffTotalDerivMass
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro m hm
  exact (referenceTailMomentum_norm_sq K kabs r m f).symm

/--
Masking the full Fourier eigenvalue equation gives the pointwise eigenvalue
equation required by the finite Euclidean bootstrap.
-/
lemma referenceTail_eigen_equation
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K E : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (kinetic : FourierConfig eta μ → ℝ)
    (coeff potentialCoeff : FourierConfig eta μ → ℂ)
    (hEigFull : ∀ p,
      (kinetic p : ℂ) * coeff p =
        (2 : ℂ) * ((E : ℂ) * coeff p - potentialCoeff p)) :
    ∀ p,
      (referenceTailKinetic K kabs r kinetic p : ℂ) *
          (referenceTailVector K kabs r coeff).ofLp p =
        (2 : ℂ) *
          ((E : ℂ) * (referenceTailVector K kabs r coeff).ofLp p -
            (referenceTailVector K kabs r potentialCoeff).ofLp p) := by
  intro p
  by_cases hp : K < kabs (p r)
  · simp [referenceTailKinetic, referenceTailVector_apply, hp,
      hEigFull p]
  · simp [referenceTailKinetic, referenceTailVector_apply, hp]

lemma referenceTailKinetic_nonneg
    {eta : ℕ} {μ : Type*}
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (kinetic : FourierConfig eta μ → ℝ)
    (hKin0 : ∀ p, 0 ≤ kinetic p) :
    ∀ p, 0 ≤ referenceTailKinetic K kabs r kinetic p := by
  intro p
  by_cases hp : K < kabs (p r)
  · simp [referenceTailKinetic, hp, hKin0 p]
  · simp [referenceTailKinetic, hp, sq_nonneg K]

lemma referenceTailMomentum_nonneg
    {eta : ℕ} {μ : Type*}
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (hk0 : ∀ u, 0 ≤ kabs u) :
    ∀ m p, 0 ≤ referenceTailMomentum K kabs r m p := by
  intro m p
  by_cases hp : K < kabs (p r)
  · simp [referenceTailMomentum, hp, hk0 (p m)]
  · simp [referenceTailMomentum, hp]

lemma referenceTail_cutoff_T
    {eta : ℕ} {μ : Type*}
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (kinetic : FourierConfig eta μ → ℝ)
    (hCut :
      ∀ p, K < kabs (p r) → K ^ 2 ≤ kinetic p) :
    ∀ p, K ^ 2 ≤ referenceTailKinetic K kabs r kinetic p := by
  intro p
  by_cases hp : K < kabs (p r)
  · simp [referenceTailKinetic, hp, hCut p hp]
  · simp [referenceTailKinetic, hp]

/-! ## Sixth milestone: make the BO kinetic symbol explicit -/

/--
The Born--Oppenheimer kinetic symbol appearing after multiplying
`(1/2) |k|^2 c = E c - Wc` by two:
`|k|^2 = sum_a |k_a|^2`.
-/
noncomputable def boKineticSymbol
    {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ) (p : FourierConfig eta μ) : ℝ :=
  ∑ a : Fin eta, (kabs (p a)) ^ 2

lemma boKineticSymbol_nonneg
    {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ) :
    ∀ p : FourierConfig eta μ, 0 ≤ boKineticSymbol kabs p := by
  intro p
  unfold boKineticSymbol
  exact Finset.sum_nonneg (fun a ha => sq_nonneg (kabs (p a)))

/--
Every individual squared particle momentum is bounded by the total kinetic
symbol.
-/
lemma component_sq_le_boKineticSymbol
    {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ) (p : FourierConfig eta μ) (m : Fin eta) :
    (kabs (p m)) ^ 2 ≤ boKineticSymbol kabs p := by
  unfold boKineticSymbol
  exact Finset.single_le_sum
    (fun a ha => sq_nonneg (kabs (p a)))
    (Finset.mem_univ m)

/--
On the reference-particle tail, the total kinetic symbol is at least `K^2`.
This is the first multiplier estimate used in the bootstrap.
-/
lemma boKineticSymbol_cutoff_T
    {eta : ℕ} {μ : Type*}
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (hK0 : 0 ≤ K) (hkabs0 : ∀ u, 0 ≤ kabs u) :
    ∀ p : FourierConfig eta μ,
      K < kabs (p r) → K ^ 2 ≤ boKineticSymbol kabs p := by
  intro p hp
  have hsquare : K ^ 2 ≤ (kabs (p r)) ^ 2 := by
    nlinarith [hkabs0 (p r)]
  exact hsquare.trans (component_sq_le_boKineticSymbol kabs p r)

/-! ## Seventh milestone: remove bookkeeping scalars from the theorem interface -/

/--
The exact squared `L^2` mass discarded by the many-particle Galerkin cutoff.
-/
noncomputable def discardedL2Sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) : ℝ :=
  Finset.sum (discardedConfigFinset K kabs) (coeffMass coeff)

/--
The exact squared `H^1` Fourier mass discarded by the Galerkin cutoff.
-/
noncomputable def discardedH1Sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) : ℝ :=
  Finset.sum (discardedConfigFinset K kabs)
    (fun p => coeffMass coeff p + coeffTotalDerivMass kabs coeff p)

/--
For a normalized state, the squared norm retained by the Galerkin projector
is `1 - ||(1-P) psi||^2`.
-/
noncomputable def retainedNormSq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) : ℝ :=
  1 - discardedL2Sq K kabs coeff

lemma discardedL2Sq_nonneg
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    0 ≤ discardedL2Sq K kabs coeff := by
  unfold discardedL2Sq
  exact Finset.sum_nonneg (fun p hp => by
    unfold coeffMass
    positivity)

lemma discardedH1Sq_nonneg
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    0 ≤ discardedH1Sq K kabs coeff := by
  unfold discardedH1Sq
  exact Finset.sum_nonneg (fun p hp => by
    apply add_nonneg
    · unfold coeffMass
      positivity
    · unfold coeffTotalDerivMass coeffDerivMass coeffMass
      exact Finset.sum_nonneg (fun m hm => by positivity))

/-! ## Eighth milestone: formalize the variational projection identity -/

/--
The full finite Fourier coefficient vector.
-/
noncomputable def fullCoeffVector
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (coeff : FourierConfig eta μ → ℂ) :
    EuclideanSpace ℂ (FourierConfig eta μ) :=
  WithLp.toLp 2 coeff

@[simp] lemma fullCoeffVector_apply
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (coeff : FourierConfig eta μ → ℂ)
    (p : FourierConfig eta μ) :
    (fullCoeffVector coeff).ofLp p = coeff p := by
  rfl

/--
The many-particle Fourier tail `delta = (1-P) psi`.
-/
noncomputable def discardedGalerkinVector
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    EuclideanSpace ℂ (FourierConfig eta μ) :=
  WithLp.toLp 2 (fun p =>
    if p ∈ discardedConfigFinset K kabs then coeff p else 0)

@[simp] lemma discardedGalerkinVector_apply
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (p : FourierConfig eta μ) :
    (discardedGalerkinVector K kabs coeff).ofLp p =
      if p ∈ discardedConfigFinset K kabs then coeff p else 0 := by
  rfl

/--
The Galerkin-retained vector `P psi`, represented by the complementary
Fourier mask.
-/
noncomputable def retainedGalerkinVector
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    EuclideanSpace ℂ (FourierConfig eta μ) :=
  WithLp.toLp 2 (fun p =>
    if p ∈ discardedConfigFinset K kabs then 0 else coeff p)

@[simp] lemma retainedGalerkinVector_apply
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (p : FourierConfig eta μ) :
    (retainedGalerkinVector K kabs coeff).ofLp p =
      if p ∈ discardedConfigFinset K kabs then 0 else coeff p := by
  rfl

lemma fullCoeffVector_eq_retained_add_discarded
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    fullCoeffVector coeff =
      retainedGalerkinVector K kabs coeff +
        discardedGalerkinVector K kabs coeff := by
  ext p
  by_cases hp : p ∈ discardedConfigFinset K kabs
  · simp [hp]
  · simp [hp]

lemma discardedGalerkinVector_norm_sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    ‖discardedGalerkinVector K kabs coeff‖ ^ 2 =
      discardedL2Sq K kabs coeff := by
  classical
  rw [EuclideanSpace.norm_sq_eq]
  unfold discardedL2Sq
  let d : Finset (FourierConfig eta μ) :=
    discardedConfigFinset (eta := eta) K kabs
  change
    (∑ p, ‖if p ∈ d then coeff p else 0‖ ^ 2) =
      Finset.sum d (coeffMass coeff)
  have hd :
      Finset.sum d (coeffMass coeff) =
        ∑ p, if p ∈ d then coeffMass coeff p else 0 := by
    calc
      Finset.sum d (coeffMass coeff)
          = Finset.sum (Finset.univ.filter (fun p => p ∈ d))
              (coeffMass coeff) := by
                apply Finset.sum_congr
                · ext p
                  simp
                · intro p hp
                  rfl
      _ = ∑ p, if p ∈ d then coeffMass coeff p else 0 := by
            rw [Finset.sum_filter]
  rw [hd]
  apply Finset.sum_congr rfl
  intro p hp
  by_cases hpd : p ∈ d
  · simp [hpd, coeffMass]
  · simp [hpd, coeffMass]

lemma retainedGalerkinVector_norm_sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (hNormalized : (∑ p, coeffMass coeff p) = 1) :
    ‖retainedGalerkinVector K kabs coeff‖ ^ 2 =
      retainedNormSq K kabs coeff := by
  classical
  let d : Finset (FourierConfig eta μ) :=
    discardedConfigFinset (eta := eta) K kabs
  have hd :
      discardedL2Sq K kabs coeff =
        ∑ p, if p ∈ d then coeffMass coeff p else 0 := by
    unfold discardedL2Sq
    change Finset.sum d (coeffMass coeff) =
      ∑ p, if p ∈ d then coeffMass coeff p else 0
    calc
      Finset.sum d (coeffMass coeff)
          = Finset.sum (Finset.univ.filter (fun p => p ∈ d))
              (coeffMass coeff) := by
                apply Finset.sum_congr
                · ext p
                  simp
                · intro p hp
                  rfl
      _ = ∑ p, if p ∈ d then coeffMass coeff p else 0 := by
            rw [Finset.sum_filter]

  have hret :
      ‖retainedGalerkinVector K kabs coeff‖ ^ 2 =
        ∑ p, if p ∈ d then 0 else coeffMass coeff p := by
    rw [EuclideanSpace.norm_sq_eq]
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hpd :
        p ∈ discardedConfigFinset (eta := eta) K kabs
    · have hdmem : p ∈ d := by
        simpa [d] using hpd
      simp [retainedGalerkinVector_apply, hpd, hdmem, coeffMass]
    · have hdmem : p ∉ d := by
        simpa [d] using hpd
      simp [retainedGalerkinVector_apply, hpd, hdmem, coeffMass]

  have hpartition :
      (∑ p, if p ∈ d then 0 else coeffMass coeff p) +
        (∑ p, if p ∈ d then coeffMass coeff p else 0) =
        ∑ p, coeffMass coeff p := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hpd : p ∈ d
    · simp [hpd]
    · simp [hpd]

  unfold retainedNormSq
  rw [hret, hd]
  linarith

/--
The shifted sesquilinear form
`B_E(x,y) = <x,Hy> - E <x,y>`.
-/
noncomputable def shiftedSesquilinear
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (E : ℝ) (x y : V) : ℂ :=
  inner ℂ x (H y) - (E : ℂ) * inner ℂ x y

/--
The real shifted quadratic form used in the variational sandwich.
-/
noncomputable def shiftedQuadratic
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (E : ℝ) (x : V) : ℝ :=
  Complex.re (shiftedSesquilinear H E x x)

lemma shiftedSesquilinear_eigen_left
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (hSym : H.IsSymmetric)
    (E : ℝ) (psi y : V)
    (hEig : H psi = (E : ℂ) • psi) :
    shiftedSesquilinear H E psi y = 0 := by
  unfold shiftedSesquilinear
  rw [← hSym psi y, hEig, inner_smul_left]
  simp

lemma shiftedSesquilinear_eigen_right
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V)
    (E : ℝ) (psi x : V)
    (hEig : H psi = (E : ℂ) • psi) :
    shiftedSesquilinear H E x psi = 0 := by
  unfold shiftedSesquilinear
  rw [hEig, inner_smul_right]
  simp

lemma shiftedSesquilinear_sub_sub
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (E : ℝ) (x d : V) :
    shiftedSesquilinear H E (x - d) (x - d) =
      shiftedSesquilinear H E x x -
        shiftedSesquilinear H E x d -
        shiftedSesquilinear H E d x +
        shiftedSesquilinear H E d d := by
  unfold shiftedSesquilinear
  rw [H.map_sub]
  simp only [inner_sub_left, inner_sub_right]
  ring

/--
For a symmetric Hamiltonian and an exact eigenvector, replacing the
projected state `psi - delta` by the discarded tail leaves the shifted
quadratic form unchanged.
-/
lemma shiftedQuadratic_projection_identity
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (hSym : H.IsSymmetric)
    (E : ℝ) (psi delta : V)
    (hEig : H psi = (E : ℂ) • psi) :
    shiftedQuadratic H E (psi - delta) =
      shiftedQuadratic H E delta := by
  have hll :
      shiftedSesquilinear H E psi psi = 0 :=
    shiftedSesquilinear_eigen_left H hSym E psi psi hEig
  have hlr :
      shiftedSesquilinear H E psi delta = 0 :=
    shiftedSesquilinear_eigen_left H hSym E psi delta hEig
  have hrl :
      shiftedSesquilinear H E delta psi = 0 :=
    shiftedSesquilinear_eigen_right H E psi delta hEig
  unfold shiftedQuadratic
  rw [shiftedSesquilinear_sub_sub, hll, hlr, hrl]
  simp

/--
The shifted quadratic form equals the ordinary Rayleigh numerator minus
`E ||u||^2`.
-/
lemma shiftedQuadratic_eq_rayleigh_sub
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (E : ℝ) (u : V) :
    shiftedQuadratic H E u =
      Complex.re (inner ℂ u (H u)) - E * ‖u‖ ^ 2 := by
  have hself : (inner ℂ u u).re = ‖u‖ ^ 2 :=
    inner_self_eq_norm_sq (𝕜 := ℂ) u
  have hmul :
      (((E : ℂ) * inner ℂ u u).re) = E * ‖u‖ ^ 2 := by
    have hEre : (E : ℂ).re = E := rfl
    have hEim : (E : ℂ).im = 0 := rfl
    rw [Complex.mul_re, hEre, hEim, zero_mul, sub_zero, hself]
  unfold shiftedQuadratic shiftedSesquilinear
  rw [Complex.sub_re, hmul]

/--
Rayleigh--Ritz for a trial vector, rewritten after subtracting the exact
eigenvalue `E`.
-/
lemma rayleigh_trial_to_shifted
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (E EN : ℝ) (u : V)
    (hTrial :
      EN * ‖u‖ ^ 2 ≤ Complex.re (inner ℂ u (H u))) :
    (EN - E) * ‖u‖ ^ 2 ≤ shiftedQuadratic H E u := by
  rw [shiftedQuadratic_eq_rayleigh_sub]
  linarith

/-! ## Eighth milestone without exchange symmetry

`bo_fourth_milestone` uses exchange antisymmetry to identify every one-particle
tail with the tail of one reference particle. The variant below uses no
exchange symmetry. It applies the eigenvalue bootstrap to the tail of every
particle separately and passes the largest tail norms to the scalar
bookkeeping of the first milestone. The potential-tail bound is therefore
assumed for every particle, and the constant `64 C1 eta^2 CW^2` is unchanged.
This is the form used for sectors with partial or no exchange antisymmetry.
-/

/-! ## Ninth milestone: variational characterization of the Galerkin energy -/

/--
A vector lies in the retained Galerkin subspace when all Fourier
coefficients in the discarded set vanish.
-/
noncomputable def IsRetainedVector
    {μ : Type*} [Fintype μ] [DecidableEq μ]
    (eta : ℕ) (K : ℝ) (kabs : μ → ℝ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) : Prop :=
  ∀ p : FourierConfig eta μ,
    p ∈ discardedConfigFinset (eta := eta) K kabs → u.ofLp p = 0

lemma retainedGalerkinVector_isRetained
    {μ : Type*} [Fintype μ] [DecidableEq μ]
    (eta : ℕ) (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    IsRetainedVector eta K kabs
      (retainedGalerkinVector K kabs coeff) := by
  unfold IsRetainedVector
  intro p hp
  simp [retainedGalerkinVector_apply, hp]

/-! ## Tenth milestone: connect the operator Hamiltonian to the Fourier bootstrap -/

/--
The Fourier coefficient function of the potential action `W psi`, where
`psi` is represented by `coeff`.
-/
noncomputable def operatorPotentialCoeff
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (W :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ) :
    FourierConfig eta μ → ℂ :=
  fun p => (W (fullCoeffVector coeff)).ofLp p

@[simp] lemma operatorPotentialCoeff_apply
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (W :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (p : FourierConfig eta μ) :
    operatorPotentialCoeff W coeff p =
      (W (fullCoeffVector coeff)).ofLp p := by
  rfl

/-! ## Eleventh milestone: define the BO kinetic and Hamiltonian operators -/

/--
The BO kinetic operator in the finite Fourier basis.  It is diagonal with
symbol

`boKineticSymbol kabs p = sum_a |k_{p_a}|^2`.
-/
noncomputable def boKineticOperator
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ) where
  toFun := fun u => diagMul (boKineticSymbol kabs) u
  map_add' := by
    intro u v
    ext p
    simp [diagMul_apply]
    ring
  map_smul' := by
    intro z u
    ext p
    simp [diagMul_apply]
    ring

@[simp] lemma boKineticOperator_apply
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ))
    (p : FourierConfig eta μ) :
    (boKineticOperator kabs u).ofLp p =
      (boKineticSymbol kabs p : ℂ) * u.ofLp p := by
  rfl

/--
The finite-dimensional Born--Oppenheimer Hamiltonian

`H_BO = (1/2) T + W`.

Here `T` is the explicitly defined diagonal kinetic operator and `W` is an
arbitrary complex-linear potential operator.
-/
noncomputable def boHamiltonian
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (W :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ)) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ) :=
  (1 / 2 : ℂ) • boKineticOperator kabs + W

@[simp] lemma boHamiltonian_apply
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (W :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (u : EuclideanSpace ℂ (FourierConfig eta μ))
    (p : FourierConfig eta μ) :
    (boHamiltonian kabs W u).ofLp p =
      (1 / 2 : ℂ) * (boKineticSymbol kabs p : ℂ) * u.ofLp p +
        (W u).ofLp p := by
  simp [boHamiltonian, boKineticOperator, diagMul_apply]
  ring

/-! ## Twelfth milestone: derive Hamiltonian symmetry from potential symmetry -/

/--
The explicitly defined BO kinetic operator is symmetric.

The proof is coordinatewise: the diagonal symbol
`boKineticSymbol kabs p` is real, so multiplication by it is self-adjoint in
each complex Fourier coordinate.
-/
lemma boKineticOperator_isSymmetric
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ) :
    (boKineticOperator (eta := eta) kabs).IsSymmetric := by
  intro x y
  rw [PiLp.inner_apply, PiLp.inner_apply]
  apply Finset.sum_congr rfl
  intro p hp
  rw [boKineticOperator_apply, boKineticOperator_apply]
  have hcoord :
      inner ℂ
          ((boKineticSymbol kabs p : ℂ) • x.ofLp p)
          (y.ofLp p) =
        inner ℂ
          (x.ofLp p)
          ((boKineticSymbol kabs p : ℂ) • y.ofLp p) := by
    rw [inner_smul_left, inner_smul_right]
    simp
  simpa [smul_eq_mul] using hcoord

/--
The real scalar `1/2`, viewed in `ℂ`, is fixed by complex conjugation.
-/
lemma half_complex_star :
    starRingEnd ℂ (1 / 2 : ℂ) = (1 / 2 : ℂ) := by
  have htwo : starRingEnd ℂ (2 : ℂ) = (2 : ℂ) := by
    simpa using (map_natCast (starRingEnd ℂ) 2)
  simp only [div_eq_mul_inv, one_mul, map_inv₀, htwo]

/--
If the potential operator is symmetric, then the explicit BO Hamiltonian
`(1/2) T + W` is symmetric.
-/
lemma boHamiltonian_isSymmetric
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (W :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (hWSym : W.IsSymmetric) :
    (boHamiltonian kabs W).IsSymmetric := by
  have hT :
      (boKineticOperator (eta := eta) kabs).IsSymmetric :=
    boKineticOperator_isSymmetric kabs
  have hHalfT :
      ((1 / 2 : ℂ) • boKineticOperator (eta := eta) kabs).IsSymmetric :=
    LinearMap.IsSymmetric.smul half_complex_star hT
  unfold boHamiltonian
  exact LinearMap.IsSymmetric.add hHalfT hWSym

/-! ## Thirteenth milestone: split the quadratic-form estimate -/

/--
The derivative-only part of the discarded `H^1` Fourier mass.
-/
noncomputable def discardedDerivSq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) : ℝ :=
  Finset.sum (discardedConfigFinset K kabs)
    (coeffTotalDerivMass kabs coeff)

lemma discardedDerivSq_nonneg
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    0 ≤ discardedDerivSq K kabs coeff := by
  unfold discardedDerivSq
  apply Finset.sum_nonneg
  intro p hp
  unfold coeffTotalDerivMass coeffDerivMass coeffMass
  apply Finset.sum_nonneg
  intro m hm
  positivity

lemma discardedH1Sq_eq_l2_add_deriv
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    discardedH1Sq K kabs coeff =
      discardedL2Sq K kabs coeff + discardedDerivSq K kabs coeff := by
  unfold discardedH1Sq discardedL2Sq discardedDerivSq
  rw [Finset.sum_add_distrib]

lemma discardedL2Sq_le_discardedH1Sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    discardedL2Sq K kabs coeff ≤ discardedH1Sq K kabs coeff := by
  rw [discardedH1Sq_eq_l2_add_deriv]
  exact le_add_of_nonneg_right
    (discardedDerivSq_nonneg K kabs coeff)

lemma discardedDerivSq_le_discardedH1Sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    discardedDerivSq K kabs coeff ≤ discardedH1Sq K kabs coeff := by
  rw [discardedH1Sq_eq_l2_add_deriv]
  exact le_add_of_nonneg_left
    (discardedL2Sq_nonneg K kabs coeff)

/--
The diagonal kinetic symbol times the coefficient mass is exactly the total
first-derivative Fourier mass of that configuration.
-/
lemma boKineticSymbol_mul_coeffMass
    {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (p : FourierConfig eta μ) :
    boKineticSymbol kabs p * coeffMass coeff p =
      coeffTotalDerivMass kabs coeff p := by
  unfold boKineticSymbol coeffTotalDerivMass coeffDerivMass
  rw [Finset.sum_mul]

/--
For one Fourier configuration, the kinetic-coordinate inner product equals
the total derivative mass of that configuration.
-/
lemma boKinetic_coeff_inner
    {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (p : FourierConfig eta μ) :
    inner ℂ (coeff p)
        ((boKineticSymbol kabs p : ℂ) * coeff p) =
      (coeffTotalDerivMass kabs coeff p : ℂ) := by
  rw [← smul_eq_mul, inner_smul_right]
  rw [inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (coeff p)]
  have hreal :
      boKineticSymbol kabs p * ‖coeff p‖ ^ 2 =
        coeffTotalDerivMass kabs coeff p := by
    simpa [coeffMass] using
      (boKineticSymbol_mul_coeffMass kabs coeff p)
  have hcomplex :
      ((boKineticSymbol kabs p * ‖coeff p‖ ^ 2 : ℝ) : ℂ) =
        (coeffTotalDerivMass kabs coeff p : ℂ) :=
    congrArg (fun x : ℝ => (x : ℂ)) hreal
  push_cast at hcomplex
  exact hcomplex

/--
The kinetic quadratic form of the discarded Fourier vector is exactly its
derivative-only Fourier mass.
-/
lemma discarded_kinetic_inner
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    inner ℂ
        (discardedGalerkinVector K kabs coeff)
        (boKineticOperator kabs
          (discardedGalerkinVector K kabs coeff)) =
      (discardedDerivSq K kabs coeff : ℂ) := by
  classical
  let d : Finset (FourierConfig eta μ) :=
    discardedConfigFinset (eta := eta) K kabs
  let delta := discardedGalerkinVector K kabs coeff
  rw [PiLp.inner_apply]
  calc
    (∑ p,
        inner ℂ (delta.ofLp p)
          ((boKineticOperator kabs delta).ofLp p))
        =
      ∑ p,
        if p ∈ d then
          (coeffTotalDerivMass kabs coeff p : ℂ)
        else 0 := by
          apply Finset.sum_congr rfl
          intro p hp
          by_cases hpd : p ∈ d
          · have hpd' :
                p ∈ discardedConfigFinset (eta := eta) K kabs := by
              simpa [d] using hpd
            rw [if_pos hpd]
            simp only [delta, discardedGalerkinVector_apply, hpd',
              boKineticOperator_apply]
            simp only [if_pos]
            exact boKinetic_coeff_inner kabs coeff p
          · have hpd' :
                p ∉ discardedConfigFinset (eta := eta) K kabs := by
              simpa [d] using hpd
            rw [if_neg hpd]
            simp [delta, discardedGalerkinVector_apply, hpd',
              boKineticOperator_apply]
    _ =
      Finset.sum d
        (fun p => (coeffTotalDerivMass kabs coeff p : ℂ)) := by
          rw [← Finset.sum_filter]
          simp
    _ = (discardedDerivSq K kabs coeff : ℂ) := by
          unfold discardedDerivSq
          simp [d]

/--
The potential contribution to the quadratic form.
-/
noncomputable def potentialQuadratic
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (W : V →ₗ[ℂ] V) (u : V) : ℝ :=
  Complex.re (inner ℂ u (W u))

/-! ## Fourteenth milestone: decompose the potential-tail lemma -/

/--
The Fourier projector onto configurations whose reference-particle momentum
lies above `K`.
-/
noncomputable def referenceTailOperator
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ) where
  toFun := fun u =>
    WithLp.toLp 2 (fun p => if K < kabs (p r) then u.ofLp p else 0)
  map_add' := by
    intro u v
    ext p
    by_cases hp : K < kabs (p r)
    · simp [hp]
    · simp [hp]
  map_smul' := by
    intro z u
    ext p
    by_cases hp : K < kabs (p r)
    · simp [hp]
    · simp [hp]

@[simp] lemma referenceTailOperator_apply
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (u : EuclideanSpace ℂ (FourierConfig eta μ))
    (p : FourierConfig eta μ) :
    (referenceTailOperator K kabs r u).ofLp p =
      if K < kabs (p r) then u.ofLp p else 0 := by
  rfl

lemma referenceTailOperator_fullCoeffVector
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (f : FourierConfig eta μ → ℂ) :
    referenceTailOperator K kabs r (fullCoeffVector f) =
      referenceTailVector K kabs r f := by
  ext p
  rfl

lemma referenceTailOperator_potential
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (W :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ) :
    referenceTailOperator K kabs r
        (W (fullCoeffVector coeff)) =
      referenceTailVector K kabs r (operatorPotentialCoeff W coeff) := by
  ext p
  rfl

/--
A Fourier tail projector is a contraction in the Euclidean norm.
-/
lemma referenceTailOperator_norm_sq_le
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖referenceTailOperator K kabs r u‖ ^ 2 ≤ ‖u‖ ^ 2 := by
  classical
  rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq]
  apply Finset.sum_le_sum
  intro p hp
  by_cases htail : K < kabs (p r)
  · simp [referenceTailOperator_apply, htail]
  · simp [referenceTailOperator_apply, htail]

lemma referenceTailOperator_norm_le
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖referenceTailOperator K kabs r u‖ ≤ ‖u‖ := by
  have hsquare :=
    referenceTailOperator_norm_sq_le K kabs r u
  have hleft : 0 ≤ ‖referenceTailOperator K kabs r u‖ := norm_nonneg _
  have hright : 0 ≤ ‖u‖ := norm_nonneg _
  nlinarith

/--
Terms of the potential that do not involve the reference particle commute
with the reference-particle Fourier tail projector.  This predicate isolates
the structural statement used in part (a) of the potential-tail lemma.
-/
def CommutesWithReferenceTail
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (A :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ)) : Prop :=
  ∀ u,
    referenceTailOperator K kabs r (A u) =
      A (referenceTailOperator K kabs r u)

/--
A low-pass potential involving the reference particle cannot create output
above `K` from input whose reference momentum is at most `K/2`.

This is the operator form of the support argument in part (b) of the
potential-tail lemma.
-/
def HasLowPassReferenceSupport
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (A :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ)) : Prop :=
  ∀ u,
    referenceTailOperator K kabs r (A u) =
      referenceTailOperator K kabs r
        (A (referenceTailOperator (K / 2) kabs r u))

/-! ## Fifteenth milestone: formalize the a-priori H2 Fourier-tail estimate -/

/--
The finite Fourier representation of the squared `H^2` norm,
with weight `(1 + |k|^2)^2`.
-/
noncomputable def fullH2Sq
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) : ℝ :=
  ∑ p : FourierConfig eta μ,
    (1 + boKineticSymbol kabs p) ^ 2 * coeffMass coeff p

/--
The reference-particle high-pass contribution to the squared `H^1` norm.
-/
noncomputable def referenceTailH1Sq
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (coeff : FourierConfig eta μ → ℂ) : ℝ :=
  Finset.sum (particleTailFinset K kabs r)
    (fun p => (1 + boKineticSymbol kabs p) * coeffMass coeff p)

lemma fullH2Sq_nonneg
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    0 ≤ fullH2Sq kabs coeff := by
  unfold fullH2Sq
  apply Finset.sum_nonneg
  intro p hp
  exact mul_nonneg (sq_nonneg _) (by
    unfold coeffMass
    positivity)

/--
The standard a-priori Fourier tail estimate:
on `|k_r| > K`, the `H^2` weight controls `K^4` times the `L^2` mass.

This is the squared form of
`||psi_{>K}|| <= K^{-2} ||psi||_{H^2}`.
-/
lemma referenceTail_l2_h2_scaled
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (coeff : FourierConfig eta μ → ℂ)
    (hK0 : 0 ≤ K)
    (hkabs0 : ∀ u, 0 ≤ kabs u) :
    K ^ 4 * ‖referenceTailVector K kabs r coeff‖ ^ 2 ≤
      fullH2Sq kabs coeff := by
  classical
  let d : Finset (FourierConfig eta μ) :=
    particleTailFinset K kabs r
  rw [referenceTailVector_norm_sq]
  have hTail :
      K ^ 4 * Finset.sum d (coeffMass coeff) ≤
        Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p) := by
    calc
      K ^ 4 * Finset.sum d (coeffMass coeff) =
          Finset.sum d (fun p => K ^ 4 * coeffMass coeff p) := by
            rw [Finset.mul_sum]
      _ ≤ Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p) := by
            apply Finset.sum_le_sum
            intro p hp
            have hpTail : K < kabs (p r) := by
              simpa [d, particleTailFinset] using hp
            have hA :
                K ^ 2 ≤ boKineticSymbol kabs p :=
              boKineticSymbol_cutoff_T
                K kabs r hK0 hkabs0 p hpTail
            have hA0 :
                0 ≤ boKineticSymbol kabs p :=
              boKineticSymbol_nonneg kabs p
            have hbase :
                K ^ 2 ≤ 1 + boKineticSymbol kabs p := by
              linarith
            have hsq :
                K ^ 4 ≤
                  (1 + boKineticSymbol kabs p) ^ 2 := by
              have hs :=
                sq_le_sq_of_nonneg (sq_nonneg K) hbase
              nlinarith
            exact mul_le_mul_of_nonneg_right hsq (by
              unfold coeffMass
              positivity)
  have hSubset :
      Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p) ≤
        fullH2Sq kabs coeff := by
    unfold fullH2Sq
    calc
      Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p)
          =
        ∑ p : FourierConfig eta μ,
          if p ∈ d then
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p
          else 0 := by
            calc
              Finset.sum d
                  (fun p =>
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p)
                  =
                Finset.sum
                  (Finset.univ.filter (fun p => p ∈ d))
                  (fun p =>
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p) := by
                    apply Finset.sum_congr
                    · ext p
                      simp
                    · intro p hp
                      rfl
              _ = ∑ p : FourierConfig eta μ,
                  if p ∈ d then
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p
                  else 0 := by
                    rw [Finset.sum_filter]
      _ ≤ ∑ p : FourierConfig eta μ,
          (1 + boKineticSymbol kabs p) ^ 2 *
            coeffMass coeff p := by
            apply Finset.sum_le_sum
            intro p hp
            by_cases hpd : p ∈ d
            · simp [hpd]
            · have hnonneg :
                  0 ≤
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p := by
                exact mul_nonneg (sq_nonneg _) (by
                  unfold coeffMass
                  positivity)
              simp [hpd, hnonneg]
  exact le_trans hTail hSubset

/--
The corresponding high-pass `H^1` estimate:
`K^2 ||psi_{>K}||_{H^1}^2 <= ||psi||_{H^2}^2`.
-/
lemma referenceTail_h1_h2_scaled
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (coeff : FourierConfig eta μ → ℂ)
    (hK0 : 0 ≤ K)
    (hkabs0 : ∀ u, 0 ≤ kabs u) :
    K ^ 2 * referenceTailH1Sq K kabs r coeff ≤
      fullH2Sq kabs coeff := by
  classical
  let d : Finset (FourierConfig eta μ) :=
    particleTailFinset K kabs r
  have hTail :
      K ^ 2 * referenceTailH1Sq K kabs r coeff ≤
        Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p) := by
    unfold referenceTailH1Sq
    change
      K ^ 2 *
          Finset.sum d
            (fun p =>
              (1 + boKineticSymbol kabs p) *
                coeffMass coeff p) ≤
        Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p)
    calc
      K ^ 2 *
          Finset.sum d
            (fun p =>
              (1 + boKineticSymbol kabs p) *
                coeffMass coeff p)
          =
        Finset.sum d
          (fun p =>
            K ^ 2 *
              ((1 + boKineticSymbol kabs p) *
                coeffMass coeff p)) := by
            rw [Finset.mul_sum]
      _ ≤ Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p) := by
            apply Finset.sum_le_sum
            intro p hp
            have hpTail : K < kabs (p r) := by
              simpa [d, particleTailFinset] using hp
            have hA :
                K ^ 2 ≤ boKineticSymbol kabs p :=
              boKineticSymbol_cutoff_T
                K kabs r hK0 hkabs0 p hpTail
            have hweight0 :
                0 ≤ 1 + boKineticSymbol kabs p := by
              have hA0 :
                  0 ≤ boKineticSymbol kabs p :=
                boKineticSymbol_nonneg kabs p
              linarith
            have hbase :
                K ^ 2 ≤ 1 + boKineticSymbol kabs p := by
              linarith
            have hmass0 : 0 ≤ coeffMass coeff p := by
              unfold coeffMass
              positivity
            calc
              K ^ 2 *
                    ((1 + boKineticSymbol kabs p) *
                      coeffMass coeff p)
                  ≤
                (1 + boKineticSymbol kabs p) *
                    ((1 + boKineticSymbol kabs p) *
                      coeffMass coeff p) := by
                      exact mul_le_mul_of_nonneg_right hbase
                        (mul_nonneg hweight0 hmass0)
              _ =
                (1 + boKineticSymbol kabs p) ^ 2 *
                  coeffMass coeff p := by ring
  have hSubset :
      Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p) ≤
        fullH2Sq kabs coeff := by
    unfold fullH2Sq
    calc
      Finset.sum d
          (fun p =>
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p)
          =
        ∑ p : FourierConfig eta μ,
          if p ∈ d then
            (1 + boKineticSymbol kabs p) ^ 2 *
              coeffMass coeff p
          else 0 := by
            calc
              Finset.sum d
                  (fun p =>
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p)
                  =
                Finset.sum
                  (Finset.univ.filter (fun p => p ∈ d))
                  (fun p =>
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p) := by
                    apply Finset.sum_congr
                    · ext p
                      simp
                    · intro p hp
                      rfl
              _ = ∑ p : FourierConfig eta μ,
                  if p ∈ d then
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p
                  else 0 := by
                    rw [Finset.sum_filter]
      _ ≤ ∑ p : FourierConfig eta μ,
          (1 + boKineticSymbol kabs p) ^ 2 *
            coeffMass coeff p := by
            apply Finset.sum_le_sum
            intro p hp
            by_cases hpd : p ∈ d
            · simp [hpd]
            · have hnonneg :
                  0 ≤
                    (1 + boKineticSymbol kabs p) ^ 2 *
                      coeffMass coeff p := by
                exact mul_nonneg (sq_nonneg _) (by
                  unfold coeffMass
                  positivity)
              simp [hpd, hnonneg]
  exact le_trans hTail hSubset

/--
Linear-norm form of the `H^2 -> L^2` tail estimate, with an explicit bound
`M2` on the full `H^2` norm.
-/
lemma referenceTail_l2_norm_of_h2_bound
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K M2 : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (coeff : FourierConfig eta μ → ℂ)
    (hK0 : 0 ≤ K)
    (hkabs0 : ∀ u, 0 ≤ kabs u)
    (hM20 : 0 ≤ M2)
    (hH2 : fullH2Sq kabs coeff ≤ M2 ^ 2) :
    K ^ 2 * ‖referenceTailVector K kabs r coeff‖ ≤ M2 := by
  have hscaled :=
    referenceTail_l2_h2_scaled K kabs r coeff hK0 hkabs0
  have hsq :
      (K ^ 2 * ‖referenceTailVector K kabs r coeff‖) ^ 2 ≤
        M2 ^ 2 := by
    calc
      (K ^ 2 * ‖referenceTailVector K kabs r coeff‖) ^ 2 =
          K ^ 4 * ‖referenceTailVector K kabs r coeff‖ ^ 2 := by ring
      _ ≤ fullH2Sq kabs coeff := hscaled
      _ ≤ M2 ^ 2 := hH2
  have hleft0 :
      0 ≤ K ^ 2 * ‖referenceTailVector K kabs r coeff‖ := by
    positivity
  nlinarith

/--
The manuscript's low-pass estimate follows from:
* the low-pass operator norm growing at most linearly in `K`;
* the `H^2` a-priori tail bound at cutoff `K/2`.

The exact relation `rho^2 K = 1` identifies `rho^2` with `K^{-1}` without
introducing division into the certificate.
-/
lemma low_pass_bound_from_h2_tail
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K rho Blow M2 : ℝ)
    (kabs : μ → ℝ) (r : Fin eta)
    (coeff : FourierConfig eta μ → ℂ)
    (Wlow :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (hK1 : 1 ≤ K)
    (hRhoScaleEq : rho ^ 2 * K = 1)
    (hkabs0 : ∀ u, 0 ≤ kabs u)
    (hBlow0 : 0 ≤ Blow)
    (hM20 : 0 ≤ M2)
    (hH2 : fullH2Sq kabs coeff ≤ M2 ^ 2)
    (hLowOp :
      ∀ u : EuclideanSpace ℂ (FourierConfig eta μ),
        ‖referenceTailOperator K kabs r (Wlow u)‖ ≤
          Blow * K * ‖u‖) :
    ‖referenceTailOperator K kabs r
        (Wlow
          (referenceTailOperator (K / 2) kabs r
            (fullCoeffVector coeff)))‖ ≤
      (4 * Blow * M2) * rho ^ 2 := by

  have hK0 : 0 ≤ K := le_trans (by norm_num) hK1
  have hKpos : 0 < K := lt_of_lt_of_le (by norm_num) hK1
  let tailHalf :=
    referenceTailOperator (K / 2) kabs r (fullCoeffVector coeff)

  have hTailId :
      tailHalf = referenceTailVector (K / 2) kabs r coeff := by
    simpa [tailHalf] using
      referenceTailOperator_fullCoeffVector (K / 2) kabs r coeff

  have hHalf0 : 0 ≤ K / 2 := by positivity

  have hTailScaled :
      (K / 2) ^ 2 * ‖tailHalf‖ ≤ M2 := by
    rw [hTailId]
    exact referenceTail_l2_norm_of_h2_bound
      (K / 2) M2 kabs r coeff hHalf0 hkabs0 hM20 hH2

  have hK2Tail :
      K ^ 2 * ‖tailHalf‖ ≤ 4 * M2 := by
    nlinarith

  have hLowRaw :
      ‖referenceTailOperator K kabs r (Wlow tailHalf)‖ ≤
        Blow * K * ‖tailHalf‖ :=
    hLowOp tailHalf

  have hLowK :
      K * ‖referenceTailOperator K kabs r (Wlow tailHalf)‖ ≤
        4 * Blow * M2 := by
    calc
      K * ‖referenceTailOperator K kabs r (Wlow tailHalf)‖
          ≤ K * (Blow * K * ‖tailHalf‖) :=
            mul_le_mul_of_nonneg_left hLowRaw hK0
      _ = Blow * (K ^ 2 * ‖tailHalf‖) := by ring
      _ ≤ Blow * (4 * M2) :=
            mul_le_mul_of_nonneg_left hK2Tail hBlow0
      _ = 4 * Blow * M2 := by ring

  have hRhsK :
      ((4 * Blow * M2) * rho ^ 2) * K =
        4 * Blow * M2 := by
    calc
      ((4 * Blow * M2) * rho ^ 2) * K =
          (4 * Blow * M2) * (rho ^ 2 * K) := by ring
      _ = 4 * Blow * M2 := by rw [hRhoScaleEq]; ring

  have hLowDesired :
      ‖referenceTailOperator K kabs r (Wlow tailHalf)‖ ≤
        (4 * Blow * M2) * rho ^ 2 := by
    by_contra hnot
    have hgt :
        (4 * Blow * M2) * rho ^ 2 <
          ‖referenceTailOperator K kabs r (Wlow tailHalf)‖ :=
      lt_of_not_ge hnot
    have hmulgt :=
      mul_lt_mul_of_pos_right hgt hKpos
    rw [hRhsK] at hmulgt
    linarith

  simpa [tailHalf] using hLowDesired

/-! ## Sixteenth milestone: derive the far-term bound from an H1 Hardy estimate -/

/--
The finite Fourier representation of the squared `H^1` norm of an arbitrary
vector.
-/
noncomputable def fourierH1Sq
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) : ℝ :=
  ∑ p : FourierConfig eta μ,
    (1 + boKineticSymbol kabs p) * ‖u.ofLp p‖ ^ 2

lemma fourierH1Sq_nonneg
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    0 ≤ fourierH1Sq kabs u := by
  unfold fourierH1Sq
  apply Finset.sum_nonneg
  intro p hp
  have hA : 0 ≤ boKineticSymbol kabs p :=
    boKineticSymbol_nonneg kabs p
  have hweight : 0 ≤ 1 + boKineticSymbol kabs p := by
    linarith
  exact mul_nonneg hweight (sq_nonneg _)

/--
The `H^1` Fourier norm of the explicit reference-tail vector is exactly the
previously defined reference-tail `H^1` mass.
-/
lemma fourierH1Sq_referenceTail
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta)
    (coeff : FourierConfig eta μ → ℂ) :
    fourierH1Sq kabs
        (referenceTailOperator K kabs r (fullCoeffVector coeff)) =
      referenceTailH1Sq K kabs r coeff := by
  classical
  let d : Finset (FourierConfig eta μ) :=
    particleTailFinset K kabs r
  unfold fourierH1Sq referenceTailH1Sq
  change
    (∑ p : FourierConfig eta μ,
      (1 + boKineticSymbol kabs p) *
        ‖(referenceTailOperator K kabs r
            (fullCoeffVector coeff)).ofLp p‖ ^ 2) =
      Finset.sum d
        (fun p =>
          (1 + boKineticSymbol kabs p) * coeffMass coeff p)
  calc
    (∑ p : FourierConfig eta μ,
      (1 + boKineticSymbol kabs p) *
        ‖(referenceTailOperator K kabs r
            (fullCoeffVector coeff)).ofLp p‖ ^ 2)
        =
      ∑ p : FourierConfig eta μ,
        if p ∈ d then
          (1 + boKineticSymbol kabs p) * coeffMass coeff p
        else 0 := by
          apply Finset.sum_congr rfl
          intro p hp
          by_cases hpd : p ∈ d
          · have htail : K < kabs (p r) := by
              simpa [d, particleTailFinset] using hpd
            simp [referenceTailOperator_apply, htail, hpd, coeffMass]
          · have htail : ¬ K < kabs (p r) := by
              simpa [d, particleTailFinset] using hpd
            simp [referenceTailOperator_apply, htail, hpd, coeffMass]
    _ =
      Finset.sum d
        (fun p =>
          (1 + boKineticSymbol kabs p) * coeffMass coeff p) := by
          rw [← Finset.sum_filter]
          apply Finset.sum_congr
          · ext p
            simp
          · intro p hp
            rfl

/--
Squared Hardy/form interface for potential terms that do not involve the
reference particle.

For the physical Coulomb terms this is the finite-Fourier analogue of
`||w u|| <= Bfar ||u||_{H^1}`.
-/
def HasH1OperatorBound
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (A :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (B : ℝ) : Prop :=
  ∀ u : EuclideanSpace ℂ (FourierConfig eta μ),
    ‖A u‖ ^ 2 ≤ B ^ 2 * fourierH1Sq kabs u

/--
The Hardy `H^1` operator estimate plus the a-priori `H^2` tail estimate
implies the manuscript's `O(K^{-1})` far-term bound.

The exact scale relation `rho^2 K = 1` is used instead of division:
the proof first establishes

`K * ||Wfar psi_{>K}|| <= Bfar * M2`

and then converts this to

`||Wfar psi_{>K}|| <= Bfar * M2 * rho^2`.
-/
lemma far_bound_from_h1_h2_tail
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K rho Bfar M2 : ℝ)
    (kabs : μ → ℝ) (r : Fin eta)
    (coeff : FourierConfig eta μ → ℂ)
    (Wfar :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (hK1 : 1 ≤ K)
    (hRhoScaleEq : rho ^ 2 * K = 1)
    (hkabs0 : ∀ u, 0 ≤ kabs u)
    (hBfar0 : 0 ≤ Bfar)
    (hM20 : 0 ≤ M2)
    (hH2 : fullH2Sq kabs coeff ≤ M2 ^ 2)
    (hHardy : HasH1OperatorBound kabs Wfar Bfar) :
    ‖Wfar
        (referenceTailOperator K kabs r
          (fullCoeffVector coeff))‖ ≤
      (Bfar * M2) * rho ^ 2 := by

  let tail :=
    referenceTailOperator K kabs r (fullCoeffVector coeff)
  have hK0 : 0 ≤ K := le_trans (by norm_num) hK1
  have hKpos : 0 < K := lt_of_lt_of_le (by norm_num) hK1

  have hTailH1 :
      K ^ 2 * fourierH1Sq kabs tail ≤ M2 ^ 2 := by
    rw [fourierH1Sq_referenceTail K kabs r coeff]
    exact le_trans
      (referenceTail_h1_h2_scaled K kabs r coeff hK0 hkabs0)
      hH2

  have hHardyTail :
      ‖Wfar tail‖ ^ 2 ≤
        Bfar ^ 2 * fourierH1Sq kabs tail := by
    exact hHardy tail

  have hBsq0 : 0 ≤ Bfar ^ 2 := sq_nonneg Bfar
  have hKsq0 : 0 ≤ K ^ 2 := sq_nonneg K

  have h1 :
      K ^ 2 * ‖Wfar tail‖ ^ 2 ≤
        K ^ 2 * (Bfar ^ 2 * fourierH1Sq kabs tail) :=
    mul_le_mul_of_nonneg_left hHardyTail hKsq0

  have h2 :
      K ^ 2 * (Bfar ^ 2 * fourierH1Sq kabs tail) ≤
        Bfar ^ 2 * M2 ^ 2 := by
    calc
      K ^ 2 * (Bfar ^ 2 * fourierH1Sq kabs tail)
          =
        Bfar ^ 2 *
          (K ^ 2 * fourierH1Sq kabs tail) := by ring
      _ ≤ Bfar ^ 2 * M2 ^ 2 :=
        mul_le_mul_of_nonneg_left hTailH1 hBsq0

  have hSquare :
      (K * ‖Wfar tail‖) ^ 2 ≤ (Bfar * M2) ^ 2 := by
    nlinarith [le_trans h1 h2]

  have hLeft0 : 0 ≤ K * ‖Wfar tail‖ := by positivity
  have hRight0 : 0 ≤ Bfar * M2 :=
    mul_nonneg hBfar0 hM20
  have hScaled :
      K * ‖Wfar tail‖ ≤ Bfar * M2 := by
    nlinarith

  have hRhsK :
      ((Bfar * M2) * rho ^ 2) * K = Bfar * M2 := by
    calc
      ((Bfar * M2) * rho ^ 2) * K =
          (Bfar * M2) * (rho ^ 2 * K) := by ring
      _ = Bfar * M2 := by rw [hRhoScaleEq]; ring

  by_contra hnot
  have hgt :
      (Bfar * M2) * rho ^ 2 < ‖Wfar tail‖ :=
    lt_of_not_ge hnot
  have hmulgt := mul_lt_mul_of_pos_left hgt hKpos
  have hleftRewrite :
      K * ((Bfar * M2) * rho ^ 2) = Bfar * M2 := by
    calc
      K * ((Bfar * M2) * rho ^ 2)
          = ((Bfar * M2) * rho ^ 2) * K := by ring
      _ = Bfar * M2 := hRhsK
  rw [hleftRewrite] at hmulgt
  linarith

/-! ## Seventeenth milestone: derive the high-pass Coulomb remainder bound -/

/--
Abstract squared `L^2` size of the high-pass Coulomb kernel.

In the continuum proof this scalar is
`||w_>||_{L^2(T^3)}^2`.  We keep it as an explicit nonnegative real at this
stage, so that the lattice-tail estimate and the slice-Sobolev estimate can
be formalized separately.
-/
def HighPassKernelTailSq (Q : ℝ) : Prop :=
  0 ≤ Q

/--
The manuscript's slice-Sobolev/Fubini estimate for the high-pass potential
remainder, written in squared form.

For the physical Coulomb operator this corresponds to

`||w_> psi||^2 <= Cs^2 ||w_>||_L2^2 ||psi||_H2^2`.
-/
def HasHighPassSliceBound
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (Cs kernelTailSq : ℝ) : Prop :=
  ‖Whigh (fullCoeffVector coeff)‖ ^ 2 ≤
    Cs ^ 2 * kernelTailSq * fullH2Sq kabs coeff

/--
The `K^{-1}` lattice-tail estimate for the squared `L^2` norm of the
high-pass Coulomb kernel, encoded without division:

`K * ||w_>||_L2^2 <= Bker^2`.
-/
def HasKernelL2TailBound
    (K kernelTailSq Bker : ℝ) : Prop :=
  kernelTailSq * K ≤ Bker ^ 2

/--
The high-pass Coulomb remainder has the required `K^{-1/2}` norm scaling.

This is the algebraic combination of the two analytic estimates appearing
in part (c) of the potential-tail lemma:

* `kernelTailSq * K <= Bker^2`;
* `||Whigh psi||^2 <= Cs^2 kernelTailSq ||psi||_H2^2`.

With `rho^2 K = 1`, Lean derives

`||Whigh psi|| <= Cs Bker M2 rho`.
-/
lemma high_pass_bound_from_kernel_and_slice
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (K rho Cs Bker M2 kernelTailSq : ℝ)
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (hK1 : 1 ≤ K)
    (hRho0 : 0 ≤ rho)
    (hRhoScaleEq : rho ^ 2 * K = 1)
    (hCs0 : 0 ≤ Cs)
    (hBker0 : 0 ≤ Bker)
    (hM20 : 0 ≤ M2)
    (hKernel0 : HighPassKernelTailSq kernelTailSq)
    (hKernelTail :
      HasKernelL2TailBound K kernelTailSq Bker)
    (hH2 : fullH2Sq kabs coeff ≤ M2 ^ 2)
    (hSlice :
      HasHighPassSliceBound kabs Whigh coeff Cs kernelTailSq) :
    ‖Whigh (fullCoeffVector coeff)‖ ≤
      (Cs * Bker * M2) * rho := by

  have hK0 : 0 ≤ K := le_trans (by norm_num) hK1
  have hKpos : 0 < K := lt_of_lt_of_le (by norm_num) hK1
  have hQ0 : 0 ≤ kernelTailSq := hKernel0
  have hH20 : 0 ≤ fullH2Sq kabs coeff :=
    fullH2Sq_nonneg kabs coeff
  have hSlice' :
      ‖Whigh (fullCoeffVector coeff)‖ ^ 2 ≤
        Cs ^ 2 * kernelTailSq * fullH2Sq kabs coeff :=
    hSlice
  have hKernelTail' :
      kernelTailSq * K ≤ Bker ^ 2 :=
    hKernelTail

  have hScaled :
      K * ‖Whigh (fullCoeffVector coeff)‖ ^ 2 ≤
        (Cs * Bker * M2) ^ 2 := by
    calc
      K * ‖Whigh (fullCoeffVector coeff)‖ ^ 2
          ≤ K *
              (Cs ^ 2 * kernelTailSq *
                fullH2Sq kabs coeff) :=
            mul_le_mul_of_nonneg_left hSlice' hK0
      _ =
          Cs ^ 2 * (kernelTailSq * K) *
            fullH2Sq kabs coeff := by ring
      _ ≤
          Cs ^ 2 * Bker ^ 2 *
            fullH2Sq kabs coeff := by
            have h1 :
                Cs ^ 2 * (kernelTailSq * K) ≤
                  Cs ^ 2 * Bker ^ 2 :=
              mul_le_mul_of_nonneg_left hKernelTail'
                (sq_nonneg Cs)
            exact mul_le_mul_of_nonneg_right h1 hH20
      _ ≤ Cs ^ 2 * Bker ^ 2 * M2 ^ 2 := by
            exact mul_le_mul_of_nonneg_left hH2
              (mul_nonneg (sq_nonneg Cs) (sq_nonneg Bker))
      _ = (Cs * Bker * M2) ^ 2 := by ring

  let C := Cs * Bker * M2
  have hC0 : 0 ≤ C := by
    dsimp [C]
    positivity
  have hNorm0 :
      0 ≤ ‖Whigh (fullCoeffVector coeff)‖ := norm_nonneg _

  by_contra hnot
  have hgt :
      C * rho < ‖Whigh (fullCoeffVector coeff)‖ := by
    simpa [C] using lt_of_not_ge hnot
  have hCrho0 : 0 ≤ C * rho :=
    mul_nonneg hC0 hRho0
  have hsqgt :
      (C * rho) ^ 2 <
        ‖Whigh (fullCoeffVector coeff)‖ ^ 2 := by
    nlinarith
  have hmulgt :=
    mul_lt_mul_of_pos_left hsqgt hKpos
  have hRhs :
      K * (C * rho) ^ 2 = C ^ 2 := by
    calc
      K * (C * rho) ^ 2 =
          C ^ 2 * (rho ^ 2 * K) := by ring
      _ = C ^ 2 := by rw [hRhoScaleEq]; ring
  have hScaledC :
      K * ‖Whigh (fullCoeffVector coeff)‖ ^ 2 ≤ C ^ 2 := by
    simpa [C] using hScaled
  rw [hRhs] at hmulgt
  linarith

/-! ## Eighteenth milestone: finite-shell proof of the Coulomb lattice tail -/

/--
A finite tail written as consecutive radial-shell masses, starting at shell
`m` and containing `count` shells.
-/
noncomputable def shellTailMass
    (shellMass : ℕ → ℝ) (m count : ℕ) : ℝ :=
  Finset.sum (Finset.range count) (fun j => shellMass (m + j))

/--
A telescoping envelope for consecutive shell masses.

The condition says that each shell is bounded by the drop of a nonnegative
budget sequence.  This is the abstract form of the standard comparison

`O(n^{-2}) <= C (1/n - 1/(n+1))`

used to sum the three-dimensional `|k|^{-4}` lattice tail.
-/
def HasTelescopingShellEnvelope
    (shellMass budget : ℕ → ℝ) (m count : ℕ) : Prop :=
  (∀ n : ℕ, 0 ≤ budget n) ∧
  ∀ j ∈ Finset.range count,
    shellMass (m + j) ≤ budget (m + j) - budget (m + j + 1)

/--
The finite telescoping identity underlying the shell comparison.
-/
lemma sum_budget_differences
    (budget : ℕ → ℝ) (m count : ℕ) :
    Finset.sum (Finset.range count)
        (fun j => budget (m + j) - budget (m + j + 1)) =
      budget m - budget (m + count) := by
  induction count with
  | zero =>
      simp
  | succ count ih =>
      rw [Finset.sum_range_succ, ih]
      have hidx : m + count + 1 = m + (count + 1) := by
        omega
      rw [hidx]
      ring

/--
A nonnegative telescoping budget controls the total mass of all included
shells by its initial value.
-/
lemma shellTailMass_le_budget
    (shellMass budget : ℕ → ℝ) (m count : ℕ)
    (hEnv : HasTelescopingShellEnvelope shellMass budget m count) :
    shellTailMass shellMass m count ≤ budget m := by
  rcases hEnv with ⟨hBudget0, hShell⟩
  unfold shellTailMass
  calc
    Finset.sum (Finset.range count)
        (fun j => shellMass (m + j))
        ≤
      Finset.sum (Finset.range count)
        (fun j => budget (m + j) - budget (m + j + 1)) := by
          apply Finset.sum_le_sum
          intro j hj
          exact hShell j hj
    _ = budget m - budget (m + count) :=
      sum_budget_differences budget m count
    _ ≤ budget m := by
      have hlast : 0 ≤ budget (m + count) :=
        hBudget0 (m + count)
      linarith

/--
A shell decomposition plus a telescoping envelope implies the kernel
`K^{-1}` tail estimate used by the seventeenth milestone.

`hShellCover` says the squared `L^2` mass of the actual high-pass kernel is
covered by the selected radial shells.  `hBudgetScale` is the final
geometric comparison between the initial shell budget and the physical
cutoff `K`.
-/
lemma kernel_tail_bound_from_shells
    (K kernelTailSq Bker : ℝ)
    (shellMass budget : ℕ → ℝ)
    (m count : ℕ)
    (hK0 : 0 ≤ K)
    (hShellCover :
      kernelTailSq ≤ shellTailMass shellMass m count)
    (hEnvelope :
      HasTelescopingShellEnvelope shellMass budget m count)
    (hBudgetScale :
      budget m * K ≤ Bker ^ 2) :
    HasKernelL2TailBound K kernelTailSq Bker := by
  unfold HasKernelL2TailBound
  have hTailBudget :
      shellTailMass shellMass m count ≤ budget m :=
    shellTailMass_le_budget shellMass budget m count hEnvelope
  calc
    kernelTailSq * K
        ≤ shellTailMass shellMass m count * K :=
      mul_le_mul_of_nonneg_right hShellCover hK0
    _ ≤ budget m * K :=
      mul_le_mul_of_nonneg_right hTailBudget hK0
    _ ≤ Bker ^ 2 := hBudgetScale

/-! ## Nineteenth milestone: construct the telescoping budget explicitly -/

/--
The explicit reciprocal budget used to sum an inverse-square shell bound.
-/
noncomputable def reciprocalShellBudget
    (A : ℝ) (n : ℕ) : ℝ :=
  2 * A / ((n : ℝ) + 1)

/--
The elementary real inequality behind the telescoping comparison:
for `x >= 1` and `A >= 0`,

`A/x^2 <= 2A/x - 2A/(x+1)`.
-/
lemma inverse_square_le_reciprocal_drop
    (A x : ℝ)
    (hA0 : 0 ≤ A)
    (hx : 1 ≤ x) :
    A / x ^ 2 ≤ 2 * A / x - 2 * A / (x + 1) := by
  have hx0 : 0 < x := lt_of_lt_of_le zero_lt_one hx
  have hx1 : 0 < x + 1 := by linarith
  have hden0 : 0 < x ^ 2 * (x + 1) := by
    positivity
  have hid :
      2 * A / x - 2 * A / (x + 1) - A / x ^ 2 =
        A * (x - 1) / (x ^ 2 * (x + 1)) := by
    field_simp [ne_of_gt hx0, ne_of_gt hx1]
    ring
  have hnum0 : 0 ≤ A * (x - 1) := by
    exact mul_nonneg hA0 (by linarith)
  have hquot0 :
      0 ≤ A * (x - 1) / (x ^ 2 * (x + 1)) := by
    exact div_nonneg hnum0 (le_of_lt hden0)
  nlinarith [hquot0]

lemma reciprocalShellBudget_nonneg
    (A : ℝ) (hA0 : 0 ≤ A) :
    ∀ n : ℕ, 0 ≤ reciprocalShellBudget A n := by
  intro n
  unfold reciprocalShellBudget
  have hden : 0 ≤ (n : ℝ) + 1 := by positivity
  exact div_nonneg (mul_nonneg (by norm_num) hA0) hden

/--
An inverse-square shell estimate automatically gives the telescoping
envelope used in the eighteenth milestone.
-/
lemma inverse_square_shells_have_envelope
    (shellMass : ℕ → ℝ)
    (A : ℝ) (m count : ℕ)
    (hA0 : 0 ≤ A)
    (hShellDecay :
      ∀ j ∈ Finset.range count,
        shellMass (m + j) ≤
          A / (((m + j : ℕ) : ℝ) + 1) ^ 2) :
    HasTelescopingShellEnvelope
      shellMass (reciprocalShellBudget A) m count := by
  constructor
  · exact reciprocalShellBudget_nonneg A hA0
  · intro j hj
    have hmj0 :
        0 ≤ (((m + j : ℕ) : ℝ)) := by
      positivity
    have hx :
        1 ≤ (((m + j : ℕ) : ℝ) + 1) := by
      linarith
    have hdrop :=
      inverse_square_le_reciprocal_drop
        A (((m + j : ℕ) : ℝ) + 1) hA0 hx
    have hnext :
        (((m + j + 1 : ℕ) : ℝ) + 1) =
          (((m + j : ℕ) : ℝ) + 1) + 1 := by
      norm_num
    calc
      shellMass (m + j)
          ≤ A / (((m + j : ℕ) : ℝ) + 1) ^ 2 :=
        hShellDecay j hj
      _ ≤
          2 * A / (((m + j : ℕ) : ℝ) + 1) -
            2 * A /
              ((((m + j : ℕ) : ℝ) + 1) + 1) :=
        hdrop
      _ =
          reciprocalShellBudget A (m + j) -
            reciprocalShellBudget A (m + j + 1) := by
        unfold reciprocalShellBudget
        rw [hnext]

/--
Consequently, a finite collection of shells with inverse-square mass decay
has total mass at most `2A/(m+1)`.
-/
lemma shellTailMass_le_reciprocal_budget
    (shellMass : ℕ → ℝ)
    (A : ℝ) (m count : ℕ)
    (hA0 : 0 ≤ A)
    (hShellDecay :
      ∀ j ∈ Finset.range count,
        shellMass (m + j) ≤
          A / (((m + j : ℕ) : ℝ) + 1) ^ 2) :
    shellTailMass shellMass m count ≤
      reciprocalShellBudget A m := by
  exact shellTailMass_le_budget
    shellMass (reciprocalShellBudget A) m count
    (inverse_square_shells_have_envelope
      shellMass A m count hA0 hShellDecay)

/--
The kernel-tail estimate can now be obtained directly from an
inverse-square shell-mass bound, without supplying an abstract budget
sequence.
-/
lemma kernel_tail_bound_from_inverse_square_shells
    (K kernelTailSq Bker A : ℝ)
    (shellMass : ℕ → ℝ)
    (m count : ℕ)
    (hK0 : 0 ≤ K)
    (hA0 : 0 ≤ A)
    (hShellCover :
      kernelTailSq ≤ shellTailMass shellMass m count)
    (hShellDecay :
      ∀ j ∈ Finset.range count,
        shellMass (m + j) ≤
          A / (((m + j : ℕ) : ℝ) + 1) ^ 2)
    (hBudgetScale :
      reciprocalShellBudget A m * K ≤ Bker ^ 2) :
    HasKernelL2TailBound K kernelTailSq Bker := by
  exact kernel_tail_bound_from_shells
    K kernelTailSq Bker
    shellMass (reciprocalShellBudget A) m count
    hK0 hShellCover
    (inverse_square_shells_have_envelope
      shellMass A m count hA0 hShellDecay)
    hBudgetScale

/-! ## Twentieth milestone: derive inverse-square shell mass from counting -/

/--
The weighted mass of a finite shell.
-/
noncomputable def finiteShellMass
    {α : Type*}
    (shell : ℕ → Finset α)
    (weight : α → ℝ)
    (n : ℕ) : ℝ :=
  Finset.sum (shell n) weight

/--
A cardinality bound of the form `O((n+1)^2)` for three-dimensional radial
shells.
-/
def HasQuadraticShellCount
    {α : Type*}
    (shell : ℕ → Finset α)
    (Ccount : ℝ) : Prop :=
  ∀ n : ℕ,
    ((shell n).card : ℝ) ≤
      Ccount * (((n : ℝ) + 1) ^ 2)

/--
A pointwise `O((n+1)^-4)` bound for the Coulomb-square weight on shell `n`.
-/
def HasInverseFourthShellWeight
    {α : Type*}
    (shell : ℕ → Finset α)
    (weight : α → ℝ)
    (Cweight : ℝ) : Prop :=
  ∀ n : ℕ, ∀ q ∈ shell n,
    weight q ≤
      Cweight / (((n : ℝ) + 1) ^ 4)

/--
The product of an `O((n+1)^2)` shell-count bound and an
`O((n+1)^-4)` pointwise weight bound gives an
`O((n+1)^-2)` shell-mass bound.
-/
lemma finiteShellMass_inverse_square_bound
    {α : Type*}
    (shell : ℕ → Finset α)
    (weight : α → ℝ)
    (Ccount Cweight : ℝ)
    (hCcount0 : 0 ≤ Ccount)
    (hCweight0 : 0 ≤ Cweight)
    (hCount : HasQuadraticShellCount shell Ccount)
    (hWeight : HasInverseFourthShellWeight shell weight Cweight) :
    ∀ n : ℕ,
      finiteShellMass shell weight n ≤
        (Ccount * Cweight) / (((n : ℝ) + 1) ^ 2) := by
  intro n
  let x : ℝ := (n : ℝ) + 1
  have hx : 0 < x := by
    dsimp [x]
    positivity
  have hx2 : 0 < x ^ 2 := by positivity
  have hx4 : 0 < x ^ 4 := by positivity
  have hB0 : 0 ≤ Cweight / x ^ 4 :=
    div_nonneg hCweight0 (le_of_lt hx4)
  have hEach :
      ∀ q ∈ shell n, weight q ≤ Cweight / x ^ 4 := by
    intro q hq
    simpa [x] using hWeight n q hq
  have hSum :
      finiteShellMass shell weight n ≤
        ((shell n).card : ℝ) * (Cweight / x ^ 4) := by
    unfold finiteShellMass
    calc
      Finset.sum (shell n) weight
          ≤ Finset.sum (shell n) (fun _ => Cweight / x ^ 4) := by
            apply Finset.sum_le_sum
            intro q hq
            exact hEach q hq
      _ = ((shell n).card : ℝ) * (Cweight / x ^ 4) := by
            simp [mul_comm]
  have hCountN :
      ((shell n).card : ℝ) ≤ Ccount * x ^ 2 := by
    simpa [x] using hCount n
  have hCardWeighted :
      ((shell n).card : ℝ) * (Cweight / x ^ 4) ≤
        (Ccount * x ^ 2) * (Cweight / x ^ 4) :=
    mul_le_mul_of_nonneg_right hCountN hB0
  have hAlgebra :
      (Ccount * x ^ 2) * (Cweight / x ^ 4) =
        (Ccount * Cweight) / x ^ 2 := by
    field_simp [ne_of_gt hx]
  calc
    finiteShellMass shell weight n
        ≤ ((shell n).card : ℝ) * (Cweight / x ^ 4) := hSum
    _ ≤ (Ccount * x ^ 2) * (Cweight / x ^ 4) := hCardWeighted
    _ = (Ccount * Cweight) / x ^ 2 := hAlgebra
    _ = (Ccount * Cweight) / (((n : ℝ) + 1) ^ 2) := by
      rfl

/--
The nineteenth milestone's shell-decay hypothesis follows automatically
from the shell cardinality and pointwise weight estimates.
-/
lemma finiteShellMass_decay_on_range
    {α : Type*}
    (shell : ℕ → Finset α)
    (weight : α → ℝ)
    (Ccount Cweight : ℝ)
    (m count : ℕ)
    (hCcount0 : 0 ≤ Ccount)
    (hCweight0 : 0 ≤ Cweight)
    (hCount : HasQuadraticShellCount shell Ccount)
    (hWeight : HasInverseFourthShellWeight shell weight Cweight) :
    ∀ j ∈ Finset.range count,
      finiteShellMass shell weight (m + j) ≤
        (Ccount * Cweight) /
          (((m + j : ℕ) : ℝ) + 1) ^ 2 := by
  intro j hj
  exact finiteShellMass_inverse_square_bound
    shell weight Ccount Cweight
    hCcount0 hCweight0 hCount hWeight (m + j)

/-! ## Twenty-first milestone: an explicit cubic shell in Z^3 -/

/--
Three-dimensional reciprocal-lattice indices.
-/
abbrev Lattice3 := Fin 3 → ℤ

/--
A parameter space for the six faces of the cube of radius `n+1`.

Each face has `(2n+3)^2` parameter pairs.  Edge and corner points are
represented more than once, which is harmless because we only need an upper
bound on the cardinality of the image.
-/
abbrev CubeBoundaryParam (n : ℕ) :=
  Fin 6 × (Fin (2 * n + 3) × Fin (2 * n + 3))

/--
Convert a face coordinate in `Fin (2n+3)` to the centered integer interval
`[-(n+1), ..., n+1]`.
-/
def centeredCubeCoord
    (n : ℕ) (i : Fin (2 * n + 3)) : ℤ :=
  ((i : ℕ) : ℤ) - ((n + 1 : ℕ) : ℤ)

/--
The lattice point associated with a face parameter.

Faces `0,1` fix the first coordinate to `±(n+1)`, faces `2,3` fix the
second, and faces `4,5` fix the third.
-/
def cubeBoundaryPoint
    (n : ℕ) (p : CubeBoundaryParam n) : Lattice3 :=
  let r : ℤ := ((n + 1 : ℕ) : ℤ)
  let a : ℤ := centeredCubeCoord n p.2.1
  let b : ℤ := centeredCubeCoord n p.2.2
  if p.1 = (0 : Fin 6) then
    ![r, a, b]
  else if p.1 = (1 : Fin 6) then
    ![-r, a, b]
  else if p.1 = (2 : Fin 6) then
    ![a, r, b]
  else if p.1 = (3 : Fin 6) then
    ![a, -r, b]
  else if p.1 = (4 : Fin 6) then
    ![a, b, r]
  else
    ![a, b, -r]

/--
The explicit finite `l∞` shell `||ν||∞ = n+1`, represented as the image of
the six face parameterizations.
-/
noncomputable def cubicSupShell (n : ℕ) : Finset Lattice3 := by
  classical
  exact Finset.univ.image (cubeBoundaryPoint n)

/--
The image cannot contain more points than its six-face parameter space.
-/
lemma cubicSupShell_card_le_param (n : ℕ) :
    (cubicSupShell n).card ≤ Fintype.card (CubeBoundaryParam n) := by
  classical
  unfold cubicSupShell
  simpa using
    (Finset.card_image_le
      (s := (Finset.univ : Finset (CubeBoundaryParam n)))
      (f := cubeBoundaryPoint n))

/--
The six-face parameter space has exactly `6 (2n+3)^2` elements.
-/
lemma cubeBoundaryParam_card (n : ℕ) :
    Fintype.card (CubeBoundaryParam n) =
      6 * (2 * n + 3) ^ 2 := by
  simp [CubeBoundaryParam, pow_two]

/--
A convenient polynomial upper bound on the number of lattice points in the
cubic shell.
-/
lemma cubicSupShell_card_nat_bound (n : ℕ) :
    (cubicSupShell n).card ≤ 54 * (n + 1) ^ 2 := by
  have hparam :
      (cubicSupShell n).card ≤ 6 * (2 * n + 3) ^ 2 := by
    calc
      (cubicSupShell n).card
          ≤ Fintype.card (CubeBoundaryParam n) :=
        cubicSupShell_card_le_param n
      _ = 6 * (2 * n + 3) ^ 2 :=
        cubeBoundaryParam_card n
  have hlinear :
      2 * n + 3 ≤ 3 * (n + 1) := by
    omega
  have hpoly :
      6 * (2 * n + 3) ^ 2 ≤ 54 * (n + 1) ^ 2 := by
    calc
      6 * (2 * n + 3) ^ 2
          ≤ 6 * (3 * (n + 1)) ^ 2 := by
            gcongr
      _ = 54 * (n + 1) ^ 2 := by
            ring
  exact le_trans hparam hpoly

/--
The concrete cubic shells satisfy the quadratic shell-count interface with
the explicit constant `54`.
-/
lemma cubicSupShell_hasQuadraticShellCount :
    HasQuadraticShellCount cubicSupShell 54 := by
  intro n
  have hnat := cubicSupShell_card_nat_bound n
  exact_mod_cast hnat

/-! ## Twenty-second milestone: explicit Coulomb inverse-fourth shell weight -/

/--
Squared Euclidean length of a three-dimensional integer lattice vector.
-/
def latticeNormSq (nu : Lattice3) : ℝ :=
  (nu (0 : Fin 3) : ℝ) ^ 2 +
  (nu (1 : Fin 3) : ℝ) ^ 2 +
  (nu (2 : Fin 3) : ℝ) ^ 2

lemma latticeNormSq_nonneg (nu : Lattice3) :
    0 ≤ latticeNormSq nu := by
  unfold latticeNormSq
  positivity

/--
Every point produced by a face parameter has Euclidean norm at least the
cube radius `n+1`.
-/
lemma cubeBoundaryPoint_normSq_lower
    (n : ℕ) (p : CubeBoundaryParam n) :
    (((n : ℝ) + 1) ^ 2) ≤
      latticeNormSq (cubeBoundaryPoint n p) := by
  rcases p with ⟨f, ⟨a, b⟩⟩
  have ha :
      0 ≤ (centeredCubeCoord n a : ℝ) ^ 2 :=
    sq_nonneg _
  have hb :
      0 ≤ (centeredCubeCoord n b : ℝ) ^ 2 :=
    sq_nonneg _
  fin_cases f <;>
    simp [cubeBoundaryPoint, latticeNormSq] <;>
    nlinarith

/--
Hence every point in the explicit cubic shell has Euclidean norm at least
`n+1`.
-/
lemma cubicSupShell_normSq_lower
    (n : ℕ) {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    (((n : ℝ) + 1) ^ 2) ≤ latticeNormSq nu := by
  classical
  unfold cubicSupShell at hnu
  rcases Finset.mem_image.mp hnu with ⟨p, hp, hpeq⟩
  rw [← hpeq]
  exact cubeBoundaryPoint_normSq_lower n p

/--
Squared modulus of a Coulomb Fourier coefficient, with all physical
prefactors absorbed into the nonnegative constant `C`.

Since `latticeNormSq nu = |nu|_2^2`, this is `C / |nu|_2^4`.
-/
noncomputable def latticeCoulombSquareWeight
    (C : ℝ) (nu : Lattice3) : ℝ :=
  C / (latticeNormSq nu) ^ 2

lemma latticeCoulombSquareWeight_nonneg
    (C : ℝ) (hC0 : 0 ≤ C) (nu : Lattice3) :
    0 ≤ latticeCoulombSquareWeight C nu := by
  unfold latticeCoulombSquareWeight
  exact div_nonneg hC0 (sq_nonneg _)

/--
On cubic shell `n`, the explicit Coulomb-square weight is bounded by
`C/(n+1)^4`.
-/
lemma latticeCoulombSquareWeight_shell_bound
    (C : ℝ) (hC0 : 0 ≤ C)
    (n : ℕ) {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    latticeCoulombSquareWeight C nu ≤
      C / (((n : ℝ) + 1) ^ 4) := by
  let x : ℝ := (n : ℝ) + 1
  have hx : 0 < x := by
    dsimp [x]
    positivity
  have hx2 : 0 ≤ x ^ 2 := sq_nonneg x
  have hnorm :
      x ^ 2 ≤ latticeNormSq nu := by
    simpa [x] using cubicSupShell_normSq_lower n hnu
  have hden :
      x ^ 4 ≤ (latticeNormSq nu) ^ 2 := by
    calc
      x ^ 4 = (x ^ 2) ^ 2 := by ring
      _ ≤ (latticeNormSq nu) ^ 2 :=
        sq_le_sq_of_nonneg hx2 hnorm
  have hx4 : 0 < x ^ 4 := by
    positivity
  have hnorm4 : 0 < (latticeNormSq nu) ^ 2 :=
    lt_of_lt_of_le hx4 hden
  have hcross :
      C * x ^ 4 ≤ C * (latticeNormSq nu) ^ 2 :=
    mul_le_mul_of_nonneg_left hden hC0
  unfold latticeCoulombSquareWeight
  have hdiv :
      C / (latticeNormSq nu) ^ 2 ≤ C / x ^ 4 :=
    (div_le_div_iff₀ hnorm4 hx4).2 hcross
  simpa [x] using hdiv

/--
The concrete cubic shell and explicit Coulomb-square weight satisfy the
inverse-fourth shell-weight interface automatically.
-/
lemma cubicSupShell_hasInverseFourthCoulombWeight
    (C : ℝ) (hC0 : 0 ≤ C) :
    HasInverseFourthShellWeight
      cubicSupShell (latticeCoulombSquareWeight C) C := by
  intro n nu hnu
  exact latticeCoulombSquareWeight_shell_bound C hC0 n hnu

/-! ## Twenty-third milestone: explicit finite high-pass kernel and shell cover -/

/--
Squared high-pass condition for a reciprocal-lattice mode.

If the physical reciprocal momentum is `k = g * nu`, this is the
division-free form of `|k| > K/2`:
`(K/2)^2 < g^2 |nu|^2`.
-/
def IsAboveHalfCutoff
    (K g : ℝ) (nu : Lattice3) : Prop :=
  (K / 2) ^ 2 < g ^ 2 * latticeNormSq nu

/--
Coulomb-square mass in one cubic shell after imposing the physical
high-pass condition.
-/
noncomputable def highPassCoulombShellMass
    (K g C : ℝ) (n : ℕ) : ℝ := by
  classical
  exact
    Finset.sum
      ((cubicSupShell n).filter (IsAboveHalfCutoff K g))
      (latticeCoulombSquareWeight C)

/--
The finite high-pass kernel mass through shells
`0, ..., m + count - 1`.
-/
noncomputable def finiteHighPassKernelTailSq
    (K g C : ℝ) (m count : ℕ) : ℝ :=
  Finset.sum (Finset.range (m + count))
    (highPassCoulombShellMass K g C)

/--
Filtering a shell by the high-pass condition cannot increase its weighted
mass when the Coulomb-square weight is nonnegative.
-/
lemma highPassCoulombShellMass_le_full
    (K g C : ℝ) (n : ℕ)
    (hC0 : 0 ≤ C) :
    highPassCoulombShellMass K g C n ≤
      finiteShellMass cubicSupShell
        (latticeCoulombSquareWeight C) n := by
  classical
  unfold highPassCoulombShellMass finiteShellMass
  rw [Finset.sum_filter]
  apply Finset.sum_le_sum
  intro nu hnu
  by_cases hp : IsAboveHalfCutoff K g nu
  · simp [hp]
  · have hw0 :
        0 ≤ latticeCoulombSquareWeight C nu :=
      latticeCoulombSquareWeight_nonneg C hC0 nu
    simp [hp, hw0]

lemma highPassCoulombShellMass_nonneg
    (K g C : ℝ) (n : ℕ)
    (hC0 : 0 ≤ C) :
    0 ≤ highPassCoulombShellMass K g C n := by
  classical
  unfold highPassCoulombShellMass
  apply Finset.sum_nonneg
  intro nu hnu
  exact latticeCoulombSquareWeight_nonneg C hC0 nu

lemma finiteHighPassKernelTailSq_nonneg
    (K g C : ℝ) (m count : ℕ)
    (hC0 : 0 ≤ C) :
    HighPassKernelTailSq
      (finiteHighPassKernelTailSq K g C m count) := by
  unfold HighPassKernelTailSq finiteHighPassKernelTailSq
  apply Finset.sum_nonneg
  intro n hn
  exact highPassCoulombShellMass_nonneg K g C n hC0

/--
If no mode in shells below `m` lies above the physical half-cutoff, the
explicit finite high-pass kernel mass is covered by the full Coulomb masses
of shells `m, ..., m+count-1`.

This is the shell-cover/cutoff conversion that was previously assumed as
`hShellCover`.
-/
lemma finiteHighPassKernelTailSq_shell_cover
    (K g C : ℝ) (m count : ℕ)
    (hC0 : 0 ≤ C)
    (hBelow :
      ∀ n ∈ Finset.range m,
        ∀ nu ∈ cubicSupShell n,
          ¬ IsAboveHalfCutoff K g nu) :
    finiteHighPassKernelTailSq K g C m count ≤
      shellTailMass
        (finiteShellMass cubicSupShell
          (latticeCoulombSquareWeight C)) m count := by
  classical

  have hEarlyZero :
      Finset.sum (Finset.range m)
          (highPassCoulombShellMass K g C) = 0 := by
    apply Finset.sum_eq_zero
    intro n hn
    unfold highPassCoulombShellMass
    apply Finset.sum_eq_zero
    intro nu hnu
    rcases Finset.mem_filter.mp hnu with ⟨hShell, hHigh⟩
    exact False.elim ((hBelow n hn nu hShell) hHigh)

  have hTail :
      Finset.sum (Finset.range count)
          (fun j => highPassCoulombShellMass K g C (m + j)) ≤
        Finset.sum (Finset.range count)
          (fun j =>
            finiteShellMass cubicSupShell
              (latticeCoulombSquareWeight C) (m + j)) := by
    apply Finset.sum_le_sum
    intro j hj
    exact highPassCoulombShellMass_le_full K g C (m + j) hC0

  unfold finiteHighPassKernelTailSq shellTailMass
  rw [Finset.sum_range_add, hEarlyZero, zero_add]
  exact hTail

/-! ## Twenty-fourth milestone: derive the below-cutoff shells geometrically -/

/--
A centered face coordinate lies between `-(n+1)` and `n+1`.
-/
lemma centeredCubeCoord_bounds
    (n : ℕ) (i : Fin (2 * n + 3)) :
    -(((n + 1 : ℕ) : ℤ)) ≤ centeredCubeCoord n i ∧
      centeredCubeCoord n i ≤ ((n + 1 : ℕ) : ℤ) := by
  unfold centeredCubeCoord
  have hi : (i : ℕ) < 2 * n + 3 := i.isLt
  constructor <;> omega

/--
Consequently the square of a centered face coordinate is at most
`(n+1)^2`.
-/
lemma centeredCubeCoord_sq_le
    (n : ℕ) (i : Fin (2 * n + 3)) :
    (centeredCubeCoord n i : ℝ) ^ 2 ≤
      (((n : ℝ) + 1) ^ 2) := by
  rcases centeredCubeCoord_bounds n i with ⟨hloZ, hhiZ⟩
  have hlo :
      -((n : ℝ) + 1) ≤ (centeredCubeCoord n i : ℝ) := by
    exact_mod_cast hloZ
  have hhi :
      (centeredCubeCoord n i : ℝ) ≤ (n : ℝ) + 1 := by
    exact_mod_cast hhiZ
  have hr0 : 0 ≤ (n : ℝ) + 1 := by
    positivity
  have hprod :
      0 ≤
        (((n : ℝ) + 1) - (centeredCubeCoord n i : ℝ)) *
          (((n : ℝ) + 1) + (centeredCubeCoord n i : ℝ)) := by
    apply mul_nonneg
    · linarith
    · linarith
  nlinarith

/--
Every parameterized cube-boundary point also has the matching Euclidean
upper bound `|nu|^2 <= 3 (n+1)^2`.
-/
lemma cubeBoundaryPoint_normSq_upper
    (n : ℕ) (p : CubeBoundaryParam n) :
    latticeNormSq (cubeBoundaryPoint n p) ≤
      3 * (((n : ℝ) + 1) ^ 2) := by
  rcases p with ⟨f, ⟨a, b⟩⟩
  have ha := centeredCubeCoord_sq_le n a
  have hb := centeredCubeCoord_sq_le n b
  fin_cases f <;>
    simp [cubeBoundaryPoint, latticeNormSq] <;>
    nlinarith

/--
Transfer the Euclidean upper bound from the six-face parameterization to
every member of the explicit cubic shell.
-/
lemma cubicSupShell_normSq_upper
    (n : ℕ) {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    latticeNormSq nu ≤ 3 * (((n : ℝ) + 1) ^ 2) := by
  classical
  unfold cubicSupShell at hnu
  rcases Finset.mem_image.mp hnu with ⟨p, hp, hpeq⟩
  rw [← hpeq]
  exact cubeBoundaryPoint_normSq_upper n p

/--
If shell `m` is still below the half-cutoff in the worst-case Euclidean
cube bound, then every earlier shell is entirely below the half-cutoff.
-/
lemma cubicSupShell_not_above_half_cutoff
    (K g : ℝ) (m n : ℕ)
    (hnm : n < m)
    (hCutoffStart :
      3 * g ^ 2 * ((m : ℝ) ^ 2) ≤ (K / 2) ^ 2) :
    ∀ nu ∈ cubicSupShell n,
      ¬ IsAboveHalfCutoff K g nu := by
  intro nu hnu
  have hnorm :
      latticeNormSq nu ≤
        3 * (((n : ℝ) + 1) ^ 2) :=
    cubicSupShell_normSq_upper n hnu

  have hnmNat : n + 1 ≤ m := by
    omega
  have hnmReal :
      (n : ℝ) + 1 ≤ (m : ℝ) := by
    exact_mod_cast hnmNat

  have hn0 : 0 ≤ (n : ℝ) + 1 := by
    positivity
  have hm0 : 0 ≤ (m : ℝ) := by
    positivity
  have hsq :
      ((n : ℝ) + 1) ^ 2 ≤ (m : ℝ) ^ 2 := by
    have hprod :
        0 ≤
          ((m : ℝ) - ((n : ℝ) + 1)) *
            ((m : ℝ) + ((n : ℝ) + 1)) := by
      apply mul_nonneg
      · linarith
      · positivity
    nlinarith

  have hg2 : 0 ≤ g ^ 2 := sq_nonneg g

  have hphys :
      g ^ 2 * latticeNormSq nu ≤ (K / 2) ^ 2 := by
    calc
      g ^ 2 * latticeNormSq nu
          ≤ g ^ 2 * (3 * (((n : ℝ) + 1) ^ 2)) :=
        mul_le_mul_of_nonneg_left hnorm hg2
      _ ≤ 3 * g ^ 2 * ((m : ℝ) ^ 2) := by
        have hcoef0 : 0 ≤ 3 * g ^ 2 := by
          positivity
        calc
          g ^ 2 * (3 * (((n : ℝ) + 1) ^ 2))
              = (3 * g ^ 2) * (((n : ℝ) + 1) ^ 2) := by
                ring
          _ ≤ (3 * g ^ 2) * ((m : ℝ) ^ 2) :=
            mul_le_mul_of_nonneg_left hsq hcoef0
          _ = 3 * g ^ 2 * ((m : ℝ) ^ 2) := by
            ring
      _ ≤ (K / 2) ^ 2 := hCutoffStart

  unfold IsAboveHalfCutoff
  linarith

/--
The hypothesis required by the twenty-third milestone follows directly
from the single cutoff-start inequality.
-/
lemma all_earlier_cubic_shells_below_half_cutoff
    (K g : ℝ) (m : ℕ)
    (hCutoffStart :
      3 * g ^ 2 * ((m : ℝ) ^ 2) ≤ (K / 2) ^ 2) :
    ∀ n ∈ Finset.range m,
      ∀ nu ∈ cubicSupShell n,
        ¬ IsAboveHalfCutoff K g nu := by
  intro n hn
  have hnm : n < m := by
    simpa using hn
  exact cubicSupShell_not_above_half_cutoff
    K g m n hnm hCutoffStart

/-! ## Twenty-fifth milestone: reduce the cutoff and budget conditions to
    placement of the shell index -/

/--
If the chosen shell index satisfies `4 g m <= K`, then the entire collection
of shells below `m` is below the half-cutoff in the sense required by the
twenty-fourth milestone.
-/
lemma cutoff_start_from_shell_index_upper
    (K g : ℝ) (m : ℕ)
    (hK0 : 0 ≤ K)
    (hg0 : 0 ≤ g)
    (hIndexUpper :
      4 * g * (m : ℝ) ≤ K) :
    3 * g ^ 2 * ((m : ℝ) ^ 2) ≤ (K / 2) ^ 2 := by
  have hm0 : 0 ≤ (m : ℝ) := by
    positivity
  have hgm0 : 0 ≤ 4 * g * (m : ℝ) := by
    positivity
  have hsum0 :
      0 ≤ K + 4 * g * (m : ℝ) := by
    positivity
  have hdiff0 :
      0 ≤ K - 4 * g * (m : ℝ) := by
    linarith
  have hprod :
      0 ≤
        (K - 4 * g * (m : ℝ)) *
          (K + 4 * g * (m : ℝ)) :=
    mul_nonneg hdiff0 hsum0
  nlinarith

/--
If `K <= 4 g (m+1)`, then the reciprocal shell budget times `K` is bounded
by the explicit constant `432 Cweight g`.

The constant is simply

`2 * 54 * 4 = 432`.
-/
lemma reciprocal_budget_scale_from_shell_index_lower
    (K g Cweight : ℝ) (m : ℕ)
    (hg0 : 0 ≤ g)
    (hCweight0 : 0 ≤ Cweight)
    (hIndexLower :
      K ≤ 4 * g * ((m : ℝ) + 1)) :
    reciprocalShellBudget (54 * Cweight) m * K ≤
      432 * Cweight * g := by
  have hA0 : 0 ≤ 54 * Cweight := by
    positivity
  have hbudget0 :
      0 ≤ reciprocalShellBudget (54 * Cweight) m :=
    reciprocalShellBudget_nonneg (54 * Cweight) hA0 m
  have hmul :
      reciprocalShellBudget (54 * Cweight) m * K ≤
        reciprocalShellBudget (54 * Cweight) m *
          (4 * g * ((m : ℝ) + 1)) :=
    mul_le_mul_of_nonneg_left hIndexLower hbudget0
  have hm1pos : 0 < (m : ℝ) + 1 := by
    positivity
  have hidentity :
      reciprocalShellBudget (54 * Cweight) m *
          (4 * g * ((m : ℝ) + 1)) =
        432 * Cweight * g := by
    unfold reciprocalShellBudget
    field_simp [ne_of_gt hm1pos]; ring
  rw [hidentity] at hmul
  exact hmul

/--
The two shell-index placement inequalities and one fixed physical constant
bound imply both scalar hypotheses of the twenty-fourth milestone.
-/
lemma cutoff_and_budget_from_shell_index_placement
    (K g Cweight Bker : ℝ) (m : ℕ)
    (hK0 : 0 ≤ K)
    (hg0 : 0 ≤ g)
    (hCweight0 : 0 ≤ Cweight)
    (hIndexUpper :
      4 * g * (m : ℝ) ≤ K)
    (hIndexLower :
      K ≤ 4 * g * ((m : ℝ) + 1))
    (hBkerScale :
      432 * Cweight * g ≤ Bker ^ 2) :
    3 * g ^ 2 * ((m : ℝ) ^ 2) ≤ (K / 2) ^ 2 ∧
    reciprocalShellBudget (54 * Cweight) m * K ≤
      Bker ^ 2 := by
  constructor
  · exact cutoff_start_from_shell_index_upper
      K g m hK0 hg0 hIndexUpper
  · exact
      (reciprocal_budget_scale_from_shell_index_lower
        K g Cweight m hg0 hCweight0 hIndexLower).trans
        hBkerScale

/-! ## Twenty-sixth milestone: choose the shell index by natural floor -/

/--
The natural shell index corresponding to the scaled cutoff `K/(4g)`.
For the physical reciprocal scale we assume `g > 0`.
-/
noncomputable def cutoffShellIndex
    (K g : ℝ) : ℕ :=
  ⌊K / (4 * g)⌋₊

/--
The natural floor is below the scaled cutoff.
-/
lemma cutoffShellIndex_le_scaled_cutoff
    (K g : ℝ)
    (hK0 : 0 ≤ K)
    (hgpos : 0 < g) :
    (cutoffShellIndex K g : ℝ) ≤ K / (4 * g) := by
  unfold cutoffShellIndex
  have hden0 : 0 ≤ 4 * g := by
    positivity
  exact Nat.floor_le (div_nonneg hK0 hden0)

/--
The scaled cutoff lies strictly below one plus its natural floor.
-/
lemma scaled_cutoff_lt_cutoffShellIndex_add_one
    (K g : ℝ) :
    K / (4 * g) < (cutoffShellIndex K g : ℝ) + 1 := by
  unfold cutoffShellIndex
  exact Nat.lt_floor_add_one (K / (4 * g))

/--
The floor choice gives exactly the shell-index placement used in the
twenty-fifth milestone:

`4 g m <= K <= 4 g (m+1)`.
-/
lemma cutoffShellIndex_placement
    (K g : ℝ)
    (hK0 : 0 ≤ K)
    (hgpos : 0 < g) :
    4 * g * (cutoffShellIndex K g : ℝ) ≤ K ∧
    K ≤ 4 * g * ((cutoffShellIndex K g : ℝ) + 1) := by
  have hdenpos : 0 < 4 * g := by
    positivity
  have hden0 : 0 ≤ 4 * g := le_of_lt hdenpos
  have hfloor :
      (cutoffShellIndex K g : ℝ) ≤ K / (4 * g) :=
    cutoffShellIndex_le_scaled_cutoff K g hK0 hgpos
  have hfloorSucc :
      K / (4 * g) <
        (cutoffShellIndex K g : ℝ) + 1 :=
    scaled_cutoff_lt_cutoffShellIndex_add_one K g
  have hcancel :
      (4 * g) * (K / (4 * g)) = K := by
    field_simp [ne_of_gt hdenpos]
  constructor
  · calc
      4 * g * (cutoffShellIndex K g : ℝ)
          ≤ (4 * g) * (K / (4 * g)) :=
        mul_le_mul_of_nonneg_left hfloor hden0
      _ = K := hcancel
  · calc
      K = (4 * g) * (K / (4 * g)) := hcancel.symm
      _ ≤ 4 * g * ((cutoffShellIndex K g : ℝ) + 1) :=
        mul_le_mul_of_nonneg_left hfloorSucc.le hden0

/-! ## Twenty-seventh milestone: convert the K^{-3} bound to N^{-1} -/

/-! ## Twenty-eighth milestone: formalize the finite slice/Fubini step -/

/--
The configuration of all particles except the distinguished reference
particle `r`.
-/
abbrev OuterConfig
    (eta : ℕ) (r : Fin eta) (μ : Type*) :=
  {a : Fin eta // a ≠ r} → μ

/--
Forget the reference-particle momentum and retain all other particle
momenta.  This labels the Fourier slices used in the slice-Sobolev
argument.
-/
def outerConfigOf
    {eta : ℕ} {μ : Type*}
    (r : Fin eta) (p : FourierConfig eta μ) :
    OuterConfig eta r μ :=
  fun a => p a.1

/--
Squared output norm restricted to one slice.
-/
noncomputable def sliceOutputSq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (b : β) : ℝ := by
  classical
  exact
    ∑ p : FourierConfig eta μ,
      if label p = b then
        ‖(Whigh (fullCoeffVector coeff)).ofLp p‖ ^ 2
      else 0

/--
The global `H^2` Fourier mass restricted to one slice.
-/
noncomputable def sliceH2Sq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (b : β) : ℝ := by
  classical
  exact
    ∑ p : FourierConfig eta μ,
      if label p = b then
        (1 + boKineticSymbol kabs p) ^ 2 * coeffMass coeff p
      else 0

lemma sliceH2Sq_nonneg
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (b : β) :
    0 ≤ sliceH2Sq label kabs coeff b := by
  classical
  unfold sliceH2Sq
  apply Finset.sum_nonneg
  intro p hp
  by_cases hpb : label p = b
  · simp only [if_pos hpb]
    exact mul_nonneg (sq_nonneg _) (by
      unfold coeffMass
      positivity)
  · simp [hpb]

/--
Finite Fubini identity for the output norm: summing the disjoint slice
masses recovers the full squared Euclidean norm.
-/
lemma sum_sliceOutputSq_eq_norm_sq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ] [Fintype β]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ) :
    (∑ b : β, sliceOutputSq label Whigh coeff b) =
      ‖Whigh (fullCoeffVector coeff)‖ ^ 2 := by
  classical
  rw [EuclideanSpace.norm_sq_eq]
  unfold sliceOutputSq
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro p hp
  simp

/--
Finite Fubini identity for the input `H^2` mass.
-/
lemma sum_sliceH2Sq_eq_fullH2Sq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ] [Fintype β]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) :
    (∑ b : β, sliceH2Sq label kabs coeff b) =
      fullH2Sq kabs coeff := by
  classical
  unfold sliceH2Sq fullH2Sq
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro p hp
  simp

/--
Slice-wise Hölder/Fubini input.

`sliceSupSq b` represents the squared `L∞` norm of the physical-space
one-particle slice.  The estimate corresponds to

`||w_> psi_b||_2^2 <= ||w_>||_2^2 ||psi_b||_∞^2`.
-/
def HasSliceHolderBound
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (sliceSupSq : β → ℝ)
    (kernelTailSq : ℝ) : Prop :=
  ∀ b : β,
    sliceOutputSq label Whigh coeff b ≤
      kernelTailSq * sliceSupSq b

/--
Slice-wise Sobolev input,

`||psi_b||_∞^2 <= Cs^2 ||psi_b||_{H^2}^2`.
-/
def HasSliceSobolevBound
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (sliceSupSq : β → ℝ)
    (Cs : ℝ) : Prop :=
  ∀ b : β,
    sliceSupSq b ≤
      Cs ^ 2 * sliceH2Sq label kabs coeff b

/--
The slice-wise Hölder and Sobolev estimates imply the global
`HasHighPassSliceBound`.  The finite Fubini identities are proved above,
so this lemma contains the complete recombination step from the manuscript.
-/
lemma highPassSliceBound_of_slice_holder_sobolev
    {eta : ℕ} {μ β : Type*}
    [Fintype μ] [Fintype β]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (sliceSupSq : β → ℝ)
    (Cs kernelTailSq : ℝ)
    (hKernel0 : 0 ≤ kernelTailSq)
    (hHolder :
      HasSliceHolderBound
        label Whigh coeff sliceSupSq kernelTailSq)
    (hSobolev :
      HasSliceSobolevBound
        label kabs coeff sliceSupSq Cs) :
    HasHighPassSliceBound
      kabs Whigh coeff Cs kernelTailSq := by

  have hPerSlice :
      ∀ b : β,
        sliceOutputSq label Whigh coeff b ≤
          Cs ^ 2 * kernelTailSq *
            sliceH2Sq label kabs coeff b := by
    intro b
    calc
      sliceOutputSq label Whigh coeff b
          ≤ kernelTailSq * sliceSupSq b :=
        hHolder b
      _ ≤ kernelTailSq *
          (Cs ^ 2 * sliceH2Sq label kabs coeff b) :=
        mul_le_mul_of_nonneg_left (hSobolev b) hKernel0
      _ =
          Cs ^ 2 * kernelTailSq *
            sliceH2Sq label kabs coeff b := by
        ring

  unfold HasHighPassSliceBound
  rw [← sum_sliceOutputSq_eq_norm_sq label Whigh coeff]
  calc
    (∑ b : β, sliceOutputSq label Whigh coeff b)
        ≤
      ∑ b : β,
        (Cs ^ 2 * kernelTailSq) *
          sliceH2Sq label kabs coeff b := by
            apply Finset.sum_le_sum
            intro b hb
            exact hPerSlice b
    _ =
      (Cs ^ 2 * kernelTailSq) *
        (∑ b : β, sliceH2Sq label kabs coeff b) := by
          rw [Finset.mul_sum]
    _ =
      Cs ^ 2 * kernelTailSq * fullH2Sq kabs coeff := by
        rw [sum_sliceH2Sq_eq_fullH2Sq label kabs coeff]

/-! ## Twenty-ninth milestone: prove the finite slice Sobolev bound by
    weighted Cauchy--Schwarz -/

/--
The square of the Fourier `l1` norm on one slice.

For a trigonometric polynomial this bounds the squared physical-space
`L∞` norm because every Fourier phase has modulus one.
-/
noncomputable def sliceFourierL1Sq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (coeff : FourierConfig eta μ → ℂ)
    (b : β) : ℝ := by
  classical
  exact
    (∑ p : FourierConfig eta μ,
      if label p = b then ‖coeff p‖ else 0) ^ 2

/--
The inverse `H^2` weight sum on a slice.  This is the finite Fourier
Sobolev constant before taking a uniform bound over slices.
-/
noncomputable def sliceInverseH2WeightSum
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (b : β) : ℝ := by
  classical
  exact
    ∑ p : FourierConfig eta μ,
      if label p = b then
        (1 / (1 + boKineticSymbol kabs p)) ^ 2
      else 0

/--
Weighted Cauchy--Schwarz on one finite Fourier slice:

`(||c||_1)^2 <= (sum (1+T_p)^-2) * (sum (1+T_p)^2 |c_p|^2)`.
-/
lemma sliceFourierL1Sq_le_inverseWeight_mul_sliceH2Sq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (b : β) :
    sliceFourierL1Sq label coeff b ≤
      sliceInverseH2WeightSum label kabs b *
        sliceH2Sq label kabs coeff b := by
  classical

  let f : FourierConfig eta μ → ℝ :=
    fun p =>
      if label p = b then
        1 / (1 + boKineticSymbol kabs p)
      else 0
  let g : FourierConfig eta μ → ℝ :=
    fun p =>
      if label p = b then
        (1 + boKineticSymbol kabs p) * ‖coeff p‖
      else 0

  have hCS :=
    Finset.sum_mul_sq_le_sq_mul_sq
      (Finset.univ : Finset (FourierConfig eta μ)) f g

  have hFG :
      (∑ p : FourierConfig eta μ, f p * g p) =
        ∑ p : FourierConfig eta μ,
          if label p = b then ‖coeff p‖ else 0 := by
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hpb : label p = b
    · have hT0 : 0 ≤ boKineticSymbol kabs p :=
        boKineticSymbol_nonneg kabs p
      have hwpos : 0 < 1 + boKineticSymbol kabs p := by
        linarith
      simp only [f, g, if_pos hpb]
      field_simp [ne_of_gt hwpos]
    · simp [f, g, hpb]

  have hF2 :
      (∑ p : FourierConfig eta μ, f p ^ 2) =
        sliceInverseH2WeightSum label kabs b := by
    unfold sliceInverseH2WeightSum
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hpb : label p = b
    · simp [f, hpb]
    · simp [f, hpb]

  have hG2 :
      (∑ p : FourierConfig eta μ, g p ^ 2) =
        sliceH2Sq label kabs coeff b := by
    unfold sliceH2Sq
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hpb : label p = b
    · simp only [g, if_pos hpb]
      unfold coeffMass
      ring
    · simp [g, hpb]

  unfold sliceFourierL1Sq
  rw [← hFG, ← hF2, ← hG2]
  exact hCS

/--
A uniform bound on the inverse `H^2` Fourier weight sum supplies a finite
Sobolev constant.
-/
def HasSliceInverseH2WeightBound
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (Cs : ℝ) : Prop :=
  ∀ b : β,
    sliceInverseH2WeightSum label kabs b ≤ Cs ^ 2

/--
The inverse-weight bound proves the slice Sobolev inequality with the
explicit Fourier `l1` proxy for the physical-space supremum.
-/
lemma sliceSobolevBound_of_inverseH2Weight
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ)
    (Cs : ℝ)
    (hWeight :
      HasSliceInverseH2WeightBound label kabs Cs) :
    HasSliceSobolevBound
      label kabs coeff
      (sliceFourierL1Sq label coeff) Cs := by
  intro b
  have hCS :=
    sliceFourierL1Sq_le_inverseWeight_mul_sliceH2Sq
      label kabs coeff b
  have hH2nonneg :
      0 ≤ sliceH2Sq label kabs coeff b :=
    sliceH2Sq_nonneg label kabs coeff b
  calc
    sliceFourierL1Sq label coeff b
        ≤ sliceInverseH2WeightSum label kabs b *
            sliceH2Sq label kabs coeff b :=
      hCS
    _ ≤ Cs ^ 2 * sliceH2Sq label kabs coeff b :=
      mul_le_mul_of_nonneg_right (hWeight b) hH2nonneg

/-! ## Thirtieth milestone: identify a fixed outer slice with one free momentum -/

/--
Reconstruct a full Fourier configuration from the momenta of all particles
except `r` and a chosen momentum `u` for particle `r`.
-/
def referenceSliceConfig
    {eta : ℕ} {μ : Type*}
    (r : Fin eta)
    (b : OuterConfig eta r μ)
    (u : μ) :
    FourierConfig eta μ :=
  fun a =>
    if h : a = r then
      u
    else
      b ⟨a, h⟩

@[simp]
lemma referenceSliceConfig_ref
    {eta : ℕ} {μ : Type*}
    (r : Fin eta)
    (b : OuterConfig eta r μ)
    (u : μ) :
    referenceSliceConfig r b u r = u := by
  simp [referenceSliceConfig]

/--
Reconstructing a configuration from an outer label does not alter that
outer label.
-/
lemma outerConfigOf_referenceSliceConfig
    {eta : ℕ} {μ : Type*}
    (r : Fin eta)
    (b : OuterConfig eta r μ)
    (u : μ) :
    outerConfigOf r (referenceSliceConfig r b u) = b := by
  funext a
  simp [outerConfigOf, referenceSliceConfig, a.property]

/--
Conversely, a configuration with outer label `b` is completely determined
by its reference-particle momentum.
-/
lemma referenceSliceConfig_of_outerConfig_eq
    {eta : ℕ} {μ : Type*}
    (r : Fin eta)
    (b : OuterConfig eta r μ)
    (p : FourierConfig eta μ)
    (hp : outerConfigOf r p = b) :
    referenceSliceConfig r b (p r) = p := by
  funext a
  by_cases ha : a = r
  · subst a
    simp
  · have hcoord := congrFun hp ⟨a, ha⟩
    have hcoord' : p a = b ⟨a, ha⟩ := by
      simpa [outerConfigOf] using hcoord
    simp [referenceSliceConfig, ha, hcoord']

/--
The inverse `H^2` weight involving only one particle momentum.
-/
noncomputable def oneParticleInverseH2Weight
    {μ : Type*}
    (kabs : μ → ℝ)
    (u : μ) : ℝ :=
  (1 / (1 + (kabs u) ^ 2)) ^ 2

/--
The corresponding finite one-particle Sobolev weight sum.
-/
noncomputable def oneParticleInverseH2WeightSum
    {μ : Type*}
    [Fintype μ]
    (kabs : μ → ℝ) : ℝ :=
  ∑ u : μ, oneParticleInverseH2Weight kabs u

/--
The full many-particle kinetic weight is at least the contribution of the
reference particle, so its inverse square is no larger than the
one-particle inverse square.
-/
lemma inverseH2Weight_le_referenceWeight
    {eta : ℕ} {μ : Type*}
    (kabs : μ → ℝ)
    (p : FourierConfig eta μ)
    (r : Fin eta) :
    (1 / (1 + boKineticSymbol kabs p)) ^ 2 ≤
      oneParticleInverseH2Weight kabs (p r) := by

  have hcomp :
      (kabs (p r)) ^ 2 ≤ boKineticSymbol kabs p :=
    component_sq_le_boKineticSymbol kabs p r

  have hden :
      1 + (kabs (p r)) ^ 2 ≤
        1 + boKineticSymbol kabs p := by
    linarith

  have hrefDenPos :
      0 < 1 + (kabs (p r)) ^ 2 := by
    positivity

  have htotalDenPos :
      0 < 1 + boKineticSymbol kabs p := by
    have hT0 := boKineticSymbol_nonneg kabs p
    linarith

  have hinv :
      1 / (1 + boKineticSymbol kabs p) ≤
        1 / (1 + (kabs (p r)) ^ 2) :=
    one_div_le_one_div_of_le hrefDenPos hden

  have hinvLeft0 :
      0 ≤ 1 / (1 + boKineticSymbol kabs p) := by
    exact le_of_lt (one_div_pos.mpr htotalDenPos)

  have hinvRight0 :
      0 ≤ 1 / (1 + (kabs (p r)) ^ 2) := by
    exact le_of_lt (one_div_pos.mpr hrefDenPos)

  unfold oneParticleInverseH2Weight
  exact (sq_le_sq₀ hinvLeft0 hinvRight0).2 hinv

/--
For a fixed outer configuration, evaluation at the reference particle is a
bijection from the slice to the one-particle momentum set.  Consequently
the slice inverse `H^2` weight sum is bounded by the one-particle sum.
-/
lemma sliceInverseH2WeightSum_le_oneParticleSum
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kabs : μ → ℝ)
    (b : OuterConfig eta r μ) :
    sliceInverseH2WeightSum (outerConfigOf r) kabs b ≤
      oneParticleInverseH2WeightSum kabs := by
  classical

  have hSliceEq :
      sliceInverseH2WeightSum (outerConfigOf r) kabs b =
        Finset.sum
          ((Finset.univ : Finset (FourierConfig eta μ)).filter
            (fun p => outerConfigOf r p = b))
          (fun p => (1 / (1 + boKineticSymbol kabs p)) ^ 2) := by
    unfold sliceInverseH2WeightSum
    rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hpb : outerConfigOf r p = b
    · simp [hpb]
    · simp [hpb]

  calc
    sliceInverseH2WeightSum (outerConfigOf r) kabs b
        =
      Finset.sum
        ((Finset.univ : Finset (FourierConfig eta μ)).filter
          (fun p => outerConfigOf r p = b))
        (fun p => (1 / (1 + boKineticSymbol kabs p)) ^ 2) :=
      hSliceEq
    _ ≤
      Finset.sum
        ((Finset.univ : Finset (FourierConfig eta μ)).filter
          (fun p => outerConfigOf r p = b))
        (fun p => oneParticleInverseH2Weight kabs (p r)) := by
          apply Finset.sum_le_sum
          intro p hp
          exact inverseH2Weight_le_referenceWeight kabs p r
    _ = oneParticleInverseH2WeightSum kabs := by
      unfold oneParticleInverseH2WeightSum
      apply Finset.sum_bij
        (fun p _ => p r)
      · intro p hp
        simp
      · intro p₁ hp₁ p₂ hp₂ href
        have hs₁ :
            outerConfigOf r p₁ = b :=
          (Finset.mem_filter.mp hp₁).2
        have hs₂ :
            outerConfigOf r p₂ = b :=
          (Finset.mem_filter.mp hp₂).2
        have hp₁rec :
            referenceSliceConfig r b (p₁ r) = p₁ :=
          referenceSliceConfig_of_outerConfig_eq r b p₁ hs₁
        have hp₂rec :
            referenceSliceConfig r b (p₂ r) = p₂ :=
          referenceSliceConfig_of_outerConfig_eq r b p₂ hs₂
        calc
          p₁ = referenceSliceConfig r b (p₁ r) := hp₁rec.symm
          _ = referenceSliceConfig r b (p₂ r) := by rw [href]
          _ = p₂ := hp₂rec
      · intro u hu
        let p : FourierConfig eta μ :=
          referenceSliceConfig r b u
        have hpSlice :
            outerConfigOf r p = b := by
          dsimp [p]
          exact outerConfigOf_referenceSliceConfig r b u
        have hpMem :
            p ∈
              (Finset.univ : Finset (FourierConfig eta μ)).filter
                (fun q => outerConfigOf r q = b) := by
          exact Finset.mem_filter.mpr ⟨Finset.mem_univ p, hpSlice⟩
        refine ⟨p, hpMem, ?_⟩
        dsimp [p]
        exact referenceSliceConfig_ref r b u
      · intro p hp
        rfl

/--
A uniform bound on the one-particle inverse weight sum.
-/
def HasOneParticleInverseH2WeightBound
    {μ : Type*}
    [Fintype μ]
    (kabs : μ → ℝ)
    (Cs : ℝ) : Prop :=
  oneParticleInverseH2WeightSum kabs ≤ Cs ^ 2

/--
The one-particle bound automatically supplies the slice-wise bound required
by the twenty-ninth milestone.
-/
lemma sliceInverseH2WeightBound_of_oneParticleBound
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kabs : μ → ℝ)
    (Cs : ℝ)
    (hOne :
      HasOneParticleInverseH2WeightBound kabs Cs) :
    HasSliceInverseH2WeightBound
      (outerConfigOf r) kabs Cs := by
  intro b
  exact
    (sliceInverseH2WeightSum_le_oneParticleSum r kabs b).trans hOne

/-! ## Thirty-first milestone: uniform one-particle Sobolev lattice sum -/

/--
The reciprocal-lattice Sobolev weight associated with physical momentum
`k = g nu`.
-/
noncomputable def latticeSobolevWeight
    (g : ℝ) (nu : Lattice3) : ℝ :=
  (1 / (1 + g ^ 2 * latticeNormSq nu)) ^ 2

/--
On cubic shell `n`, the Sobolev weight is bounded by

`g^{-4} (n+1)^{-4}`.
-/
lemma latticeSobolevWeight_shell_bound
    (g : ℝ) (hgpos : 0 < g)
    (n : ℕ) {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    latticeSobolevWeight g nu ≤
      (1 / g ^ 4) / (((n : ℝ) + 1) ^ 4) := by
  let x : ℝ := (n : ℝ) + 1
  have hx : 0 < x := by
    dsimp [x]
    positivity
  have hg2pos : 0 < g ^ 2 := by
    positivity
  have hx2pos : 0 < x ^ 2 := by
    positivity
  have hnorm :
      x ^ 2 ≤ latticeNormSq nu := by
    simpa [x] using cubicSupShell_normSq_lower n hnu
  have hscaled :
      g ^ 2 * x ^ 2 ≤ g ^ 2 * latticeNormSq nu :=
    mul_le_mul_of_nonneg_left hnorm (le_of_lt hg2pos)
  have hsmallDenPos :
      0 < g ^ 2 * x ^ 2 := by
    positivity
  have hbigDenPos :
      0 < 1 + g ^ 2 * latticeNormSq nu := by
    have hnorm0 := latticeNormSq_nonneg nu
    positivity
  have hden :
      g ^ 2 * x ^ 2 ≤ 1 + g ^ 2 * latticeNormSq nu := by
    linarith
  have hinv :
      1 / (1 + g ^ 2 * latticeNormSq nu) ≤
        1 / (g ^ 2 * x ^ 2) :=
    one_div_le_one_div_of_le hsmallDenPos hden
  have hinvLeft0 :
      0 ≤ 1 / (1 + g ^ 2 * latticeNormSq nu) := by
    exact le_of_lt (one_div_pos.mpr hbigDenPos)
  have hinvRight0 :
      0 ≤ 1 / (g ^ 2 * x ^ 2) := by
    exact le_of_lt (one_div_pos.mpr hsmallDenPos)
  have hsquare :
      (1 / (1 + g ^ 2 * latticeNormSq nu)) ^ 2 ≤
        (1 / (g ^ 2 * x ^ 2)) ^ 2 :=
    (sq_le_sq₀ hinvLeft0 hinvRight0).2 hinv
  have hg0 : g ≠ 0 := ne_of_gt hgpos
  have hx0 : x ≠ 0 := ne_of_gt hx
  unfold latticeSobolevWeight
  calc
    (1 / (1 + g ^ 2 * latticeNormSq nu)) ^ 2
        ≤ (1 / (g ^ 2 * x ^ 2)) ^ 2 := hsquare
    _ = (1 / g ^ 4) / x ^ 4 := by
      field_simp [hg0, hx0]
    _ = (1 / g ^ 4) / (((n : ℝ) + 1) ^ 4) := by
      rfl

/--
The explicit cubic shells satisfy the inverse-fourth interface for the
Sobolev weight, with constant `1/g^4`.
-/
lemma cubicSupShell_hasSobolevInverseFourthWeight
    (g : ℝ) (hgpos : 0 < g) :
    HasInverseFourthShellWeight
      cubicSupShell (latticeSobolevWeight g) (1 / g ^ 4) := by
  intro n nu hnu
  exact latticeSobolevWeight_shell_bound g hgpos n hnu

/--
A finite collection of nonzero cubic shells has Sobolev weight at most
`108/g^4`, uniformly in the number of included shells.
-/
lemma latticeSobolevShellTail_uniform_bound
    (g : ℝ) (hgpos : 0 < g)
    (count : ℕ) :
    shellTailMass
        (finiteShellMass cubicSupShell (latticeSobolevWeight g))
        0 count
      ≤ 108 / g ^ 4 := by

  have hCweight0 : 0 ≤ 1 / g ^ 4 := by
    positivity
  have hA0 : 0 ≤ 54 * (1 / g ^ 4) := by
    positivity

  have hDecay :
      ∀ j ∈ Finset.range count,
        finiteShellMass cubicSupShell (latticeSobolevWeight g) (0 + j) ≤
          (54 * (1 / g ^ 4)) /
            ((((0 + j : ℕ) : ℝ) + 1) ^ 2) :=
    finiteShellMass_decay_on_range
      cubicSupShell (latticeSobolevWeight g)
      54 (1 / g ^ 4) 0 count
      (by norm_num) hCweight0
      cubicSupShell_hasQuadraticShellCount
      (cubicSupShell_hasSobolevInverseFourthWeight g hgpos)

  have hTail :
      shellTailMass
          (finiteShellMass cubicSupShell (latticeSobolevWeight g))
          0 count
        ≤ reciprocalShellBudget (54 * (1 / g ^ 4)) 0 :=
    shellTailMass_le_reciprocal_budget
      (finiteShellMass cubicSupShell (latticeSobolevWeight g))
      (54 * (1 / g ^ 4)) 0 count hA0 hDecay

  have hBudget :
      reciprocalShellBudget (54 * (1 / g ^ 4)) 0 =
        108 / g ^ 4 := by
    unfold reciprocalShellBudget
    ring

  rw [hBudget] at hTail
  exact hTail

/-! ## Thirty-second milestone: explicit finite plane-wave momentum type -/

/--
A shell index drawn from `0, ..., count-1`.

Using the coercion of `Finset.range count` as a finite type makes the later
reindexing to `shellTailMass` direct.
-/
abbrev FiniteShellIndex (count : ℕ) :=
  ↥(Finset.range count)

/--
A nonzero plane-wave mode is a shell index together with an actual lattice
point in that cubic shell.
-/
abbrev FiniteNonzeroPlaneWaveMode (count : ℕ) :=
  Σ n : FiniteShellIndex count, ↥(cubicSupShell (n : ℕ))

/--
The finite one-particle plane-wave momentum type: one distinguished zero
mode plus all nonzero lattice modes in shells `0, ..., count-1`.
-/
abbrev FinitePlaneWaveMode (count : ℕ) :=
  Option (FiniteNonzeroPlaneWaveMode count)

/--
Physical momentum magnitude for the explicit finite plane-wave mode set.

For a nonzero lattice point `nu`, this is `g * |nu|_2`; the zero mode has
magnitude zero.
-/
noncomputable def finitePlaneWaveKabs
    (g : ℝ) (count : ℕ) :
    FinitePlaneWaveMode count → ℝ
  | none => 0
  | some q =>
      g * Real.sqrt (latticeNormSq (q.2 : Lattice3))

lemma finitePlaneWaveKabs_nonneg
    (g : ℝ) (count : ℕ)
    (hg0 : 0 ≤ g) :
    ∀ u : FinitePlaneWaveMode count,
      0 ≤ finitePlaneWaveKabs g count u := by
  intro u
  cases u with
  | none =>
      simp [finitePlaneWaveKabs]
  | some q =>
      unfold finitePlaneWaveKabs
      exact mul_nonneg hg0 (Real.sqrt_nonneg _)

/--
The zero mode contributes exactly one to the inverse-`H^2` Sobolev sum.
-/
@[simp]
lemma oneParticleInverseH2Weight_finitePlaneWave_none
    (g : ℝ) (count : ℕ) :
    oneParticleInverseH2Weight
        (finitePlaneWaveKabs g count)
        (none : FinitePlaneWaveMode count) = 1 := by
  unfold oneParticleInverseH2Weight finitePlaneWaveKabs
  norm_num

/--
For a nonzero explicit lattice mode, the abstract one-particle inverse
`H^2` weight is exactly the lattice Sobolev weight.
-/
@[simp]
lemma oneParticleInverseH2Weight_finitePlaneWave_some
    (g : ℝ) (count : ℕ)
    (q : FiniteNonzeroPlaneWaveMode count) :
    oneParticleInverseH2Weight
        (finitePlaneWaveKabs g count)
        (some q) =
      latticeSobolevWeight g (q.2 : Lattice3) := by
  have hnorm0 :
      0 ≤ latticeNormSq (q.2 : Lattice3) :=
    latticeNormSq_nonneg (q.2 : Lattice3)
  have hsqrt :
      (Real.sqrt (latticeNormSq (q.2 : Lattice3))) ^ 2 =
        latticeNormSq (q.2 : Lattice3) :=
    Real.sq_sqrt hnorm0
  unfold oneParticleInverseH2Weight
  unfold finitePlaneWaveKabs
  unfold latticeSobolevWeight
  rw [mul_pow, hsqrt]

/--
The inverse-`H^2` weight sum over the explicit finite mode type is exactly
the zero-mode contribution plus the sum over its cubic shells.
-/
lemma oneParticleInverseH2WeightSum_finitePlaneWave
    (g : ℝ) (count : ℕ) :
    oneParticleInverseH2WeightSum
        (finitePlaneWaveKabs g count) =
      1 +
        shellTailMass
          (finiteShellMass cubicSupShell (latticeSobolevWeight g))
          0 count := by
  unfold oneParticleInverseH2WeightSum

  rw [Fintype.sum_option]
  rw [Fintype.sum_sigma]

  simp only [
    oneParticleInverseH2Weight_finitePlaneWave_none,
    oneParticleInverseH2Weight_finitePlaneWave_some
  ]

  unfold shellTailMass
  simp only [zero_add]

  congr 1

  calc
    (∑ n : FiniteShellIndex count,
        ∑ nu : ↥(cubicSupShell (n : ℕ)),
          latticeSobolevWeight g (nu : Lattice3))
        =
      ∑ n : FiniteShellIndex count,
        finiteShellMass
          cubicSupShell (latticeSobolevWeight g) (n : ℕ) := by
            apply Finset.sum_congr rfl
            intro n hn
            unfold finiteShellMass
            exact
              Finset.sum_coe_sort
                (cubicSupShell (n : ℕ))
                (latticeSobolevWeight g)
    _ =
      ∑ n ∈ Finset.range count,
        finiteShellMass
          cubicSupShell (latticeSobolevWeight g) n := by
            exact
              Finset.sum_coe_sort
                (Finset.range count)
                (fun n =>
                  finiteShellMass
                    cubicSupShell (latticeSobolevWeight g) n)

/--
The explicit finite plane-wave mode set satisfies the one-particle Sobolev
weight bound with no separate mode-cover hypothesis.
-/
lemma finitePlaneWave_hasOneParticleInverseH2WeightBound
    (g Cs : ℝ) (count : ℕ)
    (hgpos : 0 < g)
    (hCsScale :
      1 + 108 / g ^ 4 ≤ Cs ^ 2) :
    HasOneParticleInverseH2WeightBound
      (finitePlaneWaveKabs g count) Cs := by
  unfold HasOneParticleInverseH2WeightBound
  rw [oneParticleInverseH2WeightSum_finitePlaneWave]
  calc
    1 +
        shellTailMass
          (finiteShellMass cubicSupShell (latticeSobolevWeight g))
          0 count
        ≤ 1 + 108 / g ^ 4 := by
      gcongr
      exact latticeSobolevShellTail_uniform_bound g hgpos count
    _ ≤ Cs ^ 2 := hCsScale

/-! ## Thirty-third milestone: finite Young inequality for the high-pass slice -/

/--
Restrict a Fourier vector to one value of an arbitrary slice label.
-/
noncomputable def sliceRestrictedVector
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (v : EuclideanSpace ℂ (FourierConfig eta μ))
    (b : β) :
    EuclideanSpace ℂ (FourierConfig eta μ) := by
  classical
  exact
    WithLp.toLp 2 (fun p =>
      if label p = b then v.ofLp p else 0)

@[simp]
lemma sliceRestrictedVector_apply
    {eta : ℕ} {μ β : Type*}
    [Fintype μ] [DecidableEq β]
    (label : FourierConfig eta μ → β)
    (v : EuclideanSpace ℂ (FourierConfig eta μ))
    (b : β)
    (p : FourierConfig eta μ) :
    (sliceRestrictedVector label v b).ofLp p =
      if label p = b then v.ofLp p else 0 := by
  by_cases hpb : label p = b
  · simp [sliceRestrictedVector, hpb]
  · simp [sliceRestrictedVector, hpb]

/--
The previously defined slice output mass is literally the squared norm of
the restricted output vector.
-/
lemma sliceOutputSq_eq_restricted_norm_sq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (b : β) :
    sliceOutputSq label Whigh coeff b =
      ‖sliceRestrictedVector
          label (Whigh (fullCoeffVector coeff)) b‖ ^ 2 := by
  classical
  unfold sliceOutputSq
  rw [EuclideanSpace.norm_sq_eq]
  apply Finset.sum_congr rfl
  intro p hp
  by_cases hpb : label p = b
  · simp [sliceRestrictedVector, hpb]
  · simp [sliceRestrictedVector, hpb]

/--
The coefficient-weighted sum of a family of slice kernel atoms.

This shared definition fixes the indicator's hidden `Decidable` instance
once and for all.  Both the abstract atom representation and the concrete
reference-kernel expansion use this exact term.
-/
noncomputable def sliceKernelAtomSum
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (coeff : FourierConfig eta μ → ℂ)
    (atom :
      FourierConfig eta μ →
        EuclideanSpace ℂ (FourierConfig eta μ))
    (b : β) :
    EuclideanSpace ℂ (FourierConfig eta μ) := by
  classical
  exact
    ∑ p : FourierConfig eta μ,
      if label p = b then coeff p • atom p else 0

/--
A finite convolution representation on each slice.

For a fixed slice `b`, `atom p` is the translated high-pass kernel generated
by a unit coefficient at input configuration `p`.  The representation says
that the restricted output is the sum of the actual input coefficients
times these atoms, while every atom has norm at most `kernelNorm`.

This is the structural content needed for the finite Young inequality.
-/
def HasSliceKernelAtomRepresentation
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (kernelNorm : ℝ) : Prop :=
  ∀ b : β,
    ∃ atom :
        FourierConfig eta μ →
          EuclideanSpace ℂ (FourierConfig eta μ),
      sliceRestrictedVector
          label (Whigh (fullCoeffVector coeff)) b =
        sliceKernelAtomSum label coeff atom b
      ∧
      ∀ p : FourierConfig eta μ,
        label p = b → ‖atom p‖ ≤ kernelNorm

/--
The finite Young inequality underlying the manuscript's slice-wise
Hölder estimate.

If every translated kernel atom has norm at most `kernelNorm`, then

`sliceOutputSq <= kernelNorm^2 * sliceFourierL1Sq`.
-/
lemma sliceOutputSq_le_kernelNorm_sq_mul_l1_sq
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (kernelNorm : ℝ)
    (hKernelNorm0 : 0 ≤ kernelNorm)
    (hRep :
      HasSliceKernelAtomRepresentation
        label Whigh coeff kernelNorm) :
    ∀ b : β,
      sliceOutputSq label Whigh coeff b ≤
        kernelNorm ^ 2 * sliceFourierL1Sq label coeff b := by
  classical
  intro b

  rcases hRep b with ⟨atom, hVec, hAtom⟩

  let l1 : ℝ :=
    ∑ p : FourierConfig eta μ,
      if label p = b then ‖coeff p‖ else 0

  have hl10 : 0 ≤ l1 := by
    dsimp [l1]
    apply Finset.sum_nonneg
    intro p hp
    by_cases hpb : label p = b
    · simp [hpb]
    · simp [hpb]

  have hTriangle :
      ‖sliceRestrictedVector
          label (Whigh (fullCoeffVector coeff)) b‖ ≤
        kernelNorm * l1 := by
    rw [hVec]
    unfold sliceKernelAtomSum

    have hNormSum :
        ‖∑ p : FourierConfig eta μ,
            if label p = b then coeff p • atom p else 0‖ ≤
          ∑ p : FourierConfig eta μ,
            ‖if label p = b then coeff p • atom p else 0‖ := by
      simpa using
        (norm_sum_le
          (Finset.univ : Finset (FourierConfig eta μ))
          (fun p =>
            if label p = b then coeff p • atom p else 0))

    have hTermSum :
        (∑ p : FourierConfig eta μ,
            ‖if label p = b then coeff p • atom p else 0‖) ≤
          kernelNorm * l1 := by
      calc
        (∑ p : FourierConfig eta μ,
            ‖if label p = b then coeff p • atom p else 0‖)
            ≤
          ∑ p : FourierConfig eta μ,
            kernelNorm *
              (if label p = b then ‖coeff p‖ else 0) := by
                apply Finset.sum_le_sum
                intro p hp
                by_cases hpb : label p = b
                · simp only [if_pos hpb, norm_smul]
                  have hcoeff0 : 0 ≤ ‖coeff p‖ := norm_nonneg _
                  have hmul :
                      ‖coeff p‖ * ‖atom p‖ ≤
                        ‖coeff p‖ * kernelNorm :=
                    mul_le_mul_of_nonneg_left
                      (hAtom p hpb) hcoeff0
                  nlinarith
                · simp [hpb, hKernelNorm0]
        _ = kernelNorm * l1 := by
          dsimp [l1]
          rw [Finset.mul_sum]

    exact hNormSum.trans hTermSum

  have hRhs0 : 0 ≤ kernelNorm * l1 :=
    mul_nonneg hKernelNorm0 hl10

  have hSquare :
      ‖sliceRestrictedVector
          label (Whigh (fullCoeffVector coeff)) b‖ ^ 2 ≤
        (kernelNorm * l1) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _) hRhs0).2 hTriangle

  rw [sliceOutputSq_eq_restricted_norm_sq]
  unfold sliceFourierL1Sq
  dsimp [l1] at hSquare ⊢
  calc
    ‖sliceRestrictedVector
        label (Whigh (fullCoeffVector coeff)) b‖ ^ 2
        ≤
      (kernelNorm *
        (∑ p : FourierConfig eta μ,
          if label p = b then ‖coeff p‖ else 0)) ^ 2 :=
      hSquare
    _ =
      kernelNorm ^ 2 *
        (∑ p : FourierConfig eta μ,
          if label p = b then ‖coeff p‖ else 0) ^ 2 := by
      ring

/--
If `kernelNorm^2` is bounded by the high-pass kernel squared mass, the
finite Young inequality yields the former `HasSliceHolderBound`.
-/
lemma sliceHolderBound_of_kernel_atom_representation
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (kernelNorm kernelTailSq : ℝ)
    (hKernelNorm0 : 0 ≤ kernelNorm)
    (hKernelTail0 : 0 ≤ kernelTailSq)
    (hKernelNormSq :
      kernelNorm ^ 2 ≤ kernelTailSq)
    (hRep :
      HasSliceKernelAtomRepresentation
        label Whigh coeff kernelNorm) :
    HasSliceHolderBound
      label Whigh coeff
      (sliceFourierL1Sq label coeff)
      kernelTailSq := by
  intro b
  have hYoung :=
    sliceOutputSq_le_kernelNorm_sq_mul_l1_sq
      label Whigh coeff kernelNorm hKernelNorm0 hRep b
  have hL1sq0 :
      0 ≤ sliceFourierL1Sq label coeff b := by
    unfold sliceFourierL1Sq
    exact sq_nonneg _
  calc
    sliceOutputSq label Whigh coeff b
        ≤ kernelNorm ^ 2 *
            sliceFourierL1Sq label coeff b :=
      hYoung
    _ ≤ kernelTailSq *
          sliceFourierL1Sq label coeff b :=
      mul_le_mul_of_nonneg_right hKernelNormSq hL1sq0

/--
Specializing `kernelNorm` to the square root of the explicit kernel tail
removes all scalar norm bookkeeping.
-/
lemma sliceHolderBound_of_sqrt_kernel_atom_representation
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (kernelTailSq : ℝ)
    (hKernelTail0 : 0 ≤ kernelTailSq)
    (hRep :
      HasSliceKernelAtomRepresentation
        label Whigh coeff (Real.sqrt kernelTailSq)) :
    HasSliceHolderBound
      label Whigh coeff
      (sliceFourierL1Sq label coeff)
      kernelTailSq := by
  apply sliceHolderBound_of_kernel_atom_representation
    label Whigh coeff
    (Real.sqrt kernelTailSq) kernelTailSq
  · exact Real.sqrt_nonneg _
  · exact hKernelTail0
  · rw [Real.sq_sqrt hKernelTail0]
  · exact hRep

/-! ## Thirty-fourth milestone: explicit reference-particle kernel columns -/

/--
The translated column generated by a concrete one-particle kernel matrix
`kernel v u`.

The atom changes only the reference-particle momentum.  All momenta of the
other particles are fixed to those of the input configuration `p`.
-/
noncomputable def referenceSliceKernelAtom
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (p : FourierConfig eta μ) :
    EuclideanSpace ℂ (FourierConfig eta μ) := by
  classical
  exact
    WithLp.toLp 2 (fun q =>
      if outerConfigOf r q = outerConfigOf r p then
        kernel (q r) (p r)
      else 0)

/--
A concrete finite convolution expansion on every outer slice.

Unlike `HasSliceKernelAtomRepresentation`, there is no existential choice
of atoms here: the atoms are the explicit translated columns
`referenceSliceKernelAtom r kernel p`.
-/
def HasReferenceSliceKernelExpansion
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ) : Prop :=
  ∀ b : OuterConfig eta r μ,
    sliceRestrictedVector
        (outerConfigOf r) (Whigh (fullCoeffVector coeff)) b =
      sliceKernelAtomSum
        (outerConfigOf r) coeff
        (referenceSliceKernelAtom r kernel) b

/--
A uniform norm bound on the concrete translated kernel columns.
-/
def HasReferenceSliceKernelColumnNormBound
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (kernelNorm : ℝ) : Prop :=
  ∀ p : FourierConfig eta μ,
    ‖referenceSliceKernelAtom r kernel p‖ ≤ kernelNorm

/--
The concrete kernel expansion and its column norm bound produce the
existential atom representation used by the finite Young inequality.
-/
lemma hasSliceKernelAtomRepresentation_of_referenceKernel
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (Whigh :
      EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
        EuclideanSpace ℂ (FourierConfig eta μ))
    (coeff : FourierConfig eta μ → ℂ)
    (kernelNorm : ℝ)
    (hExpansion :
      HasReferenceSliceKernelExpansion
        r kernel Whigh coeff)
    (hColumn :
      HasReferenceSliceKernelColumnNormBound
        r kernel kernelNorm) :
    HasSliceKernelAtomRepresentation
      (outerConfigOf r) Whigh coeff kernelNorm := by
  intro b
  refine ⟨referenceSliceKernelAtom r kernel, hExpansion b, ?_⟩
  intro p hp
  exact hColumn p

/-! ## Thirty-fifth milestone: derive kernel-column norms from scalar ℓ² sums -/

/--
The squared `ℓ²` mass of one column of the one-particle kernel matrix.
-/
noncomputable def referenceKernelColumnSq
    {μ : Type*} [Fintype μ]
    (kernel : μ → μ → ℂ)
    (u : μ) : ℝ :=
  ∑ v : μ, ‖kernel v u‖ ^ 2

/--
The norm of an explicit many-particle kernel atom is exactly the `ℓ²` norm
of the corresponding one-particle kernel column.
-/
lemma referenceSliceKernelAtom_norm_sq
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (p : FourierConfig eta μ) :
    ‖referenceSliceKernelAtom r kernel p‖ ^ 2 =
      referenceKernelColumnSq kernel (p r) := by
  classical

  rw [EuclideanSpace.norm_sq_eq]

  have hFilter :
      (∑ q : FourierConfig eta μ,
          ‖(referenceSliceKernelAtom r kernel p).ofLp q‖ ^ 2)
        =
      Finset.sum
        ((Finset.univ : Finset (FourierConfig eta μ)).filter
          (fun q => outerConfigOf r q = outerConfigOf r p))
        (fun q => ‖kernel (q r) (p r)‖ ^ 2) := by
    calc
      (∑ q : FourierConfig eta μ,
          ‖(referenceSliceKernelAtom r kernel p).ofLp q‖ ^ 2)
          =
        ∑ q : FourierConfig eta μ,
          if outerConfigOf r q = outerConfigOf r p then
            ‖kernel (q r) (p r)‖ ^ 2
          else 0 := by
            apply Finset.sum_congr rfl
            intro q hq
            by_cases hs :
                outerConfigOf r q = outerConfigOf r p
            · simp [referenceSliceKernelAtom, hs]
            · simp [referenceSliceKernelAtom, hs]
      _ =
        Finset.sum
          ((Finset.univ : Finset (FourierConfig eta μ)).filter
            (fun q => outerConfigOf r q = outerConfigOf r p))
          (fun q => ‖kernel (q r) (p r)‖ ^ 2) := by
            symm
            rw [Finset.sum_filter]

  rw [hFilter]
  unfold referenceKernelColumnSq

  apply Finset.sum_bij
    (fun q _ => q r)
  · intro q hq
    simp
  · intro q₁ hq₁ q₂ hq₂ href
    have hs₁ :
        outerConfigOf r q₁ = outerConfigOf r p :=
      (Finset.mem_filter.mp hq₁).2
    have hs₂ :
        outerConfigOf r q₂ = outerConfigOf r p :=
      (Finset.mem_filter.mp hq₂).2
    have hq₁rec :
        referenceSliceConfig r (outerConfigOf r p) (q₁ r) = q₁ :=
      referenceSliceConfig_of_outerConfig_eq
        r (outerConfigOf r p) q₁ hs₁
    have hq₂rec :
        referenceSliceConfig r (outerConfigOf r p) (q₂ r) = q₂ :=
      referenceSliceConfig_of_outerConfig_eq
        r (outerConfigOf r p) q₂ hs₂
    calc
      q₁ =
          referenceSliceConfig
            r (outerConfigOf r p) (q₁ r) := hq₁rec.symm
      _ =
          referenceSliceConfig
            r (outerConfigOf r p) (q₂ r) := by
              rw [href]
      _ = q₂ := hq₂rec
  · intro v hv
    let q : FourierConfig eta μ :=
      referenceSliceConfig r (outerConfigOf r p) v
    have hqSlice :
        outerConfigOf r q = outerConfigOf r p := by
      dsimp [q]
      exact
        outerConfigOf_referenceSliceConfig
          r (outerConfigOf r p) v
    have hqMem :
        q ∈
          (Finset.univ : Finset (FourierConfig eta μ)).filter
            (fun z => outerConfigOf r z = outerConfigOf r p) := by
      exact
        Finset.mem_filter.mpr
          ⟨Finset.mem_univ q, hqSlice⟩
    refine ⟨q, hqMem, ?_⟩
    dsimp [q]
    exact referenceSliceConfig_ref r (outerConfigOf r p) v
  · intro q hq
    rfl

/--
A scalar column-square bound for the one-particle kernel.
-/
def HasReferenceKernelColumnSqBound
    {μ : Type*} [Fintype μ]
    (kernel : μ → μ → ℂ)
    (kernelTailSq : ℝ) : Prop :=
  ∀ u : μ,
    referenceKernelColumnSq kernel u ≤ kernelTailSq

/--
The scalar column-square estimate implies the norm bound on every
many-particle translated kernel atom.
-/
lemma referenceSliceKernelColumnNormBound_of_sq
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (kernelTailSq : ℝ)
    (hTail0 : 0 ≤ kernelTailSq)
    (hColumnSq :
      HasReferenceKernelColumnSqBound kernel kernelTailSq) :
    HasReferenceSliceKernelColumnNormBound
      r kernel (Real.sqrt kernelTailSq) := by
  intro p
  have hsq :
      ‖referenceSliceKernelAtom r kernel p‖ ^ 2 ≤
        kernelTailSq := by
    rw [referenceSliceKernelAtom_norm_sq]
    exact hColumnSq (p r)

  have hsqrtSq :
      (Real.sqrt kernelTailSq) ^ 2 = kernelTailSq :=
    Real.sq_sqrt hTail0

  have hsq' :
      ‖referenceSliceKernelAtom r kernel p‖ ^ 2 ≤
        (Real.sqrt kernelTailSq) ^ 2 := by
    rw [hsqrtSq]
    exact hsq

  exact
    (sq_le_sq₀
      (norm_nonneg _)
      (Real.sqrt_nonneg _)).1 hsq'

/-! ## Thirty-sixth milestone: explicit transfer-momentum mass and corrected horizon -/

/--
Pointwise high-pass Coulomb-square weight on the reciprocal lattice.

The cutoff indicator is kept inside this noncomputable definition so its
hidden `Decidable` instance never appears in theorem statements.
-/
noncomputable def highPassCoulombPointWeight
    (K g C : ℝ) (nu : Lattice3) : ℝ := by
  classical
  exact
    if IsAboveHalfCutoff K g nu then
      latticeCoulombSquareWeight C nu
    else 0

lemma highPassCoulombPointWeight_of_pos
    (K g C : ℝ) (nu : Lattice3)
    (hnu : IsAboveHalfCutoff K g nu) :
    highPassCoulombPointWeight K g C nu =
      latticeCoulombSquareWeight C nu := by
  classical
  simp [highPassCoulombPointWeight, hnu]

lemma highPassCoulombPointWeight_of_neg
    (K g C : ℝ) (nu : Lattice3)
    (hnu : ¬ IsAboveHalfCutoff K g nu) :
    highPassCoulombPointWeight K g C nu = 0 := by
  classical
  simp [highPassCoulombPointWeight, hnu]

lemma highPassCoulombPointWeight_nonneg
    (K g C : ℝ) (hC0 : 0 ≤ C) (nu : Lattice3) :
    0 ≤ highPassCoulombPointWeight K g C nu := by
  classical
  by_cases hnu : IsAboveHalfCutoff K g nu
  · rw [highPassCoulombPointWeight_of_pos K g C nu hnu]
    exact latticeCoulombSquareWeight_nonneg C hC0 nu
  · rw [highPassCoulombPointWeight_of_neg K g C nu hnu]

noncomputable def finiteTransferCoulombSquareWeight
    (K g C : ℝ) (shellCount : ℕ)
    (q : FinitePlaneWaveMode shellCount) : ℝ :=
  match q with
  | none => 0
  | some q =>
      highPassCoulombPointWeight K g C (q.2 : Lattice3)

@[simp]
lemma finiteTransferCoulombSquareWeight_none
    (K g C : ℝ) (shellCount : ℕ) :
    finiteTransferCoulombSquareWeight
        K g C shellCount
        (none : FinitePlaneWaveMode shellCount) = 0 := by
  rfl

@[simp]
lemma finiteTransferCoulombSquareWeight_some
    (K g C : ℝ) (shellCount : ℕ)
    (q : FiniteNonzeroPlaneWaveMode shellCount) :
    finiteTransferCoulombSquareWeight K g C shellCount (some q) =
      highPassCoulombPointWeight K g C (q.2 : Lattice3) := by
  rfl

lemma finiteTransferCoulombSquareWeight_nonneg
    (K g C : ℝ) (shellCount : ℕ)
    (hC0 : 0 ≤ C) :
    ∀ q : FinitePlaneWaveMode shellCount,
      0 ≤ finiteTransferCoulombSquareWeight K g C shellCount q := by
  intro q
  cases q with
  | none =>
      simp
  | some q =>
      rw [finiteTransferCoulombSquareWeight_some]
      exact
        highPassCoulombPointWeight_nonneg
          K g C hC0 (q.2 : Lattice3)

/--
The sum over the lattice points in one explicit shell is exactly the
filtered high-pass shell mass.
-/
lemma finiteTransferCoulombSquareWeight_shell_sum
    (K g C : ℝ) (shellCount : ℕ)
    (n : FiniteShellIndex shellCount) :
    (∑ nu : ↥(cubicSupShell (n : ℕ)),
        finiteTransferCoulombSquareWeight
          K g C shellCount (some ⟨n, nu⟩))
      =
    highPassCoulombShellMass K g C (n : ℕ) := by
  classical
  calc
    (∑ nu : ↥(cubicSupShell (n : ℕ)),
        finiteTransferCoulombSquareWeight
          K g C shellCount (some ⟨n, nu⟩))
        =
      ∑ nu : ↥(cubicSupShell (n : ℕ)),
        highPassCoulombPointWeight K g C (nu : Lattice3) := by
          apply Finset.sum_congr rfl
          intro nu hnu
          rw [finiteTransferCoulombSquareWeight_some]
    _ =
      ∑ nu ∈ cubicSupShell (n : ℕ),
        highPassCoulombPointWeight K g C nu := by
          exact
            Finset.sum_coe_sort
              (cubicSupShell (n : ℕ))
              (highPassCoulombPointWeight K g C)
    _ =
      highPassCoulombShellMass K g C (n : ℕ) := by
        unfold highPassCoulombShellMass
        rw [Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro nu hnu
        by_cases h :
            IsAboveHalfCutoff K g nu
        · rw [highPassCoulombPointWeight_of_pos K g C nu h]
          simp [h]
        · rw [highPassCoulombPointWeight_of_neg K g C nu h]
          simp [h]

/--
The total squared Coulomb weight over the explicit finite transfer-momentum
type is exactly the previously defined finite high-pass kernel tail.
-/
lemma finiteTransferCoulombSquareWeight_sum
    (K g C : ℝ) (m count : ℕ) :
    (∑ q : FinitePlaneWaveMode (m + count),
        finiteTransferCoulombSquareWeight
          K g C (m + count) q)
      =
    finiteHighPassKernelTailSq K g C m count := by
  classical
  unfold finiteHighPassKernelTailSq
  rw [Fintype.sum_option]
  rw [Fintype.sum_sigma]
  simp only [finiteTransferCoulombSquareWeight_none, zero_add]

  calc
    (∑ n : FiniteShellIndex (m + count),
        ∑ nu : ↥(cubicSupShell (n : ℕ)),
          finiteTransferCoulombSquareWeight
            K g C (m + count) (some ⟨n, nu⟩))
        =
      ∑ n : FiniteShellIndex (m + count),
        highPassCoulombShellMass K g C (n : ℕ) := by
          apply Finset.sum_congr rfl
          intro n hn
          exact
            finiteTransferCoulombSquareWeight_shell_sum
              K g C (m + count) n
    _ =
      ∑ n ∈ Finset.range (m + count),
        highPassCoulombShellMass K g C n := by
          exact
            Finset.sum_coe_sort
              (Finset.range (m + count))
              (highPassCoulombShellMass K g C)

/--
If the one-particle basis contains cubic shells through radius
`m + basisExtra`, then differences of two such momenta can reach twice that
radius.  The number of transfer shells after the cutoff shell `m` therefore
has to be `m + 2*basisExtra`.
-/
def coulombTransferShellCount
    (m basisExtra : ℕ) : ℕ :=
  m + 2 * basisExtra

lemma cutoff_add_coulombTransferShellCount
    (m basisExtra : ℕ) :
    m + coulombTransferShellCount m basisExtra =
      2 * (m + basisExtra) := by
  unfold coulombTransferShellCount
  omega

/--
For the corrected transfer horizon, the explicit transfer-weight sum is
the high-pass tail through all shells below twice the basis radius.
-/
lemma correctedTransferCoulombSquareWeight_sum
    (K g C : ℝ) (m basisExtra : ℕ) :
    (∑ q :
        FinitePlaneWaveMode (2 * (m + basisExtra)),
        finiteTransferCoulombSquareWeight
          K g C (2 * (m + basisExtra)) q)
      =
    finiteHighPassKernelTailSq
      K g C m (coulombTransferShellCount m basisExtra) := by
  have hcount :
      m + coulombTransferShellCount m basisExtra =
        2 * (m + basisExtra) :=
    cutoff_add_coulombTransferShellCount m basisExtra

  rw [← hcount]

  exact
    finiteTransferCoulombSquareWeight_sum
      K g C m (coulombTransferShellCount m basisExtra)

/-! ## Thirty-seventh milestone: literal lattice momentum differences -/

/--
The integer reciprocal-lattice vector represented by a finite plane-wave
mode.
-/
def finitePlaneWaveLatticeIndex
    (count : ℕ) :
    FinitePlaneWaveMode count → Lattice3
  | none => fun _ => 0
  | some q => (q.2 : Lattice3)

@[simp]
lemma finitePlaneWaveLatticeIndex_none
    (count : ℕ) :
    finitePlaneWaveLatticeIndex count
        (none : FinitePlaneWaveMode count) =
      (fun _ => 0) := by
  rfl

@[simp]
lemma finitePlaneWaveLatticeIndex_some
    (count : ℕ)
    (q : FiniteNonzeroPlaneWaveMode count) :
    finitePlaneWaveLatticeIndex count (some q) =
      (q.2 : Lattice3) := by
  rfl

/--
Subtraction in the reciprocal lattice, written explicitly coordinatewise.
-/
def latticeSub (a b : Lattice3) : Lattice3 :=
  fun i => a i - b i

@[simp]
lemma latticeSub_apply
    (a b : Lattice3) (i : Fin 3) :
    latticeSub a b i = a i - b i := by
  rfl

@[simp]
lemma latticeSub_self
    (a : Lattice3) :
    latticeSub a a = (fun _ => 0) := by
  funext i
  simp [latticeSub]

/--
For fixed input momentum `u`, translation by `-u` is injective in the
output momentum.  This is the key counting fact behind bounding one
Coulomb-kernel column by the total transfer-momentum tail.
-/
lemma latticeSub_right_injective
    (u : Lattice3) :
    Function.Injective (fun v : Lattice3 => latticeSub v u) := by
  intro v₁ v₂ h
  funext i
  have hi := congrFun h i
  simp only [latticeSub_apply] at hi
  omega

/--
The literal reciprocal-lattice transfer associated with a finite
one-particle kernel entry `(v,u)`.
-/
def finitePlaneWaveTransfer
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    Lattice3 :=
  latticeSub
    (finitePlaneWaveLatticeIndex count v)
    (finitePlaneWaveLatticeIndex count u)

@[simp]
lemma finitePlaneWaveTransfer_self
    (count : ℕ)
    (u : FinitePlaneWaveMode count) :
    finitePlaneWaveTransfer count u u =
      (fun _ => 0) := by
  unfold finitePlaneWaveTransfer
  exact latticeSub_self _

/--
The squared high-pass Coulomb weight attached to the literal transfer
`nu_v - nu_u`.

This is now the actual difference-kernel scalar appearing in a Coulomb
convolution column; the only remaining geometric work is to encode every
nonzero difference into the corrected finite transfer-mode type.
-/
noncomputable def finitePlaneWaveDifferenceCoulombSquareWeight
    (K g C : ℝ) (count : ℕ)
    (v u : FinitePlaneWaveMode count) : ℝ := by
  classical
  let nu :=
    finitePlaneWaveTransfer count v u
  exact
    if IsAboveHalfCutoff K g nu then
      latticeCoulombSquareWeight C nu
    else 0

lemma finitePlaneWaveDifferenceCoulombSquareWeight_nonneg
    (K g C : ℝ) (count : ℕ)
    (hC0 : 0 ≤ C)
    (v u : FinitePlaneWaveMode count) :
    0 ≤
      finitePlaneWaveDifferenceCoulombSquareWeight
        K g C count v u := by
  classical
  unfold finitePlaneWaveDifferenceCoulombSquareWeight
  dsimp
  by_cases h :
      IsAboveHalfCutoff K g
        (finitePlaneWaveTransfer count v u)
  · simp only [if_pos h]
    exact
      latticeCoulombSquareWeight_nonneg
        C hC0 (finitePlaneWaveTransfer count v u)
  · simp [h]

/-! ## Thirty-eighth milestone: doubled coordinate horizon for momentum transfers -/

/--
Every lattice point in cubic shell `n` has every coordinate in
`[-(n+1), n+1]`.
-/
lemma cubicSupShell_coord_bounds
    (n : ℕ) {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n)
    (i : Fin 3) :
    -(((n + 1 : ℕ) : ℤ)) ≤ nu i ∧
      nu i ≤ ((n + 1 : ℕ) : ℤ) := by
  classical
  unfold cubicSupShell at hnu
  rcases Finset.mem_image.mp hnu with ⟨p, hp, hpeq⟩
  rw [← hpeq]
  rcases p with ⟨f, ⟨a, b⟩⟩
  rcases centeredCubeCoord_bounds n a with ⟨haLo, haHi⟩
  rcases centeredCubeCoord_bounds n b with ⟨hbLo, hbHi⟩
  fin_cases f <;>
    fin_cases i <;>
    simp [cubeBoundaryPoint] <;>
    omega

/--
Every explicit finite plane-wave mode with `count` shells has every lattice
coordinate bounded in magnitude by `count`.
-/
lemma finitePlaneWaveLatticeIndex_coord_bounds
    (count : ℕ)
    (u : FinitePlaneWaveMode count)
    (i : Fin 3) :
    -((count : ℕ) : ℤ) ≤
        finitePlaneWaveLatticeIndex count u i ∧
      finitePlaneWaveLatticeIndex count u i ≤
        ((count : ℕ) : ℤ) := by
  cases u with
  | none =>
      simp [finitePlaneWaveLatticeIndex]
  | some q =>
      have hShell :
          -((((q.1 : ℕ) + 1 : ℕ) : ℤ)) ≤
              (q.2 : Lattice3) i ∧
            (q.2 : Lattice3) i ≤
              (((q.1 : ℕ) + 1 : ℕ) : ℤ) :=
        cubicSupShell_coord_bounds
          (q.1 : ℕ) q.2.property i

      have hIndexLt :
          (q.1 : ℕ) < count := by
        exact Finset.mem_range.mp q.1.property

      have hRadiusNat :
          (q.1 : ℕ) + 1 ≤ count := by
        omega

      have hRadiusInt :
          ((((q.1 : ℕ) + 1 : ℕ) : ℤ)) ≤
            ((count : ℕ) : ℤ) := by
        exact_mod_cast hRadiusNat

      simp only [finitePlaneWaveLatticeIndex_some]
      constructor <;> omega

/--
Consequently every literal transfer `nu_v - nu_u` between two modes from a
`count`-shell basis has every coordinate bounded in magnitude by
`2 * count`.
-/
lemma finitePlaneWaveTransfer_coord_bounds
    (count : ℕ)
    (v u : FinitePlaneWaveMode count)
    (i : Fin 3) :
    -(2 * ((count : ℕ) : ℤ)) ≤
        finitePlaneWaveTransfer count v u i ∧
      finitePlaneWaveTransfer count v u i ≤
        2 * ((count : ℕ) : ℤ) := by
  rcases
      finitePlaneWaveLatticeIndex_coord_bounds count v i with
    ⟨hvLo, hvHi⟩
  rcases
      finitePlaneWaveLatticeIndex_coord_bounds count u i with
    ⟨huLo, huHi⟩
  unfold finitePlaneWaveTransfer
  simp only [latticeSub_apply]
  constructor <;> omega

/-! ## Thirty-ninth milestone: surjectivity of the six cubic faces -/

/--
Every integer in the interval `[-(n+1), n+1]` is represented by one of the
centered coordinates in `Fin (2*n+3)`.
-/
lemma exists_centeredCubeCoord_eq
    (n : ℕ) (z : ℤ)
    (hzLo : -(((n + 1 : ℕ) : ℤ)) ≤ z)
    (hzHi : z ≤ ((n + 1 : ℕ) : ℤ)) :
    ∃ i : Fin (2 * n + 3),
      centeredCubeCoord n i = z := by
  let r : ℤ := ((n + 1 : ℕ) : ℤ)

  have hz0 : 0 ≤ z + r := by
    dsimp [r]
    omega

  have hzlt :
      z + r < (((2 * n + 3 : ℕ) : ℤ)) := by
    dsimp [r]
    omega

  let k : ℕ := (z + r).toNat

  have hklt : k < 2 * n + 3 := by
    dsimp [k]
    rw [Int.toNat_lt hz0]
    exact hzlt

  let i : Fin (2 * n + 3) := ⟨k, hklt⟩
  refine ⟨i, ?_⟩

  unfold centeredCubeCoord
  change (((z + r).toNat : ℕ) : ℤ) -
      ((n + 1 : ℕ) : ℤ) = z
  rw [Int.toNat_of_nonneg hz0]
  dsimp [r] at *
  omega

/--
The six face parameterizations cover every integer lattice point on the
boundary of the cube of radius `n+1`.

The first six hypotheses say that every coordinate lies in the cube.  The
last hypothesis says that at least one coordinate lies on one of its six
faces.
-/
lemma cubicSupShell_mem_of_boundary
    (n : ℕ) (nu : Lattice3)
    (h0Lo : -(((n + 1 : ℕ) : ℤ)) ≤ nu (0 : Fin 3))
    (h0Hi : nu (0 : Fin 3) ≤ ((n + 1 : ℕ) : ℤ))
    (h1Lo : -(((n + 1 : ℕ) : ℤ)) ≤ nu (1 : Fin 3))
    (h1Hi : nu (1 : Fin 3) ≤ ((n + 1 : ℕ) : ℤ))
    (h2Lo : -(((n + 1 : ℕ) : ℤ)) ≤ nu (2 : Fin 3))
    (h2Hi : nu (2 : Fin 3) ≤ ((n + 1 : ℕ) : ℤ))
    (hBoundary :
      nu (0 : Fin 3) = ((n + 1 : ℕ) : ℤ) ∨
      nu (0 : Fin 3) = -(((n + 1 : ℕ) : ℤ)) ∨
      nu (1 : Fin 3) = ((n + 1 : ℕ) : ℤ) ∨
      nu (1 : Fin 3) = -(((n + 1 : ℕ) : ℤ)) ∨
      nu (2 : Fin 3) = ((n + 1 : ℕ) : ℤ) ∨
      nu (2 : Fin 3) = -(((n + 1 : ℕ) : ℤ))) :
    nu ∈ cubicSupShell n := by
  classical

  rcases exists_centeredCubeCoord_eq n (nu (0 : Fin 3)) h0Lo h0Hi with
    ⟨a0, ha0⟩
  rcases exists_centeredCubeCoord_eq n (nu (1 : Fin 3)) h1Lo h1Hi with
    ⟨a1, ha1⟩
  rcases exists_centeredCubeCoord_eq n (nu (2 : Fin 3)) h2Lo h2Hi with
    ⟨a2, ha2⟩

  unfold cubicSupShell
  apply Finset.mem_image.mpr

  rcases hBoundary with h0p | h0n | h1p | h1n | h2p | h2n
  · refine
      ⟨((0 : Fin 6), (a1, a2)),
        Finset.mem_univ _, ?_⟩
    funext i
    fin_cases i <;>
      simp [cubeBoundaryPoint, ha1, ha2, h0p]
  · refine
      ⟨((1 : Fin 6), (a1, a2)),
        Finset.mem_univ _, ?_⟩
    funext i
    fin_cases i <;>
      simp [cubeBoundaryPoint, ha1, ha2, h0n]
  · refine
      ⟨((2 : Fin 6), (a0, a2)),
        Finset.mem_univ _, ?_⟩
    funext i
    fin_cases i <;>
      simp [cubeBoundaryPoint, ha0, ha2, h1p]
  · refine
      ⟨((3 : Fin 6), (a0, a2)),
        Finset.mem_univ _, ?_⟩
    funext i
    fin_cases i <;>
      simp [cubeBoundaryPoint, ha0, ha2, h1n]
  · refine
      ⟨((4 : Fin 6), (a0, a1)),
        Finset.mem_univ _, ?_⟩
    funext i
    fin_cases i <;>
      simp [cubeBoundaryPoint, ha0, ha1, h2p]
  · refine
      ⟨((5 : Fin 6), (a0, a1)),
        Finset.mem_univ _, ?_⟩
    funext i
    fin_cases i <;>
      simp [cubeBoundaryPoint, ha0, ha1, h2n]

/--
Equivalent convenient form: it is enough to know that some coordinate is
equal to `±(n+1)`.
-/
lemma cubicSupShell_mem_of_exists_boundary_coord
    (n : ℕ) (nu : Lattice3)
    (hBounds :
      ∀ i : Fin 3,
        -(((n + 1 : ℕ) : ℤ)) ≤ nu i ∧
          nu i ≤ ((n + 1 : ℕ) : ℤ))
    (hBoundary :
      ∃ i : Fin 3,
        nu i = ((n + 1 : ℕ) : ℤ) ∨
          nu i = -(((n + 1 : ℕ) : ℤ))) :
    nu ∈ cubicSupShell n := by
  rcases hBounds (0 : Fin 3) with ⟨h0Lo, h0Hi⟩
  rcases hBounds (1 : Fin 3) with ⟨h1Lo, h1Hi⟩
  rcases hBounds (2 : Fin 3) with ⟨h2Lo, h2Hi⟩
  rcases hBoundary with ⟨i, hi⟩
  fin_cases i
  · rcases hi with h | h
    · exact cubicSupShell_mem_of_boundary
        n nu h0Lo h0Hi h1Lo h1Hi h2Lo h2Hi
        (Or.inl h)
    · exact cubicSupShell_mem_of_boundary
        n nu h0Lo h0Hi h1Lo h1Hi h2Lo h2Hi
        (Or.inr (Or.inl h))
  · rcases hi with h | h
    · exact cubicSupShell_mem_of_boundary
        n nu h0Lo h0Hi h1Lo h1Hi h2Lo h2Hi
        (Or.inr (Or.inr (Or.inl h)))
    · exact cubicSupShell_mem_of_boundary
        n nu h0Lo h0Hi h1Lo h1Hi h2Lo h2Hi
        (Or.inr (Or.inr (Or.inr (Or.inl h))))
  · rcases hi with h | h
    · exact cubicSupShell_mem_of_boundary
        n nu h0Lo h0Hi h1Lo h1Hi h2Lo h2Hi
        (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
    · exact cubicSupShell_mem_of_boundary
        n nu h0Lo h0Hi h1Lo h1Hi h2Lo h2Hi
        (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h)))))

/-! ## Fortieth milestone: full cubic-shell cover and transfer encoding -/

/--
Every nonzero integer lattice vector in the cube of coordinate radius `R`
belongs to one of the explicit shells `0, ..., R-1`.

The proof is by induction on `R`.  Either the vector already lies in the
smaller cube of radius `R-1`, or some coordinate is forced to be exactly
`±R`, in which case milestone 39's face-surjectivity lemma applies.
-/
lemma exists_cubicSupShell_of_nonzero_coord_bounds
    (R : ℕ) (nu : Lattice3)
    (hne : nu ≠ (fun _ => 0))
    (hBounds :
      ∀ i : Fin 3,
        -((R : ℕ) : ℤ) ≤ nu i ∧
          nu i ≤ ((R : ℕ) : ℤ)) :
    ∃ n : ℕ, n < R ∧ nu ∈ cubicSupShell n := by
  induction R with
  | zero =>
      have hzero : nu = (fun _ => 0) := by
        funext i
        have hi := hBounds i
        simp only [Nat.cast_zero, neg_zero] at hi
        omega
      exact False.elim (hne hzero)

  | succ R ih =>
      by_cases hInner :
          ∀ i : Fin 3,
            -((R : ℕ) : ℤ) ≤ nu i ∧
              nu i ≤ ((R : ℕ) : ℤ)
      · rcases ih hInner with ⟨n, hnlt, hnmem⟩
        refine ⟨n, ?_, hnmem⟩
        omega

      · push Not at hInner
        rcases hInner with ⟨i, hi⟩
        rcases hBounds i with ⟨hiLo, hiHi⟩

        have hiFace :
            nu i = (((R + 1 : ℕ) : ℤ)) ∨
              nu i = -(((R + 1 : ℕ) : ℤ)) := by
          by_cases hLo :
              -((R : ℕ) : ℤ) ≤ nu i
          · have hHiFail : ((R : ℕ) : ℤ) < nu i :=
              hi hLo
            left
            omega
          · right
            omega

        have hShellBounds :
            ∀ j : Fin 3,
              -((((R + 1 : ℕ)) : ℤ)) ≤ nu j ∧
                nu j ≤ (((R + 1 : ℕ)) : ℤ) := by
          intro j
          have hj := hBounds j
          simpa [Nat.succ_eq_add_one] using hj

        have hmem :
            nu ∈ cubicSupShell R := by
          apply cubicSupShell_mem_of_exists_boundary_coord R nu
          · exact hShellBounds
          · exact ⟨i, hiFace⟩

        exact ⟨R, Nat.lt_succ_self R, hmem⟩

/--
Every nonzero literal transfer between two modes of a `count`-shell basis
can be encoded as a member of the explicit `2*count`-shell transfer type.
-/
lemma finitePlaneWaveTransfer_encodable
    (count : ℕ)
    (v u : FinitePlaneWaveMode count)
    (hne :
      finitePlaneWaveTransfer count v u ≠
        (fun _ => 0)) :
    ∃ q : FiniteNonzeroPlaneWaveMode (2 * count),
      (q.2 : Lattice3) =
        finitePlaneWaveTransfer count v u := by

  have hBounds :
      ∀ i : Fin 3,
        -(((2 * count : ℕ) : ℤ)) ≤
            finitePlaneWaveTransfer count v u i ∧
          finitePlaneWaveTransfer count v u i ≤
            (((2 * count : ℕ) : ℤ)) := by
    intro i
    rcases
        finitePlaneWaveTransfer_coord_bounds count v u i with
      ⟨hLo, hHi⟩
    constructor
    · calc
        -(((2 * count : ℕ) : ℤ))
            = -(2 * ((count : ℕ) : ℤ)) := by
                push_cast
                ring
        _ ≤ finitePlaneWaveTransfer count v u i := hLo
    · calc
        finitePlaneWaveTransfer count v u i
            ≤ 2 * ((count : ℕ) : ℤ) := hHi
        _ = (((2 * count : ℕ) : ℤ)) := by
              push_cast
              ring

  rcases
      exists_cubicSupShell_of_nonzero_coord_bounds
        (2 * count)
        (finitePlaneWaveTransfer count v u)
        hne hBounds with
    ⟨n, hnlt, hnmem⟩

  let shellIndex : FiniteShellIndex (2 * count) :=
    ⟨n, Finset.mem_range.mpr hnlt⟩

  let shellPoint :
      ↥(cubicSupShell (shellIndex : ℕ)) :=
    ⟨finitePlaneWaveTransfer count v u, hnmem⟩

  refine ⟨⟨shellIndex, shellPoint⟩, ?_⟩
  rfl

/--
The transfer encoded above necessarily represents the original literal
difference, and its shell index is strictly below the doubled basis
horizon.  This is the exact finite-basis bridge needed before applying the
injectivity of `v ↦ v-u`.
-/
lemma exists_finiteTransferMode_eq_difference
    (count : ℕ)
    (v u : FinitePlaneWaveMode count)
    (hne :
      finitePlaneWaveTransfer count v u ≠
        (fun _ => 0)) :
    ∃ q : FinitePlaneWaveMode (2 * count),
      q ≠ none ∧
      finitePlaneWaveLatticeIndex (2 * count) q =
        finitePlaneWaveTransfer count v u := by
  rcases finitePlaneWaveTransfer_encodable count v u hne with
    ⟨q, hq⟩
  refine ⟨some q, ?_, ?_⟩
  · simp
  · simpa using hq

/-! ## Forty-first milestone: disjoint cubic shells and injective mode encoding -/

/--
Every point in `cubicSupShell n` lies on at least one of the six faces:
some coordinate is exactly `±(n+1)`.
-/
lemma cubicSupShell_exists_boundary_coord
    (n : ℕ) {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    ∃ i : Fin 3,
      nu i = ((n + 1 : ℕ) : ℤ) ∨
        nu i = -(((n + 1 : ℕ) : ℤ)) := by
  classical
  unfold cubicSupShell at hnu
  rcases Finset.mem_image.mp hnu with ⟨p, hp, hpeq⟩
  rw [← hpeq]
  rcases p with ⟨f, ⟨a, b⟩⟩
  fin_cases f
  · refine ⟨(0 : Fin 3), Or.inl ?_⟩
    simp [cubeBoundaryPoint]
  · refine ⟨(0 : Fin 3), Or.inr ?_⟩
    simp [cubeBoundaryPoint]
  · refine ⟨(1 : Fin 3), Or.inl ?_⟩
    simp [cubeBoundaryPoint]
  · refine ⟨(1 : Fin 3), Or.inr ?_⟩
    simp [cubeBoundaryPoint]
  · refine ⟨(2 : Fin 3), Or.inl ?_⟩
    simp [cubeBoundaryPoint]
  · refine ⟨(2 : Fin 3), Or.inr ?_⟩
    simp [cubeBoundaryPoint]

/--
The explicit cubic shells are pairwise disjoint: if the same lattice point
belongs to shell `n` and shell `m`, then `n = m`.
-/
lemma cubicSupShell_index_unique
    {n m : ℕ} {nu : Lattice3}
    (hn : nu ∈ cubicSupShell n)
    (hm : nu ∈ cubicSupShell m) :
    n = m := by
  rcases cubicSupShell_exists_boundary_coord n hn with
    ⟨i, hi⟩
  rcases cubicSupShell_coord_bounds m hm i with
    ⟨hmLo, hmHi⟩

  have hnm : n ≤ m := by
    rcases hi with hi | hi <;> omega

  rcases cubicSupShell_exists_boundary_coord m hm with
    ⟨j, hj⟩
  rcases cubicSupShell_coord_bounds n hn j with
    ⟨hnLo, hnHi⟩

  have hmn : m ≤ n := by
    rcases hj with hj | hj <;> omega

  omega

/--
No explicit cubic shell contains the zero lattice vector.
-/
lemma cubicSupShell_ne_zero
    (n : ℕ) {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    nu ≠ (fun _ => 0) := by
  intro hzero
  rcases cubicSupShell_exists_boundary_coord n hnu with
    ⟨i, hi⟩
  have hzi : nu i = 0 := by
    rw [hzero]
  rcases hi with hi | hi <;> omega

/--
The nonzero finite plane-wave representation is injective as a lattice
vector: shell index plus shell point does not duplicate any reciprocal
lattice momentum.
-/
lemma finiteNonzeroPlaneWaveMode_latticeIndex_injective
    (count : ℕ) :
    Function.Injective
      (fun q : FiniteNonzeroPlaneWaveMode count =>
        (q.2 : Lattice3)) := by
  intro q₁ q₂ hq
  rcases q₁ with ⟨n₁, p₁⟩
  rcases q₂ with ⟨n₂, p₂⟩

  change (p₁ : Lattice3) = (p₂ : Lattice3) at hq

  have hp₂mem :
      (p₁ : Lattice3) ∈ cubicSupShell (n₂ : ℕ) := by
    rw [hq]
    exact p₂.property

  have hnval :
      (n₁ : ℕ) = (n₂ : ℕ) :=
    cubicSupShell_index_unique
      p₁.property hp₂mem

  have hn : n₁ = n₂ := by
    exact Subtype.ext hnval

  cases hn

  have hp : p₁ = p₂ := by
    exact Subtype.ext hq

  cases hp
  rfl

/--
The full finite plane-wave mode type, including the distinguished zero
mode, has an injective map to its reciprocal-lattice vector.
-/
lemma finitePlaneWaveLatticeIndex_injective
    (count : ℕ) :
    Function.Injective
      (finitePlaneWaveLatticeIndex count) := by
  intro u v huv
  cases u with
  | none =>
      cases v with
      | none =>
          rfl
      | some q =>
          exfalso
          have hqzero :
              (q.2 : Lattice3) = (fun _ => 0) := by
            simpa using huv.symm
          exact
            (cubicSupShell_ne_zero
              (q.1 : ℕ) q.2.property) hqzero
  | some q₁ =>
      cases v with
      | none =>
          exfalso
          have hqzero :
              (q₁.2 : Lattice3) = (fun _ => 0) := by
            simpa using huv
          exact
            (cubicSupShell_ne_zero
              (q₁.1 : ℕ) q₁.2.property) hqzero
      | some q₂ =>
          have hq :
              q₁ = q₂ := by
            apply finiteNonzeroPlaneWaveMode_latticeIndex_injective count
            simpa using huv
          cases hq
          rfl

/--
For fixed input mode `u`, the literal finite-basis transfer
`v ↦ nu_v - nu_u` is injective in `v`.
-/
lemma finitePlaneWaveTransfer_left_injective
    (count : ℕ)
    (u : FinitePlaneWaveMode count) :
    Function.Injective
      (fun v : FinitePlaneWaveMode count =>
        finitePlaneWaveTransfer count v u) := by
  intro v₁ v₂ htransfer

  have hindex :
      finitePlaneWaveLatticeIndex count v₁ =
        finitePlaneWaveLatticeIndex count v₂ := by
    apply
      latticeSub_right_injective
        (finitePlaneWaveLatticeIndex count u)
    exact htransfer

  exact
    finitePlaneWaveLatticeIndex_injective
      count hindex

/-! ## Forty-second milestone: inject a difference-kernel column into the transfer tail -/

/--
Every literal finite-basis transfer, including zero, has a representative
in the doubled transfer-mode type.
-/
lemma exists_finitePlaneWaveTransferMode
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    ∃ q : FinitePlaneWaveMode (2 * count),
      finitePlaneWaveLatticeIndex (2 * count) q =
        finitePlaneWaveTransfer count v u := by
  by_cases hzero :
      finitePlaneWaveTransfer count v u = (fun _ => 0)
  · refine ⟨none, ?_⟩
    rw [finitePlaneWaveLatticeIndex_none]
    exact hzero.symm
  · rcases
        exists_finiteTransferMode_eq_difference
          count v u hzero with
      ⟨q, hqne, hq⟩
    exact ⟨q, hq⟩

/--
Choose one transfer-mode representative for every literal difference.
-/
noncomputable def finitePlaneWaveTransferMode
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    FinitePlaneWaveMode (2 * count) :=
  Classical.choose
    (exists_finitePlaneWaveTransferMode count v u)

lemma finitePlaneWaveTransferMode_spec
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    finitePlaneWaveLatticeIndex (2 * count)
        (finitePlaneWaveTransferMode count v u) =
      finitePlaneWaveTransfer count v u :=
  Classical.choose_spec
    (exists_finitePlaneWaveTransferMode count v u)

/--
For fixed `u`, the chosen transfer-mode representative is injective in
`v`.  Equality of representatives implies equality of their lattice
vectors, hence equality of the literal transfers, and milestone 41 then
gives equality of the original basis modes.
-/
lemma finitePlaneWaveTransferMode_left_injective
    (count : ℕ)
    (u : FinitePlaneWaveMode count) :
    Function.Injective
      (fun v : FinitePlaneWaveMode count =>
        finitePlaneWaveTransferMode count v u) := by
  intro v₁ v₂ hmode
  apply finitePlaneWaveTransfer_left_injective count u
  calc
    finitePlaneWaveTransfer count v₁ u
        =
      finitePlaneWaveLatticeIndex (2 * count)
        (finitePlaneWaveTransferMode count v₁ u) :=
      (finitePlaneWaveTransferMode_spec count v₁ u).symm
    _ =
      finitePlaneWaveLatticeIndex (2 * count)
        (finitePlaneWaveTransferMode count v₂ u) := by
          change
            finitePlaneWaveTransferMode count v₁ u =
              finitePlaneWaveTransferMode count v₂ u
            at hmode
          rw [hmode]
    _ =
      finitePlaneWaveTransfer count v₂ u :=
      finitePlaneWaveTransferMode_spec count v₂ u

lemma highPassCoulombPointWeight_zero
    (K g C : ℝ) :
    highPassCoulombPointWeight K g C (fun _ => 0) = 0 := by
  apply highPassCoulombPointWeight_of_neg
  intro h
  unfold IsAboveHalfCutoff at h
  have hz :
      latticeNormSq (fun _ => 0) = 0 := by
    norm_num [latticeNormSq]
  rw [hz] at h
  have hs : 0 ≤ (K / 2) ^ 2 := sq_nonneg _
  nlinarith

/--
The explicit transfer-mode weight depends only on the lattice vector
represented by the mode.
-/
lemma finiteTransferCoulombSquareWeight_eq_pointWeight
    (K g C : ℝ) (count : ℕ)
    (q : FinitePlaneWaveMode count) :
    finiteTransferCoulombSquareWeight K g C count q =
      highPassCoulombPointWeight K g C
        (finitePlaneWaveLatticeIndex count q) := by
  cases q with
  | none =>
      rw [finiteTransferCoulombSquareWeight_none]
      rw [finitePlaneWaveLatticeIndex_none]
      exact (highPassCoulombPointWeight_zero K g C).symm
  | some q =>
      rw [finiteTransferCoulombSquareWeight_some]
      rw [finitePlaneWaveLatticeIndex_some]

/--
The previously defined literal difference weight is exactly the named
pointwise high-pass Coulomb weight evaluated at `nu_v - nu_u`.
-/
lemma finitePlaneWaveDifferenceCoulombSquareWeight_eq_pointWeight
    (K g C : ℝ) (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    finitePlaneWaveDifferenceCoulombSquareWeight
        K g C count v u =
      highPassCoulombPointWeight
        K g C (finitePlaneWaveTransfer count v u) := by
  classical
  by_cases h :
      IsAboveHalfCutoff K g
        (finitePlaneWaveTransfer count v u)
  · rw [highPassCoulombPointWeight_of_pos
          K g C (finitePlaneWaveTransfer count v u) h]
    unfold finitePlaneWaveDifferenceCoulombSquareWeight
    simp [h]
  · rw [highPassCoulombPointWeight_of_neg
          K g C (finitePlaneWaveTransfer count v u) h]
    unfold finitePlaneWaveDifferenceCoulombSquareWeight
    simp [h]

/--
The weight of the chosen doubled-basis transfer representative is exactly
the literal Coulomb difference weight.
-/
lemma finiteTransferCoulombSquareWeight_transferMode
    (K g C : ℝ) (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    finiteTransferCoulombSquareWeight
        K g C (2 * count)
        (finitePlaneWaveTransferMode count v u)
      =
    finitePlaneWaveDifferenceCoulombSquareWeight
        K g C count v u := by
  calc
    finiteTransferCoulombSquareWeight
        K g C (2 * count)
        (finitePlaneWaveTransferMode count v u)
        =
      highPassCoulombPointWeight K g C
        (finitePlaneWaveLatticeIndex (2 * count)
          (finitePlaneWaveTransferMode count v u)) :=
      finiteTransferCoulombSquareWeight_eq_pointWeight
        K g C (2 * count)
        (finitePlaneWaveTransferMode count v u)
    _ =
      highPassCoulombPointWeight K g C
        (finitePlaneWaveTransfer count v u) := by
          rw [finitePlaneWaveTransferMode_spec]
    _ =
      finitePlaneWaveDifferenceCoulombSquareWeight
        K g C count v u :=
      (finitePlaneWaveDifferenceCoulombSquareWeight_eq_pointWeight
        K g C count v u).symm

/--
For fixed input mode `u`, the total squared high-pass Coulomb difference
weight of the finite kernel column is bounded by the total explicit weight
of the doubled transfer basis.
-/
lemma finitePlaneWaveDifferenceColumnSq_le_transferSum
    (K g C : ℝ) (count : ℕ)
    (hC0 : 0 ≤ C)
    (u : FinitePlaneWaveMode count) :
    (∑ v : FinitePlaneWaveMode count,
        finitePlaneWaveDifferenceCoulombSquareWeight
          K g C count v u)
      ≤
    ∑ q : FinitePlaneWaveMode (2 * count),
      finiteTransferCoulombSquareWeight
        K g C (2 * count) q := by
  classical

  let f :
      FinitePlaneWaveMode count →
        FinitePlaneWaveMode (2 * count) :=
    fun v => finitePlaneWaveTransferMode count v u

  have hfInjective : Function.Injective f := by
    dsimp [f]
    exact finitePlaneWaveTransferMode_left_injective count u

  have hImageEq :
      (∑ v : FinitePlaneWaveMode count,
          finitePlaneWaveDifferenceCoulombSquareWeight
            K g C count v u)
        =
      Finset.sum
        ((Finset.univ :
            Finset (FinitePlaneWaveMode count)).image f)
        (finiteTransferCoulombSquareWeight
          K g C (2 * count)) := by
    apply Finset.sum_bij
      (fun v _ => f v)
    · intro v hv
      exact Finset.mem_image.mpr
        ⟨v, Finset.mem_univ v, rfl⟩
    · intro v₁ hv₁ v₂ hv₂ hfv
      exact hfInjective hfv
    · intro q hq
      rcases Finset.mem_image.mp hq with
        ⟨v, hv, hvq⟩
      exact ⟨v, hv, hvq⟩
    · intro v hv
      exact
        (finiteTransferCoulombSquareWeight_transferMode
          K g C count v u).symm

  rw [hImageEq]

  refine
    Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.subset_univ _) ?_

  intro q hqUniv hqNotImage
  exact
    finiteTransferCoulombSquareWeight_nonneg
      K g C (2 * count) hC0 q

/--
For the BO basis radius `m + basisExtra`, the difference-kernel column is
bounded by the corrected finite high-pass transfer tail.
-/
lemma finitePlaneWaveDifferenceColumnSq_le_correctedTail
    (K g C : ℝ) (m basisExtra : ℕ)
    (hC0 : 0 ≤ C)
    (u : FinitePlaneWaveMode (m + basisExtra)) :
    (∑ v : FinitePlaneWaveMode (m + basisExtra),
        finitePlaneWaveDifferenceCoulombSquareWeight
          K g C (m + basisExtra) v u)
      ≤
    finiteHighPassKernelTailSq
      K g C m
      (coulombTransferShellCount m basisExtra) := by
  calc
    (∑ v : FinitePlaneWaveMode (m + basisExtra),
        finitePlaneWaveDifferenceCoulombSquareWeight
          K g C (m + basisExtra) v u)
        ≤
      ∑ q : FinitePlaneWaveMode (2 * (m + basisExtra)),
        finiteTransferCoulombSquareWeight
          K g C (2 * (m + basisExtra)) q :=
      finitePlaneWaveDifferenceColumnSq_le_transferSum
        K g C (m + basisExtra) hC0 u
    _ =
      finiteHighPassKernelTailSq
        K g C m
        (coulombTransferShellCount m basisExtra) :=
      correctedTransferCoulombSquareWeight_sum
        K g C m basisExtra

/--
If the squared modulus of each one-particle kernel entry is the explicit
high-pass Coulomb difference weight, then the scalar column-tail bound is
automatic.
-/
lemma referenceKernelColumnSqBound_of_coulombDifference
    (K g C : ℝ) (m basisExtra : ℕ)
    (hC0 : 0 ≤ C)
    (kernel :
      FinitePlaneWaveMode (m + basisExtra) →
      FinitePlaneWaveMode (m + basisExtra) → ℂ)
    (hKernelSq :
      ∀ v u : FinitePlaneWaveMode (m + basisExtra),
        ‖kernel v u‖ ^ 2 =
          finitePlaneWaveDifferenceCoulombSquareWeight
            K g C (m + basisExtra) v u) :
    HasReferenceKernelColumnSqBound
      kernel
      (finiteHighPassKernelTailSq
        K g C m
        (coulombTransferShellCount m basisExtra)) := by
  intro u
  unfold referenceKernelColumnSq
  calc
    (∑ v : FinitePlaneWaveMode (m + basisExtra),
        ‖kernel v u‖ ^ 2)
        =
      ∑ v : FinitePlaneWaveMode (m + basisExtra),
        finitePlaneWaveDifferenceCoulombSquareWeight
          K g C (m + basisExtra) v u := by
            apply Finset.sum_congr rfl
            intro v hv
            exact hKernelSq v u
    _ ≤
      finiteHighPassKernelTailSq
        K g C m
        (coulombTransferShellCount m basisExtra) :=
      finitePlaneWaveDifferenceColumnSq_le_correctedTail
        K g C m basisExtra hC0 u

/-! ## Forty-third milestone: explicit high-pass Coulomb kernel coefficient -/

/--
The explicit complex high-pass Coulomb coefficient associated with one
literal finite-basis momentum transfer.

The physical Coulomb Fourier coefficients are real and nonnegative (up to
the overall charge/sign convention already absorbed elsewhere), so for the
present norm estimate it is natural to take the positive square root of the
already formalized squared coefficient.
-/
noncomputable def finiteHighPassCoulombKernel
    (K g C : ℝ) (count : ℕ)
    (v u : FinitePlaneWaveMode count) : ℂ :=
  (Real.sqrt
    (finitePlaneWaveDifferenceCoulombSquareWeight
      K g C count v u) : ℝ)

/--
For nonnegative Coulomb prefactor `C`, the squared modulus of the explicit
kernel is exactly the previously defined high-pass Coulomb-square weight.
-/
lemma finiteHighPassCoulombKernel_norm_sq
    (K g C : ℝ) (count : ℕ)
    (hC0 : 0 ≤ C)
    (v u : FinitePlaneWaveMode count) :
    ‖finiteHighPassCoulombKernel K g C count v u‖ ^ 2 =
      finitePlaneWaveDifferenceCoulombSquareWeight
        K g C count v u := by
  have hw0 :
      0 ≤
        finitePlaneWaveDifferenceCoulombSquareWeight
          K g C count v u :=
    finitePlaneWaveDifferenceCoulombSquareWeight_nonneg
      K g C count hC0 v u

  unfold finiteHighPassCoulombKernel
  simp only [Complex.norm_real, Real.norm_eq_abs]
  rw [abs_of_nonneg (Real.sqrt_nonneg _)]
  exact Real.sq_sqrt hw0

/--
The explicit high-pass Coulomb kernel automatically satisfies the scalar
column-square bound proved abstractly in milestone 42.
-/
lemma finiteHighPassCoulombKernel_hasColumnSqBound
    (K g C : ℝ) (m basisExtra : ℕ)
    (hC0 : 0 ≤ C) :
    HasReferenceKernelColumnSqBound
      (finiteHighPassCoulombKernel
        K g C (m + basisExtra))
      (finiteHighPassKernelTailSq
        K g C m
        (coulombTransferShellCount m basisExtra)) := by
  apply
    referenceKernelColumnSqBound_of_coulombDifference
      K g C m basisExtra hC0
      (finiteHighPassCoulombKernel
        K g C (m + basisExtra))
  intro v u
  exact
    finiteHighPassCoulombKernel_norm_sq
      K g C (m + basisExtra) hC0 v u

/-! ## Forty-fourth milestone: explicit high-pass convolution operator -/

/--
Linear restriction to one Fourier slice.
-/
noncomputable def sliceRestrictionLinearMap
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (b : β) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ) := by
  classical
  exact
  {
    toFun := fun v => sliceRestrictedVector label v b
    map_add' := by
      intro u v
      ext p
      by_cases hp : label p = b
      · simp [sliceRestrictedVector, hp]
      · simp [sliceRestrictedVector, hp]
    map_smul' := by
      intro z u
      ext p
      by_cases hp : label p = b
      · simp [sliceRestrictedVector, hp]
      · simp [sliceRestrictedVector, hp]
  }

@[simp]
lemma sliceRestrictionLinearMap_apply
    {eta : ℕ} {μ β : Type*}
    [Fintype μ]
    (label : FourierConfig eta μ → β)
    (b : β)
    (v : EuclideanSpace ℂ (FourierConfig eta μ)) :
    sliceRestrictionLinearMap label b v =
      sliceRestrictedVector label v b := by
  rfl

/--
If the input configuration `p` belongs to slice `b`, then restricting its
kernel atom to `b` leaves the atom unchanged.
-/
lemma sliceRestrictedVector_referenceSliceKernelAtom_of_eq
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (p : FourierConfig eta μ)
    (b : OuterConfig eta r μ)
    (hp : outerConfigOf r p = b) :
    sliceRestrictedVector
        (outerConfigOf r)
        (referenceSliceKernelAtom r kernel p)
        b
      =
    referenceSliceKernelAtom r kernel p := by
  classical
  ext q
  by_cases hq : outerConfigOf r q = b
  · have hqp :
        outerConfigOf r q = outerConfigOf r p := by
      exact hq.trans hp.symm
    simp [sliceRestrictedVector, referenceSliceKernelAtom,
      hq, hqp]
  · have hqne :
        outerConfigOf r q ≠ outerConfigOf r p := by
      intro h
      apply hq
      exact h.trans hp
    simp [sliceRestrictedVector, referenceSliceKernelAtom,
      hq, hqne]

/--
If the input configuration `p` does not belong to slice `b`, then
restricting its kernel atom to `b` gives zero.
-/
lemma sliceRestrictedVector_referenceSliceKernelAtom_of_ne
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (p : FourierConfig eta μ)
    (b : OuterConfig eta r μ)
    (hp : outerConfigOf r p ≠ b) :
    sliceRestrictedVector
        (outerConfigOf r)
        (referenceSliceKernelAtom r kernel p)
        b
      =
    0 := by
  classical
  ext q
  by_cases hq : outerConfigOf r q = b
  · have hqne :
        outerConfigOf r q ≠ outerConfigOf r p := by
      intro h
      apply hp
      exact h.symm.trans hq
    rw [sliceRestrictedVector_apply]
    rw [if_pos hq]
    simp [referenceSliceKernelAtom, hqne]
  · simp [sliceRestrictedVector, hq]

/--
The finite reference-particle convolution operator generated by a
one-particle kernel matrix.

It is written as the finite linear combination of the explicit kernel
columns from milestone 34.
-/
noncomputable def referenceKernelConvolutionOperator
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ) := by
  classical
  exact
  {
    toFun := fun u =>
      ∑ p : FourierConfig eta μ,
        u.ofLp p • referenceSliceKernelAtom r kernel p
    map_add' := by
      intro u v
      ext q
      simp [add_smul, Finset.sum_add_distrib]
    map_smul' := by
      intro z u
      ext q
      simp [mul_smul]
      rw [Finset.mul_sum]
  }

lemma referenceKernelConvolutionOperator_eq_sum
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    referenceKernelConvolutionOperator r kernel u =
      ∑ p : FourierConfig eta μ,
        u.ofLp p • referenceSliceKernelAtom r kernel p := by
  rfl

lemma referenceKernelConvolutionOperator_fullCoeffVector
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (coeff : FourierConfig eta μ → ℂ) :
    referenceKernelConvolutionOperator
        r kernel (fullCoeffVector coeff)
      =
    ∑ p : FourierConfig eta μ,
      coeff p • referenceSliceKernelAtom r kernel p := by
  rfl

/--
The shared atom sum is exactly the sum of coefficients times the
corresponding slice-restricted atoms.

This formulation avoids comparing two independently elaborated indicator
sums, so their hidden `Decidable` instances never have to be definitionally
equal.
-/
lemma sliceKernelAtomSum_eq_sum_restrictedAtoms
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (coeff : FourierConfig eta μ → ℂ)
    (b : OuterConfig eta r μ) :
    sliceKernelAtomSum
        (outerConfigOf r) coeff
        (referenceSliceKernelAtom r kernel) b
      =
    ∑ p : FourierConfig eta μ,
      coeff p •
        sliceRestrictedVector
          (outerConfigOf r)
          (referenceSliceKernelAtom r kernel p)
          b := by
  classical
  unfold sliceKernelAtomSum
  apply Finset.sum_congr rfl
  intro p hpFin
  by_cases hp : outerConfigOf r p = b
  · rw [
      sliceRestrictedVector_referenceSliceKernelAtom_of_eq
        r kernel p b hp]
    simp [hp]
  · rw [
      sliceRestrictedVector_referenceSliceKernelAtom_of_ne
        r kernel p b hp]
    simp [hp]

/--
The explicit convolution operator has exactly the slice expansion required
by milestone 34.
-/
lemma referenceKernelConvolutionOperator_hasExpansion
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (coeff : FourierConfig eta μ → ℂ) :
    HasReferenceSliceKernelExpansion
      r kernel
      (referenceKernelConvolutionOperator r kernel)
      coeff := by
  classical
  intro b

  rw [referenceKernelConvolutionOperator_fullCoeffVector]

  change
    sliceRestrictionLinearMap
        (outerConfigOf r) b
        (∑ p : FourierConfig eta μ,
          coeff p • referenceSliceKernelAtom r kernel p)
      =
    sliceKernelAtomSum
      (outerConfigOf r) coeff
      (referenceSliceKernelAtom r kernel) b

  calc
    sliceRestrictionLinearMap
        (outerConfigOf r) b
        (∑ p : FourierConfig eta μ,
          coeff p • referenceSliceKernelAtom r kernel p)
        =
      ∑ p : FourierConfig eta μ,
        coeff p •
          sliceRestrictedVector
            (outerConfigOf r)
            (referenceSliceKernelAtom r kernel p)
            b := by
              rw [map_sum]
              apply Finset.sum_congr rfl
              intro p hpFin
              rw [map_smul]
              rw [sliceRestrictionLinearMap_apply]
    _ =
      sliceKernelAtomSum
        (outerConfigOf r) coeff
        (referenceSliceKernelAtom r kernel) b :=
      (sliceKernelAtomSum_eq_sum_restrictedAtoms
        r kernel coeff b).symm

/--
The explicit high-pass convolution operator used in the BO theorem.
-/
noncomputable def explicitHighPassCoulombOperator
    (eta : ℕ)
    (r : Fin eta)
    (K g C : ℝ)
    (count : ℕ) :
    EuclideanSpace ℂ
        (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ
        (FourierConfig eta (FinitePlaneWaveMode count)) :=
  referenceKernelConvolutionOperator
    r (finiteHighPassCoulombKernel K g C count)

/--
The explicit high-pass Coulomb operator automatically satisfies the
remaining slice-kernel expansion hypothesis.
-/
lemma explicitHighPassCoulombOperator_hasExpansion
    (eta : ℕ)
    (r : Fin eta)
    (K g C : ℝ)
    (count : ℕ)
    (coeff :
      FourierConfig eta (FinitePlaneWaveMode count) → ℂ) :
    HasReferenceSliceKernelExpansion
      r
      (finiteHighPassCoulombKernel K g C count)
      (explicitHighPassCoulombOperator eta r K g C count)
      coeff := by
  exact
    referenceKernelConvolutionOperator_hasExpansion
      r
      (finiteHighPassCoulombKernel K g C count)
      coeff

/-! ## Forty-fifth milestone: explicit low-pass convolution interface -/

/--
A pointwise one-particle kernel support condition sufficient for the
reference-particle low-pass support property.

If the output reference momentum lies above `K` while the input reference
momentum is not above `K/2`, the kernel entry vanishes.
-/
def HasReferenceKernelLowPassSupport
    {μ : Type*}
    (K : ℝ)
    (kabs : μ → ℝ)
    (kernel : μ → μ → ℂ) : Prop :=
  ∀ v u : μ,
    K < kabs v →
    ¬ K / 2 < kabs u →
    kernel v u = 0

/--
For an input configuration whose reference momentum is at most `K/2`, the
`>K` reference tail of its explicit kernel atom vanishes.
-/
lemma referenceTailOperator_referenceSliceKernelAtom_eq_zero
    {eta : ℕ} {μ : Type*}
    [Fintype μ] [DecidableEq μ]
    (K : ℝ)
    (kabs : μ → ℝ)
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (hSupport :
      HasReferenceKernelLowPassSupport K kabs kernel)
    (p : FourierConfig eta μ)
    (hp : ¬ K / 2 < kabs (p r)) :
    referenceTailOperator K kabs r
        (referenceSliceKernelAtom r kernel p) =
      0 := by
  classical
  ext q
  by_cases hq : K < kabs (q r)
  · rw [referenceTailOperator_apply]
    rw [if_pos hq]
    by_cases houter :
        outerConfigOf r q = outerConfigOf r p
    · have hkzero :
          kernel (q r) (p r) = 0 :=
        hSupport (q r) (p r) hq hp
      simp [referenceSliceKernelAtom, houter, hkzero]
    · simp [referenceSliceKernelAtom, houter]
  · simp [referenceTailOperator_apply, hq]

/--
A reference-particle convolution whose one-particle kernel obeys the
pointwise low-pass support condition automatically satisfies the operator
support identity used in the BO potential-tail proof.
-/
lemma referenceKernelConvolutionOperator_hasLowPassSupport
    {eta : ℕ} {μ : Type*}
    [Fintype μ] [DecidableEq μ]
    (K : ℝ)
    (kabs : μ → ℝ)
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (hSupport :
      HasReferenceKernelLowPassSupport K kabs kernel) :
    HasLowPassReferenceSupport
      K kabs r
      (referenceKernelConvolutionOperator r kernel) := by
  classical
  intro u

  let tailHalf :=
    referenceTailOperator (K / 2) kabs r u

  calc
    referenceTailOperator K kabs r
        (referenceKernelConvolutionOperator r kernel u)
        =
      ∑ p : FourierConfig eta μ,
        u.ofLp p •
          referenceTailOperator K kabs r
            (referenceSliceKernelAtom r kernel p) := by
              rw [referenceKernelConvolutionOperator_eq_sum]
              rw [map_sum]
              apply Finset.sum_congr rfl
              intro p hpFin
              rw [map_smul]
    _ =
      ∑ p : FourierConfig eta μ,
        tailHalf.ofLp p •
          referenceTailOperator K kabs r
            (referenceSliceKernelAtom r kernel p) := by
              apply Finset.sum_congr rfl
              intro p hpFin
              by_cases hp :
                  K / 2 < kabs (p r)
              · simp [tailHalf, referenceTailOperator_apply, hp]
              · have hzero :=
                  referenceTailOperator_referenceSliceKernelAtom_eq_zero
                    K kabs r kernel hSupport p hp
                simp [tailHalf, referenceTailOperator_apply, hp, hzero]
    _ =
      referenceTailOperator K kabs r
        (referenceKernelConvolutionOperator r kernel tailHalf) := by
              rw [referenceKernelConvolutionOperator_eq_sum]
              rw [map_sum]
              apply Finset.sum_congr rfl
              intro p hpFin
              rw [map_smul]
    _ =
      referenceTailOperator K kabs r
        (referenceKernelConvolutionOperator r kernel
          (referenceTailOperator (K / 2) kabs r u)) := by
              rfl

/-! ## Forty-sixth milestone: explicit complementary low-pass Coulomb kernel -/

/--
Squared Coulomb weight on the complementary low-transfer region.

This is the complement of `highPassCoulombPointWeight`: transfers above the
physical half-cutoff have zero low-pass weight, while all other transfers
carry the explicit Coulomb-square weight.
-/
noncomputable def lowPassCoulombPointWeight
    (K g C : ℝ) (nu : Lattice3) : ℝ := by
  classical
  exact
    if IsAboveHalfCutoff K g nu then
      0
    else
      latticeCoulombSquareWeight C nu

lemma lowPassCoulombPointWeight_nonneg
    (K g C : ℝ)
    (hC0 : 0 ≤ C)
    (nu : Lattice3) :
    0 ≤ lowPassCoulombPointWeight K g C nu := by
  classical
  unfold lowPassCoulombPointWeight
  by_cases hnu : IsAboveHalfCutoff K g nu
  · simp [hnu]
  · simp only [if_neg hnu]
    exact latticeCoulombSquareWeight_nonneg C hC0 nu

/--
The complementary low-pass squared weight associated with the literal
finite-basis transfer `nu_v - nu_u`.
-/
noncomputable def finitePlaneWaveLowPassDifferenceSquareWeight
    (K g C : ℝ)
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) : ℝ :=
  lowPassCoulombPointWeight
    K g C (finitePlaneWaveTransfer count v u)

/--
An explicit low-pass Coulomb kernel.

The square-root factor is exactly the complementary Coulomb coefficient.
The first indicator enforces the reference-tail support property used in
the bootstrap: a coefficient connecting input momentum at most `K/2`
directly to output momentum above `K` is set to zero.

For the physical difference kernel this extra indicator is redundant by
the reverse triangle inequality; keeping it explicit here separates that
geometric fact from the operator-norm estimate.
-/
noncomputable def finiteLowPassCoulombKernel
    (K g C : ℝ)
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) : ℂ := by
  classical
  let kabs := finitePlaneWaveKabs g count
  exact
    if K < kabs v ∧ ¬ K / 2 < kabs u then
      0
    else
      (Real.sqrt
        (finitePlaneWaveLowPassDifferenceSquareWeight
          K g C count v u) : ℝ)

/--
The explicit low-pass kernel satisfies the pointwise reference-tail support
condition by construction.
-/
lemma finiteLowPassCoulombKernel_hasReferenceSupport
    (K g C : ℝ)
    (count : ℕ) :
    HasReferenceKernelLowPassSupport
      K
      (finitePlaneWaveKabs g count)
      (finiteLowPassCoulombKernel K g C count) := by
  intro v u hv hu
  classical
  unfold finiteLowPassCoulombKernel
  dsimp
  simp [hv, hu]

/-! ## Forty-seventh milestone: finite Schur bound for the low-pass operator -/

/--
A weighted finite Cauchy--Schwarz inequality in the form used by Schur's
test:
`(sum w_i x_i)^2 <= (sum w_i) (sum w_i x_i^2)`.
-/
lemma finite_weighted_cauchy_sq
    {α : Type*} [Fintype α]
    (w x : α → ℝ)
    (hw : ∀ i : α, 0 ≤ w i) :
    (∑ i : α, w i * x i) ^ 2 ≤
      (∑ i : α, w i) *
        (∑ i : α, w i * (x i) ^ 2) := by
  classical

  let f : α → ℝ := fun i => Real.sqrt (w i)
  let h : α → ℝ := fun i => Real.sqrt (w i) * x i

  have hCS :=
    Finset.sum_mul_sq_le_sq_mul_sq
      (Finset.univ : Finset α) f h

  have hfh :
      (∑ i : α, f i * h i) =
        ∑ i : α, w i * x i := by
    apply Finset.sum_congr rfl
    intro i hi
    dsimp [f, h]
    calc
      Real.sqrt (w i) * (Real.sqrt (w i) * x i)
          =
        (Real.sqrt (w i)) ^ 2 * x i := by ring
      _ = w i * x i := by
        rw [Real.sq_sqrt (hw i)]

  have hf2 :
      (∑ i : α, (f i) ^ 2) =
        ∑ i : α, w i := by
    apply Finset.sum_congr rfl
    intro i hi
    dsimp [f]
    exact Real.sq_sqrt (hw i)

  have hh2 :
      (∑ i : α, (h i) ^ 2) =
        ∑ i : α, w i * (x i) ^ 2 := by
    apply Finset.sum_congr rfl
    intro i hi
    dsimp [h]
    calc
      (Real.sqrt (w i) * x i) ^ 2
          =
        (Real.sqrt (w i)) ^ 2 * (x i) ^ 2 := by ring
      _ = w i * (x i) ^ 2 := by
        rw [Real.sq_sqrt (hw i)]

  rw [hfh, hf2, hh2] at hCS
  exact hCS

/--
Finite Schur test for a complex matrix.

If every row has `ℓ¹` norm at most `R` and every column has `ℓ¹` norm at
most `C`, then the squared `ℓ²` norm of the matrix action is at most
`R*C` times the squared input norm.
-/
lemma finite_schur_sum_sq
    {α : Type*} [Fintype α]
    (kernel : α → α → ℂ)
    (x : α → ℂ)
    (R C : ℝ)
    (hR0 : 0 ≤ R)
    (hC0 : 0 ≤ C)
    (hRow :
      ∀ q : α,
        (∑ p : α, ‖kernel q p‖) ≤ R)
    (hColumn :
      ∀ p : α,
        (∑ q : α, ‖kernel q p‖) ≤ C) :
    (∑ q : α,
        ‖∑ p : α, x p * kernel q p‖ ^ 2)
      ≤
    R * C * (∑ p : α, ‖x p‖ ^ 2) := by
  classical

  have hPoint :
      ∀ q : α,
        ‖∑ p : α, x p * kernel q p‖ ^ 2
          ≤
        R *
          (∑ p : α,
            ‖kernel q p‖ * ‖x p‖ ^ 2) := by
    intro q

    have hTriangle :
        ‖∑ p : α, x p * kernel q p‖
          ≤
        ∑ p : α, ‖kernel q p‖ * ‖x p‖ := by
      have h :=
        norm_sum_le
          (Finset.univ : Finset α)
          (fun p => x p * kernel q p)
      calc
        ‖∑ p : α, x p * kernel q p‖
            ≤
          ∑ p : α, ‖x p * kernel q p‖ := h
        _ =
          ∑ p : α, ‖kernel q p‖ * ‖x p‖ := by
            apply Finset.sum_congr rfl
            intro p hp
            rw [norm_mul]
            ring

    have hsum0 :
        0 ≤ ∑ p : α, ‖kernel q p‖ * ‖x p‖ := by
      apply Finset.sum_nonneg
      intro p hp
      exact mul_nonneg (norm_nonneg _) (norm_nonneg _)

    have hTriangleSq :
        ‖∑ p : α, x p * kernel q p‖ ^ 2
          ≤
        (∑ p : α, ‖kernel q p‖ * ‖x p‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hsum0).2 hTriangle

    have hWeighted :=
      finite_weighted_cauchy_sq
        (fun p : α => ‖kernel q p‖)
        (fun p : α => ‖x p‖)
        (fun p => norm_nonneg (kernel q p))

    have hWeightedSum0 :
        0 ≤
          ∑ p : α,
            ‖kernel q p‖ * ‖x p‖ ^ 2 := by
      apply Finset.sum_nonneg
      intro p hp
      exact mul_nonneg (norm_nonneg _) (sq_nonneg _)

    have hRowMul :
        (∑ p : α, ‖kernel q p‖) *
            (∑ p : α,
              ‖kernel q p‖ * ‖x p‖ ^ 2)
          ≤
        R *
            (∑ p : α,
              ‖kernel q p‖ * ‖x p‖ ^ 2) :=
      mul_le_mul_of_nonneg_right
        (hRow q) hWeightedSum0

    exact
      hTriangleSq.trans
        (hWeighted.trans hRowMul)

  calc
    (∑ q : α,
        ‖∑ p : α, x p * kernel q p‖ ^ 2)
        ≤
      ∑ q : α,
        R *
          (∑ p : α,
            ‖kernel q p‖ * ‖x p‖ ^ 2) := by
          apply Finset.sum_le_sum
          intro q hq
          exact hPoint q
    _ =
      R *
        (∑ q : α,
          ∑ p : α,
            ‖kernel q p‖ * ‖x p‖ ^ 2) := by
          rw [Finset.mul_sum]
    _ =
      R *
        (∑ p : α,
          ∑ q : α,
            ‖kernel q p‖ * ‖x p‖ ^ 2) := by
          congr 1
          rw [Finset.sum_comm]
    _ ≤
      R *
        (∑ p : α,
          C * ‖x p‖ ^ 2) := by
          apply mul_le_mul_of_nonneg_left _ hR0
          apply Finset.sum_le_sum
          intro p hp
          calc
            (∑ q : α,
                ‖kernel q p‖ * ‖x p‖ ^ 2)
                =
              (∑ q : α, ‖kernel q p‖) *
                ‖x p‖ ^ 2 := by
                  rw [Finset.sum_mul]
            _ ≤
              C * ‖x p‖ ^ 2 :=
                mul_le_mul_of_nonneg_right
                  (hColumn p) (sq_nonneg _)
    _ =
      R * C * (∑ p : α, ‖x p‖ ^ 2) := by
          rw [← Finset.mul_sum]
          exact (mul_assoc R C (∑ p : α, ‖x p‖ ^ 2)).symm

/--
The configuration-space kernel induced by a reference-particle
one-particle kernel.

Defining it through the already-established translated atom keeps the
slice indicator hidden inside one shared noncomputable definition.
-/
noncomputable def referenceConfigurationKernel
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (q p : FourierConfig eta μ) : ℂ :=
  (referenceSliceKernelAtom r kernel p).ofLp q

/--
The explicit reference-kernel convolution is the finite matrix action of
`referenceConfigurationKernel`.
-/
lemma referenceKernelConvolutionOperator_apply
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ))
    (q : FourierConfig eta μ) :
    (referenceKernelConvolutionOperator r kernel u).ofLp q =
      ∑ p : FourierConfig eta μ,
        u.ofLp p * referenceConfigurationKernel r kernel q p := by
  classical
  rw [referenceKernelConvolutionOperator_eq_sum]
  unfold referenceConfigurationKernel
  simp

/--
Uniform configuration-space row `ℓ¹` bound.
-/
def HasReferenceConfigurationKernelRowL1Bound
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (B : ℝ) : Prop :=
  ∀ q : FourierConfig eta μ,
    (∑ p : FourierConfig eta μ,
      ‖referenceConfigurationKernel r kernel q p‖) ≤ B

/--
Uniform configuration-space column `ℓ¹` bound.
-/
def HasReferenceConfigurationKernelColumnL1Bound
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (B : ℝ) : Prop :=
  ∀ p : FourierConfig eta μ,
    (∑ q : FourierConfig eta μ,
      ‖referenceConfigurationKernel r kernel q p‖) ≤ B

/--
Schur's test gives the squared norm bound for the explicit many-particle
reference-kernel convolution.
-/
lemma referenceKernelConvolutionOperator_norm_sq_le_of_schur
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (R C : ℝ)
    (hR0 : 0 ≤ R)
    (hC0 : 0 ≤ C)
    (hRow :
      HasReferenceConfigurationKernelRowL1Bound
        r kernel R)
    (hColumn :
      HasReferenceConfigurationKernelColumnL1Bound
        r kernel C)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖referenceKernelConvolutionOperator r kernel u‖ ^ 2
      ≤
    R * C * ‖u‖ ^ 2 := by
  classical
  rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq]

  calc
    (∑ q : FourierConfig eta μ,
        ‖(referenceKernelConvolutionOperator r kernel u).ofLp q‖ ^ 2)
        =
      ∑ q : FourierConfig eta μ,
        ‖∑ p : FourierConfig eta μ,
            u.ofLp p *
              referenceConfigurationKernel r kernel q p‖ ^ 2 := by
          apply Finset.sum_congr rfl
          intro q hq
          rw [referenceKernelConvolutionOperator_apply]
    _ ≤
      R * C *
        (∑ p : FourierConfig eta μ, ‖u.ofLp p‖ ^ 2) :=
      finite_schur_sum_sq
        (referenceConfigurationKernel r kernel)
        (fun p => u.ofLp p)
        R C hR0 hC0 hRow hColumn

/--
If the row and column bounds are both `B`, the operator norm is at most
`B`.
-/
lemma referenceKernelConvolutionOperator_norm_le_of_schur
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (B : ℝ)
    (hB0 : 0 ≤ B)
    (hRow :
      HasReferenceConfigurationKernelRowL1Bound
        r kernel B)
    (hColumn :
      HasReferenceConfigurationKernelColumnL1Bound
        r kernel B)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖referenceKernelConvolutionOperator r kernel u‖
      ≤
    B * ‖u‖ := by
  have hsq :=
    referenceKernelConvolutionOperator_norm_sq_le_of_schur
      r kernel B B hB0 hB0 hRow hColumn u

  have hright0 :
      0 ≤ B * ‖u‖ :=
    mul_nonneg hB0 (norm_nonneg _)

  have hsq' :
      ‖referenceKernelConvolutionOperator r kernel u‖ ^ 2
        ≤
      (B * ‖u‖) ^ 2 := by
    calc
      ‖referenceKernelConvolutionOperator r kernel u‖ ^ 2
          ≤
        B * B * ‖u‖ ^ 2 := hsq
      _ = (B * ‖u‖) ^ 2 := by ring

  exact
    (sq_le_sq₀
      (norm_nonneg _)
      hright0).1 hsq'

/-! ## Forty-eighth milestone: reduce configuration Schur sums to one-particle sums -/

/--
The one-particle row `ℓ¹` sum of a kernel matrix.
-/
noncomputable def referenceKernelRowL1
    {μ : Type*} [Fintype μ]
    (kernel : μ → μ → ℂ)
    (v : μ) : ℝ :=
  ∑ u : μ, ‖kernel v u‖

/--
The one-particle column `ℓ¹` sum of a kernel matrix.
-/
noncomputable def referenceKernelColumnL1
    {μ : Type*} [Fintype μ]
    (kernel : μ → μ → ℂ)
    (u : μ) : ℝ :=
  ∑ v : μ, ‖kernel v u‖

def HasReferenceKernelRowL1Bound
    {μ : Type*} [Fintype μ]
    (kernel : μ → μ → ℂ)
    (B : ℝ) : Prop :=
  ∀ v : μ, referenceKernelRowL1 kernel v ≤ B

def HasReferenceKernelColumnL1Bound
    {μ : Type*} [Fintype μ]
    (kernel : μ → μ → ℂ)
    (B : ℝ) : Prop :=
  ∀ u : μ, referenceKernelColumnL1 kernel u ≤ B

/--
A coordinate of the induced configuration kernel is the underlying
one-particle kernel entry when the two configurations have the same outer
slice.
-/
lemma referenceConfigurationKernel_of_outer_eq
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (q p : FourierConfig eta μ)
    (h :
      outerConfigOf r q = outerConfigOf r p) :
    referenceConfigurationKernel r kernel q p =
      kernel (q r) (p r) := by
  classical
  unfold referenceConfigurationKernel
  change
    (if outerConfigOf r q = outerConfigOf r p then
      kernel (q r) (p r)
    else 0) =
      kernel (q r) (p r)
  exact if_pos h

/--
A coordinate of the induced configuration kernel vanishes when the two
configurations lie in different outer slices.
-/
lemma referenceConfigurationKernel_of_outer_ne
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (q p : FourierConfig eta μ)
    (h :
      outerConfigOf r q ≠ outerConfigOf r p) :
    referenceConfigurationKernel r kernel q p = 0 := by
  classical
  unfold referenceConfigurationKernel
  change
    (if outerConfigOf r q = outerConfigOf r p then
      kernel (q r) (p r)
    else 0) = 0
  exact if_neg h

/--
For a fixed input configuration `p`, the configuration-space column sum is
exactly the one-particle kernel column sum at reference momentum `p r`.
-/
lemma referenceConfigurationKernel_columnL1_eq
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (p : FourierConfig eta μ) :
    (∑ q : FourierConfig eta μ,
        ‖referenceConfigurationKernel r kernel q p‖)
      =
    referenceKernelColumnL1 kernel (p r) := by
  classical

  have hFilter :
      (∑ q : FourierConfig eta μ,
          ‖referenceConfigurationKernel r kernel q p‖)
        =
      Finset.sum
        ((Finset.univ : Finset (FourierConfig eta μ)).filter
          (fun q => outerConfigOf r q = outerConfigOf r p))
        (fun q => ‖kernel (q r) (p r)‖) := by
    calc
      (∑ q : FourierConfig eta μ,
          ‖referenceConfigurationKernel r kernel q p‖)
          =
        ∑ q : FourierConfig eta μ,
          if outerConfigOf r q = outerConfigOf r p then
            ‖kernel (q r) (p r)‖
          else 0 := by
            apply Finset.sum_congr rfl
            intro q hq
            by_cases hs :
                outerConfigOf r q = outerConfigOf r p
            · rw [if_pos hs]
              rw [
                referenceConfigurationKernel_of_outer_eq
                  r kernel q p hs]
            · rw [if_neg hs]
              rw [
                referenceConfigurationKernel_of_outer_ne
                  r kernel q p hs]
              exact norm_zero
      _ =
        Finset.sum
          ((Finset.univ : Finset (FourierConfig eta μ)).filter
            (fun q => outerConfigOf r q = outerConfigOf r p))
          (fun q => ‖kernel (q r) (p r)‖) := by
            symm
            rw [Finset.sum_filter]

  rw [hFilter]
  unfold referenceKernelColumnL1

  apply Finset.sum_bij
    (fun q _ => q r)
  · intro q hq
    simp
  · intro q₁ hq₁ q₂ hq₂ href
    have hs₁ :
        outerConfigOf r q₁ = outerConfigOf r p :=
      (Finset.mem_filter.mp hq₁).2
    have hs₂ :
        outerConfigOf r q₂ = outerConfigOf r p :=
      (Finset.mem_filter.mp hq₂).2
    have hq₁rec :
        referenceSliceConfig r (outerConfigOf r p) (q₁ r) = q₁ :=
      referenceSliceConfig_of_outerConfig_eq
        r (outerConfigOf r p) q₁ hs₁
    have hq₂rec :
        referenceSliceConfig r (outerConfigOf r p) (q₂ r) = q₂ :=
      referenceSliceConfig_of_outerConfig_eq
        r (outerConfigOf r p) q₂ hs₂
    calc
      q₁ =
          referenceSliceConfig
            r (outerConfigOf r p) (q₁ r) := hq₁rec.symm
      _ =
          referenceSliceConfig
            r (outerConfigOf r p) (q₂ r) := by
              rw [href]
      _ = q₂ := hq₂rec
  · intro v hv
    let q : FourierConfig eta μ :=
      referenceSliceConfig r (outerConfigOf r p) v
    have hqSlice :
        outerConfigOf r q = outerConfigOf r p := by
      dsimp [q]
      exact
        outerConfigOf_referenceSliceConfig
          r (outerConfigOf r p) v
    have hqMem :
        q ∈
          (Finset.univ : Finset (FourierConfig eta μ)).filter
            (fun z => outerConfigOf r z = outerConfigOf r p) := by
      exact
        Finset.mem_filter.mpr
          ⟨Finset.mem_univ q, hqSlice⟩
    refine ⟨q, hqMem, ?_⟩
    dsimp [q]
    exact referenceSliceConfig_ref r (outerConfigOf r p) v
  · intro q hq
    rfl

/--
For a fixed output configuration `q`, the configuration-space row sum is
exactly the one-particle kernel row sum at reference momentum `q r`.
-/
lemma referenceConfigurationKernel_rowL1_eq
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (q : FourierConfig eta μ) :
    (∑ p : FourierConfig eta μ,
        ‖referenceConfigurationKernel r kernel q p‖)
      =
    referenceKernelRowL1 kernel (q r) := by
  classical

  have hFilter :
      (∑ p : FourierConfig eta μ,
          ‖referenceConfigurationKernel r kernel q p‖)
        =
      Finset.sum
        ((Finset.univ : Finset (FourierConfig eta μ)).filter
          (fun p => outerConfigOf r p = outerConfigOf r q))
        (fun p => ‖kernel (q r) (p r)‖) := by
    calc
      (∑ p : FourierConfig eta μ,
          ‖referenceConfigurationKernel r kernel q p‖)
          =
        ∑ p : FourierConfig eta μ,
          if outerConfigOf r p = outerConfigOf r q then
            ‖kernel (q r) (p r)‖
          else 0 := by
            apply Finset.sum_congr rfl
            intro p hp
            by_cases hs :
                outerConfigOf r p = outerConfigOf r q
            · have hs' :
                  outerConfigOf r q = outerConfigOf r p :=
                hs.symm
              rw [if_pos hs]
              rw [
                referenceConfigurationKernel_of_outer_eq
                  r kernel q p hs']
            · have hs' :
                  outerConfigOf r q ≠ outerConfigOf r p := by
                intro h
                exact hs h.symm
              rw [if_neg hs]
              rw [
                referenceConfigurationKernel_of_outer_ne
                  r kernel q p hs']
              exact norm_zero
      _ =
        Finset.sum
          ((Finset.univ : Finset (FourierConfig eta μ)).filter
            (fun p => outerConfigOf r p = outerConfigOf r q))
          (fun p => ‖kernel (q r) (p r)‖) := by
            symm
            rw [Finset.sum_filter]

  rw [hFilter]
  unfold referenceKernelRowL1

  apply Finset.sum_bij
    (fun p _ => p r)
  · intro p hp
    simp
  · intro p₁ hp₁ p₂ hp₂ href
    have hs₁ :
        outerConfigOf r p₁ = outerConfigOf r q :=
      (Finset.mem_filter.mp hp₁).2
    have hs₂ :
        outerConfigOf r p₂ = outerConfigOf r q :=
      (Finset.mem_filter.mp hp₂).2
    have hp₁rec :
        referenceSliceConfig r (outerConfigOf r q) (p₁ r) = p₁ :=
      referenceSliceConfig_of_outerConfig_eq
        r (outerConfigOf r q) p₁ hs₁
    have hp₂rec :
        referenceSliceConfig r (outerConfigOf r q) (p₂ r) = p₂ :=
      referenceSliceConfig_of_outerConfig_eq
        r (outerConfigOf r q) p₂ hs₂
    calc
      p₁ =
          referenceSliceConfig
            r (outerConfigOf r q) (p₁ r) := hp₁rec.symm
      _ =
          referenceSliceConfig
            r (outerConfigOf r q) (p₂ r) := by
              rw [href]
      _ = p₂ := hp₂rec
  · intro u hu
    let p : FourierConfig eta μ :=
      referenceSliceConfig r (outerConfigOf r q) u
    have hpSlice :
        outerConfigOf r p = outerConfigOf r q := by
      dsimp [p]
      exact
        outerConfigOf_referenceSliceConfig
          r (outerConfigOf r q) u
    have hpMem :
        p ∈
          (Finset.univ : Finset (FourierConfig eta μ)).filter
            (fun z => outerConfigOf r z = outerConfigOf r q) := by
      exact
        Finset.mem_filter.mpr
          ⟨Finset.mem_univ p, hpSlice⟩
    refine ⟨p, hpMem, ?_⟩
    dsimp [p]
    exact referenceSliceConfig_ref r (outerConfigOf r q) u
  · intro p hp
    rfl

/--
A one-particle row bound automatically gives the corresponding
configuration-space row bound.
-/
lemma referenceConfigurationKernel_rowL1Bound_of_oneParticle
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (B : ℝ)
    (hRow : HasReferenceKernelRowL1Bound kernel B) :
    HasReferenceConfigurationKernelRowL1Bound
      r kernel B := by
  intro q
  rw [referenceConfigurationKernel_rowL1_eq]
  exact hRow (q r)

/--
A one-particle column bound automatically gives the corresponding
configuration-space column bound.
-/
lemma referenceConfigurationKernel_columnL1Bound_of_oneParticle
    {eta : ℕ} {μ : Type*}
    [Fintype μ]
    (r : Fin eta)
    (kernel : μ → μ → ℂ)
    (B : ℝ)
    (hColumn : HasReferenceKernelColumnL1Bound kernel B) :
    HasReferenceConfigurationKernelColumnL1Bound
      r kernel B := by
  intro p
  rw [referenceConfigurationKernel_columnL1_eq]
  exact hColumn (p r)

/-! ## Forty-ninth milestone: one-particle low-pass sums to one transfer-shell sum -/

/--
The scalar low-pass Coulomb amplitude attached to a reciprocal-lattice
transfer.
-/
noncomputable def lowPassCoulombPointAmplitude
    (K g C : ℝ) (nu : Lattice3) : ℝ :=
  Real.sqrt (lowPassCoulombPointWeight K g C nu)

lemma lowPassCoulombPointAmplitude_nonneg
    (K g C : ℝ) (nu : Lattice3) :
    0 ≤ lowPassCoulombPointAmplitude K g C nu := by
  unfold lowPassCoulombPointAmplitude
  exact Real.sqrt_nonneg _

lemma lowPassCoulombPointAmplitude_zero
    (K g C : ℝ) :
    lowPassCoulombPointAmplitude K g C (fun _ => 0) = 0 := by
  have hnot :
      ¬ IsAboveHalfCutoff K g (fun _ => 0) := by
    unfold IsAboveHalfCutoff latticeNormSq
    norm_num
    exact sq_nonneg (K / 2)
  unfold lowPassCoulombPointAmplitude
  rw [show
      lowPassCoulombPointWeight K g C (fun _ => 0) = 0 by
        classical
        unfold lowPassCoulombPointWeight
        rw [if_neg hnot]
        unfold latticeCoulombSquareWeight latticeNormSq
        norm_num]
  simp

/--
The low-pass amplitude carried by one element of the finite transfer-mode
type.  The distinguished `none` mode represents zero transfer and hence has
zero amplitude automatically.
-/
noncomputable def finiteTransferLowPassCoulombAmplitude
    (K g C : ℝ)
    (count : ℕ)
    (q : FinitePlaneWaveMode count) : ℝ :=
  lowPassCoulombPointAmplitude
    K g C (finitePlaneWaveLatticeIndex count q)

lemma finiteTransferLowPassCoulombAmplitude_nonneg
    (K g C : ℝ)
    (count : ℕ)
    (q : FinitePlaneWaveMode count) :
    0 ≤ finiteTransferLowPassCoulombAmplitude K g C count q := by
  unfold finiteTransferLowPassCoulombAmplitude
  exact lowPassCoulombPointAmplitude_nonneg _ _ _ _

@[simp]
lemma finiteTransferLowPassCoulombAmplitude_none
    (K g C : ℝ)
    (count : ℕ) :
    finiteTransferLowPassCoulombAmplitude
        K g C count (none : FinitePlaneWaveMode count) = 0 := by
  unfold finiteTransferLowPassCoulombAmplitude
  rw [finitePlaneWaveLatticeIndex_none]
  exact lowPassCoulombPointAmplitude_zero K g C

/--
The norm of the explicit low-pass kernel is bounded pointwise by the
unmasked low-pass amplitude of its literal momentum transfer.
-/
lemma finiteLowPassCoulombKernel_norm_le_pointAmplitude
    (K g C : ℝ)
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    ‖finiteLowPassCoulombKernel K g C count v u‖ ≤
      lowPassCoulombPointAmplitude
        K g C (finitePlaneWaveTransfer count v u) := by
  classical
  unfold finiteLowPassCoulombKernel
  dsimp
  by_cases hmask :
      K < finitePlaneWaveKabs g count v ∧
        ¬ K / 2 < finitePlaneWaveKabs g count u
  · rw [if_pos hmask]
    simp [lowPassCoulombPointAmplitude]
  · rw [if_neg hmask]
    unfold lowPassCoulombPointAmplitude
    unfold finitePlaneWaveLowPassDifferenceSquareWeight
    simp only [Complex.norm_real, Real.norm_eq_abs]
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]

/--
The chosen doubled-transfer representative carries exactly the amplitude of
the literal difference.
-/
lemma finiteTransferLowPassCoulombAmplitude_transferMode
    (K g C : ℝ)
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    finiteTransferLowPassCoulombAmplitude
        K g C (2 * count)
        (finitePlaneWaveTransferMode count v u)
      =
    lowPassCoulombPointAmplitude
      K g C (finitePlaneWaveTransfer count v u) := by
  unfold finiteTransferLowPassCoulombAmplitude
  rw [finitePlaneWaveTransferMode_spec]

/--
For fixed output mode `v`, subtraction `u ↦ nu_v - nu_u` is injective.
-/
lemma latticeSub_left_injective
    (v : Lattice3) :
    Function.Injective (fun u : Lattice3 => latticeSub v u) := by
  intro u₁ u₂ h
  funext i
  have hi := congrFun h i
  simp only [latticeSub_apply] at hi
  omega

lemma finitePlaneWaveTransfer_right_injective
    (count : ℕ)
    (v : FinitePlaneWaveMode count) :
    Function.Injective
      (fun u : FinitePlaneWaveMode count =>
        finitePlaneWaveTransfer count v u) := by
  intro u₁ u₂ htransfer
  apply finitePlaneWaveLatticeIndex_injective count
  apply
    latticeSub_left_injective
      (finitePlaneWaveLatticeIndex count v)
  exact htransfer

lemma finitePlaneWaveTransferMode_right_injective
    (count : ℕ)
    (v : FinitePlaneWaveMode count) :
    Function.Injective
      (fun u : FinitePlaneWaveMode count =>
        finitePlaneWaveTransferMode count v u) := by
  intro u₁ u₂ hmode
  apply finitePlaneWaveTransfer_right_injective count v
  calc
    finitePlaneWaveTransfer count v u₁
        =
      finitePlaneWaveLatticeIndex (2 * count)
        (finitePlaneWaveTransferMode count v u₁) :=
      (finitePlaneWaveTransferMode_spec count v u₁).symm
    _ =
      finitePlaneWaveLatticeIndex (2 * count)
        (finitePlaneWaveTransferMode count v u₂) := by
          change
            finitePlaneWaveTransferMode count v u₁ =
              finitePlaneWaveTransferMode count v u₂
            at hmode
          rw [hmode]
    _ =
      finitePlaneWaveTransfer count v u₂ :=
      finitePlaneWaveTransferMode_spec count v u₂

/--
Total low-pass Coulomb amplitude on a finite transfer-mode type.
-/
noncomputable def finiteLowPassTransferL1
    (K g C : ℝ)
    (count : ℕ) : ℝ :=
  ∑ q : FinitePlaneWaveMode count,
    finiteTransferLowPassCoulombAmplitude K g C count q

/--
Every one-particle column of the explicit low-pass kernel injects into the
full doubled transfer-mode amplitude sum.
-/
lemma finiteLowPassCoulombKernel_columnL1_le_transferL1
    (K g C : ℝ)
    (count : ℕ)
    (u : FinitePlaneWaveMode count) :
    referenceKernelColumnL1
        (finiteLowPassCoulombKernel K g C count) u
      ≤
    finiteLowPassTransferL1 K g C (2 * count) := by
  classical

  let f :
      FinitePlaneWaveMode count →
        FinitePlaneWaveMode (2 * count) :=
    fun v => finitePlaneWaveTransferMode count v u

  have hfInjective : Function.Injective f := by
    dsimp [f]
    exact finitePlaneWaveTransferMode_left_injective count u

  have hPoint :
      ∀ v : FinitePlaneWaveMode count,
        ‖finiteLowPassCoulombKernel K g C count v u‖ ≤
          finiteTransferLowPassCoulombAmplitude
            K g C (2 * count) (f v) := by
    intro v
    calc
      ‖finiteLowPassCoulombKernel K g C count v u‖
          ≤
        lowPassCoulombPointAmplitude
          K g C (finitePlaneWaveTransfer count v u) :=
        finiteLowPassCoulombKernel_norm_le_pointAmplitude
          K g C count v u
      _ =
        finiteTransferLowPassCoulombAmplitude
          K g C (2 * count) (f v) := by
            dsimp [f]
            exact
              (finiteTransferLowPassCoulombAmplitude_transferMode
                K g C count v u).symm

  have hSource :
      referenceKernelColumnL1
          (finiteLowPassCoulombKernel K g C count) u
        ≤
      ∑ v : FinitePlaneWaveMode count,
        finiteTransferLowPassCoulombAmplitude
          K g C (2 * count) (f v) := by
    unfold referenceKernelColumnL1
    apply Finset.sum_le_sum
    intro v hv
    exact hPoint v

  have hImageEq :
      (∑ v : FinitePlaneWaveMode count,
          finiteTransferLowPassCoulombAmplitude
            K g C (2 * count) (f v))
        =
      Finset.sum
        ((Finset.univ :
            Finset (FinitePlaneWaveMode count)).image f)
        (finiteTransferLowPassCoulombAmplitude
          K g C (2 * count)) := by
    apply Finset.sum_bij
      (fun v _ => f v)
    · intro v hv
      exact Finset.mem_image.mpr
        ⟨v, Finset.mem_univ v, rfl⟩
    · intro v₁ hv₁ v₂ hv₂ hfv
      exact hfInjective hfv
    · intro q hq
      rcases Finset.mem_image.mp hq with
        ⟨v, hv, hvq⟩
      exact ⟨v, hv, hvq⟩
    · intro v hv
      rfl

  have hImageLe :
      Finset.sum
        ((Finset.univ :
            Finset (FinitePlaneWaveMode count)).image f)
        (finiteTransferLowPassCoulombAmplitude
          K g C (2 * count))
        ≤
      finiteLowPassTransferL1 K g C (2 * count) := by
    unfold finiteLowPassTransferL1
    refine
      Finset.sum_le_sum_of_subset_of_nonneg
        (Finset.subset_univ _) ?_
    intro q hqUniv hqNotImage
    exact
      finiteTransferLowPassCoulombAmplitude_nonneg
        K g C (2 * count) q

  exact hSource.trans (hImageEq ▸ hImageLe)

/--
Every one-particle row obeys the same doubled-transfer bound.
-/
lemma finiteLowPassCoulombKernel_rowL1_le_transferL1
    (K g C : ℝ)
    (count : ℕ)
    (v : FinitePlaneWaveMode count) :
    referenceKernelRowL1
        (finiteLowPassCoulombKernel K g C count) v
      ≤
    finiteLowPassTransferL1 K g C (2 * count) := by
  classical

  let f :
      FinitePlaneWaveMode count →
        FinitePlaneWaveMode (2 * count) :=
    fun u => finitePlaneWaveTransferMode count v u

  have hfInjective : Function.Injective f := by
    dsimp [f]
    exact finitePlaneWaveTransferMode_right_injective count v

  have hPoint :
      ∀ u : FinitePlaneWaveMode count,
        ‖finiteLowPassCoulombKernel K g C count v u‖ ≤
          finiteTransferLowPassCoulombAmplitude
            K g C (2 * count) (f u) := by
    intro u
    calc
      ‖finiteLowPassCoulombKernel K g C count v u‖
          ≤
        lowPassCoulombPointAmplitude
          K g C (finitePlaneWaveTransfer count v u) :=
        finiteLowPassCoulombKernel_norm_le_pointAmplitude
          K g C count v u
      _ =
        finiteTransferLowPassCoulombAmplitude
          K g C (2 * count) (f u) := by
            dsimp [f]
            exact
              (finiteTransferLowPassCoulombAmplitude_transferMode
                K g C count v u).symm

  have hSource :
      referenceKernelRowL1
          (finiteLowPassCoulombKernel K g C count) v
        ≤
      ∑ u : FinitePlaneWaveMode count,
        finiteTransferLowPassCoulombAmplitude
          K g C (2 * count) (f u) := by
    unfold referenceKernelRowL1
    apply Finset.sum_le_sum
    intro u hu
    exact hPoint u

  have hImageEq :
      (∑ u : FinitePlaneWaveMode count,
          finiteTransferLowPassCoulombAmplitude
            K g C (2 * count) (f u))
        =
      Finset.sum
        ((Finset.univ :
            Finset (FinitePlaneWaveMode count)).image f)
        (finiteTransferLowPassCoulombAmplitude
          K g C (2 * count)) := by
    apply Finset.sum_bij
      (fun u _ => f u)
    · intro u hu
      exact Finset.mem_image.mpr
        ⟨u, Finset.mem_univ u, rfl⟩
    · intro u₁ hu₁ u₂ hu₂ hfu
      exact hfInjective hfu
    · intro q hq
      rcases Finset.mem_image.mp hq with
        ⟨u, hu, huq⟩
      exact ⟨u, hu, huq⟩
    · intro u hu
      rfl

  have hImageLe :
      Finset.sum
        ((Finset.univ :
            Finset (FinitePlaneWaveMode count)).image f)
        (finiteTransferLowPassCoulombAmplitude
          K g C (2 * count))
        ≤
      finiteLowPassTransferL1 K g C (2 * count) := by
    unfold finiteLowPassTransferL1
    refine
      Finset.sum_le_sum_of_subset_of_nonneg
        (Finset.subset_univ _) ?_
    intro q hqUniv hqNotImage
    exact
      finiteTransferLowPassCoulombAmplitude_nonneg
        K g C (2 * count) q

  exact hSource.trans (hImageEq ▸ hImageLe)

/--
Low-pass Coulomb amplitude in one explicit cubic shell.
-/
noncomputable def lowPassCoulombShellAmplitudeMass
    (K g C : ℝ)
    (n : ℕ) : ℝ :=
  ∑ nu ∈ cubicSupShell n,
    lowPassCoulombPointAmplitude K g C nu

/--
The total finite transfer amplitude is exactly the sum of the low-pass
amplitude masses of its explicit cubic shells.
-/
lemma finiteLowPassTransferL1_eq_shell_sum
    (K g C : ℝ)
    (count : ℕ) :
    finiteLowPassTransferL1 K g C count =
      ∑ n ∈ Finset.range count,
        lowPassCoulombShellAmplitudeMass K g C n := by
  classical
  unfold finiteLowPassTransferL1
  rw [Fintype.sum_option]
  rw [Fintype.sum_sigma]
  simp only [finiteTransferLowPassCoulombAmplitude_none, zero_add]

  calc
    (∑ n : FiniteShellIndex count,
        ∑ nu : ↥(cubicSupShell (n : ℕ)),
          finiteTransferLowPassCoulombAmplitude
            K g C count (some ⟨n, nu⟩))
        =
      ∑ n : FiniteShellIndex count,
        ∑ nu : ↥(cubicSupShell (n : ℕ)),
          lowPassCoulombPointAmplitude K g C (nu : Lattice3) := by
            apply Finset.sum_congr rfl
            intro n hn
            apply Finset.sum_congr rfl
            intro nu hnu
            unfold finiteTransferLowPassCoulombAmplitude
            rw [finitePlaneWaveLatticeIndex_some]
    _ =
      ∑ n : FiniteShellIndex count,
        lowPassCoulombShellAmplitudeMass K g C (n : ℕ) := by
          apply Finset.sum_congr rfl
          intro n hn
          unfold lowPassCoulombShellAmplitudeMass
          exact
            Finset.sum_coe_sort
              (cubicSupShell (n : ℕ))
              (lowPassCoulombPointAmplitude K g C)
    _ =
      ∑ n ∈ Finset.range count,
        lowPassCoulombShellAmplitudeMass K g C n := by
          exact
            Finset.sum_coe_sort
              (Finset.range count)
              (lowPassCoulombShellAmplitudeMass K g C)

/-! ## Fiftieth milestone: explicit low-pass shell amplitude bounds -/

/--
The complementary low-pass square weight is bounded by the full Coulomb
square weight.
-/
lemma lowPassCoulombPointWeight_le_latticeCoulombSquareWeight
    (K g C : ℝ)
    (hC0 : 0 ≤ C)
    (nu : Lattice3) :
    lowPassCoulombPointWeight K g C nu ≤
      latticeCoulombSquareWeight C nu := by
  classical
  unfold lowPassCoulombPointWeight
  by_cases hnu : IsAboveHalfCutoff K g nu
  · rw [if_pos hnu]
    exact latticeCoulombSquareWeight_nonneg C hC0 nu
  · rw [if_neg hnu]

/--
On cubic shell `n`, the low-pass Coulomb amplitude is at most

`sqrt(C) / (n+1)^2`.

This is the amplitude analogue of the already-proved inverse-fourth bound
for the squared Coulomb coefficient.
-/
lemma lowPassCoulombPointAmplitude_shell_bound
    (K g C : ℝ)
    (hC0 : 0 ≤ C)
    (n : ℕ)
    {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    lowPassCoulombPointAmplitude K g C nu ≤
      Real.sqrt C / (((n : ℝ) + 1) ^ 2) := by
  let x : ℝ := (n : ℝ) + 1

  have hx : 0 < x := by
    dsimp [x]
    positivity

  have hw0 :
      0 ≤ lowPassCoulombPointWeight K g C nu :=
    lowPassCoulombPointWeight_nonneg K g C hC0 nu

  have hweight :
      lowPassCoulombPointWeight K g C nu ≤
        C / x ^ 4 := by
    calc
      lowPassCoulombPointWeight K g C nu
          ≤ latticeCoulombSquareWeight C nu :=
        lowPassCoulombPointWeight_le_latticeCoulombSquareWeight
          K g C hC0 nu
      _ ≤ C / (((n : ℝ) + 1) ^ 4) :=
        latticeCoulombSquareWeight_shell_bound
          C hC0 n hnu
      _ = C / x ^ 4 := by
        rfl

  have hright0 :
      0 ≤ Real.sqrt C / x ^ 2 :=
    div_nonneg (Real.sqrt_nonneg C) (sq_nonneg x)

  have heq :
      C / x ^ 4 =
        (Real.sqrt C / x ^ 2) ^ 2 := by
    rw [div_pow]
    rw [Real.sq_sqrt hC0]
    congr 1
    ring

  have hsq :
      (Real.sqrt
        (lowPassCoulombPointWeight K g C nu)) ^ 2
        ≤
      (Real.sqrt C / x ^ 2) ^ 2 := by
    rw [Real.sq_sqrt hw0]
    calc
      lowPassCoulombPointWeight K g C nu
          ≤ C / x ^ 4 := hweight
      _ = (Real.sqrt C / x ^ 2) ^ 2 := heq

  have hamp :
      Real.sqrt (lowPassCoulombPointWeight K g C nu) ≤
        Real.sqrt C / x ^ 2 :=
    (sq_le_sq₀
      (Real.sqrt_nonneg _)
      hright0).1 hsq

  unfold lowPassCoulombPointAmplitude
  simpa [x] using hamp

/--
Every low-pass cubic shell has total Coulomb amplitude at most
`54 * sqrt(C)`.
-/
lemma lowPassCoulombShellAmplitudeMass_le
    (K g C : ℝ)
    (hC0 : 0 ≤ C)
    (n : ℕ) :
    lowPassCoulombShellAmplitudeMass K g C n ≤
      54 * Real.sqrt C := by
  let x : ℝ := (n : ℝ) + 1
  let A : ℝ := Real.sqrt C / x ^ 2

  have hx : 0 < x := by
    dsimp [x]
    positivity

  have hA0 : 0 ≤ A := by
    dsimp [A]
    exact
      div_nonneg
        (Real.sqrt_nonneg C)
        (sq_nonneg x)

  have hcard :
      ((cubicSupShell n).card : ℝ) ≤
        54 * x ^ 2 := by
    have hnat :=
      cubicSupShell_card_nat_bound n
    dsimp [x]
    exact_mod_cast hnat

  unfold lowPassCoulombShellAmplitudeMass

  calc
    (∑ nu ∈ cubicSupShell n,
        lowPassCoulombPointAmplitude K g C nu)
        ≤
      ∑ nu ∈ cubicSupShell n, A := by
        apply Finset.sum_le_sum
        intro nu hnu
        dsimp [A]
        simpa [x] using
          lowPassCoulombPointAmplitude_shell_bound
            K g C hC0 n hnu
    _ =
      ((cubicSupShell n).card : ℝ) * A := by
        simp [nsmul_eq_mul]
    _ ≤
      (54 * x ^ 2) * A :=
        mul_le_mul_of_nonneg_right hcard hA0
    _ =
      54 * Real.sqrt C := by
        dsimp [A]
        have hxne : x ≠ 0 := ne_of_gt hx
        field_simp [hxne]

/--
The number of potentially nonzero low-pass cubic shells.  Shell indices
`n >= lowPassCutoffShellCount K g` lie strictly beyond the physical
half-cutoff.
-/
noncomputable def lowPassCutoffShellCount
    (K g : ℝ) : ℕ :=
  ⌊K / (2 * g)⌋₊ + 1

lemma scaled_half_cutoff_lt_lowPassCutoffShellCount
    (K g : ℝ) :
    K / (2 * g) <
      (lowPassCutoffShellCount K g : ℝ) := by
  unfold lowPassCutoffShellCount
  simpa using
    Nat.lt_floor_add_one (K / (2 * g))

/--
Every point in a cubic shell whose index is at least the low-pass cutoff
shell count lies strictly above the physical half-cutoff.
-/
lemma cubicSupShell_above_half_cutoff_of_lowPassCutoffShellCount_le
    (K g : ℝ)
    (hK0 : 0 ≤ K)
    (hgpos : 0 < g)
    (n : ℕ)
    (hn :
      lowPassCutoffShellCount K g ≤ n)
    {nu : Lattice3}
    (hnu : nu ∈ cubicSupShell n) :
    IsAboveHalfCutoff K g nu := by
  let x : ℝ := K / (2 * g)
  let y : ℝ := (n : ℝ) + 1

  have hx0 : 0 ≤ x := by
    dsimp [x]
    have hden0 : 0 ≤ 2 * g := by
      positivity
    exact div_nonneg hK0 hden0

  have hcut :
      x < (lowPassCutoffShellCount K g : ℝ) := by
    dsimp [x]
    exact
      scaled_half_cutoff_lt_lowPassCutoffShellCount
        K g

  have hncast :
      (lowPassCutoffShellCount K g : ℝ) ≤
        (n : ℝ) := by
    exact_mod_cast hn

  have hxy : x < y := by
    dsimp [y]
    have hxn : x < (n : ℝ) :=
      lt_of_lt_of_le hcut hncast
    linarith

  have hy0 : 0 ≤ y := by
    dsimp [y]
    positivity

  have hsq :
      x ^ 2 < y ^ 2 := by
    nlinarith

  have hnorm :
      y ^ 2 ≤ latticeNormSq nu := by
    dsimp [y]
    simpa using
      cubicSupShell_normSq_lower n hnu

  have hscaled :
      g ^ 2 * x ^ 2 <
        g ^ 2 * latticeNormSq nu := by
    apply mul_lt_mul_of_pos_left
    · exact lt_of_lt_of_le hsq hnorm
    · positivity

  have hidentity :
      g ^ 2 * x ^ 2 = (K / 2) ^ 2 := by
    dsimp [x]
    have hg0 : g ≠ 0 := ne_of_gt hgpos
    field_simp [hg0]

  unfold IsAboveHalfCutoff
  rw [← hidentity]
  exact hscaled

/--
Consequently every sufficiently late low-pass cubic shell has exactly zero
amplitude mass.
-/
lemma lowPassCoulombShellAmplitudeMass_eq_zero_of_cutoff_le
    (K g C : ℝ)
    (hK0 : 0 ≤ K)
    (hgpos : 0 < g)
    (n : ℕ)
    (hn :
      lowPassCutoffShellCount K g ≤ n) :
    lowPassCoulombShellAmplitudeMass K g C n = 0 := by
  classical
  unfold lowPassCoulombShellAmplitudeMass
  apply Finset.sum_eq_zero
  intro nu hnu

  have habove :
      IsAboveHalfCutoff K g nu :=
    cubicSupShell_above_half_cutoff_of_lowPassCutoffShellCount_le
      K g hK0 hgpos n hn hnu

  unfold lowPassCoulombPointAmplitude
  have hweight :
      lowPassCoulombPointWeight K g C nu = 0 := by
    unfold lowPassCoulombPointWeight
    rw [if_pos habove]

  rw [hweight]
  simp

/-! ## Fifty-first milestone: sum the active low-pass shells -/

/--
The complete finite low-pass transfer `ℓ¹` mass is bounded by the number of
potentially active shells times the uniform shell-amplitude bound.

The finite transfer range may end before the physical cutoff shell count,
or may extend beyond it.  In the first case we bound every included shell
by `54 * sqrt C`; in the second case we split the range at the cutoff and
use the exact vanishing theorem from milestone 50 for the remainder.
-/
lemma finiteLowPassTransferL1_le_cutoffShellCount_mul
    (K g C : ℝ)
    (count : ℕ)
    (hK0 : 0 ≤ K)
    (hgpos : 0 < g)
    (hC0 : 0 ≤ C) :
    finiteLowPassTransferL1 K g C count ≤
      (lowPassCutoffShellCount K g : ℝ) *
        (54 * Real.sqrt C) := by
  rw [finiteLowPassTransferL1_eq_shell_sum]

  let m : ℕ := lowPassCutoffShellCount K g
  let A : ℝ := 54 * Real.sqrt C

  have hA0 : 0 ≤ A := by
    dsimp [A]
    positivity

  have hShell :
      ∀ n : ℕ,
        lowPassCoulombShellAmplitudeMass K g C n ≤ A := by
    intro n
    dsimp [A]
    exact
      lowPassCoulombShellAmplitudeMass_le
        K g C hC0 n

  by_cases hcount : count ≤ m
  · have hCountR :
        (count : ℝ) ≤ (m : ℝ) := by
      exact_mod_cast hcount

    calc
      Finset.sum (Finset.range count)
          (lowPassCoulombShellAmplitudeMass K g C)
          ≤
        Finset.sum (Finset.range count)
          (fun _ => A) := by
            apply Finset.sum_le_sum
            intro n hn
            exact hShell n
      _ = (count : ℝ) * A := by
            simp [nsmul_eq_mul]
      _ ≤ (m : ℝ) * A :=
            mul_le_mul_of_nonneg_right hCountR hA0
      _ =
        (lowPassCutoffShellCount K g : ℝ) *
          (54 * Real.sqrt C) := by
            rfl

  · have hmc : m ≤ count := by
      omega

    let d : ℕ := count - m

    have hcountEq : count = m + d := by
      dsimp [d]
      omega

    have hLateZero :
        Finset.sum (Finset.range d)
            (fun j =>
              lowPassCoulombShellAmplitudeMass
                K g C (m + j)) = 0 := by
      apply Finset.sum_eq_zero
      intro j hj
      apply
        lowPassCoulombShellAmplitudeMass_eq_zero_of_cutoff_le
          K g C hK0 hgpos (m + j)
      dsimp [m]
      omega

    have hEarly :
        Finset.sum (Finset.range m)
            (lowPassCoulombShellAmplitudeMass K g C)
          ≤
        (m : ℝ) * A := by
      calc
        Finset.sum (Finset.range m)
            (lowPassCoulombShellAmplitudeMass K g C)
            ≤
          Finset.sum (Finset.range m)
            (fun _ => A) := by
              apply Finset.sum_le_sum
              intro n hn
              exact hShell n
        _ = (m : ℝ) * A := by
              simp [nsmul_eq_mul]

    rw [hcountEq, Finset.sum_range_add, hLateZero, add_zero]
    calc
      Finset.sum (Finset.range m)
          (lowPassCoulombShellAmplitudeMass K g C)
          ≤
        (m : ℝ) * A := hEarly
      _ =
        (lowPassCutoffShellCount K g : ℝ) *
          (54 * Real.sqrt C) := by
            rfl

/-! ## Fifty-second milestone: remove the floor-valued low-pass scale -/

/--
If the physical cutoff is at least twice the reciprocal scale, then the
number of potentially active low-pass shells, multiplied by `g`, is at most
`K`.

Since

`lowPassCutoffShellCount K g = floor(K/(2g)) + 1`,

we use `floor x <= x` and `g <= K/2`.
-/
lemma lowPassCutoffShellCount_mul_g_le_K
    (K g : ℝ)
    (hK0 : 0 ≤ K)
    (hgpos : 0 < g)
    (h2gK : 2 * g ≤ K) :
    (lowPassCutoffShellCount K g : ℝ) * g ≤ K := by

  have hden0 : 0 ≤ 2 * g := by
    positivity

  have hx0 : 0 ≤ K / (2 * g) :=
    div_nonneg hK0 hden0

  have hfloor :
      (⌊K / (2 * g)⌋₊ : ℝ) ≤
        K / (2 * g) := by
    exact Nat.floor_le hx0

  have hm :
      (lowPassCutoffShellCount K g : ℝ) ≤
        K / (2 * g) + 1 := by
    unfold lowPassCutoffShellCount
    push_cast
    linarith

  have hmul :
      (lowPassCutoffShellCount K g : ℝ) * g ≤
        (K / (2 * g) + 1) * g :=
    mul_le_mul_of_nonneg_right hm (le_of_lt hgpos)

  have hg0 : g ≠ 0 := ne_of_gt hgpos

  have hid :
      (K / (2 * g) + 1) * g =
        K / 2 + g := by
    field_simp [hg0]

  have hhalf :
      K / 2 + g ≤ K := by
    linarith

  calc
    (lowPassCutoffShellCount K g : ℝ) * g
        ≤ (K / (2 * g) + 1) * g := hmul
    _ = K / 2 + g := hid
    _ ≤ K := hhalf

/--
A division-free low-pass Schur scale condition.

The shell-count factor from milestone 51 disappears if

`54 * sqrt(Cweight) <= Blow * g`

and `2g <= K`.
-/
lemma lowPassScale_of_amplitudeScale
    (K g Cweight Blow : ℝ)
    (hK0 : 0 ≤ K)
    (hgpos : 0 < g)
    (h2gK : 2 * g ≤ K)
    (hBlow0 : 0 ≤ Blow)
    (hAmplitudeScale :
      54 * Real.sqrt Cweight ≤ Blow * g) :
    (lowPassCutoffShellCount K g : ℝ) *
        (54 * Real.sqrt Cweight)
      ≤
    Blow * K := by

  have hm0 :
      0 ≤ (lowPassCutoffShellCount K g : ℝ) := by
    positivity

  have hmg :
      (lowPassCutoffShellCount K g : ℝ) * g ≤ K :=
    lowPassCutoffShellCount_mul_g_le_K
      K g hK0 hgpos h2gK

  calc
    (lowPassCutoffShellCount K g : ℝ) *
        (54 * Real.sqrt Cweight)
        ≤
      (lowPassCutoffShellCount K g : ℝ) *
        (Blow * g) :=
          mul_le_mul_of_nonneg_left hAmplitudeScale hm0
    _ =
      Blow *
        ((lowPassCutoffShellCount K g : ℝ) * g) := by
          ring
    _ ≤ Blow * K :=
      mul_le_mul_of_nonneg_left hmg hBlow0

/-! ## Fifty-third milestone: explicit spectator far operator -/

/-! ## Fifty-fourth milestone: reduce the far Hardy bound to fixed reference-momentum slices -/

/-! ## Fifty-fifth milestone: identify fixed reference-momentum slices with `OuterConfig` -/

/-! ## Fifty-sixth milestone: collapse spectator slices to the explicit outer-kernel action -/

/-! ## Fifty-seventh milestone: remove the reference momentum from the far `H^1` weight -/

/-! ## Fifty-eighth milestone: explicit one-body Coulomb far kernel -/

/--
The unsplit squared Coulomb coefficient for one literal finite-basis
momentum transfer.

Unlike the low/high kernels above, this contains the entire Coulomb
coefficient.  All charge, normalization, and phase-magnitude prefactors
relevant to the norm estimate are absorbed into the nonnegative scalar
`C`.
-/
noncomputable def finiteCoulombDifferenceSquareWeight
    (C : ℝ) (count : ℕ)
    (v u : FinitePlaneWaveMode count) : ℝ :=
  latticeCoulombSquareWeight C
    (finitePlaneWaveTransfer count v u)

/--
The corresponding unsplit complex Coulomb amplitude.

As in the already-compiled low/high branches, the positive square root is
used because the present theorem only needs the coefficient magnitude.
Physical charge signs or unit-modulus nuclear phases can be restored
without changing the norm calculation.
-/
noncomputable def finiteCoulombKernel
    (C : ℝ) (count : ℕ)
    (v u : FinitePlaneWaveMode count) : ℂ :=
  (Real.sqrt
    (finiteCoulombDifferenceSquareWeight C count v u) : ℝ)

/-! ## Fifty-ninth milestone: reduce one-body far Coulomb Hardy to one particle -/

/--
One-particle finite Coulomb convolution.
-/
noncomputable def finiteCoulombOneParticleAction
    (C : ℝ)
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ)
    (v : FinitePlaneWaveMode count) : ℂ :=
  ∑ u : FinitePlaneWaveMode count,
    f u * finiteCoulombKernel C count v u

/--
Squared output norm of the one-particle Coulomb convolution.
-/
noncomputable def finiteCoulombOneParticleOutputSq
    (C : ℝ)
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) : ℝ :=
  ∑ v : FinitePlaneWaveMode count,
    ‖finiteCoulombOneParticleAction C count f v‖ ^ 2

/--
The one-particle finite Fourier `H^1` mass.
-/
noncomputable def finiteOneParticleH1Sq
    {μ : Type*}
    [Fintype μ]
    (kabs : μ → ℝ)
    (f : μ → ℂ) : ℝ :=
  ∑ u : μ,
    (1 + (kabs u) ^ 2) * ‖f u‖ ^ 2

/--
The genuine one-particle Hardy estimate for the explicit finite Coulomb
convolution.
-/
def HasOneParticleCoulombH1Bound
    (g C B : ℝ)
    (count : ℕ) : Prop :=
  ∀ f : FinitePlaneWaveMode count → ℂ,
    finiteCoulombOneParticleOutputSq C count f ≤
      B ^ 2 *
        finiteOneParticleH1Sq
          (finitePlaneWaveKabs g count) f

/-! ## Sixtieth milestone: isolate the dimensionless discrete Coulomb Hardy inequality -/

/--
Dimensionless lattice `H^1` mass for the explicit finite plane-wave mode
set.  The kinetic weight is `1 + |nu|^2`, with no reciprocal-lattice scale
`g`.
-/
noncomputable def finitePlaneWaveLatticeH1Sq
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) : ℝ :=
  ∑ u : FinitePlaneWaveMode count,
    (1 +
      latticeNormSq
        (finitePlaneWaveLatticeIndex count u)) *
      ‖f u‖ ^ 2

lemma finitePlaneWaveLatticeH1Sq_nonneg
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) :
    0 ≤ finitePlaneWaveLatticeH1Sq count f := by
  unfold finitePlaneWaveLatticeH1Sq
  apply Finset.sum_nonneg
  intro u hu
  have hnorm :
      0 ≤
        latticeNormSq
          (finitePlaneWaveLatticeIndex count u) :=
    latticeNormSq_nonneg
      (finitePlaneWaveLatticeIndex count u)
  have hweight :
      0 ≤
        1 +
          latticeNormSq
            (finitePlaneWaveLatticeIndex count u) := by
    linarith
  exact mul_nonneg hweight (sq_nonneg _)

/--
Exact conversion between the physical squared momentum and the
dimensionless lattice squared norm.
-/
lemma finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq
    (g : ℝ)
    (count : ℕ)
    (u : FinitePlaneWaveMode count) :
    (finitePlaneWaveKabs g count u) ^ 2 =
      g ^ 2 *
        latticeNormSq
          (finitePlaneWaveLatticeIndex count u) := by
  cases u with
  | none =>
      simp [
        finitePlaneWaveKabs,
        finitePlaneWaveLatticeIndex,
        latticeNormSq
      ]
  | some q =>
      have hnorm :
          0 ≤ latticeNormSq (q.2 : Lattice3) :=
        latticeNormSq_nonneg (q.2 : Lattice3)
      unfold finitePlaneWaveKabs
      rw [mul_pow]
      rw [Real.sq_sqrt hnorm]
      rfl

/--
The amount of the dimensionless lattice `H^1` norm controlled uniformly
by the physical norm at reciprocal-lattice scale `g`.
-/
noncomputable def physicalH1Scale (g : ℝ) : ℝ :=
  min 1 (g ^ 2)

lemma physicalH1Scale_le_one
    (g : ℝ) :
    physicalH1Scale g ≤ 1 := by
  unfold physicalH1Scale
  exact min_le_left _ _

lemma physicalH1Scale_le_g_sq
    (g : ℝ) :
    physicalH1Scale g ≤ g ^ 2 := by
  unfold physicalH1Scale
  exact min_le_right _ _

/--
Pointwise comparison of dimensionless and physical one-particle `H^1`
weights.
-/
lemma physicalH1Scale_mul_latticeWeight_le_physicalWeight
    (g : ℝ)
    (count : ℕ)
    (u : FinitePlaneWaveMode count) :
    physicalH1Scale g *
        (1 +
          latticeNormSq
            (finitePlaneWaveLatticeIndex count u))
      ≤
    1 + (finitePlaneWaveKabs g count u) ^ 2 := by

  let x : ℝ :=
    latticeNormSq
      (finitePlaneWaveLatticeIndex count u)

  have hx : 0 ≤ x := by
    dsimp [x]
    exact
      latticeNormSq_nonneg
        (finitePlaneWaveLatticeIndex count u)

  have h1 :
      physicalH1Scale g ≤ 1 :=
    physicalH1Scale_le_one g

  have hg :
      physicalH1Scale g ≤ g ^ 2 :=
    physicalH1Scale_le_g_sq g

  have hmul :
      physicalH1Scale g * x ≤
        g ^ 2 * x :=
    mul_le_mul_of_nonneg_right hg hx

  rw [
    finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq
      g count u
  ]

  dsimp [x] at hmul ⊢
  nlinarith

/--
The physical one-particle `H^1` mass dominates
`min(1,g^2)` times the dimensionless lattice `H^1` mass.
-/
lemma physicalH1Scale_mul_latticeH1Sq_le_finiteOneParticleH1Sq
    (g : ℝ)
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) :
    physicalH1Scale g *
        finitePlaneWaveLatticeH1Sq count f
      ≤
    finiteOneParticleH1Sq
      (finitePlaneWaveKabs g count) f := by
  unfold finitePlaneWaveLatticeH1Sq
  unfold finiteOneParticleH1Sq
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro u hu

  have hw :
      physicalH1Scale g *
          (1 +
            latticeNormSq
              (finitePlaneWaveLatticeIndex count u))
        ≤
      1 + (finitePlaneWaveKabs g count u) ^ 2 :=
    physicalH1Scale_mul_latticeWeight_le_physicalWeight
      g count u

  have hmul :
      (physicalH1Scale g *
          (1 +
            latticeNormSq
              (finitePlaneWaveLatticeIndex count u))) *
          ‖f u‖ ^ 2
        ≤
      (1 + (finitePlaneWaveKabs g count u) ^ 2) *
          ‖f u‖ ^ 2 :=
    mul_le_mul_of_nonneg_right
      hw
      (sq_nonneg ‖f u‖)

  calc
    physicalH1Scale g *
        ((1 +
          latticeNormSq
            (finitePlaneWaveLatticeIndex count u)) *
          ‖f u‖ ^ 2)
        =
      (physicalH1Scale g *
          (1 +
            latticeNormSq
              (finitePlaneWaveLatticeIndex count u))) *
        ‖f u‖ ^ 2 := by
          ring
    _ ≤
      (1 + (finitePlaneWaveKabs g count u) ^ 2) *
        ‖f u‖ ^ 2 :=
      hmul

/--
The dimensionless finite-lattice Coulomb Hardy statement.

This is now the only genuinely analytic one-particle input: the Coulomb
convolution is the already explicit finite Fourier convolution, while the
right-hand side uses the dimensionless lattice weight `1 + |nu|^2`.
-/
def HasDimensionlessFiniteCoulombHardyBound
    (C H : ℝ)
    (count : ℕ) : Prop :=
  ∀ f : FinitePlaneWaveMode count → ℂ,
    finiteCoulombOneParticleOutputSq C count f ≤
      H ^ 2 * finitePlaneWaveLatticeH1Sq count f

/-! ## Sixty-first milestone: weighted Schur reduction of the discrete Hardy bound -/

/-! ## Sixty-second milestone: normalize the Coulomb strength to `C = 1` -/

/--
The Coulomb square weight is linear in its nonnegative physical prefactor.
This identity is algebraic and in fact does not need a sign assumption.
-/
lemma latticeCoulombSquareWeight_eq_C_mul_unit
    (C : ℝ)
    (nu : Lattice3) :
    latticeCoulombSquareWeight C nu =
      C * latticeCoulombSquareWeight 1 nu := by
  unfold latticeCoulombSquareWeight
  ring

/--
The literal finite-basis Coulomb square weight inherits the same linear
scaling in `C`.
-/
lemma finiteCoulombDifferenceSquareWeight_eq_C_mul_unit
    (C : ℝ)
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    finiteCoulombDifferenceSquareWeight C count v u =
      C *
        finiteCoulombDifferenceSquareWeight 1 count v u := by
  unfold finiteCoulombDifferenceSquareWeight
  rw [latticeCoulombSquareWeight_eq_C_mul_unit]

/--
For nonnegative `C`, the explicit Coulomb amplitude scales by `sqrt C`.
-/
lemma finiteCoulombKernel_eq_sqrt_C_mul_unit
    (C : ℝ)
    (count : ℕ)
    (hC0 : 0 ≤ C)
    (v u : FinitePlaneWaveMode count) :
    finiteCoulombKernel C count v u =
      (Real.sqrt C : ℂ) *
        finiteCoulombKernel 1 count v u := by
  unfold finiteCoulombKernel
  rw [
    finiteCoulombDifferenceSquareWeight_eq_C_mul_unit
      C count v u
  ]
  rw [Real.sqrt_mul hC0]
  push_cast
  rfl

/--
The one-particle Coulomb convolution action scales by `sqrt C`.
-/
lemma finiteCoulombOneParticleAction_eq_sqrt_C_mul_unit
    (C : ℝ)
    (count : ℕ)
    (hC0 : 0 ≤ C)
    (f : FinitePlaneWaveMode count → ℂ)
    (v : FinitePlaneWaveMode count) :
    finiteCoulombOneParticleAction C count f v =
      (Real.sqrt C : ℂ) *
        finiteCoulombOneParticleAction 1 count f v := by
  unfold finiteCoulombOneParticleAction

  calc
    (∑ u : FinitePlaneWaveMode count,
        f u * finiteCoulombKernel C count v u)
        =
      ∑ u : FinitePlaneWaveMode count,
        (Real.sqrt C : ℂ) *
          (f u * finiteCoulombKernel 1 count v u) := by
            apply Finset.sum_congr rfl
            intro u hu
            rw [
              finiteCoulombKernel_eq_sqrt_C_mul_unit
                C count hC0 v u
            ]
            ring
    _ =
      (Real.sqrt C : ℂ) *
        (∑ u : FinitePlaneWaveMode count,
          f u * finiteCoulombKernel 1 count v u) := by
            rw [Finset.mul_sum]

/--
The squared one-particle output norm scales exactly linearly in `C`.
-/
lemma finiteCoulombOneParticleOutputSq_eq_C_mul_unit
    (C : ℝ)
    (count : ℕ)
    (hC0 : 0 ≤ C)
    (f : FinitePlaneWaveMode count → ℂ) :
    finiteCoulombOneParticleOutputSq C count f =
      C *
        finiteCoulombOneParticleOutputSq 1 count f := by
  unfold finiteCoulombOneParticleOutputSq

  calc
    (∑ v : FinitePlaneWaveMode count,
        ‖finiteCoulombOneParticleAction C count f v‖ ^ 2)
        =
      ∑ v : FinitePlaneWaveMode count,
        C *
          ‖finiteCoulombOneParticleAction 1 count f v‖ ^ 2 := by
            apply Finset.sum_congr rfl
            intro v hv
            rw [
              finiteCoulombOneParticleAction_eq_sqrt_C_mul_unit
                C count hC0 f v
            ]
            rw [norm_mul]
            simp only [
              Complex.norm_real,
              Real.norm_eq_abs,
              abs_of_nonneg (Real.sqrt_nonneg C)
            ]
            calc
              (Real.sqrt C *
                  ‖finiteCoulombOneParticleAction 1 count f v‖) ^ 2
                  =
                (Real.sqrt C) ^ 2 *
                  ‖finiteCoulombOneParticleAction 1 count f v‖ ^ 2 := by
                    ring
              _ =
                C *
                  ‖finiteCoulombOneParticleAction 1 count f v‖ ^ 2 := by
                    rw [Real.sq_sqrt hC0]
    _ =
      C *
        (∑ v : FinitePlaneWaveMode count,
          ‖finiteCoulombOneParticleAction 1 count f v‖ ^ 2) := by
            rw [Finset.mul_sum]

/-! ## Sixty-third milestone: canonical unit lattice Coulomb convolution -/

/--
The universal dimensionless unit-strength Coulomb amplitude on the
reciprocal lattice.

Because Lean's real division sets `1 / 0 = 0`, the zero Fourier mode is
automatically removed:
`unitLatticeCoulombKernel 0 = 0`.
-/
noncomputable def unitLatticeCoulombKernel
    (nu : Lattice3) : ℂ :=
  (Real.sqrt (latticeCoulombSquareWeight 1 nu) : ℝ)

@[simp]
lemma unitLatticeCoulombKernel_zero :
    unitLatticeCoulombKernel (fun _ => 0) = 0 := by
  unfold unitLatticeCoulombKernel
  unfold latticeCoulombSquareWeight
  unfold latticeNormSq
  norm_num

/--
The squared norm of the universal unit lattice Coulomb amplitude is exactly
the inverse-fourth lattice weight.
-/
lemma unitLatticeCoulombKernel_norm_sq
    (nu : Lattice3) :
    ‖unitLatticeCoulombKernel nu‖ ^ 2 =
      latticeCoulombSquareWeight 1 nu := by
  have hweight0 :
      0 ≤ latticeCoulombSquareWeight 1 nu :=
    latticeCoulombSquareWeight_nonneg
      1 (by norm_num) nu

  unfold unitLatticeCoulombKernel
  simp only [Complex.norm_real, Real.norm_eq_abs]
  rw [abs_of_nonneg (Real.sqrt_nonneg _)]
  exact Real.sq_sqrt hweight0

/--
At unit Coulomb strength, the finite-mode kernel is exactly the universal
lattice kernel evaluated on the literal momentum transfer.
-/
lemma finiteCoulombKernel_one_eq_unitLatticeCoulombKernel
    (count : ℕ)
    (v u : FinitePlaneWaveMode count) :
    finiteCoulombKernel 1 count v u =
      unitLatticeCoulombKernel
        (latticeSub
          (finitePlaneWaveLatticeIndex count v)
          (finitePlaneWaveLatticeIndex count u)) := by
  unfold finiteCoulombKernel
  unfold finiteCoulombDifferenceSquareWeight
  unfold finitePlaneWaveTransfer
  unfold unitLatticeCoulombKernel
  rfl

/--
The finite coefficient vector convolved with the universal unit-strength
lattice Coulomb kernel, evaluated at an arbitrary reciprocal-lattice point
`xi`.
-/
noncomputable def finiteUnitLatticeCoulombAction
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ)
    (xi : Lattice3) : ℂ :=
  ∑ u : FinitePlaneWaveMode count,
    f u *
      unitLatticeCoulombKernel
        (latticeSub
          xi
          (finitePlaneWaveLatticeIndex count u))

/--
The existing unit-strength one-particle Coulomb action is exactly the
universal lattice convolution restricted to a finite basis lattice point.
-/
lemma finiteCoulombOneParticleAction_one_eq_lattice
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ)
    (v : FinitePlaneWaveMode count) :
    finiteCoulombOneParticleAction 1 count f v =
      finiteUnitLatticeCoulombAction
        count f
        (finitePlaneWaveLatticeIndex count v) := by
  unfold finiteCoulombOneParticleAction
  unfold finiteUnitLatticeCoulombAction
  apply Finset.sum_congr rfl
  intro u hu
  rw [
    finiteCoulombKernel_one_eq_unitLatticeCoulombKernel
      count v u
  ]

/--
Squared output mass of the universal lattice convolution after restriction
back to the finite plane-wave cube.
-/
noncomputable def finiteUnitLatticeCoulombOutputSq
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) : ℝ :=
  ∑ v : FinitePlaneWaveMode count,
    ‖finiteUnitLatticeCoulombAction
        count f
        (finitePlaneWaveLatticeIndex count v)‖ ^ 2

/--
The old finite-mode unit-strength output norm is exactly the restricted
universal lattice-convolution output norm.
-/
lemma finiteCoulombOneParticleOutputSq_one_eq_lattice
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) :
    finiteCoulombOneParticleOutputSq 1 count f =
      finiteUnitLatticeCoulombOutputSq count f := by
  unfold finiteCoulombOneParticleOutputSq
  unfold finiteUnitLatticeCoulombOutputSq
  apply Finset.sum_congr rfl
  intro v hv
  rw [
    finiteCoulombOneParticleAction_one_eq_lattice
      count f v
  ]

/--
The remaining analytic statement in canonical lattice form, with a single
constant `H` that is uniform over *every* finite plane-wave cutoff.

This is now a theorem about one universal convolution kernel on `Z^3`;
the finite basis enters only by restricting the input and output to the
finite cube.
-/
def HasUniversalUnitLatticeCoulombHardyBound
    (H : ℝ) : Prop :=
  ∀ count : ℕ,
    ∀ f : FinitePlaneWaveMode count → ℂ,
      finiteUnitLatticeCoulombOutputSq count f ≤
        H ^ 2 * finitePlaneWaveLatticeH1Sq count f

/--
A cutoff-uniform universal lattice Hardy theorem implies the unit-strength
dimensionless finite Coulomb Hardy theorem at any particular cutoff.
-/
lemma dimensionlessFiniteCoulombHardyBound_of_universalUnitLattice
    (H : ℝ)
    (count : ℕ)
    (hUniversal :
      HasUniversalUnitLatticeCoulombHardyBound H) :
    HasDimensionlessFiniteCoulombHardyBound
      1 H count := by
  intro f
  rw [
    finiteCoulombOneParticleOutputSq_one_eq_lattice
      count f
  ]
  exact hUniversal count f

/-! ## Sixty-fourth milestone: arbitrary finite Fourier support on `Z^3` -/

/--
Unit-strength Coulomb convolution on an arbitrary finite family of lattice
momenta.

The finite type `α` is only a label set.  The map `index : α → Lattice3`
specifies the actual Fourier momenta.
-/
noncomputable def finiteSupportUnitLatticeCoulombAction
    {α : Type*}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (q : α) : ℂ :=
  ∑ p : α,
    f p *
      unitLatticeCoulombKernel
        (latticeSub (index q) (index p))

/--
Squared output norm of the unit-strength Coulomb convolution on an
arbitrary finite Fourier support.
-/
noncomputable def finiteSupportUnitLatticeCoulombOutputSq
    {α : Type*}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) : ℝ :=
  ∑ q : α,
    ‖finiteSupportUnitLatticeCoulombAction
        index f q‖ ^ 2

/--
Dimensionless `H^1` mass of an arbitrary finite Fourier polynomial.
-/
noncomputable def finiteSupportLatticeH1Sq
    {α : Type*}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) : ℝ :=
  ∑ p : α,
    (1 + latticeNormSq (index p)) * ‖f p‖ ^ 2

lemma finiteSupportLatticeH1Sq_nonneg
    {α : Type*}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    0 ≤ finiteSupportLatticeH1Sq index f := by
  unfold finiteSupportLatticeH1Sq
  apply Finset.sum_nonneg
  intro p hp
  have hnorm :
      0 ≤ latticeNormSq (index p) :=
    latticeNormSq_nonneg (index p)
  have hweight :
      0 ≤ 1 + latticeNormSq (index p) := by
    linarith
  exact mul_nonneg hweight (sq_nonneg _)

/--
Our shell-indexed finite plane-wave Coulomb action is exactly the general
finite-support lattice action for the already-defined lattice embedding.
-/
lemma finiteSupportUnitLatticeCoulombAction_finitePlaneWave
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ)
    (v : FinitePlaneWaveMode count) :
    finiteSupportUnitLatticeCoulombAction
        (finitePlaneWaveLatticeIndex count)
        f v
      =
    finiteUnitLatticeCoulombAction
      count f
      (finitePlaneWaveLatticeIndex count v) := by
  unfold finiteSupportUnitLatticeCoulombAction
  unfold finiteUnitLatticeCoulombAction
  rfl

/--
The corresponding squared output norms agree exactly.
-/
lemma finiteSupportUnitLatticeCoulombOutputSq_finitePlaneWave
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) :
    finiteSupportUnitLatticeCoulombOutputSq
        (finitePlaneWaveLatticeIndex count) f
      =
    finiteUnitLatticeCoulombOutputSq count f := by
  unfold finiteSupportUnitLatticeCoulombOutputSq
  unfold finiteUnitLatticeCoulombOutputSq
  apply Finset.sum_congr rfl
  intro v hv
  rw [
    finiteSupportUnitLatticeCoulombAction_finitePlaneWave
      count f v
  ]

/--
The general finite-support lattice `H^1` mass also specializes exactly to
the finite plane-wave quantity used in the BO proof.
-/
lemma finiteSupportLatticeH1Sq_finitePlaneWave
    (count : ℕ)
    (f : FinitePlaneWaveMode count → ℂ) :
    finiteSupportLatticeH1Sq
        (finitePlaneWaveLatticeIndex count) f
      =
    finitePlaneWaveLatticeH1Sq count f := by
  unfold finiteSupportLatticeH1Sq
  unfold finitePlaneWaveLatticeH1Sq
  rfl

/--
The representation-independent finite Fourier-polynomial Coulomb Hardy
statement.

It quantifies over every finite coefficient label type and every injective
map of those labels to distinct lattice momenta in `Z^3`.  Thus it is
exactly the finite Fourier support formulation of the periodic
multiplication estimate, with no reference to our shell enumeration or
basis cutoff.
-/
def HasFiniteSupportUnitLatticeCoulombHardyBound
    (H : ℝ) : Prop :=
  ∀ (α : Type) [Fintype α],
    ∀ index : α → Lattice3,
      Function.Injective index →
      ∀ f : α → ℂ,
        finiteSupportUnitLatticeCoulombOutputSq
            index f
          ≤
        H ^ 2 *
          finiteSupportLatticeH1Sq index f

/--
The arbitrary finite-support lattice Hardy theorem immediately gives the
cutoff-uniform theorem for our finite plane-wave basis.
-/
lemma universalUnitLatticeCoulombHardyBound_of_finiteSupport
    (H : ℝ)
    (hFinite :
      HasFiniteSupportUnitLatticeCoulombHardyBound H) :
    HasUniversalUnitLatticeCoulombHardyBound H := by
  intro count f

  have hGeneral :
      finiteSupportUnitLatticeCoulombOutputSq
          (finitePlaneWaveLatticeIndex count) f
        ≤
      H ^ 2 *
        finiteSupportLatticeH1Sq
          (finitePlaneWaveLatticeIndex count) f :=
    hFinite
      (FinitePlaneWaveMode count)
      (finitePlaneWaveLatticeIndex count)
      (finitePlaneWaveLatticeIndex_injective count)
      f

  rw [
    finiteSupportUnitLatticeCoulombOutputSq_finitePlaneWave
      count f
  ] at hGeneral
  rw [
    finiteSupportLatticeH1Sq_finitePlaneWave
      count f
  ] at hGeneral
  exact hGeneral

/-! ## Sixty-fifth milestone: explicit Parseval/real-space bridge interface -/

/--
Coefficient-space `L^2` mass for an arbitrary finite Fourier polynomial.
-/
noncomputable def finiteSupportL2Sq
    {α : Type*}
    [Fintype α]
    (f : α → ℂ) : ℝ :=
  ∑ p : α, ‖f p‖ ^ 2

/--
Coefficient-space gradient mass for an arbitrary finite Fourier polynomial.
The reciprocal-lattice momentum is dimensionless here.
-/
noncomputable def finiteSupportGradSq
    {α : Type*}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) : ℝ :=
  ∑ p : α,
    latticeNormSq (index p) * ‖f p‖ ^ 2

/--
The lattice `H^1` mass is exactly the sum of its `L^2` and gradient parts.
-/
lemma finiteSupportLatticeH1Sq_eq_l2_add_grad
    {α : Type*}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    finiteSupportLatticeH1Sq index f =
      finiteSupportL2Sq f +
        finiteSupportGradSq index f := by
  unfold finiteSupportLatticeH1Sq
  unfold finiteSupportL2Sq
  unfold finiteSupportGradSq
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro p hp
  ring

/-! ## Sixty-sixth milestone: actual Mathlib three-torus Fourier realization -/

noncomputable section

/--
Use exactly the canonical `UnitAddCircle` measure-space instance used by
Mathlib's `UnitAddTorus.mFourierLp`.  This avoids a definitionally distinct
but mathematically equal `AddCircle.measureSpace 1` instance being selected
when the product torus measure is elaborated.
-/
local instance unitAddCircleMeasureSpaceForFourier :
    MeasureTheory.MeasureSpace UnitAddCircle :=
  instMeasureSpaceUnitAddCircle

/--
The actual three-dimensional unit torus from Mathlib.
-/
abbrev UnitTorus3 :=
  UnitAddTorus (Fin 3)

/--
The actual complex `L^2` space on the three-dimensional unit torus, with
Mathlib's normalized Haar probability measure.
-/
abbrev UnitTorus3L2 :=
  MeasureTheory.Lp
    ℂ 2
    (MeasureTheory.volume :
      MeasureTheory.Measure UnitTorus3)

/--
The actual Mathlib `L^2` Fourier polynomial corresponding to a finite family
of distinct lattice momenta.
-/
noncomputable def torus3FourierPolynomial
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    UnitTorus3L2 :=
  ∑ p : α,
    f p •
      UnitAddTorus.mFourierLp 2 (index p)

/--
An injective finite family of Mathlib torus Fourier monomials remains
orthonormal.
-/
lemma torus3_mFourierLp_orthonormal_on
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index) :
    Orthonormal ℂ
      (fun p : α =>
        UnitAddTorus.mFourierLp 2 (index p)) := by
  simpa [Function.comp_def] using
    (UnitAddTorus.orthonormal_mFourier.comp
      index hInjective)

/--
Exact `L^2` Parseval identity for the concrete Mathlib torus Fourier
polynomial.
-/
lemma torus3FourierPolynomial_norm_sq
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ) :
    ‖torus3FourierPolynomial index f‖ ^ 2 =
      finiteSupportL2Sq f := by

  have hOrtho :
      Orthonormal ℂ
        (fun p : α =>
          UnitAddTorus.mFourierLp 2 (index p)) :=
    torus3_mFourierLp_orthonormal_on
      index hInjective

  have hInner :
      inner ℂ
          (torus3FourierPolynomial index f)
          (torus3FourierPolynomial index f)
        =
      ∑ p : α,
        (starRingEnd ℂ) (f p) * f p := by
    simpa [torus3FourierPolynomial] using
      (hOrtho.inner_sum
        f f (Finset.univ : Finset α))

  have hRe :=
    congrArg Complex.re hInner

  have hLeft :
      (inner ℂ
          (torus3FourierPolynomial index f)
          (torus3FourierPolynomial index f)).re
        =
      ‖torus3FourierPolynomial index f‖ ^ 2 :=
    inner_self_eq_norm_sq
      (𝕜 := ℂ)
      (torus3FourierPolynomial index f)

  have hRight :
      ((∑ p : α,
          (starRingEnd ℂ) (f p) * f p) : ℂ).re
        =
      finiteSupportL2Sq f := by
    rw [Complex.re_sum]
    unfold finiteSupportL2Sq
    apply Finset.sum_congr rfl
    intro p hp

    have hSelf :
        (inner ℂ (f p) (f p)).re =
          ‖f p‖ ^ 2 :=
      inner_self_eq_norm_sq
        (𝕜 := ℂ) (f p)

    rw [RCLike.inner_apply'] at hSelf
    exact hSelf

  rw [hLeft, hRight] at hRe
  exact hRe

/-! ## Sixty-seventh milestone: concrete Fourier-gradient functional -/

/--
The dimensionless periodic gradient energy defined directly from the
coefficients of Mathlib's actual three-torus Fourier Hilbert basis:

`sum_n |n|^2 |hat ψ(n)|^2`.

This is the spectral `H^1` seminorm squared.  It is now a fixed
definition, not part of the analytic input data.
-/
noncomputable def torus3FourierGradientSq
    (ψ : UnitTorus3L2) : ℝ :=
  ∑' nu : Lattice3,
    latticeNormSq nu *
      ‖(UnitAddTorus.mFourierBasis.repr ψ) nu‖ ^ 2

/-! ## Sixty-eighth milestone: prove gradient Parseval on Fourier polynomials -/

/--
For an injectively indexed finite Fourier polynomial, the coefficient of the
Mathlib Fourier Hilbert-basis representation at one of the selected momenta
is exactly the corresponding scalar coefficient.
-/
lemma torus3FourierPolynomial_repr_at_index
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ)
    (p : α) :
    (UnitAddTorus.mFourierBasis.repr
        (torus3FourierPolynomial index f))
        (index p)
      =
    f p := by
  rw [HilbertBasis.repr_apply_apply]

  have hOrtho :
      Orthonormal ℂ
        (fun q : α =>
          UnitAddTorus.mFourierLp 2 (index q)) :=
    torus3_mFourierLp_orthonormal_on
      index hInjective

  simpa [torus3FourierPolynomial] using
    hOrtho.inner_right_fintype f p

/--
Outside the finite image of the selected Fourier momenta, every coefficient
of the finite Fourier polynomial is zero.
-/
lemma torus3FourierPolynomial_repr_eq_zero_of_not_mem_image
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (nu : Lattice3)
    (hnu :
      nu ∉ (Finset.univ.image index : Finset Lattice3)) :
    (UnitAddTorus.mFourierBasis.repr
        (torus3FourierPolynomial index f)) nu
      =
    0 := by
  rw [HilbertBasis.repr_apply_apply]
  unfold torus3FourierPolynomial
  rw [inner_sum]
  apply Finset.sum_eq_zero
  intro p hp
  rw [inner_smul_right]

  have hne :
      nu ≠ index p := by
    intro hEq
    apply hnu
    apply Finset.mem_image.mpr
    exact ⟨p, Finset.mem_univ p, hEq.symm⟩

  have hInner :
      inner ℂ
          (UnitAddTorus.mFourierLp 2 nu)
          (UnitAddTorus.mFourierLp 2 (index p))
        =
      0 :=
    UnitAddTorus.orthonormal_mFourier.inner_eq_zero
      hne

  simpa using congrArg (fun z : ℂ => f p * z) hInner

/--
The concrete Fourier-gradient functional from milestone 67 has finite
support on every finite Fourier polynomial, so its `tsum` reduces to the
image of the finite momentum support.
-/
lemma torus3FourierGradientSq_eq_image_sum
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    torus3FourierGradientSq
        (torus3FourierPolynomial index f)
      =
    Finset.sum
      (Finset.univ.image index)
      (fun nu =>
        latticeNormSq nu *
          ‖(UnitAddTorus.mFourierBasis.repr
              (torus3FourierPolynomial index f)) nu‖ ^ 2) := by
  unfold torus3FourierGradientSq
  apply tsum_eq_sum
  intro nu hnu

  rw [
    torus3FourierPolynomial_repr_eq_zero_of_not_mem_image
      index f nu hnu
  ]
  simp

/--
Exact gradient Parseval identity for the actual Mathlib three-torus finite
Fourier polynomial:

`sum_n |n|^2 |hat psi(n)|^2
   = sum_p |index p|^2 |f p|^2`.
-/
lemma torus3FourierGradientSq_fourierPolynomial
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ) :
    torus3FourierGradientSq
        (torus3FourierPolynomial index f)
      =
    finiteSupportGradSq index f := by
  rw [
    torus3FourierGradientSq_eq_image_sum
      index f
  ]

  have hImage :
      Finset.sum
          (Finset.univ.image index)
          (fun nu =>
            latticeNormSq nu *
              ‖(UnitAddTorus.mFourierBasis.repr
                  (torus3FourierPolynomial index f)) nu‖ ^ 2)
        =
      ∑ p : α,
        latticeNormSq (index p) *
          ‖(UnitAddTorus.mFourierBasis.repr
              (torus3FourierPolynomial index f))
              (index p)‖ ^ 2 := by
    rw [Finset.sum_image hInjective.injOn]

  rw [hImage]
  unfold finiteSupportGradSq
  apply Finset.sum_congr rfl
  intro p hp
  rw [
    torus3FourierPolynomial_repr_at_index
      index hInjective f p
  ]

/-! ## Sixty-ninth milestone: remove the abstract Coulomb-output functional -/

/--
The Coulomb Fourier coefficient at an arbitrary output lattice momentum
`nu`, for a finite Fourier polynomial with coefficient labels `α`.

This is now completely explicit: convolution with the universal
unit-strength lattice Coulomb kernel.
-/
noncomputable def torus3CoulombFourierCoeff
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (nu : Lattice3) : ℂ :=
  ∑ p : α,
    f p *
      unitLatticeCoulombKernel
        (latticeSub nu (index p))

/--
On one of the selected input/output lattice momenta, the arbitrary-output
coefficient is exactly the finite-support Coulomb action defined earlier.
-/
lemma torus3CoulombFourierCoeff_at_index
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (q : α) :
    torus3CoulombFourierCoeff
        index f (index q)
      =
    finiteSupportUnitLatticeCoulombAction
      index f q := by
  unfold torus3CoulombFourierCoeff
  unfold finiteSupportUnitLatticeCoulombAction
  rfl

/--
Squared Coulomb-output Fourier mass on an arbitrary finite set of output
lattice modes.

Using finite partial sums avoids assigning a real-valued infinite `tsum`
before summability has been proved.
-/
noncomputable def torus3CoulombFourierPartialOutputSq
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (outputs : Finset Lattice3) : ℝ :=
  Finset.sum outputs
    (fun nu =>
      ‖torus3CoulombFourierCoeff index f nu‖ ^ 2)

/--
For an injective finite Fourier support, the BO finite-support Coulomb
output norm is exactly the arbitrary-output partial Fourier mass on the
image of that support.
-/
lemma finiteSupportUnitLatticeCoulombOutputSq_eq_partial_image
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ) :
    finiteSupportUnitLatticeCoulombOutputSq
        index f
      =
    torus3CoulombFourierPartialOutputSq
      index f (Finset.univ.image index) := by
  unfold finiteSupportUnitLatticeCoulombOutputSq
  unfold torus3CoulombFourierPartialOutputSq

  have hImage :
      Finset.sum
          (Finset.univ.image index)
          (fun nu =>
            ‖torus3CoulombFourierCoeff index f nu‖ ^ 2)
        =
      ∑ q : α,
        ‖torus3CoulombFourierCoeff
            index f (index q)‖ ^ 2 := by
    rw [Finset.sum_image hInjective.injOn]

  rw [hImage]
  apply Finset.sum_congr rfl
  intro q hq
  rw [torus3CoulombFourierCoeff_at_index]

/--
The remaining Coulomb `H^1 -> L^2` input in purely explicit Fourier form.

For every finite Fourier polynomial and every finite set of output Fourier
modes, the corresponding Coulomb-output partial `L^2` mass is bounded by
the input periodic `H^1` mass.

This is the exact finite-partial-sum consequence of:
1. the Fourier coefficient identity for multiplication by the periodic
   Coulomb Green function;
2. Bessel's inequality in the actual torus `L^2` space;
3. the real-space Coulomb multiplication `H^1 -> L^2` bound.

No abstract Coulomb-output functional remains.
-/
def HasUnitTorus3CoulombFourierPartialSumH1L2Bound
    (H : ℝ) : Prop :=
  ∀ (α : Type) [Fintype α],
    ∀ index : α → Lattice3,
      Function.Injective index →
      ∀ f : α → ℂ,
        ∀ outputs : Finset Lattice3,
          torus3CoulombFourierPartialOutputSq
              index f outputs
            ≤
          H ^ 2 *
            (‖torus3FourierPolynomial index f‖ ^ 2 +
              torus3FourierGradientSq
                (torus3FourierPolynomial index f))

/--
The explicit finite-output Fourier partial-sum estimate directly implies
the arbitrary finite-support lattice Hardy theorem.
-/
lemma finiteSupportUnitLatticeCoulombHardyBound_of_fourierPartialSums
    (H : ℝ)
    (hPartial :
      HasUnitTorus3CoulombFourierPartialSumH1L2Bound
        H) :
    HasFiniteSupportUnitLatticeCoulombHardyBound H := by
  intro α inst index hInjective f

  have hChosen :
      torus3CoulombFourierPartialOutputSq
          index f (Finset.univ.image index)
        ≤
      H ^ 2 *
        (‖torus3FourierPolynomial index f‖ ^ 2 +
          torus3FourierGradientSq
            (torus3FourierPolynomial index f)) :=
    hPartial
      α index hInjective f
      (Finset.univ.image index)

  rw [
    ← finiteSupportUnitLatticeCoulombOutputSq_eq_partial_image
      index hInjective f
  ] at hChosen

  calc
    finiteSupportUnitLatticeCoulombOutputSq
        index f
        ≤
      H ^ 2 *
        (‖torus3FourierPolynomial index f‖ ^ 2 +
          torus3FourierGradientSq
            (torus3FourierPolynomial index f)) :=
      hChosen
    _ =
      H ^ 2 *
        (finiteSupportL2Sq f +
          finiteSupportGradSq index f) := by
            rw [
              torus3FourierPolynomial_norm_sq
                index hInjective f,
              torus3FourierGradientSq_fourierPolynomial
                index hInjective f
            ]
    _ =
      H ^ 2 *
        finiteSupportLatticeH1Sq index f := by
            rw [
              finiteSupportLatticeH1Sq_eq_l2_add_grad
                index f
            ]

/-! ## Seventieth milestone: derive finite-output control from Mathlib Bessel -/

/--
A real-space realization of multiplication by the unit-strength periodic
Coulomb potential on finite Fourier polynomials.

For each finite Fourier polynomial, `productState` is intended to be the
actual torus `L^2` state `V_C * ψ`.  The only structural field states that
its Mathlib Fourier coefficient is the explicit Coulomb convolution
coefficient already defined in milestone 69.

No Bessel or partial-output estimate is assumed here.
-/
structure UnitTorus3CoulombProductRealization where
  productState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → UnitTorus3L2
  fourier_coeff :
    ∀ (α : Type) [Fintype α],
      ∀ (index : α → Lattice3),
        ∀ (f : α → ℂ),
          ∀ nu : Lattice3,
            inner ℂ
                (UnitAddTorus.mFourierLp 2 nu)
                (productState α index f)
              =
            torus3CoulombFourierCoeff
              index f nu

/--
Mathlib Bessel inequality gives the squared Fourier mass on every finite
output set directly from the `L^2` norm of the realized Coulomb product.
-/
lemma torus3CoulombFourierPartialOutputSq_le_product_norm_sq
    (data : UnitTorus3CoulombProductRealization)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (outputs : Finset Lattice3) :
    torus3CoulombFourierPartialOutputSq
        index f outputs
      ≤
    ‖data.productState α index f‖ ^ 2 := by

  have hBessel :
      Finset.sum outputs
          (fun nu =>
            ‖inner ℂ
                (UnitAddTorus.mFourierLp 2 nu)
                (data.productState α index f)‖ ^ 2)
        ≤
      ‖data.productState α index f‖ ^ 2 := by
    simpa only using
      (UnitAddTorus.orthonormal_mFourier.sum_inner_products_le
        (data.productState α index f)
        (s := outputs))

  unfold torus3CoulombFourierPartialOutputSq

  calc
    Finset.sum outputs
        (fun nu =>
          ‖torus3CoulombFourierCoeff index f nu‖ ^ 2)
        =
      Finset.sum outputs
        (fun nu =>
          ‖inner ℂ
              (UnitAddTorus.mFourierLp 2 nu)
              (data.productState α index f)‖ ^ 2) := by
          apply Finset.sum_congr rfl
          intro nu hnu
          rw [data.fourier_coeff α index f nu]
    _ ≤
      ‖data.productState α index f‖ ^ 2 :=
      hBessel

/--
The genuinely analytic real-space input remaining after Bessel has been
formalized: the actual Coulomb product state obeys the periodic
`H^1 -> L^2` bound on every finite Fourier polynomial.
-/
def HasUnitTorus3CoulombProductH1L2Bound
    (data : UnitTorus3CoulombProductRealization)
    (H : ℝ) : Prop :=
  ∀ (α : Type) [Fintype α],
    ∀ index : α → Lattice3,
      Function.Injective index →
      ∀ f : α → ℂ,
        ‖data.productState α index f‖ ^ 2
          ≤
        H ^ 2 *
          (‖torus3FourierPolynomial index f‖ ^ 2 +
            torus3FourierGradientSq
              (torus3FourierPolynomial index f))

/--
A real-space Coulomb product realization plus its `H^1 -> L^2` norm bound
implies the explicit finite-output Fourier partial-sum estimate from
milestone 69.
-/
lemma unitTorus3CoulombFourierPartialSumH1L2Bound_of_product
    (data : UnitTorus3CoulombProductRealization)
    (H : ℝ)
    (hReal :
      HasUnitTorus3CoulombProductH1L2Bound
        data H) :
    HasUnitTorus3CoulombFourierPartialSumH1L2Bound H := by
  intro α inst index hInjective f outputs

  have hBessel :
      torus3CoulombFourierPartialOutputSq
          index f outputs
        ≤
      ‖data.productState α index f‖ ^ 2 :=
    torus3CoulombFourierPartialOutputSq_le_product_norm_sq
      data index f outputs

  have hRealPoly :
      ‖data.productState α index f‖ ^ 2
        ≤
      H ^ 2 *
        (‖torus3FourierPolynomial index f‖ ^ 2 +
          torus3FourierGradientSq
            (torus3FourierPolynomial index f)) :=
    hReal α index hInjective f

  exact le_trans hBessel hRealPoly

/-! ## Seventy-first milestone: reduce the product realization to one potential -/

/--
Concrete periodic Coulomb-potential data on Mathlib's actual three-torus.

The function `potential` is intended to be the unit-strength periodic
Coulomb Green function.

The only Fourier information assumed is its own coefficient sequence

`mFourierCoeff potential nu = kappa(nu)`.

The `basis_memLp` field says multiplication of the potential by one Fourier
character is in `L^2`; this will later follow from `potential ∈ L^2`, since
the Fourier characters have pointwise norm one.
-/
structure UnitTorus3CoulombPotentialRealization where
  potential : UnitTorus3 → ℂ
  basis_memLp :
    ∀ n : Lattice3,
      MeasureTheory.MemLp
        (fun x : UnitTorus3 =>
          potential x *
            UnitAddTorus.mFourier n x)
        2 MeasureTheory.volume
  fourier_coeff :
    ∀ nu : Lattice3,
      UnitAddTorus.mFourierCoeff
          potential nu
        =
      unitLatticeCoulombKernel nu

/--
Multiplying the periodic potential by one Fourier character shifts its
Fourier coefficients exactly as expected:

`hat(V * e_n)(nu) = hat(V)(nu - n) = kappa(nu - n)`.

This is proved from `UnitAddTorus.mFourier_add`; it is no longer an
independent assumption.
-/
lemma unitTorus3CoulombPotential_basis_fourier_shift
    (data : UnitTorus3CoulombPotentialRealization)
    (n nu : Lattice3) :
    UnitAddTorus.mFourierCoeff
        (fun x : UnitTorus3 =>
          data.potential x *
            UnitAddTorus.mFourier n x)
        nu
      =
    unitLatticeCoulombKernel
      (latticeSub nu n) := by

  have hfreq :
      -(latticeSub nu n) =
        n + (-nu) := by
    ext i
    simp [latticeSub]
    ring

  calc
    UnitAddTorus.mFourierCoeff
        (fun x : UnitTorus3 =>
          data.potential x *
            UnitAddTorus.mFourier n x)
        nu
        =
      UnitAddTorus.mFourierCoeff
        data.potential
        (latticeSub nu n) := by
          unfold UnitAddTorus.mFourierCoeff
          apply MeasureTheory.integral_congr_ae
          filter_upwards [] with x
          simp only [smul_eq_mul]
          rw [hfreq]
          rw [UnitAddTorus.mFourier_add]
          ring
    _ =
      unitLatticeCoulombKernel
        (latticeSub nu n) :=
      data.fourier_coeff (latticeSub nu n)

/--
The actual `L^2` state obtained by multiplying the potential by one Fourier
basis character.
-/
noncomputable def UnitTorus3CoulombPotentialRealization.basisProductState
    (data : UnitTorus3CoulombPotentialRealization)
    (n : Lattice3) :
    UnitTorus3L2 :=
  (data.basis_memLp n).toLp
    (fun x : UnitTorus3 =>
      data.potential x *
        UnitAddTorus.mFourier n x)

/--
The Mathlib Fourier coefficient of the `L^2` basis-product state is exactly
the shifted lattice Coulomb kernel.
-/
lemma unitTorus3CoulombPotential_basisProductState_fourier
    (data : UnitTorus3CoulombPotentialRealization)
    (n nu : Lattice3) :
    inner ℂ
        (UnitAddTorus.mFourierLp 2 nu)
        (data.basisProductState n)
      =
    unitLatticeCoulombKernel
      (latticeSub nu n) := by

  have hrepr :=
    UnitAddTorus.mFourierBasis_repr
      (data.basisProductState n) nu

  rw [HilbertBasis.repr_apply_apply] at hrepr

  have hreprLp :
      inner ℂ
          (UnitAddTorus.mFourierLp 2 nu)
          (data.basisProductState n)
        =
      UnitAddTorus.mFourierCoeff
        (↑↑(data.basisProductState n))
        nu := by
    simpa only [UnitAddTorus.coe_mFourierBasis] using hrepr

  have hCoeff :
      UnitAddTorus.mFourierCoeff
          (↑↑(data.basisProductState n))
          nu
        =
      UnitAddTorus.mFourierCoeff
          (fun x : UnitTorus3 =>
            data.potential x *
              UnitAddTorus.mFourier n x)
          nu := by
    unfold UnitAddTorus.mFourierCoeff
    unfold UnitTorus3CoulombPotentialRealization.basisProductState
    apply MeasureTheory.integral_congr_ae
    filter_upwards [
      MeasureTheory.MemLp.coeFn_toLp
        (data.basis_memLp n)
    ] with x hx
    rw [hx]

  calc
    inner ℂ
        (UnitAddTorus.mFourierLp 2 nu)
        (data.basisProductState n)
        =
      UnitAddTorus.mFourierCoeff
        (↑↑(data.basisProductState n))
        nu :=
      hreprLp
    _ =
      UnitAddTorus.mFourierCoeff
        (fun x : UnitTorus3 =>
          data.potential x *
            UnitAddTorus.mFourier n x)
        nu :=
      hCoeff
    _ =
      unitLatticeCoulombKernel
        (latticeSub nu n) :=
      unitTorus3CoulombPotential_basis_fourier_shift
        data n nu

/--
For an arbitrary finite Fourier polynomial, form the Coulomb-product state
as the corresponding finite linear combination of the basis-product
states.
-/
noncomputable def UnitTorus3CoulombPotentialRealization.productState
    (data : UnitTorus3CoulombPotentialRealization)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    UnitTorus3L2 :=
  ∑ p : α,
    f p • data.basisProductState (index p)

/--
Finite linearity now gives the full Coulomb convolution formula from the
single-potential Fourier coefficient specification.
-/
lemma unitTorus3CoulombPotential_productState_fourier
    (data : UnitTorus3CoulombPotentialRealization)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (nu : Lattice3) :
    inner ℂ
        (UnitAddTorus.mFourierLp 2 nu)
        (data.productState index f)
      =
    torus3CoulombFourierCoeff
      index f nu := by
  unfold UnitTorus3CoulombPotentialRealization.productState
  unfold torus3CoulombFourierCoeff
  rw [inner_sum]
  apply Finset.sum_congr rfl
  intro p hp
  rw [inner_smul_right]
  rw [
    unitTorus3CoulombPotential_basisProductState_fourier
      data (index p) nu
  ]

/--
The single-potential realization canonically produces the milestone-70
Coulomb-product realization.  Its Fourier coefficient field is now a
theorem rather than an assumption.
-/
noncomputable def UnitTorus3CoulombPotentialRealization.toProductRealization
    (data : UnitTorus3CoulombPotentialRealization) :
    UnitTorus3CoulombProductRealization where
  productState :=
    fun α _ index f =>
      data.productState index f
  fourier_coeff := by
    intro α inst index f nu
    exact
      unitTorus3CoulombPotential_productState_fourier
        data index f nu

/--
The remaining Hardy input with the product state now fixed by one periodic
potential.
-/
def HasUnitTorus3CoulombPotentialH1L2Bound
    (data : UnitTorus3CoulombPotentialRealization)
    (H : ℝ) : Prop :=
  ∀ (α : Type) [Fintype α],
    ∀ index : α → Lattice3,
      Function.Injective index →
      ∀ f : α → ℂ,
        ‖data.productState index f‖ ^ 2
          ≤
        H ^ 2 *
          (‖torus3FourierPolynomial index f‖ ^ 2 +
            torus3FourierGradientSq
              (torus3FourierPolynomial index f))

/--
The potential-level Hardy estimate supplies the product-level estimate from
milestone 70.
-/
lemma unitTorus3CoulombProductH1L2Bound_of_potential
    (data : UnitTorus3CoulombPotentialRealization)
    (H : ℝ)
    (hHardy :
      HasUnitTorus3CoulombPotentialH1L2Bound
        data H) :
    HasUnitTorus3CoulombProductH1L2Bound
      data.toProductRealization H := by
  intro α inst index hInjective f
  exact hHardy α index hInjective f

/-! ## Seventy-second milestone: one `L²` hypothesis for the periodic potential -/

/--
Periodic Coulomb-potential data with a single `L²` hypothesis.

Compared with `UnitTorus3CoulombPotentialRealization` from milestone 71,
the family of assumptions

`MemLp (V * e_n) 2 volume`

for every Fourier character has been replaced by the single natural
statement

`MemLp V 2 volume`.

The Fourier coefficient specification is unchanged.
-/
structure UnitTorus3CoulombPotentialL2Realization where
  potential : UnitTorus3 → ℂ
  potential_memLp :
    MeasureTheory.MemLp
      potential 2 MeasureTheory.volume
  fourier_coeff :
    ∀ nu : Lattice3,
      UnitAddTorus.mFourierCoeff
          potential nu
        =
      unitLatticeCoulombKernel nu

/--
Multiplication by a torus Fourier character preserves `L²` membership.

We only need domination rather than an exact norm identity:
the pointwise norm of `mFourier n` is bounded by its uniform norm, and
Mathlib proves that uniform norm is exactly one.
-/
lemma unitTorus3CoulombPotential_basis_memLp_of_potential_memLp
    (data : UnitTorus3CoulombPotentialL2Realization)
    (n : Lattice3) :
    MeasureTheory.MemLp
      (fun x : UnitTorus3 =>
        data.potential x *
          UnitAddTorus.mFourier n x)
      2 MeasureTheory.volume := by

  have hFourierMeas :
      MeasureTheory.AEStronglyMeasurable
        (fun x : UnitTorus3 =>
          UnitAddTorus.mFourier n x)
        MeasureTheory.volume :=
    (UnitAddTorus.mFourier n).continuous.aestronglyMeasurable

  have hProductMeas :
      MeasureTheory.AEStronglyMeasurable
        (fun x : UnitTorus3 =>
          data.potential x *
            UnitAddTorus.mFourier n x)
        MeasureTheory.volume :=
    data.potential_memLp.1.fun_mul hFourierMeas

  refine data.potential_memLp.of_le hProductMeas ?_

  filter_upwards [] with x

  rw [norm_mul]

  calc
    ‖data.potential x‖ *
          ‖UnitAddTorus.mFourier n x‖
        ≤
      ‖data.potential x‖ *
          ‖UnitAddTorus.mFourier n‖ := by
            exact
              mul_le_mul_of_nonneg_left
                (ContinuousMap.norm_coe_le_norm
                  (UnitAddTorus.mFourier n) x)
                (norm_nonneg _)
    _ =
      ‖data.potential x‖ := by
        rw [UnitAddTorus.mFourier_norm, mul_one]

/--
The single-`L²` potential data canonically supply the milestone-71
potential realization.
-/
noncomputable def
    UnitTorus3CoulombPotentialL2Realization.toPotentialRealization
    (data : UnitTorus3CoulombPotentialL2Realization) :
    UnitTorus3CoulombPotentialRealization where
  potential := data.potential
  basis_memLp := by
    intro n
    exact
      unitTorus3CoulombPotential_basis_memLp_of_potential_memLp
        data n
  fourier_coeff := data.fourier_coeff

/--
The remaining periodic Coulomb Hardy statement with the potential now
specified by one `L²` function.

The product state is the one canonically built in milestone 71 from this
potential.
-/
def HasUnitTorus3CoulombL2PotentialH1L2Bound
    (data : UnitTorus3CoulombPotentialL2Realization)
    (H : ℝ) : Prop :=
  HasUnitTorus3CoulombPotentialH1L2Bound
    data.toPotentialRealization H

/-! ## Seventy-third milestone: construct the periodic Coulomb `L²` state from `ℓ²` coefficients -/

/--
The discrete square-summability statement needed to construct the periodic
unit-strength Coulomb potential in `L²`.

Mathematically this is

`sum_{nu : Z^3} |kappa(nu)|^2 < infinity`,

with `kappa(nu) = 1 / |nu|^2` and `kappa(0) = 0`.

The earlier shell estimates provide the ingredients for proving this
statement, but the infinite `Summable` assembly is deliberately left for
the next milestone.
-/
def HasUnitLatticeCoulombCoeffL2 : Prop :=
  Memℓp
    (fun nu : Lattice3 =>
      unitLatticeCoulombKernel nu)
    2

/--
Package the universal Coulomb Fourier coefficient sequence as Mathlib's
actual `ℓ²` coefficient vector.
-/
noncomputable def unitLatticeCoulombCoeffLp
    (hCoeffL2 : HasUnitLatticeCoulombCoeffL2) :
    lp (fun _ : Lattice3 => ℂ) 2 :=
  ⟨
    (fun nu : Lattice3 =>
      unitLatticeCoulombKernel nu),
    hCoeffL2
  ⟩

@[simp]
lemma unitLatticeCoulombCoeffLp_apply
    (hCoeffL2 : HasUnitLatticeCoulombCoeffL2)
    (nu : Lattice3) :
    (unitLatticeCoulombCoeffLp hCoeffL2) nu =
      unitLatticeCoulombKernel nu := by
  rfl

/--
The canonical periodic Coulomb `L²` state obtained by applying the inverse
of Mathlib's Fourier Hilbert-basis representation to the `ℓ²` coefficient
sequence `kappa`.
-/
noncomputable def unitTorus3CoulombState_of_coeffL2
    (hCoeffL2 : HasUnitLatticeCoulombCoeffL2) :
    UnitTorus3L2 :=
  UnitAddTorus.mFourierBasis.repr.symm
    (unitLatticeCoulombCoeffLp hCoeffL2)

/--
The canonical state has exactly the requested Coulomb Fourier
coefficients.  This is now a theorem of the Hilbert-basis construction,
rather than part of the potential data.
-/
lemma unitTorus3CoulombState_fourierCoeff
    (hCoeffL2 : HasUnitLatticeCoulombCoeffL2)
    (nu : Lattice3) :
    UnitAddTorus.mFourierCoeff
        (↑↑(unitTorus3CoulombState_of_coeffL2
          hCoeffL2))
        nu
      =
    unitLatticeCoulombKernel nu := by

  have hrepr :=
    UnitAddTorus.mFourierBasis_repr
      (unitTorus3CoulombState_of_coeffL2 hCoeffL2)
      nu

  calc
    UnitAddTorus.mFourierCoeff
        (↑↑(unitTorus3CoulombState_of_coeffL2
          hCoeffL2))
        nu
        =
      (UnitAddTorus.mFourierBasis.repr
        (unitTorus3CoulombState_of_coeffL2
          hCoeffL2)) nu := by
            exact hrepr.symm
    _ =
      (unitLatticeCoulombCoeffLp hCoeffL2) nu := by
        unfold unitTorus3CoulombState_of_coeffL2
        simp
    _ =
      unitLatticeCoulombKernel nu := by
        exact
          unitLatticeCoulombCoeffLp_apply
            hCoeffL2 nu

/--
The canonical Fourier-synthesized state produces the milestone-72
single-`L²` potential realization.

There is no longer an independently supplied potential function, no
independently supplied `MemLp` proof, and no independently supplied Fourier
coefficient identity.
-/
noncomputable def unitTorus3CoulombPotentialL2Realization_of_coeffL2
    (hCoeffL2 : HasUnitLatticeCoulombCoeffL2) :
    UnitTorus3CoulombPotentialL2Realization where
  potential :=
    fun x : UnitTorus3 =>
      (unitTorus3CoulombState_of_coeffL2 hCoeffL2) x
  potential_memLp := by
    exact
      MeasureTheory.Lp.memLp
        (unitTorus3CoulombState_of_coeffL2 hCoeffL2)
  fourier_coeff := by
    intro nu
    exact
      unitTorus3CoulombState_fourierCoeff
        hCoeffL2 nu

/-! ## Seventy-fourth milestone: prove the Coulomb coefficient sequence is in `ℓ²` -/

/--
The unit-strength Coulomb-square mass in the first `count` cubic shells is
uniformly bounded by `108`.

This is the exact global version of the finite-shell estimate already used
earlier for the Sobolev branch:
- shell cardinality is at most `54 (n+1)^2`;
- each Coulomb-square weight is at most `(n+1)^-4`;
- hence shell mass is at most `54 (n+1)^-2`;
- the reciprocal telescoping budget sums any finite initial collection to
  at most `108`.
-/
lemma unitCoulombShellTail_uniform_bound
    (count : ℕ) :
    shellTailMass
        (finiteShellMass
          cubicSupShell
          (latticeCoulombSquareWeight 1))
        0 count
      ≤
    108 := by

  have hDecay :
      ∀ j ∈ Finset.range count,
        finiteShellMass
            cubicSupShell
            (latticeCoulombSquareWeight 1)
            (0 + j)
          ≤
        54 / ((((0 + j : ℕ) : ℝ) + 1) ^ 2) := by
    intro j hj
    simpa using
      (finiteShellMass_inverse_square_bound
        cubicSupShell
        (latticeCoulombSquareWeight 1)
        54 1
        (by norm_num)
        (by norm_num)
        cubicSupShell_hasQuadraticShellCount
        (cubicSupShell_hasInverseFourthCoulombWeight
          1 (by norm_num))
        j)

  have hTail :
      shellTailMass
          (finiteShellMass
            cubicSupShell
            (latticeCoulombSquareWeight 1))
          0 count
        ≤
      reciprocalShellBudget 54 0 :=
    shellTailMass_le_reciprocal_budget
      (finiteShellMass
        cubicSupShell
        (latticeCoulombSquareWeight 1))
      54 0 count
      (by norm_num)
      hDecay

  calc
    shellTailMass
        (finiteShellMass
          cubicSupShell
          (latticeCoulombSquareWeight 1))
        0 count
        ≤ reciprocalShellBudget 54 0 :=
      hTail
    _ = 108 := by
      norm_num [reciprocalShellBudget]

/--
The total Coulomb-square weight over the explicit finite plane-wave mode
type is exactly the mass of its nonzero cubic shells.  The distinguished
zero mode contributes zero.
-/
lemma finitePlaneWaveCoulombSquareWeightSum_eq_shellTailMass
    (count : ℕ) :
    (∑ u : FinitePlaneWaveMode count,
      latticeCoulombSquareWeight 1
        (finitePlaneWaveLatticeIndex count u))
      =
    shellTailMass
      (finiteShellMass
        cubicSupShell
        (latticeCoulombSquareWeight 1))
      0 count := by

  rw [Fintype.sum_option]
  rw [Fintype.sum_sigma]

  have hZero :
      latticeCoulombSquareWeight 1
          (finitePlaneWaveLatticeIndex
            count
            (none : FinitePlaneWaveMode count))
        =
      0 := by
    unfold finitePlaneWaveLatticeIndex
    unfold latticeCoulombSquareWeight
    unfold latticeNormSq
    norm_num

  rw [hZero, zero_add]

  unfold shellTailMass
  simp only [zero_add]

  calc
    (∑ n : FiniteShellIndex count,
        ∑ nu : ↥(cubicSupShell (n : ℕ)),
          latticeCoulombSquareWeight 1
            (finitePlaneWaveLatticeIndex
              count
              (some ⟨n, nu⟩)))
        =
      ∑ n : FiniteShellIndex count,
        finiteShellMass
          cubicSupShell
          (latticeCoulombSquareWeight 1)
          (n : ℕ) := by
            apply Finset.sum_congr rfl
            intro n hn
            unfold finiteShellMass
            change
              (∑ nu : ↥(cubicSupShell (n : ℕ)),
                latticeCoulombSquareWeight 1
                  (nu : Lattice3))
                =
              Finset.sum
                (cubicSupShell (n : ℕ))
                (latticeCoulombSquareWeight 1)
            exact
              Finset.sum_coe_sort
                (cubicSupShell (n : ℕ))
                (latticeCoulombSquareWeight 1)
    _ =
      Finset.sum
        (Finset.range count)
        (fun n =>
          finiteShellMass
            cubicSupShell
            (latticeCoulombSquareWeight 1)
            n) := by
              exact
                Finset.sum_coe_sort
                  (Finset.range count)
                  (fun n =>
                    finiteShellMass
                      cubicSupShell
                      (latticeCoulombSquareWeight 1)
                      n)

/--
Consequently the Coulomb-square mass of every explicit finite plane-wave
mode type is at most `108`.
-/
lemma finitePlaneWaveCoulombSquareWeightSum_le_108
    (count : ℕ) :
    (∑ u : FinitePlaneWaveMode count,
      latticeCoulombSquareWeight 1
        (finitePlaneWaveLatticeIndex count u))
      ≤
    108 := by
  rw [
    finitePlaneWaveCoulombSquareWeightSum_eq_shellTailMass
  ]
  exact unitCoulombShellTail_uniform_bound count

/--
A radius large enough to contain every coordinate of every lattice vector
in a finite set.

The extra `1` is harmless and makes the radius strictly positive.
-/
noncomputable def finiteLatticeCoordBudget
    (s : Finset Lattice3) : ℕ :=
  1 +
    Finset.sum s
      (fun nu =>
        Finset.sum Finset.univ
          (fun i : Fin 3 =>
            (nu i).natAbs))

/--
Every coordinate of every vector in `s` lies in the integer cube of radius
`finiteLatticeCoordBudget s`.
-/
lemma finiteLatticeCoordBudget_coord_bounds
    (s : Finset Lattice3)
    {nu : Lattice3}
    (hnu : nu ∈ s) :
    ∀ i : Fin 3,
      -((finiteLatticeCoordBudget s : ℕ) : ℤ)
          ≤ nu i ∧
        nu i
          ≤ ((finiteLatticeCoordBudget s : ℕ) : ℤ) := by
  classical
  intro i

  have hInnerNonneg :
      ∀ j ∈ (Finset.univ : Finset (Fin 3)),
        0 ≤ (nu j).natAbs := by
    intro j hj
    exact Nat.zero_le _

  have hInner :
      (nu i).natAbs
        ≤
      Finset.sum Finset.univ
        (fun j : Fin 3 =>
          (nu j).natAbs) :=
    Finset.single_le_sum
      hInnerNonneg
      (Finset.mem_univ i)

  have hOuterNonneg :
      ∀ q ∈ s,
        0 ≤
          Finset.sum Finset.univ
            (fun j : Fin 3 =>
              (q j).natAbs) := by
    intro q hq
    exact Nat.zero_le _

  have hOuter :
      Finset.sum Finset.univ
          (fun j : Fin 3 =>
            (nu j).natAbs)
        ≤
      Finset.sum s
        (fun q =>
          Finset.sum Finset.univ
            (fun j : Fin 3 =>
              (q j).natAbs)) :=
    Finset.single_le_sum
      hOuterNonneg
      hnu

  have hNat :
      (nu i).natAbs
        ≤
      finiteLatticeCoordBudget s := by
    unfold finiteLatticeCoordBudget
    omega

  have hCast :
      (((nu i).natAbs : ℕ) : ℤ)
        ≤
      ((finiteLatticeCoordBudget s : ℕ) : ℤ) := by
    exact_mod_cast hNat

  rcases Int.natAbs_eq (nu i) with hi | hi
  · rw [hi]
    constructor <;> omega
  · rw [hi]
    constructor <;> omega

/--
Encode any lattice vector lying in the coordinate cube of radius `R` as an
explicit finite plane-wave mode.

The zero vector is sent to the distinguished zero mode.  A nonzero vector
is sent to the unique cubic shell whose existence is supplied by milestone
40.
-/
lemma exists_finitePlaneWaveModeOfBoundedLattice
    (R : ℕ)
    (nu : Lattice3)
    (hBounds :
      ∀ i : Fin 3,
        -((R : ℕ) : ℤ) ≤ nu i ∧
          nu i ≤ ((R : ℕ) : ℤ)) :
    ∃ u : FinitePlaneWaveMode R,
      finitePlaneWaveLatticeIndex R u = nu := by
  classical
  by_cases hzero :
      nu = (fun _ => 0)
  · refine ⟨none, ?_⟩
    rw [hzero]
    rfl
  · rcases
      exists_cubicSupShell_of_nonzero_coord_bounds
        R nu hzero hBounds with
      ⟨n, hnlt, hnmem⟩
    refine
      ⟨
        some
          ⟨
            ⟨n, Finset.mem_range.mpr hnlt⟩,
            ⟨nu, hnmem⟩
          ⟩,
        ?_
      ⟩
    rfl

/--
Choose one explicit finite plane-wave mode representing the bounded lattice
vector.  The existence proof stays in `Prop`; this noncomputable definition
uses `Classical.choose` only after that proof has been established.
-/
noncomputable def finitePlaneWaveModeOfBoundedLattice
    (R : ℕ)
    (nu : Lattice3)
    (hBounds :
      ∀ i : Fin 3,
        -((R : ℕ) : ℤ) ≤ nu i ∧
          nu i ≤ ((R : ℕ) : ℤ)) :
    FinitePlaneWaveMode R :=
  Classical.choose
    (exists_finitePlaneWaveModeOfBoundedLattice
      R nu hBounds)

/--
The bounded-lattice encoding represents exactly the original reciprocal
lattice vector.
-/
lemma finitePlaneWaveLatticeIndex_modeOfBoundedLattice
    (R : ℕ)
    (nu : Lattice3)
    (hBounds :
      ∀ i : Fin 3,
        -((R : ℕ) : ℤ) ≤ nu i ∧
          nu i ≤ ((R : ℕ) : ℤ)) :
    finitePlaneWaveLatticeIndex R
        (finitePlaneWaveModeOfBoundedLattice
          R nu hBounds)
      =
    nu := by
  exact
    Classical.choose_spec
      (exists_finitePlaneWaveModeOfBoundedLattice
        R nu hBounds)

/--
Every finite collection of lattice Coulomb coefficients has squared
`ℓ²` mass at most `108`.

This is the key uniform finite-partial-sum estimate.  Each finite set is
embedded injectively into one sufficiently large explicit plane-wave mode
type, and the already proved uniform shell bound controls the latter.
-/
lemma finite_unitLatticeCoulombKernel_norm_sq_sum_le_108
    (s : Finset Lattice3) :
    Finset.sum s
        (fun nu =>
          ‖unitLatticeCoulombKernel nu‖ ^ 2)
      ≤
    108 := by
  classical

  let R : ℕ := finiteLatticeCoordBudget s

  let encode :
      ↥s → FinitePlaneWaveMode R :=
    fun q =>
      finitePlaneWaveModeOfBoundedLattice
        R
        (q : Lattice3)
        (by
          dsimp [R]
          exact
            finiteLatticeCoordBudget_coord_bounds
              s q.property)

  have hIndex :
      ∀ q : ↥s,
        finitePlaneWaveLatticeIndex R
            (encode q)
          =
        (q : Lattice3) := by
    intro q
    dsimp [encode]
    exact
      finitePlaneWaveLatticeIndex_modeOfBoundedLattice
        R
        (q : Lattice3)
        (by
          dsimp [R]
          exact
            finiteLatticeCoordBudget_coord_bounds
              s q.property)

  have hEncodeInjective :
      Function.Injective encode := by
    intro q₁ q₂ hq
    apply Subtype.ext
    have hIndexEq :=
      congrArg
        (finitePlaneWaveLatticeIndex R)
        hq
    rw [hIndex q₁, hIndex q₂] at hIndexEq
    exact hIndexEq

  have hImageEq :
      Finset.sum
          (Finset.univ.image encode)
          (fun u =>
            latticeCoulombSquareWeight 1
              (finitePlaneWaveLatticeIndex R u))
        =
      Finset.sum s
        (latticeCoulombSquareWeight 1) := by

    rw [Finset.sum_image hEncodeInjective.injOn]

    calc
      (∑ q : ↥s,
        latticeCoulombSquareWeight 1
          (finitePlaneWaveLatticeIndex R
            (encode q)))
          =
        ∑ q : ↥s,
          latticeCoulombSquareWeight 1
            (q : Lattice3) := by
              apply Finset.sum_congr rfl
              intro q hq
              rw [hIndex q]
      _ =
        Finset.sum s
          (latticeCoulombSquareWeight 1) := by
            exact
              Finset.sum_coe_sort
                s
                (latticeCoulombSquareWeight 1)

  have hImageLe :
      Finset.sum
          (Finset.univ.image encode)
          (fun u =>
            latticeCoulombSquareWeight 1
              (finitePlaneWaveLatticeIndex R u))
        ≤
      (∑ u : FinitePlaneWaveMode R,
        latticeCoulombSquareWeight 1
          (finitePlaneWaveLatticeIndex R u)) := by

    apply Finset.sum_le_sum_of_subset_of_nonneg
    · exact Finset.subset_univ _
    · intro u hu hnot
      exact
        latticeCoulombSquareWeight_nonneg
          1 (by norm_num)
          (finitePlaneWaveLatticeIndex R u)

  have hWeightSum :
      Finset.sum s
          (latticeCoulombSquareWeight 1)
        ≤
      108 := by
    calc
      Finset.sum s
          (latticeCoulombSquareWeight 1)
          =
        Finset.sum
          (Finset.univ.image encode)
          (fun u =>
            latticeCoulombSquareWeight 1
              (finitePlaneWaveLatticeIndex R u)) :=
        hImageEq.symm
      _ ≤
        (∑ u : FinitePlaneWaveMode R,
          latticeCoulombSquareWeight 1
            (finitePlaneWaveLatticeIndex R u)) :=
        hImageLe
      _ ≤ 108 :=
        finitePlaneWaveCoulombSquareWeightSum_le_108 R

  calc
    Finset.sum s
        (fun nu =>
          ‖unitLatticeCoulombKernel nu‖ ^ 2)
        =
      Finset.sum s
        (latticeCoulombSquareWeight 1) := by
          apply Finset.sum_congr rfl
          intro nu hnu
          rw [unitLatticeCoulombKernel_norm_sq]
    _ ≤ 108 :=
      hWeightSum

/--
The universal unit-strength Coulomb Fourier coefficient sequence is
square-summable on `Z³`.

This discharges `HasUnitLatticeCoulombCoeffL2` with no infinite-series
assumption: Mathlib's `memℓp_gen'` reduces membership in `ℓ²` to a uniform
bound on finite partial sums, and the previous lemma supplies the explicit
constant `108`.
-/
lemma hasUnitLatticeCoulombCoeffL2 :
    HasUnitLatticeCoulombCoeffL2 := by
  unfold HasUnitLatticeCoulombCoeffL2
  apply memℓp_gen' (C := 108)
  intro s
  have hFinite :=
    finite_unitLatticeCoulombKernel_norm_sq_sum_le_108
      s
  simpa using hFinite

/--
The canonical periodic Coulomb potential now exists with no coefficient
summability assumption.
-/
noncomputable def canonicalUnitTorus3CoulombPotential :
    UnitTorus3CoulombPotentialL2Realization :=
  unitTorus3CoulombPotentialL2Realization_of_coeffL2
    hasUnitLatticeCoulombCoeffL2

/--
The only remaining periodic analytic input after coefficient
square-summability has been proved.
-/
def HasCanonicalPeriodicCoulombHardyBound
    (H : ℝ) : Prop :=
  HasUnitTorus3CoulombL2PotentialH1L2Bound
    canonicalUnitTorus3CoulombPotential
    H

/-! ## Seventy-fifth milestone: split periodic Coulomb Hardy into singular and regular pieces -/

/--
The concrete Fourier-gradient functional is nonnegative.

This small lemma is useful independently of the Coulomb split and avoids
repeatedly unfolding the real-valued `tsum`.
-/
lemma torus3FourierGradientSq_nonneg
    (ψ : UnitTorus3L2) :
    0 ≤ torus3FourierGradientSq ψ := by
  unfold torus3FourierGradientSq
  apply tsum_nonneg
  intro nu
  exact
    mul_nonneg
      (latticeNormSq_nonneg nu)
      (sq_nonneg _)

/--
Elementary Hilbert-space inequality used to recombine the singular and
regular terms:

`||x+y||² <= 2 (||x||² + ||y||²)`.
-/
lemma norm_add_sq_le_two_mul_sq_add_sq
    (x y : UnitTorus3L2) :
    ‖x + y‖ ^ 2 ≤
      2 * (‖x‖ ^ 2 + ‖y‖ ^ 2) := by

  have hNorm :
      ‖x + y‖ ≤ ‖x‖ + ‖y‖ :=
    norm_add_le x y

  have hSq :
      ‖x + y‖ ^ 2 ≤
        (‖x‖ + ‖y‖) ^ 2 :=
    sq_le_sq_of_nonneg
      (norm_nonneg _)
      hNorm

  have hAlg :
      (‖x‖ + ‖y‖) ^ 2 ≤
        2 * (‖x‖ ^ 2 + ‖y‖ ^ 2) := by
    nlinarith [sq_nonneg (‖x‖ - ‖y‖)]

  exact le_trans hSq hAlg

/-! ## Seventy-sixth milestone: realize and close the bounded regular remainder -/

/--
A concrete bounded multiplier on the unit three-torus.

The nonnegative scalar `B` is a pointwise norm bound for the multiplier.
`AEStronglyMeasurable` is exactly the measurability input needed for
constructing its product with an arbitrary `L²` state.
-/
structure UnitTorus3BoundedMultiplier (B : ℝ) where
  multiplier : UnitTorus3 → ℂ
  multiplier_aestronglyMeasurable :
    MeasureTheory.AEStronglyMeasurable
      multiplier MeasureTheory.volume
  bound_nonneg : 0 ≤ B
  norm_le :
    ∀ x : UnitTorus3,
      ‖multiplier x‖ ≤ B

/--
Multiplication by a bounded measurable torus function preserves `L²`.

The proof uses `MemLp.of_le`, comparing pointwise with the constant
multiple `B * ψ`, whose `L²` membership follows from
`MemLp.const_mul`.
-/
lemma UnitTorus3BoundedMultiplier.product_memLp
    {B : ℝ}
    (data : UnitTorus3BoundedMultiplier B)
    (ψ : UnitTorus3L2) :
    MeasureTheory.MemLp
      (fun x : UnitTorus3 =>
        data.multiplier x * ψ x)
      2 MeasureTheory.volume := by

  have hProductMeas :
      MeasureTheory.AEStronglyMeasurable
        (fun x : UnitTorus3 =>
          data.multiplier x * ψ x)
        MeasureTheory.volume :=
    data.multiplier_aestronglyMeasurable.fun_mul
      (MeasureTheory.Lp.aestronglyMeasurable ψ)

  have hScaled :
      MeasureTheory.MemLp
        (fun x : UnitTorus3 =>
          (B : ℂ) * ψ x)
        2 MeasureTheory.volume := by
    exact
      (MeasureTheory.Lp.memLp ψ).const_mul
        (B : ℂ)

  refine hScaled.of_le hProductMeas ?_

  filter_upwards [] with x

  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs]

  rw [abs_of_nonneg data.bound_nonneg]

  exact
    mul_le_mul_of_nonneg_right
      (data.norm_le x)
      (norm_nonneg _)

/--
The actual `L²` product state defined by a bounded torus multiplier.
-/
noncomputable def UnitTorus3BoundedMultiplier.productState
    {B : ℝ}
    (data : UnitTorus3BoundedMultiplier B)
    (ψ : UnitTorus3L2) :
    UnitTorus3L2 :=
  (data.product_memLp ψ).toLp
    (fun x : UnitTorus3 =>
      data.multiplier x * ψ x)

/--
The pointwise bounded-multiplier estimate becomes the exact `L²` norm
estimate

`||R ψ||₂ <= B ||ψ||₂`.

Mathlib's `Lp.norm_le_mul_norm_of_ae_le_mul` performs the final
Hilbert-space step.
-/
lemma UnitTorus3BoundedMultiplier.productState_norm_le
    {B : ℝ}
    (data : UnitTorus3BoundedMultiplier B)
    (ψ : UnitTorus3L2) :
    ‖data.productState ψ‖ ≤
      B * ‖ψ‖ := by

  have hPoint :
      ∀ᵐ x : UnitTorus3 ∂MeasureTheory.volume,
        ‖data.productState ψ x‖
          ≤
        B * ‖ψ x‖ := by

    unfold UnitTorus3BoundedMultiplier.productState

    filter_upwards [
      MeasureTheory.MemLp.coeFn_toLp
        (data.product_memLp ψ)
    ] with x hx

    rw [hx]
    rw [norm_mul]

    exact
      mul_le_mul_of_nonneg_right
        (data.norm_le x)
        (norm_nonneg _)

  exact
    MeasureTheory.Lp.norm_le_mul_norm_of_ae_le_mul
      hPoint

/--
Squared form of the bounded-multiplier estimate, matching the regular
branch interface introduced in milestone 75.
-/
lemma UnitTorus3BoundedMultiplier.productState_norm_sq_le
    {B : ℝ}
    (data : UnitTorus3BoundedMultiplier B)
    (ψ : UnitTorus3L2) :
    ‖data.productState ψ‖ ^ 2
      ≤
    B ^ 2 * ‖ψ‖ ^ 2 := by

  have hNorm :
      ‖data.productState ψ‖ ≤
        B * ‖ψ‖ :=
    data.productState_norm_le ψ

  have hRight0 :
      0 ≤ B * ‖ψ‖ :=
    mul_nonneg
      data.bound_nonneg
      (norm_nonneg _)

  have hSq :
      ‖data.productState ψ‖ ^ 2
        ≤
      (B * ‖ψ‖) ^ 2 :=
    sq_le_sq_of_nonneg
      (norm_nonneg _)
      hNorm

  calc
    ‖data.productState ψ‖ ^ 2
        ≤ (B * ‖ψ‖) ^ 2 :=
      hSq
    _ = B ^ 2 * ‖ψ‖ ^ 2 := by
      ring

/-! ## Seventy-seventh milestone: concrete inverse-radius singular multiplier -/

/--
Squared intrinsic Euclidean radius on the unit three-torus.

For each `UnitAddCircle` coordinate, its norm is the distance to the nearest
integer.  Hence this is exactly the squared Euclidean norm of the centered
representative in `[-1/2,1/2]^3`, without choosing a discontinuous
representative explicitly.
-/
noncomputable def unitTorus3RadiusSq
    (x : UnitTorus3) : ℝ :=
  ∑ i : Fin 3, ‖x i‖ ^ 2

/--
Intrinsic inverse radius on the unit three-torus.

Lean's division convention sets this to zero at the unique singular point.
That point is measure zero and therefore does not affect the `L²` Hardy
statement.
-/
noncomputable def unitTorus3InverseRadius
    (x : UnitTorus3) : ℝ :=
  1 / Real.sqrt (unitTorus3RadiusSq x)

/--
The canonical local Coulomb singularity for the Fourier normalization used
throughout this certificate.

Because Mathlib's torus Fourier modes are `exp(2*pi*i*n.x)`, the Fourier
coefficient sequence `1/|n|²` corresponds locally to the singularity

`pi / |x|`.

Thus the singular multiplier is `pi * unitTorus3InverseRadius`.
-/
noncomputable def unitTorus3CanonicalCoulombSingular
    (x : UnitTorus3) : ℂ :=
  ((Real.pi * unitTorus3InverseRadius x : ℝ) : ℂ)

/-! ## Seventy-eighth milestone: transport the singular Hardy problem to the centered cube -/

/--
The lower endpoint of the centered unit fundamental interval.
-/
def centeredCube3Base (_ : Fin 3) : ℝ :=
  -(1 / 2 : ℝ)

/--
The centered half-open fundamental cube `(-1/2,1/2]^3`.

It is written in exactly the subtype form used by Mathlib's
`UnitAddTorus.measurableEquivPiIoc`, so the measure-preserving theorem can
be used without any change-of-subtype bookkeeping.
-/
abbrev CenteredCube3 :=
  {y : Fin 3 → ℝ //
    ∀ i : Fin 3,
      y i ∈
        Set.Ioc
          (centeredCube3Base i)
          (centeredCube3Base i + 1)}

/--
Lebesgue measure restricted to the centered cube, in the exact `comap`
normalization appearing in Mathlib's torus fundamental-domain theorem.
-/
noncomputable abbrev centeredCube3Measure :
    MeasureTheory.Measure CenteredCube3 :=
  MeasureTheory.Measure.comap
    (Subtype.val : CenteredCube3 → (Fin 3 → ℝ))
    MeasureTheory.volume

/--
The `L²` space on the centered cube.
-/
noncomputable abbrev CenteredCube3L2 :=
  MeasureTheory.Lp ℂ 2 centeredCube3Measure

/--
Mathlib's measurable equivalence between the unit three-torus and the
centered cube.
-/
noncomputable def unitTorus3CenteredEquiv :
    UnitTorus3 ≃ᵐ CenteredCube3 :=
  UnitAddTorus.measurableEquivPiIoc
    centeredCube3Base

/--
The centered fundamental-domain equivalence is measure preserving.
-/
lemma unitTorus3CenteredEquiv_measurePreserving :
    MeasureTheory.MeasurePreserving
      (unitTorus3CenteredEquiv : UnitTorus3 → CenteredCube3)
      MeasureTheory.volume
      centeredCube3Measure := by
  exact
    UnitAddTorus.measurePreserving_equivPiIoc
      centeredCube3Base

/--
The centered real representative of a point of `R/Z`, chosen in
`(-1/2,1/2]`.
-/
noncomputable def unitAddCircleCenteredCoord
    (x : UnitAddCircle) : ℝ :=
  ↑((AddCircle.equivIoc
        (1 : ℝ)
        (-(1 / 2 : ℝ))) x)

/--
The quotient norm on `R/Z` is the absolute value of the centered
representative.
-/
lemma unitAddCircle_norm_eq_abs_centeredCoord
    (x : UnitAddCircle) :
    ‖x‖ = |unitAddCircleCenteredCoord x| := by

  let y :=
    (AddCircle.equivIoc
      (1 : ℝ)
      (-(1 / 2 : ℝ))) x

  have hy :
      (y : ℝ) ∈
        Set.Ioc (-(1 / 2 : ℝ)) (-(1 / 2 : ℝ) + 1) :=
    y.property

  have habs :
      |(y : ℝ)| ≤ |(1 : ℝ)| / 2 := by
    norm_num
    exact
      (abs_le).2
        ⟨le_of_lt hy.1, by
          linarith [hy.2]⟩

  have hnorm :
      ‖((y : ℝ) : UnitAddCircle)‖ =
        |(y : ℝ)| :=
    (AddCircle.norm_coe_eq_abs_iff
      (1 : ℝ) (by norm_num)).2 habs

  have hcoe :
      ((y : ℝ) : UnitAddCircle) = x := by
    dsimp [y]
    exact AddCircle.coe_equivIoc

  change ‖x‖ = |(y : ℝ)|
  rw [← hcoe]
  exact hnorm

/--
The coordinate of the centered-cube measurable equivalence is exactly the
one-dimensional centered representative.
-/
lemma unitTorus3CenteredEquiv_apply_coord
    (x : UnitTorus3)
    (i : Fin 3) :
    (unitTorus3CenteredEquiv x).1 i =
      unitAddCircleCenteredCoord (x i) := by
  simp [
    unitTorus3CenteredEquiv,
    centeredCube3Base,
    unitAddCircleCenteredCoord
  ]
  rfl

/--
Squared Euclidean radius in the centered cube.
-/
noncomputable def centeredCube3RadiusSq
    (y : CenteredCube3) : ℝ :=
  ∑ i : Fin 3, (y.1 i) ^ 2

lemma centeredCube3RadiusSq_nonneg
    (y : CenteredCube3) :
    0 ≤ centeredCube3RadiusSq y := by
  unfold centeredCube3RadiusSq
  exact
    Finset.sum_nonneg
      (fun i hi => sq_nonneg (y.1 i))

/--
The intrinsic torus radius from milestone 77 is exactly the Euclidean
radius of the centered fundamental-domain representative.
-/
lemma centeredCube3RadiusSq_centeredEquiv
    (x : UnitTorus3) :
    centeredCube3RadiusSq
        (unitTorus3CenteredEquiv x)
      =
    unitTorus3RadiusSq x := by

  unfold centeredCube3RadiusSq
  unfold unitTorus3RadiusSq

  apply Finset.sum_congr rfl
  intro i hi

  rw [unitTorus3CenteredEquiv_apply_coord]

  have hnorm :=
    unitAddCircle_norm_eq_abs_centeredCoord
      (x i)

  calc
    (unitAddCircleCenteredCoord (x i)) ^ 2
        =
      |unitAddCircleCenteredCoord (x i)| ^ 2 := by
        exact
          (sq_abs
            (unitAddCircleCenteredCoord (x i))).symm
    _ = ‖x i‖ ^ 2 := by
      rw [← hnorm]

/--
Inverse Euclidean radius on the centered cube.
-/
noncomputable def centeredCube3InverseRadius
    (y : CenteredCube3) : ℝ :=
  1 / Real.sqrt (centeredCube3RadiusSq y)

/--
The inverse radius is preserved exactly by the centered fundamental-domain
equivalence.
-/
lemma centeredCube3InverseRadius_centeredEquiv
    (x : UnitTorus3) :
    centeredCube3InverseRadius
        (unitTorus3CenteredEquiv x)
      =
    unitTorus3InverseRadius x := by
  unfold centeredCube3InverseRadius
  unfold unitTorus3InverseRadius
  rw [centeredCube3RadiusSq_centeredEquiv]

/--
Transport an `L²` state on the centered cube back to the torus using the
measure-preserving fundamental-domain equivalence.
-/
noncomputable def centeredCube3StateToTorus
    (u : CenteredCube3L2) :
    UnitTorus3L2 :=
  (MeasureTheory.Lp.compMeasurePreserving
    (unitTorus3CenteredEquiv :
      UnitTorus3 → CenteredCube3)
    unitTorus3CenteredEquiv_measurePreserving) u

/--
Transport through the centered fundamental-domain equivalence preserves
the `L²` norm exactly.
-/
lemma centeredCube3StateToTorus_norm
    (u : CenteredCube3L2) :
    ‖centeredCube3StateToTorus u‖ = ‖u‖ := by
  unfold centeredCube3StateToTorus
  exact
    MeasureTheory.Lp.norm_compMeasurePreserving
      u
      unitTorus3CenteredEquiv_measurePreserving

/-! ## Seventy-ninth milestone: correct the singular Hardy interface to H¹ -/

/--
Correct centered-cube inverse-radius Hardy data.

The gradient-only interface introduced in milestones 77--78 is too strong
for periodic functions: a nonzero constant Fourier mode has zero gradient
but nonzero `L²` norm after multiplication by `1/r`.

The correct bounded-domain estimate is

`||ψ/r||₂² <= C² (||ψ||₂² + gradientSq ψ)`.
-/
structure CenteredCube3InverseRadiusH1Data
    (C : ℝ) where
  productState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → CenteredCube3L2
  product_eq_ae :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
            productState α index f y
              =
            (centeredCube3InverseRadius y : ℂ) *
              torus3FourierPolynomial index f
                (unitTorus3CenteredEquiv.symm y)
  norm_sq_le_h1 :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖productState α index f‖ ^ 2
            ≤
          C ^ 2 *
            (‖torus3FourierPolynomial index f‖ ^ 2 +
              torus3FourierGradientSq
                (torus3FourierPolynomial index f))

/--
Transport the corrected centered-cube inverse-radius state to the torus
and restore the exact Coulomb normalization `pi/r`.
-/
noncomputable def
    CenteredCube3InverseRadiusH1Data.coulombSingularState
    {C : ℝ}
    (data : CenteredCube3InverseRadiusH1Data C)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    UnitTorus3L2 :=
  (Real.pi : ℂ) •
    centeredCube3StateToTorus
      (data.productState α index f)

/--
The corrected singular Coulomb state satisfies the genuine `H¹ -> L²`
estimate with coefficient `pi² C²`.
-/
lemma CenteredCube3InverseRadiusH1Data.coulombSingularState_norm_sq_le_h1
    {C : ℝ}
    (data : CenteredCube3InverseRadiusH1Data C)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ) :
    ‖data.coulombSingularState index f‖ ^ 2
      ≤
    (Real.pi ^ 2 * C ^ 2) *
      (‖torus3FourierPolynomial index f‖ ^ 2 +
        torus3FourierGradientSq
          (torus3FourierPolynomial index f)) := by

  let u : CenteredCube3L2 :=
    data.productState α index f

  let Q : ℝ :=
    ‖torus3FourierPolynomial index f‖ ^ 2 +
      torus3FourierGradientSq
        (torus3FourierPolynomial index f)

  have hBase :
      ‖u‖ ^ 2 ≤ C ^ 2 * Q := by
    dsimp [u, Q]
    exact data.norm_sq_le_h1 α index hInjective f

  have hPiNorm :
      ‖(Real.pi : ℂ)‖ = Real.pi := by
    simp only [Complex.norm_real, Real.norm_eq_abs]
    exact abs_of_pos Real.pi_pos

  have hPiSq0 :
      0 ≤ Real.pi ^ 2 :=
    sq_nonneg _

  unfold CenteredCube3InverseRadiusH1Data.coulombSingularState
  rw [norm_smul, hPiNorm]
  rw [centeredCube3StateToTorus_norm]

  calc
    (Real.pi * ‖u‖) ^ 2
        =
      Real.pi ^ 2 * ‖u‖ ^ 2 := by
        ring
    _ ≤
      Real.pi ^ 2 * (C ^ 2 * Q) :=
      mul_le_mul_of_nonneg_left hBase hPiSq0
    _ =
      (Real.pi ^ 2 * C ^ 2) * Q := by
      ring

/--
Correct singular-plus-regular decomposition for the canonical periodic
Coulomb potential.

Unlike milestones 75--78, the singular branch is controlled by the full
`H¹` norm, not by the gradient seminorm alone.
-/
structure CanonicalPeriodicCoulombCenteredCubeH1Split
    (C B : ℝ) where
  singular :
    CenteredCube3InverseRadiusH1Data C
  regular :
    UnitTorus3BoundedMultiplier B
  product_eq :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          (UnitTorus3CoulombPotentialL2Realization.toPotentialRealization
              canonicalUnitTorus3CoulombPotential).productState
              index f
            =
          singular.coulombSingularState index f +
            regular.productState
              (torus3FourierPolynomial index f)

/--
The corrected singular `H¹` estimate together with the bounded regular
multiplier estimate implies the canonical periodic Coulomb `H¹ -> L²`
bound.

A sufficient combined scale condition is

`2 * (pi² C² + B²) <= H²`.
-/
lemma hasCanonicalPeriodicCoulombHardyBound_of_centeredCubeH1Split
    {C B H : ℝ}
    (data : CanonicalPeriodicCoulombCenteredCubeH1Split C B)
    (hScale :
      2 * (Real.pi ^ 2 * C ^ 2 + B ^ 2) ≤ H ^ 2) :
    HasCanonicalPeriodicCoulombHardyBound H := by

  unfold HasCanonicalPeriodicCoulombHardyBound
  unfold HasUnitTorus3CoulombL2PotentialH1L2Bound
  unfold HasUnitTorus3CoulombPotentialH1L2Bound

  intro α inst index hInjective f

  let ψ : UnitTorus3L2 :=
    torus3FourierPolynomial index f

  let singular : UnitTorus3L2 :=
    data.singular.coulombSingularState index f

  let regular : UnitTorus3L2 :=
    data.regular.productState ψ

  let Q : ℝ :=
    ‖ψ‖ ^ 2 + torus3FourierGradientSq ψ

  have hGrad0 :
      0 ≤ torus3FourierGradientSq ψ :=
    torus3FourierGradientSq_nonneg ψ

  have hQ0 :
      0 ≤ Q := by
    dsimp [Q]
    exact add_nonneg (sq_nonneg _) hGrad0

  have hSingular :
      ‖singular‖ ^ 2
        ≤
      (Real.pi ^ 2 * C ^ 2) * Q := by
    dsimp [singular, Q, ψ]
    exact
      data.singular.coulombSingularState_norm_sq_le_h1
        index hInjective f

  have hRegularL2 :
      ‖regular‖ ^ 2
        ≤
      B ^ 2 * ‖ψ‖ ^ 2 := by
    dsimp [regular]
    exact data.regular.productState_norm_sq_le ψ

  have hNormPart :
      ‖ψ‖ ^ 2 ≤ Q := by
    dsimp [Q]
    exact le_add_of_nonneg_right hGrad0

  have hRegular :
      ‖regular‖ ^ 2
        ≤
      B ^ 2 * Q :=
    le_trans hRegularL2
      (mul_le_mul_of_nonneg_left
        hNormPart (sq_nonneg B))

  have hSum :
      ‖singular‖ ^ 2 + ‖regular‖ ^ 2
        ≤
      (Real.pi ^ 2 * C ^ 2 + B ^ 2) * Q := by
    calc
      ‖singular‖ ^ 2 + ‖regular‖ ^ 2
          ≤
        (Real.pi ^ 2 * C ^ 2) * Q + B ^ 2 * Q :=
        add_le_add hSingular hRegular
      _ =
        (Real.pi ^ 2 * C ^ 2 + B ^ 2) * Q := by
        ring

  have hTwice :
      2 * (‖singular‖ ^ 2 + ‖regular‖ ^ 2)
        ≤
      2 * ((Real.pi ^ 2 * C ^ 2 + B ^ 2) * Q) :=
    mul_le_mul_of_nonneg_left hSum (by norm_num)

  have hScaleQ :
      2 * (Real.pi ^ 2 * C ^ 2 + B ^ 2) * Q
        ≤
      H ^ 2 * Q :=
    mul_le_mul_of_nonneg_right hScale hQ0

  have hDecomp :
      (UnitTorus3CoulombPotentialL2Realization.toPotentialRealization
          canonicalUnitTorus3CoulombPotential).productState
          index f
        =
      singular + regular := by
    dsimp [singular, regular, ψ]
    exact data.product_eq α index f

  rw [hDecomp]

  calc
    ‖singular + regular‖ ^ 2
        ≤
      2 * (‖singular‖ ^ 2 + ‖regular‖ ^ 2) :=
      norm_add_sq_le_two_mul_sq_add_sq singular regular
    _ ≤
      2 * ((Real.pi ^ 2 * C ^ 2 + B ^ 2) * Q) :=
      hTwice
    _ =
      2 * (Real.pi ^ 2 * C ^ 2 + B ^ 2) * Q := by
      ring
    _ ≤
      H ^ 2 * Q :=
      hScaleQ

/-! ## Eightieth milestone: cutoff decomposition of the corrected cube Hardy bound -/

/--
Elementary square-norm estimate on the centered-cube `L²` space:

`||x+y||² <= 2 (||x||² + ||y||²)`.

The analogous torus statement was proved in milestone 75; this version is
kept separate because the two `Lp` spaces are definitionally different.
-/
lemma centeredCube3_norm_add_sq_le_two_mul_sq_add_sq
    (x y : CenteredCube3L2) :
    ‖x + y‖ ^ 2 ≤
      2 * (‖x‖ ^ 2 + ‖y‖ ^ 2) := by

  have hNorm :
      ‖x + y‖ ≤ ‖x‖ + ‖y‖ :=
    norm_add_le x y

  have hSq :
      ‖x + y‖ ^ 2 ≤
        (‖x‖ + ‖y‖) ^ 2 :=
    sq_le_sq_of_nonneg
      (norm_nonneg _)
      hNorm

  have hAlg :
      (‖x‖ + ‖y‖) ^ 2 ≤
        2 * (‖x‖ ^ 2 + ‖y‖ ^ 2) := by
    nlinarith [sq_nonneg (‖x‖ - ‖y‖)]

  exact le_trans hSq hAlg

/--
Cutoff decomposition of the centered-cube inverse-radius product.

`innerState` is the part supported near the Coulomb singularity and is
intended to be controlled by the local three-dimensional Hardy
inequality after multiplying by a smooth cutoff.

`outerState` is the complementary part, where `1/r` is bounded.  Its
estimate is therefore only an `L² -> L²` bound.

The exact cutoff function is deliberately not yet fixed here.  This
milestone isolates the norm bookkeeping from the forthcoming pointwise
construction of a radial cutoff.
-/
structure CenteredCube3InverseRadiusCutoffData
    (Ainner Douter : ℝ) where
  innerState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → CenteredCube3L2
  outerState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → CenteredCube3L2
  productState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → CenteredCube3L2
  product_eq :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          productState α index f =
            innerState α index f +
              outerState α index f
  product_eq_ae :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
            productState α index f y
              =
            (centeredCube3InverseRadius y : ℂ) *
              torus3FourierPolynomial index f
                (unitTorus3CenteredEquiv.symm y)
  inner_norm_sq_le_h1 :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖innerState α index f‖ ^ 2
            ≤
          Ainner ^ 2 *
            (‖torus3FourierPolynomial index f‖ ^ 2 +
              torus3FourierGradientSq
                (torus3FourierPolynomial index f))
  outer_norm_sq_le_l2 :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖outerState α index f‖ ^ 2
            ≤
          Douter ^ 2 *
            ‖torus3FourierPolynomial index f‖ ^ 2

/--
The cutoff decomposition implies the corrected centered-cube `H¹`
inverse-radius estimate.

The sufficient scale condition

`2 * (Ainner² + Douter²) <= C²`

contains only the factor two from `||inner+outer||²`.
-/
noncomputable def
    CenteredCube3InverseRadiusCutoffData.toInverseRadiusH1Data
    {Ainner Douter C : ℝ}
    (data :
      CenteredCube3InverseRadiusCutoffData
        Ainner Douter)
    (hScale :
      2 * (Ainner ^ 2 + Douter ^ 2) ≤ C ^ 2) :
    CenteredCube3InverseRadiusH1Data C where

  productState :=
    data.productState

  product_eq_ae :=
    data.product_eq_ae

  norm_sq_le_h1 := by
    intro α inst index hInjective f

    let ψ : UnitTorus3L2 :=
      torus3FourierPolynomial index f

    let inner : CenteredCube3L2 :=
      data.innerState α index f

    let outer : CenteredCube3L2 :=
      data.outerState α index f

    let product : CenteredCube3L2 :=
      data.productState α index f

    let Q : ℝ :=
      ‖ψ‖ ^ 2 +
        torus3FourierGradientSq ψ

    have hGrad0 :
        0 ≤ torus3FourierGradientSq ψ :=
      torus3FourierGradientSq_nonneg ψ

    have hQ0 :
        0 ≤ Q := by
      dsimp [Q]
      exact add_nonneg (sq_nonneg _) hGrad0

    have hInner :
        ‖inner‖ ^ 2 ≤
          Ainner ^ 2 * Q := by
      dsimp [inner, Q, ψ]
      exact
        data.inner_norm_sq_le_h1
          α index hInjective f

    have hOuterL2 :
        ‖outer‖ ^ 2 ≤
          Douter ^ 2 * ‖ψ‖ ^ 2 := by
      dsimp [outer, ψ]
      exact
        data.outer_norm_sq_le_l2
          α index hInjective f

    have hNormPart :
        ‖ψ‖ ^ 2 ≤ Q := by
      dsimp [Q]
      exact le_add_of_nonneg_right hGrad0

    have hOuter :
        ‖outer‖ ^ 2 ≤
          Douter ^ 2 * Q :=
      le_trans hOuterL2
        (mul_le_mul_of_nonneg_left
          hNormPart (sq_nonneg Douter))

    have hSum :
        ‖inner‖ ^ 2 + ‖outer‖ ^ 2
          ≤
        (Ainner ^ 2 + Douter ^ 2) * Q := by
      calc
        ‖inner‖ ^ 2 + ‖outer‖ ^ 2
            ≤
          Ainner ^ 2 * Q +
            Douter ^ 2 * Q :=
          add_le_add hInner hOuter
        _ =
          (Ainner ^ 2 + Douter ^ 2) * Q := by
          ring

    have hTwice :
        2 * (‖inner‖ ^ 2 + ‖outer‖ ^ 2)
          ≤
        2 * ((Ainner ^ 2 + Douter ^ 2) * Q) :=
      mul_le_mul_of_nonneg_left hSum (by norm_num)

    have hScaleQ :
        2 * (Ainner ^ 2 + Douter ^ 2) * Q
          ≤
        C ^ 2 * Q :=
      mul_le_mul_of_nonneg_right
        hScale hQ0

    have hProduct :
        product = inner + outer := by
      dsimp [product, inner, outer]
      exact data.product_eq α index f

    change ‖product‖ ^ 2 ≤ C ^ 2 * Q
    rw [hProduct]

    calc
      ‖inner + outer‖ ^ 2
          ≤
        2 * (‖inner‖ ^ 2 + ‖outer‖ ^ 2) :=
        centeredCube3_norm_add_sq_le_two_mul_sq_add_sq
          inner outer
      _ ≤
        2 * ((Ainner ^ 2 + Douter ^ 2) * Q) :=
        hTwice
      _ =
        2 * (Ainner ^ 2 + Douter ^ 2) * Q := by
        ring
      _ ≤
        C ^ 2 * Q :=
        hScaleQ

/--
The Coulomb-normalized singular state associated directly with a cutoff
decomposition.
-/
noncomputable def
    CenteredCube3InverseRadiusCutoffData.coulombSingularState
    {Ainner Douter : ℝ}
    (data :
      CenteredCube3InverseRadiusCutoffData
        Ainner Douter)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    UnitTorus3L2 :=
  (Real.pi : ℂ) •
    centeredCube3StateToTorus
      (data.productState α index f)

/-! ## Eighty-first milestone: explicit outer inverse-radius cutoff branch -/

/--
The inverse centered fundamental-domain equivalence is also measure
preserving.
-/
lemma unitTorus3CenteredEquiv_symm_measurePreserving :
    MeasureTheory.MeasurePreserving
      (unitTorus3CenteredEquiv.symm :
        CenteredCube3 → UnitTorus3)
      centeredCube3Measure
      MeasureTheory.volume := by
  exact
    MeasureTheory.MeasurePreserving.symm
      unitTorus3CenteredEquiv
      unitTorus3CenteredEquiv_measurePreserving

/--
Transport a torus `L²` state to the centered cube by the inverse
measure-preserving fundamental-domain equivalence.
-/
noncomputable def centeredCube3StateFromTorus
    (ψ : UnitTorus3L2) :
    CenteredCube3L2 :=
  (MeasureTheory.Lp.compMeasurePreserving
    (unitTorus3CenteredEquiv.symm :
      CenteredCube3 → UnitTorus3)
    unitTorus3CenteredEquiv_symm_measurePreserving) ψ

/--
The torus-to-cube transport preserves the `L²` norm exactly.
-/
lemma centeredCube3StateFromTorus_norm
    (ψ : UnitTorus3L2) :
    ‖centeredCube3StateFromTorus ψ‖ = ‖ψ‖ := by
  unfold centeredCube3StateFromTorus
  exact
    MeasureTheory.Lp.norm_compMeasurePreserving
      ψ
      unitTorus3CenteredEquiv_symm_measurePreserving

/--
The representative of the transported state is composition with the
inverse centered fundamental-domain equivalence almost everywhere.
-/
lemma centeredCube3StateFromTorus_eq_ae
    (ψ : UnitTorus3L2) :
    ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
      centeredCube3StateFromTorus ψ y
        =
      ψ (unitTorus3CenteredEquiv.symm y) := by

  unfold centeredCube3StateFromTorus

  have hCompRaw :=
    MeasureTheory.Lp.coeFn_compMeasurePreserving
      ψ
      unitTorus3CenteredEquiv_symm_measurePreserving

  filter_upwards [hCompRaw] with y hy
  simpa only [Function.comp_apply] using hy

/--
A bounded measurable multiplier on the centered cube.
-/
structure CenteredCube3BoundedMultiplier (B : ℝ) where
  multiplier : CenteredCube3 → ℂ
  multiplier_aestronglyMeasurable :
    MeasureTheory.AEStronglyMeasurable
      multiplier centeredCube3Measure
  bound_nonneg : 0 ≤ B
  norm_le :
    ∀ y : CenteredCube3,
      ‖multiplier y‖ ≤ B

/--
Multiplication by a bounded measurable centered-cube function preserves
`L²`.
-/
lemma CenteredCube3BoundedMultiplier.product_memLp
    {B : ℝ}
    (data : CenteredCube3BoundedMultiplier B)
    (ψ : CenteredCube3L2) :
    MeasureTheory.MemLp
      (fun y : CenteredCube3 =>
        data.multiplier y * ψ y)
      2 centeredCube3Measure := by

  have hProductMeas :
      MeasureTheory.AEStronglyMeasurable
        (fun y : CenteredCube3 =>
          data.multiplier y * ψ y)
        centeredCube3Measure :=
    data.multiplier_aestronglyMeasurable.fun_mul
      (MeasureTheory.Lp.aestronglyMeasurable ψ)

  have hScaled :
      MeasureTheory.MemLp
        (fun y : CenteredCube3 =>
          (B : ℂ) * ψ y)
        2 centeredCube3Measure := by
    exact
      (MeasureTheory.Lp.memLp ψ).const_mul
        (B : ℂ)

  refine hScaled.of_le hProductMeas ?_

  filter_upwards [] with y

  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  rw [abs_of_nonneg data.bound_nonneg]

  exact
    mul_le_mul_of_nonneg_right
      (data.norm_le y)
      (norm_nonneg _)

/--
The `L²` product state of a bounded centered-cube multiplier.
-/
noncomputable def CenteredCube3BoundedMultiplier.productState
    {B : ℝ}
    (data : CenteredCube3BoundedMultiplier B)
    (ψ : CenteredCube3L2) :
    CenteredCube3L2 :=
  (data.product_memLp ψ).toLp
    (fun y : CenteredCube3 =>
      data.multiplier y * ψ y)

/--
The product-state representative is actual pointwise multiplication
almost everywhere.
-/
lemma CenteredCube3BoundedMultiplier.productState_eq_ae
    {B : ℝ}
    (data : CenteredCube3BoundedMultiplier B)
    (ψ : CenteredCube3L2) :
    ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
      data.productState ψ y =
        data.multiplier y * ψ y := by
  unfold CenteredCube3BoundedMultiplier.productState
  exact
    MeasureTheory.MemLp.coeFn_toLp
      (data.product_memLp ψ)

/--
The bounded centered-cube multiplier satisfies
`||m ψ||₂ <= B ||ψ||₂`.
-/
lemma CenteredCube3BoundedMultiplier.productState_norm_le
    {B : ℝ}
    (data : CenteredCube3BoundedMultiplier B)
    (ψ : CenteredCube3L2) :
    ‖data.productState ψ‖ ≤ B * ‖ψ‖ := by

  have hPoint :
      ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
        ‖data.productState ψ y‖
          ≤
        B * ‖ψ y‖ := by

    unfold CenteredCube3BoundedMultiplier.productState

    filter_upwards [
      MeasureTheory.MemLp.coeFn_toLp
        (data.product_memLp ψ)
    ] with y hy

    rw [hy]
    rw [norm_mul]

    exact
      mul_le_mul_of_nonneg_right
        (data.norm_le y)
        (norm_nonneg _)

  exact
    MeasureTheory.Lp.norm_le_mul_norm_of_ae_le_mul
      hPoint

/--
Squared form of the centered-cube bounded-multiplier estimate.
-/
lemma CenteredCube3BoundedMultiplier.productState_norm_sq_le
    {B : ℝ}
    (data : CenteredCube3BoundedMultiplier B)
    (ψ : CenteredCube3L2) :
    ‖data.productState ψ‖ ^ 2
      ≤
    B ^ 2 * ‖ψ‖ ^ 2 := by

  have hNorm :
      ‖data.productState ψ‖ ≤ B * ‖ψ‖ :=
    data.productState_norm_le ψ

  have hRight0 :
      0 ≤ B * ‖ψ‖ :=
    mul_nonneg
      data.bound_nonneg
      (norm_nonneg _)

  have hSq :
      ‖data.productState ψ‖ ^ 2
        ≤
      (B * ‖ψ‖) ^ 2 :=
    sq_le_sq_of_nonneg
      (norm_nonneg _)
      hNorm

  calc
    ‖data.productState ψ‖ ^ 2
        ≤
      (B * ‖ψ‖) ^ 2 :=
      hSq
    _ =
      B ^ 2 * ‖ψ‖ ^ 2 := by
      ring

/--
Euclidean radius on the centered cube.
-/
noncomputable def centeredCube3Radius
    (y : CenteredCube3) : ℝ :=
  Real.sqrt (centeredCube3RadiusSq y)

lemma centeredCube3Radius_nonneg
    (y : CenteredCube3) :
    0 ≤ centeredCube3Radius y := by
  unfold centeredCube3Radius
  exact Real.sqrt_nonneg _

/--
The previously defined inverse radius is literally `1 / radius`.
-/
lemma centeredCube3InverseRadius_eq_one_div_radius
    (y : CenteredCube3) :
    centeredCube3InverseRadius y =
      1 / centeredCube3Radius y := by
  rfl

/--
The squared-radius function is measurable on the centered cube.
-/
lemma centeredCube3RadiusSq_measurable :
    Measurable centeredCube3RadiusSq := by
  unfold centeredCube3RadiusSq
  refine Finset.measurable_sum Finset.univ ?_
  intro i hi
  have hcoord :
      Measurable (fun y : CenteredCube3 => y.1 i) :=
    (measurable_pi_apply i).comp measurable_subtype_coe
  exact hcoord.pow_const 2

/--
The centered-cube radius is measurable.
-/
lemma centeredCube3Radius_measurable :
    Measurable centeredCube3Radius := by
  unfold centeredCube3Radius
  exact
    Real.continuous_sqrt.measurable.comp
      centeredCube3RadiusSq_measurable

/--
The centered-cube inverse radius is measurable.
-/
lemma centeredCube3InverseRadius_measurable :
    Measurable centeredCube3InverseRadius := by
  change Measurable
    (fun y : CenteredCube3 => 1 / centeredCube3Radius y)
  exact centeredCube3Radius_measurable.const_div 1

/--
Hard outer radial mask for the inverse-radius multiplier:

`1/r` on `rho <= r`, and zero on `r < rho`.
-/
noncomputable def centeredCube3OuterInverseRadius
    (rho : ℝ)
    (y : CenteredCube3) : ℂ :=
  if rho ≤ centeredCube3Radius y then
    (centeredCube3InverseRadius y : ℂ)
  else
    0

/--
The hard outer inverse-radius mask is measurable.
-/
lemma centeredCube3OuterInverseRadius_aestronglyMeasurable
    (rho : ℝ) :
    MeasureTheory.AEStronglyMeasurable
      (centeredCube3OuterInverseRadius rho)
      centeredCube3Measure := by

  have hMeas :
      Measurable
        (centeredCube3OuterInverseRadius rho) := by
    unfold centeredCube3OuterInverseRadius

    have hSet :
        MeasurableSet
          {y : CenteredCube3 |
            rho ≤ centeredCube3Radius y} :=
      measurableSet_Ici.preimage
        centeredCube3Radius_measurable

    have hInv :
        Measurable
          (fun y : CenteredCube3 =>
            (centeredCube3InverseRadius y : ℂ)) :=
      centeredCube3InverseRadius_measurable.complex_ofReal

    exact Measurable.ite hSet hInv measurable_const

  exact hMeas.aestronglyMeasurable

/--
On the outer region `rho <= r`, the inverse radius is pointwise bounded
by `1/rho`.
-/
lemma centeredCube3OuterInverseRadius_norm_le
    {rho : ℝ}
    (hrho : 0 < rho)
    (y : CenteredCube3) :
    ‖centeredCube3OuterInverseRadius rho y‖
      ≤
    1 / rho := by

  unfold centeredCube3OuterInverseRadius

  by_cases h :
      rho ≤ centeredCube3Radius y

  · simp only [
      if_pos h,
      Complex.norm_real,
      Real.norm_eq_abs
    ]

    have hRadiusPos :
        0 < centeredCube3Radius y :=
      lt_of_lt_of_le hrho h

    have hInvNonneg :
        0 ≤ centeredCube3InverseRadius y := by
      rw [centeredCube3InverseRadius_eq_one_div_radius]
      exact
        one_div_nonneg.mpr
          (le_of_lt hRadiusPos)

    rw [abs_of_nonneg hInvNonneg]
    rw [centeredCube3InverseRadius_eq_one_div_radius]

    exact
      one_div_le_one_div_of_le
        hrho h

  · simp only [if_neg h, norm_zero]

    exact
      le_of_lt
        (one_div_pos.mpr hrho)

/--
The explicit outer inverse-radius multiplier with its sharp elementary
bound `1/rho`.
-/
noncomputable def centeredCube3OuterInverseRadiusMultiplier
    (rho : ℝ)
    (hrho : 0 < rho) :
    CenteredCube3BoundedMultiplier (1 / rho) where

  multiplier :=
    centeredCube3OuterInverseRadius rho

  multiplier_aestronglyMeasurable :=
    centeredCube3OuterInverseRadius_aestronglyMeasurable
      rho

  bound_nonneg :=
    le_of_lt (one_div_pos.mpr hrho)

  norm_le :=
    centeredCube3OuterInverseRadius_norm_le
      hrho

/--
The explicit outer inverse-radius `L²` state for a finite Fourier
polynomial.
-/
noncomputable def centeredCube3OuterInverseRadiusState
    (rho : ℝ)
    (hrho : 0 < rho)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    CenteredCube3L2 :=
  (centeredCube3OuterInverseRadiusMultiplier
      rho hrho).productState
    (centeredCube3StateFromTorus
      (torus3FourierPolynomial index f))

/--
The explicit outer state is pointwise the hard outer inverse-radius mask
times the pulled-back Fourier polynomial, almost everywhere.
-/
lemma centeredCube3OuterInverseRadiusState_eq_ae
    (rho : ℝ)
    (hrho : 0 < rho)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
      centeredCube3OuterInverseRadiusState
          rho hrho index f y
        =
      centeredCube3OuterInverseRadius rho y *
        torus3FourierPolynomial index f
          (unitTorus3CenteredEquiv.symm y) := by

  unfold centeredCube3OuterInverseRadiusState

  filter_upwards [
    (centeredCube3OuterInverseRadiusMultiplier
      rho hrho).productState_eq_ae
        (centeredCube3StateFromTorus
          (torus3FourierPolynomial index f)),
    centeredCube3StateFromTorus_eq_ae
      (torus3FourierPolynomial index f)
  ] with y hProduct hPull

  rw [hProduct]
  rw [hPull]

  rfl

/--
The outer branch requires no analytic hypothesis:

`||outer||₂² <= (1/rho)² ||psi||₂²`.
-/
lemma centeredCube3OuterInverseRadiusState_norm_sq_le
    (rho : ℝ)
    (hrho : 0 < rho)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    ‖centeredCube3OuterInverseRadiusState
        rho hrho index f‖ ^ 2
      ≤
    (1 / rho) ^ 2 *
      ‖torus3FourierPolynomial index f‖ ^ 2 := by

  unfold centeredCube3OuterInverseRadiusState

  have hBound :=
    (centeredCube3OuterInverseRadiusMultiplier
      rho hrho).productState_norm_sq_le
        (centeredCube3StateFromTorus
          (torus3FourierPolynomial index f))

  rw [centeredCube3StateFromTorus_norm] at hBound

  exact hBound

/--
The only remaining near-origin input after the outer branch is made
explicit.

`innerState` is exactly the hard inner mask

`1_{r < rho} * psi/r`

almost everywhere, and its `H¹` bound is the local Hardy input that
remains to be proved.
-/
structure CenteredCube3InnerRadiusHardyData
    (rho Ainner : ℝ) where

  innerState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → CenteredCube3L2

  inner_eq_ae :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
            innerState α index f y
              =
            if centeredCube3Radius y < rho then
              (centeredCube3InverseRadius y : ℂ) *
                torus3FourierPolynomial index f
                  (unitTorus3CenteredEquiv.symm y)
            else
              0

  inner_norm_sq_le_h1 :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖innerState α index f‖ ^ 2
            ≤
          Ainner ^ 2 *
            (‖torus3FourierPolynomial index f‖ ^ 2 +
              torus3FourierGradientSq
                (torus3FourierPolynomial index f))

/--
Full centered-cube inverse-radius state assembled from the abstract inner
Hardy state and the now-explicit outer state.
-/
noncomputable def
    CenteredCube3InnerRadiusHardyData.fullState
    {rho Ainner : ℝ}
    (data :
      CenteredCube3InnerRadiusHardyData
        rho Ainner)
    (hrho : 0 < rho)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    CenteredCube3L2 :=
  data.innerState α index f +
    centeredCube3OuterInverseRadiusState
      rho hrho index f

/--
The hard inner and outer masks reconstruct the full inverse-radius product
almost everywhere.
-/
lemma CenteredCube3InnerRadiusHardyData.fullState_eq_ae
    {rho Ainner : ℝ}
    (data :
      CenteredCube3InnerRadiusHardyData
        rho Ainner)
    (hrho : 0 < rho)
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
      data.fullState hrho index f y
        =
      (centeredCube3InverseRadius y : ℂ) *
        torus3FourierPolynomial index f
          (unitTorus3CenteredEquiv.symm y) := by

  unfold CenteredCube3InnerRadiusHardyData.fullState

  filter_upwards [
    MeasureTheory.Lp.coeFn_add
      (data.innerState α index f)
      (centeredCube3OuterInverseRadiusState
        rho hrho index f),
    data.inner_eq_ae α index f,
    centeredCube3OuterInverseRadiusState_eq_ae
      rho hrho index f
  ] with y hAdd hInner hOuter

  rw [hAdd]
  simp only [Pi.add_apply]
  rw [hInner]
  rw [hOuter]

  unfold centeredCube3OuterInverseRadius

  by_cases h :
      centeredCube3Radius y < rho

  · have hNot :
        ¬ rho ≤ centeredCube3Radius y :=
      not_le.mpr h

    simp only [
      if_pos h,
      if_neg hNot,
      zero_mul,
      add_zero
    ]

  · have hLe :
        rho ≤ centeredCube3Radius y :=
      le_of_not_gt h

    simp only [
      if_neg h,
      if_pos hLe,
      zero_add
    ]

/--
The abstract-inner / explicit-outer construction is exactly the cutoff
data required by milestone 80, with

`Douter = 1/rho`.
-/
noncomputable def
    CenteredCube3InnerRadiusHardyData.toCutoffData
    {rho Ainner : ℝ}
    (data :
      CenteredCube3InnerRadiusHardyData
        rho Ainner)
    (hrho : 0 < rho) :
    CenteredCube3InverseRadiusCutoffData
      Ainner (1 / rho) where

  innerState :=
    data.innerState

  outerState :=
    fun α _ index f =>
      centeredCube3OuterInverseRadiusState
        rho hrho index f

  productState :=
    fun α _ index f =>
      data.fullState hrho index f

  product_eq := by
    intro α inst index f
    rfl

  product_eq_ae := by
    intro α inst index f
    exact
      data.fullState_eq_ae
        hrho index f

  inner_norm_sq_le_h1 :=
    data.inner_norm_sq_le_h1

  outer_norm_sq_le_l2 := by
    intro α inst index hInjective f
    exact
      centeredCube3OuterInverseRadiusState_norm_sq_le
        rho hrho index f

/-! ## Eighty-second milestone: reduce the hard inner mask to a localized radial Hardy state -/

/--
An explicit radial cutoff on the centered cube.

It is `1` on the closed ball `r <= rho`, vanishes on `R <= r`, and is
linear in the radius on the annulus `rho < r < R`.  For `0 < rho < R < 1/2`
its support lies strictly inside the centered fundamental cube, so its
zero extension to `R^3` is the standard compactly supported function to
which the Euclidean Hardy inequality is applied.
-/
noncomputable def centeredCube3RadialCutoff
    (rho R : ℝ)
    (y : CenteredCube3) : ℝ :=
  if centeredCube3Radius y ≤ rho then
    1
  else if R ≤ centeredCube3Radius y then
    0
  else
    (R - centeredCube3Radius y) / (R - rho)

/--
The radial cutoff is exactly one on the hard inner region.
-/
lemma centeredCube3RadialCutoff_eq_one_of_lt
    (rho R : ℝ)
    (y : CenteredCube3)
    (h : centeredCube3Radius y < rho) :
    centeredCube3RadialCutoff rho R y = 1 := by
  unfold centeredCube3RadialCutoff
  simp [le_of_lt h]

/--
If `rho < R`, the radial cutoff vanishes outside the outer ball.
-/
lemma centeredCube3RadialCutoff_eq_zero_of_outer_le
    {rho R : ℝ}
    (hRhoR : rho < R)
    (y : CenteredCube3)
    (h : R ≤ centeredCube3Radius y) :
    centeredCube3RadialCutoff rho R y = 0 := by
  have hNot :
      ¬ centeredCube3Radius y ≤ rho := by
    exact not_le.mpr (lt_of_lt_of_le hRhoR h)
  unfold centeredCube3RadialCutoff
  simp [hNot, h]

/--
The measurable indicator of the hard inner ball.
-/
noncomputable def centeredCube3InnerIndicator
    (rho : ℝ)
    (y : CenteredCube3) : ℂ :=
  if centeredCube3Radius y < rho then 1 else 0

lemma centeredCube3InnerIndicator_aestronglyMeasurable
    (rho : ℝ) :
    MeasureTheory.AEStronglyMeasurable
      (centeredCube3InnerIndicator rho)
      centeredCube3Measure := by

  have hMeas :
      Measurable (centeredCube3InnerIndicator rho) := by
    unfold centeredCube3InnerIndicator
    have hSet :
        MeasurableSet
          {y : CenteredCube3 |
            centeredCube3Radius y < rho} :=
      measurableSet_Iio.preimage
        centeredCube3Radius_measurable
    exact Measurable.ite hSet measurable_const measurable_const

  exact hMeas.aestronglyMeasurable

lemma centeredCube3InnerIndicator_norm_le
    (rho : ℝ)
    (y : CenteredCube3) :
    ‖centeredCube3InnerIndicator rho y‖ ≤ 1 := by
  unfold centeredCube3InnerIndicator
  by_cases h : centeredCube3Radius y < rho
  · simp [h]
  · simp [h]

/--
The hard inner indicator is a bounded centered-cube multiplier of norm at
most one.
-/
noncomputable def centeredCube3InnerIndicatorMultiplier
    (rho : ℝ) :
    CenteredCube3BoundedMultiplier 1 where

  multiplier :=
    centeredCube3InnerIndicator rho

  multiplier_aestronglyMeasurable :=
    centeredCube3InnerIndicator_aestronglyMeasurable rho

  bound_nonneg := by
    norm_num

  norm_le :=
    centeredCube3InnerIndicator_norm_le rho

/--
Localized Hardy data for the explicit radial cutoff.

This is now the only near-origin analytic input.  The state is exactly

`(chi_{rho,R}(y) / |y|) * psi(y)`

almost everywhere, where `chi_{rho,R}` is the explicit radial cutoff above.
The geometric fields `rho_pos`, `rho_lt_outer`, and `outer_lt_half` ensure
that the cutoff equals one on the desired hard inner ball and is supported
strictly inside the centered fundamental cell.

The remaining norm estimate is precisely the statement obtained by:
1. zero-extending `chi * psi` to `R^3`;
2. applying the three-dimensional Hardy inequality;
3. applying the cutoff product rule;
4. identifying the Fourier-polynomial derivative norm with
   `torus3FourierGradientSq`.
-/
structure CenteredCube3RadialCutoffHardyData
    (rho R Ainner : ℝ) where

  rho_pos : 0 < rho
  rho_lt_outer : rho < R
  outer_lt_half : R < (1 / 2 : ℝ)

  localizedState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → CenteredCube3L2

  localized_eq_ae :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
            localizedState α index f y
              =
            (centeredCube3InverseRadius y : ℂ) *
              (centeredCube3RadialCutoff rho R y : ℂ) *
              torus3FourierPolynomial index f
                (unitTorus3CenteredEquiv.symm y)

  localized_norm_sq_le_h1 :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖localizedState α index f‖ ^ 2
            ≤
          Ainner ^ 2 *
            (‖torus3FourierPolynomial index f‖ ^ 2 +
              torus3FourierGradientSq
                (torus3FourierPolynomial index f))

/--
The localized radial-cutoff Hardy state supplies the hard inner state
required by milestone 81.

Lean itself applies the hard indicator `1_{r < rho}`.  Since the radial
cutoff is exactly one there, the resulting state is pointwise the required
hard inner inverse-radius product.  Since the indicator has multiplier norm
at most one, its `L²` norm cannot exceed the localized Hardy-state norm.
-/
noncomputable def
    CenteredCube3RadialCutoffHardyData.toInnerRadiusHardyData
    {rho R Ainner : ℝ}
    (data :
      CenteredCube3RadialCutoffHardyData
        rho R Ainner) :
    CenteredCube3InnerRadiusHardyData
      rho Ainner where

  innerState :=
    fun α _ index f =>
      (centeredCube3InnerIndicatorMultiplier rho).productState
        (data.localizedState α index f)

  inner_eq_ae := by
    intro α inst index f

    filter_upwards [
      (centeredCube3InnerIndicatorMultiplier rho).productState_eq_ae
        (data.localizedState α index f),
      data.localized_eq_ae α index f
    ] with y hMask hLocalized

    rw [hMask]
    rw [hLocalized]

    by_cases h : centeredCube3Radius y < rho

    · have hCutoff :
          centeredCube3RadialCutoff rho R y = 1 :=
        centeredCube3RadialCutoff_eq_one_of_lt
          rho R y h
      simp [centeredCube3InnerIndicatorMultiplier, centeredCube3InnerIndicator, h, hCutoff]

    · simp [centeredCube3InnerIndicatorMultiplier, centeredCube3InnerIndicator, h]

  inner_norm_sq_le_h1 := by
    intro α inst index hInjective f

    have hMask :=
      (centeredCube3InnerIndicatorMultiplier rho).productState_norm_sq_le
        (data.localizedState α index f)

    have hMask' :
        ‖(centeredCube3InnerIndicatorMultiplier rho).productState
            (data.localizedState α index f)‖ ^ 2
          ≤
        ‖data.localizedState α index f‖ ^ 2 := by
      simpa using hMask

    exact
      le_trans hMask'
        (data.localized_norm_sq_le_h1
          α index hInjective f)

end

end PlaneWaveCertificate

