  classical
  ext p
  rw [tailMask_apply]
  by_cases hp : p ∈ fourierConfigCube eta n
  · rcases Finset.mem_image.mp hp with ⟨q, _, rfl⟩
    rw [finiteFourierLpEmbed_apply_index, finiteFourierLpEmbed_apply_index,
      referenceTailOperator_apply, kabs_eq_lattice]
    change (if K < g * Real.sqrt (latticeNormSq (finitePlaneWaveLatticeIndex n (q r))) then
