  rw [finiteCoefficientKernelOperator_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [finiteCoefficientKernelOperator_sum]
  apply Finset.sum_congr rfl
  intro ell hell
  rw [referenceKernelConvolutionOperator_eq_finiteCoefficientKernelOperator]
  apply congrArg finiteCoefficientKernelOperator
