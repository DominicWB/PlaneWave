noncomputable section

/-! ## One-hundred-second milestone: differentiate the radial cutoff on its annulus -/

/-- The square of the ambient Euclidean radius is literally the squared-radius
polynomial already used in the regularized Hardy field. -/
lemma centeredCube3AmbientRadius_sq
    (x : CenteredCube3Ambient) :
    centeredCube3AmbientRadius x ^ 2 =
      centeredCube3AmbientRadiusSq x := by
  unfold centeredCube3AmbientRadius
  exact Real.sq_sqrt (centeredCube3AmbientRadiusSq_nonneg x)

/-- Along a coordinate line, the squared Euclidean radius has derivative
`2 x_j` at the base point. -/
lemma centeredCube3AmbientRadiusSq_hasDerivAt_coordinate
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3AmbientRadiusSq
          (x + t • hardyCoordinateDirection j))
      (2 * x j)
      0 := by
  have hConst :=
    hasDerivAt_const (0 : ℝ) (centeredCube3AmbientRadiusSq x)
  have hLinear :=
    (hasDerivAt_const_mul (x := (0 : ℝ)) (2 : ℝ)).mul_const (x j)
  have hSquare :=
    hasDerivAt_pow 2 (0 : ℝ)
  have h :=
    (hConst.add hLinear).add hSquare

  have hFunction :
      (fun t : ℝ =>
        centeredCube3AmbientRadiusSq
          (x + t • hardyCoordinateDirection j))
        =
      (fun t : ℝ =>
        centeredCube3AmbientRadiusSq x + 2 * t * x j + t ^ 2) := by
    funext t
    exact centeredCube3AmbientRadiusSq_add_coordinate x j t

  rw [hFunction]
  have hValue :
      (0 + 2 * x j + (2 : ℝ) * 0 ^ (2 - 1)) =
        2 * x j := by
    norm_num
  exact h.congr_deriv hValue

/-- Away from the origin, the Euclidean radius has the expected directional
derivative `x_j / |x|`. -/
lemma centeredCube3AmbientRadius_hasDerivAt_coordinate
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hRadiusPos : 0 < centeredCube3AmbientRadius x) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3AmbientRadius
          (x + t • hardyCoordinateDirection j))
      (x j / centeredCube3AmbientRadius x)
      0 := by
  have hSq :=
    centeredCube3AmbientRadiusSq_hasDerivAt_coordinate x j

  have hRadiusSqPos :
      0 < centeredCube3AmbientRadiusSq x := by
    rw [← centeredCube3AmbientRadius_sq x]
    positivity

  have hRadiusSqPos0 :
      0 <
        centeredCube3AmbientRadiusSq
          (x + (0 : ℝ) • hardyCoordinateDirection j) := by
    simpa using hRadiusSqPos

  have hSqrt :=
    hSq.sqrt (ne_of_gt hRadiusSqPos0)

  have hFunction :
      (fun t : ℝ =>
        Real.sqrt
          (centeredCube3AmbientRadiusSq
            (x + t • hardyCoordinateDirection j)))
        =
      (fun t : ℝ =>
        centeredCube3AmbientRadius
          (x + t • hardyCoordinateDirection j)) := by
    rfl

  have hValue :
      (2 * x j) /
          (2 *
            Real.sqrt
              (centeredCube3AmbientRadiusSq x))
        =
      x j / centeredCube3AmbientRadius x := by
    unfold centeredCube3AmbientRadius
    have hne :
        Real.sqrt (centeredCube3AmbientRadiusSq x) ≠ 0 := by
      exact ne_of_gt hRadiusPos
    field_simp [hne]

  have hValue0 :
      (2 * x j) /
          (2 *
            Real.sqrt
              (centeredCube3AmbientRadiusSq
                (x + (0 : ℝ) • hardyCoordinateDirection j)))
        =
      x j / centeredCube3AmbientRadius x := by
    simpa using hValue

  rw [← hFunction]
  exact hSqrt.congr_deriv hValue0

/-- The scalar formula used by the cutoff on the open annulus. -/
noncomputable def centeredCube3AnnularCutoffAmbient
    (rho R : ℝ)
    (x : CenteredCube3Ambient) : ℝ :=
  (R - centeredCube3AmbientRadius x) / (R - rho)

/-- The annular scalar cutoff has derivative
`-x_j / ((R-rho)|x|)` along the `j`-th coordinate. -/
lemma centeredCube3AnnularCutoffAmbient_hasDerivAt_coordinate
    {rho R : ℝ}
    (hRhoR : rho < R)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hRadiusPos : 0 < centeredCube3AmbientRadius x) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3AnnularCutoffAmbient rho R
          (x + t • hardyCoordinateDirection j))
      ((-(x j) / centeredCube3AmbientRadius x) / (R - rho))
      0 := by
  have hRadius :=
    centeredCube3AmbientRadius_hasDerivAt_coordinate x j hRadiusPos

  have hNumerator :
      HasDerivAt
        (fun t : ℝ =>
          R -
            centeredCube3AmbientRadius
              (x + t • hardyCoordinateDirection j))
        (-(x j / centeredCube3AmbientRadius x))
        0 := by
    simpa using hRadius.const_sub R

  unfold centeredCube3AnnularCutoffAmbient
  have h :=
    hNumerator.div_const (R - rho)

  have hValue :
      (-(x j / centeredCube3AmbientRadius x)) / (R - rho)
        =
      (-(x j) / centeredCube3AmbientRadius x) / (R - rho) := by
    ring
  exact h.congr_deriv hValue

/-- On the open annulus, the piecewise cutoff is exactly its explicit scalar
annular formula. -/
lemma centeredCube3RadialCutoff_eq_annular_formula
    {rho R : ℝ}
    (hRhoR : rho < R)
    (y : CenteredCube3)
    (hInner : rho < centeredCube3Radius y)
    (hOuter : centeredCube3Radius y < R) :
    centeredCube3RadialCutoff rho R y =
      (R - centeredCube3Radius y) / (R - rho) := by
  unfold centeredCube3RadialCutoff
  have hNotInner :
      ¬ centeredCube3Radius y ≤ rho :=
    not_le.mpr hInner
  have hNotOuter :
      ¬ R ≤ centeredCube3Radius y :=
    not_le.mpr hOuter
  simp [hNotInner, hNotOuter]

/-- On the same annulus, the explicit a.e. cutoff derivative is exactly the
ordinary radial derivative formula. -/
lemma centeredCube3RadialCutoffPartial_eq_annular_formula
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (j : Fin 3)
    (y : CenteredCube3)
    (hInner : rho < centeredCube3Radius y)
    (hOuter : centeredCube3Radius y < R) :
    centeredCube3RadialCutoffPartial rho R j y =
      (-(y.1 j) / centeredCube3Radius y) / (R - rho) := by
  unfold centeredCube3RadialCutoffPartial
  have hNotInner :
      ¬ centeredCube3Radius y ≤ rho :=
    not_le.mpr hInner
  have hNotOuter :
      ¬ R ≤ centeredCube3Radius y :=
    not_le.mpr hOuter
  simp only [if_neg hNotInner, if_neg hNotOuter]
  rw [centeredCube3InverseRadius_eq_one_div_radius]
  have hRadiusPos :
      0 < centeredCube3Radius y :=
    lt_trans hrho hInner
  have hRadiusNe :
      centeredCube3Radius y ≠ 0 :=
    ne_of_gt hRadiusPos
  field_simp [hRadiusNe]

/-!
## One-hundred-second milestone

The only nontrivial scalar derivative in the piecewise-linear radial cutoff is
now formalized.  Lean proves

`d/dt |x + t e_j| at t=0 = x_j / |x|`

whenever `|x| > 0`, and consequently

`d/dt [(R - |x+t e_j|)/(R-rho)] at t=0
   = -x_j / ((R-rho)|x|)`.

On the open annulus `rho < |x| < R`, this derivative is proved to agree exactly
with the previously defined `centeredCube3RadialCutoffPartial`.  Together with
milestone 101's smooth ambient Fourier derivative, the next milestone can apply
the ordinary product rule on the annular branch; the inner branch has constant
cutoff one and the outer branch has constant cutoff zero.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open Filter
open scoped Topology

/-! ## One-hundred-third milestone: the actual cutoff-wave derivative off the crossing set

This section differentiates the existing zero extension, not just a formula that
agrees with it at the base point.  Continuity of the radius keeps each strict
radial branch fixed on a neighborhood of the parameter.  The resulting local
equalities allow `HasDerivAt.congr_of_eventuallyEq` to transfer the derivatives.
The final theorem applies at every nonexceptional parameter on a coordinate line.
-/

/-- The Euclidean radius restricted to a coordinate line is continuous, also
when the line passes through the origin. -/
lemma centeredCube3AmbientRadius_coordinate_continuous
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    Continuous
      (fun t : ℝ =>
        centeredCube3AmbientRadius
          (x + t • hardyCoordinateDirection j)) := by
  unfold centeredCube3AmbientRadius centeredCube3AmbientRadiusSq
  fun_prop

/-- A strict upper bound on the radius persists near the base parameter. -/
lemma centeredCube3AmbientRadius_coordinate_eventually_lt
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    {b : ℝ}
    (h : centeredCube3AmbientRadius x < b) :
    ∀ᶠ t : ℝ in 𝓝 (0 : ℝ),
      centeredCube3AmbientRadius (x + t • hardyCoordinateDirection j) < b := by
  have h0 :
      centeredCube3AmbientRadius
        (x + (0 : ℝ) • hardyCoordinateDirection j) < b := by
    simpa only [zero_smul, add_zero] using h
  exact
    (centeredCube3AmbientRadius_coordinate_continuous x j).continuousAt.tendsto.eventually
      (Iio_mem_nhds h0)

/-- A strict lower bound on the radius persists near the base parameter. -/
lemma centeredCube3AmbientRadius_coordinate_eventually_gt
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    {b : ℝ}
    (h : b < centeredCube3AmbientRadius x) :
    ∀ᶠ t : ℝ in 𝓝 (0 : ℝ),
      b < centeredCube3AmbientRadius (x + t • hardyCoordinateDirection j) := by
  have h0 :
      b < centeredCube3AmbientRadius
        (x + (0 : ℝ) • hardyCoordinateDirection j) := by
    simpa only [zero_smul, add_zero] using h
  exact
    (centeredCube3AmbientRadius_coordinate_continuous x j).continuousAt.tendsto.eventually
      (Ioi_mem_nhds h0)

/-- The smooth annular formula for the cutoff wave, defined independently of
whether the ambient point actually lies in the annulus. -/
noncomputable def centeredCube3AnnularCutoffWaveAmbient
    {α : Type} [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient) : ℂ :=
  (centeredCube3AnnularCutoffAmbient rho R x : ℂ) *
    centeredCube3FourierAmbientPolynomial index f x

/-- Product-rule derivative of the smooth annular formula, in the same order
`chi * partial_j psi + partial_j chi * psi` as the existing raw gradient. -/
noncomputable def centeredCube3AnnularCutoffGradientAmbient
    {α : Type} [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (x : CenteredCube3Ambient) : ℂ :=
  (centeredCube3AnnularCutoffAmbient rho R x : ℂ) *
      centeredCube3FourierAmbientPartial index f j x +
    (((-(x j) / centeredCube3AmbientRadius x) / (R - rho) : ℝ) : ℂ) *
      centeredCube3FourierAmbientPolynomial index f x

/-- The ordinary product rule for the annular cutoff times the smooth ambient
Fourier polynomial.  There is no claim of differentiability at the origin. -/
lemma centeredCube3AnnularCutoffWaveAmbient_hasDerivAt_coordinate
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hRadiusPos : 0 < centeredCube3AmbientRadius x) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3AnnularCutoffWaveAmbient rho R index f
          (x + t • hardyCoordinateDirection j))
      (centeredCube3AnnularCutoffGradientAmbient rho R index f j x)
      0 := by
  have hCutReal :=
    centeredCube3AnnularCutoffAmbient_hasDerivAt_coordinate
      hRhoR x j hRadiusPos
  have hCutComplex := hCutReal.ofReal_comp
  have hFourier :=
    centeredCube3FourierAmbientPolynomial_hasDerivAt_coordinate index f x j
  have hProduct := hCutComplex.mul hFourier
  have hValue :
      (((-(x j) / centeredCube3AmbientRadius x) / (R - rho) : ℝ) : ℂ) *
          centeredCube3FourierAmbientPolynomial index f
            (x + (0 : ℝ) • hardyCoordinateDirection j) +
        (centeredCube3AnnularCutoffAmbient rho R
            (x + (0 : ℝ) • hardyCoordinateDirection j) : ℂ) *
          centeredCube3FourierAmbientPartial index f j x =
      centeredCube3AnnularCutoffGradientAmbient rho R index f j x := by
    simp only [zero_smul, add_zero]
    unfold centeredCube3AnnularCutoffGradientAmbient
    exact add_comm _ _
  have hProduct' := hProduct.congr_deriv hValue
  simpa only [centeredCube3AnnularCutoffWaveAmbient, Pi.mul_apply] using! hProduct'

/-- Inside the inner ball the actual ambient zero extension is the ambient
Fourier polynomial, and its existing raw gradient is the Fourier partial. -/
lemma centeredCube3RadialCutoff_inner_ambient_identities
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hInner : centeredCube3AmbientRadius x < rho) :
    centeredCube3RadialCutoffWaveZeroExtension rho R index f x =
        centeredCube3FourierAmbientPolynomial index f x ∧
      centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x =
        centeredCube3FourierAmbientPartial index f j x := by
  let y : CenteredCube3 :=
    centeredCube3OfRadiusLtOuter hOuterHalf x (lt_trans hInner hRhoR)
  have hyRadius : centeredCube3Radius y = centeredCube3AmbientRadius x := by
    exact (centeredCube3AmbientRadius_subtype y).symm
  have hyInner : centeredCube3Radius y < rho := by
    rw [hyRadius]
    exact hInner
  have hCut : centeredCube3RadialCutoff rho R y = 1 :=
    centeredCube3RadialCutoff_eq_one_of_lt rho R y hyInner
  have hCutPartial : centeredCube3RadialCutoffPartial rho R j y = 0 := by
    simp only [centeredCube3RadialCutoffPartial, if_pos (le_of_lt hyInner)]
  have hWave :=
    centeredCube3RadialCutoffWaveZeroExtension_subtype rho R index f y
  have hGradient :=
    centeredCube3RadialCutoffRawGradientZeroExtension_subtype rho R index f j y
  have hPolynomial := centeredCube3FourierAmbientPolynomial_eq_torus index f y
  have hPartial := centeredCube3FourierAmbientPartial_eq_torus index f j y
  constructor
  · calc
      centeredCube3RadialCutoffWaveZeroExtension rho R index f x =
          centeredCube3RadialCutoffWaveFunction rho R index f y := hWave
      _ = centeredCube3FourierAmbientPolynomial index f x := by
        unfold centeredCube3RadialCutoffWaveFunction
        rw [hCut, ← hPolynomial]
        simp only [Complex.ofReal_one, one_mul]
        rfl
  · calc
      centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x =
          centeredCube3RadialCutoffRawGradientFunction rho R index f j y := hGradient
      _ = centeredCube3FourierAmbientPartial index f j x := by
        unfold centeredCube3RadialCutoffRawGradientFunction
        unfold centeredCube3RadialCutoffMainGradientFunction
        unfold centeredCube3RadialCutoffCutoffGradientFunction
        rw [hCut, hCutPartial, ← hPartial, ← hPolynomial]
        simp only [Complex.ofReal_one, Complex.ofReal_zero,
          one_mul, zero_mul, add_zero]
        rfl

/-- On the open annulus the actual zero extension and its existing raw gradient
are exactly the smooth ambient annular formulas. -/
lemma centeredCube3RadialCutoff_annular_ambient_identities
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hInner : rho < centeredCube3AmbientRadius x)
    (hOuter : centeredCube3AmbientRadius x < R) :
    centeredCube3RadialCutoffWaveZeroExtension rho R index f x =
        centeredCube3AnnularCutoffWaveAmbient rho R index f x ∧
      centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x =
        centeredCube3AnnularCutoffGradientAmbient rho R index f j x := by
  let y : CenteredCube3 := centeredCube3OfRadiusLtOuter hOuterHalf x hOuter
  have hyRadius : centeredCube3Radius y = centeredCube3AmbientRadius x := by
    exact (centeredCube3AmbientRadius_subtype y).symm
  have hyInner : rho < centeredCube3Radius y := by
    rw [hyRadius]
    exact hInner
  have hyOuter : centeredCube3Radius y < R := by
    rw [hyRadius]
    exact hOuter
  have hCut :
      centeredCube3RadialCutoff rho R y =
        centeredCube3AnnularCutoffAmbient rho R x := by
    rw [centeredCube3RadialCutoff_eq_annular_formula hRhoR y hyInner hyOuter]
    unfold centeredCube3AnnularCutoffAmbient
    rw [hyRadius]
  have hCutPartial :
      centeredCube3RadialCutoffPartial rho R j y =
        (-(x j) / centeredCube3AmbientRadius x) / (R - rho) := by
    rw [centeredCube3RadialCutoffPartial_eq_annular_formula
      hrho hRhoR j y hyInner hyOuter, hyRadius]
    rfl
  have hWave :=
    centeredCube3RadialCutoffWaveZeroExtension_subtype rho R index f y
  have hGradient :=
    centeredCube3RadialCutoffRawGradientZeroExtension_subtype rho R index f j y
  have hPolynomial := centeredCube3FourierAmbientPolynomial_eq_torus index f y
  have hPartial := centeredCube3FourierAmbientPartial_eq_torus index f j y
  constructor
  · calc
      centeredCube3RadialCutoffWaveZeroExtension rho R index f x =
          centeredCube3RadialCutoffWaveFunction rho R index f y := hWave
      _ = centeredCube3AnnularCutoffWaveAmbient rho R index f x := by
        unfold centeredCube3RadialCutoffWaveFunction centeredCube3AnnularCutoffWaveAmbient
        rw [hCut, ← hPolynomial]
        rfl
  · calc
      centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x =
          centeredCube3RadialCutoffRawGradientFunction rho R index f j y := hGradient
      _ = centeredCube3AnnularCutoffGradientAmbient rho R index f j x := by
        unfold centeredCube3RadialCutoffRawGradientFunction
        unfold centeredCube3RadialCutoffMainGradientFunction
        unfold centeredCube3RadialCutoffCutoffGradientFunction
        unfold centeredCube3AnnularCutoffGradientAmbient
        rw [hCut, hCutPartial, ← hPartial, ← hPolynomial]
        rfl

/-- Actual coordinate derivative of the zero-extended wave on the inner branch.
The origin is included, since the cutoff is locally constant there. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_inner
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hInner : centeredCube3AmbientRadius x < rho) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3RadialCutoffWaveZeroExtension rho R index f
          (x + t • hardyCoordinateDirection j))
      (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x)
      0 := by
  have hEq :
      (fun t : ℝ =>
        centeredCube3RadialCutoffWaveZeroExtension rho R index f
          (x + t • hardyCoordinateDirection j)) =ᶠ[𝓝 (0 : ℝ)]
      (fun t : ℝ =>
        centeredCube3FourierAmbientPolynomial index f
          (x + t • hardyCoordinateDirection j)) := by
    filter_upwards [centeredCube3AmbientRadius_coordinate_eventually_lt x j hInner]
      with t ht
    exact
      (centeredCube3RadialCutoff_inner_ambient_identities
        hRhoR hOuterHalf index f (x + t • hardyCoordinateDirection j) j ht).1
  have hBase :=
    centeredCube3FourierAmbientPolynomial_hasDerivAt_coordinate index f x j
  have hActual := hBase.congr_of_eventuallyEq hEq
  have hValue :
      centeredCube3FourierAmbientPartial index f j x =
        centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x :=
    (centeredCube3RadialCutoff_inner_ambient_identities
      hRhoR hOuterHalf index f x j hInner).2.symm
  simpa only using! hActual.congr_deriv hValue

/-- Actual coordinate derivative of the zero-extended wave on the open annulus. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_annular
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hInner : rho < centeredCube3AmbientRadius x)
    (hOuter : centeredCube3AmbientRadius x < R) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3RadialCutoffWaveZeroExtension rho R index f
          (x + t • hardyCoordinateDirection j))
      (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x)
      0 := by
  have hEq :
      (fun t : ℝ =>
        centeredCube3RadialCutoffWaveZeroExtension rho R index f
          (x + t • hardyCoordinateDirection j)) =ᶠ[𝓝 (0 : ℝ)]
      (fun t : ℝ =>
        centeredCube3AnnularCutoffWaveAmbient rho R index f
          (x + t • hardyCoordinateDirection j)) := by
    filter_upwards [
      centeredCube3AmbientRadius_coordinate_eventually_gt x j hInner,
      centeredCube3AmbientRadius_coordinate_eventually_lt x j hOuter
    ] with t htInner htOuter
    exact
      (centeredCube3RadialCutoff_annular_ambient_identities
        hrho hRhoR hOuterHalf index f
        (x + t • hardyCoordinateDirection j) j htInner htOuter).1
  have hBase :=
    centeredCube3AnnularCutoffWaveAmbient_hasDerivAt_coordinate
      hRhoR index f x j (lt_trans hrho hInner)
  have hActual := hBase.congr_of_eventuallyEq hEq
  have hValue :
      centeredCube3AnnularCutoffGradientAmbient rho R index f j x =
        centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x :=
    (centeredCube3RadialCutoff_annular_ambient_identities
      hrho hRhoR hOuterHalf index f x j hInner hOuter).2.symm
  simpa only using! hActual.congr_deriv hValue

/-- Actual coordinate derivative of the zero-extended wave outside the outer
sphere.  Both the wave and the raw gradient are zero on this open region. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_outer
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hOuter : R < centeredCube3AmbientRadius x) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3RadialCutoffWaveZeroExtension rho R index f
          (x + t • hardyCoordinateDirection j))
      (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x)
      0 := by
  have hEq :
      (fun t : ℝ =>
        centeredCube3RadialCutoffWaveZeroExtension rho R index f
          (x + t • hardyCoordinateDirection j)) =ᶠ[𝓝 (0 : ℝ)]
      (fun _ : ℝ => (0 : ℂ)) := by
    filter_upwards [centeredCube3AmbientRadius_coordinate_eventually_gt x j hOuter]
      with t ht
    exact
      centeredCube3RadialCutoffWaveZeroExtension_eq_zero_of_outer_le
        hRhoR index f (x + t • hardyCoordinateDirection j) (le_of_lt ht)
  have hActual :=
    (hasDerivAt_const (0 : ℝ) (0 : ℂ)).congr_of_eventuallyEq hEq
  have hValue :
      (0 : ℂ) =
        centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x :=
    (centeredCube3RadialCutoffRawGradientZeroExtension_eq_zero_of_outer_le
      hRhoR index f j x (le_of_lt hOuter)).symm
  simpa only using! hActual.congr_deriv hValue

/-- The existing raw-gradient zero extension is the actual coordinate derivative
at every ambient point off the two cutoff spheres. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_coordinate
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (hNeInner : centeredCube3AmbientRadius x ≠ rho)
    (hNeOuter : centeredCube3AmbientRadius x ≠ R) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3RadialCutoffWaveZeroExtension rho R index f
          (x + t • hardyCoordinateDirection j))
      (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x)
      0 := by
  by_cases hInner : centeredCube3AmbientRadius x < rho
  · exact
      centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_inner
        hRhoR hOuterHalf index f x j hInner
  · have hInner' : rho < centeredCube3AmbientRadius x :=
      lt_of_le_of_ne (le_of_not_gt hInner) (Ne.symm hNeInner)
    by_cases hOuter : centeredCube3AmbientRadius x < R
    · exact
        centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_annular
          hrho hRhoR hOuterHalf index f x j hInner' hOuter
    · have hOuter' : R < centeredCube3AmbientRadius x :=
        lt_of_le_of_ne (le_of_not_gt hOuter) (Ne.symm hNeOuter)
      exact
        centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_outer
          hRhoR index f x j hOuter'

/-!
## One-hundred-third milestone

For `0 < rho < R < 1/2`, the derivative of the actual zero-extended cutoff wave
on each coordinate line is now identified with the existing raw-gradient slice
at every parameter outside the finite radial crossing set.  No differentiability
assumption or new analytic input is introduced.

The proof handles all three strict regions.  On the inner region the cutoff is
locally one; on the annulus it uses the scalar derivative from milestone 102 and
the Fourier derivative from milestone 101; on the outer region the wave is
locally zero.  Radius continuity provides neighborhood equality before applying
the local derivative congruence theorem, and re-centering gives the result at
arbitrary line parameters, not only at zero.

This does not yet prove integration by parts.  Continuity across the exceptional
parameters, cancellation of their boundary contributions, transverse integration,
and the Hardy cross estimate remain to be assembled.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open Filter
open scoped Topology

/-! ## One-hundred-fourth milestone: continuity through the cutoff crossings

We express the original piecewise-linear cutoff as a clipped affine function of
its radius.  This representation is continuous even at the two cutoff radii.
The equality with the existing zero extension is proved everywhere, including
both spheres and all points outside the centered cell.  No original definitions
or derivative statements are changed.
-/

/-- The continuous scalar profile of the radial cutoff. -/
noncomputable def hardyClippedLinearCutoff
    (rho R r : ℝ) : ℝ :=
  max 0 (min 1 ((R - r) / (R - rho)))

/-- The clipped profile is one on the closed inner region. -/
lemma hardyClippedLinearCutoff_eq_one
    {rho R : ℝ}
    (hRhoR : rho < R)
    (r : ℝ)
    (hInner : r ≤ rho) :
    hardyClippedLinearCutoff rho R r = 1 := by
  have hGap : 0 < R - rho := sub_pos.mpr hRhoR
  have hRatio : (1 : ℝ) ≤ (R - r) / (R - rho) := by
    apply (le_div_iff₀ hGap).2
    linarith
  unfold hardyClippedLinearCutoff
  rw [min_eq_left hRatio, max_eq_right (by norm_num : (0 : ℝ) ≤ 1)]

/-- The clipped profile vanishes on the closed outer region. -/
lemma hardyClippedLinearCutoff_eq_zero
    {rho R : ℝ}
    (hRhoR : rho < R)
    (r : ℝ)
    (hOuter : R ≤ r) :
    hardyClippedLinearCutoff rho R r = 0 := by
  have hGap : 0 < R - rho := sub_pos.mpr hRhoR
  have hRatio : (R - r) / (R - rho) ≤ (0 : ℝ) := by
    apply (div_le_iff₀ hGap).2
    linarith
  have hRatioOne : (R - r) / (R - rho) ≤ (1 : ℝ) :=
    le_trans hRatio (by norm_num)
  unfold hardyClippedLinearCutoff
  rw [min_eq_right hRatioOne, max_eq_left hRatio]

/-- On the closed annulus the clipped profile equals the affine formula.
The endpoint cases are included: the formula takes values one and zero there. -/
lemma hardyClippedLinearCutoff_eq_affine
    {rho R : ℝ}
    (hRhoR : rho < R)
    (r : ℝ)
    (hInner : rho ≤ r)
    (hOuter : r ≤ R) :
    hardyClippedLinearCutoff rho R r = (R - r) / (R - rho) := by
  have hGap : 0 < R - rho := sub_pos.mpr hRhoR
  have hRatioZero : (0 : ℝ) ≤ (R - r) / (R - rho) :=
    div_nonneg (sub_nonneg.mpr hOuter) (le_of_lt hGap)
  have hRatioOne : (R - r) / (R - rho) ≤ (1 : ℝ) := by
    apply (div_le_iff₀ hGap).2
    linarith
  unfold hardyClippedLinearCutoff
  rw [min_eq_right hRatioOne, max_eq_right hRatioZero]

/-- Exact equality of the clipped profile and the original three-branch profile. -/
lemma hardyClippedLinearCutoff_eq_piecewise
    {rho R : ℝ}
    (hRhoR : rho < R)
    (r : ℝ) :
    hardyClippedLinearCutoff rho R r =
      if r ≤ rho then 1 else if R ≤ r then 0 else (R - r) / (R - rho) := by
  by_cases hInner : r ≤ rho
  · rw [if_pos hInner]
    exact hardyClippedLinearCutoff_eq_one hRhoR r hInner
  · rw [if_neg hInner]
    by_cases hOuter : R ≤ r
    · rw [if_pos hOuter]
      exact hardyClippedLinearCutoff_eq_zero hRhoR r hOuter
    · rw [if_neg hOuter]
      exact hardyClippedLinearCutoff_eq_affine hRhoR r
        (le_of_lt (lt_of_not_ge hInner))
        (le_of_lt (lt_of_not_ge hOuter))

/-- The clipped profile is continuous, with no exclusion of either endpoint. -/
lemma hardyClippedLinearCutoff_continuous
    (rho R : ℝ) :
    Continuous (hardyClippedLinearCutoff rho R) := by
  unfold hardyClippedLinearCutoff
  simp only [div_eq_mul_inv]
  fun_prop

/-- The ambient Euclidean radius is continuous, including at the origin. -/
lemma centeredCube3AmbientRadius_continuous :
    Continuous centeredCube3AmbientRadius := by
  unfold centeredCube3AmbientRadius centeredCube3AmbientRadiusSq
  fun_prop

/-- An everywhere-defined continuous ambient cutoff. -/
noncomputable def centeredCube3ClippedCutoffAmbient
    (rho R : ℝ)
    (x : CenteredCube3Ambient) : ℝ :=
  hardyClippedLinearCutoff rho R (centeredCube3AmbientRadius x)

lemma centeredCube3ClippedCutoffAmbient_continuous
    (rho R : ℝ) :
    Continuous (centeredCube3ClippedCutoffAmbient rho R) := by
  unfold centeredCube3ClippedCutoffAmbient
  exact (hardyClippedLinearCutoff_continuous rho R).comp
    centeredCube3AmbientRadius_continuous

/-- On the centered cube this continuous ambient cutoff is exactly the existing
piecewise-linear cutoff, not a replacement with a different boundary convention. -/
lemma centeredCube3ClippedCutoffAmbient_subtype
    {rho R : ℝ}
    (hRhoR : rho < R)
    (y : CenteredCube3) :
    centeredCube3ClippedCutoffAmbient rho R y.1 =
      centeredCube3RadialCutoff rho R y := by
  unfold centeredCube3ClippedCutoffAmbient
  rw [centeredCube3AmbientRadius_subtype,
    hardyClippedLinearCutoff_eq_piecewise hRhoR]
  rfl

lemma centeredCube3ClippedCutoffAmbient_eq_zero_of_outer_le
    {rho R : ℝ}
    (hRhoR : rho < R)
    (x : CenteredCube3Ambient)
    (hOuter : R ≤ centeredCube3AmbientRadius x) :
    centeredCube3ClippedCutoffAmbient rho R x = 0 := by
  exact hardyClippedLinearCutoff_eq_zero hRhoR
    (centeredCube3AmbientRadius x) hOuter

/-- The finite ambient Fourier sum is continuous on all of real three-space.
The exponential representation from milestone 101 avoids any appeal to
continuity of a choice of fundamental-domain representative. -/
lemma centeredCube3FourierAmbientPolynomial_continuous
    {α : Type} [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    Continuous (centeredCube3FourierAmbientPolynomial index f) := by
  classical
  unfold centeredCube3FourierAmbientPolynomial
  unfold centeredCube3FourierMonomial centeredCube3FourierFactor
  fun_prop

/-- Everywhere equality of the actual zero extension with the continuous
clipped cutoff times the ambient Fourier polynomial.  The proof treats the
whole closed exterior separately, so in particular it includes the outer
sphere and the faces of the fundamental cube. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_eq_clippedAmbient
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient) :
    centeredCube3RadialCutoffWaveZeroExtension rho R index f x =
      (centeredCube3ClippedCutoffAmbient rho R x : ℂ) *
        centeredCube3FourierAmbientPolynomial index f x := by
  by_cases hInside : centeredCube3AmbientRadius x < R
  · let y : CenteredCube3 := centeredCube3OfRadiusLtOuter hOuterHalf x hInside
    have hWave :=
      centeredCube3RadialCutoffWaveZeroExtension_subtype rho R index f y
    have hCut := centeredCube3ClippedCutoffAmbient_subtype hRhoR y
    have hPolynomial := centeredCube3FourierAmbientPolynomial_eq_torus index f y
    calc
      centeredCube3RadialCutoffWaveZeroExtension rho R index f x =
          centeredCube3RadialCutoffWaveFunction rho R index f y := hWave
      _ = (centeredCube3ClippedCutoffAmbient rho R x : ℂ) *
          centeredCube3FourierAmbientPolynomial index f x := by
        unfold centeredCube3RadialCutoffWaveFunction
        rw [← hCut, ← hPolynomial]
        rfl
  · have hOuter : R ≤ centeredCube3AmbientRadius x := le_of_not_gt hInside
    rw [centeredCube3RadialCutoffWaveZeroExtension_eq_zero_of_outer_le
      hRhoR index f x hOuter]
    rw [centeredCube3ClippedCutoffAmbient_eq_zero_of_outer_le hRhoR x hOuter]
    simp only [Complex.ofReal_zero, zero_mul]

/-- The actual zero-extended cutoff wave is globally continuous.  In particular
this closes the continuity gap left by differentiating off the cutoff spheres. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_continuous
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3)
    (f : α → ℂ) :
    Continuous (centeredCube3RadialCutoffWaveZeroExtension rho R index f) := by
  have hFunction :
      centeredCube3RadialCutoffWaveZeroExtension rho R index f =
        (fun x : CenteredCube3Ambient =>
          (centeredCube3ClippedCutoffAmbient rho R x : ℂ) *
            centeredCube3FourierAmbientPolynomial index f x) := by
    funext x
    exact centeredCube3RadialCutoffWaveZeroExtension_eq_clippedAmbient
      hRhoR hOuterHalf index f x
  rw [hFunction]
  have hCut : Continuous
      (fun x : CenteredCube3Ambient =>
        (centeredCube3ClippedCutoffAmbient rho R x : ℂ)) := by
    simpa only [Function.comp_def] using
      Complex.continuous_ofReal.comp
        (centeredCube3ClippedCutoffAmbient_continuous rho R)
  exact hCut.mul (centeredCube3FourierAmbientPolynomial_continuous index f)

/-- A coordinate alone already bounds the radius from below. -/
lemma centeredCube3AmbientRadius_coordinate_ge_abs
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) :
    |x j + t| ≤ centeredCube3AmbientRadius (x + t • hardyCoordinateDirection j) := by
  simpa only [add_smul_hardyCoordinateDirection_apply_same] using
    centeredCube3Ambient_abs_coord_le_radius
      (x + t • hardyCoordinateDirection j) j

/-- Positive regularization makes each Hardy field component continuous
throughout the ambient space. -/
lemma hardyRegularizedFieldComponent_continuous
    {eps : ℝ}
    (heps : 0 < eps)
    (j : Fin 3) :
    Continuous (hardyRegularizedFieldComponent eps j) := by
  have hCoord : Continuous (fun x : CenteredCube3Ambient => x j) :=
    continuous_apply j
  have hDen : Continuous (hardyRegularizedDenominator eps) := by
    unfold hardyRegularizedDenominator centeredCube3AmbientRadiusSq
    fun_prop
  unfold hardyRegularizedFieldComponent
  exact hCoord.div hDen (fun x => ne_of_gt (hardyRegularizedDenominator_pos heps x))

/-- The real flux whose coordinate derivative is used in the Hardy
integration-by-parts identity.  This is `F_eps,j * |U|^2` for the actual wave. -/
noncomputable def centeredCube3RadialCutoffRegularizedFlux
    {α : Type} [Fintype α]
    (rho R eps : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (x : CenteredCube3Ambient) : ℝ :=
  hardyRegularizedFieldComponent eps j x *
    ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2

/-- The Hardy flux is continuous even on both cutoff spheres.  The raw gradient
need not be continuous on these spheres, and no such assertion is made. -/
lemma centeredCube3RadialCutoffRegularizedFlux_continuous
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (heps : 0 < eps)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    Continuous (centeredCube3RadialCutoffRegularizedFlux rho R eps index f j) := by
  unfold centeredCube3RadialCutoffRegularizedFlux
  exact (hardyRegularizedFieldComponent_continuous heps j).mul
    ((centeredCube3RadialCutoffWaveZeroExtension_continuous
      hRhoR hOuterHalf index f).norm.pow 2)

/-- The regularized flux vanishes wherever the cutoff wave vanishes. -/
lemma centeredCube3RadialCutoffRegularizedFlux_eq_zero_of_outer_le
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (eps : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (x : CenteredCube3Ambient)
    (hOuter : R ≤ centeredCube3AmbientRadius x) :
    centeredCube3RadialCutoffRegularizedFlux rho R eps index f j x = 0 := by
  unfold centeredCube3RadialCutoffRegularizedFlux
  rw [centeredCube3RadialCutoffWaveZeroExtension_eq_zero_of_outer_le
    hRhoR index f x hOuter]
  simp

/-- Real coordinate slice of the regularized flux. -/
noncomputable def centeredCube3RadialCutoffRegularizedFluxSlice
    {α : Type} [Fintype α]
    (rho R eps : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) : ℝ :=
  centeredCube3RadialCutoffRegularizedFlux rho R eps index f j
    (x + t • hardyCoordinateDirection j)

lemma centeredCube3RadialCutoffRegularizedFluxSlice_continuous
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ))
    (heps : 0 < eps)
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    Continuous
      (centeredCube3RadialCutoffRegularizedFluxSlice rho R eps index f x j) := by
  have hLine : Continuous
      (fun t : ℝ => x + t • hardyCoordinateDirection j) := by
    fun_prop
  unfold centeredCube3RadialCutoffRegularizedFluxSlice
  exact (centeredCube3RadialCutoffRegularizedFlux_continuous
    hRhoR hOuterHalf heps index f j).comp hLine

/-- Both external endpoint values of the flux vanish on the explicit slice
interval `[-R-x_j, R-x_j]`. -/
lemma centeredCube3RadialCutoffRegularizedFluxSlice_endpoints
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (eps : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    centeredCube3RadialCutoffRegularizedFluxSlice
        rho R eps index f x j (-R - x j) = 0 ∧
      centeredCube3RadialCutoffRegularizedFluxSlice
        rho R eps index f x j (R - x j) = 0 := by
  have hLeft : R ≤ |x j + (-R - x j)| := by
    have hPoint : x j + (-R - x j) = -R := by ring
    rw [hPoint, abs_neg]
    exact le_abs_self R
  have hRight : R ≤ |x j + (R - x j)| := by
    have hPoint : x j + (R - x j) = R := by ring
    rw [hPoint]
    exact le_abs_self R
  constructor
  · exact centeredCube3RadialCutoffRegularizedFlux_eq_zero_of_outer_le
      hRhoR eps index f j (x + (-R - x j) • hardyCoordinateDirection j)
      (le_trans hLeft (centeredCube3AmbientRadius_coordinate_ge_abs x j (-R - x j)))
  · exact centeredCube3RadialCutoffRegularizedFlux_eq_zero_of_outer_le
      hRhoR eps index f j (x + (R - x j) • hardyCoordinateDirection j)
      (le_trans hRight (centeredCube3AmbientRadius_coordinate_ge_abs x j (R - x j)))

/-!
## One-hundred-fourth milestone

The actual zero-extended cutoff wave is continuous on all of ambient real
three-space.  Its coordinate slices are therefore continuous at the finite
exceptional crossing parameters, not merely differentiable away from them.
The clipped-profile identity proves this with the original endpoint values.

The regularized real Hardy flux `F_eps,j * |U|^2` is also continuous.  Its two
one-sided limits agree at every crossing, and its external endpoint values
vanish on the explicit slice interval `[-R-x_j, R-x_j]`.

No integration-by-parts identity or Hardy inequality is assumed in this section.
The next analytic step is to identify the derivative of this flux off the
crossing set and apply the finite-exception fundamental theorem of calculus,
with the required derivative integrability.  Transverse integration and the
regularized Hardy estimate still remain.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open Filter MeasureTheory
open scoped Topology

/-! ## One-hundred-fifth milestone: coordinatewise regularized integration by parts

We differentiate the actual continuous flux from milestone 104, and prove that
its explicit derivative is integrable on every bounded coordinate interval.
The finite-exception fundamental theorem of calculus then gives an integral
identity, including cancellation across the two cutoff spheres.  No derivative
or integration-by-parts assumption is added to the end-to-end certificate.
-/

/-- The real part of the complex cross term is the real inner-product term
appearing in the derivative of the squared norm. -/
lemma hardyRegularizedComplexCrossTerm_re_eq_real_inner
    (eps : ℝ) (j : Fin 3)
    (u v : CenteredCube3Ambient → ℂ)
    (x : CenteredCube3Ambient) :
    (hardyRegularizedComplexCrossTerm eps j u v x).re =
      hardyRegularizedFieldComponent eps j x * inner ℝ (u x) (v x) := by
  simp only [hardyRegularizedComplexCrossTerm, Complex.inner,
    Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
  ring

/-- The explicit coordinate derivative of `F_eps,j * |u|^2`, when `v` is the
coordinate derivative of `u`.  It is defined at the exceptional points as well;
no differentiability is asserted at those points. -/
noncomputable def hardyRegularizedFluxDerivative
    (eps : ℝ) (j : Fin 3)
    (u v : CenteredCube3Ambient → ℂ)
    (x : CenteredCube3Ambient) : ℝ :=
  hardyRegularizedCoordinateDivergence eps j x * ‖u x‖ ^ 2 +
    2 * (hardyRegularizedComplexCrossTerm eps j u v x).re

/-- Specialization to the already constructed wave and raw gradient. -/
noncomputable def centeredCube3RadialCutoffRegularizedFluxDerivative
    {α : Type} [Fintype α]
    (rho R eps : ℝ)
    (index : α → Lattice3) (f : α → ℂ)
    (j : Fin 3) : CenteredCube3Ambient → ℝ :=
  hardyRegularizedFluxDerivative eps j
    (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
    (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j)

/-- The explicit derivative density restricted to an affine coordinate line. -/
noncomputable def centeredCube3RadialCutoffRegularizedFluxDerivativeSlice
    {α : Type} [Fintype α]
    (rho R eps : ℝ)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3) (t : ℝ) : ℝ :=
  centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j
    (x + t • hardyCoordinateDirection j)

/-- The actual flux has the prescribed derivative at every ambient base point
off the two cutoff spheres.  Using the squared-norm derivative avoids imposing
any nonvanishing assumption on the wave. -/
lemma centeredCube3RadialCutoffRegularizedFlux_hasDerivAt_coordinate
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3)
    (hNeInner : centeredCube3AmbientRadius x ≠ rho)
    (hNeOuter : centeredCube3AmbientRadius x ≠ R) :
    HasDerivAt
      (fun t : ℝ => centeredCube3RadialCutoffRegularizedFlux rho R eps index f j
        (x + t • hardyCoordinateDirection j))
      (centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j x)
      0 := by
  have hField := hardyRegularizedFieldComponent_hasLineDerivAt heps x j
  unfold HasLineDerivAt at hField
  have hWave := centeredCube3RadialCutoffWaveZeroExtension_hasDerivAt_coordinate
    hrho hRhoR hOuterHalf index f x j hNeInner hNeOuter
  have hNormSq := hWave.norm_sq
  have hProduct := hField.mul hNormSq
  have hValue :
      hardyRegularizedCoordinateDivergence eps j x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f
            (x + (0 : ℝ) • hardyCoordinateDirection j)‖ ^ 2 +
        hardyRegularizedFieldComponent eps j
            (x + (0 : ℝ) • hardyCoordinateDirection j) *
          (2 * inner ℝ
            (centeredCube3RadialCutoffWaveZeroExtension rho R index f
              (x + (0 : ℝ) • hardyCoordinateDirection j))
            (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x)) =
      centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j x := by
    simp only [zero_smul, add_zero]
    unfold centeredCube3RadialCutoffRegularizedFluxDerivative
      hardyRegularizedFluxDerivative
    rw [hardyRegularizedComplexCrossTerm_re_eq_real_inner]
    ring
  have hProduct' := hProduct.congr_deriv hValue
  unfold centeredCube3RadialCutoffRegularizedFlux
  simpa only [Pi.mul_apply] using! hProduct'

/-- At every parameter outside the finite radial crossing set, the actual flux
slice has the explicit derivative density. -/
lemma centeredCube3RadialCutoffRegularizedFluxSlice_hasDerivAt_of_not_mem
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3) (t : ℝ)
    (ht : t ∉ hardyRadialSliceExceptionalSet rho R x j) :
    HasDerivAt
      (centeredCube3RadialCutoffRegularizedFluxSlice rho R eps index f x j)
      (centeredCube3RadialCutoffRegularizedFluxDerivativeSlice rho R eps index f x j t)
      t := by
  let q : CenteredCube3Ambient := x + t • hardyCoordinateDirection j
  have hNeInner : centeredCube3AmbientRadius q ≠ rho :=
    hardyRadialSlice_radius_ne_rho_of_not_mem rho R x j t ht
  have hNeOuter : centeredCube3AmbientRadius q ≠ R :=
    hardyRadialSlice_radius_ne_outer_of_not_mem rho R x j t ht
  have hBase := centeredCube3RadialCutoffRegularizedFlux_hasDerivAt_coordinate
    hrho hRhoR hOuterHalf heps index f q j hNeInner hNeOuter
  have hShift := (hasDerivAt_id' t).sub_const t
  have hComposed := hBase.scomp_of_eq t hShift (by simp)
  have hAt :
      HasDerivAt
        (fun s : ℝ => centeredCube3RadialCutoffRegularizedFlux rho R eps index f j
          (q + (s - t) • hardyCoordinateDirection j))
        (centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j q)
        t := by
    simpa only [Function.comp_def, one_smul] using! hComposed
  have hFunction :
      (fun s : ℝ => centeredCube3RadialCutoffRegularizedFlux rho R eps index f j
        (q + (s - t) • hardyCoordinateDirection j)) =
      centeredCube3RadialCutoffRegularizedFluxSlice rho R eps index f x j := by
    funext s
    unfold centeredCube3RadialCutoffRegularizedFluxSlice
    have hPoint : q + (s - t) • hardyCoordinateDirection j =
        x + s • hardyCoordinateDirection j := by
      dsimp [q]
      calc
        (x + t • hardyCoordinateDirection j) + (s - t) • hardyCoordinateDirection j =
            x + (t + (s - t)) • hardyCoordinateDirection j := by
              rw [add_smul, add_assoc]
        _ = x + s • hardyCoordinateDirection j :=
          congrArg (fun a : ℝ => x + a • hardyCoordinateDirection j) (by ring)
    rw [hPoint]
  rw [hFunction] at hAt
  simpa only [centeredCube3RadialCutoffRegularizedFluxDerivativeSlice, q] using! hAt

/-- The absolute value of an individual coordinate divergence is bounded by the
same regularized weight as the squared field components. -/
lemma hardyRegularizedCoordinateDivergence_abs_le_weight
    {eps : ℝ} (heps : 0 < eps)
    (x : CenteredCube3Ambient) (j : Fin 3) :
    |hardyRegularizedCoordinateDivergence eps j x| ≤ hardyRegularizedWeight eps x := by
  have hEq : hardyRegularizedCoordinateDivergence eps j x =
      hardyRegularizedWeight eps x -
        2 * (hardyRegularizedFieldComponent eps j x) ^ 2 := by
    simpa only [hardyRegularizedWeight, hardyRegularizedFieldComponent,
      div_pow, mul_div_assoc] using
      hardyRegularizedCoordinateDivergence_eq heps j x
  have hSq := hardyRegularizedFieldComponent_sq_le_weight heps x j
  have hSq0 := sq_nonneg (hardyRegularizedFieldComponent eps j x)
  rw [hEq]
  apply abs_le.mpr
  constructor <;> linarith

/-- Pointwise domination of the full derivative density by weighted wave energy
and ordinary gradient energy. -/
lemma hardyRegularizedFluxDerivative_norm_le
    {eps : ℝ} (heps : 0 < eps) (j : Fin 3)
    (u v : CenteredCube3Ambient → ℂ) (x : CenteredCube3Ambient) :
    ‖hardyRegularizedFluxDerivative eps j u v x‖ ≤
      2 * (hardyRegularizedWeight eps x * ‖u x‖ ^ 2) + ‖v x‖ ^ 2 := by
  have hFirst :
      |hardyRegularizedCoordinateDivergence eps j x * ‖u x‖ ^ 2| ≤
        hardyRegularizedWeight eps x * ‖u x‖ ^ 2 := by
    rw [abs_mul, abs_of_nonneg (sq_nonneg ‖u x‖)]
    exact mul_le_mul_of_nonneg_right
      (hardyRegularizedCoordinateDivergence_abs_le_weight heps x j) (sq_nonneg _)
  have hRe := Complex.abs_re_le_norm (hardyRegularizedComplexCrossTerm eps j u v x)
  have hCross := hardyRegularizedComplexCrossTerm_norm_le heps j u v x
  have hSecond :
      |2 * (hardyRegularizedComplexCrossTerm eps j u v x).re| ≤
        hardyRegularizedWeight eps x * ‖u x‖ ^ 2 + ‖v x‖ ^ 2 := by
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    linarith
  unfold hardyRegularizedFluxDerivative
  rw [Real.norm_eq_abs]
  calc
    |hardyRegularizedCoordinateDivergence eps j x * ‖u x‖ ^ 2 +
        2 * (hardyRegularizedComplexCrossTerm eps j u v x).re| ≤
      |hardyRegularizedCoordinateDivergence eps j x * ‖u x‖ ^ 2| +
        |2 * (hardyRegularizedComplexCrossTerm eps j u v x).re| := abs_add_le _ _
    _ ≤ 2 * (hardyRegularizedWeight eps x * ‖u x‖ ^ 2) + ‖v x‖ ^ 2 := by
      linarith

/-- Measurability of the derivative density requires no differentiability at the
cutoff spheres.  All factors are explicitly measurable. -/
lemma hardyRegularizedFluxDerivative_measurable
    (eps : ℝ) (j : Fin 3) (u v : CenteredCube3Ambient → ℂ)
    (hu : Measurable u) (hv : Measurable v) :
    Measurable (hardyRegularizedFluxDerivative eps j u v) := by
  have hD : Measurable (hardyRegularizedCoordinateDivergence eps j) := by
    unfold hardyRegularizedCoordinateDivergence hardyRegularizedDenominator
      centeredCube3AmbientRadiusSq
    measurability
  have hF : Measurable (hardyRegularizedFieldComponent eps j) := by
    unfold hardyRegularizedFieldComponent hardyRegularizedDenominator
      centeredCube3AmbientRadiusSq
    measurability
  have hStar : Measurable (fun x : CenteredCube3Ambient => (starRingEnd ℂ) (u x)) := by
    simpa [Function.comp_def] using (continuous_star.measurable.comp hu)
  have hCross : Measurable (hardyRegularizedComplexCrossTerm eps j u v) := by
    unfold hardyRegularizedComplexCrossTerm
    exact (hF.complex_ofReal.mul hStar).mul hv
  have hRe : Measurable (fun x : CenteredCube3Ambient =>
      (hardyRegularizedComplexCrossTerm eps j u v x).re) := by
    simpa only [Function.comp_def] using (Complex.continuous_re.measurable.comp hCross)
  have hSq : Measurable (fun x : CenteredCube3Ambient => ‖u x‖ ^ 2) :=
    hu.norm.pow_const 2
  unfold hardyRegularizedFluxDerivative
  exact (hD.mul hSq).add (measurable_const.mul hRe)

/-- Zero extension preserves any nonnegative pointwise bound. -/
lemma centeredCube3ZeroExtension_norm_le
    (g : CenteredCube3 → ℂ) {C : ℝ}
    (hC : 0 ≤ C) (hg : ∀ y : CenteredCube3, ‖g y‖ ≤ C)
    (x : CenteredCube3Ambient) :
    ‖centeredCube3ZeroExtension g x‖ ≤ C := by
  classical
  by_cases hx : x ∈ centeredCube3AmbientSet
  · let y : CenteredCube3 := ⟨x, hx⟩
    have hValue : centeredCube3ZeroExtension g x = g y :=
      centeredCube3ZeroExtension_subtype g y
    rw [hValue]
    exact hg y
  · rw [centeredCube3ZeroExtension_eq_zero_of_not_mem g x hx]
    simpa only [norm_zero] using hC

/-- A coefficient-dependent bound for one raw gradient component.  It is used
only to prove interval integrability, not in the final Hardy constant. -/
noncomputable def centeredCube3RadialCutoffGradientSupBound
    {α : Type} [Fintype α]
    (rho R : ℝ) (index : α → Lattice3) (f : α → ℂ) (j : Fin 3) : ℝ :=
  finiteSupportL1Norm (torus3FourierPartialCoeff index f j) +
    (1 / (R - rho)) * finiteSupportL1Norm f

lemma centeredCube3RadialCutoffGradientSupBound_nonneg
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) (j : Fin 3) :
    0 ≤ centeredCube3RadialCutoffGradientSupBound rho R index f j := by
  unfold centeredCube3RadialCutoffGradientSupBound
  exact add_nonneg (finiteSupportL1Norm_nonneg _)
    (mul_nonneg (one_div_nonneg.mpr (le_of_lt (sub_pos.mpr hRhoR)))
      (finiteSupportL1Norm_nonneg f))

/-- The actual ambient wave is uniformly bounded by the finite coefficient
`l1` norm, including at all crossing points. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_norm_le_l1
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) (x : CenteredCube3Ambient) :
    ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ≤
      finiteSupportL1Norm f := by
  change ‖centeredCube3ZeroExtension
    (centeredCube3RadialCutoffWaveFunction rho R index f) x‖ ≤ finiteSupportL1Norm f
  refine centeredCube3ZeroExtension_norm_le _ (finiteSupportL1Norm_nonneg f) ?_ x
  intro y
  unfold centeredCube3RadialCutoffWaveFunction
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (centeredCube3RadialCutoff_nonneg hRhoR y)]
  calc
    centeredCube3RadialCutoff rho R y *
        ‖torus3FourierContinuousPolynomial index f (unitTorus3CenteredEquiv.symm y)‖ ≤
      1 * ‖torus3FourierContinuousPolynomial index f (unitTorus3CenteredEquiv.symm y)‖ :=
        mul_le_mul_of_nonneg_right (centeredCube3RadialCutoff_le_one hRhoR y)
          (norm_nonneg _)
    _ ≤ finiteSupportL1Norm f := by
      simpa only [one_mul] using
        torus3FourierContinuousPolynomial_pointwise_norm_le_l1
          index f (unitTorus3CenteredEquiv.symm y)

/-- The raw gradient is uniformly bounded despite its jumps at the spheres. -/
lemma centeredCube3RadialCutoffRawGradientZeroExtension_norm_le_supBound
    {α : Type} [Fintype α]
    {rho R : ℝ} (hrho : 0 < rho) (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) (j : Fin 3)
    (x : CenteredCube3Ambient) :
    ‖centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x‖ ≤
      centeredCube3RadialCutoffGradientSupBound rho R index f j := by
  change ‖centeredCube3ZeroExtension
      (centeredCube3RadialCutoffRawGradientFunction rho R index f j) x‖ ≤
    centeredCube3RadialCutoffGradientSupBound rho R index f j
  refine centeredCube3ZeroExtension_norm_le _
    (centeredCube3RadialCutoffGradientSupBound_nonneg hRhoR index f j) ?_ x
  intro y
  have hGap0 : 0 ≤ (1 / (R - rho) : ℝ) :=
    one_div_nonneg.mpr (le_of_lt (sub_pos.mpr hRhoR))
  have hMain : ‖centeredCube3RadialCutoffMainGradientFunction rho R index f j y‖ ≤
      finiteSupportL1Norm (torus3FourierPartialCoeff index f j) := by
    unfold centeredCube3RadialCutoffMainGradientFunction
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (centeredCube3RadialCutoff_nonneg hRhoR y)]
    calc
      centeredCube3RadialCutoff rho R y *
          ‖torus3FourierPartialContinuousPolynomial index f j
            (unitTorus3CenteredEquiv.symm y)‖ ≤
        1 * ‖torus3FourierPartialContinuousPolynomial index f j
          (unitTorus3CenteredEquiv.symm y)‖ :=
            mul_le_mul_of_nonneg_right (centeredCube3RadialCutoff_le_one hRhoR y)
              (norm_nonneg _)
      _ ≤ finiteSupportL1Norm (torus3FourierPartialCoeff index f j) := by
        simpa only [one_mul, torus3FourierPartialContinuousPolynomial] using
          torus3FourierContinuousPolynomial_pointwise_norm_le_l1
            index (torus3FourierPartialCoeff index f j) (unitTorus3CenteredEquiv.symm y)
  have hCut : ‖centeredCube3RadialCutoffCutoffGradientFunction rho R index f j y‖ ≤
      (1 / (R - rho)) * finiteSupportL1Norm f := by
    unfold centeredCube3RadialCutoffCutoffGradientFunction
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul
      (centeredCube3RadialCutoffPartial_abs_le hrho hRhoR j y)
      (torus3FourierContinuousPolynomial_pointwise_norm_le_l1
        index f (unitTorus3CenteredEquiv.symm y))
      (norm_nonneg _) hGap0
  unfold centeredCube3RadialCutoffRawGradientFunction centeredCube3RadialCutoffGradientSupBound
  exact le_trans (norm_add_le _ _) (add_le_add hMain hCut)

/-- Measurability of the actual derivative density, including its specified
values on the exceptional spheres. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivative_measurable
    {α : Type} [Fintype α]
    (rho R eps : ℝ) (index : α → Lattice3) (f : α → ℂ) (j : Fin 3) :
    Measurable (centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j) := by
  have hu : Measurable (centeredCube3RadialCutoffWaveZeroExtension rho R index f) := by
    change Measurable (centeredCube3ZeroExtension
      (centeredCube3RadialCutoffWaveFunction rho R index f))
    exact centeredCube3ZeroExtension_measurable _
      (centeredCube3RadialCutoffWaveFunction_measurable rho R index f)
  have hv : Measurable
      (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) := by
    change Measurable (centeredCube3ZeroExtension
      (centeredCube3RadialCutoffRawGradientFunction rho R index f j))
    exact centeredCube3ZeroExtension_measurable _
      (centeredCube3RadialCutoffRawGradientFunction_measurable rho R index f j)
  unfold centeredCube3RadialCutoffRegularizedFluxDerivative
  exact hardyRegularizedFluxDerivative_measurable eps j _ _ hu hv

/-- Ambient integrability of the actual flux derivative, ready for the later
transverse Fubini step. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivative_integrable
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) (j : Fin 3) :
    Integrable (centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j)
      volume := by
  have hWave := centeredCube3RadialCutoffWaveZeroExtension_regularized_integrable
    heps hRhoR index f
  have hGradient := centeredCube3RadialCutoffRawGradientZeroExtension_sq_integrable
    hrho hRhoR index f j
  have hMajor : Integrable
      (fun x : CenteredCube3Ambient =>
        2 * (hardyRegularizedWeight eps x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) +
        ‖centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x‖ ^ 2)
      volume := (hWave.const_mul 2).add hGradient
  apply Integrable.mono' hMajor
    (centeredCube3RadialCutoffRegularizedFluxDerivative_measurable
      rho R eps index f j).aestronglyMeasurable
  filter_upwards with x
  exact hardyRegularizedFluxDerivative_norm_le heps j
    (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
    (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x

/-- The density vanishes on the closed exterior of the support ball, including
its boundary, because both terms contain the wave. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivative_eq_zero_of_outer_le
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (eps : ℝ) (index : α → Lattice3) (f : α → ℂ) (j : Fin 3)
    (x : CenteredCube3Ambient) (hOuter : R ≤ centeredCube3AmbientRadius x) :
    centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j x = 0 := by
  unfold centeredCube3RadialCutoffRegularizedFluxDerivative
    hardyRegularizedFluxDerivative hardyRegularizedComplexCrossTerm
  rw [centeredCube3RadialCutoffWaveZeroExtension_eq_zero_of_outer_le
    hRhoR index f x hOuter]
  simp

/-- A uniform bound for the actual flux derivative.  Its dependence on the
finite coefficients and on `eps` is harmless: it is used for integrability,
not as the quantitative Hardy estimate. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivative_norm_le
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) (j : Fin 3)
    (x : CenteredCube3Ambient) :
    ‖centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j x‖ ≤
      2 * ((1 / eps ^ 2) * (finiteSupportL1Norm f) ^ 2) +
        (centeredCube3RadialCutoffGradientSupBound rho R index f j) ^ 2 := by
  have huBound := centeredCube3RadialCutoffWaveZeroExtension_norm_le_l1 hRhoR index f x
  have hvBound := centeredCube3RadialCutoffRawGradientZeroExtension_norm_le_supBound
    hrho hRhoR index f j x
  have huSq : ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2 ≤
      (finiteSupportL1Norm f) ^ 2 :=
    sq_le_sq_of_nonneg (norm_nonneg _) huBound
  have hvSq : ‖centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x‖ ^ 2 ≤
      (centeredCube3RadialCutoffGradientSupBound rho R index f j) ^ 2 :=
    sq_le_sq_of_nonneg (norm_nonneg _) hvBound
  have hWeighted : hardyRegularizedWeight eps x *
      ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2 ≤
      (1 / eps ^ 2) * (finiteSupportL1Norm f) ^ 2 :=
    mul_le_mul (hardyRegularizedWeight_le_inv_eps_sq heps x) huSq
      (sq_nonneg _) (by positivity)
  exact le_trans
    (hardyRegularizedFluxDerivative_norm_le heps j
      (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
      (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x)
    (add_le_add (mul_le_mul_of_nonneg_left hWeighted (by norm_num)) hvSq)

/-- Every bounded coordinate interval has an integrable derivative density.
Unlike an application of Fubini alone, this result holds for every line. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivativeSlice_intervalIntegrable
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3)
    (a b : ℝ) (hab : a ≤ b) :
    IntervalIntegrable
      (centeredCube3RadialCutoffRegularizedFluxDerivativeSlice rho R eps index f x j)
      volume a b := by
  let B : ℝ := 2 * ((1 / eps ^ 2) * (finiteSupportL1Norm f) ^ 2) +
    (centeredCube3RadialCutoffGradientSupBound rho R index f j) ^ 2
  have hLine : Continuous (fun t : ℝ => x + t • hardyCoordinateDirection j) := by
    fun_prop
  have hMeas : Measurable
      (centeredCube3RadialCutoffRegularizedFluxDerivativeSlice rho R eps index f x j) := by
    unfold centeredCube3RadialCutoffRegularizedFluxDerivativeSlice
    exact (centeredCube3RadialCutoffRegularizedFluxDerivative_measurable
      rho R eps index f j).comp hLine.measurable
  have hMajor : IntegrableOn (fun _ : ℝ => B) (Set.Icc a b) volume :=
    (continuous_const : Continuous (fun _ : ℝ => B)).continuousOn.integrableOn_Icc
  have hOn : IntegrableOn
      (centeredCube3RadialCutoffRegularizedFluxDerivativeSlice rho R eps index f x j)
      (Set.Icc a b) volume := by
    apply Integrable.mono' hMajor hMeas.aestronglyMeasurable
    filter_upwards with t
    exact centeredCube3RadialCutoffRegularizedFluxDerivative_norm_le
      hrho hRhoR heps index f j (x + t • hardyCoordinateDirection j)
  exact (intervalIntegrable_iff_integrableOn_Icc_of_le hab).2 hOn

/-- Fundamental theorem of calculus for the actual flux across the finite
cutoff crossing set.  Both continuity and derivative integrability have been
proved above, rather than added as hypotheses. -/
lemma centeredCube3RadialCutoffRegularizedFluxSlice_integral_derivative
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3)
    (a b : ℝ) (hab : a ≤ b) :
    (∫ t in a..b,
      centeredCube3RadialCutoffRegularizedFluxDerivativeSlice rho R eps index f x j t) =
      centeredCube3RadialCutoffRegularizedFluxSlice rho R eps index f x j b -
        centeredCube3RadialCutoffRegularizedFluxSlice rho R eps index f x j a := by
  apply MeasureTheory.integral_eq_of_hasDerivAt_off_countable_of_le
    (centeredCube3RadialCutoffRegularizedFluxSlice rho R eps index f x j)
    (centeredCube3RadialCutoffRegularizedFluxDerivativeSlice rho R eps index f x j)
    hab (hardyRadialSliceExceptionalSet_finite rho R x j).countable
  · exact (centeredCube3RadialCutoffRegularizedFluxSlice_continuous
      hRhoR hOuterHalf heps index f x j).continuousOn
  · intro t ht
    simpa only using!
      centeredCube3RadialCutoffRegularizedFluxSlice_hasDerivAt_of_not_mem
        hrho hRhoR hOuterHalf heps index f x j t ht.2
  · exact centeredCube3RadialCutoffRegularizedFluxDerivativeSlice_intervalIntegrable
      hrho hRhoR heps index f x j a b hab

/-- Coordinatewise regularized integration by parts: the total derivative of
the flux integrates to zero over the explicit support interval.  This includes
internal boundary cancellation at crossings and tangencies of both spheres. -/
lemma centeredCube3RadialCutoffRegularizedFluxSlice_integral_derivative_eq_zero
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3) :
    (∫ t in (-R - x j)..(R - x j),
      centeredCube3RadialCutoffRegularizedFluxDerivativeSlice rho R eps index f x j t) =
      0 := by
  have hab : -R - x j ≤ R - x j := by linarith
  rw [centeredCube3RadialCutoffRegularizedFluxSlice_integral_derivative
    hrho hRhoR hOuterHalf heps index f x j (-R - x j) (R - x j) hab]
  have hEnds := centeredCube3RadialCutoffRegularizedFluxSlice_endpoints
    hRhoR eps index f x j
  simp only [hEnds.1, hEnds.2, sub_self]

/-!
## One-hundred-fifth milestone

For the original zero-extended cutoff wave `U` and original raw gradient `G_j`,
the actual derivative of `J_j = F_eps,j * |U|^2` is now

`D_j = partial_j F_eps,j * |U|^2 + 2 * Re(F_eps,j * conj(U) * G_j)`

at every coordinate parameter outside the finite radial crossing set.  The
squared-norm rule includes zeros of `U`, so no further exceptional set appears.

The coefficient-dependent pointwise bounds prove that `D_j` is integrable on
every bounded coordinate interval, including its values at all crossings.  The
finite-exception fundamental theorem of calculus, combined with milestone 104's
continuity and endpoint values, then gives

`integral_{-R-x_j}^{R-x_j} D_j(x + t e_j) dt = 0`.

This is an actual coordinatewise integration-by-parts identity, not an interface
assuming that identity.  The auxiliary supremum bounds are used only for
integrability; they do not replace the sharp energy estimates needed by Hardy.

The remaining steps are transverse integration, summation over the three
coordinates, the energy Cauchy--Schwarz bound, and the regularization limit.
-/

end

