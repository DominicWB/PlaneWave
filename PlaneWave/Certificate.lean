-- BEGIN RELEASE SOURCE 144: Coulomb systems and signed exchange sectors
section ReleaseMilestone144

/-!
# Milestone 144: Coulomb systems, signed exchange sectors and diagonal Hamiltonians

A periodic Coulomb system has quantum particles, each with a mass, a charge and a
species, and static (clamped) nuclei. Particles of one species are identical: they
have the same mass and charge, and the same exchange statistics. The Born--Oppenheimer
problem is the case whose only quantum particles are electrons; the non-BO problem has
no static nuclei. Exchange sectors carry a sign for each particle, `-1` for a fermion
and `+1` for a boson.
-/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-! ## Particle data -/

/-- The quantum particles of a periodic Coulomb system, in atomic units with the
electron mass one. Identical particles share a species, and with it their mass,
charge and statistics. -/
structure CoulombParticles (eta : ℕ) where
  mass : Fin eta → ℝ
  one_le_mass : ∀ a, 1 ≤ mass a
  charge : Fin eta → ℝ
  species : Fin eta → ℕ
  fermion : ℕ → Bool
  mass_eq : ∀ a b, species a = species b → mass a = mass b
  charge_eq : ∀ a b, species a = species b → charge a = charge b

namespace CoulombParticles

variable {eta : ℕ} (P : CoulombParticles eta)

/-- The exchange sign of a particle: `-1` for a fermion, `+1` for a boson. -/
def sign (a : Fin eta) : ℂ := if P.fermion (P.species a) then -1 else 1

lemma mass_pos (a : Fin eta) : 0 < P.mass a := lt_of_lt_of_le one_pos (P.one_le_mass a)

/-- A labelling of the particles is admissible when particles with equal labels are
of the same species. -/
def IsAdmissible (lab : Fin eta → ℕ) : Prop :=
  ∀ i j : Fin eta, lab i = lab j → P.species i = P.species j

/-- The largest mass, at least one. -/
def maxMass : ℝ := Finset.univ.fold max 1 P.mass

lemma one_le_maxMass : 1 ≤ P.maxMass := by
  unfold maxMass
  exact (Finset.le_fold_max _).mpr (Or.inl le_rfl)

lemma mass_le_maxMass (a : Fin eta) : P.mass a ≤ P.maxMass := by
  unfold maxMass
  exact (Finset.le_fold_max _).mpr (Or.inr ⟨a, Finset.mem_univ a, le_rfl⟩)

/-- The mass moment `S_r = Σ_a m_a ^ r`. -/
def massMoment (r : ℕ) : ℝ := ∑ a, P.mass a ^ r

/-- Electrons only: mass one, charge `-1`, one fermionic species. -/
def electrons (eta : ℕ) : CoulombParticles eta where
  mass := fun _ => 1
  one_le_mass := fun _ => le_rfl
  charge := fun _ => -1
  species := fun _ => 0
  fermion := fun _ => true
  mass_eq := fun _ _ _ => rfl
  charge_eq := fun _ _ _ => rfl

@[simp] lemma electrons_mass (eta : ℕ) (a : Fin eta) : (electrons eta).mass a = 1 := rfl
@[simp] lemma electrons_charge (eta : ℕ) (a : Fin eta) : (electrons eta).charge a = -1 := rfl
@[simp] lemma electrons_sign (eta : ℕ) (a : Fin eta) : (electrons eta).sign a = -1 := rfl

end CoulombParticles

/-- A periodic Coulomb system: quantum particles and static nuclei. -/
structure CoulombSystem (eta : ℕ) (ν : Type*) extends CoulombParticles eta where
  nuclei : FiniteBONuclearData ν

/-- The Born--Oppenheimer system: electrons and clamped nuclei. -/
def CoulombSystem.bo {ν : Type*} (eta : ℕ) (data : FiniteBONuclearData ν) :
    CoulombSystem eta ν :=
  { CoulombParticles.electrons eta with nuclei := data }

@[simp] lemma CoulombSystem.bo_mass {ν : Type*} (eta : ℕ) (data : FiniteBONuclearData ν)
    (a : Fin eta) : (CoulombSystem.bo eta data).mass a = 1 := rfl
@[simp] lemma CoulombSystem.bo_charge {ν : Type*} (eta : ℕ) (data : FiniteBONuclearData ν)
    (a : Fin eta) : (CoulombSystem.bo eta data).charge a = -1 := rfl
@[simp] lemma CoulombSystem.bo_nuclei {ν : Type*} (eta : ℕ) (data : FiniteBONuclearData ν) :
    (CoulombSystem.bo eta data).nuclei = data := rfl

/-! ## Signed exchange sectors -/

/-- The exchange sector of the labelling `lab` with exchange signs `sgn`: exchanging
two distinct registers with equal labels multiplies a coefficient by the sign of the
particle. -/
def IsSectorCoeff {eta : ℕ} {μ : Type*} (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ)
    (coeff : FourierConfig eta μ → ℂ) : Prop :=
  ∀ i j : Fin eta, i ≠ j → lab i = lab j → ∀ p : FourierConfig eta μ,
    coeff (swapConfig i j p) = sgn i * coeff p

/-- The same condition on a finite coefficient vector. -/
def IsSectorVector {eta : ℕ} (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ) {μ : Type*}
    [Fintype μ] (u : EuclideanSpace ℂ (FourierConfig eta μ)) : Prop :=
  IsSectorCoeff sgn lab (fun p => u.ofLp p)

lemma fullCoeffVector_isSector {eta : ℕ} {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ}
    {μ : Type*} [Fintype μ] (coeff : FourierConfig eta μ → ℂ)
    (h : IsSectorCoeff sgn lab coeff) :
    IsSectorVector sgn lab (fullCoeffVector coeff) := h

/-- The retained coefficient mask preserves every exchange sector. -/
lemma retainedGalerkinVector_isSector {eta : ℕ} {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ}
    {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (h : IsSectorCoeff sgn lab coeff) :
    IsSectorVector sgn lab (retainedGalerkinVector K kabs coeff) := by
  classical
  intro i j hij hlab p
  have hMem := discardedConfigFinset_swap_mem_iff K kabs i j p
  by_cases hp : p ∈ discardedConfigFinset K kabs
  · have hs := hMem.mpr hp
    simp only [retainedGalerkinVector_apply, if_pos hp, if_pos hs, mul_zero]
  · have hs : swapConfig i j p ∉ discardedConfigFinset K kabs :=
      fun hs => hp (hMem.mp hs)
    simp only [retainedGalerkinVector_apply, if_neg hp, if_neg hs]
    exact h i j hij hlab p

/-- `E` is a variational lower bound on the sector. -/
def IsSectorGroundEnergy {eta : ℕ} (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ) {μ : Type*}
    [Fintype μ]
    (H : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (E : ℝ) : Prop :=
  ∀ u : EuclideanSpace ℂ (FourierConfig eta μ), IsSectorVector sgn lab u →
    E * ‖u‖ ^ 2 ≤ (inner ℂ u (H u)).re

/-- The Ritz minimum on the cube intersected with the sector. -/
def IsSectorCubicGalerkinGroundEnergy
    (eta : ℕ) (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ) (K g : ℝ) (count : ℕ)
    (H : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) (EN : ℝ) : Prop :=
  (∀ u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
    IsSectorVector sgn lab u → IsCubicRetainedVector eta K g count u →
      EN * ‖u‖ ^ 2 ≤ (inner ℂ u (H u)).re) ∧
  ∃ phi : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
    IsSectorVector sgn lab phi ∧ IsCubicRetainedVector eta K g count phi ∧
      ‖phi‖ = 1 ∧ (inner ℂ phi (H phi)).re = EN

lemma sector_ground_le_cubic_galerkin
    (eta : ℕ) {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ} (K g E EN : ℝ) (count : ℕ)
    (H : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (hGround : IsSectorGroundEnergy sgn lab H E)
    (hGalerkin : IsSectorCubicGalerkinGroundEnergy eta sgn lab K g count H EN) : E ≤ EN := by
  obtain ⟨phi, hF, _hC, hN, hR⟩ := hGalerkin.2
  have h := hGround phi hF
  rw [hN, one_pow, mul_one, hR] at h
  exact h

/-! ## Hamiltonians with a diagonal kinetic symbol -/

/-- Multiplication of Fourier coefficients by a real symbol. -/
def diagOperator {eta : ℕ} {μ : Type*} [Fintype μ] (A : FourierConfig eta μ → ℝ) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ) where
  toFun := fun u => diagMul A u
  map_add' := by
    intro u v
    ext p
    simp [diagMul_apply]
    ring
  map_smul' := by
    intro z u
    ext p
    simp [diagMul_apply]
    ring

@[simp] lemma diagOperator_apply {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (u : EuclideanSpace ℂ (FourierConfig eta μ))
    (p : FourierConfig eta μ) :
    (diagOperator A u).ofLp p = (A p : ℂ) * u.ofLp p := rfl

/-- The Hamiltonian `(1/2) A + W` with a real diagonal kinetic symbol `A`. -/
def diagHamiltonian {eta : ℕ} {μ : Type*} [Fintype μ] (A : FourierConfig eta μ → ℝ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ)) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ) :=
  (1 / 2 : ℂ) • diagOperator A + W

@[simp] lemma diagHamiltonian_apply {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) (p : FourierConfig eta μ) :
    (diagHamiltonian A W u).ofLp p =
      (1 / 2 : ℂ) * (A p : ℂ) * u.ofLp p + (W u).ofLp p := by
  simp [diagHamiltonian]
  ring

lemma diagOperator_isSymmetric {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) : (diagOperator A).IsSymmetric := by
  intro x y
  rw [PiLp.inner_apply, PiLp.inner_apply]
  apply Finset.sum_congr rfl
  intro p _
  rw [diagOperator_apply, diagOperator_apply]
  have hcoord : inner ℂ ((A p : ℂ) • x.ofLp p) (y.ofLp p) =
      inner ℂ (x.ofLp p) ((A p : ℂ) • y.ofLp p) := by
    rw [inner_smul_left, inner_smul_right]
    simp
  simpa [smul_eq_mul] using hcoord

lemma diagHamiltonian_isSymmetric {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (hWSym : W.IsSymmetric) : (diagHamiltonian A W).IsSymmetric := by
  unfold diagHamiltonian
  exact LinearMap.IsSymmetric.add
    (LinearMap.IsSymmetric.smul half_complex_star (diagOperator_isSymmetric A)) hWSym

/-- The eigenvector equation in Fourier coordinates. -/
lemma diag_fourier_eigen_equation {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (E : ℝ)
    (hEig : diagHamiltonian A W (fullCoeffVector coeff) = (E : ℂ) • fullCoeffVector coeff) :
    ∀ p : FourierConfig eta μ,
      (A p : ℂ) * coeff p = (2 : ℂ) * ((E : ℂ) * coeff p - operatorPotentialCoeff W coeff p) := by
  intro p
  have h := congrArg (fun v : EuclideanSpace ℂ (FourierConfig eta μ) => v.ofLp p) hEig
  simp only [diagHamiltonian_apply, PiLp.smul_apply, smul_eq_mul] at h
  have hc : (fullCoeffVector coeff).ofLp p = coeff p := rfl
  rw [hc] at h
  unfold operatorPotentialCoeff
  linear_combination 2 * h

/-! ## The mass-weighted kinetic symbol -/

/-- The kinetic symbol `Σ_a kabs(p_a)² / m_a`. The Hamiltonian is `(1/2)` times it plus
the potential; with all masses one it is the Sobolev symbol `boKineticSymbol`. -/
def massKineticSymbol {eta : ℕ} {μ : Type*} (m : Fin eta → ℝ) (kabs : μ → ℝ)
    (p : FourierConfig eta μ) : ℝ :=
  ∑ a : Fin eta, kabs (p a) ^ 2 / m a

lemma massKineticSymbol_one {eta : ℕ} {μ : Type*} (kabs : μ → ℝ) :
    massKineticSymbol (eta := eta) (fun _ => 1) kabs = boKineticSymbol kabs := by
  funext p
  simp [massKineticSymbol, boKineticSymbol]

lemma massKineticSymbol_nonneg {eta : ℕ} {μ : Type*} {m : Fin eta → ℝ}
    (hm : ∀ a, 0 < m a) (kabs : μ → ℝ) (p : FourierConfig eta μ) :
    0 ≤ massKineticSymbol m kabs p :=
  Finset.sum_nonneg fun a _ => div_nonneg (sq_nonneg _) (hm a).le

/-- With masses at least one, the mass-weighted symbol is at most the Sobolev symbol. -/
lemma massKineticSymbol_le_boKineticSymbol {eta : ℕ} {μ : Type*} {m : Fin eta → ℝ}
    (hm : ∀ a, 1 ≤ m a) (kabs : μ → ℝ) (p : FourierConfig eta μ) :
    massKineticSymbol m kabs p ≤ boKineticSymbol kabs p := by
  unfold massKineticSymbol boKineticSymbol
  apply Finset.sum_le_sum
  intro a _
  exact div_le_self (sq_nonneg _) (hm a)

/-- With masses at most `M`, the Sobolev symbol is at most `M` times the mass-weighted one. -/
lemma boKineticSymbol_le_mul_massKineticSymbol {eta : ℕ} {μ : Type*} {m : Fin eta → ℝ}
    {M : ℝ} (hm : ∀ a, 0 < m a) (hM : ∀ a, m a ≤ M) (kabs : μ → ℝ)
    (p : FourierConfig eta μ) :
    boKineticSymbol kabs p ≤ M * massKineticSymbol m kabs p := by
  unfold massKineticSymbol boKineticSymbol
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro a _
  have hma := hm a
  rw [mul_div_assoc', le_div_iff₀ hma]
  nlinarith [sq_nonneg (kabs (p a)), hM a]

/-- One particle's squared momentum is at most its mass times the mass-weighted symbol. -/
lemma component_sq_le_mass_mul_massKineticSymbol {eta : ℕ} {μ : Type*} {m : Fin eta → ℝ}
    (hm : ∀ a, 0 < m a) (kabs : μ → ℝ) (p : FourierConfig eta μ) (r : Fin eta) :
    kabs (p r) ^ 2 ≤ m r * massKineticSymbol m kabs p := by
  have hterm : kabs (p r) ^ 2 / m r ≤ massKineticSymbol m kabs p := by
    unfold massKineticSymbol
    exact Finset.single_le_sum (f := fun a => kabs (p a) ^ 2 / m a)
      (fun a _ => div_nonneg (sq_nonneg _) (hm a).le) (Finset.mem_univ r)
  have hmr := hm r
  rw [div_le_iff₀ hmr] at hterm
  linarith

/-- On the tail of particle `r`, the mass-weighted symbol is at least `K² / m_r`. -/
lemma massKineticSymbol_cutoff_T {eta : ℕ} {μ : Type*} {m : Fin eta → ℝ}
    (hm : ∀ a, 0 < m a) (K : ℝ) (kabs : μ → ℝ) (r : Fin eta) (hK0 : 0 ≤ K)
    (p : FourierConfig eta μ) (hp : K < kabs (p r)) :
    K ^ 2 ≤ m r * massKineticSymbol m kabs p := by
  have hsq : K ^ 2 ≤ kabs (p r) ^ 2 := by nlinarith
  exact hsq.trans (component_sq_le_mass_mul_massKineticSymbol hm kabs p r)

/-- On the tail of particle `r`, every momentum is controlled by the mass-weighted symbol
with the weight `√(m_r m_b)` (the manuscript's eq. `nbo-weights`). -/
lemma massKineticSymbol_cutoff_S {eta : ℕ} {μ : Type*} {m : Fin eta → ℝ}
    (hm : ∀ a, 0 < m a) (K : ℝ) (kabs : μ → ℝ) (r : Fin eta) (hK0 : 0 ≤ K)
    (hkabs0 : ∀ u, 0 ≤ kabs u) (b : Fin eta)
    (p : FourierConfig eta μ) (hp : K < kabs (p r)) :
    K * kabs (p b) ≤ Real.sqrt (m r * m b) * massKineticSymbol m kabs p := by
  have hmr := hm r
  have hmb := hm b
  have hA0 := massKineticSymbol_nonneg hm kabs p
  have hkr := hkabs0 (p r)
  have hkb := hkabs0 (p b)
  by_cases hrb : r = b
  · subst hrb
    have hsq : Real.sqrt (m r * m r) = m r := by
      rw [Real.sqrt_mul_self hmr.le]
    rw [hsq]
    have h1 := component_sq_le_mass_mul_massKineticSymbol hm kabs p r
    nlinarith
  · -- AM-GM on the two particles r and b
    have hpair : kabs (p r) ^ 2 / m r + kabs (p b) ^ 2 / m b ≤
        massKineticSymbol m kabs p := by
      unfold massKineticSymbol
      have hsub : ({r, b} : Finset (Fin eta)) ⊆ Finset.univ := Finset.subset_univ _
      have h := Finset.sum_le_sum_of_subset_of_nonneg hsub
        (f := fun a => kabs (p a) ^ 2 / m a)
        (fun a _ _ => div_nonneg (sq_nonneg _) (hm a).le)
      rwa [Finset.sum_pair hrb] at h
    set s := Real.sqrt (m r * m b) with hs
    have hs0 : 0 < s := Real.sqrt_pos.mpr (mul_pos hmr hmb)
    have hamgm : 2 * kabs (p r) * kabs (p b) ≤
        s * (kabs (p r) ^ 2 / m r + kabs (p b) ^ 2 / m b) := by
      set a := Real.sqrt (m r) with ha
      set c := Real.sqrt (m b) with hc
      have ha0 : 0 < a := Real.sqrt_pos.mpr hmr
      have hc0 : 0 < c := Real.sqrt_pos.mpr hmb
      have ha2 : m r = a ^ 2 := (Real.sq_sqrt hmr.le).symm
      have hc2 : m b = c ^ 2 := (Real.sq_sqrt hmb.le).symm
      have hsac : s = a * c := by rw [hs]; exact Real.sqrt_mul hmr.le (m b)
      rw [hsac, ha2, hc2]
      have key : a * c * (kabs (p r) ^ 2 / a ^ 2 + kabs (p b) ^ 2 / c ^ 2) -
          2 * kabs (p r) * kabs (p b) = (c * kabs (p r) - a * kabs (p b)) ^ 2 / (a * c) := by
        field_simp
        ring
      have hnn : 0 ≤ (c * kabs (p r) - a * kabs (p b)) ^ 2 / (a * c) :=
        div_nonneg (sq_nonneg _) (by positivity)
      linarith
    have h2 : K * kabs (p b) ≤ 2 * kabs (p r) * kabs (p b) := by nlinarith
    calc K * kabs (p b) ≤ 2 * kabs (p r) * kabs (p b) := h2
      _ ≤ s * (kabs (p r) ^ 2 / m r + kabs (p b) ^ 2 / m b) := hamgm
      _ ≤ s * massKineticSymbol m kabs p := mul_le_mul_of_nonneg_left hpair hs0.le

/-! ## The variational sandwich for a diagonal Hamiltonian -/

/-- The real part of `⟨z, a z⟩` for a real scalar `a`. -/
lemma inner_real_mul_re (a : ℝ) (z : ℂ) : (inner ℂ z ((a : ℂ) * z)).re = a * ‖z‖ ^ 2 := by
  rw [← smul_eq_mul, inner_smul_right, inner_self_eq_norm_sq_to_K]
  simp [← Complex.ofReal_pow]

/-- The kinetic form of the discarded vector is at most its derivative mass. -/
lemma discarded_diag_kinetic_inner_re_le {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ) (A : FourierConfig eta μ → ℝ)
    (hA : ∀ p, A p ≤ boKineticSymbol kabs p) :
    (inner ℂ (discardedGalerkinVector K kabs coeff)
        (diagOperator A (discardedGalerkinVector K kabs coeff))).re ≤
      discardedDerivSq K kabs coeff := by
  classical
  have hkin := discarded_kinetic_inner K kabs coeff
  set delta := discardedGalerkinVector K kabs coeff with hdelta
  have hre : (inner ℂ delta (boKineticOperator kabs delta)).re = discardedDerivSq K kabs coeff := by
    rw [hkin]; simp
  rw [← hre]
  rw [PiLp.inner_apply, PiLp.inner_apply, Complex.re_sum, Complex.re_sum]
  apply Finset.sum_le_sum
  intro p _
  rw [diagOperator_apply, boKineticOperator_apply, inner_real_mul_re, inner_real_mul_re]
  exact mul_le_mul_of_nonneg_right (hA p) (sq_nonneg _)

/-- A potential-form estimate gives the full form estimate needed by the variational
argument, for any nonnegative diagonal symbol below the Sobolev symbol. -/
lemma discarded_full_form_bound_of_potential_diag {eta : ℕ} {μ : Type*} [Fintype μ]
    [DecidableEq μ] (K E Cpot : ℝ) (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (A : FourierConfig eta μ → ℝ) (hA : ∀ p, A p ≤ boKineticSymbol kabs p)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (hPotential : potentialQuadratic W (discardedGalerkinVector K kabs coeff) ≤
      Cpot * discardedH1Sq K kabs coeff) :
    shiftedQuadratic (diagHamiltonian A W) E (discardedGalerkinVector K kabs coeff) ≤
      ((1 / 2 : ℝ) + Cpot + |E|) * discardedH1Sq K kabs coeff := by
  set delta := discardedGalerkinVector K kabs coeff with hdelta
  have hkin := discarded_diag_kinetic_inner_re_le K kabs coeff A hA
  have hnorm : ‖delta‖ ^ 2 = discardedL2Sq K kabs coeff :=
    discardedGalerkinVector_norm_sq K kabs coeff
  have hL0 := discardedL2Sq_nonneg K kabs coeff
  have hD0 := discardedDerivSq_nonneg K kabs coeff
  have hLle := discardedL2Sq_le_discardedH1Sq K kabs coeff
  have hDle := discardedDerivSq_le_discardedH1Sq K kabs coeff
  have hsplit : shiftedQuadratic (diagHamiltonian A W) E delta =
      (1 / 2 : ℝ) * (inner ℂ delta (diagOperator A delta)).re +
        potentialQuadratic W delta - E * discardedL2Sq K kabs coeff := by
    rw [shiftedQuadratic_eq_rayleigh_sub]
    unfold diagHamiltonian potentialQuadratic
    simp only [LinearMap.add_apply, LinearMap.smul_apply, inner_add_right,
      inner_smul_right, Complex.add_re]
    rw [hnorm]
    have hh : ((1 / 2 : ℂ) * inner ℂ delta (diagOperator A delta)).re =
        (1 / 2 : ℝ) * (inner ℂ delta (diagOperator A delta)).re := by
      rw [show (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) by norm_num, Complex.re_ofReal_mul]
    rw [hh]
  rw [hsplit]
  have hminusE : -E * discardedL2Sq K kabs coeff ≤ |E| * discardedH1Sq K kabs coeff := by
    have := neg_le_abs E
    nlinarith [abs_nonneg E]
  nlinarith [hkin, hPotential, hminusE, hDle]

end
end PlaneWaveCertificate

end ReleaseMilestone144
-- END RELEASE SOURCE 144

-- BEGIN RELEASE SOURCE 145: per-particle bootstrap with masses
section ReleaseMilestone145

/-!
# Milestone 145: the per-particle bootstrap with masses

The manuscript's non-BO bootstrap (`app:nbo`, eqs. `nbo-weights`, `nbo-tfinal`,
`nbo-sfinal`, `nbo-assembly`). On the tail of particle `a` the mass-weighted symbol
satisfies `m_a A_m ≥ K²` and `√(m_a m_b) A_m ≥ K kabs(p_b)`. With the absorption
condition `4 m_a |E| ≤ K²` this gives `K² t_a ≤ 4 m_a Λ_a` and
`K s_{a,b} ≤ 4 √(m_a m_b) Λ_a`, and the energy error is at most
`32 C1 Σ_a m_a CW_a² (m_a + S₁) / K³`.
-/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-- The scalar bookkeeping of the per-particle bootstrap with masses. -/
theorem mass_bootstrap_scalar
    (eta : ℕ) (K Eabs rho C1 energyGap q deltaL2Sq deltaH1Sq pnormSq : ℝ)
    (m CW t lam : Fin eta → ℝ) (s : Fin eta → Fin eta → ℝ)
    (hK1 : 1 ≤ K) (hRhoScale : rho ^ 2 * K ≤ 1)
    (hm1 : ∀ a, 1 ≤ m a) (ht0 : ∀ a, 0 ≤ t a)
    (hs0 : ∀ a b, 0 ≤ s a b)
    (hPT : ∀ a, lam a ≤ CW a * rho)
    (hAbsorb : ∀ a, 4 * m a * Eabs ≤ K ^ 2)
    (hBootT : ∀ a, K ^ 2 * t a ≤ 2 * m a * (Eabs * t a + lam a))
    (hBootS : ∀ a b, K * s a b ≤ 2 * Real.sqrt (m a * m b) * (Eabs * t a + lam a))
    (hReductionL2 : deltaL2Sq ≤ ∑ a, t a ^ 2)
    (hReductionH1 : deltaH1Sq ≤ ∑ a, (t a ^ 2 + ∑ b, s a b ^ 2))
    (hPnorm : pnormSq = 1 - deltaL2Sq)
    (hLargeK : 32 * ∑ a, m a ^ 2 * CW a ^ 2 ≤ K ^ 5)
    (hGap0 : 0 ≤ energyGap)
    (hRayleigh : energyGap * pnormSq ≤ q)
    (hKR_form : q ≤ C1 * deltaH1Sq) (hC10 : 0 ≤ C1) :
    (1 / 2 : ℝ) ≤ pnormSq ∧
    K ^ 3 * deltaH1Sq ≤ 16 * ∑ a, m a * CW a ^ 2 * (m a + ∑ b, m b) ∧
    K ^ 3 * energyGap ≤ 32 * C1 * ∑ a, m a * CW a ^ 2 * (m a + ∑ b, m b) := by
  have hK0 : 0 < K := by linarith
  have hT : ∀ a, K ^ 2 * t a ≤ 4 * m a * lam a := by
    intro a
    have h2 := mul_le_mul_of_nonneg_right (hAbsorb a) (ht0 a)
    nlinarith [hBootT a]
  have hEt : ∀ a, Eabs * t a ≤ lam a := by
    intro a
    have h2 := mul_le_mul_of_nonneg_right (hAbsorb a) (ht0 a)
    have h3 := hT a
    have hm : 0 < m a := lt_of_lt_of_le one_pos (hm1 a)
    have h4 : 4 * m a * (Eabs * t a) ≤ 4 * m a * lam a := by nlinarith
    have h5 : (0 : ℝ) < 4 * m a := by positivity
    exact le_of_mul_le_mul_left h4 h5
  have hS : ∀ a b, K * s a b ≤ 4 * Real.sqrt (m a * m b) * lam a := by
    intro a b
    have h := hBootS a b
    have hsq := Real.sqrt_nonneg (m a * m b)
    have h2 : Eabs * t a + lam a ≤ 2 * lam a := by linarith [hEt a]
    nlinarith [mul_le_mul_of_nonneg_left h2 (by positivity : (0 : ℝ) ≤ 2 * Real.sqrt (m a * m b))]
  have hTsq : ∀ a, K ^ 5 * t a ^ 2 ≤ 16 * m a ^ 2 * CW a ^ 2 := by
    intro a
    have hma : 0 ≤ m a := le_trans zero_le_one (hm1 a)
    have h1 : K ^ 2 * t a ≤ 4 * m a * (CW a * rho) :=
      (hT a).trans (mul_le_mul_of_nonneg_left (hPT a) (by positivity))
    have h0 : 0 ≤ K ^ 2 * t a := mul_nonneg (by positivity) (ht0 a)
    have h2 : (K ^ 2 * t a) ^ 2 ≤ (4 * m a * (CW a * rho)) ^ 2 := pow_le_pow_left₀ h0 h1 2
    calc K ^ 5 * t a ^ 2 = K * (K ^ 2 * t a) ^ 2 := by ring
      _ ≤ K * (4 * m a * (CW a * rho)) ^ 2 := mul_le_mul_of_nonneg_left h2 hK0.le
      _ = 16 * m a ^ 2 * CW a ^ 2 * (rho ^ 2 * K) := by ring
      _ ≤ 16 * m a ^ 2 * CW a ^ 2 * 1 :=
          mul_le_mul_of_nonneg_left hRhoScale (by positivity)
      _ = 16 * m a ^ 2 * CW a ^ 2 := by ring
  have hSsq : ∀ a b, K ^ 3 * s a b ^ 2 ≤ 16 * (m a * m b) * CW a ^ 2 := by
    intro a b
    have hmab : 0 ≤ m a * m b :=
      mul_nonneg (le_trans zero_le_one (hm1 a)) (le_trans zero_le_one (hm1 b))
    have hsq0 := Real.sqrt_nonneg (m a * m b)
    have h1 : K * s a b ≤ 4 * Real.sqrt (m a * m b) * (CW a * rho) :=
      (hS a b).trans (mul_le_mul_of_nonneg_left (hPT a) (by positivity))
    have h0 : 0 ≤ K * s a b := mul_nonneg hK0.le (hs0 a b)
    have h2 := pow_le_pow_left₀ h0 h1 2
    have hsq : Real.sqrt (m a * m b) ^ 2 = m a * m b := Real.sq_sqrt hmab
    calc K ^ 3 * s a b ^ 2 = K * (K * s a b) ^ 2 := by ring
      _ ≤ K * (4 * Real.sqrt (m a * m b) * (CW a * rho)) ^ 2 :=
          mul_le_mul_of_nonneg_left h2 hK0.le
      _ = 16 * Real.sqrt (m a * m b) ^ 2 * CW a ^ 2 * (rho ^ 2 * K) := by ring
      _ = 16 * (m a * m b) * CW a ^ 2 * (rho ^ 2 * K) := by rw [hsq]
      _ ≤ 16 * (m a * m b) * CW a ^ 2 * 1 :=
          mul_le_mul_of_nonneg_left hRhoScale (by positivity)
      _ = 16 * (m a * m b) * CW a ^ 2 := by ring
  have hK5 : 0 < K ^ 5 := by positivity
  have hL2 : deltaL2Sq ≤ 1 / 2 := by
    have hsum : K ^ 5 * ∑ a, t a ^ 2 ≤ 16 * ∑ a, m a ^ 2 * CW a ^ 2 := by
      rw [Finset.mul_sum, Finset.mul_sum]
      apply Finset.sum_le_sum
      intro a _
      have := hTsq a
      linarith
    have h1 : K ^ 5 * deltaL2Sq ≤ K ^ 5 * ∑ a, t a ^ 2 :=
      mul_le_mul_of_nonneg_left hReductionL2 hK5.le
    have h2 : K ^ 5 * deltaL2Sq ≤ K ^ 5 * (1 / 2) := by nlinarith
    exact le_of_mul_le_mul_left h2 hK5
  have hP : (1 / 2 : ℝ) ≤ pnormSq := by rw [hPnorm]; linarith
  have hK3le : K ^ 3 ≤ K ^ 5 := pow_le_pow_right₀ hK1 (by norm_num)
  have hH1 : K ^ 3 * deltaH1Sq ≤ 16 * ∑ a, m a * CW a ^ 2 * (m a + ∑ b, m b) := by
    have h1 : K ^ 3 * deltaH1Sq ≤ K ^ 3 * ∑ a, (t a ^ 2 + ∑ b, s a b ^ 2) :=
      mul_le_mul_of_nonneg_left hReductionH1 (by positivity)
    refine h1.trans ?_
    rw [Finset.mul_sum, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro a _
    have hta : K ^ 3 * t a ^ 2 ≤ 16 * m a ^ 2 * CW a ^ 2 :=
      (mul_le_mul_of_nonneg_right hK3le (sq_nonneg (t a))).trans (hTsq a)
    have hsb : K ^ 3 * ∑ b, s a b ^ 2 ≤ 16 * (m a * CW a ^ 2) * ∑ b, m b := by
      rw [Finset.mul_sum, Finset.mul_sum]
      apply Finset.sum_le_sum
      intro b _
      have := hSsq a b
      linarith
    have : K ^ 3 * (t a ^ 2 + ∑ b, s a b ^ 2) = K ^ 3 * t a ^ 2 + K ^ 3 * ∑ b, s a b ^ 2 := by
      ring
    rw [this]
    nlinarith
  have hgap := rayleigh_form_sandwich hGap0 hP hRayleigh hKR_form
  refine ⟨hP, hH1, ?_⟩
  have h1 : K ^ 3 * energyGap ≤ K ^ 3 * (2 * C1 * deltaH1Sq) :=
    mul_le_mul_of_nonneg_left hgap (by positivity)
  have h2 : K ^ 3 * (2 * C1 * deltaH1Sq) = 2 * C1 * (K ^ 3 * deltaH1Sq) := by ring
  rw [h2] at h1
  have h3 : 2 * C1 * (K ^ 3 * deltaH1Sq) ≤
      2 * C1 * (16 * ∑ a, m a * CW a ^ 2 * (m a + ∑ b, m b)) :=
    mul_le_mul_of_nonneg_left hH1 (by positivity)
  linarith

/-- The tail vector of a scaled coefficient function. -/
lemma referenceTailVector_const_mul {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (r : Fin eta) (c : ℂ) (f : FourierConfig eta μ → ℂ) :
    referenceTailVector K kabs r (fun p => c * f p) = c • referenceTailVector K kabs r f := by
  ext p
  simp only [referenceTailVector, PiLp.smul_apply, smul_eq_mul]
  split_ifs <;> simp

/-- The cutoff on a single momentum on the tail of one particle. -/
lemma referenceTail_cutoff_S_single {eta : ℕ} {μ : Type*}
    (K : ℝ) (kabs : μ → ℝ) (r b : Fin eta) (kinetic : FourierConfig eta μ → ℝ)
    (hCut : ∀ p, K < kabs (p r) → K * kabs (p b) ≤ kinetic p) :
    ∀ p, K * referenceTailMomentum K kabs r b p ≤ referenceTailKinetic K kabs r kinetic p := by
  intro p
  by_cases hp : K < kabs (p r)
  · simpa [referenceTailMomentum, referenceTailKinetic, hp] using hCut p hp
  · simp [referenceTailMomentum, referenceTailKinetic, hp, sq_nonneg K]

/-- The per-particle bootstrap with masses: the vector form of `mass_bootstrap_scalar`,
for an exact eigenvector of any symmetric Hamiltonian whose Fourier eigen-equation has the
mass-weighted kinetic symbol. -/
theorem mass_eighth_milestone_perParticle
    {μ : Type*} [Fintype μ] [DecidableEq μ]
    (eta : ℕ) (K E EN rho C1 : ℝ) (m CW : Fin eta → ℝ)
    (kabs : μ → ℝ) (coeff potentialCoeff : FourierConfig eta μ → ℂ)
    (H : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (hK1 : 1 ≤ K) (hm1 : ∀ a, 1 ≤ m a)
    (hkabs0 : ∀ u, 0 ≤ kabs u)
    (hEigFull : ∀ p, (massKineticSymbol m kabs p : ℂ) * coeff p =
      (2 : ℂ) * ((E : ℂ) * coeff p - potentialCoeff p))
    (hRhoScale : rho ^ 2 * K ≤ 1)
    (hPT : ∀ r : Fin eta, ‖referenceTailVector K kabs r potentialCoeff‖ ≤ CW r * rho)
    (hAbsorb : ∀ a, 4 * m a * |E| ≤ K ^ 2)
    (hNormalized : (∑ p, coeffMass coeff p) = 1)
    (hLargeK : 32 * ∑ a, m a ^ 2 * CW a ^ 2 ≤ K ^ 5)
    (hVariationalLower : E ≤ EN)
    (hHSym : H.IsSymmetric)
    (hHEig : H (fullCoeffVector coeff) = (E : ℂ) • fullCoeffVector coeff)
    (hTrialRayleigh :
      EN * ‖retainedGalerkinVector K kabs coeff‖ ^ 2 ≤
        Complex.re (inner ℂ (retainedGalerkinVector K kabs coeff)
          (H (retainedGalerkinVector K kabs coeff))))
    (hC10 : 0 ≤ C1)
    (hKR_form : shiftedQuadratic H E (discardedGalerkinVector K kabs coeff) ≤
      C1 * discardedH1Sq K kabs coeff) :
    0 ≤ EN - E ∧
    K ^ 3 * (EN - E) ≤ 32 * C1 * ∑ a, m a * CW a ^ 2 * (m a + ∑ b, m b) := by
  classical
  have hK0 : 0 ≤ K := le_trans (by norm_num) hK1
  have hmpos : ∀ a, 0 < m a := fun a => lt_of_lt_of_le one_pos (hm1 a)
  let c : Fin eta → EuclideanSpace ℂ (FourierConfig eta μ) :=
    fun r => referenceTailVector K kabs r coeff
  let w : Fin eta → EuclideanSpace ℂ (FourierConfig eta μ) :=
    fun r => referenceTailVector K kabs r potentialCoeff
  let d : Fin eta → Fin eta → EuclideanSpace ℂ (FourierConfig eta μ) :=
    fun r b => diagMul (referenceTailMomentum K kabs r b) (c r)
  -- the eigen-equation scaled by a positive real weight
  have hScaled : ∀ (k : ℝ), ∀ p,
      ((k * massKineticSymbol m kabs p : ℝ) : ℂ) * coeff p =
        (2 : ℂ) * (((k * E : ℝ) : ℂ) * coeff p - (k : ℂ) * potentialCoeff p) := by
    intro k p
    have h := hEigFull p
    push_cast
    linear_combination (k : ℂ) * h
  have hBootT : ∀ r, K ^ 2 * ‖c r‖ ≤ 2 * m r * (|E| * ‖c r‖ + ‖w r‖) := by
    intro r
    have hA0 : ∀ p, 0 ≤ m r * massKineticSymbol m kabs p :=
      fun p => mul_nonneg (hmpos r).le (massKineticSymbol_nonneg hmpos kabs p)
    have hEig := referenceTail_eigen_equation K (m r * E) kabs r
      (fun p => m r * massKineticSymbol m kabs p) coeff (fun p => (m r : ℂ) * potentialCoeff p)
      (hScaled (m r))
    rw [referenceTailVector_const_mul] at hEig
    have h := fourier_boot_t (Eabs := m r * |E|)
      (referenceTailKinetic K kabs r (fun p => m r * massKineticSymbol m kabs p))
      (c r) ((m r : ℂ) • w r) hK0
      (referenceTailKinetic_nonneg K kabs r _ hA0)
      (referenceTail_cutoff_T K kabs r _
        (fun p hp => massKineticSymbol_cutoff_T hmpos K kabs r hK0 p hp))
      (by rw [abs_mul, abs_of_pos (hmpos r)]) hEig
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hmpos r)] at h
    linarith
  have hBootS : ∀ r b, K * ‖d r b‖ ≤
      2 * Real.sqrt (m r * m b) * (|E| * ‖c r‖ + ‖w r‖) := by
    intro r b
    set sq := Real.sqrt (m r * m b) with hsq
    have hsq0 : 0 ≤ sq := Real.sqrt_nonneg _
    have hA0 : ∀ p, 0 ≤ sq * massKineticSymbol m kabs p :=
      fun p => mul_nonneg hsq0 (massKineticSymbol_nonneg hmpos kabs p)
    have hEig := referenceTail_eigen_equation K (sq * E) kabs r
      (fun p => sq * massKineticSymbol m kabs p) coeff (fun p => (sq : ℂ) * potentialCoeff p)
      (hScaled sq)
    rw [referenceTailVector_const_mul] at hEig
    have h := fourier_boot_s (Eabs := sq * |E|)
      (referenceTailKinetic K kabs r (fun p => sq * massKineticSymbol m kabs p))
      (referenceTailMomentum K kabs r b) (c r) ((sq : ℂ) • w r) hK0
      (fun p => referenceTailMomentum_nonneg K kabs r hkabs0 b p)
      (referenceTailKinetic_nonneg K kabs r _ hA0)
      (referenceTail_cutoff_S_single K kabs r b _
        (fun p hp => massKineticSymbol_cutoff_S hmpos K kabs r hK0 hkabs0 b p hp))
      (by rw [abs_mul, abs_of_nonneg hsq0]) hEig
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hsq0] at h
    change K * ‖d r b‖ ≤ 2 * (sq * |E| * ‖c r‖ + sq * ‖w r‖) at h
    linarith
  -- union bound over particle tails
  have hMass0 : ∀ p, 0 ≤ coeffMass coeff p := fun p => by unfold coeffMass; positivity
  have hH10 : ∀ p, 0 ≤ coeffMass coeff p + coeffTotalDerivMass kabs coeff p := fun p => by
    unfold coeffTotalDerivMass coeffDerivMass coeffMass
    positivity
  have hReductionL2 : discardedL2Sq K kabs coeff ≤ ∑ a, ‖c a‖ ^ 2 := by
    calc discardedL2Sq K kabs coeff
        ≤ ∑ a : Fin eta, Finset.sum (particleTailFinset K kabs a) (coeffMass coeff) :=
          sum_discarded_le_sum_particle_tails _ _ _ hMass0 (discardedConfig_covered K kabs)
      _ = ∑ a : Fin eta, ‖c a‖ ^ 2 := by
          apply Finset.sum_congr rfl
          intro a _
          exact (referenceTailVector_norm_sq K kabs a coeff).symm
  have hReductionH1 :
      discardedH1Sq K kabs coeff ≤ ∑ a, (‖c a‖ ^ 2 + ∑ b, ‖d a b‖ ^ 2) := by
    calc discardedH1Sq K kabs coeff
        ≤ ∑ a : Fin eta, Finset.sum (particleTailFinset K kabs a)
            (fun p => coeffMass coeff p + coeffTotalDerivMass kabs coeff p) :=
          sum_discarded_le_sum_particle_tails _ _ _ hH10 (discardedConfig_covered K kabs)
      _ = ∑ a : Fin eta, (‖c a‖ ^ 2 + ∑ b, ‖d a b‖ ^ 2) := by
          apply Finset.sum_congr rfl
          intro a _
          rw [Finset.sum_add_distrib, referenceTailVector_norm_sq,
            referenceTail_totalDeriv_eq_diag_norms]
  -- the Rayleigh--Ritz identity
  let psi := fullCoeffVector coeff
  let delta := discardedGalerkinVector K kabs coeff
  let u := retainedGalerkinVector K kabs coeff
  let q := shiftedQuadratic H E delta
  have hdecomp : psi = u + delta := by
    simpa [psi, u, delta] using fullCoeffVector_eq_retained_add_discarded K kabs coeff
  have hu : u = psi - delta := by rw [hdecomp]; abel
  have hretNorm : ‖u‖ ^ 2 = retainedNormSq K kabs coeff := by
    simpa [u] using retainedGalerkinVector_norm_sq K kabs coeff hNormalized
  have hTrialShift : (EN - E) * ‖u‖ ^ 2 ≤ shiftedQuadratic H E u :=
    rayleigh_trial_to_shifted H E EN u (by simpa [u] using hTrialRayleigh)
  have hQuad : shiftedQuadratic H E u = q := by
    rw [hu]
    simpa [psi, delta, q] using
      shiftedQuadratic_projection_identity H hHSym E (fullCoeffVector coeff)
        (discardedGalerkinVector K kabs coeff) hHEig
  have hRayleigh : (EN - E) * retainedNormSq K kabs coeff ≤ q := by
    rw [← hretNorm]
    exact hTrialShift.trans_eq hQuad
  obtain ⟨-, -, hRate⟩ :=
    mass_bootstrap_scalar eta K |E| rho C1 (EN - E) q
      (discardedL2Sq K kabs coeff) (discardedH1Sq K kabs coeff)
      (retainedNormSq K kabs coeff) m CW (fun a => ‖c a‖) (fun a => ‖w a‖)
      (fun a b => ‖d a b‖)
      hK1 hRhoScale hm1 (fun a => norm_nonneg _) (fun a b => norm_nonneg _)
      hPT hAbsorb hBootT hBootS hReductionL2 hReductionH1 rfl hLargeK
      (sub_nonneg.mpr hVariationalLower) hRayleigh (by simpa [q] using hKR_form) hC10
  exact ⟨sub_nonneg.mpr hVariationalLower, hRate⟩

end
