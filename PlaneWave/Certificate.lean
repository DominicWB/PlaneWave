    (coulombPositionC2Test_weakKinetic sys L f)

/-- The weak kinetic equation with masses, tested against functions with continuous
first and pure second coordinate derivatives. -/
def HasCoulombClassicalWeakKinetic (sys : CoulombSystem eta ν) (L : ℝ)
    (f k : MolecularPositionL2 eta) : Prop :=
  ∀ φ : TorusCoordinateC2Test (Fin eta × Fin 3),
    inner ℂ ((ContinuousMap.toLp 2 volume ℂ) φ.toContinuousMap) k =
      inner ℂ ((ContinuousMap.toLp 2 volume ℂ) (coulombPositionC2Kinetic sys L φ)) f

omit [Fintype ν] in
theorem hasCoulombClassicalWeakKinetic_iff (sys : CoulombSystem eta ν) (L : ℝ)
    (f k : MolecularPositionL2 eta) :
    HasCoulombClassicalWeakKinetic sys L f k ↔
      HasCoulombWeakKinetic sys (2 * Real.pi / L) f k := by
  constructor
  · intro h s c
    have hTest := h (molecularPositionFourierTestC2 eta s c)
    simpa only [molecularPositionFourierTestC2_toContinuousMap,
      coulombPositionC2Kinetic_fourierTest] using hTest
  · intro h φ
    obtain ⟨u, hu, hk⟩ := coulombPositionC2Test_exists_H2 sys L φ
    have hTest := (hasCoulombWeakKinetic_iff_allH2_inner sys (2 * Real.pi / L) f k).mp h u
    rw [hu, hk] at hTest
    exact hTest

omit [Fintype ν] in
theorem coulombPositionKineticH2_classicalWeak (sys : CoulombSystem eta ν) (L : ℝ)
    (u : MolecularFourierH2 eta) :
    HasCoulombClassicalWeakKinetic sys L
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (coulombPositionKineticH2 sys (2 * Real.pi / L) u) :=
  (hasCoulombClassicalWeakKinetic_iff sys L _ _).mpr
    (coulombPositionKineticH2_weak sys (2 * Real.pi / L) u)

