    let BN := (2 * sys.maxMass / lam ^ 2) * ΞN + N₀ +
      finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker MN * rho'
    let l := cubeLift (2 * Real.pi / L) n
      (UN s (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀)))
