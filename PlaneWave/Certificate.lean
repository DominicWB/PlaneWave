local instance unitTorus3RightInvariantForNuclearTranslation138 :
    Measure.IsAddRightInvariant (volume : Measure UnitTorus3) :=
  Measure.pi.isAddRightInvariant (fun _ : Fin 3 => AddCircle.haarAddCircle)

/-- A torus character converts addition of its position argument to
multiplication. -/
lemma mFourier_add_argument {d : Type*} [Fintype d]
    (n : d → ℤ) (x y : UnitAddTorus d) :
    UnitAddTorus.mFourier n (x + y) =
      UnitAddTorus.mFourier n x * UnitAddTorus.mFourier n y := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, Pi.add_apply,
    fourier_add_argument, Finset.prod_mul_distrib]

/-- Positive translation gives the positive nuclear phase in the existing
Fourier convention. No regularity assumption on `V` is needed for the
measure-preserving change of variables. -/
theorem unitTorus3_fourierCoeff_add_right
    (V : UnitTorus3 → ℂ) (R : UnitTorus3) (n : Lattice3) :
    UnitAddTorus.mFourierCoeff (fun x => V (x + R)) n =
      UnitAddTorus.mFourier n R * UnitAddTorus.mFourierCoeff V n := by
  unfold UnitAddTorus.mFourierCoeff
  simp only [smul_eq_mul]
  calc
    (∫ x, UnitAddTorus.mFourier (-n) x * V (x + R)) =
        ∫ x, UnitAddTorus.mFourier (-n) (x + -R) * V ((x + -R) + R) :=
      (integral_add_right_eq_self
        (fun x : UnitTorus3 => UnitAddTorus.mFourier (-n) x * V (x + R)) (-R)).symm
    _ = ∫ x, UnitAddTorus.mFourier n R *
        (UnitAddTorus.mFourier (-n) x * V x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      simp only [mFourier_add_argument, mFourier_neg_argument, neg_neg,
        add_assoc, neg_add_cancel, add_zero]
      ring
    _ = _ := integral_const_mul _ _

theorem canonicalUnitTorus3CoulombPotential_translate_memLp (R : UnitTorus3) :
    MemLp (fun x : UnitTorus3 =>
      canonicalUnitTorus3CoulombPotential.potential (x + R)) 2 volume :=
  canonicalUnitTorus3CoulombPotential.potential_memLp.comp_measurePreserving
    (measurePreserving_add_right (volume : Measure UnitTorus3) R)

theorem canonicalUnitTorus3CoulombPotential_translate_fourierCoeff
    (R : UnitTorus3) (n : Lattice3) :
    UnitAddTorus.mFourierCoeff (fun x : UnitTorus3 =>
      canonicalUnitTorus3CoulombPotential.potential (x + R)) n =
      UnitAddTorus.mFourier n R * unitLatticeCoulombKernel n := by
  rw [unitTorus3_fourierCoeff_add_right,
    canonicalUnitTorus3CoulombPotential.fourier_coeff]

/-- The amplitude in the unrestricted lattice kernel is exactly the scalar
multiple of the canonical unit-cell coefficient. -/
lemma latticeCoulombKernel_eq_scaled_unitKernel
    (gamma : ℝ) (hGamma : 0 ≤ gamma) (q p : Lattice3) :
    latticeCoulombKernel (gamma ^ 2) q p =
      (gamma : ℂ) * unitLatticeCoulombKernel (latticeSub q p) := by
  rw [latticeCoulombKernel_of_amplitude_sq gamma hGamma,
    unitLatticeCoulombKernel_eq_inv_normSq]
  simp only [Complex.ofReal_div, Complex.ofReal_one]
  ring

