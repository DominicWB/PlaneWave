    (eta : ℕ) (g : ℝ) (count : ℕ)
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    boKineticSymbol (finitePlaneWaveKabs g count) q =
      ∑ i : Fin eta, g ^ 2 * latticeNormSq (finiteConfigLatticeIndex eta count q i) := by
  unfold boKineticSymbol
  apply Finset.sum_congr rfl
  intro i hi
  exact finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq g count (q i)

lemma finiteKineticHamiltonian_eq_latticeKernel
    (eta : ℕ) (L : ℝ) (count : ℕ) :
    (1 / 2 : ℂ) • boKineticOperator (eta := eta)
        (finitePlaneWaveKabs (2 * Real.pi / L) count) =
      finiteCoefficientKernelOperator (fun q p => molecularLatticeKineticKernel eta L
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  classical
  apply LinearMap.ext
  intro u
  ext q
  change (1 / 2 : ℂ) *
      ((boKineticSymbol (finitePlaneWaveKabs (2 * Real.pi / L) count) q : ℂ) * u.ofLp q) =
    ∑ p, u.ofLp p * molecularLatticeKineticKernel eta L
      (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)
  rw [boKineticSymbol_eq_lattice_sum]
  have hEq : ∀ p : FourierConfig eta (FinitePlaneWaveMode count),
      finiteConfigLatticeIndex eta count p = finiteConfigLatticeIndex eta count q ↔ p = q :=
    fun p => (finiteConfigLatticeIndex_injective eta count).eq_iff
  simp only [molecularLatticeKineticKernel, hEq, mul_ite, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true]
  ring

/-- Every finite signed molecular Hamiltonian is a compression of the SAME
explicit lattice kernel. This is proved from the actual finite operators. -/
lemma finiteMolecularBOHamiltonian_eq_latticeKernel
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (count : ℕ) :
    finiteMolecularBOHamiltonian eta L data count =
      finiteCoefficientKernelOperator (fun q p => molecularLatticeHamiltonianKernel eta L data
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  rw [finiteMolecularBOHamiltonian, boHamiltonian, finiteKineticHamiltonian_eq_latticeKernel,
    finiteMolecularCoulombPotential_eq_latticeKernel]
  exact (map_add (finiteCoefficientKernelOperatorAddHom
    (ι := FourierConfig eta (FinitePlaneWaveMode count))) _ _).symm

lemma finiteMolecularBOHamiltonian_apply_latticeKernel
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (count : ℕ)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    (finiteMolecularBOHamiltonian eta L data count u).ofLp q =
      ∑ p, u.ofLp p * molecularLatticeHamiltonianKernel eta L data
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p) := by
  rw [finiteMolecularBOHamiltonian_eq_latticeKernel]
  rfl

lemma finiteMolecularBOHamiltonian_fullCoeff_apply_latticeKernel
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    (finiteMolecularBOHamiltonian eta L data count (fullCoeffVector coeff)).ofLp q =
      ∑ p, coeff p * molecularLatticeHamiltonianKernel eta L data
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p) :=
  finiteMolecularBOHamiltonian_apply_latticeKernel eta L data count (fullCoeffVector coeff) q

end

