/-! ## One-hundred-first milestone: smooth ambient representative of the finite Fourier polynomial -/

/-- A single one-dimensional unit-period Fourier factor, written on the real
cover rather than on `UnitAddCircle`. -/
noncomputable def centeredCube3FourierFactor
    (n : ℤ)
    (r : ℝ) : ℂ :=
  Complex.exp
    ((2 * (Real.pi : ℂ) * Complex.I * (n : ℂ)) * (r : ℂ))

/-- The ordinary real derivative of one Fourier factor. -/
lemma centeredCube3FourierFactor_hasDerivAt
    (n : ℤ)
    (r : ℝ) :
    HasDerivAt
      (fun t : ℝ => centeredCube3FourierFactor n (r + t))
      (centeredCube3FourierFactor n r *
        (2 * (Real.pi : ℂ) * Complex.I * (n : ℂ)))
      0 := by
  let A : ℂ :=
    2 * (Real.pi : ℂ) * Complex.I * (n : ℂ)
  have hId :
      HasDerivAt (fun z : ℂ => z) 1 0 :=
    hasDerivAt_id' (0 : ℂ)
  have hShift :
      HasDerivAt (fun z : ℂ => (r : ℂ) + z) 1 0 :=
    HasDerivAt.const_add (r : ℂ) hId
  have hArg :
      HasDerivAt
        (fun z : ℂ => A * ((r : ℂ) + z))
        A
        0 := by
    simpa using hShift.const_mul A
  have hExp := hArg.cexp
  have hReal := hExp.comp_ofReal

  have hFunction :
      (fun t : ℝ => centeredCube3FourierFactor n (r + t))
        =
      (fun t : ℝ =>
        Complex.exp (A * ((r : ℂ) + (t : ℂ)))) := by
    funext t
    simp only [centeredCube3FourierFactor, A, Complex.ofReal_add]

  have hDeriv :
      Complex.exp (A * ((r : ℂ) + (0 : ℂ))) * A
        =
      centeredCube3FourierFactor n r *
        (2 * (Real.pi : ℂ) * Complex.I * (n : ℂ)) := by
    simp only [centeredCube3FourierFactor, A, add_zero]

  rw [hFunction]
  exact hReal.congr_deriv hDeriv

/-- The explicit ambient factor agrees with Mathlib's unit-circle Fourier
character on a real representative. -/
lemma centeredCube3FourierFactor_eq_fourier
    (n : ℤ)
    (r : ℝ) :
    centeredCube3FourierFactor n r =
      fourier n (r : UnitAddCircle) := by
  unfold centeredCube3FourierFactor
  rw [fourier_coe_apply]
  simp

/-- The ambient three-dimensional plane-wave monomial corresponding to a
lattice momentum.  It is defined on all of `ℝ³`, so ordinary calculus can be
used without differentiating the fundamental-domain measurable equivalence. -/
noncomputable def centeredCube3FourierMonomial
    (n : Lattice3)
    (x : CenteredCube3Ambient) : ℂ :=
  ∏ i : Fin 3, centeredCube3FourierFactor (n i) (x i)

/-- The ambient monomial agrees exactly with Mathlib's torus monomial when a
point is represented in the centered fundamental cube. -/
lemma centeredCube3FourierMonomial_eq_mFourier
    (n : Lattice3)
    (y : CenteredCube3) :
    centeredCube3FourierMonomial n y.1 =
      UnitAddTorus.mFourier n (unitTorus3CenteredEquiv.symm y) := by
  have hSymm :
      unitTorus3CenteredEquiv.symm y =
        fun i : Fin 3 => ((y.1 i : ℝ) : UnitAddCircle) := by
    exact UnitAddTorus.coe_symm_measurableEquivPiIoc_apply
      centeredCube3Base y
  rw [hSymm]
  unfold centeredCube3FourierMonomial
  simp_rw [centeredCube3FourierFactor_eq_fourier]
  rfl

/-- Moving in one coordinate changes the ambient plane-wave monomial with the
usual Fourier multiplier `2π i n_j`. -/
lemma centeredCube3FourierMonomial_hasDerivAt_coordinate_zero
    (n : Lattice3)
    (x : CenteredCube3Ambient) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3FourierMonomial n
          (x + t • hardyCoordinateDirection (0 : Fin 3)))
      (centeredCube3FourierMonomial n x *
        (2 * (Real.pi : ℂ) * Complex.I * (n (0 : Fin 3) : ℂ)))
      0 := by
  have h0 :=
    centeredCube3FourierFactor_hasDerivAt (n 0) (x 0)
  have h :=
    (h0.mul_const
      (centeredCube3FourierFactor (n 1) (x 1))).mul_const
      (centeredCube3FourierFactor (n 2) (x 2))
  have hFunction :
      (fun t : ℝ =>
        centeredCube3FourierMonomial n
          (x + t • hardyCoordinateDirection (0 : Fin 3)))
        =
      (fun t : ℝ =>
        centeredCube3FourierFactor (n 0) (x 0 + t) *
          centeredCube3FourierFactor (n 1) (x 1) *
          centeredCube3FourierFactor (n 2) (x 2)) := by
    funext t
    rw [add_smul_hardyCoordinateDirection_eq_update]
    simp [centeredCube3FourierMonomial, Fin.prod_univ_succ, mul_assoc]
  have hDeriv :
      centeredCube3FourierFactor (n 0) (x 0) *
            (2 * (Real.pi : ℂ) * Complex.I * (n 0 : ℂ)) *
          centeredCube3FourierFactor (n 1) (x 1) *
        centeredCube3FourierFactor (n 2) (x 2)
        =
      centeredCube3FourierMonomial n x *
        (2 * (Real.pi : ℂ) * Complex.I * (n (0 : Fin 3) : ℂ)) := by
    unfold centeredCube3FourierMonomial
    simp [Fin.prod_univ_succ]
    ring
  rw [hFunction]
  exact h.congr_deriv hDeriv

lemma centeredCube3FourierMonomial_hasDerivAt_coordinate_one
    (n : Lattice3)
    (x : CenteredCube3Ambient) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3FourierMonomial n
          (x + t • hardyCoordinateDirection (1 : Fin 3)))
      (centeredCube3FourierMonomial n x *
        (2 * (Real.pi : ℂ) * Complex.I * (n (1 : Fin 3) : ℂ)))
      0 := by
  have h1 :=
    centeredCube3FourierFactor_hasDerivAt (n 1) (x 1)
  have h :=
    (h1.const_mul
      (centeredCube3FourierFactor (n 0) (x 0))).mul_const
      (centeredCube3FourierFactor (n 2) (x 2))
  have hFunction :
      (fun t : ℝ =>
        centeredCube3FourierMonomial n
          (x + t • hardyCoordinateDirection (1 : Fin 3)))
        =
      (fun t : ℝ =>
        centeredCube3FourierFactor (n 0) (x 0) *
          centeredCube3FourierFactor (n 1) (x 1 + t) *
          centeredCube3FourierFactor (n 2) (x 2)) := by
    funext t
    rw [add_smul_hardyCoordinateDirection_eq_update]
    simp [centeredCube3FourierMonomial, Fin.prod_univ_succ, mul_assoc]
  have hDeriv :
      centeredCube3FourierFactor (n 0) (x 0) *
          (centeredCube3FourierFactor (n 1) (x 1) *
            (2 * (Real.pi : ℂ) * Complex.I * (n 1 : ℂ))) *
        centeredCube3FourierFactor (n 2) (x 2)
        =
      centeredCube3FourierMonomial n x *
        (2 * (Real.pi : ℂ) * Complex.I * (n (1 : Fin 3) : ℂ)) := by
    unfold centeredCube3FourierMonomial
    simp [Fin.prod_univ_succ]
    ring
  rw [hFunction]
  exact h.congr_deriv hDeriv

lemma centeredCube3FourierMonomial_hasDerivAt_coordinate_two
    (n : Lattice3)
    (x : CenteredCube3Ambient) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3FourierMonomial n
          (x + t • hardyCoordinateDirection (2 : Fin 3)))
      (centeredCube3FourierMonomial n x *
        (2 * (Real.pi : ℂ) * Complex.I * (n (2 : Fin 3) : ℂ)))
      0 := by
  have h2 :=
    centeredCube3FourierFactor_hasDerivAt (n 2) (x 2)
  have h :=
    h2.const_mul
      (centeredCube3FourierFactor (n 0) (x 0) *
        centeredCube3FourierFactor (n 1) (x 1))
  have hFunction :
      (fun t : ℝ =>
        centeredCube3FourierMonomial n
          (x + t • hardyCoordinateDirection (2 : Fin 3)))
        =
      (fun t : ℝ =>
        centeredCube3FourierFactor (n 0) (x 0) *
          centeredCube3FourierFactor (n 1) (x 1) *
          centeredCube3FourierFactor (n 2) (x 2 + t)) := by
    funext t
    rw [add_smul_hardyCoordinateDirection_eq_update]
    simp [centeredCube3FourierMonomial, Fin.prod_univ_succ, mul_assoc]
  have hDeriv :
      (centeredCube3FourierFactor (n 0) (x 0) *
          centeredCube3FourierFactor (n 1) (x 1)) *
        (centeredCube3FourierFactor (n 2) (x 2) *
          (2 * (Real.pi : ℂ) * Complex.I * (n 2 : ℂ)))
        =
      centeredCube3FourierMonomial n x *
        (2 * (Real.pi : ℂ) * Complex.I * (n (2 : Fin 3) : ℂ)) := by
    unfold centeredCube3FourierMonomial
    simp [Fin.prod_univ_succ]
    ring
  rw [hFunction]
  exact h.congr_deriv hDeriv

/-- Moving in one coordinate changes the ambient plane-wave monomial with the
usual Fourier multiplier `2π i n_j`. -/
lemma centeredCube3FourierMonomial_hasDerivAt_coordinate
    (n : Lattice3)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3FourierMonomial n
          (x + t • hardyCoordinateDirection j))
      (centeredCube3FourierMonomial n x *
        (2 * (Real.pi : ℂ) * Complex.I * (n j : ℂ)))
      0 := by
  fin_cases j
  · exact centeredCube3FourierMonomial_hasDerivAt_coordinate_zero n x
  · exact centeredCube3FourierMonomial_hasDerivAt_coordinate_one n x
  · exact centeredCube3FourierMonomial_hasDerivAt_coordinate_two n x

/-- The finite Fourier polynomial, now as a literal smooth function on ambient
`ℝ³`. -/
noncomputable def centeredCube3FourierAmbientPolynomial
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient) : ℂ :=
  ∑ p : α, f p * centeredCube3FourierMonomial (index p) x

/-- The ambient polynomial agrees pointwise on the centered cube with the
continuous torus representative already used throughout the Hardy construction. -/
lemma centeredCube3FourierAmbientPolynomial_eq_torus
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (y : CenteredCube3) :
    centeredCube3FourierAmbientPolynomial index f y.1 =
      torus3FourierContinuousPolynomial index f
        (unitTorus3CenteredEquiv.symm y) := by
  classical
  unfold centeredCube3FourierAmbientPolynomial
  unfold torus3FourierContinuousPolynomial
  simp only [ContinuousMap.sum_apply, ContinuousMap.smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro p hp
  rw [centeredCube3FourierMonomial_eq_mFourier]

/-- Ambient version of the explicit `j`-th Fourier partial derivative. -/
noncomputable def centeredCube3FourierAmbientPartial
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (x : CenteredCube3Ambient) : ℂ :=
  ∑ p : α,
    torus3FourierPartialCoeff index f j p *
      centeredCube3FourierMonomial (index p) x

/-- This ambient partial derivative likewise agrees with the continuous
representative of `torus3FourierPartial`. -/
lemma centeredCube3FourierAmbientPartial_eq_torus
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (y : CenteredCube3) :
    centeredCube3FourierAmbientPartial index f j y.1 =
      torus3FourierPartialContinuousPolynomial index f j
        (unitTorus3CenteredEquiv.symm y) := by
  classical
  unfold centeredCube3FourierAmbientPartial
  unfold torus3FourierPartialContinuousPolynomial
  unfold torus3FourierContinuousPolynomial
  simp only [ContinuousMap.sum_apply, ContinuousMap.smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro p hp
  rw [centeredCube3FourierMonomial_eq_mFourier]

/-- The ambient finite Fourier polynomial has exactly the expected coordinate
derivative. -/
lemma centeredCube3FourierAmbientPolynomial_hasDerivAt_coordinate
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    HasDerivAt
      (fun t : ℝ =>
        centeredCube3FourierAmbientPolynomial index f
          (x + t • hardyCoordinateDirection j))
      (centeredCube3FourierAmbientPartial index f j x)
      0 := by
  classical
  have hTerms :
      ∀ p ∈ (Finset.univ : Finset α),
        HasDerivAt
          (fun t : ℝ =>
            f p *
              centeredCube3FourierMonomial (index p)
                (x + t • hardyCoordinateDirection j))
          (f p *
            (centeredCube3FourierMonomial (index p) x *
              (2 * (Real.pi : ℂ) * Complex.I *
                (index p j : ℂ))))
          0 := by
    intro p hp
    simpa using!
      (centeredCube3FourierMonomial_hasDerivAt_coordinate
        (index p) x j).const_mul (f p)

  have hSum := HasDerivAt.fun_sum hTerms

  have hValue :
      (∑ p : α,
        f p *
          (centeredCube3FourierMonomial (index p) x *
            (2 * (Real.pi : ℂ) * Complex.I *
              (index p j : ℂ)))) =
        centeredCube3FourierAmbientPartial index f j x := by
    unfold centeredCube3FourierAmbientPartial
    unfold torus3FourierPartialCoeff
    apply Finset.sum_congr rfl
    intro p hp
    push_cast
    ring

  have hSum' := hSum.congr_deriv hValue
  simpa [centeredCube3FourierAmbientPolynomial] using! hSum'

/-!
## One-hundred-first milestone

The Fourier part of the cutoff wave now has a genuine smooth ambient
representative.  Rather than differentiating the measurable centered-domain
equivalence, Lean works with the literal product of one-dimensional Fourier
characters on the real cover.  On the centered cube this ambient polynomial is
proved exactly equal to the existing continuous torus representative.

For each coordinate `j`, Lean also proves that its ordinary real derivative is
the ambient polynomial built from the already-defined coefficients

`2 * pi * I * n_j * f_n`.

That ambient derivative agrees exactly on the centered cube with
`torus3FourierPartialContinuousPolynomial`.  The next milestone can therefore
differentiate the radial cutoff times this smooth ambient polynomial on the
inner and annular branches, with no remaining Fourier-calculus interface.
-/

end

end PlaneWaveCertificate

