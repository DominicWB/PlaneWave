/-! ## Eighty-ninth milestone: prove scalar inverse-radius `L²` integrability -/

/-- The ambient real three-space underlying the centered cube. -/
abbrev CenteredCube3Ambient := Fin 3 → ℝ

/-- The half-open centered cube as a subset of the ambient real vector space. -/
def centeredCube3AmbientSet : Set CenteredCube3Ambient :=
  {x : CenteredCube3Ambient |
    ∀ i : Fin 3,
      x i ∈ Set.Ioc
        (centeredCube3Base i)
        (centeredCube3Base i + 1)}

lemma centeredCube3AmbientSet_measurable :
    MeasurableSet centeredCube3AmbientSet := by
  have hEq :
      centeredCube3AmbientSet =
        ⋂ i : Fin 3,
          {x : CenteredCube3Ambient |
            x i ∈ Set.Ioc
              (centeredCube3Base i)
              (centeredCube3Base i + 1)} := by
    ext x
    simp [centeredCube3AmbientSet]
  rw [hEq]
  refine MeasurableSet.iInter ?_
  intro i
  exact
    measurableSet_Ioc.preimage
      (measurable_pi_apply i)

/-- The half-open centered cube lies in the sup-norm closed ball of radius `1/2`. -/
lemma centeredCube3AmbientSet_subset_closedBall :
    centeredCube3AmbientSet ⊆
      Metric.closedBall (0 : CenteredCube3Ambient) (1 / 2 : ℝ) := by
  intro x hx
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)).2
  intro i
  have hiRaw := hx i
  dsimp [centeredCube3Base] at hiRaw
  have hi : -(1 / 2 : ℝ) < x i ∧ x i ≤ (1 / 2 : ℝ) := by
    constructor
    · exact hiRaw.1
    · linarith [hiRaw.2]
  rw [Real.norm_eq_abs, abs_le]
  constructor <;> linarith

/-- In ambient dimension three, the singular majorant `||x||_∞^{-2}` is locally integrable. -/
lemma centeredCube3Ambient_norm_rpow_neg_two_locallyIntegrable :
    MeasureTheory.LocallyIntegrable
      (fun x : CenteredCube3Ambient => ‖x‖ ^ (-2 : ℝ))
      MeasureTheory.volume := by
  refine
    MeasureTheory.locallyIntegrable_of_norm_le_rpow
      (μ := MeasureTheory.volume)
      (E := CenteredCube3Ambient)
      (F := ℝ)
      (C := 1)
      (α := 2)
      ?_ ?_ ?_ ?_
  · norm_num [Module.finrank_fin_fun]
  · norm_num [Module.finrank_fin_fun]
  · filter_upwards [] with x
    have hx0 : 0 ≤ ‖x‖ := norm_nonneg x
    simp only [one_mul, Real.norm_eq_abs]
    rw [abs_of_nonneg (Real.rpow_nonneg hx0 (-2 : ℝ))]
  · measurability

/-- The ambient singular majorant is integrable on the half-open centered cube. -/
lemma centeredCube3Ambient_norm_rpow_neg_two_integrableOn :
    MeasureTheory.IntegrableOn
      (fun x : CenteredCube3Ambient => ‖x‖ ^ (-2 : ℝ))
      centeredCube3AmbientSet
      MeasureTheory.volume := by
  have hBall :
      MeasureTheory.IntegrableOn
        (fun x : CenteredCube3Ambient => ‖x‖ ^ (-2 : ℝ))
        (Metric.closedBall (0 : CenteredCube3Ambient) (1 / 2 : ℝ))
        MeasureTheory.volume :=
    centeredCube3Ambient_norm_rpow_neg_two_locallyIntegrable.integrableOn_isCompact
      (isCompact_closedBall (0 : CenteredCube3Ambient) (1 / 2 : ℝ))
  exact hBall.mono_set centeredCube3AmbientSet_subset_closedBall

/-- The ambient sup norm is bounded by the Euclidean radius used in the Coulomb singularity. -/
lemma centeredCube3_ambient_norm_le_radius
    (y : CenteredCube3) :
    ‖(y.1 : CenteredCube3Ambient)‖ ≤ centeredCube3Radius y := by
  apply
    (pi_norm_le_iff_of_nonneg
      (centeredCube3Radius_nonneg y)).2
  intro i
  simpa only [Real.norm_eq_abs] using
    centeredCube3_abs_coord_le_radius y i

/-- Pointwise domination of the squared Euclidean inverse radius by the
ambient sup-norm singularity. -/
lemma centeredCube3InverseRadius_norm_sq_le_ambient_rpow
    (y : CenteredCube3) :
    ‖(centeredCube3InverseRadius y : ℂ)‖ ^ 2
      ≤
    ‖(y.1 : CenteredCube3Ambient)‖ ^ (-2 : ℝ) := by

  let s : ℝ := ‖(y.1 : CenteredCube3Ambient)‖
  let r : ℝ := centeredCube3Radius y

  have hs0 : 0 ≤ s := by
    dsimp [s]
    exact norm_nonneg _

  have hr0 : 0 ≤ r := by
    dsimp [r]
    exact centeredCube3Radius_nonneg y

  have hsr : s ≤ r := by
    dsimp [s, r]
    exact centeredCube3_ambient_norm_le_radius y

  by_cases hs : s = 0

  · have hy0 : (y.1 : CenteredCube3Ambient) = 0 := by
      dsimp [s] at hs
      exact norm_eq_zero.mp hs

    have hr : r = 0 := by
      dsimp [r, centeredCube3Radius, centeredCube3RadiusSq]
      simp [hy0]

    have hInv : centeredCube3InverseRadius y = 0 := by
      rw [centeredCube3InverseRadius_eq_one_div_radius]
      dsimp [r] at hr
      rw [hr]
      simp

    rw [hInv]
    have hRpow0 : 0 ≤ s ^ (-2 : ℝ) :=
      Real.rpow_nonneg hs0 (-2 : ℝ)
    simpa using hRpow0

  · have hspos : 0 < s := lt_of_le_of_ne hs0 (Ne.symm hs)
    have hrpos : 0 < r := lt_of_lt_of_le hspos hsr

    have hInvLe : 1 / r ≤ 1 / s :=
      one_div_le_one_div_of_le hspos hsr

    have hInvR0 : 0 ≤ 1 / r := one_div_nonneg.mpr hr0
    have hInvS0 : 0 ≤ 1 / s := one_div_nonneg.mpr hs0

    have hSq : (1 / r) ^ 2 ≤ (1 / s) ^ 2 := by
      nlinarith

    have hRpow : s ^ (-2 : ℝ) = (1 / s) ^ 2 := by
      rw [show (-2 : ℝ) = -(2 : ℝ) by norm_num]
      rw [Real.rpow_neg hs0]
      rw [Real.rpow_two]
      simp only [one_div, inv_pow]

    have hInvNonneg : 0 ≤ centeredCube3InverseRadius y := by
      rw [centeredCube3InverseRadius_eq_one_div_radius]
      exact one_div_nonneg.mpr hr0

    simp only [Complex.norm_real, Real.norm_eq_abs]
    rw [abs_of_nonneg hInvNonneg]
    rw [centeredCube3InverseRadius_eq_one_div_radius]
    change (1 / r) ^ 2 ≤ s ^ (-2 : ℝ)
    rw [hRpow]
    exact hSq

/-- The scalar Coulomb singularity belongs to `L²` on the centered cube.

The proof uses `memLp_two_iff_integrable_sq_norm`, transports ambient
integrability through the subtype `comap`, and then applies the pointwise
sup-norm domination above. -/
lemma centeredCube3InverseRadius_memLp :
    MeasureTheory.MemLp
      (fun y : CenteredCube3 =>
        (centeredCube3InverseRadius y : ℂ))
      2 centeredCube3Measure := by

  have hMajor :
      MeasureTheory.Integrable
        (fun y : CenteredCube3 =>
          ‖(y.1 : CenteredCube3Ambient)‖ ^ (-2 : ℝ))
        centeredCube3Measure := by
    change
      MeasureTheory.Integrable
        (fun y : {x : CenteredCube3Ambient // x ∈ centeredCube3AmbientSet} =>
          ‖(y.1 : CenteredCube3Ambient)‖ ^ (-2 : ℝ))
        (MeasureTheory.Measure.comap Subtype.val MeasureTheory.volume)
    exact
      (MeasureTheory.integrableOn_iff_comap_subtypeVal
        centeredCube3AmbientSet_measurable).1
        centeredCube3Ambient_norm_rpow_neg_two_integrableOn

  have hInvMeas :
      MeasureTheory.AEStronglyMeasurable
        (fun y : CenteredCube3 =>
          (centeredCube3InverseRadius y : ℂ))
        centeredCube3Measure :=
    centeredCube3InverseRadius_measurable.complex_ofReal.aestronglyMeasurable

  apply
    (MeasureTheory.memLp_two_iff_integrable_sq_norm hInvMeas).2

  have hSqMeas :
      MeasureTheory.AEStronglyMeasurable
        (fun y : CenteredCube3 =>
          ‖(centeredCube3InverseRadius y : ℂ)‖ ^ 2)
        centeredCube3Measure := by
    exact
      MeasureTheory.AEStronglyMeasurable.fun_pow
        hInvMeas.norm 2

  exact
    MeasureTheory.Integrable.mono'
      hMajor
      hSqMeas
      (Filter.Eventually.of_forall (fun y => by
        have hBound :=
          centeredCube3InverseRadius_norm_sq_le_ambient_rpow y
        have hLeft0 :
            0 ≤ ‖(centeredCube3InverseRadius y : ℂ)‖ ^ 2 :=
          sq_nonneg _
        simpa only [Real.norm_eq_abs, abs_of_nonneg hLeft0] using hBound))

/-- Milestone-88 data with scalar inverse-radius integrability removed from the
analytic interface.  Only the actual Hardy inequality remains. -/
structure CenteredCube3RadialCutoffHardyOnlyData
    (rho R : ℝ) where

  rho_pos : 0 < rho
  rho_lt_outer : rho < R
  outer_lt_half : R < (1 / 2 : ℝ)

  hardy_norm_sq_le_explicit_gradient :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ∀ hMem :
            MeasureTheory.MemLp
              (centeredCube3RadialCutoffLocalizedFunction
                rho R index f)
              2 centeredCube3Measure,
            ‖hMem.toLp
                (centeredCube3RadialCutoffLocalizedFunction
                  rho R index f)‖ ^ 2
              ≤
            4 *
              (∑ j : Fin 3,
                ‖centeredCube3RadialCutoffMainGradientState
                      rho R rho_lt_outer index f j +
                    centeredCube3RadialCutoffGradientState
                      rho R rho_pos rho_lt_outer index f j‖ ^ 2)

/-- The Hardy-only data canonically supply milestone 88. -/
theorem
    CenteredCube3RadialCutoffHardyOnlyData.toInverseRadiusHardyData
    {rho R : ℝ}
    (data : CenteredCube3RadialCutoffHardyOnlyData rho R) :
    CenteredCube3RadialCutoffInverseRadiusHardyData rho R where

  rho_pos := data.rho_pos
  rho_lt_outer := data.rho_lt_outer
  outer_lt_half := data.outer_lt_half

  inverseRadius_memLp := centeredCube3InverseRadius_memLp

  hardy_norm_sq_le_explicit_gradient :=
    data.hardy_norm_sq_le_explicit_gradient

/-!
## Eighty-ninth milestone

The scalar integrability input introduced in milestone 88 is now a theorem.
Mathlib's finite-dimensional negative-power integrability result is applied in
`Fin 3 → ℝ`, whose norm is the sup norm.  The elementary estimate

`||y||_∞ ≤ |y|₂`

then dominates the squared Euclidean Coulomb singularity by
`||y||_∞^{-2}`.  Since `2 < 3`, this majorant is locally integrable, hence
integrable on the bounded centered cube.

Therefore the only remaining near-origin analytic field is the genuine
three-dimensional Hardy inequality with the explicitly assembled weak
gradient.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

/-- Keep the torus volume instance definitionally identical to the one used in
milestone 88's continuous Fourier representative lemmas. -/
local instance unitAddCircleMeasureSpaceForFourier90 :
    MeasureTheory.MeasureSpace UnitAddCircle :=
  instMeasureSpaceUnitAddCircle

/-! ## Ninetieth milestone: make the Hardy weak-gradient functions pointwise explicit -/

/-- The continuous representative of the `j`-th Fourier derivative. -/
noncomputable def torus3FourierPartialContinuousPolynomial
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) : C(UnitTorus3, ℂ) :=
  torus3FourierContinuousPolynomial index
    (torus3FourierPartialCoeff index f j)

/-- The existing `L²` derivative polynomial agrees a.e. with its continuous
finite Fourier representative. -/
lemma torus3FourierPartial_eq_continuous_ae
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    ∀ᵐ x : UnitTorus3 ∂MeasureTheory.volume,
      torus3FourierPartial index f j x
        =
      torus3FourierPartialContinuousPolynomial index f j x := by
  unfold torus3FourierPartial
  unfold torus3FourierPartialContinuousPolynomial
  exact
    torus3FourierPolynomial_eq_continuous_ae
      index (torus3FourierPartialCoeff index f j)

/-- Pointwise `chi * partial_j psi` using the continuous Fourier representative. -/
noncomputable def centeredCube3RadialCutoffMainGradientFunction
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (y : CenteredCube3) : ℂ :=
  (centeredCube3RadialCutoff rho R y : ℂ) *
    torus3FourierPartialContinuousPolynomial index f j
      (unitTorus3CenteredEquiv.symm y)

/-- The explicit main-gradient `L²` state is the pointwise main product-rule
term almost everywhere. -/
lemma centeredCube3RadialCutoffMainGradientState_eq_function_ae
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
      centeredCube3RadialCutoffMainGradientState
          rho R hRhoR index f j y
        =
      centeredCube3RadialCutoffMainGradientFunction
          rho R index f j y := by

  have hProduct :=
    (centeredCube3RadialCutoffMultiplier rho R hRhoR).productState_eq_ae
      (centeredCube3StateFromTorus
        (torus3FourierPartial index f j))

  have hPull :=
    centeredCube3StateFromTorus_eq_ae
      (torus3FourierPartial index f j)

  have hTorus :=
    torus3FourierPartial_eq_continuous_ae index f j

  have hContinuous :
      ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
        torus3FourierPartial index f j
            (unitTorus3CenteredEquiv.symm y)
          =
        torus3FourierPartialContinuousPolynomial index f j
            (unitTorus3CenteredEquiv.symm y) :=
    unitTorus3CenteredEquiv_symm_measurePreserving.quasiMeasurePreserving.ae
      hTorus

  filter_upwards [hProduct, hPull, hContinuous] with y hpull hstate hcont
  unfold centeredCube3RadialCutoffMainGradientState
  unfold centeredCube3RadialCutoffMainGradientFunction
  rw [hpull]
  rw [hstate]
  rw [hcont]
  rfl

/-- Pointwise `(partial_j chi) * psi` using the continuous Fourier representative. -/
noncomputable def centeredCube3RadialCutoffCutoffGradientFunction
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (y : CenteredCube3) : ℂ :=
  (centeredCube3RadialCutoffPartial rho R j y : ℂ) *
    torus3FourierContinuousPolynomial index f
      (unitTorus3CenteredEquiv.symm y)

/-- The explicit cutoff-gradient `L²` state is the pointwise cutoff product-rule
term almost everywhere. -/
lemma centeredCube3RadialCutoffGradientState_eq_function_ae
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
      centeredCube3RadialCutoffGradientState
          rho R hrho hRhoR index f j y
        =
      centeredCube3RadialCutoffCutoffGradientFunction
          rho R index f j y := by

  have hProduct :=
    (centeredCube3RadialCutoffPartialMultiplier
      rho R hrho hRhoR j).productState_eq_ae
        (centeredCube3StateFromTorus
          (torus3FourierPolynomial index f))

  have hPull :=
    centeredCube3StateFromTorus_eq_ae
      (torus3FourierPolynomial index f)

  have hTorus :=
    torus3FourierPolynomial_eq_continuous_ae index f

  have hContinuous :
      ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
        torus3FourierPolynomial index f
            (unitTorus3CenteredEquiv.symm y)
          =
        torus3FourierContinuousPolynomial index f
            (unitTorus3CenteredEquiv.symm y) :=
    unitTorus3CenteredEquiv_symm_measurePreserving.quasiMeasurePreserving.ae
      hTorus

  filter_upwards [hProduct, hPull, hContinuous] with y hpull hstate hcont
  unfold centeredCube3RadialCutoffGradientState
  unfold centeredCube3RadialCutoffCutoffGradientFunction
  rw [hpull]
  rw [hstate]
  rw [hcont]
  rfl

/-- The actual pointwise `j`-th product-rule gradient of `chi * psi`. -/
noncomputable def centeredCube3RadialCutoffRawGradientFunction
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (y : CenteredCube3) : ℂ :=
  centeredCube3RadialCutoffMainGradientFunction rho R index f j y +
    centeredCube3RadialCutoffCutoffGradientFunction rho R index f j y

/-- The assembled `L²` gradient state agrees a.e. with the actual pointwise
product-rule expression. -/
lemma centeredCube3RadialCutoffAssembledGradientState_eq_raw_ae
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
      (centeredCube3RadialCutoffMainGradientState
          rho R hRhoR index f j +
        centeredCube3RadialCutoffGradientState
          rho R hrho hRhoR index f j) y
        =
      centeredCube3RadialCutoffRawGradientFunction
          rho R index f j y := by

  have hAdd :=
    MeasureTheory.Lp.coeFn_add
      (centeredCube3RadialCutoffMainGradientState
        rho R hRhoR index f j)
      (centeredCube3RadialCutoffGradientState
        rho R hrho hRhoR index f j)

  have hMain :=
    centeredCube3RadialCutoffMainGradientState_eq_function_ae
      hRhoR index f j

  have hCutoff :=
    centeredCube3RadialCutoffGradientState_eq_function_ae
      hrho hRhoR index f j

  filter_upwards [hAdd, hMain, hCutoff] with y hadd hmain hcutoff
  rw [hadd]
  change
    centeredCube3RadialCutoffMainGradientState
          rho R hRhoR index f j y +
        centeredCube3RadialCutoffGradientState
          rho R hrho hRhoR index f j y
      =
    centeredCube3RadialCutoffRawGradientFunction
      rho R index f j y
  rw [hmain, hcutoff]
  rfl

/-- The raw pointwise product-rule gradient belongs to `L²`, because it agrees
a.e. with the already-constructed assembled `L²` state. -/
lemma centeredCube3RadialCutoffRawGradientFunction_memLp
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    MeasureTheory.MemLp
      (centeredCube3RadialCutoffRawGradientFunction
        rho R index f j)
      2 centeredCube3Measure := by

  let g : CenteredCube3L2 :=
    centeredCube3RadialCutoffMainGradientState
        rho R hRhoR index f j +
      centeredCube3RadialCutoffGradientState
        rho R hrho hRhoR index f j

  have hg :
      MeasureTheory.MemLp
        (fun y : CenteredCube3 => g y)
        2 centeredCube3Measure :=
    MeasureTheory.Lp.memLp g

  have hEq :
      (fun y : CenteredCube3 => g y)
        =ᵐ[centeredCube3Measure]
      centeredCube3RadialCutoffRawGradientFunction
        rho R index f j := by
    dsimp [g]
    exact
      centeredCube3RadialCutoffAssembledGradientState_eq_raw_ae
        hrho hRhoR index f j

  exact (MeasureTheory.memLp_congr_ae hEq).1 hg

/-- The canonical `toLp` realization of the raw gradient is exactly the
assembled gradient state used in milestones 84--89. -/
lemma centeredCube3RadialCutoffRawGradientFunction_toLp_eq
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    (centeredCube3RadialCutoffRawGradientFunction_memLp
        hrho hRhoR index f j).toLp
      (centeredCube3RadialCutoffRawGradientFunction
        rho R index f j)
      =
    centeredCube3RadialCutoffMainGradientState
        rho R hRhoR index f j +
      centeredCube3RadialCutoffGradientState
        rho R hrho hRhoR index f j := by

  apply MeasureTheory.Lp.ext

  have hCoe :=
    MeasureTheory.MemLp.coeFn_toLp
      (centeredCube3RadialCutoffRawGradientFunction_memLp
        hrho hRhoR index f j)

  have hState :=
    centeredCube3RadialCutoffAssembledGradientState_eq_raw_ae
      hrho hRhoR index f j

  filter_upwards [hCoe, hState] with y hcoe hstate
  rw [hcoe]
  exact hstate.symm

/-- Canonical `L²` witness for the localized inverse-radius function, now that
scalar inverse-radius integrability has been proved. -/
lemma centeredCube3RadialCutoffLocalizedFunction_memLp_canonical
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ) :
    MeasureTheory.MemLp
      (centeredCube3RadialCutoffLocalizedFunction rho R index f)
      2 centeredCube3Measure :=
  centeredCube3RadialCutoffLocalizedFunction_memLp_of_inverseRadius_memLp
    hRhoR centeredCube3InverseRadius_memLp index f

/--
The final near-origin analytic input, now written only in terms of actual
pointwise real-space functions.  No arbitrary `Lp` representative or weak-
gradient state occurs in this interface.

The next milestone can prove this statement by a direct Euclidean Hardy
argument (regularized divergence/integration by parts), with the product-rule
functions already fixed by the definitions above.
-/
structure CenteredCube3RadialCutoffPointwiseHardyData
    (rho R : ℝ) where

  rho_pos : 0 < rho
  rho_lt_outer : rho < R
  outer_lt_half : R < (1 / 2 : ℝ)

  hardy_raw_gradient :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical
                rho_lt_outer index f).toLp
              (centeredCube3RadialCutoffLocalizedFunction
                rho R index f)‖ ^ 2
            ≤
          4 *
            (∑ j : Fin 3,
              ‖(centeredCube3RadialCutoffRawGradientFunction_memLp
                    rho_pos rho_lt_outer index f j).toLp
                  (centeredCube3RadialCutoffRawGradientFunction
                    rho R index f j)‖ ^ 2)

/-- Pointwise Hardy data imply milestone 89's `Lp`-state formulation. -/
theorem
    CenteredCube3RadialCutoffPointwiseHardyData.toHardyOnlyData
    {rho R : ℝ}
    (data : CenteredCube3RadialCutoffPointwiseHardyData rho R) :
    CenteredCube3RadialCutoffHardyOnlyData rho R where

  rho_pos := data.rho_pos
  rho_lt_outer := data.rho_lt_outer
  outer_lt_half := data.outer_lt_half

  hardy_norm_sq_le_explicit_gradient := by
    intro α inst index hInjective f hMem

    let hCanonical :
        MeasureTheory.MemLp
          (centeredCube3RadialCutoffLocalizedFunction rho R index f)
          2 centeredCube3Measure :=
      centeredCube3RadialCutoffLocalizedFunction_memLp_canonical
        data.rho_lt_outer index f

    have hLocalizedEq :
        hMem.toLp
            (centeredCube3RadialCutoffLocalizedFunction rho R index f)
          =
        hCanonical.toLp
            (centeredCube3RadialCutoffLocalizedFunction rho R index f) := by
      apply MeasureTheory.Lp.ext
      have h1 := MeasureTheory.MemLp.coeFn_toLp hMem
      have h2 := MeasureTheory.MemLp.coeFn_toLp hCanonical
      filter_upwards [h1, h2] with y hy1 hy2
      exact hy1.trans hy2.symm

    have hHardy :=
      data.hardy_raw_gradient α index hInjective f

    rw [hLocalizedEq]

    calc
      ‖hCanonical.toLp
          (centeredCube3RadialCutoffLocalizedFunction rho R index f)‖ ^ 2
          ≤
        4 *
          (∑ j : Fin 3,
            ‖(centeredCube3RadialCutoffRawGradientFunction_memLp
                  data.rho_pos data.rho_lt_outer index f j).toLp
                (centeredCube3RadialCutoffRawGradientFunction
                  rho R index f j)‖ ^ 2) := by
            simpa [hCanonical] using hHardy
      _ =
        4 *
          (∑ j : Fin 3,
            ‖centeredCube3RadialCutoffMainGradientState
                  rho R data.rho_lt_outer index f j +
                centeredCube3RadialCutoffGradientState
                  rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2) := by
            apply congrArg (fun z : ℝ => 4 * z)
            apply Finset.sum_congr rfl
            intro j hj
            rw [centeredCube3RadialCutoffRawGradientFunction_toLp_eq
              data.rho_pos data.rho_lt_outer index f j]

/-!
## Ninetieth milestone

Both pieces of the weak gradient are now pointwise objects.  Lean proves that

* `chi * partial_j psi` is represented by
  `centeredCube3RadialCutoffMainGradientFunction`;
* `(partial_j chi) * psi` is represented by
  `centeredCube3RadialCutoffCutoffGradientFunction`;
* their sum is `centeredCube3RadialCutoffRawGradientFunction`;
* this raw function is in `L²`; and
* its canonical `toLp` realization is exactly the assembled gradient state used
  in all previous norm estimates.

Consequently the only near-origin analytic interface is now a Hardy inequality
for literal pointwise functions.  No Fourier-representative or product-rule
identification remains hidden in that interface.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

/-! ## Ninety-first milestone: reduce Hardy to the integration-by-parts cross estimate -/

/--
The elementary algebraic closure of the three-dimensional Hardy proof.

If nonnegative quantities `I` and `G` satisfy the integration-by-parts / Cauchy--
Schwarz estimate

`I ≤ 2 * sqrt I * sqrt G`,

then `I ≤ 4 * G`.  The constant `4` is therefore no longer part of the analytic
interface in the next structure.
-/
lemma hardy_four_mul_of_cross_bound
    {I G : ℝ}
    (hI : 0 ≤ I)
    (hG : 0 ≤ G)
    (hCross : I ≤ 2 * Real.sqrt I * Real.sqrt G) :
    I ≤ 4 * G := by
  have hsI0 : 0 ≤ Real.sqrt I := Real.sqrt_nonneg I
  have hsG0 : 0 ≤ Real.sqrt G := Real.sqrt_nonneg G
  have hsI2 : (Real.sqrt I) ^ 2 = I := Real.sq_sqrt hI
  have hsG2 : (Real.sqrt G) ^ 2 = G := Real.sq_sqrt hG
  have hSquare :
      0 ≤ (Real.sqrt I - 2 * Real.sqrt G) ^ 2 :=
    sq_nonneg _
  nlinarith

/--
The remaining Hardy input in the form produced directly by the classical proof
before squaring.  Analytically, this is the statement obtained from

`div (x / |x|²) = 1 / |x|²`,

integration by parts for the zero extension of `chi * psi`, and Cauchy--Schwarz.
All Fourier representatives, product-rule terms, and `L²` realizations have
already been made canonical in milestone 90.
-/
structure CenteredCube3RadialCutoffHardyCrossData
    (rho R : ℝ) where

  rho_pos : 0 < rho
  rho_lt_outer : rho < R
  outer_lt_half : R < (1 / 2 : ℝ)

  hardy_cross_bound :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical
                rho_lt_outer index f).toLp
              (centeredCube3RadialCutoffLocalizedFunction
                rho R index f)‖ ^ 2
            ≤
          2 *
            Real.sqrt
              (‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical
                    rho_lt_outer index f).toLp
                  (centeredCube3RadialCutoffLocalizedFunction
                    rho R index f)‖ ^ 2) *
            Real.sqrt
              (∑ j : Fin 3,
                ‖(centeredCube3RadialCutoffRawGradientFunction_memLp
                      rho_pos rho_lt_outer index f j).toLp
                    (centeredCube3RadialCutoffRawGradientFunction
                      rho R index f j)‖ ^ 2)

/-- The cross estimate implies milestone 90's full pointwise Hardy inequality. -/
theorem
    CenteredCube3RadialCutoffHardyCrossData.toPointwiseHardyData
    {rho R : ℝ}
    (data : CenteredCube3RadialCutoffHardyCrossData rho R) :
    CenteredCube3RadialCutoffPointwiseHardyData rho R where

  rho_pos := data.rho_pos
  rho_lt_outer := data.rho_lt_outer
  outer_lt_half := data.outer_lt_half

  hardy_raw_gradient := by
    intro α inst index hInjective f

    let I : ℝ :=
      ‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical
            data.rho_lt_outer index f).toLp
          (centeredCube3RadialCutoffLocalizedFunction
            rho R index f)‖ ^ 2

    let G : ℝ :=
      ∑ j : Fin 3,
        ‖(centeredCube3RadialCutoffRawGradientFunction_memLp
              data.rho_pos data.rho_lt_outer index f j).toLp
            (centeredCube3RadialCutoffRawGradientFunction
              rho R index f j)‖ ^ 2

    have hI : 0 ≤ I := by
      dsimp [I]
      exact sq_nonneg _

    have hG : 0 ≤ G := by
      dsimp [G]
      exact Finset.sum_nonneg (fun j hj => sq_nonneg _)

    have hCross : I ≤ 2 * Real.sqrt I * Real.sqrt G := by
      dsimp [I, G]
      exact data.hardy_cross_bound α index hInjective f

    have hHardy : I ≤ 4 * G :=
      hardy_four_mul_of_cross_bound hI hG hCross

    simpa [I, G] using hHardy

/-!
## Ninety-first milestone

The constant-four Hardy inequality is no longer assumed.  Its algebraic closure
is proved in Lean from the pre-squared cross estimate

`I ≤ 2 * sqrt I * sqrt G`.

Thus the remaining near-origin analytic task is exactly the classical
integration-by-parts/Cauchy--Schwarz estimate for the zero extension of the
compactly supported cutoff Fourier polynomial.  No spectral, Fourier, or `Lp`
identification remains in that task.
-/

end

end PlaneWaveCertificate

