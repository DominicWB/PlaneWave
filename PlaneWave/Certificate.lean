-- BEGIN RELEASE SOURCE 148b: Coulomb potential, reflection and physical Hamiltonian
section ReleaseMilestone148b

/-!
# Milestone 148b: the Coulomb potential, reflection and the physical Hamiltonian

The charge-weighted Coulomb potential as an actual function on the torus, its Fourier
coefficients, the identification of the potential completion with multiplication on the
whole `H²` domain, global reflection to the usual nuclear differences `x_a - R`, the
independently defined Hamiltonian graph (charge-weighted Coulomb multiplication plus the
mass-weighted weak kinetic equation), its physical Galerkin bridge, and the ground-pair and
cubic-minimum predicates (milestones 137--140 for a general system).
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology BigOperators

noncomputable section

variable {eta : ℕ} {ν : Type*} [Fintype ν]

local instance unitAddCircleMeasureSpaceForCoulombPotential148b :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-! ## The Coulomb potential in the Fourier convention -/

/-- The charge-weighted Coulomb function in the Fourier convention: each pair appears
once with the product of its charges, and the attraction of particle `a` to a nucleus
of charge `Z` carries `q_a Z`, evaluated at `x_a + R`. -/
def coulombFourierConventionPotential (sys : CoulombSystem eta ν) (L : ℝ)
    (x : MolecularPositionTorus eta) : ℂ :=
  (coulombCellAmplitude L : ℂ) *
    ((∑ pair : FiniteElectronPair eta,
        ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionDifference pair.1.1 pair.1.2 x)) +
      ∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) *
        ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearArgument i (sys.nuclei.position ell) x))

theorem coulombFourierConventionPotential_memLp (sys : CoulombSystem eta ν) (L : ℝ) :
    MemLp (coulombFourierConventionPotential sys L) 2 volume := by
  have hPair : MemLp (fun x : MolecularPositionTorus eta =>
      ∑ pair : FiniteElectronPair eta,
        ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionDifference pair.1.1 pair.1.2 x)) 2 volume := by
    apply memLp_finsetSum
    intro pair _
    exact (molecularPositionPairCoulomb_memLp pair.1.1 pair.1.2 (ne_of_lt pair.2)).const_mul _
  have hNuclear : MemLp (fun x : MolecularPositionTorus eta =>
      ∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) *
        ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearArgument i (sys.nuclei.position ell) x)) 2 volume := by
    apply memLp_finsetSum
    intro i _
    apply MemLp.const_mul
    apply memLp_finsetSum
    intro ell _
    exact (molecularPositionNuclearCoulomb_memLp i (sys.nuclei.position ell)).const_mul _
  exact (hPair.add hNuclear).const_mul (coulombCellAmplitude L : ℂ)

/-- The Coulomb function has exactly the charge-weighted nuclear and pair kernel. Every
coefficient, spectator constraint, charge and phase is derived from the function. -/
theorem coulombFourierConventionPotential_fourierCoeff (sys : CoulombSystem eta ν) (L : ℝ)
    (hL : 0 < L) (q p : FourierConfig eta Lattice3) :
    UnitAddTorus.mFourierCoeff (coulombFourierConventionPotential sys L)
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      coulombLatticeNuclearKernel sys (coulombCellAmplitude L) q p +
        coulombLatticePairKernel sys (coulombCellAmplitude L) q p := by
  classical
  let pairV : FiniteElectronPair eta → MolecularPositionTorus eta → ℂ :=
    fun pair x => canonicalUnitTorus3CoulombPotential.potential
      (molecularPositionDifference pair.1.1 pair.1.2 x)
  let nucV : Fin eta → ν → MolecularPositionTorus eta → ℂ :=
    fun i ell x => canonicalUnitTorus3CoulombPotential.potential
      (molecularPositionNuclearArgument i (sys.nuclei.position ell) x)
  have hPair : ∀ pair : FiniteElectronPair eta, MemLp (pairV pair) 2 volume :=
    fun pair => molecularPositionPairCoulomb_memLp pair.1.1 pair.1.2 (ne_of_lt pair.2)
  have hNuc : ∀ i ell, MemLp (nucV i ell) 2 volume :=
    fun i ell => molecularPositionNuclearCoulomb_memLp i (sys.nuclei.position ell)
  have hPairW : ∀ pair : FiniteElectronPair eta,
      MemLp (fun x => ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) * pairV pair x)
        2 volume :=
    fun pair => (hPair pair).const_mul _
  have hNucW : ∀ i ell,
      MemLp (fun x => (sys.nuclei.charge ell : ℂ) * nucV i ell x) 2 volume :=
    fun i ell => (hNuc i ell).const_mul _
  have hNucSum : ∀ i, MemLp (fun x => ∑ ell : ν,
      (sys.nuclei.charge ell : ℂ) * nucV i ell x) 2 volume :=
    fun i => memLp_finsetSum _ (fun ell _ => hNucW i ell)
  have hNucSumW : ∀ i, MemLp (fun x => ((sys.charge i : ℝ) : ℂ) * ∑ ell : ν,
      (sys.nuclei.charge ell : ℂ) * nucV i ell x) 2 volume :=
    fun i => (hNucSum i).const_mul _
  have hPairSum : MemLp (fun x => ∑ pair : FiniteElectronPair eta,
      ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) * pairV pair x) 2 volume :=
    memLp_finsetSum _ (fun pair _ => hPairW pair)
  have hAllNuc : MemLp (fun x => ∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) * ∑ ell : ν,
      (sys.nuclei.charge ell : ℂ) * nucV i ell x) 2 volume :=
    memLp_finsetSum _ (fun i _ => hNucSumW i)
  have hNucK : ∀ (i : Fin eta) (ell : ν),
      latticeReferenceConfigurationKernel i
          (latticeElectronNuclearKernel sys.nuclei (coulombCellAmplitude L) ell) q p =
        -(coulombCellAmplitude L : ℂ) * (sys.nuclei.charge ell : ℂ) *
          UnitAddTorus.mFourierCoeff (nucV i ell)
            (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) :=
    fun i ell => (molecularPositionNuclearCoulomb_scaled_fourierCoeff L hL sys.nuclei i ell q p).symm
  have hPairK : ∀ pair : FiniteElectronPair eta,
      latticeElectronPairConfigurationKernel pair.1.1 pair.1.2
          ((coulombCellAmplitude L) ^ 2) q p =
        (coulombCellAmplitude L : ℂ) *
          UnitAddTorus.mFourierCoeff (pairV pair)
            (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) :=
    fun pair => (molecularPositionPairCoulomb_scaled_fourierCoeff L hL
      pair.1.1 pair.1.2 (ne_of_lt pair.2) q p).symm
  rw [add_comm (coulombLatticeNuclearKernel sys (coulombCellAmplitude L) q p)]
  change UnitAddTorus.mFourierCoeff
    (fun x => (coulombCellAmplitude L : ℂ) *
      ((∑ pair : FiniteElectronPair eta,
          ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) * pairV pair x) +
        ∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) * ∑ ell : ν,
          (sys.nuclei.charge ell : ℂ) * nucV i ell x)) _ = _
  rw [torus_mFourierCoeff_const_mul,
    torus_mFourierCoeff_add_of_memLp _ _ hPairSum hAllNuc,
    torus_mFourierCoeff_fintypeSum_of_memLp _ hPairW,
    torus_mFourierCoeff_fintypeSum_of_memLp _ hNucSumW]
  simp_rw [torus_mFourierCoeff_const_mul]
  simp_rw [torus_mFourierCoeff_fintypeSum_of_memLp _ (hNucW _), torus_mFourierCoeff_const_mul]
  rw [mul_add]
  congr 1
  · unfold coulombLatticePairKernel
    simp only [hPairK, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro pair _hpair
    ring
  · unfold coulombLatticeNuclearKernel
    simp only [hNucK, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _hi
    apply Finset.sum_congr rfl
    intro ell _hell
    push_cast
    ring

/-! ## The potential completion is multiplication -/

/-- Matching coefficients identify the potential part on each Fourier core with the
actual product. -/
theorem coulombPositionPotentialH2_core_eq_of_fourierCoeff (sys : CoulombSystem eta ν)
    (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (V : MolecularPositionTorus eta → ℂ) (hV : MemLp V 2 volume)
    (hCoeff : ∀ q p : FourierConfig eta Lattice3,
      UnitAddTorus.mFourierCoeff V
          (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
        coulombLatticeNuclearKernel sys (coulombCellAmplitude L) q p +
          coulombLatticePairKernel sys (coulombCellAmplitude L) q p)
    (N : ℕ) (u : MolecularFourierH2 eta) :
    coulombPositionPotentialH2 sys (2 * Real.pi / L) H (molecularH2Truncate N u) =
      molecularPositionPotentialFourierProduct eta V hV (fourierConfigCube eta N)
        (molecularH2Coeff (2 * Real.pi / L) u) := by
  apply (molecularPositionSynthesis eta).symm.injective
  apply lp.ext
  funext q
  change (molecularPositionSynthesis eta).symm
      (molecularPositionSynthesis eta
        (coulombFourierPotentialH2 sys (2 * Real.pi / L) H (molecularH2Truncate N u))) q = _
  rw [LinearIsometryEquiv.symm_apply_apply, coulombFourierPotentialH2_core sys L H hKernel,
    molecularPositionPotentialFourierProduct_fourier]
  unfold fourierCubeKernelAction
  apply Finset.sum_congr rfl
  intro p _hp
  rw [hCoeff]

/-- The coefficient identity identifies multiplication on the whole `H²` domain. -/
theorem coulombPositionPotentialH2_pointwise_of_fourierCoeff (sys : CoulombSystem eta ν)
    (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (V : MolecularPositionTorus eta → ℂ) (hV : MemLp V 2 volume)
    (hCoeff : ∀ q p : FourierConfig eta Lattice3,
      UnitAddTorus.mFourierCoeff V
          (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
        coulombLatticeNuclearKernel sys (coulombCellAmplitude L) q p +
          coulombLatticePairKernel sys (coulombCellAmplitude L) q p)
    (u : MolecularFourierH2 eta) :
    HasL2PointwisePotential volume V
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (coulombPositionPotentialH2 sys (2 * Real.pi / L) H u) := by
  refine (molecularPositionH2Operator_pointwise_iff_core eta (2 * Real.pi / L) V
    (coulombPositionPotentialH2 sys (2 * Real.pi / L) H)).mpr (fun N v => ?_) u
  rw [coulombPositionPotentialH2_core_eq_of_fourierCoeff sys L H hKernel V hV hCoeff N v,
    molecularPositionPotentialFourierProduct_eq_continuousProduct,
    ← molecularPositionFourierTest_cube_toLp]
  exact torusPotentialContinuousProduct_graph V hV
    (molecularPositionFourierTest eta (fourierConfigCube eta N)
      (molecularH2Coeff (2 * Real.pi / L) v))

/-- The potential completion is multiplication by the Coulomb function on all of `H²`. -/
theorem coulombPositionPotentialH2_fourierConventionPointwise (sys : CoulombSystem eta ν)
    (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (u : MolecularFourierH2 eta) :
    HasL2PointwisePotential volume (coulombFourierConventionPotential sys L)
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (coulombPositionPotentialH2 sys (2 * Real.pi / L) H u) :=
  coulombPositionPotentialH2_pointwise_of_fourierCoeff sys L H hKernel
    (coulombFourierConventionPotential sys L) (coulombFourierConventionPotential_memLp sys L)
    (coulombFourierConventionPotential_fourierCoeff sys L hL) u

/-- The Hamiltonian relation in the Fourier convention: Coulomb multiplication plus the
mass-weighted weak kinetic equation. -/
def HasCoulombFourierConventionHamiltonian (sys : CoulombSystem eta ν) (L : ℝ)
    (f h : MolecularPositionL2 eta) : Prop :=
  ∃ v : MolecularPositionL2 eta,
    HasL2PointwisePotential volume (coulombFourierConventionPotential sys L) f v ∧
    HasCoulombContDiffWeakKinetic sys L f (h - v)

theorem molecularPositionHamiltonianH2_coulombFourierConvention (sys : CoulombSystem eta ν)
    (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (u : MolecularFourierH2 eta) :
    HasCoulombFourierConventionHamiltonian sys L
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (molecularPositionHamiltonianH2 H u) :=
  ⟨coulombPositionPotentialH2 sys (2 * Real.pi / L) H u,
    coulombPositionPotentialH2_fourierConventionPointwise sys L hL H hKernel u,
    coulombPositionHamiltonianH2_sub_potential_contDiffWeak sys L H u⟩

/-- The Hamiltonian relation in the Fourier convention has exactly the graph of the
completed operator on `H²`. -/
theorem hasCoulombFourierConventionHamiltonian_iff_H2 (sys : CoulombSystem eta ν) (L : ℝ)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (f h : MolecularPositionL2 eta) :
    HasCoulombFourierConventionHamiltonian sys L f h ↔
      ∃ u : MolecularFourierH2 eta,
        molecularPositionH2StateMap eta (2 * Real.pi / L) u = f ∧
        molecularPositionHamiltonianH2 H u = h := by
  constructor
  · rintro ⟨v, hv, hweak⟩
    obtain ⟨u, huState, huKinetic⟩ :=
      (hasCoulombContDiffWeakKinetic_iff_H2 sys L f (h - v)).mp hweak
    have huPotential :=
      coulombPositionPotentialH2_fourierConventionPointwise sys L hL H hKernel u
    rw [huState] at huPotential
    have huValue : coulombPositionPotentialH2 sys (2 * Real.pi / L) H u = v :=
      huPotential.unique hv
    refine ⟨u, huState, ?_⟩
    rw [coulombPositionHamiltonianH2_decomposition sys (2 * Real.pi / L) H u,
      huKinetic, huValue, sub_add_cancel]
  · rintro ⟨u, rfl, rfl⟩
    exact molecularPositionHamiltonianH2_coulombFourierConvention sys L hL H hKernel u

/-! ## Reflection to the usual nuclear differences -/

/-- The charge-weighted Coulomb potential in the usual position convention: the
attraction to a nucleus at `R` is evaluated at `x_a - R`. -/
def coulombPotential (sys : CoulombSystem eta ν) (L : ℝ)
    (x : MolecularPositionTorus eta) : ℂ :=
  (coulombCellAmplitude L : ℂ) *
    ((∑ pair : FiniteElectronPair eta,
        ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionDifference pair.1.1 pair.1.2 x)) +
      ∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) *
        ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearDifference i (sys.nuclei.position ell) x))

/-- The potential in the usual convention is the reflection of the potential in the
Fourier convention. -/
theorem coulombFourierConventionPotential_reflect_ae (sys : CoulombSystem eta ν) (L : ℝ) :
    (fun x : MolecularPositionTorus eta => coulombFourierConventionPotential sys L (-x))
      =ᵐ[volume] coulombPotential sys L := by
  have hPair : ∀ᵐ x : MolecularPositionTorus eta ∂volume,
      ∀ pair : FiniteElectronPair eta,
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 (-x)) =
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 x) :=
    ae_all_iff.mpr fun pair => molecularPositionPairCoulomb_reflect_ae
      pair.1.1 pair.1.2 (ne_of_lt pair.2)
  have hNuclear : ∀ᵐ x : MolecularPositionTorus eta ∂volume,
      ∀ i : Fin eta, ∀ ell : ν,
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionNuclearArgument i (sys.nuclei.position ell) (-x)) =
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionNuclearDifference i (sys.nuclei.position ell) x) :=
    ae_all_iff.mpr fun i => ae_all_iff.mpr fun ell =>
      molecularPositionNuclearCoulomb_reflect_ae i (sys.nuclei.position ell)
  filter_upwards [hPair, hNuclear] with x hPx hNx
  simp only [coulombFourierConventionPotential, coulombPotential, hPx, hNx]

omit [Fintype ν] in
/-- Momentum reversal preserves the kinetic energy. -/
lemma coulombKineticEnergySymbol_neg (sys : CoulombSystem eta ν) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    coulombKineticEnergySymbol sys g (-p) = coulombKineticEnergySymbol sys g p := by
  simp only [coulombKineticEnergySymbol, latticeNormSq, Pi.neg_apply, Int.cast_neg, neg_sq]

omit [Fintype ν] in
theorem HasCoulombWeakKinetic.reflection {sys : CoulombSystem eta ν} {g : ℝ}
    {f k : MolecularPositionL2 eta} (h : HasCoulombWeakKinetic sys g f k) :
    HasCoulombWeakKinetic sys g
      (molecularPositionReflection eta f) (molecularPositionReflection eta k) := by
  apply (hasCoulombWeakKinetic_iff_coeff sys g _ _).mpr
  intro p
  rw [molecularPositionReflection_fourier, molecularPositionReflection_fourier]
  simpa only [coulombKineticEnergySymbol_neg] using
    (hasCoulombWeakKinetic_iff_coeff sys g f k).mp h (-p)

omit [Fintype ν] in
theorem HasCoulombContDiffWeakKinetic.reflection {sys : CoulombSystem eta ν} {L : ℝ}
    {f k : MolecularPositionL2 eta} (h : HasCoulombContDiffWeakKinetic sys L f k) :
    HasCoulombContDiffWeakKinetic sys L
      (molecularPositionReflection eta f) (molecularPositionReflection eta k) :=
  (hasCoulombContDiffWeakKinetic_iff sys L _ _).mpr
    ((hasCoulombContDiffWeakKinetic_iff sys L f k).mp h).reflection

/-- Reflection preserves every exchange sector. -/
theorem molecularPositionReflection_preserves_sector (eta : ℕ) {sgn : Fin eta → ℂ}
    {lab : Fin eta → ℕ} (f : MolecularPositionL2 eta) (hS : IsPositionSector sgn lab f) :
    IsPositionSector sgn lab (molecularPositionReflection eta f) := by
  intro i j hij hlab
  filter_upwards [molecularPositionReflection_coeFn eta f,
    (molecularPositionSwap_measurePreserving i j).quasiMeasurePreserving.ae
      (molecularPositionReflection_coeFn eta f),
    (molecularPosition_neg_measurePreserving eta).quasiMeasurePreserving.ae
      (hS i j hij hlab)] with x hReflect hSwap hSector
  calc
    molecularPositionReflection eta f (molecularPositionSwap i j x) =
        f (-molecularPositionSwap i j x) := hSwap
    _ = f (molecularPositionSwap i j (-x)) := rfl
    _ = sgn i * f (-x) := hSector
    _ = sgn i * (molecularPositionReflection eta f x) := by rw [hReflect]

theorem molecularPositionReflection_isSector_iff (eta : ℕ) (sgn : Fin eta → ℂ)
    (lab : Fin eta → ℕ) (f : MolecularPositionL2 eta) :
    IsPositionSector sgn lab (molecularPositionReflection eta f) ↔
      IsPositionSector sgn lab f := by
  constructor
  · intro hS
    have h := molecularPositionReflection_preserves_sector eta
      (molecularPositionReflection eta f) hS
    simpa only [molecularPositionReflection_involutive] using h
  · exact molecularPositionReflection_preserves_sector eta f

/-- The Hamiltonian of a Coulomb system in the usual position convention: Coulomb
multiplication with the charges and the nuclear differences `x_a - R`, and a residual
satisfying the mass-weighted `C²` weak kinetic equation. -/
def HasCoulombHamiltonian (sys : CoulombSystem eta ν) (L : ℝ)
    (f h : MolecularPositionL2 eta) : Prop :=
  ∃ v : MolecularPositionL2 eta,
    HasL2PointwisePotential volume (coulombPotential sys L) f v ∧
    HasCoulombContDiffWeakKinetic sys L f (h - v)

theorem hasCoulombFourierConventionHamiltonian_reflection_iff (sys : CoulombSystem eta ν)
    (L : ℝ) (f h : MolecularPositionL2 eta) :
    HasCoulombHamiltonian sys L
        (molecularPositionReflection eta f) (molecularPositionReflection eta h) ↔
      HasCoulombFourierConventionHamiltonian sys L f h := by
  constructor
  · rintro ⟨v, hv, hweak⟩
    refine ⟨molecularPositionReflection eta v, ?_, ?_⟩
    · apply (hasL2PointwisePotential_reflection_iff eta
        (coulombFourierConventionPotential sys L) (coulombPotential sys L)
        (coulombFourierConventionPotential_reflect_ae sys L)
        f (molecularPositionReflection eta v)).mp
      simpa only [molecularPositionReflection_involutive] using hv
    · simpa only [map_sub, molecularPositionReflection_involutive] using hweak.reflection
  · rintro ⟨v, hv, hweak⟩
    refine ⟨molecularPositionReflection eta v, ?_, ?_⟩
    · exact hv.reflection (coulombFourierConventionPotential_reflect_ae sys L)
    · simpa only [map_sub] using hweak.reflection

/-- The Hamiltonian in the usual convention is the reflected completed operator on `H²`. -/
theorem hasCoulombHamiltonian_iff_reflectedH2 (sys : CoulombSystem eta ν) (L : ℝ)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (f h : MolecularPositionL2 eta) :
    HasCoulombHamiltonian sys L f h ↔
      ∃ u : MolecularFourierH2 eta,
        molecularPositionReflection eta
          (molecularPositionH2StateMap eta (2 * Real.pi / L) u) = f ∧
        molecularPositionReflection eta (molecularPositionHamiltonianH2 H u) = h := by
  constructor
  · intro hPhysical
    have hTwice : HasCoulombHamiltonian sys L
        (molecularPositionReflection eta (molecularPositionReflection eta f))
        (molecularPositionReflection eta (molecularPositionReflection eta h)) := by
      simpa only [molecularPositionReflection_involutive] using hPhysical
    have hPlus :=
      (hasCoulombFourierConventionHamiltonian_reflection_iff sys L
        (molecularPositionReflection eta f) (molecularPositionReflection eta h)).mp hTwice
    obtain ⟨u, huState, huAction⟩ :=
      (hasCoulombFourierConventionHamiltonian_iff_H2 sys L hL H hKernel
        (molecularPositionReflection eta f) (molecularPositionReflection eta h)).mp hPlus
    refine ⟨u, ?_, ?_⟩
    · simpa only [molecularPositionReflection_involutive] using
        congrArg (molecularPositionReflection eta) huState
    · simpa only [molecularPositionReflection_involutive] using
        congrArg (molecularPositionReflection eta) huAction
  · rintro ⟨u, rfl, rfl⟩
    exact (hasCoulombFourierConventionHamiltonian_reflection_iff sys L
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (molecularPositionHamiltonianH2 H u)).mpr
        (molecularPositionHamiltonianH2_coulombFourierConvention sys L hL H hKernel u)

/-! ## The physical Galerkin bridge -/

/-- The Galerkin bridge of a Coulomb system in the usual position convention. -/
def coulombPhysicalGalerkinBridge (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ) (L : ℝ)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q) :
    ContinuumCoulombGalerkinBridge sys lab L (MolecularPositionL2 eta)
      (molecularPhysicalH2Domain eta (2 * Real.pi / L)) :=
  continuumCoulombGalerkinBridge_unitaryTransport
    (coulombPositionGalerkinBridge sys lab L hL H hKernel) (molecularPositionReflection eta)

@[simp] theorem coulombPhysicalGalerkinBridge_hamiltonian_H2 (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (u : MolecularFourierH2 eta) :
    (coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian
      (molecularPhysicalH2DomainEquiv eta (2 * Real.pi / L) u) =
      molecularPositionReflection eta (molecularPositionHamiltonianH2 H u) := by
  change (continuumCoulombGalerkinBridge_unitaryTransport
    (coulombPositionGalerkinBridge sys lab L hL H hKernel)
    (molecularPositionReflection eta)).hamiltonian
      (continuumDomainUnitaryEquiv (molecularPositionReflection eta)
        (molecularPositionH2Domain eta (2 * Real.pi / L))
        (molecularPositionDomainEquiv eta (2 * Real.pi / L)
          (molecularFourierH2DomainEquiv eta (2 * Real.pi / L) u))) = _
  rw [continuumCoulombGalerkinBridge_unitaryTransport_hamiltonian]
  change molecularPositionReflection eta
    ((continuumCoulombGalerkinBridge_unitaryTransport
      (coulombFourierGalerkinBridge sys lab L hL H hKernel)
      (molecularPositionSynthesis eta)).hamiltonian
      (continuumDomainUnitaryEquiv (molecularPositionSynthesis eta)
        (molecularFourierH2Domain eta (2 * Real.pi / L))
        (molecularFourierH2DomainEquiv eta (2 * Real.pi / L) u))) = _
  rw [continuumCoulombGalerkinBridge_unitaryTransport_hamiltonian]
  change molecularPositionReflection eta (molecularPositionSynthesis eta
    (molecularFourierDomainOperator (2 * Real.pi / L) H
      (molecularFourierH2DomainEquiv eta (2 * Real.pi / L) u))) = _
  simpa only [molecularPositionHamiltonianH2_apply] using
    congrArg (fun z => molecularPositionReflection eta (molecularPositionSynthesis eta z))
      (molecularFourierDomainOperator_apply_equiv (2 * Real.pi / L) H u)

/-- The independently defined Hamiltonian graph is exactly the graph of the physical
Galerkin Hamiltonian on its whole domain. -/
theorem hasCoulombHamiltonian_iff_physicalGalerkinBridge (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (f h : MolecularPositionL2 eta) :
    HasCoulombHamiltonian sys L f h ↔
      ∃ z : molecularPhysicalH2Domain eta (2 * Real.pi / L),
        (z : MolecularPositionL2 eta) = f ∧
        (coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian z = h := by
  rw [hasCoulombHamiltonian_iff_reflectedH2 sys L hL H hKernel]
  constructor
  · rintro ⟨u, huState, huAction⟩
    refine ⟨molecularPhysicalH2DomainEquiv eta (2 * Real.pi / L) u, ?_, ?_⟩
    · exact (molecularPhysicalH2DomainEquiv_coe eta (2 * Real.pi / L) u).trans huState
    · exact (coulombPhysicalGalerkinBridge_hamiltonian_H2 sys lab L hL H hKernel u).trans
        huAction
  · rintro ⟨z, hzState, hzAction⟩
    obtain ⟨u, rfl⟩ := (molecularPhysicalH2DomainEquiv eta (2 * Real.pi / L)).surjective z
    refine ⟨u, ?_, ?_⟩
    · exact (molecularPhysicalH2DomainEquiv_coe eta (2 * Real.pi / L) u).symm.trans hzState
    · exact (coulombPhysicalGalerkinBridge_hamiltonian_H2 sys lab L hL H hKernel u).symm.trans
        hzAction

theorem coulombPhysicalGalerkinBridge_coulombHamiltonian (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (z : molecularPhysicalH2Domain eta (2 * Real.pi / L)) :
    HasCoulombHamiltonian sys L (z : MolecularPositionL2 eta)
      ((coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian z) :=
  (hasCoulombHamiltonian_iff_physicalGalerkinBridge sys lab L hL H hKernel _ _).mpr
    ⟨z, rfl, rfl⟩

/-- The sector of the physical bridge is the almost-everywhere exchange sector. -/
theorem coulombPhysicalGalerkinBridge_sector_iff (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (f : MolecularPositionL2 eta) :
    (coulombPhysicalGalerkinBridge sys lab L hL H hKernel).sector f ↔
      IsPositionSector sys.sign lab f := by
  change (coulombPositionGalerkinBridge sys lab L hL H hKernel).sector
    ((molecularPositionReflection eta).symm f) ↔ _
  rw [molecularPositionReflection_symm, coulombPositionGalerkinBridge_sector_iff,
    molecularPositionReflection_isSector_iff]

/-- The cubic subspaces of the physical bridge are the ordinary cubic Fourier supports. -/
theorem coulombPhysicalGalerkinBridge_cubic_iff (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (K : ℝ) (f : MolecularPositionL2 eta) :
    (coulombPhysicalGalerkinBridge sys lab L hL H hKernel).cubic K f ↔
      IsMolecularPositionCubic eta L K f := by
  change IsLatticeCubicCoeff eta K (2 * Real.pi / L)
    (fun p => (molecularPositionSynthesis eta).symm
      ((molecularPositionReflection eta).symm f) p) ↔ _
  rw [molecularPositionReflection_symm]
  exact molecularPositionReflection_isCubic_iff eta K (2 * Real.pi / L) f

/-- The ground state and cubic Ritz theorem for the Hamiltonian in the usual position
convention, with its exact `H²` graph. -/
theorem coulomb_physical_cubic_error (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ∃ H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
    ∃ hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
        fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q,
      (∀ u, ‖H u‖ ≤ ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) * ‖u‖) ∧
      (∀ f h : MolecularPositionL2 eta,
        HasCoulombHamiltonian sys L f h ↔
          ∃ z : molecularPhysicalH2Domain eta (2 * Real.pi / L),
            (z : MolecularPositionL2 eta) = f ∧
            (coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian z = h) ∧
      ∃ E : ℝ, ∃ psi : molecularPhysicalH2Domain eta (2 * Real.pi / L),
        HasContinuumSectorGroundPair (coulombPhysicalGalerkinBridge sys lab L hL H hKernel)
          psi E ∧
        ∀ K rho Blow Cs Bker : ℝ,
          1 ≤ K → 0 ≤ rho → rho ^ 2 * K = 1 →
          0 ≤ Blow → 0 ≤ Cs → 0 ≤ Bker →
          2 * (2 * Real.pi / L) ≤ K →
          54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L) →
          432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2 →
          1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2 →
          4 * sys.maxMass * (|E| + 1) ≤ K ^ 2 →
          32 * sys.massMoment 2 *
            (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
              (continuumCoulombH2Constant sys E L Hunit)) ^ 2 ≤ K ^ 5 →
          ∀ m : ℕ, 1 ≤ m → K * L = 2 * Real.pi * (m : ℝ) →
            eta ≤ (2 * m + 1) ^ 3 →
          ∃ EN : ℝ, IsContinuumSectorCubicGroundEnergy
            (coulombPhysicalGalerkinBridge sys lab L hL H hKernel) K EN ∧
            (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
            0 ≤ EN - E ∧
            EN - E ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ∧
            continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ≤
              ((3 * L / (2 * Real.pi)) ^ 3 *
                continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker) /
                (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨H, hKernel, hNorm, E, psi, hPair, hCubic⟩ :=
    coulomb_position_cubic_error sys lab hlab L Hunit hL hPeriodic
  refine ⟨H, hKernel, hNorm, ?_, E, molecularPhysicalDomainEquiv eta (2 * Real.pi / L) psi,
    ?_, ?_⟩
  · exact fun f h =>
      hasCoulombHamiltonian_iff_physicalGalerkinBridge sys lab L hL H hKernel f h
  · exact (hasContinuumSectorGroundPair_unitaryTransport_iff
      (coulombPositionGalerkinBridge sys lab L hL H hKernel)
      (molecularPositionReflection eta) psi E).mpr hPair
  · intro K rho Blow Cs Bker hK hRho hRhoK hBlow hCs hBker hGrid hLow hKernelScale
      hSobolev hEnergy hTail m hm hCutoff hCount
    obtain ⟨EN, hEN, hCard, hNonneg, hRate, hCountRate⟩ :=
      hCubic K rho Blow Cs Bker hK hRho hRhoK hBlow hCs hBker hGrid hLow hKernelScale
        hSobolev hEnergy hTail m hm hCutoff hCount
    refine ⟨EN, ?_, hCard, hNonneg, hRate, hCountRate⟩
    exact (isContinuumSectorCubicGroundEnergy_unitaryTransport_iff
      (coulombPositionGalerkinBridge sys lab L hL H hKernel)
      (molecularPositionReflection eta) K EN).mpr hEN

/-! ## Physical ground pairs and cubic minima -/

/-- A normalized ground eigenpair of the Hamiltonian of a Coulomb system in the exchange
sector of `lab`, with the lower bound over every graph element of that sector. -/
def HasCoulombSectorGroundPair (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ) (L : ℝ)
    (psi : MolecularPositionL2 eta) (E : ℝ) : Prop :=
  IsPositionSector sys.sign lab psi ∧ ‖psi‖ = 1 ∧
    HasCoulombHamiltonian sys L psi ((E : ℂ) • psi) ∧
    ∀ f h : MolecularPositionL2 eta, IsPositionSector sys.sign lab f →
      HasCoulombHamiltonian sys L f h →
      E * ‖f‖ ^ 2 ≤ (inner ℂ f h).re

/-- The attained cubic Ritz minimum of a Coulomb system in the exchange sector of `lab`. -/
def IsCoulombSectorCubicGroundEnergy (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (L K EN : ℝ) : Prop :=
  (∀ f h : MolecularPositionL2 eta, IsPositionSector sys.sign lab f →
    IsMolecularPositionCubic eta L K f →
    HasCoulombHamiltonian sys L f h →
    EN * ‖f‖ ^ 2 ≤ (inner ℂ f h).re) ∧
  ∃ f h : MolecularPositionL2 eta, IsPositionSector sys.sign lab f ∧
    IsMolecularPositionCubic eta L K f ∧ ‖f‖ = 1 ∧
    HasCoulombHamiltonian sys L f h ∧ (inner ℂ f h).re = EN

theorem hasCoulombSectorGroundPair_iff_physicalGalerkinBridge (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (psi : molecularPhysicalH2Domain eta (2 * Real.pi / L)) (E : ℝ) :
    HasCoulombSectorGroundPair sys lab L (psi : MolecularPositionL2 eta) E ↔
      HasContinuumSectorGroundPair
        (coulombPhysicalGalerkinBridge sys lab L hL H hKernel) psi E := by
  constructor
  · rintro ⟨hSector, hNorm, hEigen, hLower⟩
    refine ⟨(coulombPhysicalGalerkinBridge_sector_iff
      sys lab L hL H hKernel _).mpr hSector, hNorm, ?_, ?_⟩
    · obtain ⟨z, hzState, hzAction⟩ :=
        (hasCoulombHamiltonian_iff_physicalGalerkinBridge
          sys lab L hL H hKernel _ _).mp hEigen
      have hz : z = psi := Subtype.ext hzState
      subst z
      exact hzAction
    · intro z hzSector
      exact hLower (z : MolecularPositionL2 eta)
        ((coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian z)
        ((coulombPhysicalGalerkinBridge_sector_iff
          sys lab L hL H hKernel _).mp hzSector)
        (coulombPhysicalGalerkinBridge_coulombHamiltonian
          sys lab L hL H hKernel z)
  · rintro ⟨hSector, hNorm, hEigen, hLower⟩
    refine ⟨(coulombPhysicalGalerkinBridge_sector_iff
      sys lab L hL H hKernel _).mp hSector, hNorm, ?_, ?_⟩
    · exact (hasCoulombHamiltonian_iff_physicalGalerkinBridge
        sys lab L hL H hKernel _ _).mpr ⟨psi, rfl, hEigen⟩
    · intro f h hf hh
      obtain ⟨z, hzState, hzAction⟩ :=
        (hasCoulombHamiltonian_iff_physicalGalerkinBridge
          sys lab L hL H hKernel f h).mp hh
      have hzSector := (coulombPhysicalGalerkinBridge_sector_iff
        sys lab L hL H hKernel (z : MolecularPositionL2 eta)).mpr
          (by rw [hzState]; exact hf)
      have hzLower := hLower z hzSector
      change E * ‖(z : MolecularPositionL2 eta)‖ ^ 2 ≤
        (inner ℂ (z : MolecularPositionL2 eta)
          ((coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian z)).re
        at hzLower
      simpa only [hzState, hzAction] using hzLower

theorem isCoulombSectorCubicGroundEnergy_iff_physicalGalerkinBridge
    (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (K EN : ℝ) :
    IsCoulombSectorCubicGroundEnergy sys lab L K EN ↔
      IsContinuumSectorCubicGroundEnergy
        (coulombPhysicalGalerkinBridge sys lab L hL H hKernel) K EN := by
  constructor
  · rintro ⟨hLower, f, h, hf, hCube, hNorm, hGraph, hEnergy⟩
    constructor
    · intro z hzSector hzCubic
      exact hLower (z : MolecularPositionL2 eta)
        ((coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian z)
        ((coulombPhysicalGalerkinBridge_sector_iff
          sys lab L hL H hKernel _).mp hzSector)
        ((coulombPhysicalGalerkinBridge_cubic_iff
          sys lab L hL H hKernel K _).mp hzCubic)
        (coulombPhysicalGalerkinBridge_coulombHamiltonian
          sys lab L hL H hKernel z)
    · obtain ⟨z, hzState, hzAction⟩ :=
        (hasCoulombHamiltonian_iff_physicalGalerkinBridge
          sys lab L hL H hKernel f h).mp hGraph
      refine ⟨z, ?_, ?_, ?_, ?_⟩
      · apply (coulombPhysicalGalerkinBridge_sector_iff
          sys lab L hL H hKernel _).mpr
        rw [hzState]
        exact hf
      · apply (coulombPhysicalGalerkinBridge_cubic_iff
          sys lab L hL H hKernel K _).mpr
        rw [hzState]
        exact hCube
      · change ‖(z : MolecularPositionL2 eta)‖ = 1
        simpa only [hzState] using hNorm
      · simpa only [hzState, hzAction] using hEnergy
  · rintro ⟨hLower, z, hzSector, hzCubic, hzNorm, hzEnergy⟩
    constructor
    · intro f h hf hCube hGraph
      obtain ⟨w, hwState, hwAction⟩ :=
        (hasCoulombHamiltonian_iff_physicalGalerkinBridge
          sys lab L hL H hKernel f h).mp hGraph
      have hwSector := (coulombPhysicalGalerkinBridge_sector_iff
        sys lab L hL H hKernel (w : MolecularPositionL2 eta)).mpr
          (by rw [hwState]; exact hf)
      have hwCubic := (coulombPhysicalGalerkinBridge_cubic_iff
        sys lab L hL H hKernel K (w : MolecularPositionL2 eta)).mpr
          (by rw [hwState]; exact hCube)
      have hwLower := hLower w hwSector hwCubic
      change EN * ‖(w : MolecularPositionL2 eta)‖ ^ 2 ≤
        (inner ℂ (w : MolecularPositionL2 eta)
          ((coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian w)).re
        at hwLower
      simpa only [hwState, hwAction] using hwLower
    · exact ⟨(z : MolecularPositionL2 eta),
        (coulombPhysicalGalerkinBridge sys lab L hL H hKernel).hamiltonian z,
        (coulombPhysicalGalerkinBridge_sector_iff
          sys lab L hL H hKernel _).mp hzSector,
        (coulombPhysicalGalerkinBridge_cubic_iff
          sys lab L hL H hKernel K _).mp hzCubic,
        hzNorm, coulombPhysicalGalerkinBridge_coulombHamiltonian
          sys lab L hL H hKernel z, hzEnergy⟩

/-- The ground energy is unique. -/
theorem HasCoulombSectorGroundPair.energy_unique {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} {L : ℝ} {psi phi : MolecularPositionL2 eta} {E F : ℝ}
    (hE : HasCoulombSectorGroundPair sys lab L psi E)
    (hF : HasCoulombSectorGroundPair sys lab L phi F) : E = F := by
  apply le_antisymm
  · have h := hE.2.2.2 phi ((F : ℂ) • phi) hF.1 hF.2.2.1
    rw [inner_smul_right, inner_self_eq_norm_sq_to_K] at h
    simpa [hF.2.1] using h
  · have h := hF.2.2.2 psi ((E : ℂ) • psi) hE.1 hE.2.2.1
    rw [inner_smul_right, inner_self_eq_norm_sq_to_K] at h
    simpa [hE.2.1] using h

/-- The cubic Ritz energy is unique. -/
theorem IsCoulombSectorCubicGroundEnergy.unique {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} {L K : ℝ} {E F : ℝ}
    (hE : IsCoulombSectorCubicGroundEnergy sys lab L K E)
    (hF : IsCoulombSectorCubicGroundEnergy sys lab L K F) : E = F := by
  obtain ⟨f, h, hf, hCube, hNorm, hGraph, hEnergy⟩ := hF.2
  obtain ⟨g, k, hg, hgCube, hgNorm, hgGraph, hgEnergy⟩ := hE.2
  apply le_antisymm
  · have hLower := hE.1 f h hf hCube hGraph
    simpa only [hNorm, one_pow, mul_one, hEnergy] using hLower
  · have hLower := hF.1 g k hg hgCube hgGraph
    simpa only [hgNorm, one_pow, mul_one, hgEnergy] using hLower

/-- The ground energy is at most every cubic Ritz energy. -/
theorem HasCoulombSectorGroundPair.le_cubicGroundEnergy {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} {L K : ℝ} {psi : MolecularPositionL2 eta} {E EN : ℝ}
    (hE : HasCoulombSectorGroundPair sys lab L psi E)
    (hEN : IsCoulombSectorCubicGroundEnergy sys lab L K EN) : E ≤ EN := by
  obtain ⟨f, h, hf, _hCube, hNorm, hGraph, hEnergy⟩ := hEN.2
  have hLower := hE.2.2.2 f h hf hGraph
  simpa only [hNorm, one_pow, mul_one, hEnergy] using hLower

/-- The ground state and the cubic Ritz bounds for the independently defined Hamiltonian
of a Coulomb system, in every sector of an admissible labelling. -/
theorem coulomb_sector_cubic_error (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ∃ E : ℝ, ∃ psi : MolecularPositionL2 eta,
      HasCoulombSectorGroundPair sys lab L psi E ∧
      ∀ K rho Blow Cs Bker : ℝ,
        1 ≤ K → 0 ≤ rho → rho ^ 2 * K = 1 →
        0 ≤ Blow → 0 ≤ Cs → 0 ≤ Bker →
        2 * (2 * Real.pi / L) ≤ K →
        54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L) →
        432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2 →
        1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2 →
        4 * sys.maxMass * (|E| + 1) ≤ K ^ 2 →
        32 * sys.massMoment 2 *
          (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
            (continuumCoulombH2Constant sys E L Hunit)) ^ 2 ≤ K ^ 5 →
        ∀ m : ℕ, 1 ≤ m → K * L = 2 * Real.pi * (m : ℝ) →
          eta ≤ (2 * m + 1) ^ 3 →
        ∃ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L K EN ∧
          (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
          0 ≤ EN - E ∧
          EN - E ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ∧
          continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ≤
            ((3 * L / (2 * Real.pi)) ^ 3 *
              continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker) /
              (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨H, hKernel, _hNorm, _hGraph, E, psi, hPair, hCubic⟩ :=
    coulomb_physical_cubic_error sys lab hlab L Hunit hL hPeriodic
  refine ⟨E, (psi : MolecularPositionL2 eta),
    (hasCoulombSectorGroundPair_iff_physicalGalerkinBridge sys lab L hL H hKernel psi E).mpr
      hPair, ?_⟩
  intro K rho Blow Cs Bker hK hRho hRhoK hBlow hCs hBker hGrid hLow hKernelScale
    hSobolev hEnergy hTail m hm hCutoff hCount
  obtain ⟨EN, hEN, hCard, hNonneg, hRate, hCountRate⟩ :=
    hCubic K rho Blow Cs Bker hK hRho hRhoK hBlow hCs hBker hGrid hLow hKernelScale
      hSobolev hEnergy hTail m hm hCutoff hCount
  exact ⟨EN, (isCoulombSectorCubicGroundEnergy_iff_physicalGalerkinBridge
    sys lab L hL H hKernel K EN).mpr hEN, hCard, hNonneg, hRate, hCountRate⟩

/-! ## Agreement with the Born--Oppenheimer objects -/

omit [Fintype ν] in
@[simp] lemma CoulombSystem.bo_sign (eta : ℕ) (data : FiniteBONuclearData ν) (a : Fin eta) :
    (CoulombSystem.bo eta data).sign a = -1 := rfl

omit [Fintype ν] in
lemma CoulombSystem.bo_sign_eq (eta : ℕ) (data : FiniteBONuclearData ν) :
    (CoulombSystem.bo eta data).sign = fun _ => -1 := funext fun _ => rfl

lemma coulombPotential_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombPotential (CoulombSystem.bo eta data) L = molecularCoulombPotential eta L data := by
  funext x
  simp only [coulombPotential, molecularCoulombPotential,
    CoulombSystem.bo_charge, CoulombSystem.bo_nuclei, mul_neg, mul_one, neg_neg,
    Complex.ofReal_one, one_mul, Complex.ofReal_neg, neg_mul, Finset.sum_neg_distrib,
    sub_eq_add_neg]

theorem hasCoulombHamiltonian_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ)
    (f h : MolecularPositionL2 eta) :
    HasCoulombHamiltonian (CoulombSystem.bo eta data) L f h ↔
      HasMolecularCoulombHamiltonian eta L data f h := by
  unfold HasCoulombHamiltonian HasMolecularCoulombHamiltonian
  simp only [coulombPotential_bo, hasCoulombContDiffWeakKinetic_bo]

omit [Fintype ν] in
theorem isPositionSector_bo (eta : ℕ) (data : FiniteBONuclearData ν) (lab : Fin eta → ℕ)
    (f : MolecularPositionL2 eta) :
    IsPositionSector (CoulombSystem.bo eta data).sign lab f ↔ IsPositionFermionic lab f := by
  rw [CoulombSystem.bo_sign_eq, isPositionFermionic_iff_isPositionSector]

theorem hasCoulombSectorGroundPair_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (lab : Fin eta → ℕ) (L : ℝ) (psi : MolecularPositionL2 eta) (E : ℝ) :
    HasCoulombSectorGroundPair (CoulombSystem.bo eta data) lab L psi E ↔
      HasMolecularFermionicGroundPair eta lab L data psi E := by
  unfold HasCoulombSectorGroundPair HasMolecularFermionicGroundPair
  simp only [isPositionSector_bo, hasCoulombHamiltonian_bo]

theorem isCoulombSectorCubicGroundEnergy_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (lab : Fin eta → ℕ) (L K EN : ℝ) :
    IsCoulombSectorCubicGroundEnergy (CoulombSystem.bo eta data) lab L K EN ↔
      IsMolecularFermionicCubicGroundEnergy eta lab L data K EN := by
  unfold IsCoulombSectorCubicGroundEnergy IsMolecularFermionicCubicGroundEnergy
  simp only [isPositionSector_bo, hasCoulombHamiltonian_bo]

end

end PlaneWaveCertificate

end ReleaseMilestone148b
-- END RELEASE SOURCE 148b

-- BEGIN RELEASE SOURCE 149: explicit constants and entry points for Coulomb systems
section ReleaseMilestone149

/-!
# Milestone 149: explicit constants and entry points for Coulomb systems

The canonical Hardy, low-frequency, Sobolev and kernel budgets fixed; explicit cutoff
thresholds with the mass factors `m̄` and `S₂`; the energy sequence and its limit; the
data-only ground-energy budget `U + B_m² + 1/4`; the four entry points in every sector of an
admissible labelling (milestones 140--142 for a general system); and the
Born--Oppenheimer statements of milestones 140--142 re-derived as instances.
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology BigOperators

noncomputable section

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-! ## Mass moments -/

lemma CoulombParticles.massMoment_nonneg {eta : ℕ} (P : CoulombParticles eta) (r : ℕ) :
    0 ≤ P.massMoment r :=
  Finset.sum_nonneg fun a _ => pow_nonneg (P.mass_pos a).le r

lemma CoulombParticles.maxMass_pos {eta : ℕ} (P : CoulombParticles eta) : 0 < P.maxMass :=
  lt_of_lt_of_le one_pos P.one_le_maxMass

/-! ## The canonical error constants -/

/-- The cutoff-independent error constant of a Coulomb system after fixing every auxiliary
Hardy, low-frequency, Sobolev and kernel budget. -/
def coulombCanonicalCubicErrorConstant (sys : CoulombSystem eta ν) (E L : ℝ) : ℝ :=
  continuumCoulombCubicConstant sys E L molecularCanonicalUnitHardyConstant
    (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
    (molecularCanonicalKernelConstant L)

/-- The canonical potential-tail budget at the energy `E`. -/
def coulombCanonicalTailBudget (sys : CoulombSystem eta ν) (E L : ℝ) : ℝ :=
  finiteCoulombPhysicalTailConstant sys L molecularCanonicalUnitHardyConstant
    (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
    (molecularCanonicalKernelConstant L)
    (continuumCoulombH2Constant sys E L molecularCanonicalUnitHardyConstant)

/-- The coefficient of the inverse basis-count error. -/
def coulombCanonicalBasisErrorConstant (sys : CoulombSystem eta ν) (E L : ℝ) : ℝ :=
  (3 * L / (2 * Real.pi)) ^ 3 * coulombCanonicalCubicErrorConstant sys E L

theorem coulombCanonicalCubicErrorConstant_nonneg (sys : CoulombSystem eta ν) (E L : ℝ) :
    0 ≤ coulombCanonicalCubicErrorConstant sys E L := by
  have hForm := finiteCoulombPhysicalFormConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  have hP : 0 ≤ 64 * ((1 / 2 : ℝ) +
      finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |E|) := by
    have := abs_nonneg E
    positivity
  unfold coulombCanonicalCubicErrorConstant continuumCoulombCubicConstant
  exact mul_nonneg (mul_nonneg (mul_nonneg hP (sys.massMoment_nonneg 1))
    (sys.massMoment_nonneg 2)) (sq_nonneg _)

lemma coulombCanonicalTailBudget_nonneg (sys : CoulombSystem eta ν) (E L : ℝ) (hL : 0 < L) :
    0 ≤ coulombCanonicalTailBudget sys E L :=
  finiteCoulombPhysicalTailConstant_nonneg sys L molecularCanonicalUnitHardyConstant
    (molecularCanonicalLowConstant_nonneg L hL) (molecularCanonicalSobolevConstant_nonneg L)
    (molecularCanonicalKernelConstant_nonneg L)
    (continuumCoulombH2Constant_nonneg sys E L molecularCanonicalUnitHardyConstant)

/-! ## Explicit cutoff thresholds -/

/-- An explicit conservative threshold for all six cutoff side conditions of a system with
largest mass `M` and second mass moment `S`. No sign assumption on `A` or `T` is needed. -/
def coulombExplicitCubicThreshold (eta : ℕ) (g M S A T : ℝ) : ℕ :=
  max 1 (max eta (Nat.ceil
    ((1 + 2 * g + 4 * M * (|A| + 1) + 32 * S * T ^ 2) / g) + 1))

/-- With `M = 1` and `S = η` this is the Born--Oppenheimer threshold. -/
lemma coulombExplicitCubicThreshold_one (eta : ℕ) (g A T : ℝ) :
    coulombExplicitCubicThreshold eta g 1 eta A T = molecularExplicitCubicThreshold eta g A T := by
  unfold coulombExplicitCubicThreshold molecularExplicitCubicThreshold
  rw [mul_one]

/-- Every cube above the explicit threshold satisfies the quantitative hypotheses of the
cubic error theorem, with the mass factors. -/
lemma coulombExplicitCubicThreshold_admissible (eta : ℕ) (g M S A T : ℝ) (hg : 0 < g)
    (hM : 0 ≤ M) (hS : 0 ≤ S) (m : ℕ)
    (hm : coulombExplicitCubicThreshold eta g M S A T ≤ m) :
    1 ≤ m ∧ eta ≤ (2 * m + 1) ^ 3 ∧
      1 ≤ g * (m : ℝ) ∧
      2 * g ≤ g * (m : ℝ) ∧
      4 * M * (|A| + 1) ≤ (g * (m : ℝ)) ^ 2 ∧
      32 * S * T ^ 2 ≤ (g * (m : ℝ)) ^ 5 := by
  let B : ℝ := 1 + 2 * g + 4 * M * (|A| + 1) + 32 * S * T ^ 2
  let n : ℕ := Nat.ceil (B / g) + 1
  have hceil : B / g ≤ (Nat.ceil (B / g) : ℝ) :=
    (Nat.ceil_le).mp (le_refl (Nat.ceil (B / g)))
  have hn : B / g < (n : ℝ) := by
    dsimp [n]
    push_cast
    linarith only [hceil]
  change max 1 (max eta n) ≤ m at hm
  have hm1 : 1 ≤ m := (le_max_left 1 (max eta n)).trans hm
  have hmEta : eta ≤ m :=
    ((le_max_left eta n).trans (le_max_right 1 (max eta n))).trans hm
  have hmn : n ≤ m :=
    ((le_max_right eta n).trans (le_max_right 1 (max eta n))).trans hm
  have hmnReal : (n : ℝ) ≤ (m : ℝ) := by exact_mod_cast hmn
  have hBn : B < (n : ℝ) * g := (div_lt_iff₀ hg).mp hn
  have hBm : B ≤ g * (m : ℝ) := by
    have hmono := mul_le_mul_of_nonneg_left hmnReal hg.le
    nlinarith only [hBn, hmono]
  have hEnergy : 0 ≤ 4 * M * (|A| + 1) :=
    mul_nonneg (mul_nonneg (by norm_num) hM) (by positivity)
  have hTail : 0 ≤ 32 * S * T ^ 2 := mul_nonneg (mul_nonneg (by norm_num) hS) (sq_nonneg T)
  dsimp [B] at hBm
  have hK1 : 1 ≤ g * (m : ℝ) := by
    linarith only [hBm, hg, hEnergy, hTail]
  have hKg : 2 * g ≤ g * (m : ℝ) := by
    linarith only [hBm, hEnergy, hTail]
  have hKEnergy : 4 * M * (|A| + 1) ≤ g * (m : ℝ) := by
    linarith only [hBm, hg, hTail]
  have hKTail : 32 * S * T ^ 2 ≤ g * (m : ℝ) := by
    linarith only [hBm, hg, hEnergy]
  have hKSq : g * (m : ℝ) ≤ (g * (m : ℝ)) ^ 2 := by
    nlinarith only [hK1, sq_nonneg (g * (m : ℝ) - 1)]
  have hKSqOne : 1 ≤ (g * (m : ℝ)) ^ 2 := hK1.trans hKSq
  have hKFourth : 1 ≤ ((g * (m : ℝ)) ^ 2) ^ 2 := by
    nlinarith only [hKSqOne, sq_nonneg ((g * (m : ℝ)) ^ 2 - 1)]
  have hKNonneg : 0 ≤ g * (m : ℝ) := by positivity
  have hKFifth : g * (m : ℝ) ≤ (g * (m : ℝ)) ^ 5 := by
    calc
      g * (m : ℝ) = g * (m : ℝ) * 1 := by ring
      _ ≤ g * (m : ℝ) * ((g * (m : ℝ)) ^ 2) ^ 2 :=
        mul_le_mul_of_nonneg_left hKFourth hKNonneg
      _ = (g * (m : ℝ)) ^ 5 := by ring
  exact ⟨hm1, enough_cubic_modes_of_particle_le_count eta m hmEta,
    hK1, hKg, hKEnergy.trans hKSq, hKTail.trans hKFifth⟩

/-! ## The canonical cubic error theorem -/

/-- The ground pair of a Coulomb system in the sector of an admissible labelling, and the
cubic error bounds on every sufficiently large ordinary cube, with all analytic budgets
fixed. -/
theorem coulomb_sector_canonical_cubic_error (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ psi : MolecularPositionL2 eta,
      HasCoulombSectorGroundPair sys lab L psi E ∧
      0 ≤ coulombCanonicalCubicErrorConstant sys E L ∧
      ∃ m0 : ℕ, ∀ m : ℕ, m0 ≤ m →
        ∃ EN : ℝ,
          IsCoulombSectorCubicGroundEnergy sys lab L ((2 * Real.pi / L) * (m : ℝ)) EN ∧
          (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
          0 ≤ EN - E ∧
          EN - E ≤ coulombCanonicalCubicErrorConstant sys E L /
            ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
          coulombCanonicalCubicErrorConstant sys E L /
              ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ≤
            ((3 * L / (2 * Real.pi)) ^ 3 * coulombCanonicalCubicErrorConstant sys E L) /
              (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨E, psi, hPair, hCubic⟩ := coulomb_sector_cubic_error sys lab hlab L
    molecularCanonicalUnitHardyConstant hL canonicalPeriodicCoulombHardyBound_explicit
  refine ⟨E, psi, hPair, coulombCanonicalCubicErrorConstant_nonneg sys E L, ?_⟩
  have hg : 0 < 2 * Real.pi / L := by positivity
  refine ⟨coulombExplicitCubicThreshold eta (2 * Real.pi / L) sys.maxMass (sys.massMoment 2)
    E (coulombCanonicalTailBudget sys E L), ?_⟩
  intro m hm
  obtain ⟨hm1, hCount, hK, hGrid, hEnergy, hTail⟩ :=
    coulombExplicitCubicThreshold_admissible eta (2 * Real.pi / L) sys.maxMass
      (sys.massMoment 2) E (coulombCanonicalTailBudget sys E L) hg sys.maxMass_pos.le
      (sys.massMoment_nonneg 2) m hm
  obtain ⟨rho, hRho, hRhoK⟩ :=
    molecularCubicCutoff_exists_radius ((2 * Real.pi / L) * (m : ℝ))
      (lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) hK)
  obtain ⟨hBlow, hCs, hBker, hLow, hKernelScale, hSobolev⟩ :=
    molecularCanonicalTailConstants_spec L hL
  exact hCubic ((2 * Real.pi / L) * (m : ℝ)) rho
    (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
    (molecularCanonicalKernelConstant L)
    hK hRho hRhoK hBlow hCs hBker hGrid hLow hKernelScale hSobolev
    hEnergy hTail m hm1 (molecularCubicCutoff_mul_cellLength L hL m) hCount

/-! ## Monotone convergence -/

theorem IsCoulombSectorCubicGroundEnergy.antitone_cutoff {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} {L K K' : ℝ} {EN EN' : ℝ}
    (hEN : IsCoulombSectorCubicGroundEnergy sys lab L K EN)
    (hEN' : IsCoulombSectorCubicGroundEnergy sys lab L K' EN')
    (hKK' : K ≤ K') : EN' ≤ EN := by
  obtain ⟨f, h, hf, hCube, hNorm, hGraph, hEnergy⟩ := hEN.2
  have hLower := hEN'.1 f h hf (hCube.mono hKK') hGraph
  simpa only [hNorm, one_pow, mul_one, hEnergy] using hLower

theorem IsCoulombSectorCubicGroundEnergy.antitone_integer {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} {L : ℝ} {m n : ℕ} {EN EN' : ℝ}
    (hEN : IsCoulombSectorCubicGroundEnergy sys lab L ((2 * Real.pi / L) * (m : ℝ)) EN)
    (hEN' : IsCoulombSectorCubicGroundEnergy sys lab L ((2 * Real.pi / L) * (n : ℝ)) EN')
    (hL : 0 < L) (hmn : m ≤ n) : EN' ≤ EN := by
  apply hEN.antitone_cutoff hEN'
  have hg : 0 ≤ 2 * Real.pi / L := le_of_lt (by positivity)
  have hmnReal : (m : ℝ) ≤ (n : ℝ) := by exact_mod_cast hmn
  exact mul_le_mul_of_nonneg_left hmnReal hg

/-- The cubic Ritz energies of a Coulomb system form a decreasing sequence converging to
the ground energy, which is their infimum; every entry gives a certified interval. -/
theorem coulomb_sector_cubic_convergence (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ psi : MolecularPositionL2 eta,
      HasCoulombSectorGroundPair sys lab L psi E ∧
      ∃ m0 : ℕ, 1 ≤ m0 ∧ ∃ energy : ℕ → ℝ,
        (∀ n : ℕ, IsCoulombSectorCubicGroundEnergy sys lab L
          ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) (energy n)) ∧
        Antitone energy ∧
        Tendsto energy atTop (𝓝 E) ∧
        E = (⨅ n : ℕ, energy n) ∧
        ∀ n : ℕ,
          (cubicPlaneWaveBox (m0 + n)).card = (2 * (m0 + n) + 1) ^ 3 ∧
          0 ≤ energy n - E ∧
          energy n - E ≤ coulombCanonicalCubicErrorConstant sys E L /
            ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) ^ 3 ∧
          energy n - E ≤ coulombCanonicalBasisErrorConstant sys E L /
            (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ∧
          energy n - coulombCanonicalBasisErrorConstant sys E L /
              (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ≤ E ∧
          E ≤ energy n := by
  classical
  obtain ⟨E, psi, hPair, _hConstant, mBase, hmBase⟩ :=
    coulomb_sector_canonical_cubic_error sys lab hlab L hL
  let m0 : ℕ := max mBase 1
  have hm0 : 1 ≤ m0 := le_max_right mBase 1
  have hLarge (n : ℕ) : mBase ≤ m0 + n := by
    dsimp [m0]
    omega
  choose energy hSpec hCard hNonneg hKRate hCountRate using
    (fun n : ℕ => hmBase (m0 + n) (hLarge n))
  have hBound (n : ℕ) : energy n - E ≤
      coulombCanonicalBasisErrorConstant sys E L /
        (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) :=
    (hKRate n).trans (hCountRate n)
  have hMono : Antitone energy := by
    intro i j hij
    exact (hSpec i).antitone_integer (hSpec j) hL (by omega)
  have hLimit : Tendsto energy atTop (𝓝 E) :=
    molecularCubicRate_tendsto energy E
      (coulombCanonicalBasisErrorConstant sys E L) m0 hNonneg hBound
  have hBdd : BddBelow (Set.range energy) := by
    refine ⟨E, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact sub_nonneg.mp (hNonneg n)
  have hInf : E = (⨅ n : ℕ, energy n) :=
    tendsto_nhds_unique hLimit (tendsto_atTop_ciInf hMono hBdd)
  refine ⟨E, psi, hPair, m0, hm0, energy, hSpec, hMono, hLimit, hInf, ?_⟩
  intro n
  refine ⟨hCard n, hNonneg n, hKRate n, hBound n, ?_, ?_⟩
  · linarith only [hBound n]
  · exact sub_nonneg.mp (hNonneg n)

/-! ## Lower and upper bounds for the ground energy -/

/-- The Hamiltonian graph of a Coulomb system is bounded below by `-(B_m² + 1/4)`, with
`B_m` the mass-weighted `H¹` constant. -/
theorem HasCoulombHamiltonian.form_lower_bound {sys : CoulombSystem eta ν} {L : ℝ}
    {f h : MolecularPositionL2 eta} (hL : 0 < L)
    (hGraph : HasCoulombHamiltonian sys L f h) :
    -((finiteCoulombPhysicalMassConstant sys L molecularCanonicalUnitHardyConstant) ^ 2 +
        (1 / 4 : ℝ)) * ‖f‖ ^ 2 ≤ (inner ℂ f h).re := by
  obtain ⟨H, hKernel, _hNorm⟩ := exists_coulombFourierH2Operator sys L
    molecularCanonicalUnitHardyConstant hL canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨u, huState, huAction⟩ :=
    (hasCoulombHamiltonian_iff_reflectedH2 sys L hL H hKernel f h).mp hGraph
  have hLower := coulombFourierDomainOperator_form_lower_bound sys L
    molecularCanonicalUnitHardyConstant hL canonicalPeriodicCoulombHardyBound_explicit H hKernel
    (molecularFourierH2DomainEquiv eta (2 * Real.pi / L) u)
  rw [molecularFourierH2DomainEquiv_coe, molecularFourierDomainOperator_apply_equiv] at hLower
  rw [← huState, ← huAction, molecularPositionH2StateMap_apply,
    molecularPositionHamiltonianH2_apply,
    (molecularPositionReflection eta).norm_map,
    (molecularPositionSynthesis eta).norm_map,
    (molecularPositionReflection eta).inner_map_map,
    (molecularPositionSynthesis eta).inner_map_map]
  exact hLower

theorem HasCoulombSectorGroundPair.energy_lower_bound {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} {L : ℝ} {psi : MolecularPositionL2 eta} {E : ℝ} (hL : 0 < L)
    (hPair : HasCoulombSectorGroundPair sys lab L psi E) :
    -((finiteCoulombPhysicalMassConstant sys L molecularCanonicalUnitHardyConstant) ^ 2 +
        (1 / 4 : ℝ)) ≤ E := by
  have hLower := HasCoulombHamiltonian.form_lower_bound hL hPair.2.2.1
  rw [inner_smul_right, inner_self_eq_norm_sq_to_K] at hLower
  simpa [hPair.2.1] using hLower

/-- The finite reference Hamiltonian on the integer cube of radius `η`. -/
def coulombReferenceHamiltonian (sys : CoulombSystem eta ν) (L : ℝ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode eta)) →L[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode eta)) :=
  (finiteCoulombHamiltonian_isSymmetric sys L eta).toSelfAdjoint.val

/-- A data-only upper budget for the ground energy: the norm of one finite matrix. -/
def coulombFiniteReferenceEnergyBound (sys : CoulombSystem eta ν) (L : ℝ) : ℝ :=
  ‖coulombReferenceHamiltonian sys L‖

lemma coulombFiniteReferenceEnergyBound_nonneg (sys : CoulombSystem eta ν) (L : ℝ) :
    0 ≤ coulombFiniteReferenceEnergyBound sys L :=
  norm_nonneg _

lemma coulombReferenceHamiltonian_form_upper (sys : CoulombSystem eta ν) (L : ℝ)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode eta))) (hNorm : ‖u‖ = 1) :
    (inner ℂ u (finiteCoulombHamiltonian sys L eta u)).re ≤
      coulombFiniteReferenceEnergyBound sys L := by
  have hOp := (coulombReferenceHamiltonian sys L).le_opNorm u
  change ‖finiteCoulombHamiltonian sys L eta u‖ ≤
    coulombFiniteReferenceEnergyBound sys L * ‖u‖ at hOp
  have hInner := re_inner_le_norm (𝕜 := ℂ) u (finiteCoulombHamiltonian sys L eta u)
  rw [hNorm, one_mul] at hInner
  rw [hNorm, mul_one] at hOp
  exact hInner.trans hOp

/-- A normalized trial vector of the sector in the reference cube gives the upper bound. -/
theorem HasCoulombSectorGroundPair.energy_upper_bound {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab) {L : ℝ}
    {psi : MolecularPositionL2 eta} {E : ℝ} (hL : 0 < L)
    (hPair : HasCoulombSectorGroundPair sys lab L psi E) :
    E ≤ coulombFiniteReferenceEnergyBound sys L := by
  obtain ⟨H, hKernel, _hBound⟩ := exists_coulombFourierH2Operator sys L
    molecularCanonicalUnitHardyConstant hL canonicalPeriodicCoulombHardyBound_explicit
  let bridge := coulombPhysicalGalerkinBridge sys lab L hL H hKernel
  obtain ⟨_EN, u, hSector, hNorm, _hEigen, _hGround⟩ :=
    finiteCoulomb_exists_sector_ground sys lab hlab L eta
      (enough_finitePlaneWaveModes_of_particle_le_count eta eta le_rfl)
  let z : molecularPhysicalH2Domain eta (2 * Real.pi / L) := bridge.embed eta u
  have hzSector : IsPositionSector sys.sign lab (z : MolecularPositionL2 eta) :=
    (coulombPhysicalGalerkinBridge_sector_iff sys lab L hL H hKernel _).mp
      ((bridge.sector_iff eta u).mpr hSector)
  have hzNorm : ‖(z : MolecularPositionL2 eta)‖ = 1 := by
    change ‖bridge.embed eta u‖ = 1
    rw [(bridge.embed eta).norm_map, hNorm]
  have hzGraph : HasCoulombHamiltonian sys L (z : MolecularPositionL2 eta)
      (bridge.hamiltonian z) :=
    coulombPhysicalGalerkinBridge_coulombHamiltonian sys lab L hL H hKernel z
  have hLower := hPair.2.2.2 (z : MolecularPositionL2 eta) (bridge.hamiltonian z)
    hzSector hzGraph
  rw [hzNorm, one_pow, mul_one] at hLower
  have hForm : (inner ℂ (z : MolecularPositionL2 eta) (bridge.hamiltonian z)).re =
      (inner ℂ u (finiteCoulombHamiltonian sys L eta u)).re :=
    bridge.form_eq eta u
  rw [hForm] at hLower
  exact hLower.trans (coulombReferenceHamiltonian_form_upper sys L u hNorm)

/-- A diagonal operator whose nonnegative symbol is at most `M` has norm at most `M`. -/
lemma norm_diagOperator_apply_le {μ : Type*} [Fintype μ] (A : FourierConfig eta μ → ℝ)
    {M : ℝ} (hM0 : 0 ≤ M) (hA0 : ∀ p, 0 ≤ A p) (hM : ∀ p, A p ≤ M)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖diagOperator A u‖ ≤ M * ‖u‖ := by
  change ‖diagMul A u‖ ≤ M * ‖u‖
  have hSq : ‖diagMul A u‖ ^ 2 ≤ (M * ‖u‖) ^ 2 := by
    rw [diagMul_norm_sq, mul_pow, EuclideanSpace.norm_sq_eq, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro p _
    have hp : (A p) ^ 2 ≤ M ^ 2 := by nlinarith [hM p, hA0 p]
    exact mul_le_mul_of_nonneg_right hp (sq_nonneg _)
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hSq

/-- The reference budget is explicit: masses at least one only lower the kinetic energy. -/
theorem coulombFiniteReferenceEnergyBound_le_explicit (sys : CoulombSystem eta ν) (L : ℝ)
    (hL : 0 < L) :
    coulombFiniteReferenceEnergyBound sys L ≤
      (3 / 2) * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3 +
        finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant *
          Real.sqrt (1 + 3 * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3) := by
  set g : ℝ := 2 * Real.pi / L with hg
  set B : ℝ := finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant
    with hBdef
  set M : ℝ := 3 * g ^ 2 * (eta : ℝ) * (eta : ℝ) ^ 2 with hMdef
  have hW := finiteCoulombPotential_physical_h1Bound sys L molecularCanonicalUnitHardyConstant
    eta hL canonicalPeriodicCoulombHardyBound_explicit
  have hB0 : 0 ≤ B := finiteCoulombPhysicalFormConstant_nonneg sys L _
  have hM0 : 0 ≤ M := by positivity
  have hMbo : ∀ p, boKineticSymbol (finitePlaneWaveKabs g eta) p ≤ M :=
    fun p => boKineticSymbol_finitePlaneWaveKabs_le g eta p
  have hA0 : ∀ p, 0 ≤ massKineticSymbol sys.mass (finitePlaneWaveKabs g eta) p :=
    fun p => massKineticSymbol_nonneg (fun a => sys.mass_pos a) _ p
  have hMmass : ∀ p, massKineticSymbol sys.mass (finitePlaneWaveKabs g eta) p ≤ M :=
    fun p => (massKineticSymbol_le_boKineticSymbol sys.one_le_mass _ p).trans (hMbo p)
  have hMeq : M = 3 * g ^ 2 * (eta : ℝ) ^ 3 := by rw [hMdef]; ring
  have hRHS0 : 0 ≤ (3 / 2) * g ^ 2 * (eta : ℝ) ^ 3 +
      B * Real.sqrt (1 + 3 * g ^ 2 * (eta : ℝ) ^ 3) :=
    add_nonneg (by positivity) (mul_nonneg hB0 (Real.sqrt_nonneg _))
  apply ContinuousLinearMap.opNorm_le_bound _ hRHS0
  intro u
  change ‖finiteCoulombHamiltonian sys L eta u‖ ≤ _ * ‖u‖
  have hsplit : finiteCoulombHamiltonian sys L eta u =
      (1 / 2 : ℂ) • diagOperator (massKineticSymbol sys.mass (finitePlaneWaveKabs g eta)) u +
        finiteCoulombPotential sys (coulombCellAmplitude L) eta u := rfl
  have hT := norm_diagOperator_apply_le _ hM0 hA0 hMmass u
  have hV := norm_apply_le_of_h1OperatorBound hW hB0 hM0 hMbo u
  rw [hsplit]
  calc ‖(1 / 2 : ℂ) • diagOperator (massKineticSymbol sys.mass (finitePlaneWaveKabs g eta)) u +
        finiteCoulombPotential sys (coulombCellAmplitude L) eta u‖
      ≤ ‖(1 / 2 : ℂ) • diagOperator (massKineticSymbol sys.mass (finitePlaneWaveKabs g eta)) u‖ +
          ‖finiteCoulombPotential sys (coulombCellAmplitude L) eta u‖ :=
        norm_add_le _ _
    _ ≤ (1 / 2) * (M * ‖u‖) + B * Real.sqrt (1 + M) * ‖u‖ := by
        rw [norm_smul]
        have h12 : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
        rw [h12]
        exact add_le_add (mul_le_mul_of_nonneg_left hT (by norm_num)) hV
    _ = ((3 / 2) * g ^ 2 * (eta : ℝ) ^ 3 +
          B * Real.sqrt (1 + 3 * g ^ 2 * (eta : ℝ) ^ 3)) * ‖u‖ := by
        rw [hMeq]
        ring

/-- The data-only budget `U + B_m² + 1/4` for the absolute ground energy. -/
def coulombGroundEnergyBudget (sys : CoulombSystem eta ν) (L : ℝ) : ℝ :=
  coulombFiniteReferenceEnergyBound sys L +
    (finiteCoulombPhysicalMassConstant sys L molecularCanonicalUnitHardyConstant) ^ 2 +
    (1 / 4 : ℝ)

theorem coulombGroundEnergyBudget_le_explicit (sys : CoulombSystem eta ν) (L : ℝ)
    (hL : 0 < L) :
    coulombGroundEnergyBudget sys L ≤
      (3 / 2) * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3 +
        finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant *
          Real.sqrt (1 + 3 * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3) +
        (finiteCoulombPhysicalMassConstant sys L molecularCanonicalUnitHardyConstant) ^ 2 +
        1 / 4 := by
  have h := coulombFiniteReferenceEnergyBound_le_explicit sys L hL
  unfold coulombGroundEnergyBudget
  linarith only [h]

theorem HasCoulombSectorGroundPair.abs_energy_le_budget {sys : CoulombSystem eta ν}
    {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab) {L : ℝ}
    {psi : MolecularPositionL2 eta} {E : ℝ} (hL : 0 < L)
    (hPair : HasCoulombSectorGroundPair sys lab L psi E) :
    |E| ≤ coulombGroundEnergyBudget sys L := by
  have hLower := HasCoulombSectorGroundPair.energy_lower_bound hL hPair
  have hUpper := HasCoulombSectorGroundPair.energy_upper_bound hlab hL hPair
  have hReference := coulombFiniteReferenceEnergyBound_nonneg sys L
  have hSquare := sq_nonneg (finiteCoulombPhysicalMassConstant sys L
    molecularCanonicalUnitHardyConstant)
  rw [abs_le]
  unfold coulombGroundEnergyBudget
  constructor <;> linarith only [hLower, hUpper, hReference, hSquare]

/-! ## Monotonicity of the budgets in the energy -/

lemma continuumCoulombH2Constant_mono_abs (sys : CoulombSystem eta ν) (E F L Hunit : ℝ)
    (hEF : |E| ≤ |F|) :
    continuumCoulombH2Constant sys E L Hunit ≤ continuumCoulombH2Constant sys F L Hunit := by
  unfold continuumCoulombH2Constant finiteCoulombH2Constant uniformBOEigenH2Constant
  apply mul_le_mul_of_nonneg_left _ sys.maxMass_pos.le
  linarith only [hEF]

lemma finiteCoulombPhysicalTailConstant_mono_h2 (sys : CoulombSystem eta ν) (L Hunit : ℝ)
    {Blow Cs Bker M M' : ℝ} (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (hM : M ≤ M') :
    finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M ≤
      finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M' := by
  unfold finiteCoulombPhysicalTailConstant finiteCoulombTailConstant
  apply mul_le_mul_of_nonneg_left _ sys.couplingWeight_nonneg
  have hB := coulombPhysicalCellConstant_nonneg L Hunit
  have h1 := mul_le_mul_of_nonneg_left hM hB
  have h2 := mul_le_mul_of_nonneg_left hM (mul_nonneg (by norm_num : (0 : ℝ) ≤ 4) hBlow)
  have h3 := mul_le_mul_of_nonneg_left hM (mul_nonneg hCs hBker)
  linarith only [h1, h2, h3]

lemma coulombCanonicalTailBudget_le_of_abs_le (sys : CoulombSystem eta ν) (E A L : ℝ)
    (hL : 0 < L) (hEA : |E| ≤ A) :
    coulombCanonicalTailBudget sys E L ≤ coulombCanonicalTailBudget sys A L := by
  have hA : 0 ≤ A := (abs_nonneg E).trans hEA
  have hAbs : |E| ≤ |A| := by simpa only [abs_of_nonneg hA] using hEA
  exact finiteCoulombPhysicalTailConstant_mono_h2 sys L _
    (molecularCanonicalLowConstant_nonneg L hL) (molecularCanonicalSobolevConstant_nonneg L)
    (molecularCanonicalKernelConstant_nonneg L)
    (continuumCoulombH2Constant_mono_abs sys E A L _ hAbs)

lemma coulombCanonicalTailBudget_sq_le_of_abs_le (sys : CoulombSystem eta ν) (E A L : ℝ)
    (hL : 0 < L) (hEA : |E| ≤ A) :
    (coulombCanonicalTailBudget sys E L) ^ 2 ≤ (coulombCanonicalTailBudget sys A L) ^ 2 := by
  have hMono := coulombCanonicalTailBudget_le_of_abs_le sys E A L hL hEA
  have hNonneg := coulombCanonicalTailBudget_nonneg sys E L hL
  exact (sq_le_sq₀ hNonneg (hNonneg.trans hMono)).2 hMono

theorem coulombCanonicalCubicErrorConstant_le_of_abs_le (sys : CoulombSystem eta ν)
    (E A L : ℝ) (hL : 0 < L) (hEA : |E| ≤ A) :
    coulombCanonicalCubicErrorConstant sys E L ≤ coulombCanonicalCubicErrorConstant sys A L := by
  have hA : 0 ≤ A := (abs_nonneg E).trans hEA
  have hForm := finiteCoulombPhysicalFormConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  have h12 := mul_nonneg (sys.massMoment_nonneg 1) (sys.massMoment_nonneg 2)
  have hTailSq := coulombCanonicalTailBudget_sq_le_of_abs_le sys E A L hL hEA
  have hPre : 64 * ((1 / 2 : ℝ) +
        finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |E|) *
        sys.massMoment 1 * sys.massMoment 2 ≤
      64 * ((1 / 2 : ℝ) +
        finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |A|) *
        sys.massMoment 1 * sys.massMoment 2 := by
    have hAbs : |E| ≤ |A| := by simpa only [abs_of_nonneg hA] using hEA
    have hle : 64 * ((1 / 2 : ℝ) +
          finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |E|) ≤
        64 * ((1 / 2 : ℝ) +
          finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |A|) := by
      linarith only [hAbs]
    have := mul_le_mul_of_nonneg_right hle h12
    linarith only [this]
  have hPre0 : 0 ≤ 64 * ((1 / 2 : ℝ) +
      finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |A|) *
      sys.massMoment 1 * sys.massMoment 2 := by
    have : 0 ≤ 64 * ((1 / 2 : ℝ) +
        finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |A|) := by
      have := abs_nonneg A
      positivity
    exact mul_nonneg (mul_nonneg this (sys.massMoment_nonneg 1)) (sys.massMoment_nonneg 2)
  change 64 * ((1 / 2 : ℝ) +
        finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |E|) *
        sys.massMoment 1 * sys.massMoment 2 * (coulombCanonicalTailBudget sys E L) ^ 2 ≤
      64 * ((1 / 2 : ℝ) +
        finiteCoulombPhysicalFormConstant sys L molecularCanonicalUnitHardyConstant + |A|) *
        sys.massMoment 1 * sys.massMoment 2 * (coulombCanonicalTailBudget sys A L) ^ 2
  exact mul_le_mul hPre hTailSq (sq_nonneg _) hPre0

theorem coulombCanonicalBasisErrorConstant_le_of_abs_le (sys : CoulombSystem eta ν)
    (E A L : ℝ) (hL : 0 < L) (hEA : |E| ≤ A) :
    coulombCanonicalBasisErrorConstant sys E L ≤ coulombCanonicalBasisErrorConstant sys A L := by
  unfold coulombCanonicalBasisErrorConstant
  exact mul_le_mul_of_nonneg_left
    (coulombCanonicalCubicErrorConstant_le_of_abs_le sys E A L hL hEA) (by positivity)

/-! ## Data-only budgets and thresholds -/

/-- Cutoff error coefficient with no unknown ground energy. -/
def coulombDataCubicErrorConstant (sys : CoulombSystem eta ν) (L : ℝ) : ℝ :=
  coulombCanonicalCubicErrorConstant sys (coulombGroundEnergyBudget sys L) L

/-- Basis-count error coefficient with no unknown ground energy. -/
def coulombDataBasisErrorConstant (sys : CoulombSystem eta ν) (L : ℝ) : ℝ :=
  coulombCanonicalBasisErrorConstant sys (coulombGroundEnergyBudget sys L) L

lemma coulombDataCubicErrorConstant_nonneg (sys : CoulombSystem eta ν) (L : ℝ) :
    0 ≤ coulombDataCubicErrorConstant sys L :=
  coulombCanonicalCubicErrorConstant_nonneg sys _ L

/-- The potential-tail budget at the data-only energy budget. -/
def coulombDataTailBudget (sys : CoulombSystem eta ν) (L : ℝ) : ℝ :=
  coulombCanonicalTailBudget sys (coulombGroundEnergyBudget sys L) L

/-- An explicit integer cube threshold determined by the data of the system. -/
def coulombDataCubicThreshold (sys : CoulombSystem eta ν) (L : ℝ) : ℕ :=
  coulombExplicitCubicThreshold eta (2 * Real.pi / L) sys.maxMass (sys.massMoment 2)
    (coulombGroundEnergyBudget sys L) (coulombDataTailBudget sys L)

/-- A fully specified sufficient cube radius for a requested energy accuracy. -/
def coulombDataAccuracyThreshold (sys : CoulombSystem eta ν) (L ε : ℝ) : ℕ :=
  max (coulombDataCubicThreshold sys L)
    (Nat.ceil (coulombDataBasisErrorConstant sys L / ε))

/-- The ground pair and the cubic error certificate with constants and an admissible
threshold determined by the data of the system. -/
theorem coulomb_sector_data_cubic_error (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ psi : MolecularPositionL2 eta,
      HasCoulombSectorGroundPair sys lab L psi E ∧
      |E| ≤ coulombGroundEnergyBudget sys L ∧
      ∀ m : ℕ, coulombDataCubicThreshold sys L ≤ m →
        ∃ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
          ((2 * Real.pi / L) * (m : ℝ)) EN ∧
          (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
          0 ≤ EN - E ∧
          EN - E ≤ coulombDataCubicErrorConstant sys L /
            ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
          EN - E ≤ coulombDataBasisErrorConstant sys L /
            (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨E, psi, hPair, hCubic⟩ := coulomb_sector_cubic_error sys lab hlab L
    molecularCanonicalUnitHardyConstant hL canonicalPeriodicCoulombHardyBound_explicit
  have hEA := HasCoulombSectorGroundPair.abs_energy_le_budget hlab hL hPair
  refine ⟨E, psi, hPair, hEA, ?_⟩
  intro m hm
  have hg : 0 < 2 * Real.pi / L := by positivity
  obtain ⟨hm1, hCount, hK, hGrid, hEnergyA, hTailA⟩ :=
    coulombExplicitCubicThreshold_admissible eta (2 * Real.pi / L) sys.maxMass
      (sys.massMoment 2) (coulombGroundEnergyBudget sys L) (coulombDataTailBudget sys L)
      hg sys.maxMass_pos.le (sys.massMoment_nonneg 2) m hm
  have hEAAbs : |E| ≤ |coulombGroundEnergyBudget sys L| := hEA.trans (le_abs_self _)
  have hEnergy : 4 * sys.maxMass * (|E| + 1) ≤ ((2 * Real.pi / L) * (m : ℝ)) ^ 2 := by
    have h4 : 0 ≤ 4 * sys.maxMass := mul_nonneg (by norm_num) sys.maxMass_pos.le
    have := mul_le_mul_of_nonneg_left (add_le_add_right hEAAbs 1) h4
    linarith only [this, hEnergyA]
  have hTailSq := coulombCanonicalTailBudget_sq_le_of_abs_le sys E
    (coulombGroundEnergyBudget sys L) L hL hEA
  have hTail : 32 * sys.massMoment 2 * (coulombCanonicalTailBudget sys E L) ^ 2 ≤
      ((2 * Real.pi / L) * (m : ℝ)) ^ 5 :=
    (mul_le_mul_of_nonneg_left hTailSq
      (mul_nonneg (by norm_num : (0 : ℝ) ≤ 32) (sys.massMoment_nonneg 2))).trans hTailA
  have hKpos : 0 < (2 * Real.pi / L) * (m : ℝ) :=
    lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) hK
  obtain ⟨rho, hRho, hRhoK⟩ :=
    molecularCubicCutoff_exists_radius ((2 * Real.pi / L) * (m : ℝ)) hKpos
  obtain ⟨hBlow, hCs, hBker, hLow, hKernelScale, hSobolev⟩ :=
    molecularCanonicalTailConstants_spec L hL
  obtain ⟨EN, hEN, hCard, hNonneg, hRate, hCountRate⟩ :=
    hCubic ((2 * Real.pi / L) * (m : ℝ)) rho
      (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
      (molecularCanonicalKernelConstant L)
      hK hRho hRhoK hBlow hCs hBker hGrid hLow hKernelScale hSobolev
      hEnergy hTail m hm1 (molecularCubicCutoff_mul_cellLength L hL m) hCount
  have hC : coulombCanonicalCubicErrorConstant sys E L ≤ coulombDataCubicErrorConstant sys L :=
    coulombCanonicalCubicErrorConstant_le_of_abs_le sys E _ L hL hEA
  have hCN : coulombCanonicalBasisErrorConstant sys E L ≤ coulombDataBasisErrorConstant sys L :=
    coulombCanonicalBasisErrorConstant_le_of_abs_le sys E _ L hL hEA
  have hRate0 : EN - E ≤ coulombCanonicalCubicErrorConstant sys E L /
      ((2 * Real.pi / L) * (m : ℝ)) ^ 3 := hRate
  have hNRate0 : EN - E ≤ coulombCanonicalBasisErrorConstant sys E L /
      (((2 * m + 1) ^ 3 : ℕ) : ℝ) := hRate.trans hCountRate
  refine ⟨EN, hEN, hCard, hNonneg, ?_, ?_⟩
  · exact hRate0.trans ((div_le_div_iff_of_pos_right (pow_pos hKpos 3)).mpr hC)
  · exact hNRate0.trans ((div_le_div_iff_of_pos_right (by positivity)).mpr hCN)

/-- The data-only certificate applies to every ground pair and every cubic minimum above
the threshold. -/
theorem coulombSector_data_bound_for_ground_pair (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab) (L : ℝ) (hL : 0 < L)
    (psi : MolecularPositionL2 eta) (E : ℝ)
    (hPair : HasCoulombSectorGroundPair sys lab L psi E)
    (m : ℕ) (hm : coulombDataCubicThreshold sys L ≤ m) :
    (∃ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
      0 ≤ EN - E ∧
      EN - E ≤ coulombDataCubicErrorConstant sys L /
        ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
      EN - E ≤ coulombDataBasisErrorConstant sys L /
        (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨E0, psi0, hPair0, _hBudget, hCubic⟩ :=
    coulomb_sector_data_cubic_error sys lab hlab L hL
  have hE : E0 = E := hPair0.energy_unique hPair
  subst E0
  obtain ⟨EN0, hEN0, hCard, hNonneg, hRate, hNRate⟩ := hCubic m hm
  refine ⟨⟨EN0, hEN0⟩, ?_⟩
  intro EN hEN
  have hENeq : EN = EN0 := hEN.unique hEN0
  subst EN
  exact ⟨hCard, hNonneg, hRate, hNRate⟩

theorem coulombSector_data_accuracy_of_basis_budget (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab) (L : ℝ) (hL : 0 < L)
    (psi : MolecularPositionL2 eta) (E : ℝ)
    (hPair : HasCoulombSectorGroundPair sys lab L psi E)
    (ε : ℝ) (m : ℕ) (hm : coulombDataCubicThreshold sys L ≤ m)
    (hBudget : coulombDataBasisErrorConstant sys L ≤ ε * (((2 * m + 1) ^ 3 : ℕ) : ℝ)) :
    (∃ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  obtain ⟨hExists, hEvery⟩ :=
    coulombSector_data_bound_for_ground_pair sys hlab L hL psi E hPair m hm
  refine ⟨hExists, ?_⟩
  intro EN hEN
  obtain ⟨_hCard, hNonneg, _hRate, hNRate⟩ := hEvery EN hEN
  exact cubicEnergy_interval_of_count_budget E EN
    (coulombDataBasisErrorConstant sys L) (((2 * m + 1) ^ 3 : ℕ) : ℝ) ε
    (by positivity) hNonneg hNRate hBudget

theorem coulombSector_data_accuracy_for_ground_pair (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab) (L : ℝ) (hL : 0 < L)
    (psi : MolecularPositionL2 eta) (E : ℝ)
    (hPair : HasCoulombSectorGroundPair sys lab L psi E)
    (ε : ℝ) (hε : 0 < ε) (m : ℕ) (hm : coulombDataAccuracyThreshold sys L ε ≤ m) :
    (∃ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  have hmBase : coulombDataCubicThreshold sys L ≤ m := (le_max_left _ _).trans hm
  have hmBudget : Nat.ceil (coulombDataBasisErrorConstant sys L / ε) ≤ m :=
    (le_max_right _ _).trans hm
  exact coulombSector_data_accuracy_of_basis_budget sys hlab L hL psi E hPair ε m hmBase
    (molecularCubicCount_accuracy_budget_of_ceil
      (coulombDataBasisErrorConstant sys L) ε hε m hmBudget)

/-! ## Agreement with the Born--Oppenheimer constants -/

lemma coulombCanonicalCubicErrorConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (E L : ℝ) :
    coulombCanonicalCubicErrorConstant (CoulombSystem.bo eta data) E L =
      molecularCanonicalCubicErrorConstant eta data E L := by
  unfold coulombCanonicalCubicErrorConstant molecularCanonicalCubicErrorConstant
  exact continuumCoulombCubicConstant_bo eta data E L _ _ _ _

lemma coulombCanonicalBasisErrorConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (E L : ℝ) :
    coulombCanonicalBasisErrorConstant (CoulombSystem.bo eta data) E L =
      molecularCanonicalBasisErrorConstant eta data E L := by
  unfold coulombCanonicalBasisErrorConstant molecularCanonicalBasisErrorConstant
  rw [coulombCanonicalCubicErrorConstant_bo]

lemma coulombReferenceHamiltonian_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombReferenceHamiltonian (CoulombSystem.bo eta data) L =
      molecularReferenceHamiltonian eta L data := by
  apply ContinuousLinearMap.ext
  intro u
  change finiteCoulombHamiltonian (CoulombSystem.bo eta data) L eta u =
    finiteMolecularBOHamiltonian eta L data eta u
  rw [finiteCoulombHamiltonian_bo]

lemma coulombFiniteReferenceEnergyBound_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombFiniteReferenceEnergyBound (CoulombSystem.bo eta data) L =
      molecularFiniteReferenceEnergyBound eta data L := by
  unfold coulombFiniteReferenceEnergyBound molecularFiniteReferenceEnergyBound
  rw [coulombReferenceHamiltonian_bo]

lemma coulombGroundEnergyBudget_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombGroundEnergyBudget (CoulombSystem.bo eta data) L =
      molecularGroundEnergyBudget eta data L := by
  unfold coulombGroundEnergyBudget molecularGroundEnergyBudget
  rw [coulombFiniteReferenceEnergyBound_bo, finiteCoulombPhysicalMassConstant_bo,
    finiteCoulombPhysicalFormConstant_bo]

lemma coulombCanonicalTailBudget_bo (eta : ℕ) (data : FiniteBONuclearData ν) (E L : ℝ) :
    coulombCanonicalTailBudget (CoulombSystem.bo eta data) E L =
      finiteMolecularCoulombPhysicalTailConstant eta data L
        molecularCanonicalUnitHardyConstant (molecularCanonicalLowConstant L)
        (molecularCanonicalSobolevConstant L) (molecularCanonicalKernelConstant L)
        (continuumMolecularBOH2Constant eta data E L molecularCanonicalUnitHardyConstant) := by
  unfold coulombCanonicalTailBudget
  rw [finiteCoulombPhysicalTailConstant_bo, continuumCoulombH2Constant_bo]

lemma coulombDataTailBudget_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombDataTailBudget (CoulombSystem.bo eta data) L = molecularDataTailBudget eta data L := by
  unfold coulombDataTailBudget molecularDataTailBudget
  rw [coulombCanonicalTailBudget_bo, coulombGroundEnergyBudget_bo]

lemma coulombDataCubicErrorConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombDataCubicErrorConstant (CoulombSystem.bo eta data) L =
      molecularDataCubicErrorConstant eta data L := by
  unfold coulombDataCubicErrorConstant molecularDataCubicErrorConstant
  rw [coulombGroundEnergyBudget_bo, coulombCanonicalCubicErrorConstant_bo]

lemma coulombDataBasisErrorConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombDataBasisErrorConstant (CoulombSystem.bo eta data) L =
      molecularDataBasisErrorConstant eta data L := by
  unfold coulombDataBasisErrorConstant molecularDataBasisErrorConstant
  rw [coulombGroundEnergyBudget_bo, coulombCanonicalBasisErrorConstant_bo]

lemma coulombDataCubicThreshold_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) :
    coulombDataCubicThreshold (CoulombSystem.bo eta data) L =
      molecularDataCubicThreshold eta data L := by
  unfold coulombDataCubicThreshold molecularDataCubicThreshold
  rw [CoulombSystem.maxMass_bo, CoulombSystem.massMoment_bo, coulombGroundEnergyBudget_bo,
    coulombDataTailBudget_bo, coulombExplicitCubicThreshold_one]

lemma coulombDataAccuracyThreshold_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L ε : ℝ) :
    coulombDataAccuracyThreshold (CoulombSystem.bo eta data) L ε =
      molecularDataAccuracyThreshold eta data L ε := by
  unfold coulombDataAccuracyThreshold molecularDataAccuracyThreshold
  rw [coulombDataCubicThreshold_bo, coulombDataBasisErrorConstant_bo]

omit [Fintype ν] in
lemma CoulombSystem.bo_isAdmissible (eta : ℕ) (data : FiniteBONuclearData ν)
    (lab : Fin eta → ℕ) : (CoulombSystem.bo eta data).IsAdmissible lab :=
  fun _ _ _ => rfl

end

end PlaneWaveCertificate

end ReleaseMilestone149
-- END RELEASE SOURCE 149

-- BEGIN RELEASE SOURCE 149b: Born--Oppenheimer theorems as instances
section ReleaseMilestone149b

/-!
# Milestone 149b: the Born--Oppenheimer theorems as instances

The theorems of milestones 140--142 for the periodic Born--Oppenheimer problem that the
entry points use, with their statements unchanged. Each is derived from the theorem for
Coulomb systems at `CoulombSystem.bo eta data` (electrons of mass one and charge `-1`,
clamped nuclei `data`), using the agreement at that system of the Hamiltonian graph, the
exchange sector, the energy budget, the error constants and the cutoff threshold
(milestones 148--149).
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology

noncomputable section

/-- The physical cubic Ritz energies form a decreasing sequence converging
to the actual fermionic Coulomb ground energy. Every entry is an attained
minimum on an ordinary Fourier cube. The ground energy is the infimum of
these energies, and every entry gives a certified interval containing it.

The initial cube is chosen large enough for all estimates; subsequent
cubes have integer radii m0+n. No spectral or analytic premise is added to
the physical inputs of milestone 140. -/
theorem bo_onehundredfortyone_milestone
    {ν : Type*} [Fintype ν] (eta : ℕ) (lab : Fin eta → ℕ) (_heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ psi : MolecularPositionL2 eta,
      HasMolecularFermionicGroundPair eta lab L data psi E ∧
      ∃ m0 : ℕ, 1 ≤ m0 ∧ ∃ energy : ℕ → ℝ,
        (∀ n : ℕ, IsMolecularFermionicCubicGroundEnergy eta lab L data
          ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) (energy n)) ∧
        Antitone energy ∧
        Tendsto energy atTop (𝓝 E) ∧
        E = (⨅ n : ℕ, energy n) ∧
        ∀ n : ℕ,
          (cubicPlaneWaveBox (m0 + n)).card = (2 * (m0 + n) + 1) ^ 3 ∧
          0 ≤ energy n - E ∧
          energy n - E ≤ molecularCanonicalCubicErrorConstant eta data E L /
            ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) ^ 3 ∧
          energy n - E ≤ molecularCanonicalBasisErrorConstant eta data E L /
            (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ∧
          energy n - molecularCanonicalBasisErrorConstant eta data E L /
              (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ≤ E ∧
          E ≤ energy n := by
  obtain ⟨E, psi, hPair, m0, hm0, energy, hSpec, hMono, hLimit, hInf, hBounds⟩ :=
    coulomb_sector_cubic_convergence (CoulombSystem.bo eta data) lab
      (CoulombSystem.bo_isAdmissible eta data lab) L hL
  refine ⟨E, psi, (hasCoulombSectorGroundPair_bo eta data lab L psi E).mp hPair, m0, hm0,
    energy, fun n => (isCoulombSectorCubicGroundEnergy_bo eta data lab L _ _).mp (hSpec n),
    hMono, hLimit, hInf, ?_⟩
  intro n
  simpa only [coulombCanonicalCubicErrorConstant_bo, coulombCanonicalBasisErrorConstant_bo]
    using hBounds n

/-- The reference-norm budget is explicit: at most the largest kinetic energy of the
reference cube plus the molecular H¹ form constant times the square root of the largest
H¹ weight. Both terms are bounded by polynomials in `eta`, the total charge, `L` and
`1/L`. -/
theorem molecularFiniteReferenceEnergyBound_le_explicit {ν : Type*} [Fintype ν]
    (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    molecularFiniteReferenceEnergyBound eta data L ≤
      (3 / 2) * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3 +
        finiteMolecularCoulombPhysicalFormConstant eta data L
            molecularCanonicalUnitHardyConstant *
          Real.sqrt (1 + 3 * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3) := by
  have h := coulombFiniteReferenceEnergyBound_le_explicit (CoulombSystem.bo eta data) L hL
  rwa [coulombFiniteReferenceEnergyBound_bo, finiteCoulombPhysicalFormConstant_bo] at h

/-- The data-only ground-energy budget is bounded by an explicit expression in the
kinetic scale and the molecular H¹ form constant. -/
theorem molecularGroundEnergyBudget_le_explicit {ν : Type*} [Fintype ν]
    (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    molecularGroundEnergyBudget eta data L ≤
      (3 / 2) * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3 +
        finiteMolecularCoulombPhysicalFormConstant eta data L
            molecularCanonicalUnitHardyConstant *
          Real.sqrt (1 + 3 * (2 * Real.pi / L) ^ 2 * (eta : ℝ) ^ 3) +
        (finiteMolecularCoulombPhysicalFormConstant eta data L
            molecularCanonicalUnitHardyConstant) ^ 2 + 1 / 4 := by
  have h := coulombGroundEnergyBudget_le_explicit (CoulombSystem.bo eta data) L hL
  rwa [coulombGroundEnergyBudget_bo, finiteCoulombPhysicalMassConstant_bo,
    finiteCoulombPhysicalFormConstant_bo] at h

/-- The physical Coulomb ground pair and cubic error certificate with
constants and an explicit admissible threshold determined solely by the
molecular data. The exact ground energy is not an input to either budget. -/
theorem bo_onehundredfortytwo_milestone
    {ν : Type*} [Fintype ν] (eta : ℕ) (lab : Fin eta → ℕ) (_heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ psi : MolecularPositionL2 eta,
      HasMolecularFermionicGroundPair eta lab L data psi E ∧
      |E| ≤ molecularGroundEnergyBudget eta data L ∧
      ∀ m : ℕ, molecularDataCubicThreshold eta data L ≤ m →
        ∃ EN : ℝ, IsMolecularFermionicCubicGroundEnergy eta lab L data
          ((2 * Real.pi / L) * (m : ℝ)) EN ∧
          (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
          0 ≤ EN - E ∧
          EN - E ≤ molecularDataCubicErrorConstant eta data L /
            ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
          EN - E ≤ molecularDataBasisErrorConstant eta data L /
            (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨E, psi, hPair, hBudget, hCubic⟩ := coulomb_sector_data_cubic_error
    (CoulombSystem.bo eta data) lab (CoulombSystem.bo_isAdmissible eta data lab) L hL
  rw [coulombGroundEnergyBudget_bo] at hBudget
  refine ⟨E, psi, (hasCoulombSectorGroundPair_bo eta data lab L psi E).mp hPair, hBudget, ?_⟩
  intro m hm
  rw [← coulombDataCubicThreshold_bo] at hm
  obtain ⟨EN, hEN, hCard, hNonneg, hRate, hCountRate⟩ := hCubic m hm
  rw [coulombDataCubicErrorConstant_bo] at hRate
  rw [coulombDataBasisErrorConstant_bo] at hCountRate
  exact ⟨EN, (isCoulombSectorCubicGroundEnergy_bo eta data lab L _ EN).mp hEN, hCard, hNonneg,
    hRate, hCountRate⟩

/-- The basis-count budget is a direct sufficient accuracy test. It retains
the inverse-count scaling: above the admissible cutoff, C_basis <= epsilon*N
certifies the requested energy interval. -/
theorem molecularCoulomb_data_accuracy_of_basis_budget
    {ν : Type*} [Fintype ν] (eta : ℕ) {lab : Fin eta → ℕ} (_heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L)
    (psi : MolecularPositionL2 eta) (E : ℝ)
    (hPair : HasMolecularFermionicGroundPair eta lab L data psi E)
    (ε : ℝ) (m : ℕ) (hm : molecularDataCubicThreshold eta data L ≤ m)
    (hBudget : molecularDataBasisErrorConstant eta data L ≤
      ε * (((2 * m + 1) ^ 3 : ℕ) : ℝ)) :
    (∃ EN : ℝ, IsMolecularFermionicCubicGroundEnergy eta lab L data
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsMolecularFermionicCubicGroundEnergy eta lab L data
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  rw [← coulombDataCubicThreshold_bo] at hm
  rw [← coulombDataBasisErrorConstant_bo] at hBudget
  obtain ⟨hExists, hEvery⟩ := coulombSector_data_accuracy_of_basis_budget
    (CoulombSystem.bo eta data) (CoulombSystem.bo_isAdmissible eta data lab) L hL psi E
    ((hasCoulombSectorGroundPair_bo eta data lab L psi E).mpr hPair) ε m hm hBudget
  obtain ⟨EN, hEN⟩ := hExists
  refine ⟨⟨EN, (isCoulombSectorCubicGroundEnergy_bo eta data lab L _ EN).mp hEN⟩, ?_⟩
  intro EN' hEN'
  exact hEvery EN' ((isCoulombSectorCubicGroundEnergy_bo eta data lab L _ EN').mpr hEN')

/-- The explicit molecular-data threshold certifies every positive accuracy,
without knowing the exact ground energy in advance. -/
theorem molecularCoulomb_data_accuracy_for_ground_pair
    {ν : Type*} [Fintype ν] (eta : ℕ) {lab : Fin eta → ℕ} (_heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L)
    (psi : MolecularPositionL2 eta) (E : ℝ)
    (hPair : HasMolecularFermionicGroundPair eta lab L data psi E)
    (ε : ℝ) (hε : 0 < ε) (m : ℕ)
    (hm : molecularDataAccuracyThreshold eta data L ε ≤ m) :
    (∃ EN : ℝ, IsMolecularFermionicCubicGroundEnergy eta lab L data
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsMolecularFermionicCubicGroundEnergy eta lab L data
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  rw [← coulombDataAccuracyThreshold_bo] at hm
  obtain ⟨hExists, hEvery⟩ := coulombSector_data_accuracy_for_ground_pair
    (CoulombSystem.bo eta data) (CoulombSystem.bo_isAdmissible eta data lab) L hL psi E
    ((hasCoulombSectorGroundPair_bo eta data lab L psi E).mpr hPair) ε hε m hm
  obtain ⟨EN, hEN⟩ := hExists
  refine ⟨⟨EN, (isCoulombSectorCubicGroundEnergy_bo eta data lab L _ EN).mp hEN⟩, ?_⟩
  intro EN' hEN'
  exact hEvery EN' ((isCoulombSectorCubicGroundEnergy_bo eta data lab L _ EN').mpr hEN')

end

end PlaneWaveCertificate

end ReleaseMilestone149b
-- END RELEASE SOURCE 149b

-- BEGIN RELEASE SOURCE 143: spin-inclusive electronic space
section ReleaseMilestone143

/-!
# Milestone 143: the spin-inclusive electronic space

The milestones above are stated for an exchange sector `lab : Fin eta → ℕ`:
antisymmetry under exchange of two particles with equal labels. The constant
labelling gives the fully antisymmetric spatial sector. This milestone builds
the physical electronic space `Λ^η(L²(T³) ⊗ ℂ²)` of the manuscript from the
sectors of the spin configurations `σ : Fin eta → Fin 2` (two electrons have
equal labels when they have equal spins; the labelling `spinLabel σ` is now in
the record file).

New results:
* Relabelling the particles of a position wavefunction is a unitary
  representation of the permutation group. It relabels the Fourier momenta,
  preserves cubic support, and commutes with the physical Coulomb Hamiltonian.
* The sector, spin and antisymmetrization results are proved for any unitary
  representation of particle relabelling (`ParticleRelabelling`), so that
  other state spaces, such as grid functions, can use them. The L2
  wavefunctions are one instance.
* On the sector `lab`, every label-preserving relabelling acts by its sign.
* A spin state is fermionic when it changes sign under simultaneous exchange
  of the positions and spins of two electrons. Each spin component of such a
  state lies in the sector of its spin pattern.
* Every state with cubic Fourier support lies in the H2 domain of the
  Hamiltonian. The cubic Ritz predicates therefore minimise over all of ran P
  in the sector, and over all of ran (P ⊗ I) on the electronic space.
* Antisymmetrization maps a sector state to a fermionic spin state. It scales
  inner products by the number of rearrangements of the spin pattern, maps
  Hamiltonian graph pairs to graph pairs and preserves cubic support.
* The ground energy on the electronic space is the lowest sector ground
  energy, and its cubic Ritz energy is the lowest sector cubic Ritz energy.
  The sector bounds use the per-particle tail bootstrap, and their data-only
  constants and thresholds do not depend on the sector. The spin-inclusive
  bounds therefore have the same data-only constants and threshold.

The spin-inclusive certificates of this milestone that the entry points use
are now derived from the theorems for Coulomb systems of milestone 150b, in
milestone 150c; the spin layer of milestones 150a--150b generalises the one
here to several species, bosons and other spin multiplicities, and the grid
files use that layer on grid functions. The declarations of this milestone that
no root uses any more, among them the antisymmetrization lemmas and the
assembly lemma `HasMolecularSpinGroundPair.of_sectors`, are in the record
file.
-/

/-! ## Spin-inclusive electronic sector: particle permutations -/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped BigOperators

noncomputable section

local instance unitAddCircleMeasureSpaceForSpin :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

local instance unitAddCircleProbabilityForSpin :
    IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  instIsProbabilityMeasureUnitAddCircleVolume

/-- Relabel the particles of a position configuration: particle `a` of the
result is at the position of particle `π a`. For a transposition this is
`molecularPositionSwap`. -/
def molecularPositionPermute {eta : ℕ} (π : Equiv.Perm (Fin eta))
    (x : MolecularPositionTorus eta) : MolecularPositionTorus eta :=
  fun a => x (π a.1, a.2)

@[simp] lemma molecularPositionPermute_apply {eta : ℕ} (π : Equiv.Perm (Fin eta))
    (x : MolecularPositionTorus eta) (a : Fin eta × Fin 3) :
    molecularPositionPermute π x a = x (π a.1, a.2) := rfl

/-- Relabelling particles preserves normalized product Haar measure. -/
theorem molecularPositionPermute_measurePreserving {eta : ℕ} (π : Equiv.Perm (Fin eta)) :
    MeasurePreserving (molecularPositionPermute π)
      (volume : Measure (MolecularPositionTorus eta)) volume := by
  let e : (Fin eta × Fin 3) ≃ (Fin eta × Fin 3) :=
    π.symm.prodCongr (Equiv.refl (Fin 3))
  have hFun :
      (MeasurableEquiv.piCongrLeft (fun _ : Fin eta × Fin 3 => UnitAddCircle) e :
        MolecularPositionTorus eta → MolecularPositionTorus eta) =
      molecularPositionPermute π := by
    funext x a
    have h := MeasurableEquiv.piCongrLeft_apply_apply
      (β := fun _ : Fin eta × Fin 3 => UnitAddCircle) e x (e.symm a)
    rw [e.apply_symm_apply] at h
    exact h
  have hPres : MeasurePreserving
      (MeasurableEquiv.piCongrLeft (fun _ : Fin eta × Fin 3 => UnitAddCircle) e :
        MolecularPositionTorus eta → MolecularPositionTorus eta) volume volume :=
    volume_measurePreserving_piCongrLeft
      (fun _ : Fin eta × Fin 3 => UnitAddCircle) e
  rw [hFun] at hPres
  exact hPres

/-- Particle relabelling as a measurable equivalence. -/
def molecularPositionPermuteMeasurableEquiv {eta : ℕ} (π : Equiv.Perm (Fin eta)) :
    MolecularPositionTorus eta ≃ᵐ MolecularPositionTorus eta where
  toFun := molecularPositionPermute π
  invFun := molecularPositionPermute π⁻¹
  left_inv x := by
    change molecularPositionPermute (π * π⁻¹) x = x
    rw [mul_inv_cancel]
    rfl
  right_inv x := by
    change molecularPositionPermute (π⁻¹ * π) x = x
    rw [inv_mul_cancel]
    rfl
  measurable_toFun := (molecularPositionPermute_measurePreserving π).measurable
  measurable_invFun := (molecularPositionPermute_measurePreserving π⁻¹).measurable

/-- Particle relabelling of actual L2 wavefunctions, by composition with the
measure-preserving relabelling of positions. -/
def molecularPositionPermLp {eta : ℕ} (π : Equiv.Perm (Fin eta)) :
    MolecularPositionL2 eta →ₗᵢ[ℂ] MolecularPositionL2 eta :=
  MeasureTheory.Lp.compMeasurePreservingₗᵢ ℂ (molecularPositionPermute π)
    (molecularPositionPermute_measurePreserving π)

theorem molecularPositionPermLp_coeFn {eta : ℕ} (π : Equiv.Perm (Fin eta))
    (f : MolecularPositionL2 eta) :
    (molecularPositionPermLp π f : MolecularPositionTorus eta → ℂ) =ᵐ[volume]
      (fun x => f (molecularPositionPermute π x)) :=
  MeasureTheory.Lp.coeFn_compMeasurePreserving f
    (molecularPositionPermute_measurePreserving π)

/-- A transposition acts as the existing coordinate exchange. -/
theorem molecularPositionPermLp_swap {eta : ℕ} (i j : Fin eta) (f : MolecularPositionL2 eta) :
    molecularPositionPermLp (Equiv.swap i j) f = molecularPositionSwapLp i j f := by
  apply MeasureTheory.Lp.ext
  filter_upwards [molecularPositionPermLp_coeFn (Equiv.swap i j) f,
    molecularPositionSwapLp_coeFn i j f] with x h1 h2
  rw [h1, h2]
  rfl

/-- Relabelling is a representation of the permutation group. -/
theorem molecularPositionPermLp_mul {eta : ℕ} (π ρ : Equiv.Perm (Fin eta))
    (f : MolecularPositionL2 eta) :
    molecularPositionPermLp π (molecularPositionPermLp ρ f) =
      molecularPositionPermLp (π * ρ) f := by
  apply MeasureTheory.Lp.ext
  filter_upwards [molecularPositionPermLp_coeFn π (molecularPositionPermLp ρ f),
    (molecularPositionPermute_measurePreserving π).quasiMeasurePreserving.ae
      (molecularPositionPermLp_coeFn ρ f),
    molecularPositionPermLp_coeFn (π * ρ) f] with x h1 h2 h3
  rw [h1, h2, h3]
  rfl

theorem molecularPositionPermLp_one {eta : ℕ} (f : MolecularPositionL2 eta) :
    molecularPositionPermLp 1 f = f := by
  apply MeasureTheory.Lp.ext
  filter_upwards [molecularPositionPermLp_coeFn 1 f] with x h1
  rw [h1]
  rfl

/-- Relabelling positions relabels the momenta of a plane wave. -/
theorem molecularPositionPlaneWave_permute {eta : ℕ} (π : Equiv.Perm (Fin eta))
    (p : FourierConfig eta Lattice3) (x : MolecularPositionTorus eta) :
    UnitAddTorus.mFourier (molecularFourierIndexEquiv eta (p ∘ π))
        (molecularPositionPermute π x) =
      UnitAddTorus.mFourier (molecularFourierIndexEquiv eta p) x := by
  rw [molecularPositionPlaneWave_factorization, molecularPositionPlaneWave_factorization]
  exact Equiv.prod_comp π
    (fun i : Fin eta => UnitAddTorus.mFourier (p i) (fun d => x (i, d)))

/-- Fourier coefficients of a relabelled function, for arbitrary representatives. -/
theorem molecularPositionFourierCoeff_comp_permute {eta : ℕ}
    (π : Equiv.Perm (Fin eta)) (f : MolecularPositionTorus eta → ℂ)
    (p : FourierConfig eta Lattice3) :
    UnitAddTorus.mFourierCoeff (fun x => f (molecularPositionPermute π x))
        (molecularFourierIndexEquiv eta p) =
      UnitAddTorus.mFourierCoeff f (molecularFourierIndexEquiv eta (p ∘ π)) := by
  have hPhase (x : MolecularPositionTorus eta) :
      UnitAddTorus.mFourier (-(molecularFourierIndexEquiv eta (p ∘ π)))
          (molecularPositionPermute π x) =
        UnitAddTorus.mFourier (-(molecularFourierIndexEquiv eta p)) x := by
    rw [UnitAddTorus.mFourier_neg, UnitAddTorus.mFourier_neg,
      molecularPositionPlaneWave_permute]
  have hPres : MeasurePreserving (molecularPositionPermuteMeasurableEquiv π)
      (volume : Measure (MolecularPositionTorus eta)) volume :=
    molecularPositionPermute_measurePreserving π
  unfold UnitAddTorus.mFourierCoeff
  calc
    (∫ x, UnitAddTorus.mFourier (-(molecularFourierIndexEquiv eta p)) x •
        f (molecularPositionPermute π x)) =
      ∫ x, UnitAddTorus.mFourier (-(molecularFourierIndexEquiv eta (p ∘ π)))
          (molecularPositionPermute π x) • f (molecularPositionPermute π x) := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x =>
        congrArg (fun z : ℂ => z • f (molecularPositionPermute π x)) (hPhase x).symm
    _ = ∫ x, UnitAddTorus.mFourier
          (-(molecularFourierIndexEquiv eta (p ∘ π))) x • f x :=
      hPres.integral_comp' (fun x : MolecularPositionTorus eta =>
        UnitAddTorus.mFourier (-(molecularFourierIndexEquiv eta (p ∘ π))) x • f x)

/-- Relabelling in position space relabels the momentum indices. -/
theorem molecularPositionPermLp_fourier {eta : ℕ} (π : Equiv.Perm (Fin eta))
    (f : MolecularPositionL2 eta) (p : FourierConfig eta Lattice3) :
    (molecularPositionSynthesis eta).symm (molecularPositionPermLp π f) p =
      (molecularPositionSynthesis eta).symm f (p ∘ π) := by
  rw [molecularPositionSynthesis_symm_apply, molecularPositionSynthesis_symm_apply]
  calc
    UnitAddTorus.mFourierCoeff (molecularPositionPermLp π f)
        (molecularFourierIndexEquiv eta p) =
      UnitAddTorus.mFourierCoeff (fun x => f (molecularPositionPermute π x))
        (molecularFourierIndexEquiv eta p) := by
      unfold UnitAddTorus.mFourierCoeff
      apply integral_congr_ae
      filter_upwards [molecularPositionPermLp_coeFn π f] with x hx
      rw [hx]
    _ = UnitAddTorus.mFourierCoeff f
        (molecularFourierIndexEquiv eta (p ∘ π)) :=
      molecularPositionFourierCoeff_comp_permute π f p

/-! ### Covariance of the physical Hamiltonian under particle relabelling -/

/-- The pair Coulomb term is even in the pair coordinate almost everywhere. -/
theorem molecularPositionPairCoulomb_swap_ae {eta : ℕ} (i j : Fin eta) (hij : i ≠ j) :
    ∀ᵐ x ∂(volume : Measure (MolecularPositionTorus eta)),
      canonicalUnitTorus3CoulombPotential.potential (molecularPositionDifference j i x) =
        canonicalUnitTorus3CoulombPotential.potential (molecularPositionDifference i j x) := by
  have h := (molecularPositionDifference_measurePreserving i j hij).quasiMeasurePreserving.ae
    canonicalUnitTorus3CoulombPotential_even_ae
  filter_upwards [h] with x hx
  have hDiff : molecularPositionDifference j i x = -(molecularPositionDifference i j x) := by
    funext a
    change x (j, a) - x (i, a) = -(x (i, a) - x (j, a))
    abel
  rw [hDiff]
  exact hx

/-- Relabelling transports a literal multiplication graph by an invariant potential. -/
theorem HasL2PointwisePotential.permute {eta : ℕ} {V : MolecularPositionTorus eta → ℂ}
    (π : Equiv.Perm (Fin eta))
    (hV : (fun x => V (molecularPositionPermute π x)) =ᵐ[volume] V)
    {f v : MolecularPositionL2 eta} (hv : HasL2PointwisePotential volume V f v) :
    HasL2PointwisePotential volume V
      (molecularPositionPermLp π f) (molecularPositionPermLp π v) := by
  filter_upwards [molecularPositionPermLp_coeFn π f, molecularPositionPermLp_coeFn π v,
    (molecularPositionPermute_measurePreserving π).quasiMeasurePreserving.ae hv, hV]
    with x hF hW hProduct hPotentialValue
  rw [hW, hF, ← hPotentialValue]
  exact hProduct

/-- Relabelling preserves cubic Fourier support. -/
theorem IsMolecularPositionCubic.permute {eta : ℕ} {L K : ℝ} {f : MolecularPositionL2 eta}
    (hf : IsMolecularPositionCubic eta L K f) (π : Equiv.Perm (Fin eta)) :
    IsMolecularPositionCubic eta L K (molecularPositionPermLp π f) := by
  intro p hp
  dsimp only
  rw [molecularPositionPermLp_fourier]
  obtain ⟨i, d, h⟩ := hp
  exact hf (p ∘ π)
    ⟨π.symm i, d, by simpa only [Function.comp_apply, Equiv.apply_symm_apply] using h⟩

/-- Cubic Fourier support is closed under scalar multiplication. -/
theorem IsMolecularPositionCubic.smul {eta : ℕ} {L K : ℝ} {f : MolecularPositionL2 eta}
    (hf : IsMolecularPositionCubic eta L K f) (c : ℂ) :
    IsMolecularPositionCubic eta L K (c • f) := by
  intro p hp
  have h0 : (molecularPositionSynthesis eta).symm f p = 0 := hf p hp
  dsimp only
  rw [LinearIsometryEquiv.map_smul]
  change c • (molecularPositionSynthesis eta).symm f p = 0
  rw [h0, smul_zero]

/-! ## Particle relabelling and exchange sectors in a general state space -/

/-- Electronic spin configurations: a value in `Fin 2` (spin up or down) for
each electron. -/
abbrev SpinConfig (eta : ℕ) := Fin eta → Fin 2

/-- The number of rearrangements of a spin pattern. -/
def spinOrbitCount {eta : ℕ} (σ₀ : SpinConfig eta) : ℕ := by
  classical
  exact (Finset.univ.filter
    (fun σ : SpinConfig eta => ∃ π : Equiv.Perm (Fin eta), σ ∘ π = σ₀)).card

lemma spinOrbitCount_pos {eta : ℕ} (σ₀ : SpinConfig eta) : 0 < spinOrbitCount σ₀ := by
  classical
  unfold spinOrbitCount
  apply Finset.card_pos.mpr
  refine ⟨σ₀, ?_⟩
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨1, rfl⟩

lemma norm_inv_smul_self_eq_one {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {x : E} (hx : ‖x‖ ≠ 0) : ‖((‖x‖⁻¹ : ℝ) : ℂ) • x‖ = 1 := by
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_inv, abs_norm, inv_mul_cancel₀ hx]

/-- A unitary representation of particle relabelling on a complex inner product
space of `eta`-particle states. -/
structure ParticleRelabelling (eta : ℕ) (V : Type*) [NormedAddCommGroup V]
    [InnerProductSpace ℂ V] where
  /-- The action of a relabelling of the particles. -/
  act : Equiv.Perm (Fin eta) → V →ₗᵢ[ℂ] V
  act_mul : ∀ π ρ v, act π (act ρ v) = act (π * ρ) v
  act_one : ∀ v, act 1 v = v

/-! ## The physical electronic space -/

/-- Relabelling of the particles of actual L2 wavefunctions. -/
def molecularPositionRelabelling (eta : ℕ) :
    ParticleRelabelling eta (MolecularPositionL2 eta) where
  act := molecularPositionPermLp
  act_mul := molecularPositionPermLp_mul
  act_one := molecularPositionPermLp_one

/-- Spin-dependent position wavefunctions: one L2 component for each spin
configuration, with the squared norm summed over spins. This is
`L²((T³)^η; (ℂ²)^{⊗η})` written in spin components. -/
abbrev MolecularSpinL2 (eta : ℕ) :=
  PiLp 2 (fun _ : SpinConfig eta => MolecularPositionL2 eta)

/-- Fermionic antisymmetry under simultaneous exchange of the positions and
spins of two electrons: `Ψ(τx, τσ) = -Ψ(x, σ)` for almost every `x`, for every
transposition `τ` and every spin configuration `σ`. These states form the
physical electronic space `Λ^η(L²(T³) ⊗ ℂ²)`. -/
def IsSpinFermionic {eta : ℕ} (Ψ : MolecularSpinL2 eta) : Prop :=
  ∀ i j : Fin eta, i ≠ j → ∀ σ : SpinConfig eta,
    ∀ᵐ x ∂(volume : Measure (MolecularPositionTorus eta)),
      Ψ (σ ∘ Equiv.swap i j) (molecularPositionSwap i j x) = -Ψ σ x

/-- The spin-independent physical Hamiltonian acts on each spin component. -/
def HasMolecularSpinCoulombHamiltonian {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (Ψ Φ : MolecularSpinL2 eta) : Prop :=
  ∀ σ : SpinConfig eta, HasMolecularCoulombHamiltonian eta L data (Ψ σ) (Φ σ)

/-- Cubic Fourier support in every spin component: the range of `P ⊗ I`. -/
def IsMolecularSpinCubic (eta : ℕ) (L K : ℝ) (Ψ : MolecularSpinL2 eta) : Prop :=
  ∀ σ : SpinConfig eta, IsMolecularPositionCubic eta L K (Ψ σ)

/-- A normalized ground eigenpair on the physical electronic space, with the
lower bound over all fermionic graph elements. -/
def HasMolecularSpinGroundPair {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (Ψ : MolecularSpinL2 eta) (E : ℝ) : Prop :=
  IsSpinFermionic Ψ ∧ ‖Ψ‖ = 1 ∧
    HasMolecularSpinCoulombHamiltonian eta L data Ψ ((E : ℂ) • Ψ) ∧
    ∀ F G : MolecularSpinL2 eta, IsSpinFermionic F →
      HasMolecularSpinCoulombHamiltonian eta L data F G →
      E * ‖F‖ ^ 2 ≤ (inner ℂ F G).re

/-- The attained cubic Ritz minimum on the physical electronic space: the
lowest eigenvalue of `P H P` on `ran P ∩ Λ^η(L²(T³) ⊗ ℂ²)`. -/
def IsMolecularSpinCubicGroundEnergy {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (K EN : ℝ) : Prop :=
  (∀ F G : MolecularSpinL2 eta, IsSpinFermionic F → IsMolecularSpinCubic eta L K F →
    HasMolecularSpinCoulombHamiltonian eta L data F G →
    EN * ‖F‖ ^ 2 ≤ (inner ℂ F G).re) ∧
  ∃ F G : MolecularSpinL2 eta, IsSpinFermionic F ∧ IsMolecularSpinCubic eta L K F ∧
    ‖F‖ = 1 ∧ HasMolecularSpinCoulombHamiltonian eta L data F G ∧ (inner ℂ F G).re = EN

/-! ### Cubic states lie in the Hamiltonian's domain

The cubic predicates quantify over cubic states that have a Hamiltonian image.
Every cubic state has one, so they minimise over all of `ran P` in the sector, and
over all of `ran (P ⊗ I) ∩ Λ^η(L²(T³) ⊗ ℂ²)` on the electronic space. The same holds
for the Hamiltonian of every Coulomb system. -/

/-- The Fourier coefficients of a state with cubic support vanish outside a finite set. -/
theorem IsMolecularPositionCubic.finite_support {eta : ℕ} {L K : ℝ} (hL : 0 < L)
    {f : MolecularPositionL2 eta} (hf : IsMolecularPositionCubic eta L K f) :
    Set.Finite {p : FourierConfig eta Lattice3 |
      (molecularPositionSynthesis eta).symm f p ≠ 0} := by
  classical
  have hg : 0 < 2 * Real.pi / L := div_pos (by positivity) hL
  let M : ℤ := Int.ceil (K / (2 * Real.pi / L))
  let box : Finset (FourierConfig eta Lattice3) :=
    Fintype.piFinset (fun _ : Fin eta => Fintype.piFinset (fun _ : Fin 3 => Finset.Icc (-M) M))
  refine (box.finite_toSet).subset ?_
  intro p hp
  have hBound := (isLatticeCubicCoeff_iff_coordinate_support eta K (2 * Real.pi / L) _).mp hf p hp
  simp only [box, Fintype.coe_piFinset, Set.mem_pi, Set.mem_univ, Finset.coe_Icc,
    Set.mem_Icc, forall_const]
  intro i d
  have hid := hBound i d
  rw [abs_mul, abs_of_pos hg] at hid
  have hle : |((p i d : ℤ) : ℝ)| ≤ K / (2 * Real.pi / L) := by
    rw [le_div_iff₀ hg]
    linarith only [hid]
  have hM : K / (2 * Real.pi / L) ≤ (M : ℝ) := Int.le_ceil _
  have habs : |((p i d : ℤ) : ℝ)| ≤ (M : ℝ) := hle.trans hM
  rw [abs_le] at habs
  constructor
  · exact_mod_cast habs.1
  · exact_mod_cast habs.2

/-- Every state with cubic Fourier support lies in the H2 domain of the physical
Hamiltonian: a finite Fourier sum has square-summable weighted coefficients. -/
theorem IsMolecularPositionCubic.mem_physicalH2Domain {eta : ℕ} {L K : ℝ} (hL : 0 < L)
    {f : MolecularPositionL2 eta} (hf : IsMolecularPositionCubic eta L K f) :
    f ∈ molecularPhysicalH2Domain eta (2 * Real.pi / L) := by
  classical
  rw [molecularPhysicalH2Domain_eq]
  let g : ℝ := 2 * Real.pi / L
  let c := (molecularPositionSynthesis eta).symm f
  let w : FourierConfig eta Lattice3 → ℂ := fun p =>
    (molecularFourierH2Weight eta g p : ℂ) * c p
  have hfin : Set.Finite {p : FourierConfig eta Lattice3 | w p ≠ 0} := by
    refine (hf.finite_support hL).subset ?_
    intro p hp hc
    apply hp
    change (molecularFourierH2Weight eta g p : ℂ) * c p = 0
    rw [show c p = 0 from hc, mul_zero]
  have hw : Memℓp w 2 := (memℓp_zero_iff.mpr hfin).of_exponent_ge (by norm_num)
  let u : MolecularFourierH2 eta := ⟨w, hw⟩
  have hu : molecularH2StateMap eta g u = c := by
    apply lp.ext
    funext p
    rw [molecularH2StateMap_apply]
    have hW : (molecularFourierH2Weight eta g p : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (ne_of_gt (molecularFourierH2Weight_pos eta g p))
    change (molecularFourierH2Weight eta g p : ℂ) * c p /
      (molecularFourierH2Weight eta g p : ℂ) = c p
    field_simp
  refine Submodule.mem_map.mpr ⟨c, LinearMap.mem_range.mpr ⟨u, hu⟩, ?_⟩
  change molecularPositionSynthesis eta c = f
  exact (molecularPositionSynthesis eta).apply_symm_apply f

/-- Every state with cubic Fourier support has an image under the physical Coulomb
Hamiltonian. So the cubic Ritz predicates minimise over all of `ran P` in the
sector, not over a subset of it. -/
theorem IsMolecularPositionCubic.exists_hamiltonian {ν : Type*} [Fintype ν] {eta : ℕ}
    {L K : ℝ} (data : FiniteBONuclearData ν) (hL : 0 < L)
    {f : MolecularPositionL2 eta} (hf : IsMolecularPositionCubic eta L K f) :
    ∃ h : MolecularPositionL2 eta, HasMolecularCoulombHamiltonian eta L data f h := by
  obtain ⟨hRcut, hRcutRouter, hHalf, _hLocal, _hUnit, hCutoffScale, hPeriodicScale⟩ :=
    molecularCanonicalHardyConstants_spec
  obtain ⟨H, hKernel, _hNorm⟩ :=
    exists_molecularFourierH2Operator_explicit_remainder eta data L
      molecularCanonicalUnitHardyConstant (1 / 8) (1 / 4) molecularCanonicalLocalHardyConstant
      hL hRcut hRcutRouter hHalf hCutoffScale hPeriodicScale
  let z : molecularPhysicalH2Domain eta (2 * Real.pi / L) := ⟨f, hf.mem_physicalH2Domain hL⟩
  exact ⟨(molecularPhysicalGalerkinBridge eta (fun _ => 0) L data hL H hKernel).hamiltonian z,
    (hasMolecularCoulombHamiltonian_iff_physicalGalerkinBridge eta (fun _ => 0) L data hL
      H hKernel f _).mpr ⟨z, rfl, rfl⟩⟩

/-- The cubic Ritz minimum in the sector `lab` bounds the energy of every state of
`ran P` in that sector. -/
theorem IsMolecularFermionicCubicGroundEnergy.le_of_cubic {ν : Type*} [Fintype ν]
    {eta : ℕ} {lab : Fin eta → ℕ} {L K EN : ℝ} {data : FiniteBONuclearData ν} (hL : 0 < L)
    (hEN : IsMolecularFermionicCubicGroundEnergy eta lab L data K EN)
    {f : MolecularPositionL2 eta} (hF : IsPositionFermionic lab f)
    (hC : IsMolecularPositionCubic eta L K f) :
    ∃ h : MolecularPositionL2 eta, HasMolecularCoulombHamiltonian eta L data f h ∧
      EN * ‖f‖ ^ 2 ≤ (inner ℂ f h).re := by
  obtain ⟨h, hh⟩ := hC.exists_hamiltonian data hL
  exact ⟨h, hh, hEN.1 f h hF hC hh⟩

/-- Every state with cubic Fourier support has an image under the Hamiltonian of any
Coulomb system. -/
theorem IsMolecularPositionCubic.exists_coulombHamiltonian {ν : Type*} [Fintype ν]
    {eta : ℕ} {L K : ℝ} (sys : CoulombSystem eta ν) (hL : 0 < L)
    {f : MolecularPositionL2 eta} (hf : IsMolecularPositionCubic eta L K f) :
    ∃ h : MolecularPositionL2 eta, HasCoulombHamiltonian sys L f h := by
  obtain ⟨H, hKernel, _hNorm⟩ := exists_coulombFourierH2Operator sys L
    molecularCanonicalUnitHardyConstant hL canonicalPeriodicCoulombHardyBound_explicit
  let z : molecularPhysicalH2Domain eta (2 * Real.pi / L) := ⟨f, hf.mem_physicalH2Domain hL⟩
  exact ⟨(coulombPhysicalGalerkinBridge sys (fun _ => 0) L hL H hKernel).hamiltonian z,
    (hasCoulombHamiltonian_iff_physicalGalerkinBridge sys (fun _ => 0) L hL H hKernel f _).mpr
      ⟨z, rfl, rfl⟩⟩

/-- The cubic Ritz minimum of a Coulomb system in the sector `lab` bounds the energy of
every state of `ran P` in that sector. -/
theorem IsCoulombSectorCubicGroundEnergy.le_of_cubic {ν : Type*} [Fintype ν] {eta : ℕ}
    {sys : CoulombSystem eta ν} {lab : Fin eta → ℕ} {L K EN : ℝ} (hL : 0 < L)
    (hEN : IsCoulombSectorCubicGroundEnergy sys lab L K EN)
    {f : MolecularPositionL2 eta} (hF : IsPositionSector sys.sign lab f)
    (hC : IsMolecularPositionCubic eta L K f) :
    ∃ h : MolecularPositionL2 eta, HasCoulombHamiltonian sys L f h ∧
      EN * ‖f‖ ^ 2 ≤ (inner ℂ f h).re := by
  obtain ⟨h, hh⟩ := hC.exists_coulombHamiltonian sys hL
  exact ⟨h, hh, hEN.1 f h hF hC hh⟩

/-- Every spin state whose components have cubic Fourier support has an image under
the spin-independent Hamiltonian. -/
theorem IsMolecularSpinCubic.exists_hamiltonian {ν : Type*} [Fintype ν] {eta : ℕ}
    {L K : ℝ} (data : FiniteBONuclearData ν) (hL : 0 < L)
    {Ψ : MolecularSpinL2 eta} (hΨ : IsMolecularSpinCubic eta L K Ψ) :
    ∃ Φ : MolecularSpinL2 eta, HasMolecularSpinCoulombHamiltonian eta L data Ψ Φ := by
  choose h hh using fun σ : SpinConfig eta => (hΨ σ).exists_hamiltonian data hL
  exact ⟨WithLp.toLp 2 h, fun σ => hh σ⟩

/-- The cubic Ritz minimum on the electronic space bounds the energy of every state
of `ran (P ⊗ I) ∩ Λ^η(L²(T³) ⊗ ℂ²)`. -/
theorem IsMolecularSpinCubicGroundEnergy.le_of_cubic {ν : Type*} [Fintype ν] {eta : ℕ}
    {L K EN : ℝ} {data : FiniteBONuclearData ν} (hL : 0 < L)
    (hEN : IsMolecularSpinCubicGroundEnergy eta L data K EN)
    {Ψ : MolecularSpinL2 eta} (hF : IsSpinFermionic Ψ) (hC : IsMolecularSpinCubic eta L K Ψ) :
    ∃ Φ : MolecularSpinL2 eta, HasMolecularSpinCoulombHamiltonian eta L data Ψ Φ ∧
      EN * ‖Ψ‖ ^ 2 ≤ (inner ℂ Ψ Φ).re := by
  obtain ⟨Φ, hΦ⟩ := hC.exists_hamiltonian data hL
  exact ⟨Φ, hΦ, hEN.1 Ψ Φ hF hC hΦ⟩

