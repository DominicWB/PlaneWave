  have hg : 0 < 2 * Real.pi / L := by positivity
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set T := coulombFourierKineticH2 sys (2 * Real.pi / L)
  set W := coulombFourierPotentialH2 sys (2 * Real.pi / L) H
  set HN := finiteCoulombHamiltonian sys L n
  set emb := finiteFourierLpIsometry eta n
  set M := tailMask (2 * Real.pi / L) lam a
  have hM := sys.one_le_maxMass
  have hb : 0 ≤ b := relB_nonneg sys L Hunit hC
  have hlam : 0 < lam := by linarith
  set y := UN s (extractCLM n (S u₀))
  -- `H_N y(s) = χ_N(s) - ρ_N(s)`
