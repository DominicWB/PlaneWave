/-- Cubic coordinate truncation is complex-linear. -/
lemma molecularH2Truncate_add {eta : ℕ} (N : ℕ)
    (u v : MolecularFourierH2 eta) :
    molecularH2Truncate N (u + v) = molecularH2Truncate N u + molecularH2Truncate N v := by
  classical
  exact (lpTruncateLinearMap (fourierConfigCube eta N)).map_add u v

lemma molecularH2Truncate_smul {eta : ℕ} (N : ℕ) (a : ℂ)
    (u : MolecularFourierH2 eta) :
    molecularH2Truncate N (a • u) = a • molecularH2Truncate N u := by
  classical
  exact (lpTruncateLinearMap (fourierConfigCube eta N)).map_smul a u

lemma molecularH2Truncate_zero {eta : ℕ} (N : ℕ) :
    molecularH2Truncate N (0 : MolecularFourierH2 eta) = 0 := by
  classical
  exact (lpTruncateLinearMap (fourierConfigCube eta N)).map_zero

/-- A larger output cube leaves an already truncated vector unchanged. -/
lemma molecularH2Truncate_truncate_of_le {eta : ℕ}
    (N M : ℕ) (hNM : N ≤ M) (u : MolecularFourierH2 eta) :
    molecularH2Truncate M (molecularH2Truncate N u) = molecularH2Truncate N u := by
  classical
  apply lp.ext
  funext p
  change lpTruncate (fourierConfigCube eta M)
    (lpTruncate (fourierConfigCube eta N) u) p = lpTruncate (fourierConfigCube eta N) u p
  simp only [lpTruncate_apply]
  by_cases hp : p ∈ fourierConfigCube eta N
  · simp only [if_pos hp, if_pos (fourierConfigCube_mono eta hNM hp)]
  · simp only [if_neg hp, ite_self]

/-- Once a cube contains an input, all larger cutoffs fix that input. -/
lemma molecularH2Truncate_eq_of_le {eta : ℕ}
    (N M : ℕ) (hNM : N ≤ M) (u : MolecularFourierH2 eta)
    (hFixed : molecularH2Truncate N u = u) : molecularH2Truncate M u = u := by
  calc
    molecularH2Truncate M u = molecularH2Truncate M (molecularH2Truncate N u) :=
      congrArg (molecularH2Truncate M) hFixed.symm
    _ = molecularH2Truncate N u := molecularH2Truncate_truncate_of_le N M hNM u
    _ = u := hFixed

/-- Each actual cutoff is an element of the algebraic Fourier core. -/
lemma molecularH2Truncate_mem_coordinateCore {eta : ℕ}
    (N : ℕ) (u : MolecularFourierH2 eta) :
