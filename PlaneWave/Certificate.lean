        rw [(hsK.mul_left α).tsum_add (hsS.mul_left (1 + 1 / α)), hsK.tsum_mul_left,
          hsS.tsum_mul_left]

include hKernel in
/-- **Relative bound of the potential.** For every `α > 0`,
`‖W u‖² ≤ C² (α ‖T u‖² + (1 + 1/α) ‖S u‖²)`, with the mass-weighted `H¹` constant `C`. -/
theorem potential_sq_le (Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) {α : ℝ} (hα : 0 < α)
    (u : MolecularFourierH2 eta) :
    ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H u‖ ^ 2 ≤
      finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 *
        (α * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ ^ 2 +
          (1 + 1 / α) * ‖molecularH2StateMap eta (2 * Real.pi / L) u‖ ^ 2) := by
