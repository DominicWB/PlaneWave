/-- Choose `eta` distinct members of an arbitrary finite one-particle space. -/
def occupiedModesOfCard
    {eta : ℕ} (μ : Type*) [Fintype μ] (hCard : eta ≤ Fintype.card μ) :
    Fin eta ↪ μ where
  toFun i := (Fintype.equivFin μ).symm ⟨i.val, lt_of_lt_of_le i.isLt hCard⟩
  inj' := by
    intro i j hij
    apply Fin.ext
