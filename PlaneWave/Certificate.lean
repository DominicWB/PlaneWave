    rw [h, Real.sqrt_sq hR.le]
  have hIntegral := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun r (_hr : r ∈ Set.uIcc (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2))) =>
      hasDerivAt_quadraticCoulombSlicePrimitive R z r hR.ne' hz)
    ((continuous_quadraticCoulombSliceDensity R z hz).intervalIntegrable
      (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2)))
  calc
    (∫ r in (0 : ℝ)..Real.sqrt (R ^ 2 - z ^ 2),
        r * ((Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
          (1 - Real.sqrt (z ^ 2 + r ^ 2) / R) ^ 2)) =
        quadraticCoulombSlicePrimitive R z (Real.sqrt (R ^ 2 - z ^ 2)) -
          quadraticCoulombSlicePrimitive R z 0 := hIntegral
    _ = (Real.pi * R / 3) * (1 - |z| / R) ^ 3 := by
      simp [quadraticCoulombSlicePrimitive, hEdge, hR.ne', Real.sqrt_sq_eq_abs]

/-- On the positive radial ray, the transverse cutoff is supported up to the
radius of the corresponding planar section of the ball. -/
lemma quadraticCoulombSliceDensity_eq_indicator
    {R z r : ℝ} (hR : 0 < R) (hzR : |z| < R) (hr : 0 < r) :
    r * ((Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
      (max 0 (1 - Real.sqrt (z ^ 2 + r ^ 2) / R)) ^ 2) =
      (Set.Ioc (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2))).indicator
        (fun s : ℝ => s * ((Real.pi / Real.sqrt (z ^ 2 + s ^ 2)) *
          (1 - Real.sqrt (z ^ 2 + s ^ 2) / R) ^ 2)) r := by
  have hDifference : 0 ≤ R ^ 2 - z ^ 2 := by
    nlinarith [sq_abs z, mul_pos (sub_pos.mpr hzR)
      (add_pos_of_pos_of_nonneg hR (abs_nonneg z))]
  have hUpperSq := Real.sq_sqrt hDifference
  have hUpperNonneg := Real.sqrt_nonneg (R ^ 2 - z ^ 2)
  by_cases hrUpper : r ≤ Real.sqrt (R ^ 2 - z ^ 2)
  · have hrSq : r ^ 2 ≤ (Real.sqrt (R ^ 2 - z ^ 2)) ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hrUpper)
        (add_nonneg hUpperNonneg hr.le)]
    have hRadius : Real.sqrt (z ^ 2 + r ^ 2) ≤ R :=
      (Real.sqrt_le_left hR.le).2 (by linarith)
    have hTaper : 0 ≤ 1 - Real.sqrt (z ^ 2 + r ^ 2) / R := by
      apply sub_nonneg.mpr
      exact (div_le_iff₀ hR).2 (by simpa using hRadius)
    rw [max_eq_right hTaper,
      Set.indicator_of_mem (show r ∈ Set.Ioc (0 : ℝ)
        (Real.sqrt (R ^ 2 - z ^ 2)) from ⟨hr, hrUpper⟩)]
  · have hUpper : Real.sqrt (R ^ 2 - z ^ 2) < r := lt_of_not_ge hrUpper
    have hrSq : (Real.sqrt (R ^ 2 - z ^ 2)) ^ 2 < r ^ 2 := by
      nlinarith [mul_pos (sub_pos.mpr hUpper)
        (add_pos_of_pos_of_nonneg hr hUpperNonneg)]
    have hRadius : R ≤ Real.sqrt (z ^ 2 + r ^ 2) :=
      Real.le_sqrt_of_sq_le (by linarith)
    have hTaper : 1 - Real.sqrt (z ^ 2 + r ^ 2) / R ≤ 0 := by
      apply sub_nonpos.mpr
      exact (le_div_iff₀ hR).2 (by simpa using hRadius)
    rw [max_eq_left hTaper,
      Set.indicator_of_notMem
        (show r ∉ Set.Ioc (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2)) from
          fun h => hrUpper h.2)]
    simp

/-- The exact planar marginal of the localized Coulomb pole. The excluded
longitudinal coordinate is a Lebesgue-null singleton, sufficient for Fubini. -/
theorem integral_quadraticCoulombPlaneSlice
    {R z : ℝ} (hR : 0 < R) (hz : z ≠ 0) :
    (∫ y : EuclideanSpace ℝ (Fin 2),
      (Real.pi / Real.sqrt (z ^ 2 + ‖y‖ ^ 2)) *
        (max 0 (1 - Real.sqrt (z ^ 2 + ‖y‖ ^ 2) / R)) ^ 2) =
      (2 * Real.pi ^ 2 * R / 3) * (max 0 (1 - |z| / R)) ^ 3 := by
  by_cases hzR : |z| < R
  · have hIntersection :
        Set.Ioi (0 : ℝ) ∩ Set.Ioc (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2)) =
          Set.Ioc (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2)) := by
      ext r
      simp only [Set.mem_inter_iff, Set.mem_Ioi, Set.mem_Ioc]
      tauto
    have hRadial :
        (∫ r in Set.Ioi (0 : ℝ),
          r * ((Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
            (max 0 (1 - Real.sqrt (z ^ 2 + r ^ 2) / R)) ^ 2)) =
          (Real.pi * R / 3) * (1 - |z| / R) ^ 3 := by
      calc
        (∫ r in Set.Ioi (0 : ℝ),
            r * ((Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
              (max 0 (1 - Real.sqrt (z ^ 2 + r ^ 2) / R)) ^ 2)) =
            ∫ r in Set.Ioi (0 : ℝ),
              (Set.Ioc (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2))).indicator
                (fun s : ℝ => s * ((Real.pi / Real.sqrt (z ^ 2 + s ^ 2)) *
                  (1 - Real.sqrt (z ^ 2 + s ^ 2) / R) ^ 2)) r := by
          apply setIntegral_congr_fun measurableSet_Ioi
          intro r hr
          exact quadraticCoulombSliceDensity_eq_indicator hR hzR hr
        _ = ∫ r in Set.Ioc (0 : ℝ) (Real.sqrt (R ^ 2 - z ^ 2)),
            r * ((Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
              (1 - Real.sqrt (z ^ 2 + r ^ 2) / R) ^ 2) := by
          rw [setIntegral_indicator measurableSet_Ioc, hIntersection]
        _ = ∫ r in (0 : ℝ)..Real.sqrt (R ^ 2 - z ^ 2),
            r * ((Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
              (1 - Real.sqrt (z ^ 2 + r ^ 2) / R) ^ 2) := by
          rw [intervalIntegral.integral_of_le (Real.sqrt_nonneg _)]
        _ = (Real.pi * R / 3) * (1 - |z| / R) ^ 3 :=
          integral_quadraticCoulombSliceDensity hR hz hzR
    have hTaper : 0 ≤ 1 - |z| / R := by
      apply sub_nonneg.mpr
      exact (div_le_iff₀ hR).2 (by simpa using hzR.le)
    calc
      (∫ y : EuclideanSpace ℝ (Fin 2),
          (Real.pi / Real.sqrt (z ^ 2 + ‖y‖ ^ 2)) *
            (max 0 (1 - Real.sqrt (z ^ 2 + ‖y‖ ^ 2) / R)) ^ 2) =
          2 * Real.pi * (∫ r in Set.Ioi (0 : ℝ),
            r * ((Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
              (max 0 (1 - Real.sqrt (z ^ 2 + r ^ 2) / R)) ^ 2)) :=
        integral_euclideanTwo_radial
          (fun r : ℝ => (Real.pi / Real.sqrt (z ^ 2 + r ^ 2)) *
            (max 0 (1 - Real.sqrt (z ^ 2 + r ^ 2) / R)) ^ 2)
      _ = (2 * Real.pi ^ 2 * R / 3) * (max 0 (1 - |z| / R)) ^ 3 := by
        rw [hRadial, max_eq_right hTaper]
        ring
  · have hRz : R ≤ |z| := le_of_not_gt hzR
    have hTaper : 1 - |z| / R ≤ 0 := by
      apply sub_nonpos.mpr
      exact (le_div_iff₀ hR).2 (by simpa using hRz)
    rw [max_eq_left hTaper, zero_pow (by decide : (3 : ℕ) ≠ 0), mul_zero]
    apply integral_eq_zero_of_ae
    filter_upwards [] with y
    have hRadius : R ≤ Real.sqrt (z ^ 2 + ‖y‖ ^ 2) :=
      hRz.trans (Real.abs_le_sqrt (le_add_of_nonneg_right (sq_nonneg ‖y‖)))
    have hCutoff : 1 - Real.sqrt (z ^ 2 + ‖y‖ ^ 2) / R ≤ 0 := by
      apply sub_nonpos.mpr
      exact (le_div_iff₀ hR).2 (by simpa using hRadius)
    simp only [max_eq_left hCutoff, zero_pow (by decide : (2 : ℕ) ≠ 0), mul_zero,
      Pi.zero_apply]

/-- Complex-valued version used inside Fourier integration. -/
theorem integral_quadraticCoulombPlaneSlice_complex
    {R z : ℝ} (hR : 0 < R) (hz : z ≠ 0) :
    (∫ y : EuclideanSpace ℝ (Fin 2),
      (((Real.pi / Real.sqrt (z ^ 2 + ‖y‖ ^ 2)) *
        (max 0 (1 - Real.sqrt (z ^ 2 + ‖y‖ ^ 2) / R)) ^ 2 : ℝ) : ℂ)) =
      (((2 * Real.pi ^ 2 * R / 3) *
        (max 0 (1 - |z| / R)) ^ 3 : ℝ) : ℂ) := by
  rw [integral_complex_ofReal, integral_quadraticCoulombPlaneSlice hR hz]

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-- A primitive of the cubic taper's cosine transform, expressed using the
quadratic sine primitive already verified in milestone 126. -/
def cubicRadialCosinePrimitive (R k x : ℝ) : ℝ :=
  (1 - x / R) ^ 3 * Real.sin (k * x) / k +
    (3 / (R * k)) * quadraticRadialSinePrimitive R k x

theorem hasDerivAt_cubicRadialCosinePrimitive
    (R k x : ℝ) (hR : R ≠ 0) (hk : k ≠ 0) :
    HasDerivAt (cubicRadialCosinePrimitive R k)
      ((1 - x / R) ^ 3 * Real.cos (k * x)) x := by
  have hLinear : HasDerivAt (fun y : ℝ => 1 - y / R) (-1 / R) x := by
    exact ((hasDerivAt_const x (1 : ℝ)).sub
      ((hasDerivAt_id x).div_const R)).congr_deriv (by ring)
  have hFrequency : HasDerivAt (fun y : ℝ => k * y) k x :=
    hasDerivAt_const_mul k
  have hFirst := ((hLinear.pow 3).mul hFrequency.sin).div_const k
  have hSecond := HasDerivAt.const_mul (3 / (R * k))
    (hasDerivAt_quadraticRadialSinePrimitive R k x hR hk)
  unfold cubicRadialCosinePrimitive
  refine (hFirst.add hSecond).congr_deriv ?_
  dsimp
  field_simp [hR, hk]
  ring

/-- Exact nonzero-frequency cosine transform on the positive half interval. -/
theorem integral_cubicRadialTaper_mul_cos
    (R k : ℝ) (hR : 0 < R) (hk : k ≠ 0) :
    (∫ x in (0 : ℝ)..R, (1 - x / R) ^ 3 * Real.cos (k * x)) =
      3 / (R * k ^ 2) -
        6 * (1 - Real.cos (k * R)) / (R ^ 3 * k ^ 4) := by
  have hContinuous : Continuous
      (fun x : ℝ => (1 - x / R) ^ 3 * Real.cos (k * x)) := by
    fun_prop
  have hIntegral := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun x (_hx : x ∈ Set.uIcc (0 : ℝ) R) =>
      hasDerivAt_cubicRadialCosinePrimitive R k x (ne_of_gt hR) hk)
    (hContinuous.intervalIntegrable (0 : ℝ) R)
  calc
    (∫ x in (0 : ℝ)..R, (1 - x / R) ^ 3 * Real.cos (k * x)) =
        cubicRadialCosinePrimitive R k R -
          cubicRadialCosinePrimitive R k 0 := hIntegral
    _ = 3 / (R * k ^ 2) -
        6 * (1 - Real.cos (k * R)) / (R ^ 3 * k ^ 4) := by
      simp only [cubicRadialCosinePrimitive, quadraticRadialSinePrimitive,
        mul_zero, Real.cos_zero, Real.sin_zero]
      field_simp [ne_of_gt hR, hk]
      ring

/-- The Fourier integral of a continuous even real function on a symmetric
interval is twice its cosine integral on the positive half. -/
theorem intervalIntegral_exp_mul_even_real
    (f : ℝ → ℝ) (hf : Continuous f) (heven : ∀ x, f (-x) = f x)
    (R k : ℝ) :
    (∫ x in (-R)..R,
      Complex.exp (((-(k * x) : ℝ) : ℂ) * Complex.I) * (f x : ℂ)) =
      ((2 * ∫ x in (0 : ℝ)..R, f x * Real.cos (k * x) : ℝ) : ℂ) := by
  let F : ℝ → ℂ := fun x =>
    Complex.exp (((-(k * x) : ℝ) : ℂ) * Complex.I) * (f x : ℂ)
  have hF : Continuous F := by
    dsimp [F]
    fun_prop
  have hFneg : Continuous (fun x : ℝ => F (-x)) :=
    hF.comp continuous_neg
  have hreflect : (∫ x in (0 : ℝ)..R, F (-x)) =
      ∫ x in (-R)..(0 : ℝ), F x := by
    simpa only [neg_zero] using
      (intervalIntegral.integral_comp_neg (a := (0 : ℝ)) (b := R) F)
  have hpair (x : ℝ) : F (-x) + F x =
      ((2 * (f x * Real.cos (k * x)) : ℝ) : ℂ) := by
    dsimp [F]
    rw [heven, mul_neg, neg_neg]
    rw [Complex.exp_ofReal_mul_I (k * x),
      Complex.exp_ofReal_mul_I (-(k * x))]
    simp only [Real.cos_neg, Real.sin_neg, Complex.ofReal_neg, Complex.ofReal_mul,
      Complex.ofReal_ofNat]
    ring
  change (∫ x in (-R)..R, F x) = _
  calc
    (∫ x in (-R)..R, F x) =
        (∫ x in (-R)..(0 : ℝ), F x) + (∫ x in (0 : ℝ)..R, F x) :=
      (intervalIntegral.integral_add_adjacent_intervals
        (hF.intervalIntegrable (-R) 0) (hF.intervalIntegrable 0 R)).symm
    _ = (∫ x in (0 : ℝ)..R, F (-x)) + (∫ x in (0 : ℝ)..R, F x) := by
      rw [hreflect]
    _ = ∫ x in (0 : ℝ)..R, (F (-x) + F x) :=
      (intervalIntegral.integral_add (hFneg.intervalIntegrable 0 R)
        (hF.intervalIntegrable 0 R)).symm
    _ = ∫ x in (0 : ℝ)..R,
        ((2 * (f x * Real.cos (k * x)) : ℝ) : ℂ) := by
      apply intervalIntegral.integral_congr
      intro x _hx
      exact hpair x
    _ = ((2 * ∫ x in (0 : ℝ)..R, f x * Real.cos (k * x) : ℝ) : ℂ) := by
      rw [intervalIntegral.integral_ofReal, intervalIntegral.integral_const_mul]

/-- The one-dimensional marginal of the localized quadratic Coulomb kernel. -/
def cubicCoulombMarginal (R x : ℝ) : ℝ :=
  (2 * Real.pi ^ 2 * R / 3) * max 0 (1 - |x| / R) ^ 3

theorem continuous_cubicCoulombMarginal (R : ℝ) :
    Continuous (cubicCoulombMarginal R) := by
  unfold cubicCoulombMarginal
  fun_prop

theorem cubicCoulombMarginal_even (R x : ℝ) :
    cubicCoulombMarginal R (-x) = cubicCoulombMarginal R x := by
  simp only [cubicCoulombMarginal, abs_neg]

theorem cubicCoulombMarginal_eq_zero_of_le_abs
    (R x : ℝ) (hR : 0 < R) (hx : R ≤ |x|) :
    cubicCoulombMarginal R x = 0 := by
  have hratio : 1 ≤ |x| / R := (le_div_iff₀ hR).2 (by simpa using hx)
  have htaper : max 0 (1 - |x| / R) = 0 := max_eq_left (by linarith)
  simp [cubicCoulombMarginal, htaper]

theorem cubicCoulombMarginal_eq_of_mem_Icc
    (R x : ℝ) (hR : 0 < R) (hx : x ∈ Set.Icc (0 : ℝ) R) :
    cubicCoulombMarginal R x =
      (2 * Real.pi ^ 2 * R / 3) * (1 - x / R) ^ 3 := by
  have hratio : x / R ≤ 1 := (div_le_iff₀ hR).2 (by simpa using hx.2)
  simp only [cubicCoulombMarginal, abs_of_nonneg hx.1,
    max_eq_right (show 0 ≤ 1 - x / R by linarith)]

/-- Exact Fourier transform of the cubic marginal, including cancellation of
the odd imaginary part. This statement has no Fourier-identity premise. -/
theorem integral_exp_mul_cubicCoulombMarginal
    (R k : ℝ) (hR : 0 < R) (hk : k ≠ 0) :
    (∫ x : ℝ,
      Complex.exp (((-(k * x) : ℝ) : ℂ) * Complex.I) *
        (cubicCoulombMarginal R x : ℂ)) =
      ((4 * Real.pi ^ 2 / k ^ 2 -
        8 * Real.pi ^ 2 * (1 - Real.cos (k * R)) /
          (R ^ 2 * k ^ 4) : ℝ) : ℂ) := by
  let F : ℝ → ℂ := fun x =>
    Complex.exp (((-(k * x) : ℝ) : ℂ) * Complex.I) *
      (cubicCoulombMarginal R x : ℂ)
  have hsupport : Function.support F ⊆ Set.Ioc (-R) R := by
    intro x hx
    have hxabs : |x| < R := by
      by_contra h
      have hz := cubicCoulombMarginal_eq_zero_of_le_abs R x hR (le_of_not_gt h)
      exact hx (by simp [F, hz])
    exact ⟨(abs_lt.mp hxabs).1, (abs_lt.mp hxabs).2.le⟩
  have hhalf :
      (∫ x in (0 : ℝ)..R, cubicCoulombMarginal R x * Real.cos (k * x)) =
        (2 * Real.pi ^ 2 * R / 3) *
          (3 / (R * k ^ 2) -
            6 * (1 - Real.cos (k * R)) / (R ^ 3 * k ^ 4)) := by
    calc
      (∫ x in (0 : ℝ)..R, cubicCoulombMarginal R x * Real.cos (k * x)) =
          ∫ x in (0 : ℝ)..R, (2 * Real.pi ^ 2 * R / 3) *
            ((1 - x / R) ^ 3 * Real.cos (k * x)) := by
        apply intervalIntegral.integral_congr
        intro x hx
        rw [Set.uIcc_of_le hR.le] at hx
        change cubicCoulombMarginal R x * Real.cos (k * x) =
          (2 * Real.pi ^ 2 * R / 3) * ((1 - x / R) ^ 3 * Real.cos (k * x))
        rw [cubicCoulombMarginal_eq_of_mem_Icc R x hR hx]
        ring
      _ = _ := by
        rw [intervalIntegral.integral_const_mul,
          integral_cubicRadialTaper_mul_cos R k hR hk]
  calc
    (∫ x : ℝ, F x) = ∫ x in (-R)..R, F x :=
      (intervalIntegral.integral_eq_integral_of_support_subset hsupport).symm
    _ = ((2 * ∫ x in (0 : ℝ)..R,
        cubicCoulombMarginal R x * Real.cos (k * x) : ℝ) : ℂ) :=
      intervalIntegral_exp_mul_even_real (cubicCoulombMarginal R)
        (continuous_cubicCoulombMarginal R) (cubicCoulombMarginal_even R) R k
    _ = _ := by
      rw [hhalf]
      congr 1
      field_simp [ne_of_gt hR, hk]
      ring

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

open MeasureTheory
open scoped BigOperators

noncomputable section

/-- Split Euclidean three-space into a longitudinal real coordinate and a
transverse Euclidean plane, using the standard coordinate order. -/
def euclideanThreeFromSlice (z : ℝ) (y : EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 3) :=
  WithLp.toLp 2 (Fin.cons z y.ofLp)

lemma euclideanThreeFromSlice_norm (z : ℝ) (y : EuclideanSpace ℝ (Fin 2)) :
    ‖euclideanThreeFromSlice z y‖ = Real.sqrt (z ^ 2 + ‖y‖ ^ 2) := by
  have hSq : ‖euclideanThreeFromSlice z y‖ ^ 2 = z ^ 2 + ‖y‖ ^ 2 := by
    have hLast : Fin.cons (α := fun _ : Fin 3 => ℝ) z y.ofLp (2 : Fin 3) =
        y.ofLp (1 : Fin 2) := by
      exact Fin.cons_succ (α := fun _ : Fin 3 => ℝ) z y.ofLp (1 : Fin 2)
    simp [EuclideanSpace.real_norm_sq_eq, euclideanThreeFromSlice,
      Fin.sum_univ_three, Fin.sum_univ_two, hLast, add_assoc]
  rw [← hSq, Real.sqrt_sq (norm_nonneg _)]

lemma euclideanThreeFromSlice_inner_axis
    (ρ z : ℝ) (y : EuclideanSpace ℝ (Fin 2)) :
    inner ℝ (EuclideanSpace.single (0 : Fin 3) ρ)
      (euclideanThreeFromSlice z y) = ρ * z := by
  simp [EuclideanSpace.inner_single_left, euclideanThreeFromSlice]

/-- Fubini in an orthonormal coordinate system, with both Euclidean volume
normalizations proved by the volume-preserving `toLp` maps. -/
theorem integral_euclideanThree_slices
    (f : EuclideanSpace ℝ (Fin 3) → ℂ) (hf : Integrable f) :
    (∫ x : EuclideanSpace ℝ (Fin 3), f x) =
      ∫ z : ℝ, ∫ y : EuclideanSpace ℝ (Fin 2),
        f (euclideanThreeFromSlice z y) := by
  have hPres3 : MeasurePreserving
      (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)) volume volume :=
    PiLp.volume_preserving_toLp (Fin 3)
  have hPres2 : MeasurePreserving
      (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)) volume volume :=
    PiLp.volume_preserving_toLp (Fin 2)
  have hCoord := hardyCoordinateMeasureEquiv_symm_measurePreserving (0 : Fin 3)
  have hAmbient : Integrable
      (fun x : CenteredCube3Ambient => f (WithLp.toLp 2 x)) :=
    hPres3.integrable_comp_of_integrable hf
  have hProduct : Integrable
      (fun p : ℝ × (Fin 2 → ℝ) =>
        f (WithLp.toLp 2 ((hardyCoordinateMeasureEquiv (0 : Fin 3)).symm p))) :=
    hCoord.integrable_comp_of_integrable hAmbient
  calc
    (∫ x : EuclideanSpace ℝ (Fin 3), f x) =
        ∫ x : CenteredCube3Ambient, f (WithLp.toLp 2 x) :=
      (hPres3.integral_comp' f).symm
    _ = ∫ p : ℝ × (Fin 2 → ℝ),
        f (WithLp.toLp 2 ((hardyCoordinateMeasureEquiv (0 : Fin 3)).symm p)) :=
      (hCoord.integral_comp'
        (fun x : CenteredCube3Ambient => f (WithLp.toLp 2 x))).symm
    _ = ∫ z : ℝ, ∫ y : Fin 2 → ℝ,
        f (WithLp.toLp 2 ((0 : Fin 3).insertNth z y)) := by
      simpa only [Measure.volume_eq_prod, hardyCoordinateMeasureEquiv_symm_apply] using
        (integral_prod _ hProduct)
    _ = ∫ z : ℝ, ∫ y : EuclideanSpace ℝ (Fin 2),
        f (euclideanThreeFromSlice z y) := by
      apply integral_congr_ae
      filter_upwards with z
      simp only [Fin.insertNth_zero']
      change (∫ y : Fin 2 → ℝ,
        f (euclideanThreeFromSlice z (WithLp.toLp 2 y))) =
        ∫ y : EuclideanSpace ℝ (Fin 2), f (euclideanThreeFromSlice z y)
      exact hPres2.integral_comp'
        (fun y : EuclideanSpace ℝ (Fin 2) => f (euclideanThreeFromSlice z y))

/-- The actual Euclidean plane marginal is the compact cubic taper. The
exceptional plane through the origin is immaterial for the outer integral. -/
theorem integral_euclideanQuadraticCoulombSingular_slice
    {R z : ℝ} (hR : 0 < R) (hz : z ≠ 0) :
    (∫ y : EuclideanSpace ℝ (Fin 2),
      (euclideanQuadraticCoulombSingular R (euclideanThreeFromSlice z y) : ℂ)) =
      (cubicCoulombMarginal R z : ℂ) := by
  simp only [euclideanQuadraticCoulombSingular, euclideanThreeFromSlice_norm,
    cubicCoulombMarginal]
  exact integral_quadraticCoulombPlaneSlice_complex hR hz

/-- The nonzero-frequency angular problem is reduced to the proved cubic
marginal by actual rotation, Fubini, and the two-dimensional radial integral.
No angular identity or slice formula is assumed. -/
theorem euclideanQuadraticCoulombFourier_axis_eq_cubic_integral
    {R : ℝ} (hR : 0 < R) (ρ : ℝ) :
    euclideanQuadraticCoulombFourier R (EuclideanSpace.single (0 : Fin 3) ρ) =
      ∫ z : ℝ, Complex.exp (((-(2 * Real.pi * ρ * z) : ℝ) : ℂ) * Complex.I) *
        (cubicCoulombMarginal R z : ℂ) := by
