lemma norm_sq_stateMap (g : ℝ) (x : MolecularFourierH2 eta) :
    ‖molecularH2StateMap eta g x‖ ^ 2 = ∑' p, ‖molecularH2Coeff g x p‖ ^ 2 := by
  rw [l2_norm_sq]
  simp only [molecularH2StateMap_apply]

omit [Fintype ν] in
lemma summable_stateMap_sq (g : ℝ) (x : MolecularFourierH2 eta) :
    Summable fun p => ‖molecularH2Coeff g x p‖ ^ 2 := by
  have h := l2_summable_sq (molecularH2StateMap eta g x)
  simpa only [molecularH2StateMap_apply] using h

omit [Fintype ν] in
lemma norm_sq_kinetic (g : ℝ) (x : MolecularFourierH2 eta) :
    ‖coulombFourierKineticH2 sys g x‖ ^ 2 =
      ∑' p, coulombKineticEnergySymbol sys g p ^ 2 * ‖molecularH2Coeff g x p‖ ^ 2 := by
  rw [l2_norm_sq]
  congr 1
  funext p
  rw [coulombFourierKineticH2_apply, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow,
    sq_abs]

omit [Fintype ν] in
lemma summable_kinetic_sq (g : ℝ) (x : MolecularFourierH2 eta) :
    Summable fun p => coulombKineticEnergySymbol sys g p ^ 2 * ‖molecularH2Coeff g x p‖ ^ 2 := by
  have h := l2_summable_sq (coulombFourierKineticH2 sys g x)
  refine h.congr fun p => ?_
  rw [coulombFourierKineticH2_apply, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow,
    sq_abs]

