  rcases hNonzero with ⟨w, hw, hw0⟩
  have hwS : (⟨w, hw⟩ : S) ≠ 0 := by
    intro h
    exact hw0 (congrArg (fun v : S => (v : V)) h)
  letI : Nontrivial S := ⟨⟨⟨w, hw⟩, 0, hwS⟩⟩
  rcases exists_normalized_ground_eigenpair (finiteSectorCompression S H)
      (finiteSectorCompression_isSymmetric S H hH) with ⟨E, u, hNorm, hEigen, hLower⟩
  refine ⟨E, ?_, (u : V), u.property, hNorm, ?_⟩
  · intro v hv
    have h := hLower (⟨v, hv⟩ : S)
    rw [finiteSectorCompression_inner] at h
    exact h
  · have h := normalized_eigen_quadratic (finiteSectorCompression S H) E u hNorm hEigen
    rw [finiteSectorCompression_inner] at h
