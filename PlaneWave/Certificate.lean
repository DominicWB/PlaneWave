local instance unitAddCircleMeasureSpaceForFourier126 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

local instance unitAddCircleProbabilityMeasureForFourier126 :
    IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  instIsProbabilityMeasureUnitAddCircleVolume

local instance unitTorus3FiniteMeasureForFourier126 :
    IsFiniteMeasure (volume : Measure UnitTorus3) := by
  infer_instance

/-- Absolute summability of Fourier coefficients gives a continuous synthesis
on the actual unit torus. The series is taken in the uniform norm. -/
def unitTorus3AbsoluteFourierSynthesis (a : Lattice3 → ℂ) : C(UnitTorus3, ℂ) :=
  ∑' n : Lattice3, a n • UnitAddTorus.mFourier n

lemma unitTorus3AbsoluteFourierSeries_summable
    (a : Lattice3 → ℂ) (ha : Summable (fun n => ‖a n‖)) :
    Summable (fun n : Lattice3 => a n • UnitAddTorus.mFourier n) := by
  apply Summable.of_norm
  simpa only [norm_smul, UnitAddTorus.mFourier_norm, mul_one] using ha

lemma unitTorus3AbsoluteFourierSynthesis_norm_le
    (a : Lattice3 → ℂ) (ha : Summable (fun n => ‖a n‖)) :
    ‖unitTorus3AbsoluteFourierSynthesis a‖ ≤ ∑' n : Lattice3, ‖a n‖ := by
  unfold unitTorus3AbsoluteFourierSynthesis
  apply tsum_of_norm_bounded ha.hasSum
  intro n
  simp only [norm_smul, UnitAddTorus.mFourier_norm, mul_one, le_refl]

lemma unitTorus3AbsoluteFourierSynthesis_apply_norm_le
    (a : Lattice3 → ℂ) (ha : Summable (fun n => ‖a n‖)) (x : UnitTorus3) :
    ‖unitTorus3AbsoluteFourierSynthesis a x‖ ≤ ∑' n : Lattice3, ‖a n‖ := by
  exact (ContinuousMap.norm_coe_le_norm _ x).trans
    (unitTorus3AbsoluteFourierSynthesis_norm_le a ha)

/-- Identify uniform synthesis with an L2 state by uniqueness of its Fourier
series. No pointwise choice of a representative of the L2 state is used. -/
lemma unitTorus3AbsoluteFourierSynthesis_toLp_eq
    (a : Lattice3 → ℂ) (ha : Summable (fun n => ‖a n‖))
    (f : UnitTorus3L2)
    (hf : ∀ n : Lattice3, UnitAddTorus.mFourierCoeff (fun x => f x) n = a n) :
    ContinuousMap.toLp 2 volume ℂ (unitTorus3AbsoluteFourierSynthesis a) = f := by
  have hMap := (ContinuousMap.toLp 2 volume ℂ).hasSum
    (unitTorus3AbsoluteFourierSeries_summable a ha).hasSum
  have hMap' : HasSum (fun n : Lattice3 => a n • UnitAddTorus.mFourierLp 2 n)
      (ContinuousMap.toLp 2 volume ℂ (unitTorus3AbsoluteFourierSynthesis a)) := by
    simpa only [Function.comp_def, map_smul, unitTorus3AbsoluteFourierSynthesis] using hMap
  have hFourier : HasSum (fun n : Lattice3 => a n • UnitAddTorus.mFourierLp 2 n) f := by
    simpa only [hf] using UnitAddTorus.hasSum_mFourier_series_L2 f
  exact hMap'.unique hFourier

lemma unitTorus3L2_ae_norm_le_of_fourier_l1
    (a : Lattice3 → ℂ) (ha : Summable (fun n => ‖a n‖))
    (f : UnitTorus3L2)
    (hf : ∀ n : Lattice3, UnitAddTorus.mFourierCoeff (fun x => f x) n = a n) :
    ∀ᵐ x : UnitTorus3 ∂volume, ‖f x‖ ≤ ∑' n : Lattice3, ‖a n‖ := by
  have hEq := ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) volume
    (unitTorus3AbsoluteFourierSynthesis a)
  rw [unitTorus3AbsoluteFourierSynthesis_toLp_eq a ha f hf] at hEq
  filter_upwards [hEq] with x hx
  rw [hx]
  exact unitTorus3AbsoluteFourierSynthesis_apply_norm_le a ha x

/-- The usable form for a concrete measurable function: a proved l1 coefficient
budget gives an essential bound for that function, through its L2 class. -/
lemma unitTorus3_ae_norm_le_of_memLp_fourier_l1
    (f : UnitTorus3 → ℂ) (hf : MemLp f 2 volume)
    (a : Lattice3 → ℂ) (ha : Summable (fun n => ‖a n‖))
    (hCoeff : ∀ n : Lattice3, UnitAddTorus.mFourierCoeff f n = a n) :
    ∀ᵐ x : UnitTorus3 ∂volume, ‖f x‖ ≤ ∑' n : Lattice3, ‖a n‖ := by
  have hRep : (fun x => hf.toLp f x) =ᵐ[volume] f := MemLp.coeFn_toLp hf
  have hCoeffLp : ∀ n : Lattice3,
      UnitAddTorus.mFourierCoeff (fun x => hf.toLp f x) n = a n := by
    intro n
    rw [← hCoeff n]
    unfold UnitAddTorus.mFourierCoeff
    apply integral_congr_ae
    filter_upwards [hRep] with x hx
    rw [hx]
  have hBound := unitTorus3L2_ae_norm_le_of_fourier_l1 a ha (hf.toLp f) hCoeffLp
  filter_upwards [hRep, hBound] with x hx hb
  rwa [hx] at hb

/-- Uniqueness of an L2 torus state from all lattice Fourier coefficients. -/
lemma unitTorus3L2_eq_of_fourierCoeff_eq (f g : UnitTorus3L2)
    (h : ∀ n : Lattice3,
      UnitAddTorus.mFourierCoeff (fun x => f x) n =
        UnitAddTorus.mFourierCoeff (fun x => g x) n) : f = g := by
  apply UnitAddTorus.mFourierBasis.repr.injective
  apply lp.ext
  funext n
  rw [UnitAddTorus.mFourierBasis_repr, UnitAddTorus.mFourierBasis_repr]
  exact h n

lemma unitTorus3_fourierCoeff_congr_ae
    {f g : UnitTorus3 → ℂ} (h : f =ᵐ[volume] g) (n : Lattice3) :
    UnitAddTorus.mFourierCoeff f n = UnitAddTorus.mFourierCoeff g n := by
  unfold UnitAddTorus.mFourierCoeff
  apply integral_congr_ae
  filter_upwards [h] with x hx
  rw [hx]

/-- Linearity of Fourier coefficients on L2 classes follows directly from the
Fourier Hilbert-basis representation, with no new integral estimate. -/
lemma unitTorus3L2_fourierCoeff_sub (f g : UnitTorus3L2) (n : Lattice3) :
    UnitAddTorus.mFourierCoeff (fun x => (f - g) x) n =
      UnitAddTorus.mFourierCoeff (fun x => f x) n -
        UnitAddTorus.mFourierCoeff (fun x => g x) n := by
  calc
    UnitAddTorus.mFourierCoeff (fun x => (f - g) x) n =
        UnitAddTorus.mFourierBasis.repr (f - g) n :=
      (UnitAddTorus.mFourierBasis_repr (f - g) n).symm
    _ = UnitAddTorus.mFourierBasis.repr f n -
        UnitAddTorus.mFourierBasis.repr g n :=
      congrArg (fun u : lp (fun _ : Lattice3 => ℂ) 2 => u n)
        (map_sub UnitAddTorus.mFourierBasis.repr f g)
    _ = _ := by rw [UnitAddTorus.mFourierBasis_repr, UnitAddTorus.mFourierBasis_repr]

/-- Subtraction of Fourier coefficients of concrete L2 representatives. -/
lemma unitTorus3_fourierCoeff_sub_of_memLp
    (f g : UnitTorus3 → ℂ) (hf : MemLp f 2 volume) (hg : MemLp g 2 volume)
    (n : Lattice3) :
    UnitAddTorus.mFourierCoeff (fun x => f x - g x) n =
      UnitAddTorus.mFourierCoeff f n - UnitAddTorus.mFourierCoeff g n := by
  have hF : (fun x => hf.toLp f x) =ᵐ[volume] f := MemLp.coeFn_toLp hf
  have hG : (fun x => hg.toLp g x) =ᵐ[volume] g := MemLp.coeFn_toLp hg
  have hSub : (fun x => (hf.toLp f - hg.toLp g) x) =ᵐ[volume]
      (fun x => f x - g x) := by
    filter_upwards [Lp.coeFn_sub (hf.toLp f) (hg.toLp g), hF, hG]
      with x hx hfx hgx
    rw [hx]
    change hf.toLp f x - hg.toLp g x = f x - g x
    rw [hfx, hgx]
  rw [← unitTorus3_fourierCoeff_congr_ae hSub n,
    unitTorus3L2_fourierCoeff_sub,
    unitTorus3_fourierCoeff_congr_ae hF n,
    unitTorus3_fourierCoeff_congr_ae hG n]

end
