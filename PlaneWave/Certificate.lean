/-! ## Ninety-eighth milestone: measurable ambient representatives and Hardy cross-term integrability -/

/-- The continuous-representative cutoff wave is genuinely measurable on the
centered cube. -/
lemma centeredCube3RadialCutoffWaveFunction_measurable
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ) :
    Measurable
      (centeredCube3RadialCutoffWaveFunction rho R index f) := by
  have hPoly :
      Measurable
        (fun y : CenteredCube3 =>
          torus3FourierContinuousPolynomial index f
            (unitTorus3CenteredEquiv.symm y)) := by
    exact
      (torus3FourierContinuousPolynomial index f).continuous.measurable.comp
        unitTorus3CenteredEquiv.symm.measurable
  unfold centeredCube3RadialCutoffWaveFunction
  exact
    (centeredCube3RadialCutoff_measurable rho R).complex_ofReal.mul hPoly

/-- The continuous-representative main product-rule gradient is measurable. -/
lemma centeredCube3RadialCutoffMainGradientFunction_measurable
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    Measurable
      (centeredCube3RadialCutoffMainGradientFunction rho R index f j) := by
  have hPoly :
      Measurable
        (fun y : CenteredCube3 =>
          torus3FourierPartialContinuousPolynomial index f j
            (unitTorus3CenteredEquiv.symm y)) := by
    exact
      (torus3FourierPartialContinuousPolynomial index f j).continuous.measurable.comp
        unitTorus3CenteredEquiv.symm.measurable
  unfold centeredCube3RadialCutoffMainGradientFunction
  exact
    (centeredCube3RadialCutoff_measurable rho R).complex_ofReal.mul hPoly

/-- The cutoff-derivative product-rule gradient is measurable. -/
lemma centeredCube3RadialCutoffCutoffGradientFunction_measurable
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    Measurable
      (centeredCube3RadialCutoffCutoffGradientFunction rho R index f j) := by
  have hPoly :
      Measurable
        (fun y : CenteredCube3 =>
          torus3FourierContinuousPolynomial index f
            (unitTorus3CenteredEquiv.symm y)) := by
    exact
      (torus3FourierContinuousPolynomial index f).continuous.measurable.comp
        unitTorus3CenteredEquiv.symm.measurable
  unfold centeredCube3RadialCutoffCutoffGradientFunction
  exact
    (centeredCube3RadialCutoffPartial_measurable rho R j).complex_ofReal.mul
      hPoly

/-- Hence the full pointwise product-rule gradient is measurable. -/
lemma centeredCube3RadialCutoffRawGradientFunction_measurable
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    Measurable
      (centeredCube3RadialCutoffRawGradientFunction rho R index f j) := by
  unfold centeredCube3RadialCutoffRawGradientFunction
  exact
    (centeredCube3RadialCutoffMainGradientFunction_measurable
      rho R index f j).add
    (centeredCube3RadialCutoffCutoffGradientFunction_measurable
      rho R index f j)

/-- Measurability passes through the zero extension from the measurable centered
cube subtype to ambient `R^3`. -/
lemma centeredCube3ZeroExtension_measurable
    (g : CenteredCube3 → ℂ)
    (hg : Measurable g) :
    Measurable (centeredCube3ZeroExtension g) := by
  have hSetMeas :
      MeasurableSet
        {x : CenteredCube3Ambient |
          ∀ i : Fin 3,
            x i ∈ Set.Ioc
              (centeredCube3Base i)
              (centeredCube3Base i + 1)} := by
    simpa [centeredCube3AmbientSet] using
      centeredCube3AmbientSet_measurable
  have hEmbedding :
      MeasurableEmbedding
        (Subtype.val : CenteredCube3 → CenteredCube3Ambient) := by
    exact MeasurableEmbedding.subtype_coe hSetMeas
  unfold centeredCube3ZeroExtension
  exact hEmbedding.measurable_extend hg measurable_const

/-- A single coordinate of the regularized Hardy field has square bounded by the
full regularized Hardy weight. -/
lemma hardyRegularizedFieldComponent_sq_le_weight
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    (hardyRegularizedFieldComponent eps j x) ^ 2 ≤
      hardyRegularizedWeight eps x := by
  have hSingle :
      (hardyRegularizedFieldComponent eps j x) ^ 2 ≤
        ∑ k : Fin 3, (hardyRegularizedField eps x k) ^ 2 := by
    classical
    change
      (hardyRegularizedField eps x j) ^ 2 ≤
        ∑ k : Fin 3, (hardyRegularizedField eps x k) ^ 2
    exact
      Finset.single_le_sum
        (fun k hk => sq_nonneg (hardyRegularizedField eps x k))
        (Finset.mem_univ j)
  calc
    (hardyRegularizedFieldComponent eps j x) ^ 2
        ≤ ∑ k : Fin 3, (hardyRegularizedField eps x k) ^ 2 := hSingle
    _ = hardyRegularizedFieldNormSq eps x :=
      hardyRegularizedField_sum_sq heps x
    _ ≤ hardyRegularizedWeight eps x :=
      hardyRegularizedFieldNormSq_le_weight heps x

/-- The complex integrand appearing in the coordinatewise Hardy integration by
parts identity. -/
noncomputable def hardyRegularizedComplexCrossTerm
    (eps : ℝ)
    (j : Fin 3)
    (u v : CenteredCube3Ambient → ℂ)
    (x : CenteredCube3Ambient) : ℂ :=
  (hardyRegularizedFieldComponent eps j x : ℂ) *
    (starRingEnd ℂ) (u x) * v x

/-- Pointwise Young inequality for the regularized Hardy cross term.  The field
factor is absorbed by the regularized weighted energy. -/
lemma hardyRegularizedComplexCrossTerm_norm_le
    {eps : ℝ}
    (heps : 0 < eps)
    (j : Fin 3)
    (u v : CenteredCube3Ambient → ℂ)
    (x : CenteredCube3Ambient) :
    ‖hardyRegularizedComplexCrossTerm eps j u v x‖ ≤
      (hardyRegularizedWeight eps x * ‖u x‖ ^ 2 + ‖v x‖ ^ 2) / 2 := by
  let F : ℝ := hardyRegularizedFieldComponent eps j x
  let a : ℝ := ‖u x‖
  let b : ℝ := ‖v x‖
  have hF2 : F ^ 2 ≤ hardyRegularizedWeight eps x := by
    dsimp [F]
    exact hardyRegularizedFieldComponent_sq_le_weight heps x j
  have hF2a2 :
      F ^ 2 * a ^ 2 ≤ hardyRegularizedWeight eps x * a ^ 2 :=
    mul_le_mul_of_nonneg_right hF2 (sq_nonneg a)
  have hYoung0 : 0 ≤ (|F| * a - b) ^ 2 := sq_nonneg _
  have hAbsSq : |F| ^ 2 = F ^ 2 := sq_abs F
  have hYoung :
      2 * (|F| * a * b) ≤ F ^ 2 * a ^ 2 + b ^ 2 := by
    nlinarith [hYoung0, hAbsSq]
  have hNorm :
      ‖hardyRegularizedComplexCrossTerm eps j u v x‖ = |F| * a * b := by
    dsimp [F, a, b]
    simp [hardyRegularizedComplexCrossTerm, norm_mul, Real.norm_eq_abs]
  rw [hNorm]
  dsimp [a, b] at hF2a2 hYoung ⊢
  nlinarith

/-- If the wave is measurable with finite regularized energy and the candidate
gradient is measurable and square integrable, then the complex Hardy cross term
is integrable. -/
lemma hardyRegularizedComplexCrossTerm_integrable
    {eps : ℝ}
    (heps : 0 < eps)
    (j : Fin 3)
    (u v : CenteredCube3Ambient → ℂ)
    (huMeas : Measurable u)
    (hvMeas : Measurable v)
    (huWeighted : MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedWeight eps x * ‖u x‖ ^ 2)
      MeasureTheory.volume)
    (hvSq : MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient => ‖v x‖ ^ 2)
      MeasureTheory.volume) :
    MeasureTheory.Integrable
      (hardyRegularizedComplexCrossTerm eps j u v)
      MeasureTheory.volume := by
  have hMajor :
      MeasureTheory.Integrable
        (fun x : CenteredCube3Ambient =>
          (hardyRegularizedWeight eps x * ‖u x‖ ^ 2 + ‖v x‖ ^ 2) / 2)
        MeasureTheory.volume :=
    (huWeighted.add hvSq).div_const 2
  have hFieldRealMeas :
      Measurable
        (fun x : CenteredCube3Ambient =>
          hardyRegularizedFieldComponent eps j x) := by
    unfold hardyRegularizedFieldComponent hardyRegularizedDenominator
    unfold centeredCube3AmbientRadiusSq
    measurability
  have hFieldComplexMeas :
      Measurable
        (fun x : CenteredCube3Ambient =>
          (hardyRegularizedFieldComponent eps j x : ℂ)) :=
    hFieldRealMeas.complex_ofReal
  have hStarMeas :
      Measurable
        (fun x : CenteredCube3Ambient => (starRingEnd ℂ) (u x)) := by
    simpa [Function.comp_def] using
      (continuous_star.measurable.comp huMeas)
  have hCrossMeas :
      MeasureTheory.AEStronglyMeasurable
        (hardyRegularizedComplexCrossTerm eps j u v)
        MeasureTheory.volume := by
    apply Measurable.aestronglyMeasurable
    unfold hardyRegularizedComplexCrossTerm
    exact (hFieldComplexMeas.mul hStarMeas).mul hvMeas
  apply MeasureTheory.Integrable.mono' hMajor hCrossMeas
  filter_upwards with x
  exact hardyRegularizedComplexCrossTerm_norm_le heps j u v x

/-- The actual cutoff wave and raw product-rule gradient satisfy the integrability
hypothesis needed for the `j`-th regularized integration-by-parts term. -/
lemma centeredCube3RadialCutoff_regularizedCrossTerm_integrable
    {α : Type}
    [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (heps : 0 < eps)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    MeasureTheory.Integrable
      (hardyRegularizedComplexCrossTerm eps j
        (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
        (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j))
      MeasureTheory.volume := by
  have huMeas :
      Measurable
        (centeredCube3RadialCutoffWaveZeroExtension rho R index f) := by
    change
      Measurable
        (centeredCube3ZeroExtension
          (centeredCube3RadialCutoffWaveFunction rho R index f))
    exact
      centeredCube3ZeroExtension_measurable
        (centeredCube3RadialCutoffWaveFunction rho R index f)
        (centeredCube3RadialCutoffWaveFunction_measurable rho R index f)
  have hvMeas :
      Measurable
        (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) := by
    change
      Measurable
        (centeredCube3ZeroExtension
          (centeredCube3RadialCutoffRawGradientFunction rho R index f j))
    exact
      centeredCube3ZeroExtension_measurable
        (centeredCube3RadialCutoffRawGradientFunction rho R index f j)
        (centeredCube3RadialCutoffRawGradientFunction_measurable
          rho R index f j)
  exact
    hardyRegularizedComplexCrossTerm_integrable
      heps j
      (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
      (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j)
      huMeas hvMeas
      (centeredCube3RadialCutoffWaveZeroExtension_regularized_integrable
        heps hRhoR index f)
      (centeredCube3RadialCutoffRawGradientZeroExtension_sq_integrable
        hrho hRhoR index f j)

/-!
## Ninety-eighth milestone

The ambient cutoff wave and each explicit raw product-rule gradient component
now have genuine measurable `L²` representatives.  Moreover, for every positive
regularization parameter `eps`, each complex cross term

`F_{eps,j} * conj(u) * partial_j u`

is integrable.  The proof uses the pointwise estimate

`|F_j u v| <= (w_eps |u|^2 + |v|^2) / 2`,

which follows from `F_j^2 <= w_eps` and the elementary Young inequality.  Thus
all terms in the regularized Hardy integration-by-parts identity are now finite;
the remaining analytic issue is to justify that the zero-extended raw gradient
is the weak/coordinate derivative of the piecewise-linear cutoff wave.
-/

end

end PlaneWaveCertificate

