/-- Reuse the canonical `UnitAddCircle` measure instance used by `mFourierLp`. -/
local instance unitAddCircleMeasureSpaceForFourier88 :
    MeasureTheory.MeasureSpace UnitAddCircle :=
  instMeasureSpaceUnitAddCircle

/-! ## Eighty-eighth milestone: reduce localized integrability to scalar `1 / r` integrability -/

/--
The genuine continuous finite Fourier polynomial whose `L²` class is
`torus3FourierPolynomial`.  Introducing this representative makes the uniform
pointwise bound on a finite Fourier sum available without choosing a special
representative of an `Lp` class.
-/
noncomputable def torus3FourierContinuousPolynomial
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) : C(UnitTorus3, ℂ) :=
  ∑ p : α,
    f p • UnitAddTorus.mFourier (index p)

/-- The canonical `Lp` representative agrees a.e. with the continuous Fourier sum.

This is proved directly from `UnitAddTorus.coeFn_mFourierLp`, together with the
`Lp` coercion lemmas for finite sums and scalar multiplication. -/
lemma torus3FourierPolynomial_eq_continuous_ae
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    ∀ᵐ x : UnitTorus3 ∂MeasureTheory.volume,
      torus3FourierPolynomial index f x
        =
      torus3FourierContinuousPolynomial index f x := by
  classical
  unfold torus3FourierPolynomial
  unfold torus3FourierContinuousPolynomial

  have hSum :
      ∀ᵐ x : UnitTorus3 ∂MeasureTheory.volume,
        (∑ p : α,
            f p • UnitAddTorus.mFourierLp 2 (index p)) x
          =
        ∑ p : α,
          (f p • UnitAddTorus.mFourierLp 2 (index p)) x := by
    have hRaw :=
      MeasureTheory.Lp.coeFn_finsetSum
        (Finset.univ : Finset α)
        (fun p : α =>
          f p • UnitAddTorus.mFourierLp 2 (index p))
    filter_upwards [hRaw] with x hx
    simpa only [Finset.sum_apply] using hx

  have hTerms :
      ∀ᵐ x : UnitTorus3 ∂MeasureTheory.volume,
        ∀ p : α,
          (f p • UnitAddTorus.mFourierLp 2 (index p)) x
            =
          (f p • UnitAddTorus.mFourier (index p)) x := by
    rw [Filter.eventually_all]
    intro p
    have hsmul :=
      MeasureTheory.Lp.coeFn_smul
        (f p) (UnitAddTorus.mFourierLp 2 (index p))
    have hmono :=
      UnitAddTorus.coeFn_mFourierLp 2 (index p)
    filter_upwards [hsmul, hmono] with x hs hm
    rw [hs]
    change
      f p * (UnitAddTorus.mFourierLp 2 (index p) x) =
        f p * (UnitAddTorus.mFourier (index p) x)
    rw [hm]

  filter_upwards [hSum, hTerms] with x hsum hterms

  calc
    (∑ p : α, f p • UnitAddTorus.mFourierLp 2 (index p)) x
        =
      ∑ p : α,
        (f p • UnitAddTorus.mFourierLp 2 (index p)) x := hsum
    _ =
      ∑ p : α,
        (f p • UnitAddTorus.mFourier (index p)) x := by
          apply Finset.sum_congr rfl
          intro p hp
          exact hterms p
    _ =
      (∑ p : α, f p • UnitAddTorus.mFourier (index p)) x := by
          exact
            (ContinuousMap.sum_apply
              (Finset.univ : Finset α)
              (fun p : α =>
                f p • UnitAddTorus.mFourier (index p))
              x).symm

/-- The finite coefficient `ℓ¹` norm used for the elementary sup-norm bound. -/
noncomputable def finiteSupportL1Norm
    {α : Type}
    [Fintype α]
    (f : α → ℂ) : ℝ :=
  ∑ p : α, ‖f p‖

lemma finiteSupportL1Norm_nonneg
    {α : Type}
    [Fintype α]
    (f : α → ℂ) :
    0 ≤ finiteSupportL1Norm f := by
  unfold finiteSupportL1Norm
  exact Finset.sum_nonneg (fun p hp => norm_nonneg _)

/-- The continuous finite Fourier polynomial has sup norm at most the coefficient `ℓ¹` norm. -/
lemma torus3FourierContinuousPolynomial_norm_le_l1
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ) :
    ‖torus3FourierContinuousPolynomial index f‖
      ≤ finiteSupportL1Norm f := by
  unfold torus3FourierContinuousPolynomial
  unfold finiteSupportL1Norm
  calc
    ‖∑ p : α, f p • UnitAddTorus.mFourier (index p)‖
        ≤
      ∑ p : α, ‖f p • UnitAddTorus.mFourier (index p)‖ :=
        norm_sum_le Finset.univ _
    _ = ∑ p : α, ‖f p‖ := by
      apply Finset.sum_congr rfl
      intro p hp
      rw [norm_smul]
      rw [UnitAddTorus.mFourier_norm]
      simp

/-- Pointwise version of the finite Fourier `ℓ¹` bound. -/
lemma torus3FourierContinuousPolynomial_pointwise_norm_le_l1
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : UnitTorus3) :
    ‖torus3FourierContinuousPolynomial index f x‖
      ≤ finiteSupportL1Norm f := by
  exact le_trans
    (ContinuousMap.norm_coe_le_norm
      (torus3FourierContinuousPolynomial index f) x)
    (torus3FourierContinuousPolynomial_norm_le_l1 index f)

/--
A pointwise localized function using the continuous representative of the finite
Fourier polynomial.  It agrees a.e. with
`centeredCube3RadialCutoffLocalizedFunction`.
-/
noncomputable def centeredCube3RadialCutoffLocalizedContinuousFunction
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (y : CenteredCube3) : ℂ :=
  (centeredCube3InverseRadius y : ℂ) *
    (centeredCube3RadialCutoff rho R y : ℂ) *
    torus3FourierContinuousPolynomial index f
      (unitTorus3CenteredEquiv.symm y)

lemma centeredCube3RadialCutoffLocalizedContinuousFunction_aestronglyMeasurable
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ) :
    MeasureTheory.AEStronglyMeasurable
      (centeredCube3RadialCutoffLocalizedContinuousFunction
        rho R index f)
      centeredCube3Measure := by

  have hPoly :
      Measurable
        (fun y : CenteredCube3 =>
          torus3FourierContinuousPolynomial index f
            (unitTorus3CenteredEquiv.symm y)) := by
    exact
      (torus3FourierContinuousPolynomial index f).continuous.measurable.comp
        unitTorus3CenteredEquiv.symm.measurable

  have hMeas :
      Measurable
        (centeredCube3RadialCutoffLocalizedContinuousFunction
          rho R index f) := by
    unfold centeredCube3RadialCutoffLocalizedContinuousFunction
    exact
      (centeredCube3InverseRadius_measurable.complex_ofReal.mul
        (centeredCube3RadialCutoff_measurable rho R).complex_ofReal).mul
          hPoly

  exact hMeas.aestronglyMeasurable

/-- The `Lp` representative and continuous representative give the same localized function a.e. -/
lemma centeredCube3RadialCutoffLocalizedFunction_eq_continuous_ae
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ) :
    centeredCube3RadialCutoffLocalizedFunction rho R index f
      =ᵐ[centeredCube3Measure]
    centeredCube3RadialCutoffLocalizedContinuousFunction rho R index f := by

  have hTorus :=
    torus3FourierPolynomial_eq_continuous_ae index f

  have hPulled :
      ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
        torus3FourierPolynomial index f
            (unitTorus3CenteredEquiv.symm y)
          =
        torus3FourierContinuousPolynomial index f
            (unitTorus3CenteredEquiv.symm y) :=
    unitTorus3CenteredEquiv_symm_measurePreserving.quasiMeasurePreserving.ae
      hTorus

  filter_upwards [hPulled] with y hy
  unfold centeredCube3RadialCutoffLocalizedFunction
  unfold centeredCube3RadialCutoffLocalizedContinuousFunction
  rw [hy]

/--
If the scalar inverse-radius function belongs to `L²` on the centered cube,
then every finite-Fourier localized cutoff function belongs to `L²`.

The proof uses only the finite Fourier `ℓ¹` bound and `0 ≤ chi ≤ 1`.
-/
lemma centeredCube3RadialCutoffLocalizedFunction_memLp_of_inverseRadius_memLp
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (hInverse :
      MeasureTheory.MemLp
        (fun y : CenteredCube3 =>
          (centeredCube3InverseRadius y : ℂ))
        2 centeredCube3Measure)
    (index : α → Lattice3)
    (f : α → ℂ) :
    MeasureTheory.MemLp
      (centeredCube3RadialCutoffLocalizedFunction rho R index f)
      2 centeredCube3Measure := by

  let C : ℝ := finiteSupportL1Norm f

  have hC0 : 0 ≤ C := by
    dsimp [C]
    exact finiteSupportL1Norm_nonneg f

  have hScaled :
      MeasureTheory.MemLp
        (fun y : CenteredCube3 =>
          (C : ℂ) * (centeredCube3InverseRadius y : ℂ))
        2 centeredCube3Measure := by
    exact hInverse.const_mul (C : ℂ)

  have hRawMeas :
      MeasureTheory.AEStronglyMeasurable
        (centeredCube3RadialCutoffLocalizedContinuousFunction
          rho R index f)
        centeredCube3Measure :=
    centeredCube3RadialCutoffLocalizedContinuousFunction_aestronglyMeasurable
      rho R index f

  have hDom :
      ∀ y : CenteredCube3,
        ‖centeredCube3RadialCutoffLocalizedContinuousFunction
            rho R index f y‖
          ≤
        ‖(C : ℂ) * (centeredCube3InverseRadius y : ℂ)‖ := by
    intro y

    have hInv0 : 0 ≤ centeredCube3InverseRadius y := by
      rw [centeredCube3InverseRadius_eq_one_div_radius]
      exact one_div_nonneg.mpr (centeredCube3Radius_nonneg y)

    have hCut0 : 0 ≤ centeredCube3RadialCutoff rho R y :=
      centeredCube3RadialCutoff_nonneg hRhoR y

    have hCut1 : centeredCube3RadialCutoff rho R y ≤ 1 :=
      centeredCube3RadialCutoff_le_one hRhoR y

    have hPoly :
        ‖torus3FourierContinuousPolynomial index f
            (unitTorus3CenteredEquiv.symm y)‖ ≤ C := by
      dsimp [C]
      exact
        torus3FourierContinuousPolynomial_pointwise_norm_le_l1
          index f (unitTorus3CenteredEquiv.symm y)

    have hCutPoly :
        centeredCube3RadialCutoff rho R y *
            ‖torus3FourierContinuousPolynomial index f
              (unitTorus3CenteredEquiv.symm y)‖
          ≤ C := by
      calc
        centeredCube3RadialCutoff rho R y *
            ‖torus3FourierContinuousPolynomial index f
              (unitTorus3CenteredEquiv.symm y)‖
            ≤
          1 *
            ‖torus3FourierContinuousPolynomial index f
              (unitTorus3CenteredEquiv.symm y)‖ :=
            mul_le_mul_of_nonneg_right hCut1 (norm_nonneg _)
        _ ≤ 1 * C := by
          exact mul_le_mul_of_nonneg_left hPoly (by norm_num)
        _ = C := by ring

    have hAll :
        centeredCube3InverseRadius y *
            (centeredCube3RadialCutoff rho R y *
              ‖torus3FourierContinuousPolynomial index f
                (unitTorus3CenteredEquiv.symm y)‖)
          ≤
        centeredCube3InverseRadius y * C :=
      mul_le_mul_of_nonneg_left hCutPoly hInv0

    unfold centeredCube3RadialCutoffLocalizedContinuousFunction
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    rw [abs_of_nonneg hInv0]
    rw [abs_of_nonneg hCut0]
    rw [abs_of_nonneg hC0]
    simpa [mul_assoc, mul_comm, mul_left_comm] using hAll

  have hRaw :
      MeasureTheory.MemLp
        (centeredCube3RadialCutoffLocalizedContinuousFunction
          rho R index f)
        2 centeredCube3Measure :=
    hScaled.of_le hRawMeas (Filter.Eventually.of_forall hDom)

  have hEq :=
    centeredCube3RadialCutoffLocalizedFunction_eq_continuous_ae
      rho R index f

  exact (MeasureTheory.memLp_congr_ae hEq).2 hRaw

/--
Milestone-87 data with the per-polynomial integrability assumption replaced by
one scalar geometric fact: `1 / |y| ∈ L²` on the centered three-cube.

The Hardy field is quantified over an `L²` witness only to avoid making its
statement depend on the definitional identity of proof terms; proof
irrelevance means this carries no additional mathematical content.
-/
structure CenteredCube3RadialCutoffInverseRadiusHardyData
    (rho R : ℝ) where

  rho_pos : 0 < rho
  rho_lt_outer : rho < R
  outer_lt_half : R < (1 / 2 : ℝ)

  inverseRadius_memLp :
    MeasureTheory.MemLp
      (fun y : CenteredCube3 =>
        (centeredCube3InverseRadius y : ℂ))
      2 centeredCube3Measure

  hardy_norm_sq_le_explicit_gradient :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ∀ hMem :
            MeasureTheory.MemLp
              (centeredCube3RadialCutoffLocalizedFunction
                rho R index f)
              2 centeredCube3Measure,
            ‖hMem.toLp
                (centeredCube3RadialCutoffLocalizedFunction
                  rho R index f)‖ ^ 2
              ≤
            4 *
              (∑ j : Fin 3,
                ‖centeredCube3RadialCutoffMainGradientState
                      rho R rho_lt_outer index f j +
                    centeredCube3RadialCutoffGradientState
                      rho R rho_pos rho_lt_outer index f j‖ ^ 2)

/-- The scalar inverse-radius data canonically supply milestone 87's raw Hardy data. -/
theorem
    CenteredCube3RadialCutoffInverseRadiusHardyData.toRawHardyData
    {rho R : ℝ}
    (data : CenteredCube3RadialCutoffInverseRadiusHardyData rho R) :
    CenteredCube3RadialCutoffRawHardyData rho R where

  rho_pos := data.rho_pos
  rho_lt_outer := data.rho_lt_outer
  outer_lt_half := data.outer_lt_half

  localized_memLp :=
    fun α _ index f =>
      centeredCube3RadialCutoffLocalizedFunction_memLp_of_inverseRadius_memLp
        data.rho_lt_outer data.inverseRadius_memLp index f

  hardy_norm_sq_le_explicit_gradient := by
    intro α inst index hInjective f
    exact
      data.hardy_norm_sq_le_explicit_gradient
        α index hInjective f
        (centeredCube3RadialCutoffLocalizedFunction_memLp_of_inverseRadius_memLp
          data.rho_lt_outer data.inverseRadius_memLp index f)

/-!
Milestone 88 removes the family of `localized_memLp` hypotheses from milestone
87.  Finite Fourier polynomials are represented by an explicit continuous
finite sum, uniformly bounded by the coefficient `ℓ¹` norm.  Hence the only
integrability input is the scalar three-dimensional fact

`(y ↦ 1 / |y|) ∈ L²(centeredCube3)`.

The next milestone can prove this single scalar fact directly from Mathlib's
finite-dimensional local-integrability theorem for negative powers of the
norm.  After that, only the actual Euclidean Hardy inequality / weak-gradient
