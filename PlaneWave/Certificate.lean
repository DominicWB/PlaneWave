/-! ## One-hundred-eleventh milestone: the unsplit finite operator and its symmetry

The low-pass kernel contains an auxiliary output/input mask.  We first prove
that the masked entries already have zero low-transfer weight.  Thus the sum of
the low and high kernels is exactly the unsplit Coulomb kernel, not merely
bounded by it.  We then prove symmetry of the existing kernel lifts and state
the BO certificate for their explicitly constructed unsplit sum.

Scope: this is the same two selected one-body register terms used in milestone
110.  It is not identified here with a full signed many-electron Hamiltonian.
The background periodic-remainder bound, H2 estimate, and spectral/Galerkin
hypotheses remain explicit.  No background theorem is added as an axiom.
-/

/-- The squared-norm inequality sufficient for the half-cutoff separation.
Coordinatewise its slack is `(a_i - 2*b_i)^2`. -/
lemma latticeNormSq_le_two_mul_sub_add
    (a b : Lattice3) :
    latticeNormSq a ≤ 2 * (latticeNormSq (latticeSub a b) + latticeNormSq b) := by
  have h0 := sq_nonneg ((a (0 : Fin 3) : ℝ) - 2 * (b (0 : Fin 3) : ℝ))
  have h1 := sq_nonneg ((a (1 : Fin 3) : ℝ) - 2 * (b (1 : Fin 3) : ℝ))
  have h2 := sq_nonneg ((a (2 : Fin 3) : ℝ) - 2 * (b (2 : Fin 3) : ℝ))
  unfold latticeNormSq latticeSub
  push_cast
  nlinarith only [h0, h1, h2]

/-- An output above K and an input at most K/2 necessarily have transfer above
K/2.  The proof includes equality on the input/transfer cutoff boundaries. -/
lemma finitePlaneWaveTransfer_isAboveHalfCutoff_of_mask
    (K g : ℝ) (count : ℕ)
    (hK : 0 ≤ K) (hg : 0 ≤ g)
    (v u : FinitePlaneWaveMode count)
    (hv : K < finitePlaneWaveKabs g count v)
    (hu : ¬ K / 2 < finitePlaneWaveKabs g count u) :
    IsAboveHalfCutoff K g (finitePlaneWaveTransfer count v u) := by
  have hu0 := finitePlaneWaveKabs_nonneg g count hg u
  have huLe : finitePlaneWaveKabs g count u ≤ K / 2 := le_of_not_gt hu
  have huSq : (finitePlaneWaveKabs g count u) ^ 2 ≤ (K / 2) ^ 2 :=
    sq_le_sq_of_nonneg hu0 huLe
  have hGeom : (finitePlaneWaveKabs g count v) ^ 2 ≤
      2 * (g ^ 2 * latticeNormSq (finitePlaneWaveTransfer count v u) +
        (finitePlaneWaveKabs g count u) ^ 2) := by
    rw [finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq g count v,
      finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq g count u]
    calc
      g ^ 2 * latticeNormSq (finitePlaneWaveLatticeIndex count v) ≤
          g ^ 2 * (2 *
            (latticeNormSq (finitePlaneWaveTransfer count v u) +
              latticeNormSq (finitePlaneWaveLatticeIndex count u))) :=
        mul_le_mul_of_nonneg_left
          (latticeNormSq_le_two_mul_sub_add
            (finitePlaneWaveLatticeIndex count v)
            (finitePlaneWaveLatticeIndex count u)) (sq_nonneg g)
      _ = _ := by ring
  have hStrictProduct : 0 <
      (finitePlaneWaveKabs g count v - K) *
        (finitePlaneWaveKabs g count v + K) := by
    apply mul_pos (sub_pos.mpr hv)
    linarith only [hK, hv]
  unfold IsAboveHalfCutoff
  by_contra hNot
  have hTransferLe :
      g ^ 2 * latticeNormSq (finitePlaneWaveTransfer count v u) ≤ (K / 2) ^ 2 :=
    le_of_not_gt hNot
  nlinarith only [huSq, hGeom, hStrictProduct, hTransferLe]

/-- The extra reference-tail mask changes no coefficient of the low-pass kernel.
No assumption on the sign of C is needed for this exact identity. -/
lemma finiteLowPassCoulombKernel_eq_unmasked
    (K g C : ℝ) (count : ℕ)
    (hK : 0 ≤ K) (hg : 0 ≤ g)
    (v u : FinitePlaneWaveMode count) :
    finiteLowPassCoulombKernel K g C count v u =
      (Real.sqrt (finitePlaneWaveLowPassDifferenceSquareWeight K g C count v u) : ℂ) := by
  classical
  change
    (if K < finitePlaneWaveKabs g count v ∧
        ¬ K / 2 < finitePlaneWaveKabs g count u then (0 : ℂ)
      else (Real.sqrt
        (finitePlaneWaveLowPassDifferenceSquareWeight K g C count v u) : ℂ)) = _
  by_cases hMask : K < finitePlaneWaveKabs g count v ∧
      ¬ K / 2 < finitePlaneWaveKabs g count u
  · rw [if_pos hMask]
    have hHigh := finitePlaneWaveTransfer_isAboveHalfCutoff_of_mask
      K g count hK hg v u hMask.1 hMask.2
    simp only [finitePlaneWaveLowPassDifferenceSquareWeight,
      lowPassCoulombPointWeight, if_pos hHigh, Real.sqrt_zero, Complex.ofReal_zero]
  · rw [if_neg hMask]

/-- Low plus high is the full positive Coulomb amplitude at every matrix entry,
including zero transfer and the half-cutoff boundary. -/
lemma finiteLowHighCoulombKernel_eq_full
    (K g C : ℝ) (count : ℕ)
    (hK : 0 ≤ K) (hg : 0 ≤ g)
    (v u : FinitePlaneWaveMode count) :
    finiteLowPassCoulombKernel K g C count v u +
        finiteHighPassCoulombKernel K g C count v u =
      finiteCoulombKernel C count v u := by
  classical
  rw [finiteLowPassCoulombKernel_eq_unmasked K g C count hK hg v u]
  unfold finitePlaneWaveLowPassDifferenceSquareWeight lowPassCoulombPointWeight
    finiteHighPassCoulombKernel finitePlaneWaveDifferenceCoulombSquareWeight
    finiteCoulombKernel finiteCoulombDifferenceSquareWeight
  by_cases hHigh : IsAboveHalfCutoff K g (finitePlaneWaveTransfer count v u)
  · simp [hHigh]
  · simp [hHigh]

/-- Exact reassembly at the operator level.  Unlike the earlier domination bound,
this identifies the sum with an operator having no K-dependent mask. -/
lemma referenceLowHighCoulombOperator_eq_full
    {eta : ℕ} (r : Fin eta)
    (K g C : ℝ) (count : ℕ) (hK : 0 ≤ K) (hg : 0 ≤ g) :
    referenceKernelConvolutionOperator r (finiteCoulombKernel C count) =
      referenceKernelConvolutionOperator r (finiteLowPassCoulombKernel K g C count) +
        explicitHighPassCoulombOperator eta r K g C count := by
  have hKernel :
      (fun v u : FinitePlaneWaveMode count =>
        finiteLowPassCoulombKernel K g C count v u +
          finiteHighPassCoulombKernel K g C count v u) =
      finiteCoulombKernel C count := by
    funext v u
    exact finiteLowHighCoulombKernel_eq_full K g C count hK hg v u
  calc
    referenceKernelConvolutionOperator r (finiteCoulombKernel C count) =
        referenceKernelConvolutionOperator r
          (fun v u => finiteLowPassCoulombKernel K g C count v u +
            finiteHighPassCoulombKernel K g C count v u) :=
      congrArg (referenceKernelConvolutionOperator r) hKernel.symm
    _ = _ := referenceKernelConvolutionOperator_add_kernel r _ _

/-- Reversing a lattice transfer does not change its squared Euclidean norm. -/
lemma latticeNormSq_sub_swap (a b : Lattice3) :
    latticeNormSq (latticeSub a b) = latticeNormSq (latticeSub b a) := by
  unfold latticeNormSq latticeSub
  push_cast
  ring

lemma finiteCoulombKernel_swap
    (C : ℝ) (count : ℕ) (v u : FinitePlaneWaveMode count) :
    finiteCoulombKernel C count v u = finiteCoulombKernel C count u v := by
  unfold finiteCoulombKernel finiteCoulombDifferenceSquareWeight
    latticeCoulombSquareWeight finitePlaneWaveTransfer
  rw [latticeNormSq_sub_swap]

/-- The actual positive Coulomb kernel satisfies the complex Hermitian condition,
not merely symmetry of its entrywise magnitudes. -/
lemma finiteCoulombKernel_conj_swap
    (C : ℝ) (count : ℕ) (v u : FinitePlaneWaveMode count) :
    (starRingEnd ℂ) (finiteCoulombKernel C count v u) =
      finiteCoulombKernel C count u v := by
  calc
    (starRingEnd ℂ) (finiteCoulombKernel C count v u) =
        finiteCoulombKernel C count v u := by simp [finiteCoulombKernel]
    _ = _ := finiteCoulombKernel_swap C count v u

/-- A finite coefficient action with a Hermitian kernel is symmetric.  The
hypothesis allows complex entries; signs and phases are not discarded. -/
lemma coefficientKernelAction_isSymmetric
    {ι : Type*} [Fintype ι]
    (A : EuclideanSpace ℂ ι →ₗ[ℂ] EuclideanSpace ℂ ι)
    (kernel : ι → ι → ℂ)
    (hApply : ∀ (u : EuclideanSpace ℂ ι) (q : ι),
      (A u).ofLp q = ∑ p : ι, u.ofLp p * kernel q p)
    (hHermitian : ∀ q p : ι, (starRingEnd ℂ) (kernel q p) = kernel p q) :
    A.IsSymmetric := by
  classical
  intro u v
  rw [PiLp.inner_apply, PiLp.inner_apply]
  simp_rw [hApply, sum_inner, inner_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro p hp
  apply Finset.sum_congr rfl
  intro q hq
  rw [RCLike.inner_apply, RCLike.inner_apply, map_mul, hHermitian q p]
  ring

/-- The reference-coordinate lift preserves the Hermitian kernel condition. -/
lemma referenceKernelConvolutionOperator_isSymmetric_of_conj
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (r : Fin eta) (kernel : μ → μ → ℂ)
    (hHermitian : ∀ q p : μ,
      (starRingEnd ℂ) (kernel q p) = kernel p q) :
    (referenceKernelConvolutionOperator r kernel).IsSymmetric := by
  classical
  apply coefficientKernelAction_isSymmetric
    (referenceKernelConvolutionOperator r kernel)
    (referenceConfigurationKernel r kernel)
    (referenceKernelConvolutionOperator_apply r kernel)
  intro q p
  by_cases hOuter : outerConfigOf r q = outerConfigOf r p
  · rw [referenceConfigurationKernel_of_outer_eq r kernel q p hOuter,
      referenceConfigurationKernel_of_outer_eq r kernel p q hOuter.symm]
    exact hHermitian (q r) (p r)
  · simp only [referenceConfigurationKernel_of_outer_ne r kernel q p hOuter,
      referenceConfigurationKernel_of_outer_ne r kernel p q (Ne.symm hOuter), map_zero]

