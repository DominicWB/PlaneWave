section DevU7

/-!
# Dynamics: the smooth observable on the Fourier side

The observable `O = χ(x_a)` of `thm:dyn` acts on Fourier coefficients as a convolution in the
momentum of register `a`: `(O c)(q) = Σ_ν χ̂(ν) c(q + ν e_a)`. This section builds these
convolution operators on `ℓ²` from register translations and proves what the dynamical
estimate uses: the norm bound, the symmetry for a real `χ`, the commutation with the tails of
the other registers, the tail of a multiplied state (`lem:chitail`), and the commutator with
the kinetic energy (the `D_χ` part of `lem:smear`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveDynamics

open PlaneWaveCertificate

/-! ## Reindexing `ℓ²` along a bijection -/

section Reindex

variable {ι : Type*}

lemma memℓp_two_of_summable_sq (f : ι → ℂ) (h : Summable fun i => ‖f i‖ ^ 2) : Memℓp f 2 := by
  apply memℓp_gen
  have e : (fun i => ‖f i‖ ^ (2 : ℝ≥0∞).toReal) = fun i => ‖f i‖ ^ 2 := by
    funext i
    rw [show (2 : ℝ≥0∞).toReal = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
  rw [e]
  exact h

/-- The coefficients `c ∘ e` of a reindexed `ℓ²` sequence. -/
noncomputable def lpReindexFun (e : ι ≃ ι) (c : ℓ²(ι, ℂ)) : ℓ²(ι, ℂ) :=
  ⟨fun i => c (e i), memℓp_two_of_summable_sq _
    ((e.summable_iff (f := fun i => ‖c i‖ ^ 2)).mpr (l2_summable_sq c))⟩

lemma lpReindexFun_apply (e : ι ≃ ι) (c : ℓ²(ι, ℂ)) (i : ι) : lpReindexFun e c i = c (e i) := rfl

lemma norm_lpReindexFun (e : ι ≃ ι) (c : ℓ²(ι, ℂ)) : ‖lpReindexFun e c‖ = ‖c‖ := by
  have h : ‖lpReindexFun e c‖ ^ 2 = ‖c‖ ^ 2 := by
    rw [l2_norm_sq, l2_norm_sq]
    exact e.tsum_eq (fun i => ‖c i‖ ^ 2)
  exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h

/-- Reindexing as a linear map. -/
noncomputable def lpReindexₗ (e : ι ≃ ι) : ℓ²(ι, ℂ) →ₗ[ℂ] ℓ²(ι, ℂ) where
  toFun := lpReindexFun e
  map_add' a b := by
    ext i
    simp only [lpReindexFun_apply, lp.coeFn_add, Pi.add_apply]
  map_smul' z a := by
    ext i
    simp only [lpReindexFun_apply, lp.coeFn_smul, Pi.smul_apply, RingHom.id_apply]

/-- Reindexing `ℓ²` along a bijection is unitary. -/
noncomputable def lpReindex (e : ι ≃ ι) : ℓ²(ι, ℂ) ≃ₗᵢ[ℂ] ℓ²(ι, ℂ) where
  toFun := lpReindexFun e
  invFun := lpReindexFun e.symm
  map_add' := (lpReindexₗ e).map_add
  map_smul' := (lpReindexₗ e).map_smul
  left_inv a := by
    ext i
    change a (e (e.symm i)) = a i
    rw [e.apply_symm_apply]
  right_inv a := by
    ext i
    change a (e.symm (e i)) = a i
    rw [e.symm_apply_apply]
  norm_map' := norm_lpReindexFun e

@[simp] lemma lpReindex_apply (e : ι ≃ ι) (c : ℓ²(ι, ℂ)) (i : ι) : lpReindex e c i = c (e i) := rfl

end Reindex

/-! ## Register translations and convolution operators -/

section Convolution

variable {eta : ℕ}

/-- Translation `q ↦ q + ν e_a` of the momentum of register `a`. -/
def regShiftEquiv (a : Fin eta) (ν : Lattice3) :
    FourierConfig eta Lattice3 ≃ FourierConfig eta Lattice3 :=
  Equiv.addRight (Pi.single a ν)

/-- The register translation on `ℓ²`: `(shiftOp a ν c)(q) = c(q + ν e_a)`. -/
noncomputable def shiftOp (a : Fin eta) (ν : Lattice3) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  lpReindex (regShiftEquiv a ν)

lemma shiftOp_apply (a : Fin eta) (ν : Lattice3)
    (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (q : FourierConfig eta Lattice3) : shiftOp a ν c q = c (q + Pi.single a ν) := rfl

/-- The register translation as a bounded operator. -/
noncomputable def shiftCLM (a : Fin eta) (ν : Lattice3) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  (shiftOp a ν).toLinearIsometry.toContinuousLinearMap

lemma shiftCLM_apply (a : Fin eta) (ν : Lattice3)
    (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (q : FourierConfig eta Lattice3) : shiftCLM a ν c q = c (q + Pi.single a ν) := rfl

lemma norm_shiftCLM_le (a : Fin eta) (ν : Lattice3) : ‖shiftCLM (eta := eta) a ν‖ ≤ 1 :=
  (shiftOp a ν).toLinearIsometry.norm_toContinuousLinearMap_le

/-- The convolution operator `Σ_ν χ̂(ν) (translation by ν e_a)`; for a function `χ` on the torus
with absolutely summable Fourier coefficients `χ̂` it is the multiplication by `χ(x_a)` in the
physical Fourier coordinates of `physMap` (Fourier synthesis followed by the reflection
`x ↦ -x`; see `physMap_mulCLM`). -/
noncomputable def convOp (a : Fin eta) (χ : Lattice3 → ℂ) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  ∑' ν, χ ν • shiftCLM a ν

variable {χ : Lattice3 → ℂ}

lemma summable_convTerms (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖) :
    Summable fun ν => χ ν • shiftCLM (eta := eta) a ν :=
  Summable.of_norm_bounded hχ (fun ν => by
    rw [norm_smul]
    exact mul_le_of_le_one_right (norm_nonneg _) (norm_shiftCLM_le a ν))

lemma hasSum_convOp (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖) :
    HasSum (fun ν => χ ν • shiftCLM (eta := eta) a ν) (convOp a χ) :=
  (summable_convTerms a hχ).hasSum

/-- The coefficients of a convolution. -/
lemma convOp_apply (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖)
    (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (q : FourierConfig eta Lattice3) :
    convOp a χ c q = ∑' ν, χ ν * c (q + Pi.single a ν) := by
  have h := (hasSum_convOp a hχ).mapL
    ((lp.evalCLM ℂ (fun _ : FourierConfig eta Lattice3 => ℂ) 2 q).comp
      (ContinuousLinearMap.apply ℂ (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) c))
  exact h.tsum_eq.symm

lemma hasSum_convOp_apply (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖)
    (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    HasSum (fun ν => χ ν • shiftCLM a ν c) (convOp a χ c) :=
  (hasSum_convOp a hχ).mapL (ContinuousLinearMap.apply ℂ _ c)

/-- `‖O‖ ≤ Σ_ν |χ̂(ν)|`. -/
lemma norm_convOp_le (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖) :
    ‖convOp (eta := eta) a χ‖ ≤ ∑' ν, ‖χ ν‖ :=
  (hasSum_convOp a hχ).norm_le_of_bounded hχ.hasSum (fun ν => by
    rw [norm_smul]
    exact mul_le_of_le_one_right (norm_nonneg _) (norm_shiftCLM_le a ν))

lemma hasSum_convOp_eval (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖)
    (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (q : FourierConfig eta Lattice3) :
    HasSum (fun ν => χ ν * c (q + Pi.single a ν)) (convOp a χ c q) :=
  (hasSum_convOp a hχ).mapL
    ((lp.evalCLM ℂ (fun _ : FourierConfig eta Lattice3 => ℂ) 2 q).comp
      (ContinuousLinearMap.apply ℂ (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) c))

/-- The convolution is additive in its coefficients. -/
lemma convOp_add (a : Fin eta) {χ₁ χ₂ : Lattice3 → ℂ} (h₁ : Summable fun ν => ‖χ₁ ν‖)
    (h₂ : Summable fun ν => ‖χ₂ ν‖) :
    convOp (eta := eta) a (χ₁ + χ₂) = convOp a χ₁ + convOp a χ₂ := by
  have h12 : Summable fun ν => ‖(χ₁ + χ₂) ν‖ :=
    Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => norm_add_le _ _) (h₁.add h₂)
  have h := (hasSum_convOp (eta := eta) a h₁).add (hasSum_convOp a h₂)
  have e : (fun ν => χ₁ ν • shiftCLM (eta := eta) a ν + χ₂ ν • shiftCLM a ν) =
      fun ν => (χ₁ + χ₂) ν • shiftCLM a ν := by
    funext ν
    rw [Pi.add_apply, add_smul]
  rw [e] at h
  exact (hasSum_convOp a h12).unique h

lemma sqrt_latticeNormSq_add_le (x y : Lattice3) :
    Real.sqrt (latticeNormSq (x + y)) ≤ Real.sqrt (latticeNormSq x) + Real.sqrt
        (latticeNormSq y) := by
  rw [← norm_latticeEuclideanFrequency, ← norm_latticeEuclideanFrequency,
    ← norm_latticeEuclideanFrequency]
  have e : latticeEuclideanFrequency (x + y) =
      latticeEuclideanFrequency x + latticeEuclideanFrequency y := by
    ext i
    simp [latticeEuclideanFrequency]
  rw [e]
  exact norm_add_le _ _

lemma latticeNormSq_neg (x : Lattice3) : latticeNormSq (-x) = latticeNormSq x := by
  simp [latticeNormSq]

lemma add_single_self (a : Fin eta) (q : FourierConfig eta Lattice3) (ν : Lattice3) :
    (q + Pi.single a ν : FourierConfig eta Lattice3) a = q a + ν := by
  simp

lemma add_single_ne {a b : Fin eta} (hb : b ≠ a) (q : FourierConfig eta Lattice3) (ν : Lattice3) :
    (q + Pi.single a ν : FourierConfig eta Lattice3) b = q b := by
  rw [Pi.add_apply, Pi.single_eq_of_ne hb, add_zero]

lemma norm_tailMask_le (g K : ℝ) (r : Fin eta) :
    ‖tailMask (eta := eta) g K r‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one
    (fun x => l2_norm_le_of_le _ x zero_le_one (fun p => by
      rw [tailMask_apply]
      split_ifs <;> simp))

lemma norm_tailMask_apply_le (g K : ℝ) (r : Fin eta)
    (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) : ‖tailMask g K r x‖ ≤ ‖x‖ :=
  ((tailMask g K r).le_opNorm x).trans
    (by nlinarith [norm_tailMask_le (eta := eta) g K r, norm_nonneg x])

/-- The convolution in register `a` commutes with the tail masks of the other registers. -/
lemma tailMask_convOp_of_ne (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖) {b : Fin eta} (hb : b ≠ a)
    (g K : ℝ) (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    tailMask g K b (convOp a χ c) = convOp a χ (tailMask g K b c) := by
  ext q
  rw [tailMask_apply, convOp_apply a hχ, convOp_apply a hχ, ← tsum_mul_left]
  congr 1
  funext ν
  rw [tailMask_apply, add_single_ne hb]
  ring

/-- **Tail of a multiplied state, register `a`** (`lem:chitail`). The modes `g|ν| ≤ K/2` move a
momentum beyond `K` only from beyond `K/2`; the other modes are bounded by their coefficients. -/
lemma tailMask_convOp_self_le (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖) {g K : ℝ} (hg : 0 ≤ g)
    (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖tailMask g K a (convOp a χ c)‖ ≤
      (∑' ν, ‖χ ν‖) * ‖tailMask g (K / 2) a c‖ +
        (∑' ν, if K / 2 < g * Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0) * ‖c‖ := by
  classical
  set χs : Lattice3 → ℂ := fun ν => if K / 2 < g * Real.sqrt (latticeNormSq ν) then 0 else χ ν
  set χb : Lattice3 → ℂ := fun ν => if K / 2 < g * Real.sqrt (latticeNormSq ν) then χ ν else 0
  have hs : Summable fun ν => ‖χs ν‖ :=
    Summable.of_nonneg_of_le (fun ν => norm_nonneg _)
      (fun ν => by simp only [χs]; split_ifs <;> simp) hχ
  have hbs : Summable fun ν => ‖χb ν‖ :=
    Summable.of_nonneg_of_le (fun ν => norm_nonneg _)
      (fun ν => by simp only [χb]; split_ifs <;> simp) hχ
  have hsplit : χ = χs + χb := by
    funext ν
    simp only [χs, χb, Pi.add_apply]
    split_ifs <;> simp
  have hsmall : tailMask g K a (convOp a χs c) =
      tailMask g K a (convOp a χs (tailMask g (K / 2) a c)) := by
    ext q
    rw [tailMask_apply, tailMask_apply, convOp_apply a hs, convOp_apply a hs]
    split_ifs with hq
    · congr 1
      congr 1
      funext ν
      rw [tailMask_apply, add_single_self]
      simp only [χs]
      by_cases hν : K / 2 < g * Real.sqrt (latticeNormSq ν)
      · simp [hν]
      · have hin : K / 2 < g * Real.sqrt (latticeNormSq (q a + ν)) := by
          push Not at hν
          have htri := sqrt_latticeNormSq_add_le (q a + ν) (-ν)
          rw [add_neg_cancel_right, latticeNormSq_neg] at htri
          have := mul_le_mul_of_nonneg_left htri hg
          linarith
        simp [hν, hin]
    · simp
  have hnorm_s : ‖convOp (eta := eta) a χs‖ ≤ ∑' ν, ‖χ ν‖ :=
    (norm_convOp_le a hs).trans (Summable.tsum_le_tsum (fun ν => by
      simp only [χs]; split_ifs <;> simp) hs hχ)
  have hnorm_b : ‖convOp (eta := eta) a χb‖ ≤
      ∑' ν, if K / 2 < g * Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0 :=
    (norm_convOp_le a hbs).trans (le_of_eq (tsum_congr fun ν => by
      simp only [χb]; split_ifs <;> simp))
  have hconv : convOp a χ c = convOp a χs c + convOp a χb c := by
    conv_lhs => rw [hsplit]
    rw [convOp_add a hs hbs]
    rfl
  rw [hconv, map_add, hsmall]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · refine (norm_tailMask_apply_le g K a _).trans ?_
    refine ((convOp a χs).le_opNorm _).trans ?_
    exact mul_le_mul_of_nonneg_right hnorm_s (norm_nonneg _)
  · refine (norm_tailMask_apply_le g K a _).trans ?_
    refine ((convOp a χb).le_opNorm _).trans ?_
    exact mul_le_mul_of_nonneg_right hnorm_b (norm_nonneg _)

/-- The adjoint of a register translation is the opposite translation. -/
lemma inner_shiftCLM (a : Fin eta) (ν : Lattice3)
    (c c' : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ⟪shiftCLM a ν c, c'⟫_ℂ = ⟪c, shiftCLM a (-ν) c'⟫_ℂ := by
  have h : shiftCLM a ν (shiftCLM a (-ν) c') = c' := by
    ext q
    rw [shiftCLM_apply, shiftCLM_apply, add_assoc, ← Pi.single_add, add_neg_cancel, Pi.single_zero,
      add_zero]
  calc ⟪shiftCLM a ν c, c'⟫_ℂ = ⟪shiftOp a ν c, shiftOp a ν (shiftCLM a (-ν) c')⟫_ℂ := by
        congr 1
        exact h.symm
    _ = ⟪c, shiftCLM a (-ν) c'⟫_ℂ := LinearIsometryEquiv.inner_map_map _ _ _

/-- **Symmetry.** For a real `χ` (`χ̂(-ν) = conj χ̂(ν)`) the convolution is symmetric. -/
lemma convOp_symm (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖)
    (hreal : ∀ ν, χ (-ν) = conj (χ ν)) (c c' : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ⟪convOp a χ c, c'⟫_ℂ = ⟪c, convOp a χ c'⟫_ℂ := by
  set G : Lattice3 → ℂ := fun μ => ⟪c, χ μ • shiftCLM a μ c'⟫_ℂ
  have hR : HasSum G ⟪c, convOp a χ c'⟫_ℂ :=
    (hasSum_convOp_apply a hχ c').mapL (innerSL ℂ c)
  have hL0 : HasSum (fun ν => ⟪χ ν • shiftCLM a ν c, c'⟫_ℂ) ⟪convOp a χ c, c'⟫_ℂ := by
    have h1 := ((hasSum_convOp_apply a hχ c).mapL (innerSL ℂ c')).star
    simp only [innerSL_apply_apply] at h1
    have e : ∀ x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
        star ⟪c', x⟫_ℂ = ⟪x, c'⟫_ℂ := fun x => inner_conj_symm x c'
    simp only [e] at h1
    exact h1
  have hterm : (fun ν => ⟪χ ν • shiftCLM a ν c, c'⟫_ℂ) = G ∘ (Equiv.neg Lattice3) := by
    funext ν
    simp only [G, Function.comp_apply, Equiv.neg_apply]
    rw [inner_smul_left, inner_smul_right, inner_shiftCLM, hreal]
  rw [hterm, (Equiv.neg Lattice3).hasSum_iff] at hL0
  exact hL0.unique hR

/-- **Tail of the multiplied state** (`lem:chitail`). Outside the cube of radius `n`
(`K = g n`), `‖(1 - P)(O c)‖ ≤ C_χ t_a(K/2) + τ_χ(K/2) ‖c‖ + ‖O‖ Σ_b t_b(K)`, with
`C_χ = Σ_ν |χ̂(ν)|` and the coefficient tail `τ_χ(K/2) = Σ_{g|ν| > K/2} |χ̂(ν)|`. -/
theorem chitail {g : ℝ} (hg : 0 < g) (n : ℕ) (a : Fin eta) (hχ : Summable fun ν => ‖χ ν‖)
    (c : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖convOp a χ c - molecularH2Truncate n (convOp a χ c)‖ ≤
      (∑' ν, ‖χ ν‖) * ‖tailMask g (g * n / 2) a c‖ +
        (∑' ν, if g * n / 2 < g * Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0) * ‖c‖ +
        ‖convOp (eta := eta) a χ‖ * ∑ b : Fin eta, ‖tailMask g (g * n) b c‖ := by
  classical
  refine (norm_sub_truncate_le hg n _).trans ?_
  rw [← Finset.add_sum_erase _ _ (Finset.mem_univ a)]
  have h1 := tailMask_convOp_self_le a hχ hg.le c (K := g * n)
  have h2 : ∑ b ∈ Finset.univ.erase a, ‖tailMask g (g * n) b (convOp a χ c)‖ ≤
      ∑ b ∈ Finset.univ.erase a, ‖convOp (eta := eta) a χ‖ * ‖tailMask g (g * n) b c‖ := by
    refine Finset.sum_le_sum fun b hb => ?_
    rw [tailMask_convOp_of_ne a hχ (Finset.ne_of_mem_erase hb)]
    exact (convOp a χ).le_opNorm _
  have h3 : ∑ b ∈ Finset.univ.erase a, ‖convOp (eta := eta) a χ‖ * ‖tailMask g (g * n) b c‖ ≤
      ‖convOp (eta := eta) a χ‖ * ∑ b : Fin eta, ‖tailMask g (g * n) b c‖ := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.erase_subset _ _)
      (fun b _ _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
  linarith

end Convolution

/-! ## The convolution on `H²` and its commutator with the kinetic energy -/

section Kinetic

variable {eta : ℕ}

lemma sum_add_single (f : Fin eta → Lattice3 → ℝ) (q : FourierConfig eta Lattice3) (a : Fin eta)
    (ν : Lattice3) :
    ∑ i, f i ((q + Pi.single a ν : FourierConfig eta Lattice3) i) =
      ∑ i, f i (q i) + (f a (q a + ν) - f a (q a)) := by
  have h : ∀ i, f i ((q + Pi.single a ν : FourierConfig eta Lattice3) i) =
      f i (q i) + if i = a then f a (q a + ν) - f a (q a) else 0 := by
    intro i
    by_cases hi : i = a
    · subst hi
      rw [add_single_self, if_pos rfl]
      ring
    · rw [add_single_ne hi, if_neg hi, add_zero]
  rw [Finset.sum_congr rfl (fun i _ => h i), Finset.sum_add_distrib, Finset.sum_ite_eq']
  simp

lemma latticeNormSq_le_shift (x ν : Lattice3) :
    latticeNormSq x ≤ 2 * latticeNormSq (x + ν) + 2 * latticeNormSq ν := by
  unfold latticeNormSq
  simp only [Pi.add_apply, Int.cast_add]
  nlinarith [sq_nonneg ((x 0 : ℝ) + 2 * (ν 0 : ℝ)), sq_nonneg ((x 1 : ℝ) + 2 * (ν 1 : ℝ)),
    sq_nonneg ((x 2 : ℝ) + 2 * (ν 2 : ℝ))]

/-- The `H²` weight changes by at most the factor `2 (1 + g² |ν|²)` under a translation. -/
lemma weight_le_shift (g : ℝ) (a : Fin eta) (ν : Lattice3) (q : FourierConfig eta Lattice3) :
    molecularFourierH2Weight eta g q ≤
      2 * (1 + g ^ 2 * latticeNormSq ν) *
        molecularFourierH2Weight eta g (q + Pi.single a ν) := by
  have hw1 := molecularFourierH2Weight_ge_one eta g (q + Pi.single a ν)
  have hs := sum_add_single (fun _ x => g ^ 2 * latticeNormSq x) q a ν
  have hshift := latticeNormSq_le_shift (q a) ν
  have hν := latticeNormSq_nonneg ν
  have hqa := latticeNormSq_nonneg (q a + ν)
  have hsum_nonneg : 0 ≤ ∑ i : Fin eta,
      g ^ 2 * latticeNormSq ((q + Pi.single a ν : FourierConfig eta Lattice3) i) :=
    Finset.sum_nonneg fun i _ => mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg _)
  unfold molecularFourierH2Weight at hw1 ⊢
  have hg2 := sq_nonneg g
  have h1 : g ^ 2 * latticeNormSq (q a) ≤
      2 * (g ^ 2 * latticeNormSq (q a + ν)) + 2 * (g ^ 2 * latticeNormSq ν) := by
    nlinarith
  have hterm : g ^ 2 * latticeNormSq (q a + ν) ≤ ∑ i : Fin eta,
      g ^ 2 * latticeNormSq ((q + Pi.single a ν : FourierConfig eta Lattice3) i) := by
    have := Finset.single_le_sum (f := fun i : Fin eta =>
      g ^ 2 * latticeNormSq ((q + Pi.single a ν : FourierConfig eta Lattice3) i))
      (fun i _ => mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg _)) (Finset.mem_univ a)
    simp only [add_single_self] at this
    exact this
  nlinarith [mul_nonneg hg2 hν, mul_nonneg (mul_nonneg hg2 hν) hsum_nonneg,
    mul_nonneg hg2 hqa]

/-- The diagonal weight ratio `w(q)/w(q + ν e_a)`. -/
noncomputable def ratioCLM (g : ℝ) (a : Fin eta) (ν : Lattice3) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  diagCLM (fun q => ((molecularFourierH2Weight eta g q /
      molecularFourierH2Weight eta g (q + Pi.single a ν) : ℝ) : ℂ))
    (2 * (1 + g ^ 2 * latticeNormSq ν))
    (mul_nonneg zero_le_two (add_nonneg zero_le_one
        (mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg ν))))
    (fun q => by
      have hw := molecularFourierH2Weight_pos eta g (q + Pi.single a ν)
      have hw' := molecularFourierH2Weight_pos eta g q
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hw'.le hw.le),
        div_le_iff₀ hw]
      exact weight_le_shift g a ν q)

lemma norm_diagCLM_le {ι : Type*} (d : ι → ℂ) (C : ℝ) (hC : 0 ≤ C) (hd : ∀ i, ‖d i‖ ≤ C) :
    ‖diagCLM d C hC hd‖ ≤ C :=
  LinearMap.mkContinuous_norm_le _ hC _

lemma norm_ratioCLM_le (g : ℝ) (a : Fin eta) (ν : Lattice3) :
    ‖ratioCLM (eta := eta) g a ν‖ ≤ 2 * (1 + g ^ 2 * latticeNormSq ν) := by
  unfold ratioCLM
  exact norm_diagCLM_le _ _ _ _

/-- The convolution in the weighted `H²` coordinates. -/
noncomputable def convH2 (g : ℝ) (a : Fin eta) (χ : Lattice3 → ℂ) :
    MolecularFourierH2 eta →L[ℂ] MolecularFourierH2 eta :=
  ∑' ν, χ ν • (ratioCLM g a ν).comp (shiftCLM a ν)

variable {χ : Lattice3 → ℂ}

lemma summable_convH2Terms (g : ℝ) (a : Fin eta)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) :
    Summable fun ν => χ ν • (ratioCLM (eta := eta) g a ν).comp (shiftCLM a ν) :=
  Summable.of_norm_bounded (hχ2.mul_left 2) (fun ν => by
    rw [norm_smul]
    have h1 := ContinuousLinearMap.opNorm_comp_le (ratioCLM (eta := eta) g a ν) (shiftCLM a ν)
    have h2 := norm_ratioCLM_le (eta := eta) g a ν
    have h3 := norm_shiftCLM_le (eta := eta) a ν
    have h4 : ‖(ratioCLM (eta := eta) g a ν).comp (shiftCLM a ν)‖ ≤ 2 *
        (1 + g ^ 2 * latticeNormSq ν) :=
      h1.trans (by nlinarith [norm_nonneg (ratioCLM (eta := eta) g a ν),
        norm_nonneg (shiftCLM (eta := eta) a ν)])
    calc ‖χ ν‖ * ‖(ratioCLM (eta := eta) g a ν).comp (shiftCLM a ν)‖ ≤
          ‖χ ν‖ * (2 * (1 + g ^ 2 * latticeNormSq ν)) :=
          mul_le_mul_of_nonneg_left h4 (norm_nonneg _)
      _ = 2 * ((1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) := by ring)

lemma hasSum_convH2_eval (g : ℝ) (a : Fin eta)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖)
    (u : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    HasSum (fun ν => χ ν * (((molecularFourierH2Weight eta g q /
        molecularFourierH2Weight eta g (q + Pi.single a ν) : ℝ) : ℂ) * u (q + Pi.single a ν)))
      (convH2 g a χ u q) :=
  (summable_convH2Terms g a hχ2).hasSum.mapL
    ((lp.evalCLM ℂ (fun _ : FourierConfig eta Lattice3 => ℂ) 2 q).comp
      (ContinuousLinearMap.apply ℂ (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) u))

lemma summable_norm_of_weighted (g : ℝ)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) :
    Summable fun ν => ‖χ ν‖ :=
  Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => by
    have := mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg ν)
    nlinarith [norm_nonneg (χ ν)]) hχ2

/-- **The convolution preserves the domain**: `S (Õ u) = O (S u)`. -/
lemma stateMap_convH2 (g : ℝ) (a : Fin eta)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) (u : MolecularFourierH2 eta) :
    molecularH2StateMap eta g (convH2 g a χ u) = convOp a χ (molecularH2StateMap eta g u) := by
  have hχ := summable_norm_of_weighted g hχ2
  ext q
  rw [molecularH2StateMap_apply, molecularH2Coeff]
  have h1 := (hasSum_convH2_eval g a hχ2 u q).div_const (molecularFourierH2Weight eta g q : ℂ)
  have h2 := hasSum_convOp_eval a hχ (molecularH2StateMap eta g u) q
  have e : (fun ν => χ ν * (((molecularFourierH2Weight eta g q /
        molecularFourierH2Weight eta g (q + Pi.single a ν) : ℝ) : ℂ) * u (q + Pi.single a ν)) /
          (molecularFourierH2Weight eta g q : ℂ)) =
      fun ν => χ ν * molecularH2StateMap eta g u (q + Pi.single a ν) := by
    funext ν
    rw [molecularH2StateMap_apply, molecularH2Coeff]
    have hw := molecularFourierH2Weight_pos eta g q
    have hw' := molecularFourierH2Weight_pos eta g (q + Pi.single a ν)
    have hwc : (molecularFourierH2Weight eta g q : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hw.ne'
    have hwc' : (molecularFourierH2Weight eta g (q + Pi.single a ν) : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr hw'.ne'
    push_cast
    field_simp
  rw [e] at h1
  exact h1.unique h2

/-- The coefficients `g² |ν|² χ̂(ν)` (the Laplacian of `χ`, up to sign). -/
noncomputable def coeffLap (g : ℝ) (χ : Lattice3 → ℂ) (ν : Lattice3) : ℂ :=
  ((g ^ 2 * latticeNormSq ν : ℝ) : ℂ) * χ ν

/-- The coefficients `g ν_j χ̂(ν)` (the derivative `∂_j χ`, up to a factor `± i`). -/
noncomputable def coeffDer (g : ℝ) (χ : Lattice3 → ℂ) (j : Fin 3) (ν : Lattice3) : ℂ :=
  ((g * (ν j : ℝ) : ℝ) : ℂ) * χ ν

lemma abs_le_one_add_sq (x : ℝ) : |x| ≤ 1 + x ^ 2 := by
  nlinarith [sq_nonneg (|x| - 1), sq_abs x, abs_nonneg x]

lemma summable_coeffLap (g : ℝ) (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) :
    Summable fun ν => ‖coeffLap g χ ν‖ :=
  Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => by
    have h0 := mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg ν)
    rw [coeffLap, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0]
    nlinarith [norm_nonneg (χ ν)]) hχ2

lemma summable_coeffDer (g : ℝ) (j : Fin 3)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) :
    Summable fun ν => ‖coeffDer g χ j ν‖ :=
  Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => by
    rw [coeffDer, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have h1 := abs_le_one_add_sq (g * (ν j : ℝ))
    have h2 := lattice_coordinate_sq_le_latticeNormSq ν j
    have h3 : (g * (ν j : ℝ)) ^ 2 ≤ g ^ 2 * latticeNormSq ν := by
      rw [mul_pow]
      exact mul_le_mul_of_nonneg_left h2 (sq_nonneg g)
    exact mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)) hχ2

/-- The momentum `g p_{a,j}` of register `a`, composed with the decoding map. -/
noncomputable def momCLM (g : ℝ) (a : Fin eta) (j : Fin 3) :
    MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  diagCLM (fun p => ((g * (p a j : ℝ) / molecularFourierH2Weight eta g p : ℝ) : ℂ)) 1 zero_le_one
    (fun p => by
      have hw := molecularFourierH2Weight_pos eta g p
      rw [Complex.norm_real, Real.norm_eq_abs, abs_div, abs_of_pos hw, div_le_one hw]
      have h1 := abs_le_one_add_sq (g * (p a j : ℝ))
      have h2 := lattice_coordinate_sq_le_latticeNormSq (p a) j
      have h3 : g ^ 2 * latticeNormSq (p a) ≤ ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) :=
        Finset.single_le_sum (f := fun i : Fin eta => g ^ 2 * latticeNormSq (p i))
          (fun i _ => mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg _)) (Finset.mem_univ a)
      have h4 : (g * (p a j : ℝ)) ^ 2 ≤ g ^ 2 * latticeNormSq (p a) := by
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_left h2 (sq_nonneg g)
      unfold molecularFourierH2Weight
      linarith)

lemma momCLM_apply (g : ℝ) (a : Fin eta) (j : Fin 3) (u : MolecularFourierH2 eta)
    (p : FourierConfig eta Lattice3) :
    momCLM g a j u p = ((g * (p a j : ℝ) : ℝ) : ℂ) * molecularH2Coeff g u p := by
  rw [momCLM, diagCLM_apply, molecularH2Coeff]
  have hw := molecularFourierH2Weight_pos eta g p
  have hwc : (molecularFourierH2Weight eta g p : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hw.ne'
  push_cast
  field_simp

variable {Nuc : Type} [Fintype Nuc]

/-- The kinetic symbol under a translation of register `a`. -/
lemma kinetic_shift_identity (sys : CoulombSystem eta Nuc) (g : ℝ) (a : Fin eta) (ν : Lattice3)
    (q : FourierConfig eta Lattice3) :
    coulombKineticEnergySymbol sys g q =
      coulombKineticEnergySymbol sys g (q + Pi.single a ν) +
        (1 / (2 * sys.mass a)) * (g ^ 2 * latticeNormSq ν) -
        (1 / sys.mass a) * ∑ j : Fin 3, (g * (ν j : ℝ)) *
          (g * (((q + Pi.single a ν : FourierConfig eta Lattice3) a j : ℤ) : ℝ)) := by
  have hm := (sys.mass_pos a).ne'
  unfold coulombKineticEnergySymbol
  rw [sum_add_single (fun i x => g ^ 2 * latticeNormSq x / sys.mass i) q a ν, add_single_self]
  simp only [Fin.sum_univ_three, Pi.add_apply, Int.cast_add, latticeNormSq]
  field_simp
  ring

/-- **Commutator with the kinetic energy.**
`T Õ u = O T u + (1/2m_a) O_Δ S u - (1/m_a) Σ_j O_{∂_j} (g p_{a,j}) S u`. -/
theorem kinetic_convH2 (sys : CoulombSystem eta Nuc) (g : ℝ) (a : Fin eta)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) (u : MolecularFourierH2 eta) :
    coulombFourierKineticH2 sys g (convH2 g a χ u) =
      convOp a χ (coulombFourierKineticH2 sys g u) +
        ((1 / (2 * sys.mass a) : ℝ) : ℂ) • convOp a (coeffLap g χ) (molecularH2StateMap eta g u) -
        ((1 / sys.mass a : ℝ) : ℂ) • ∑ j : Fin 3, convOp a (coeffDer g χ j) (momCLM g a j u) := by
  have hχ := summable_norm_of_weighted g hχ2
  ext q
  rw [coulombFourierKineticH2_apply, ← molecularH2StateMap_apply, stateMap_convH2 g a hχ2]
  have hA := hasSum_convOp_eval a hχ (coulombFourierKineticH2 sys g u) q
  have hB := (hasSum_convOp_eval a (summable_coeffLap g hχ2)
      (molecularH2StateMap eta g u) q).mul_left
    ((1 / (2 * sys.mass a) : ℝ) : ℂ)
  have hC := (hasSum_sum (s := Finset.univ) (fun j _ =>
    hasSum_convOp_eval a (summable_coeffDer g j hχ2) (momCLM g a j u) q)).mul_left
      ((1 / sys.mass a : ℝ) : ℂ)
  have hR := (hA.add hB).sub hC
  have hL := (hasSum_convOp_eval a hχ (molecularH2StateMap eta g u) q).mul_left
    ((coulombKineticEnergySymbol sys g q : ℝ) : ℂ)
  have e : (fun ν => χ ν * coulombFourierKineticH2 sys g u (q + Pi.single a ν) +
        ((1 / (2 * sys.mass a) : ℝ) : ℂ) *
          (coeffLap g χ ν * molecularH2StateMap eta g u (q + Pi.single a ν)) -
        ((1 / sys.mass a : ℝ) : ℂ) *
          ∑ j : Fin 3, coeffDer g χ j ν * momCLM g a j u (q + Pi.single a ν)) =
      fun ν => ((coulombKineticEnergySymbol sys g q : ℝ) : ℂ) *
        (χ ν * molecularH2StateMap eta g u (q + Pi.single a ν)) := by
    funext ν
    rw [coulombFourierKineticH2_apply, molecularH2StateMap_apply,
      kinetic_shift_identity sys g a ν q]
    simp only [momCLM_apply, coeffLap, coeffDer, Fin.sum_univ_three]
    push_cast
    ring
  rw [e] at hR
  have hval := hL.unique hR
  rw [hval]
  simp only [lp.coeFn_sub, lp.coeFn_add, lp.coeFn_smul, Pi.sub_apply, Pi.add_apply, Pi.smul_apply,
    smul_eq_mul]
  congr 1

/-- `‖g p_{a,j} S u‖ ≤ ‖S u‖ + 2 m_a ‖T u‖`. -/
lemma norm_momCLM_le (sys : CoulombSystem eta Nuc) (g : ℝ) (a : Fin eta) (j : Fin 3)
    (u : MolecularFourierH2 eta) :
    ‖momCLM g a j u‖ ≤ ‖molecularH2StateMap eta g u‖ +
      2 * sys.mass a * ‖coulombFourierKineticH2 sys g u‖ := by
  have hm := sys.mass_pos a
  have h := l2_norm_le_of_le (momCLM g a j u)
    (molecularH2StateMap eta g u + ((2 * sys.mass a : ℝ) : ℂ) • coulombFourierKineticH2 sys g u)
    zero_le_one (fun p => by
      rw [momCLM_apply, lp.coeFn_add, lp.coeFn_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        molecularH2StateMap_apply, coulombFourierKineticH2_apply, one_mul]
      have hk0 := coulombKineticEnergySymbol_nonneg sys g p
      have e : molecularH2Coeff g u p + ((2 * sys.mass a : ℝ) : ℂ) *
          ((coulombKineticEnergySymbol sys g p : ℂ) * molecularH2Coeff g u p) =
          ((1 + 2 * sys.mass a * coulombKineticEnergySymbol sys g p : ℝ) : ℂ) *
            molecularH2Coeff g u p := by
        push_cast
        ring
      rw [e, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
        Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤ 1 + 2 * sys.mass a *
          coulombKineticEnergySymbol sys g p)]
      refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
      have h1 := abs_le_one_add_sq (g * (p a j : ℝ))
      have h2 := lattice_coordinate_sq_le_latticeNormSq (p a) j
      have h4 : (g * (p a j : ℝ)) ^ 2 ≤ g ^ 2 * latticeNormSq (p a) := by
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_left h2 (sq_nonneg g)
      have h3 : g ^ 2 * latticeNormSq (p a) / sys.mass a ≤
          ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i :=
        Finset.single_le_sum (f := fun i : Fin eta => g ^ 2 * latticeNormSq (p i) / sys.mass i)
          (fun i _ => div_nonneg (mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg _))
            (sys.mass_pos i).le) (Finset.mem_univ a)
      have h5 : g ^ 2 * latticeNormSq (p a) ≤ 2 * sys.mass a *
          coulombKineticEnergySymbol sys g p := by
        unfold coulombKineticEnergySymbol
        have := mul_le_mul_of_nonneg_left h3 hm.le
        rw [mul_div_cancel₀ _ hm.ne'] at this
        linarith
      linarith)
  refine h.trans ?_
  rw [one_mul]
  refine (norm_add_le _ _).trans ?_
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]

/-- The commutator constant `D_χ = ‖O_Δ‖ + Σ_j ‖O_{∂_j}‖` (operator norms of the convolutions with
the coefficients of `Δχ` and `∂_j χ`). -/
noncomputable def commConst (g : ℝ) (a : Fin eta) (χ : Lattice3 → ℂ) : ℝ :=
  ‖convOp (eta := eta) a (coeffLap g χ)‖ + ∑ j : Fin 3, ‖convOp (eta := eta) a (coeffDer g χ j)‖

lemma commConst_nonneg (g : ℝ) (a : Fin eta) (χ : Lattice3 → ℂ) : 0 ≤ commConst g a χ :=
  add_nonneg (norm_nonneg _) (Finset.sum_nonneg fun _ _ => norm_nonneg _)

/-- **Kinetic energy of a multiplied state** (`lem:smear`, commutator part):
`‖T Õ u‖ ≤ (‖O‖ + 2 D_χ) ‖T u‖ + D_χ ‖S u‖`. -/
theorem norm_kinetic_convH2_le (sys : CoulombSystem eta Nuc) (g : ℝ) (a : Fin eta)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖χ ν‖) (u : MolecularFourierH2 eta) :
    ‖coulombFourierKineticH2 sys g (convH2 g a χ u)‖ ≤
      (‖convOp (eta := eta) a χ‖ + 2 * commConst g a χ) * ‖coulombFourierKineticH2 sys g u‖ +
        commConst g a χ * ‖molecularH2StateMap eta g u‖ := by
  have hm1 := sys.one_le_mass a
  have hm := sys.mass_pos a
  set X := ‖coulombFourierKineticH2 sys g u‖
  set Y := ‖molecularH2StateMap eta g u‖
  have hX := norm_nonneg (coulombFourierKineticH2 sys g u)
  have hY := norm_nonneg (molecularH2StateMap eta g u)
  rw [kinetic_convH2 sys g a hχ2 u]
  have hA : ‖convOp a χ (coulombFourierKineticH2 sys g u)‖ ≤ ‖convOp (eta := eta) a χ‖ * X :=
    (convOp a χ).le_opNorm _
  have hB : ‖((1 / (2 * sys.mass a) : ℝ) : ℂ) •
      convOp a (coeffLap g χ) (molecularH2StateMap eta g u)‖ ≤
      ‖convOp (eta := eta) a (coeffLap g χ)‖ * Y := by
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have h1 := (convOp a (coeffLap g χ)).le_opNorm (molecularH2StateMap eta g u)
    have h2 : 1 / (2 * sys.mass a) ≤ 1 := by
      rw [div_le_one (by positivity)]
      linarith
    have h3 := norm_nonneg (convOp a (coeffLap g χ) (molecularH2StateMap eta g u))
    nlinarith
  have hCj : ∀ j : Fin 3, ‖convOp a (coeffDer g χ j) (momCLM g a j u)‖ ≤
      ‖convOp (eta := eta) a (coeffDer g χ j)‖ * (Y + 2 * sys.mass a * X) := fun j =>
    ((convOp a (coeffDer g χ j)).le_opNorm _).trans
      (mul_le_mul_of_nonneg_left (norm_momCLM_le sys g a j u) (norm_nonneg _))
  have hC : ‖((1 / sys.mass a : ℝ) : ℂ) •
      ∑ j : Fin 3, convOp a (coeffDer g χ j) (momCLM g a j u)‖ ≤
      (∑ j : Fin 3, ‖convOp (eta := eta) a (coeffDer g χ j)‖) * (Y + 2 * X) := by
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have hsum := norm_sum_le (Finset.univ : Finset (Fin 3))
      (fun j => convOp a (coeffDer g χ j) (momCLM g a j u))
    have hsum2 : ∑ j : Fin 3, ‖convOp a (coeffDer g χ j) (momCLM g a j u)‖ ≤
        ∑ j : Fin 3, ‖convOp (eta := eta) a (coeffDer g χ j)‖ * (Y + 2 * sys.mass a * X) :=
      Finset.sum_le_sum fun j _ => hCj j
    rw [← Finset.sum_mul] at hsum2
    set D := ∑ j : Fin 3, ‖convOp (eta := eta) a (coeffDer g χ j)‖
    have hD : 0 ≤ D := Finset.sum_nonneg fun _ _ => norm_nonneg _
    have hle : ‖∑ j : Fin 3, convOp a (coeffDer g χ j) (momCLM g a j u)‖ ≤
        D * (Y + 2 * sys.mass a * X) := hsum.trans hsum2
    calc 1 / sys.mass a * ‖∑ j : Fin 3, convOp a (coeffDer g χ j) (momCLM g a j u)‖ ≤
          1 / sys.mass a * (D * (Y + 2 * sys.mass a * X)) :=
          mul_le_mul_of_nonneg_left hle (by positivity)
      _ = D * (Y / sys.mass a + 2 * X) := by
          field_simp
      _ ≤ D * (Y + 2 * X) := by
          apply mul_le_mul_of_nonneg_left _ hD
          have : Y / sys.mass a ≤ Y := div_le_self hY hm1
          linarith
  have htot := (norm_sub_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add hA hB)) hC)
  refine htot.trans ?_
  unfold commConst
  set DL := ‖convOp (eta := eta) a (coeffLap g χ)‖
  set D := ∑ j : Fin 3, ‖convOp (eta := eta) a (coeffDer g χ j)‖
  have hDL : 0 ≤ DL := norm_nonneg _
  have hD : 0 ≤ D := Finset.sum_nonneg fun _ _ => norm_nonneg _
  nlinarith

end Kinetic

