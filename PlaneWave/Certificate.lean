    molecularH2Truncate N (lp.single (E := fun _ : FourierConfig eta Lattice3 => ℂ) 2 p z) =
      lp.single (E := fun _ : FourierConfig eta Lattice3 => ℂ) 2 p z := by
  classical
  apply lp.ext
  funext q
  change lpTruncate (fourierConfigCube eta N)
    (lp.single (E := fun _ : FourierConfig eta Lattice3 => ℂ) 2 p z) q = _
  rw [lpTruncate_apply]
  by_cases hq : q ∈ fourierConfigCube eta N
  · rw [if_pos hq]
  · rw [if_neg hq]
