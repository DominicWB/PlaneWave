/-- The subspace supported in the actual tensor-product cube. -/
def cubicRetainedSubmodule (eta : ℕ) (K g : ℝ) (count : ℕ) :
    Submodule ℂ (EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) where
  carrier := IsCubicRetainedVector eta K g count
  zero_mem' := by intro _p _hp; rfl
  add_mem' := by
    intro u v hu hv p hp
    change u.ofLp p + v.ofLp p = 0
    rw [hu p hp, hv p hp, add_zero]
  smul_mem' := by
    intro z u hu p hp
    change z * u.ofLp p = 0
    rw [hu p hp, mul_zero]

/-- Compression to a finite-dimensional trial subspace. Cubic support need not
be invariant under H: projection is part of the Galerkin operator. -/
def finiteSectorCompression
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [FiniteDimensional ℂ V] (S : Submodule ℂ V) (H : V →ₗ[ℂ] V) : S →ₗ[ℂ] S :=
  S.orthogonalProjectionOnto.toLinearMap.comp (H.comp S.subtype)

lemma finiteSectorCompression_inner
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [FiniteDimensional ℂ V] (S : Submodule ℂ V) (H : V →ₗ[ℂ] V) (u v : S) :
    inner ℂ u (finiteSectorCompression S H v) = inner ℂ (u : V) (H (v : V)) := by
  change inner ℂ u (S.orthogonalProjectionOnto (H (v : V))) = _
  exact Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left u (H (v : V))

lemma finiteSectorCompression_isSymmetric
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [FiniteDimensional ℂ V] (S : Submodule ℂ V) (H : V →ₗ[ℂ] V)
    (hH : H.IsSymmetric) : (finiteSectorCompression S H).IsSymmetric := by
  intro u v
  change inner ℂ (S.orthogonalProjectionOnto (H (u : V))) v =
    inner ℂ u (S.orthogonalProjectionOnto (H (v : V)))
  rw [Submodule.inner_orthogonalProjectionOnto_eq_of_mem_right,
    Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left]
  exact hH (u : V) (v : V)

