/-- At every line parameter, the derivative agrees with the first field. -/
theorem deriv_coordinateLine {d : Type*} [Fintype d]
    (f : TorusCoordinateC2Test d) (a : d) (x : UnitAddTorus d) (t : ℝ) :
    deriv (fun r : ℝ => f.toContinuousMap (torusCoordinateLine x a r)) t =
      f.first a (torusCoordinateLine x a t) :=
  (f.hasFirst a x t).deriv

/-- The second field agrees with the ordinary iterated derivative, so a sum
 of these fields is the classical Laplacian, independently of Fourier analysis. -/
theorem second_eq_iteratedDeriv {d : Type*} [Fintype d]
    (f : TorusCoordinateC2Test d) (a : d) (x : UnitAddTorus d) :
    f.second a x =
      deriv (deriv (fun t : ℝ =>
        f.toContinuousMap (torusCoordinateLine x a t))) 0 := by
  have hFirst :
      deriv (fun t : ℝ => f.toContinuousMap (torusCoordinateLine x a t)) =
        fun t : ℝ => f.first a (torusCoordinateLine x a t) := by
    funext t
    exact f.deriv_coordinateLine a x t
  rw [hFirst, (f.hasSecond a x 0).deriv, torusCoordinateLine_zero]

end TorusCoordinateC2Test

