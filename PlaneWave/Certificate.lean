noncomputable section

/-- A linear operator on a dense subspace extends continuously as soon as its
norm is bounded by the ambient norm. Continuity is a conclusion. -/
theorem exists_continuous_extension_of_dense_submodule
    {Y X : Type*} [NormedAddCommGroup Y] [NormedSpace ℂ Y]
    [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]
    (S : Submodule ℂ Y) (A : S →ₗ[ℂ] X)
    (hDense : DenseRange S.subtype) (C : ℝ)
    (hBound : ∀ u : S, ‖A u‖ ≤ C * ‖(u : Y)‖) :
    ∃ H : Y →L[ℂ] X,
      (∀ u : S, H (u : Y) = A u) ∧
      (∀ u : Y, ‖H u‖ ≤ C * ‖u‖) := by
  refine ⟨A.extendOfNorm S.subtype, ?_, ?_⟩
  · intro u
    exact LinearMap.extendOfNorm_eq hDense ⟨C, hBound⟩ u
  · intro u
    exact LinearMap.norm_extendOfNorm_apply_le hDense C hBound u

/-- Finite linear combinations of coordinate vectors inside complex `lp 2`.
This is the algebraic Fourier core in weighted-coordinate representations. -/
def lp2CoordinateCore (ι : Type*) [DecidableEq ι] :
    Submodule ℂ (lp (fun _ : ι => ℂ) 2) :=
  Submodule.span ℂ (Set.range (fun i : ι => lp.single 2 i (1 : ℂ)))

theorem lp2_single_mem_coordinateCore
    {ι : Type*} [DecidableEq ι] (i : ι) (z : ℂ) :
    lp.single 2 i z ∈ lp2CoordinateCore ι := by
  have hOne : lp.single 2 i (1 : ℂ) ∈ lp2CoordinateCore ι :=
    Submodule.subset_span ⟨i, rfl⟩
  simpa only [← lp.single_smul, smul_eq_mul, mul_one] using
    (lp2CoordinateCore ι).smul_mem z hOne

/-- Density of the Fourier core is proved from the canonical summation theorem
for `lp`; it is not an extra analytic hypothesis. -/
theorem lp2CoordinateCore_denseRange
    (ι : Type*) [DecidableEq ι] :
    DenseRange (lp2CoordinateCore ι).subtype := by
  intro u
  apply mem_closure_of_tendsto (lp.hasSum_single (by norm_num) u)
  apply Filter.Eventually.of_forall
  intro s
  refine ⟨⟨∑ i ∈ s, lp.single 2 i (u i), ?_⟩, rfl⟩
  exact (lp2CoordinateCore ι).sum_mem fun i _hi =>
    lp2_single_mem_coordinateCore i (u i)

/-- A uniform finite Fourier bound constructs the operator on all square-
summable weighted coefficients. The finite-core density is discharged above. -/
theorem lp2_exists_continuous_extension
    {ι X : Type*} [DecidableEq ι]
    [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]
    (A : lp2CoordinateCore ι →ₗ[ℂ] X) (C : ℝ)
    (hBound : ∀ u : lp2CoordinateCore ι,
      ‖A u‖ ≤ C * ‖(u : lp (fun _ : ι => ℂ) 2)‖) :
    ∃ H : lp (fun _ : ι => ℂ) 2 →L[ℂ] X,
      (∀ u : lp2CoordinateCore ι, H (u : lp (fun _ : ι => ℂ) 2) = A u) ∧
      (∀ u : lp (fun _ : ι => ℂ) 2, ‖H u‖ ≤ C * ‖u‖) := by
  exact exists_continuous_extension_of_dense_submodule
    (lp2CoordinateCore ι) A (lp2CoordinateCore_denseRange ι) C hBound

end

