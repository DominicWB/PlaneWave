/-! ## One-hundred-eighth milestone: remove regularization and close the local Hardy interface

The singular density is first identified with the square of the zero extension
of the existing localized continuous representative. Its integrability follows
from the inverse-radius integrability already proved in milestone 89, without
using Hardy. Dominated convergence is then applied as epsilon tends to zero
from above. The origin is excluded explicitly as a Lebesgue-null singleton:
there is no assertion of pointwise convergence of the weights at the origin.

Exact zero-extension integral and `MemLp.toLp` norm identities then transport the
ambient inequality to the precise norm formulation in the existing Hardy data.
The concluding BO wrapper supplies that data from the three geometric radius
hypotheses, instead of accepting a Hardy proof as an input.
-/

/-- The squared Euclidean radius is strictly positive off the origin. -/
lemma centeredCube3AmbientRadiusSq_pos_of_ne_zero
    (x : CenteredCube3Ambient) (hx : x ≠ 0) :
    0 < centeredCube3AmbientRadiusSq x := by
  by_contra h
  have hZero : centeredCube3AmbientRadiusSq x = 0 :=
    le_antisymm (le_of_not_gt h) (centeredCube3AmbientRadiusSq_nonneg x)
  apply hx
  ext j
  have hSingle : (x j) ^ 2 ≤ centeredCube3AmbientRadiusSq x := by
    unfold centeredCube3AmbientRadiusSq
    exact Finset.single_le_sum (fun i hi => sq_nonneg (x i)) (Finset.mem_univ j)
  change x j = 0
  nlinarith only [hSingle, hZero, sq_nonneg (x j)]

/-- The singular point has zero ambient Lebesgue measure. -/
lemma centeredCube3AmbientRadiusSq_pos_ae :
    ∀ᵐ x : CenteredCube3Ambient ∂volume, 0 < centeredCube3AmbientRadiusSq x := by
  filter_upwards [(volume : Measure CenteredCube3Ambient).ae_ne (0 : CenteredCube3Ambient)]
    with x hx
  exact centeredCube3AmbientRadiusSq_pos_of_ne_zero x hx

/-- The existing continuous representative of `chi * psi / r` is in `L2`.
This uses the previously proved scalar inverse-radius integrability, not Hardy. -/
lemma centeredCube3RadialCutoffLocalizedContinuousFunction_memLp_canonical
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) :
    MemLp (centeredCube3RadialCutoffLocalizedContinuousFunction rho R index f)
      2 centeredCube3Measure := by
  have hEq := centeredCube3RadialCutoffLocalizedFunction_eq_continuous_ae
    rho R index f
  exact (memLp_congr_ae hEq).1
    (centeredCube3RadialCutoffLocalizedFunction_memLp_canonical hRhoR index f)

/-- Zero extension of the already defined localized inverse-radius function.
This uses its continuous Fourier representative; it does not choose a new
representative of an `Lp` equivalence class. -/
noncomputable def centeredCube3RadialCutoffLocalizedZeroExtension
    {α : Type} [Fintype α]
    (rho R : ℝ) (index : α → Lattice3) (f : α → ℂ) :
    CenteredCube3Ambient → ℂ :=
  centeredCube3ZeroExtension
    (centeredCube3RadialCutoffLocalizedContinuousFunction rho R index f)

/-- Multiplication by the ambient inverse radius commutes with this zero
extension. The equality includes the origin, where the inverse is zero. -/
lemma centeredCube3RadialCutoffLocalizedZeroExtension_eq_inverse_mul_wave
    {α : Type} [Fintype α]
    (rho R : ℝ) (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) :
    centeredCube3RadialCutoffLocalizedZeroExtension rho R index f x =
      ((1 / centeredCube3AmbientRadius x : ℝ) : ℂ) *
        centeredCube3RadialCutoffWaveZeroExtension rho R index f x := by
  classical
  by_cases hx : x ∈ centeredCube3AmbientSet
  · let y : CenteredCube3 := ⟨x, hx⟩
    have hLoc := centeredCube3ZeroExtension_subtype
      (centeredCube3RadialCutoffLocalizedContinuousFunction rho R index f) y
    have hWave := centeredCube3RadialCutoffWaveZeroExtension_subtype rho R index f y
    have hRadius : centeredCube3Radius y = centeredCube3AmbientRadius x :=
      (centeredCube3AmbientRadius_subtype y).symm
    calc
      centeredCube3RadialCutoffLocalizedZeroExtension rho R index f x =
          centeredCube3RadialCutoffLocalizedContinuousFunction rho R index f y := hLoc
      _ = ((1 / centeredCube3AmbientRadius x : ℝ) : ℂ) *
          centeredCube3RadialCutoffWaveFunction rho R index f y := by
        unfold centeredCube3RadialCutoffLocalizedContinuousFunction
          centeredCube3RadialCutoffWaveFunction
        rw [centeredCube3InverseRadius_eq_one_div_radius, hRadius]
        exact mul_assoc _ _ _
      _ = ((1 / centeredCube3AmbientRadius x : ℝ) : ℂ) *
          centeredCube3RadialCutoffWaveZeroExtension rho R index f x :=
        congrArg (fun z : ℂ => ((1 / centeredCube3AmbientRadius x : ℝ) : ℂ) * z)
          hWave.symm
  · have hLoc : centeredCube3RadialCutoffLocalizedZeroExtension rho R index f x = 0 := by
      unfold centeredCube3RadialCutoffLocalizedZeroExtension
      exact centeredCube3ZeroExtension_eq_zero_of_not_mem _ x hx
    have hWave : centeredCube3RadialCutoffWaveZeroExtension rho R index f x = 0 := by
      change centeredCube3ZeroExtension
        (centeredCube3RadialCutoffWaveFunction rho R index f) x = 0
      exact centeredCube3ZeroExtension_eq_zero_of_not_mem _ x hx
    rw [hLoc, hWave, mul_zero]

/-- Exact pointwise identification of the singular weighted density with the
square of the localized zero extension. No nonzero-radius premise is needed. -/
lemma centeredCube3RadialCutoffLocalizedZeroExtension_sq_eq_singularDensity
    {α : Type} [Fintype α]
    (rho R : ℝ) (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) :
    ‖centeredCube3RadialCutoffLocalizedZeroExtension rho R index f x‖ ^ 2 =
      (1 / centeredCube3AmbientRadiusSq x) *
        ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2 := by
  rw [centeredCube3RadialCutoffLocalizedZeroExtension_eq_inverse_mul_wave]
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow,
    sq_abs, div_pow, one_pow, centeredCube3AmbientRadius_sq]

/-- The singular weighted density is integrable independently of the Hardy
estimate. This is the integrable majorant for dominated convergence. -/
lemma centeredCube3RadialCutoff_singularDensity_integrable
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) :
    Integrable
      (fun x : CenteredCube3Ambient =>
        (1 / centeredCube3AmbientRadiusSq x) *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) volume := by
  have hLoc : Integrable
      (fun x : CenteredCube3Ambient =>
        ‖centeredCube3RadialCutoffLocalizedZeroExtension rho R index f x‖ ^ 2) volume := by
    unfold centeredCube3RadialCutoffLocalizedZeroExtension
    exact centeredCube3ZeroExtension_sq_integrable _
      (centeredCube3RadialCutoffLocalizedContinuousFunction_memLp_canonical hRhoR index f)
  apply hLoc.congr
  filter_upwards with x
  exact centeredCube3RadialCutoffLocalizedZeroExtension_sq_eq_singularDensity rho R index f x

/-- The nonregularized Hardy energy of the original cutoff wave. Its
integrability is proved above; it is not justified by totalizing the integral. -/
noncomputable def centeredCube3RadialCutoffSingularEnergy
    {α : Type} [Fintype α]
    (rho R : ℝ) (index : α → Lattice3) (f : α → ℂ) : ℝ :=
  ∫ x : CenteredCube3Ambient,
    (1 / centeredCube3AmbientRadiusSq x) *
      ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2

/-- Off the origin, any regularized weight is bounded by the singular weight.
We do not assert this inequality at the origin. -/
lemma hardyRegularizedWeight_le_singularWeight
    (eps : ℝ) (x : CenteredCube3Ambient)
    (hRadiusSq : 0 < centeredCube3AmbientRadiusSq x) :
    hardyRegularizedWeight eps x ≤ 1 / centeredCube3AmbientRadiusSq x := by
  unfold hardyRegularizedWeight
  apply one_div_le_one_div_of_le hRadiusSq
  unfold hardyRegularizedDenominator
  linarith only [sq_nonneg eps]

/-- Pointwise convergence of the regularized weight as epsilon tends to zero
from above, away from the single singular point. -/
lemma hardyRegularizedWeight_tendsto_singularWeight
    (x : CenteredCube3Ambient)
    (hRadiusSq : centeredCube3AmbientRadiusSq x ≠ 0) :
    Tendsto (fun eps : ℝ => hardyRegularizedWeight eps x)
      (𝓝[>] (0 : ℝ)) (𝓝 (1 / centeredCube3AmbientRadiusSq x)) := by
  have hEps : Tendsto (fun eps : ℝ => eps) (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) :=
    continuousWithinAt_id.tendsto
  have hSquare : Tendsto (fun eps : ℝ => eps ^ 2)
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
    simpa only [zero_pow (by decide : (2 : ℕ) ≠ 0)] using hEps.pow 2
  have hDen : Tendsto (fun eps : ℝ => hardyRegularizedDenominator eps x)
      (𝓝[>] (0 : ℝ)) (𝓝 (centeredCube3AmbientRadiusSq x)) := by
    unfold hardyRegularizedDenominator
    simpa only [add_zero] using
      (tendsto_const_nhds (x := centeredCube3AmbientRadiusSq x)).add hSquare
  unfold hardyRegularizedWeight
  exact tendsto_const_nhds.div hDen hRadiusSq

/-- Dominated convergence removes the regularization. The dominating function
is the integrable singular density, and the pointwise statements are required
only almost everywhere, explicitly excluding the origin. -/
lemma centeredCube3RadialCutoffRegularizedEnergy_tendsto_singularEnergy
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) :
    Tendsto (fun eps : ℝ => centeredCube3RadialCutoffRegularizedEnergy rho R eps index f)
      (𝓝[>] (0 : ℝ)) (𝓝 (centeredCube3RadialCutoffSingularEnergy rho R index f)) := by
  have hPos : ∀ᶠ eps : ℝ in 𝓝[>] (0 : ℝ), 0 < eps := self_mem_nhdsWithin
  have hMeas : ∀ᶠ eps : ℝ in 𝓝[>] (0 : ℝ), AEStronglyMeasurable
      (fun x : CenteredCube3Ambient => hardyRegularizedWeight eps x *
        ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) volume := by
    filter_upwards [hPos] with eps heps
    exact (centeredCube3RadialCutoffWaveZeroExtension_regularized_integrable
      heps hRhoR index f).aestronglyMeasurable
  have hBound : ∀ᶠ eps : ℝ in 𝓝[>] (0 : ℝ),
      ∀ᵐ x : CenteredCube3Ambient ∂volume,
        ‖hardyRegularizedWeight eps x *
            ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2‖ ≤
          (1 / centeredCube3AmbientRadiusSq x) *
            ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2 := by
    filter_upwards [hPos] with eps heps
    filter_upwards [centeredCube3AmbientRadiusSq_pos_ae] with x hx
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (hardyRegularizedWeight_nonneg heps x) (sq_nonneg _))]
    exact mul_le_mul_of_nonneg_right
      (hardyRegularizedWeight_le_singularWeight eps x hx) (sq_nonneg _)
  have hLimit : ∀ᵐ x : CenteredCube3Ambient ∂volume,
      Tendsto
        (fun eps : ℝ => hardyRegularizedWeight eps x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2)
        (𝓝[>] (0 : ℝ))
        (𝓝 ((1 / centeredCube3AmbientRadiusSq x) *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2)) := by
    filter_upwards [centeredCube3AmbientRadiusSq_pos_ae] with x hx
    exact (hardyRegularizedWeight_tendsto_singularWeight x (ne_of_gt hx)).mul_const _
  unfold centeredCube3RadialCutoffRegularizedEnergy centeredCube3RadialCutoffSingularEnergy
  exact tendsto_integral_filter_of_dominated_convergence
    (fun x : CenteredCube3Ambient => (1 / centeredCube3AmbientRadiusSq x) *
      ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2)
    hMeas hBound (centeredCube3RadialCutoff_singularDensity_integrable hRhoR index f) hLimit

/-- The genuine, nonregularized ambient Hardy inequality, with constant four,
for the actual cutoff wave and its actual raw-gradient zero extensions. -/
lemma centeredCube3RadialCutoff_ambient_hardy
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3) (f : α → ℂ) :
    centeredCube3RadialCutoffSingularEnergy rho R index f ≤
      4 * centeredCube3RadialCutoffAmbientGradientEnergy rho R index f := by
  have hLimit := centeredCube3RadialCutoffRegularizedEnergy_tendsto_singularEnergy
    hRhoR index f
  apply le_of_tendsto hLimit
  have hPos : ∀ᶠ eps : ℝ in 𝓝[>] (0 : ℝ), 0 < eps := self_mem_nhdsWithin
  filter_upwards [hPos] with eps heps
  exact centeredCube3RadialCutoff_regularized_hardy hrho hRhoR hOuterHalf heps index f

/-! ### Exact transport to the existing centered-cube norm formulation -/

/-- The squared-norm integral of a zero extension is exactly the original
centered-cube integral. We use the literal subtype underlying `CenteredCube3`
when invoking the comap integral theorem. -/
lemma centeredCube3ZeroExtension_integral_sq
    (g : CenteredCube3 → ℂ) :
    (∫ x : CenteredCube3Ambient, ‖centeredCube3ZeroExtension g x‖ ^ 2) =
      ∫ y : CenteredCube3, ‖g y‖ ^ 2 ∂centeredCube3Measure := by
  have hSet : MeasurableSet
      {x : CenteredCube3Ambient | ∀ i : Fin 3,
        x i ∈ Set.Ioc (centeredCube3Base i) (centeredCube3Base i + 1)} :=
    centeredCube3AmbientSet_measurable
  have hSub :
      (∫ y : CenteredCube3, ‖centeredCube3ZeroExtension g y.1‖ ^ 2 ∂centeredCube3Measure) =
        ∫ x in centeredCube3AmbientSet, ‖centeredCube3ZeroExtension g x‖ ^ 2 := by
    exact integral_subtype_comap (μ := (volume : Measure CenteredCube3Ambient)) hSet
      (fun x : CenteredCube3Ambient => ‖centeredCube3ZeroExtension g x‖ ^ 2)
  have hOn : (∫ x in centeredCube3AmbientSet, ‖centeredCube3ZeroExtension g x‖ ^ 2) =
      ∫ x : CenteredCube3Ambient, ‖centeredCube3ZeroExtension g x‖ ^ 2 := by
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    rw [centeredCube3ZeroExtension_eq_zero_of_not_mem g x hx]
    simp only [norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0)]
  calc
    (∫ x : CenteredCube3Ambient, ‖centeredCube3ZeroExtension g x‖ ^ 2) =
        ∫ y : CenteredCube3, ‖centeredCube3ZeroExtension g y.1‖ ^ 2 ∂centeredCube3Measure :=
      (hSub.trans hOn).symm
    _ = ∫ y : CenteredCube3, ‖g y‖ ^ 2 ∂centeredCube3Measure := by
      apply integral_congr_ae
      filter_upwards with y
      rw [centeredCube3ZeroExtension_subtype]

/-- Exact `L2` norm identity for a specified `MemLp.toLp` representative. The
real inner product avoids any conversion through extended-real powers. -/
lemma hardyMemLp_two_integral_sq_eq_norm_sq
    {β : Type*} [MeasurableSpace β]
    (μ : Measure β) (g : β → ℂ) (hg : MemLp g 2 μ) :
    (∫ y : β, ‖g y‖ ^ 2 ∂μ) = ‖hg.toLp g‖ ^ 2 := by
  calc
    (∫ y : β, ‖g y‖ ^ 2 ∂μ) =
        ∫ y : β, ‖(hg.toLp g) y‖ ^ 2 ∂μ := by
      apply integral_congr_ae
      filter_upwards [MemLp.coeFn_toLp hg] with y hy
      exact congrArg (fun z : ℂ => ‖z‖ ^ 2) hy.symm
    _ = inner ℝ (hg.toLp g) (hg.toLp g) := by
      rw [MeasureTheory.L2.inner_def]
      apply integral_congr_ae
      filter_upwards with y
      exact (real_inner_self_eq_norm_sq ((hg.toLp g) y)).symm
    _ = ‖hg.toLp g‖ ^ 2 := real_inner_self_eq_norm_sq _

/-- The singular ambient energy is exactly the localized `toLp` norm appearing
in the pre-existing Hardy interface, not just the norm of a new representative. -/
lemma centeredCube3RadialCutoffSingularEnergy_eq_localized_norm_sq
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) :
    centeredCube3RadialCutoffSingularEnergy rho R index f =
      ‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical hRhoR index f).toLp
        (centeredCube3RadialCutoffLocalizedFunction rho R index f)‖ ^ 2 := by
  unfold centeredCube3RadialCutoffSingularEnergy
  calc
    (∫ x : CenteredCube3Ambient,
        (1 / centeredCube3AmbientRadiusSq x) *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) =
        ∫ x : CenteredCube3Ambient,
          ‖centeredCube3RadialCutoffLocalizedZeroExtension rho R index f x‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with x
      exact (centeredCube3RadialCutoffLocalizedZeroExtension_sq_eq_singularDensity
        rho R index f x).symm
    _ = ∫ y : CenteredCube3,
        ‖centeredCube3RadialCutoffLocalizedContinuousFunction rho R index f y‖ ^ 2
          ∂centeredCube3Measure :=
      centeredCube3ZeroExtension_integral_sq
        (centeredCube3RadialCutoffLocalizedContinuousFunction rho R index f)
    _ = ∫ y : CenteredCube3,
        ‖centeredCube3RadialCutoffLocalizedFunction rho R index f y‖ ^ 2
          ∂centeredCube3Measure := by
      apply integral_congr_ae
      filter_upwards [centeredCube3RadialCutoffLocalizedFunction_eq_continuous_ae
        rho R index f] with y hy
      exact congrArg (fun z : ℂ => ‖z‖ ^ 2) hy.symm
    _ = ‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical hRhoR index f).toLp
        (centeredCube3RadialCutoffLocalizedFunction rho R index f)‖ ^ 2 :=
      hardyMemLp_two_integral_sq_eq_norm_sq centeredCube3Measure _
        (centeredCube3RadialCutoffLocalizedFunction_memLp_canonical hRhoR index f)

/-- The ambient gradient energy is exactly the sum of the three raw-gradient
`toLp` norms already used in the Hardy interface. -/
lemma centeredCube3RadialCutoffAmbientGradientEnergy_eq_norm_sq
    {α : Type} [Fintype α]
    {rho R : ℝ} (hrho : 0 < rho) (hRhoR : rho < R)
    (index : α → Lattice3) (f : α → ℂ) :
    centeredCube3RadialCutoffAmbientGradientEnergy rho R index f =
      ∑ j : Fin 3,
        ‖(centeredCube3RadialCutoffRawGradientFunction_memLp hrho hRhoR index f j).toLp
          (centeredCube3RadialCutoffRawGradientFunction rho R index f j)‖ ^ 2 := by
  unfold centeredCube3RadialCutoffAmbientGradientEnergy
  apply Finset.sum_congr rfl
  intro j hj
  change (∫ x : CenteredCube3Ambient,
      ‖centeredCube3ZeroExtension
        (centeredCube3RadialCutoffRawGradientFunction rho R index f j) x‖ ^ 2) = _
  rw [centeredCube3ZeroExtension_integral_sq]
  exact hardyMemLp_two_integral_sq_eq_norm_sq centeredCube3Measure _
    (centeredCube3RadialCutoffRawGradientFunction_memLp hrho hRhoR index f j)

/-- The constant-four Hardy estimate in exactly the old centered-cube `L2`
formulation. It requires only the geometric cutoff hypotheses. -/
lemma centeredCube3RadialCutoff_hardy
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3) (f : α → ℂ) :
    ‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical hRhoR index f).toLp
        (centeredCube3RadialCutoffLocalizedFunction rho R index f)‖ ^ 2 ≤
      4 * (∑ j : Fin 3,
        ‖(centeredCube3RadialCutoffRawGradientFunction_memLp hrho hRhoR index f j).toLp
          (centeredCube3RadialCutoffRawGradientFunction rho R index f j)‖ ^ 2) := by
  have hHardy := centeredCube3RadialCutoff_ambient_hardy hrho hRhoR hOuterHalf index f
  rw [centeredCube3RadialCutoffSingularEnergy_eq_localized_norm_sq hRhoR index f,
    centeredCube3RadialCutoffAmbientGradientEnergy_eq_norm_sq hrho hRhoR index f] at hHardy
  exact hHardy

/-- The pre-squared estimate required by `CenteredCube3RadialCutoffHardyCrossData`,
now proved rather than supplied as an analytic hypothesis. -/
lemma centeredCube3RadialCutoff_hardy_cross_bound
    {α : Type} [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (hOuterHalf : R < (1 / 2 : ℝ))
    (index : α → Lattice3) (f : α → ℂ) :
    ‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical hRhoR index f).toLp
        (centeredCube3RadialCutoffLocalizedFunction rho R index f)‖ ^ 2 ≤
      2 * Real.sqrt
          (‖(centeredCube3RadialCutoffLocalizedFunction_memLp_canonical hRhoR index f).toLp
            (centeredCube3RadialCutoffLocalizedFunction rho R index f)‖ ^ 2) *
        Real.sqrt (∑ j : Fin 3,
          ‖(centeredCube3RadialCutoffRawGradientFunction_memLp hrho hRhoR index f j).toLp
            (centeredCube3RadialCutoffRawGradientFunction rho R index f j)‖ ^ 2) := by
  apply hardy_cross_bound_of_four_mul_bound
  · exact sq_nonneg _
  · exact Finset.sum_nonneg (fun j hj => sq_nonneg _)
  · exact centeredCube3RadialCutoff_hardy hrho hRhoR hOuterHalf index f

/-- The formerly assumed local Hardy data follow from `0 < rho < R < 1/2`.
No injectivity premise is used by the analytic proof, although the existing
interface retains it for compatibility with the rest of the certificate. -/
theorem centeredCube3RadialCutoffHardyCrossData_of_radii
    {rho R : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (hOuterHalf : R < (1 / 2 : ℝ)) :
    CenteredCube3RadialCutoffHardyCrossData rho R where
  rho_pos := hrho
  rho_lt_outer := hRhoR
  outer_lt_half := hOuterHalf
  hardy_cross_bound := by
    intro α inst index hInjective f
    exact centeredCube3RadialCutoff_hardy_cross_bound hrho hRhoR hOuterHalf index f

/-- The same closed proof also supplies the constant-four pointwise Hardy
interface used before the cross-estimate reduction. -/
theorem centeredCube3RadialCutoffPointwiseHardyData_of_radii
    {rho R : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (hOuterHalf : R < (1 / 2 : ℝ)) :
    CenteredCube3RadialCutoffPointwiseHardyData rho R :=
  (centeredCube3RadialCutoffHardyCrossData_of_radii hrho hRhoR hOuterHalf).toPointwiseHardyData

/-!
## One-hundred-eighth milestone

For the actual wave U and its actual raw gradient, the singular energy is the
limit of the regularized energies as epsilon decreases to zero. Dominated
convergence is justified by the previously established inverse-radius `L2`
integrability, not by the inequality being proved. Only the origin is excluded
from the pointwise limit and domination; it is a Lebesgue-null singleton.

The resulting ambient inequality is transported exactly to the centered-cube
`MemLp.toLp` norms. Both `CenteredCube3RadialCutoffHardyCrossData` and
`CenteredCube3RadialCutoffPointwiseHardyData` can therefore be constructed from
the geometric radius hypotheses alone.

The BO wrapper below is a partial application of the existing end-to-end theorem
with this proved Hardy data. Its remaining parameters are inherited unchanged:
the regular periodic remainder and its canonical decomposition, the specified
finite Hamiltonian and its hypotheses, regularity and scale bounds, and the
spectral/Galerkin assumptions. This milestone closes the local cutoff Hardy
branch; it does not claim to close those separate branches of the manuscript.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open Filter MeasureTheory

/-- Keep the torus measure identical to the Fourier and centered-cube APIs. -/
local instance unitAddCircleMeasureSpaceForFourier109 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-! ## One-hundred-ninth milestone: canonical periodic Coulomb remainder

The local Hardy inequality is now proved.  We next remove the independently
supplied state decomposition.  The remainder is the actual difference between
the canonical Fourier-defined potential and the existing pi/r singularity.
It belongs to L2 without any boundedness assumption.  Its multiplication state
has an exact decomposition on every finite Fourier polynomial.

An almost-everywhere bound on this *specified* remainder is still an analytic
hypothesis.  From that bound we construct an everywhere-bounded representative,
prove that changing its exceptional values does not change the multiplication
state, and supply the old regular-multiplier/decomposition inputs automatically.
This section does not prove the remainder bound or an Ewald representation.
-/

/-- The intrinsic inverse radius is in L2 on the torus, by the previously
proved centered-cube integrability and the measure-preserving equivalence. -/
lemma unitTorus3InverseRadius_memLp :
    MemLp (fun x : UnitTorus3 => (unitTorus3InverseRadius x : ℂ)) 2 volume := by
  have hPull := centeredCube3InverseRadius_memLp.comp_measurePreserving
    unitTorus3CenteredEquiv_measurePreserving
  have hEq :
      ((fun y : CenteredCube3 => (centeredCube3InverseRadius y : ℂ)) ∘
        (unitTorus3CenteredEquiv : UnitTorus3 → CenteredCube3)) =ᵐ[volume]
      (fun x : UnitTorus3 => (unitTorus3InverseRadius x : ℂ)) := by
    filter_upwards with x
    simp only [Function.comp_apply, centeredCube3InverseRadius_centeredEquiv]
  exact (memLp_congr_ae hEq).1 hPull

/-- The correctly normalized pi/r singularity is an L2 function. -/
lemma unitTorus3CanonicalCoulombSingular_memLp :
    MemLp unitTorus3CanonicalCoulombSingular 2 volume := by
  have h := unitTorus3InverseRadius_memLp.const_mul (Real.pi : ℂ)
  have hEq :
      (fun x : UnitTorus3 => (Real.pi : ℂ) * (unitTorus3InverseRadius x : ℂ))
        =ᵐ[volume] unitTorus3CanonicalCoulombSingular := by
    filter_upwards with x
    simp only [unitTorus3CanonicalCoulombSingular, Complex.ofReal_mul]
  exact (memLp_congr_ae hEq).1 h

/-- The specified periodic Coulomb remainder.  This definition is independent
of the Hardy cutoff radii and of all finite Fourier coefficients.  "Remainder"
here does not assert that the difference has already been proved bounded. -/
noncomputable def canonicalUnitTorus3CoulombRemainder (x : UnitTorus3) : ℂ :=
  canonicalUnitTorus3CoulombPotential.potential x - unitTorus3CanonicalCoulombSingular x

lemma canonicalUnitTorus3CoulombRemainder_memLp :
    MemLp canonicalUnitTorus3CoulombRemainder 2 volume := by
  unfold canonicalUnitTorus3CoulombRemainder
  exact canonicalUnitTorus3CoulombPotential.potential_memLp.sub
    unitTorus3CanonicalCoulombSingular_memLp

lemma canonicalUnitTorus3CoulombRemainder_aestronglyMeasurable :
    AEStronglyMeasurable canonicalUnitTorus3CoulombRemainder volume :=
  canonicalUnitTorus3CoulombRemainder_memLp.aestronglyMeasurable

/-- The finite sum of basis-product states is actual multiplication by the
potential, almost everywhere.  No injectivity of the finite index map is needed. -/
lemma UnitTorus3CoulombPotentialRealization.productState_eq_mul_continuous_ae
    (data : UnitTorus3CoulombPotentialRealization)
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    ∀ᵐ x : UnitTorus3 ∂volume,
      data.productState index f x =
        data.potential x * torus3FourierContinuousPolynomial index f x := by
  classical
  have hSum : ∀ᵐ x : UnitTorus3 ∂volume,
      (∑ p : α, f p • data.basisProductState (index p)) x =
        ∑ p : α, (f p • data.basisProductState (index p)) x := by
    have hRaw := Lp.coeFn_finsetSum (Finset.univ : Finset α)
      (fun p : α => f p • data.basisProductState (index p))
    filter_upwards [hRaw] with x hx
    simpa only [Finset.sum_apply] using hx
  have hTerms : ∀ᵐ x : UnitTorus3 ∂volume, ∀ p : α,
      (f p • data.basisProductState (index p)) x =
        f p * (data.potential x * UnitAddTorus.mFourier (index p) x) := by
    rw [Filter.eventually_all]
    intro p
    have hSmul := Lp.coeFn_smul (f p) (data.basisProductState (index p))
    have hBasis : ∀ᵐ x : UnitTorus3 ∂volume,
        data.basisProductState (index p) x =
          data.potential x * UnitAddTorus.mFourier (index p) x := by
      unfold UnitTorus3CoulombPotentialRealization.basisProductState
      exact MemLp.coeFn_toLp (data.basis_memLp (index p))
    filter_upwards [hSmul, hBasis] with x hs hb
    rw [hs]
    change f p * data.basisProductState (index p) x = _
    rw [hb]
  filter_upwards [hSum, hTerms] with x hsum hterms
  unfold UnitTorus3CoulombPotentialRealization.productState
  rw [hsum]
  unfold torus3FourierContinuousPolynomial
  rw [ContinuousMap.sum_apply]
  simp only [ContinuousMap.smul_apply, smul_eq_mul]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p hp
  rw [hterms p]
  ring

/-- The same product identity using the existing Lp representative of the
Fourier polynomial, so it matches the rest of the certificate directly. -/
lemma UnitTorus3CoulombPotentialRealization.productState_eq_mul_ae
    (data : UnitTorus3CoulombPotentialRealization)
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    ∀ᵐ x : UnitTorus3 ∂volume,
      data.productState index f x = data.potential x * torus3FourierPolynomial index f x := by
  filter_upwards [data.productState_eq_mul_continuous_ae index f,
    torus3FourierPolynomial_eq_continuous_ae index f] with x hProduct hPoly
  rw [hProduct, hPoly]

/-- Multiplication by a finite Fourier polynomial preserves L2.  The auxiliary
coefficient l1 bound is used only for existence of this multiplication state. -/
lemma torus3_memLp_mul_fourierPolynomial
    (g : UnitTorus3 → ℂ) (hg : MemLp g 2 volume)
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    MemLp (fun x : UnitTorus3 => g x * torus3FourierPolynomial index f x) 2 volume := by
  let C : ℝ := finiteSupportL1Norm f
  have hC : 0 ≤ C := finiteSupportL1Norm_nonneg f
  have hMeas : AEStronglyMeasurable
      (fun x : UnitTorus3 => g x * torus3FourierContinuousPolynomial index f x) volume :=
    hg.aestronglyMeasurable.fun_mul
      (torus3FourierContinuousPolynomial index f).continuous.aestronglyMeasurable
  have hContinuous : MemLp
      (fun x : UnitTorus3 => g x * torus3FourierContinuousPolynomial index f x) 2 volume := by
    apply (hg.const_mul (C : ℂ)).of_le hMeas
    filter_upwards with x
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hC]
    calc
      ‖g x‖ * ‖torus3FourierContinuousPolynomial index f x‖ ≤ ‖g x‖ * C :=
        mul_le_mul_of_nonneg_left
          (torus3FourierContinuousPolynomial_pointwise_norm_le_l1 index f x) (norm_nonneg _)
      _ = C * ‖g x‖ := mul_comm _ _
  have hEq :
      (fun x : UnitTorus3 => g x * torus3FourierPolynomial index f x) =ᵐ[volume]
      (fun x : UnitTorus3 => g x * torus3FourierContinuousPolynomial index f x) := by
    filter_upwards [torus3FourierPolynomial_eq_continuous_ae index f] with x hx
    rw [hx]
  exact (memLp_congr_ae hEq).2 hContinuous

/-- The canonical remainder has a multiplication state on every finite Fourier
polynomial, whether or not its L-infinity bound has yet been established. -/
noncomputable def canonicalUnitTorus3CoulombRemainderProductState
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) : UnitTorus3L2 :=
  (torus3_memLp_mul_fourierPolynomial canonicalUnitTorus3CoulombRemainder
    canonicalUnitTorus3CoulombRemainder_memLp index f).toLp
    (fun x : UnitTorus3 =>
      canonicalUnitTorus3CoulombRemainder x * torus3FourierPolynomial index f x)

lemma canonicalUnitTorus3CoulombRemainderProductState_eq_ae
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    ∀ᵐ x : UnitTorus3 ∂volume,
      canonicalUnitTorus3CoulombRemainderProductState index f x =
        canonicalUnitTorus3CoulombRemainder x * torus3FourierPolynomial index f x := by
  unfold canonicalUnitTorus3CoulombRemainderProductState
  exact MemLp.coeFn_toLp
    (torus3_memLp_mul_fourierPolynomial canonicalUnitTorus3CoulombRemainder
      canonicalUnitTorus3CoulombRemainder_memLp index f)

/-- Representatives of the cube-to-torus transport are the expected composition
almost everywhere, in the exact measure normalization used by the Fourier API. -/
lemma centeredCube3StateToTorus_eq_ae (u : CenteredCube3L2) :
    ∀ᵐ x : UnitTorus3 ∂volume,
      centeredCube3StateToTorus u x = u (unitTorus3CenteredEquiv x) := by
  unfold centeredCube3StateToTorus
  have h := Lp.coeFn_compMeasurePreserving u unitTorus3CenteredEquiv_measurePreserving
  filter_upwards [h] with x hx
  simpa only [Function.comp_apply] using hx

/-- Every existing cutoff realization has the same Coulomb singular product
representative.  The auxiliary Hardy radii do not change the resulting L2 state. -/
lemma CenteredCube3InverseRadiusCutoffData.coulombSingularState_eq_ae
    {Ainner Douter : ℝ} (data : CenteredCube3InverseRadiusCutoffData Ainner Douter)
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    ∀ᵐ x : UnitTorus3 ∂volume,
      data.coulombSingularState index f x =
        unitTorus3CanonicalCoulombSingular x * torus3FourierPolynomial index f x := by
  let u : CenteredCube3L2 := data.productState α index f
  have hCube := data.product_eq_ae α index f
  have hPull := unitTorus3CenteredEquiv_measurePreserving.quasiMeasurePreserving.ae hCube
  have hTransport := centeredCube3StateToTorus_eq_ae u
  have hSmul := Lp.coeFn_smul (Real.pi : ℂ) (centeredCube3StateToTorus u)
  filter_upwards [hPull, hTransport, hSmul] with x hc ht hs
  unfold CenteredCube3InverseRadiusCutoffData.coulombSingularState
  change ((Real.pi : ℂ) • centeredCube3StateToTorus u) x = _
  rw [hs]
  change (Real.pi : ℂ) * centeredCube3StateToTorus u x = _
  rw [ht]
  change (Real.pi : ℂ) * data.productState α index f (unitTorus3CenteredEquiv x) = _
  rw [hc, centeredCube3InverseRadius_centeredEquiv]
  simp only [MeasurableEquiv.symm_apply_apply, unitTorus3CanonicalCoulombSingular,
    Complex.ofReal_mul, mul_assoc]

/-- Unconditional exact decomposition of the canonical potential multiplication
state.  Boundedness of the remainder is not used in this identity. -/
lemma canonicalUnitTorus3CoulombProductState_eq_singular_add_remainder
    {Ainner Douter : ℝ} (cutoff : CenteredCube3InverseRadiusCutoffData Ainner Douter)
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    canonicalUnitTorus3CoulombPotential.toPotentialRealization.productState index f =
      cutoff.coulombSingularState index f + canonicalUnitTorus3CoulombRemainderProductState index f := by
  apply Lp.ext
  have hPotential :=
    canonicalUnitTorus3CoulombPotential.toPotentialRealization.productState_eq_mul_ae index f
  have hSingular := cutoff.coulombSingularState_eq_ae index f
  have hRemainder := canonicalUnitTorus3CoulombRemainderProductState_eq_ae index f
  have hAdd := Lp.coeFn_add (cutoff.coulombSingularState index f)
    (canonicalUnitTorus3CoulombRemainderProductState index f)
  filter_upwards [hPotential, hSingular, hRemainder, hAdd] with x hp hs hr ha
  rw [ha]
  simp only [Pi.add_apply]
  rw [hp, hs, hr]
  change canonicalUnitTorus3CoulombPotential.potential x * torus3FourierPolynomial index f x = _
  unfold canonicalUnitTorus3CoulombRemainder
  ring

/-- An explicit truncation used solely to select an everywhere-bounded version
of an almost-everywhere-bounded function.  Under the a.e. bound it changes only
exceptional values, not the L2 multiplication operator. -/
noncomputable def unitTorus3BoundedRepresentative (g : UnitTorus3 → ℂ) (B : ℝ)
    (x : UnitTorus3) : ℂ :=
  if ‖g x‖ ≤ B then g x else 0

lemma unitTorus3BoundedRepresentative_eq_ae
    (g : UnitTorus3 → ℂ) (B : ℝ)
    (hBound : ∀ᵐ x : UnitTorus3 ∂volume, ‖g x‖ ≤ B) :
    unitTorus3BoundedRepresentative g B =ᵐ[volume] g := by
  filter_upwards [hBound] with x hx
  simp only [unitTorus3BoundedRepresentative, if_pos hx]

/-- Turn an essential norm bound into the existing pointwise bounded-multiplier
interface, without strengthening it at the origin or on any other null set. -/
noncomputable def UnitTorus3BoundedMultiplier.of_ae_norm_le
    (g : UnitTorus3 → ℂ) (hg : AEStronglyMeasurable g volume)
    {B : ℝ} (hB : 0 ≤ B)
    (hBound : ∀ᵐ x : UnitTorus3 ∂volume, ‖g x‖ ≤ B) :
    UnitTorus3BoundedMultiplier B where
  multiplier := unitTorus3BoundedRepresentative g B
  multiplier_aestronglyMeasurable :=
    hg.congr (unitTorus3BoundedRepresentative_eq_ae g B hBound).symm
  bound_nonneg := hB
  norm_le := by
    intro x
    by_cases hx : ‖g x‖ ≤ B
    · simpa only [unitTorus3BoundedRepresentative, if_pos hx] using hx
    · simpa only [unitTorus3BoundedRepresentative, if_neg hx, norm_zero] using hB

lemma UnitTorus3BoundedMultiplier.productState_eq_ae
    {B : ℝ} (data : UnitTorus3BoundedMultiplier B) (ψ : UnitTorus3L2) :
    ∀ᵐ x : UnitTorus3 ∂volume, data.productState ψ x = data.multiplier x * ψ x := by
  unfold UnitTorus3BoundedMultiplier.productState
  exact MemLp.coeFn_toLp (data.product_memLp ψ)

/-- The regular multiplier selected from the actual canonical Coulomb remainder.
The essential bound remains explicit until the periodic Green-function analysis
has established it. -/
noncomputable def canonicalUnitTorus3CoulombRemainderMultiplier
    {B : ℝ} (hB : 0 ≤ B)
    (hBound : ∀ᵐ x : UnitTorus3 ∂volume,
      ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ B) : UnitTorus3BoundedMultiplier B :=
  UnitTorus3BoundedMultiplier.of_ae_norm_le canonicalUnitTorus3CoulombRemainder
    canonicalUnitTorus3CoulombRemainder_aestronglyMeasurable hB hBound

lemma canonicalUnitTorus3CoulombRemainderMultiplier_eq_ae
    {B : ℝ} (hB : 0 ≤ B)
    (hBound : ∀ᵐ x : UnitTorus3 ∂volume,
      ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ B) :
    (canonicalUnitTorus3CoulombRemainderMultiplier hB hBound).multiplier =ᵐ[volume]
      canonicalUnitTorus3CoulombRemainder := by
  exact unitTorus3BoundedRepresentative_eq_ae canonicalUnitTorus3CoulombRemainder B hBound

/-- Truncating the null exceptional values leaves the canonical remainder's
multiplication state unchanged. -/
lemma canonicalUnitTorus3CoulombRemainderMultiplier_productState_eq
    {B : ℝ} (hB : 0 ≤ B)
    (hBound : ∀ᵐ x : UnitTorus3 ∂volume,
      ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ B)
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    (canonicalUnitTorus3CoulombRemainderMultiplier hB hBound).productState
        (torus3FourierPolynomial index f) =
      canonicalUnitTorus3CoulombRemainderProductState index f := by
  apply Lp.ext
  have hProduct := (canonicalUnitTorus3CoulombRemainderMultiplier hB hBound).productState_eq_ae
    (torus3FourierPolynomial index f)
  have hMultiplier := canonicalUnitTorus3CoulombRemainderMultiplier_eq_ae hB hBound
  have hRemainder := canonicalUnitTorus3CoulombRemainderProductState_eq_ae index f
  filter_upwards [hProduct, hMultiplier, hRemainder] with x hp hm hr
  rw [hp, hm, hr]

/-- The missing hCanonicalDecomp input follows from the specified scalar
remainder's essential bound; no separate operator equality is assumed. -/
lemma canonicalUnitTorus3Coulomb_decomposition_of_remainder_bound
    {Ainner Douter B : ℝ} (cutoff : CenteredCube3InverseRadiusCutoffData Ainner Douter)
    (hB : 0 ≤ B)
    (hBound : ∀ᵐ x : UnitTorus3 ∂volume,
      ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ B)
    {α : Type} [Fintype α] (index : α → Lattice3) (f : α → ℂ) :
    canonicalUnitTorus3CoulombPotential.toPotentialRealization.productState index f =
      cutoff.coulombSingularState index f +
        (canonicalUnitTorus3CoulombRemainderMultiplier hB hBound).productState
          (torus3FourierPolynomial index f) := by
  rw [canonicalUnitTorus3CoulombRemainderMultiplier_productState_eq hB hBound index f]
  exact canonicalUnitTorus3CoulombProductState_eq_singular_add_remainder cutoff index f

/-!
## One-hundred-ninth milestone

The remainder V_per - pi/r is now a specified L2 function, and its product
state on every finite Fourier polynomial is constructed.  The exact equality
V_per psi = singular psi + remainder psi is proved without a boundedness
hypothesis.  It matches every cutoff realization of the singular product,
including the one built from the discharged Hardy data.

Assuming an a.e. norm bound B for this one specified remainder, a bounded
representative is constructed without imposing extra pointwise conditions at
exceptional points.  It gives exactly the same product state and the norm bound
||remainder psi||_2^2 <= B^2 ||psi||_2^2.  This supplies both the old arbitrary
regular multiplier and hCanonicalDecomp inputs.

The end-to-end wrapper below retains the scalar remainder bound explicitly.
It does not prove that bound, an Ewald expansion, the other physical-potential
bounds, regularity, or the spectral/Galerkin bridge.  Proving boundedness of the
specified remainder is the next periodic-potential analytic target.
-/

end

