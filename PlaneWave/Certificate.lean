    (q p : FourierConfig eta Lattice3) : ℂ := by
  classical
  exact if p = q then (1 / 2 : ℂ) *
    ((∑ i : Fin eta, (2 * Real.pi / L) ^ 2 * latticeNormSq (q i) : ℝ) : ℂ) else 0

