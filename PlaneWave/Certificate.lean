/-- `2 t ≤ α t² + 1/α`. -/
lemma two_mul_le_sq_add (α t : ℝ) (hα : 0 < α) : 2 * t ≤ α * t ^ 2 + 1 / α := by
  have h : 0 ≤ α * (t - 1 / α) ^ 2 := mul_nonneg hα.le (sq_nonneg _)
  have h2 : α * (t - 1 / α) ^ 2 = α * t ^ 2 - 2 * t + 1 / α := by
    field_simp
    ring
  linarith

omit [Fintype ν] in
/-- The mass-weighted `H¹` quantity of a cubic extraction is controlled by the kinetic energy
and the `L²` norm. -/
lemma weightedNormSq_extract_le (g : ℝ) (x : MolecularFourierH2 eta) (count : ℕ) {α : ℝ}
    (hα : 0 < α) :
    weightedNormSq (fun p => 1 + massKineticSymbol sys.mass (finitePlaneWaveKabs g count) p)
        (fullCoeffVector (finiteFourierCoeffExtract count (molecularH2Coeff g x))) ≤
      α * ‖coulombFourierKineticH2 sys g x‖ ^ 2 + (1 + 1 / α) *
          ‖molecularH2StateMap eta g x‖ ^ 2 := by
