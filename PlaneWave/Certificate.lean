/-!
# Dynamics: propagated regularity and the potential tail

`prop:dyn-reg` (the uniform-in-time regularity constant `Ξ`) and `eq:lam-gen` (the potential tail
of a general `H²` state) for a periodic Coulomb system, in Fourier coordinates.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveDynamics

open PlaneWaveCertificate

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-! ## A. The elliptic estimate and propagated regularity -/

section Regularity

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

/-- The constant `b = C √(4C² + 2)` of the relative bound `‖W u‖ ≤ ½ ‖T u‖ + b ‖S u‖`. -/
noncomputable def relB : ℝ :=
  finiteCoulombPhysicalMassConstant sys L Hunit *
    Real.sqrt (4 * finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 + 2)

lemma relB_nonneg (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) : 0 ≤ relB sys L Hunit :=
  mul_nonneg hC (Real.sqrt_nonneg _)

include hKernel hL hPeriodic in
/-- `‖W u‖ ≤ ½ ‖T u‖ + b ‖S u‖`. -/
theorem potential_le_half (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (u : MolecularFourierH2 eta) :
    ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H u‖ ≤
      (1 / 2) * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ +
        relB sys L Hunit * ‖molecularH2StateMap eta (2 * Real.pi / L) u‖ := by
  have h := potential_sq_le_quarter sys L H hKernel Hunit hL hPeriodic u
  set C := finiteCoulombPhysicalMassConstant sys L Hunit
  set X := ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖
  set Y := ‖molecularH2StateMap eta (2 * Real.pi / L) u‖
  have hb2 : relB sys L Hunit ^ 2 = C ^ 2 * (4 * C ^ 2 + 2) := by
    rw [relB, mul_pow, Real.sq_sqrt (by positivity)]
  have hX := norm_nonneg (coulombFourierKineticH2 sys (2 * Real.pi / L) u)
  have hY := norm_nonneg (molecularH2StateMap eta (2 * Real.pi / L) u)
  have hb := relB_nonneg sys L Hunit hC
  have h2 : ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H u‖ ^ 2 ≤
      ((1 / 2) * X + relB sys L Hunit * Y) ^ 2 := by
    calc _ ≤ 1 / 4 * X ^ 2 + C ^ 2 * (4 * C ^ 2 + 2) * Y ^ 2 := h
      _ ≤ ((1 / 2) * X + relB sys L Hunit * Y) ^ 2 := by
          rw [← hb2]
          nlinarith [mul_nonneg hX (mul_nonneg hb hY)]
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp h2

include hKernel hL hPeriodic in
/-- **Elliptic estimate.** `‖T u‖ ≤ 2 ‖H u‖ + 2b ‖S u‖`. -/
theorem kinetic_le_elliptic (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (u : MolecularFourierH2 eta) :
    ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ ≤
      2 * ‖H u‖ + 2 * relB sys L Hunit * ‖molecularH2StateMap eta (2 * Real.pi / L) u‖ := by
  have hW := potential_le_half sys L H hKernel Hunit hL hPeriodic hC u
  have hdec := coulombFourierHamiltonianH2_decomposition sys (2 * Real.pi / L) H u
  have hT : coulombFourierKineticH2 sys (2 * Real.pi / L) u =
      H u - coulombFourierPotentialH2 sys (2 * Real.pi / L) H u := by
    rw [hdec]
