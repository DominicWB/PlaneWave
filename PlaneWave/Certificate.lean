lemma h1f_truncate_le (N : ℕ) (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    h1f sys L (molecularH2Truncate N u) p ≤ h1f sys L u p := by
  classical
  simp only [h1f]
  rw [molecularH2Coeff_truncate]
  by_cases hp : p ∈ fourierConfigCube eta N
  · rw [cubicLatticeCoeffTruncate_eq_of_mem N _ p hp]
  · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem N _ p hp, norm_zero]
    have := h1f_nonneg sys L u p
    simp only [h1f] at this
    nlinarith

