      finiteFourierLpEmbed eta count
        (finiteCoulombPotential sys (coulombCellAmplitude L) count
          (fullCoeffVector (finiteFourierCoeffExtract count
            (molecularH2Coeff (2 * Real.pi / L) (molecularH2Truncate N u))))).ofLp := by
  rw [← fourierKernelFiniteOutput_pot_eq]
  exact (fourierKernelFiniteOutput_embed_eq_truncate (2 * Real.pi / L) (potKernel sys L) N u _
    (fun q => coulombFourierPotentialH2_core sys L H hKernel N u q) count hN).symm

