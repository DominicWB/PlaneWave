depend on `a`). -/
theorem thm_dyn_spin_species_hchi (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (D : ℕ) :
    ∃ U : ℝ → CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D,
      (∀ Ψ, U 0 Ψ = Ψ) ∧
      (∀ s t Ψ, U (s + t) Ψ = U s (U t Ψ)) ∧
