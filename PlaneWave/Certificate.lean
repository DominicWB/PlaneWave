/-- The completed signed potential is literal Coulomb multiplication on the
entire H2 domain. The plus sign in the nuclear position shift is the convention
of the original lattice kernel; no potential identification is assumed. -/
theorem molecularPositionPotentialH2_fourierConventionPointwise
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeHamiltonianKernel eta L data) N u q)
    (u : MolecularFourierH2 eta) :
    HasL2PointwisePotential volume
      (molecularFourierConventionCoulombPotential eta L data)
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (molecularPositionPotentialH2 (2 * Real.pi / L) H u) :=
  molecularPositionPotentialH2_pointwise_of_fourierCoeff eta L data H hKernel
    (molecularFourierConventionCoulombPotential eta L data)
    (molecularFourierConventionCoulombPotential_memLp eta L data)
    (molecularFourierConventionCoulombPotential_fourierCoeff eta L data hL) u

/-- The signed Coulomb Hamiltonian relation, defined independently of the
completed Fourier operator. The potential term is an actual pointwise product,
and the kinetic residual satisfies the ordinary C2 periodic weak equation.
Nuclear coordinates use the positive Fourier-phase convention of the existing
kernel, hence the nuclear function is evaluated at x_i + R_A. -/
def HasMolecularFourierConventionCoulombHamiltonian
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (f h : MolecularPositionL2 eta) : Prop :=
  ∃ v : MolecularPositionL2 eta,
    HasL2PointwisePotential volume
      (molecularFourierConventionCoulombPotential eta L data) f v ∧
    HasMolecularContDiffWeakKinetic eta L f (h - v)

/-- Every completed H2 state satisfies the independently defined Coulomb
Hamiltonian relation. -/
theorem molecularPositionHamiltonianH2_fourierConventionCoulomb
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeHamiltonianKernel eta L data) N u q)
    (u : MolecularFourierH2 eta) :
    HasMolecularFourierConventionCoulombHamiltonian eta L data
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (molecularPositionHamiltonianH2 H u) :=
  ⟨molecularPositionPotentialH2 (2 * Real.pi / L) H u,
    molecularPositionPotentialH2_fourierConventionPointwise eta L data hL H hKernel u,
    molecularPositionHamiltonianH2_sub_potential_contDiffWeak eta L H u⟩

/-- Exact graph identification: the independently specified signed Coulomb
Hamiltonian has precisely the constructed H2 domain and completed action.
The reverse implication recovers H2 regularity from the standard weak kinetic
relation and uses uniqueness of literal multiplication. -/
theorem hasMolecularFourierConventionCoulombHamiltonian_iff_H2
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeHamiltonianKernel eta L data) N u q)
    (f h : MolecularPositionL2 eta) :
    HasMolecularFourierConventionCoulombHamiltonian eta L data f h ↔
      ∃ u : MolecularFourierH2 eta,
        molecularPositionH2StateMap eta (2 * Real.pi / L) u = f ∧
        molecularPositionHamiltonianH2 H u = h := by
  constructor
  · rintro ⟨v, hv, hweak⟩
    obtain ⟨u, huState, huKinetic⟩ :=
      (hasMolecularContDiffWeakKinetic_iff_H2 eta L f (h - v)).mp hweak
    have huPotential :=
      molecularPositionPotentialH2_fourierConventionPointwise eta L data hL H hKernel u
    rw [huState] at huPotential
    have huValue : molecularPositionPotentialH2 (2 * Real.pi / L) H u = v :=
      huPotential.unique hv
    refine ⟨u, huState, ?_⟩
    rw [molecularPositionHamiltonianH2_decomposition (2 * Real.pi / L) H u,
      huKinetic, huValue, sub_add_cancel]
  · rintro ⟨u, rfl, rfl⟩
    exact molecularPositionHamiltonianH2_fourierConventionCoulomb eta L data hL H hKernel u

end
