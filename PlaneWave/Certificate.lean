-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open MeasureTheory

/-- Match the torus measure used by the established Coulomb Fourier bridges. -/
local instance unitAddCircleMeasureSpaceForFourier114 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-! ## One-hundred-fourteenth milestone: pair-fiber Hardy bounds and the full molecular form

For a fixed electron pair, the kernel is block diagonal in spectator momenta and
exact total pair momentum.  Within a block, one electron's lattice momentum is
injective.  The already proved arbitrary-finite-support Coulomb estimate therefore
applies to that block, even when the finite-basis boundary makes it an irregular
subset of the one-particle mode set.  Exact finite recombination introduces no
factor for the number or sizes of the blocks.

This section proves the H1-to-L2 and absolute quadratic-form bounds for the FULL
signed molecular potential constructed in milestone 113.  The periodic remainder
bound remains the agreed background input.  No pair Hardy inequality, pair form
bound, or full-potential form bound is added as an assumption in the specialization.
The full potential-TAIL estimate remains a separate analytic obligation.
-/

/-! ### Exact finite recombination, with no infinite label sum -/

/-- Recombination over the finite image of a label, even if its codomain is infinite.
In the pair application the codomain contains Z^3; only the actual finite image
is summed over. -/
lemma finite_sum_over_image_fibers
    {ι β M : Type*} [Fintype ι] [DecidableEq β] [AddCommMonoid M]
    (label : ι → β) (f : ι → M) :
    (∑ b ∈ Finset.univ.image label,
      ∑ p : {p : ι // label p = b}, f p.1) = ∑ p : ι, f p := by
  classical
  calc
    (∑ b ∈ Finset.univ.image label,
        ∑ p : {p : ι // label p = b}, f p.1) =
        ∑ b ∈ Finset.univ.image label,
          ∑ p ∈ Finset.univ.filter (fun p : ι => label p = b), f p := by
      apply Finset.sum_congr rfl
      intro b hb
      exact (Finset.sum_subtype
        (Finset.univ.filter (fun p : ι => label p = b))
        (fun p => by simp) f).symm
    _ = ∑ p : ι, f p := by
      apply Finset.sum_fiberwise_of_maps_to
      intro p hp
      exact Finset.mem_image_of_mem label hp

/-- A block-diagonal finite matrix inherits a common weighted squared-norm bound
from its exact fibers.  Neither positivity of matrix entries nor equal fiber
sizes is required.  The input coefficient family is arbitrary. -/
lemma finiteCoefficientKernelOperator_norm_sq_le_of_fibers
    {ι β : Type*} [Fintype ι] [DecidableEq β]
    (label : ι → β) (kernel : ι → ι → ℂ) (weight : ι → ℝ) (D : ℝ)
    (hOff : ∀ q p : ι, label q ≠ label p → kernel q p = 0)
    (hFiber : ∀ b : β, ∀ c : {p : ι // label p = b} → ℂ,
      (∑ q : {p : ι // label p = b},
        ‖∑ p : {p : ι // label p = b}, c p * kernel q.1 p.1‖ ^ 2) ≤
      D * (∑ p : {p : ι // label p = b}, weight p.1 * ‖c p‖ ^ 2))
    (u : EuclideanSpace ℂ ι) :
    ‖finiteCoefficientKernelOperator kernel u‖ ^ 2 ≤
      D * (∑ p : ι, weight p * ‖u.ofLp p‖ ^ 2) := by
  classical
  have hAction (b : β) (q : {p : ι // label p = b}) :
      (∑ p : ι, u.ofLp p * kernel q.1 p) =
        ∑ p : {p : ι // label p = b}, u.ofLp p.1 * kernel q.1 p.1 := by
    apply Finset.sum_congr_set {p : ι | label p = b}
      (fun p => u.ofLp p * kernel q.1 p)
      (fun p => u.ofLp p.1 * kernel q.1 p.1)
    · intro p hp
      rfl
    · intro p hp
      have hNe : label q.1 ≠ label p := by
        intro hEq
        exact hp (hEq.symm.trans q.2)
      rw [hOff q.1 p hNe, mul_zero]
  rw [EuclideanSpace.norm_sq_eq]
  simp only [finiteCoefficientKernelOperator_apply]
  calc
    (∑ q : ι, ‖∑ p : ι, u.ofLp p * kernel q p‖ ^ 2) =
        ∑ b ∈ Finset.univ.image label,
          ∑ q : {p : ι // label p = b},
            ‖∑ p : ι, u.ofLp p * kernel q.1 p‖ ^ 2 :=
      (finite_sum_over_image_fibers label
        (fun q => ‖∑ p : ι, u.ofLp p * kernel q p‖ ^ 2)).symm
    _ ≤ ∑ b ∈ Finset.univ.image label,
        D * (∑ p : {p : ι // label p = b}, weight p.1 * ‖u.ofLp p.1‖ ^ 2) := by
      apply Finset.sum_le_sum
      intro b hb
      simp_rw [hAction b]
      exact hFiber b (fun p => u.ofLp p.1)
    _ = D * (∑ b ∈ Finset.univ.image label,
        ∑ p : {p : ι // label p = b}, weight p.1 * ‖u.ofLp p.1‖ ^ 2) := by
      rw [Finset.mul_sum]
    _ = D * (∑ p : ι, weight p * ‖u.ofLp p‖ ^ 2) := by
      exact congrArg (fun s : ℝ => D * s)
        (finite_sum_over_image_fibers label
          (fun p : ι => weight p * ‖u.ofLp p‖ ^ 2))

/-! ### The existing arbitrary-support Hardy estimate on a pair fiber -/

/-- Extract the arbitrary-finite-support estimate, rather than only the special
cubic-mode estimate.  This is a direct use of the existing Fourier/Bessel proofs. -/
lemma finiteSupportUnitLatticeCoulombHardyBound_of_canonicalPeriodic
    (Hunit : ℝ) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    HasFiniteSupportUnitLatticeCoulombHardyBound Hunit := by
  have hPotential : HasUnitTorus3CoulombPotentialH1L2Bound
      canonicalUnitTorus3CoulombPotential.toPotentialRealization Hunit := hPeriodic
  have hProduct := unitTorus3CoulombProductH1L2Bound_of_potential
    canonicalUnitTorus3CoulombPotential.toPotentialRealization Hunit hPotential
  have hPartial := unitTorus3CoulombFourierPartialSumH1L2Bound_of_product
    canonicalUnitTorus3CoulombPotential.toPotentialRealization.toProductRealization
    Hunit hProduct
  exact finiteSupportUnitLatticeCoulombHardyBound_of_fourierPartialSums Hunit hPartial

/-- The Coulomb H1 bound on ANY injectively selected subset of the finite mode
set, with the same constant.  The selected set need not be a box, contain zero,
or be symmetric.  This covers the finite-boundary restrictions in pair fibers. -/
lemma finiteCoulombKernel_restricted_h1_bound
    {α : Type} [Fintype α]
    (g C B Hunit : ℝ) (count : ℕ)
    (mode : α → FinitePlaneWaveMode count) (hMode : Function.Injective mode)
    (hC : 0 ≤ C)
    (hFinite : HasFiniteSupportUnitLatticeCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g)
    (c : α → ℂ) :
    (∑ q : α, ‖∑ p : α, c p * finiteCoulombKernel C count (mode q) (mode p)‖ ^ 2) ≤
      B ^ 2 * (∑ p : α, (1 + (finitePlaneWaveKabs g count (mode p)) ^ 2) * ‖c p‖ ^ 2) := by
  classical
  let index : α → Lattice3 := fun p => finitePlaneWaveLatticeIndex count (mode p)
  have hIndex : Function.Injective index :=
    (finitePlaneWaveLatticeIndex_injective count).comp hMode
  have hAction (q : α) :
      (∑ p : α, c p * finiteCoulombKernel C count (mode q) (mode p)) =
        (Real.sqrt C : ℂ) * finiteSupportUnitLatticeCoulombAction index c q := by
    unfold finiteSupportUnitLatticeCoulombAction
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p hp
    rw [finiteCoulombKernel_eq_sqrt_C_mul_unit C count hC,
      finiteCoulombKernel_one_eq_unitLatticeCoulombKernel]
    dsimp [index]
    ring
  have hSqrt : ‖(Real.sqrt C : ℂ)‖ ^ 2 = C := by
    rw [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.sqrt_nonneg C), Real.sq_sqrt hC]
  have hOutput :
      (∑ q : α, ‖∑ p : α, c p * finiteCoulombKernel C count (mode q) (mode p)‖ ^ 2) =
        C * finiteSupportUnitLatticeCoulombOutputSq index c := by
    unfold finiteSupportUnitLatticeCoulombOutputSq
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro q hq
    rw [hAction q, norm_mul, mul_pow, hSqrt]
  have hWeight : physicalH1Scale g * finiteSupportLatticeH1Sq index c ≤
      ∑ p : α, (1 + (finitePlaneWaveKabs g count (mode p)) ^ 2) * ‖c p‖ ^ 2 := by
    unfold finiteSupportLatticeH1Sq
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro p hp
    calc
      physicalH1Scale g * ((1 + latticeNormSq (index p)) * ‖c p‖ ^ 2) =
          (physicalH1Scale g * (1 + latticeNormSq (index p))) * ‖c p‖ ^ 2 := by ring
      _ ≤ (1 + (finitePlaneWaveKabs g count (mode p)) ^ 2) * ‖c p‖ ^ 2 :=
        mul_le_mul_of_nonneg_right
          (physicalH1Scale_mul_latticeWeight_le_physicalWeight g count (mode p))
          (sq_nonneg _)
  calc
    (∑ q : α, ‖∑ p : α, c p * finiteCoulombKernel C count (mode q) (mode p)‖ ^ 2) =
        C * finiteSupportUnitLatticeCoulombOutputSq index c := hOutput
    _ ≤ C * (Hunit ^ 2 * finiteSupportLatticeH1Sq index c) :=
      mul_le_mul_of_nonneg_left (hFinite α index hIndex c) hC
    _ = (C * Hunit ^ 2) * finiteSupportLatticeH1Sq index c := by ring
    _ ≤ (B ^ 2 * physicalH1Scale g) * finiteSupportLatticeH1Sq index c :=
      mul_le_mul_of_nonneg_right hScale (finiteSupportLatticeH1Sq_nonneg index c)
    _ = B ^ 2 * (physicalH1Scale g * finiteSupportLatticeH1Sq index c) := by ring
    _ ≤ B ^ 2 * (∑ p : α,
        (1 + (finitePlaneWaveKabs g count (mode p)) ^ 2) * ‖c p‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hWeight (sq_nonneg B)

/-- The actual two-electron operator is controlled by the first named electron's
H1 mass alone.  It is not identified with a tensor-product one-body operator;
its exact total-momentum fibers are used throughout. -/
lemma finiteElectronPairCoulombOperator_norm_sq_le_first_h1
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (g C B Hunit : ℝ) (count : ℕ) (hC : 0 ≤ C)
    (hFinite : HasFiniteSupportUnitLatticeCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    ‖finiteElectronPairCoulombOperator i j C count u‖ ^ 2 ≤
      B ^ 2 * (∑ p : FourierConfig eta (FinitePlaneWaveMode count),
        (1 + (finitePlaneWaveKabs g count (p i)) ^ 2) * ‖u.ofLp p‖ ^ 2) := by
  classical
  unfold finiteElectronPairCoulombOperator
  refine finiteCoefficientKernelOperator_norm_sq_le_of_fibers
    (finiteElectronPairSliceLabel i j count)
    (finiteElectronPairConfigurationKernel i j C count)
    (fun p => 1 + (finitePlaneWaveKabs g count (p i)) ^ 2) (B ^ 2) ?_ ?_ u
  · intro q p hNe
    exact finiteElectronPairConfigurationKernel_of_other_fiber i j C count q p hNe
  · intro b c
    let mode : {p : FourierConfig eta (FinitePlaneWaveMode count) //
        finiteElectronPairSliceLabel i j count p = b} → FinitePlaneWaveMode count :=
      fun p => p.1 i
    have hMode : Function.Injective mode := by
      intro p q hEq
      apply Subtype.ext
      apply finiteElectronPairSliceLabel_with_first_injective i j hij count
      exact Prod.ext (p.2.trans q.2.symm) hEq
    have hEntry : ∀ q p : {p : FourierConfig eta (FinitePlaneWaveMode count) //
        finiteElectronPairSliceLabel i j count p = b},
        finiteElectronPairConfigurationKernel i j C count q.1 p.1 =
          finiteCoulombKernel C count (mode q) (mode p) := by
      intro q p
      exact finiteElectronPairConfigurationKernel_of_same_fiber i j C count q.1 p.1
        (q.2.trans p.2.symm)
    simp_rw [hEntry]
    exact finiteCoulombKernel_restricted_h1_bound g C B Hunit count mode hMode
      hC hFinite hScale c

/-- Full many-particle H1 bound for each pair.  No factor two from a relative
coordinate change, or factor from the number of fibers, is introduced. -/
lemma finiteElectronPairCoulombOperator_h1Bound
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (g C B Hunit : ℝ) (count : ℕ) (hC : 0 ≤ C)
    (hFinite : HasFiniteSupportUnitLatticeCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (finiteElectronPairCoulombOperator i j C count) B := by
  classical
  intro u
  have hFirst := finiteElectronPairCoulombOperator_norm_sq_le_first_h1
    i j hij g C B Hunit count hC hFinite hScale u
  apply hFirst.trans
  apply mul_le_mul_of_nonneg_left _ (sq_nonneg B)
  unfold fourierH1Sq
  apply Finset.sum_le_sum
  intro p hp
  have hKinetic : (finitePlaneWaveKabs g count (p i)) ^ 2 ≤
      boKineticSymbol (finitePlaneWaveKabs g count) p :=
    component_sq_le_boKineticSymbol (finitePlaneWaveKabs g count) p i
  exact mul_le_mul_of_nonneg_right (add_le_add (le_refl (1 : ℝ)) hKinetic) (sq_nonneg _)

/-- Periodic-background specialization of the pair H1 bound.  The general helper's
arbitrary-support estimate is discharged, not retained as a new pair assumption. -/
lemma finiteElectronPairCoulombOperator_h1Bound_of_periodic
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (g C B Hunit : ℝ) (count : ℕ) (hC : 0 ≤ C)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (finiteElectronPairCoulombOperator i j C count) B := by
  exact finiteElectronPairCoulombOperator_h1Bound i j hij g C B Hunit count hC
    (finiteSupportUnitLatticeCoulombHardyBound_of_canonicalPeriodic Hunit hPeriodic) hScale

/-! ### All unordered pairs and the full signed potential -/

/-- The unsquared constant of the sum over all unordered pairs.  The pair type
has exactly one member for each i < j, including the empty zero/one-electron cases. -/
lemma finiteElectronElectronPotential_h1Bound
    (eta : ℕ) (g gamma B Hunit : ℝ) (count : ℕ) (hB : 0 ≤ B)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : gamma ^ 2 * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (finiteElectronElectronPotential eta gamma count)
      ((Fintype.card (FiniteElectronPair eta) : ℝ) * B) := by
  classical
  have hSum := hasH1OperatorBound_finset_sum (finitePlaneWaveKabs g count)
    (Finset.univ : Finset (FiniteElectronPair eta))
    (fun pair => finiteElectronPairCoulombOperator pair.1.1 pair.1.2 (gamma ^ 2) count)
    (fun _ => B) (fun pair hpair => hB)
    (fun pair hpair => finiteElectronPairCoulombOperator_h1Bound_of_periodic
      pair.1.1 pair.1.2 (ne_of_lt pair.2) g (gamma ^ 2) B Hunit count (sq_nonneg gamma)
      hPeriodic hScale)
  have hCount : (∑ _pair : FiniteElectronPair eta, B) =
      (Fintype.card (FiniteElectronPair eta) : ℝ) * B := by simp
  rw [hCount] at hSum
  exact hSum

/-- Explicit, basis-size-independent full molecular H1 constant.  The coefficient
is eta times the total nuclear charge plus the actual unordered-pair count. -/
noncomputable def finiteMolecularCoulombH1Constant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν) (B : ℝ) : ℝ :=
  ((eta : ℝ) * data.totalCharge + (Fintype.card (FiniteElectronPair eta) : ℝ)) * B

lemma finiteMolecularCoulombH1Constant_nonneg
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    {B : ℝ} (hB : 0 ≤ B) :
    0 ≤ finiteMolecularCoulombH1Constant eta data B := by
  unfold finiteMolecularCoulombH1Constant
  exact mul_nonneg
    (add_nonneg (mul_nonneg (Nat.cast_nonneg eta) data.totalCharge_nonneg)
      (Nat.cast_nonneg _)) hB

/-- The full nuclear-plus-pair interaction has the sum of the unsquared constants.
This statement concerns the actual signed molecular operator from milestone 113,
not its entrywise positive majorant or the earlier two-register model. -/
lemma finiteMolecularCoulombPotential_h1Bound_of_periodic
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (g gamma B Hunit : ℝ) (count : ℕ) (hB : 0 ≤ B)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : gamma ^ 2 * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (finiteMolecularCoulombPotential eta data gamma count)
      (finiteMolecularCoulombH1Constant eta data B) := by
  have hOne := oneParticleCoulombH1Bound_of_canonicalPeriodic
    g (gamma ^ 2) B Hunit count (sq_nonneg gamma) hPeriodic hScale
  have hNuclear := finiteElectronNuclearPotential_h1Bound eta data g gamma B count hB hOne
  have hPair := finiteElectronElectronPotential_h1Bound eta g gamma B Hunit count hB
    hPeriodic hScale
  have hN0 : 0 ≤ (eta : ℝ) * data.totalCharge * B :=
    mul_nonneg (mul_nonneg (Nat.cast_nonneg eta) data.totalCharge_nonneg) hB
  have hP0 : 0 ≤ (Fintype.card (FiniteElectronPair eta) : ℝ) * B :=
    mul_nonneg (Nat.cast_nonneg _) hB
  have hSum := hasH1OperatorBound_add (finitePlaneWaveKabs g count)
    (finiteElectronNuclearPotential eta data gamma count)
    (finiteElectronElectronPotential eta gamma count) hN0 hP0 hNuclear hPair
  have hConstant : (eta : ℝ) * data.totalCharge * B +
      (Fintype.card (FiniteElectronPair eta) : ℝ) * B =
      finiteMolecularCoulombH1Constant eta data B := by
    unfold finiteMolecularCoulombH1Constant
    ring
  rw [hConstant] at hSum
  exact hSum

/-- Full molecular H1 estimate from precisely the agreed scalar Green-function
remainder bound and scalar choices.  No molecular operator estimate is assumed. -/
lemma finiteMolecularCoulombPotential_h1Bound_of_background
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (g gamma B Hunit rcut router Clocal Breg : ℝ) (count : ℕ)
    (hB : 0 ≤ B)
    (hRcut : 0 < rcut) (hRcutRouter : rcut < router)
    (hHalf : router < (1 / 2 : ℝ)) (hBreg : 0 ≤ Breg)
    (hRemainder : ∀ᵐ x : UnitTorus3 ∂volume, ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ Breg)
    (hCutoffScale :
      2 * (centeredCube3RadialCutoffAinnerCoarse rcut router ^ 2 + (1 / rcut) ^ 2) ≤ Clocal ^ 2)
    (hPeriodicScale : 2 * (Real.pi ^ 2 * Clocal ^ 2 + Breg ^ 2) ≤ Hunit ^ 2)
    (hScale : gamma ^ 2 * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (finiteMolecularCoulombPotential eta data gamma count)
      (finiteMolecularCoulombH1Constant eta data B) := by
  have hPeriodic := canonicalPeriodicCoulombHardyBound_of_remainder_bound
    hRcut hRcutRouter hHalf hBreg hRemainder hCutoffScale hPeriodicScale
  exact finiteMolecularCoulombPotential_h1Bound_of_periodic eta data g gamma B Hunit count
    hB hPeriodic hScale

/-! ### A fully specified physical-cell constant -/

/-- A concrete full molecular form constant at g=2*pi/L and gamma=1/(pi*L).
It depends on eta, the total charge, L and the unit-period bound, not on count or K. -/
noncomputable def finiteMolecularCoulombPhysicalFormConstant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (L Hunit : ℝ) : ℝ :=
  finiteMolecularCoulombH1Constant eta data
    (coulombPhysicalH1Constant (2 * Real.pi / L) ((coulombCellAmplitude L) ^ 2) Hunit)

/-- The physical specialization requires no independently chosen B or additional
H1 scaling inequality: the explicit square-root choice satisfies it identically. -/
lemma finiteMolecularCoulombPotential_physical_h1Bound
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (L Hunit rcut router Clocal Breg : ℝ) (count : ℕ) (hL : 0 < L)
    (hRcut : 0 < rcut) (hRcutRouter : rcut < router)
    (hHalf : router < (1 / 2 : ℝ)) (hBreg : 0 ≤ Breg)
    (hRemainder : ∀ᵐ x : UnitTorus3 ∂volume, ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ Breg)
    (hCutoffScale :
      2 * (centeredCube3RadialCutoffAinnerCoarse rcut router ^ 2 + (1 / rcut) ^ 2) ≤ Clocal ^ 2)
    (hPeriodicScale : 2 * (Real.pi ^ 2 * Clocal ^ 2 + Breg ^ 2) ≤ Hunit ^ 2) :
    HasH1OperatorBound (finitePlaneWaveKabs (2 * Real.pi / L) count)
      (finiteMolecularCoulombPotential eta data (coulombCellAmplitude L) count)
      (finiteMolecularCoulombPhysicalFormConstant eta data L Hunit) := by
  have hg : 0 < 2 * Real.pi / L :=
    div_pos (mul_pos (by norm_num) Real.pi_pos) hL
  have hScale := coulombPhysicalH1Constant_sq_mul_scale Hunit hg
    (sq_nonneg (coulombCellAmplitude L))
  exact finiteMolecularCoulombPotential_h1Bound_of_background eta data
    (2 * Real.pi / L) (coulombCellAmplitude L)
    (coulombPhysicalH1Constant (2 * Real.pi / L) ((coulombCellAmplitude L) ^ 2) Hunit)
    Hunit rcut router Clocal Breg count (coulombPhysicalH1Constant_nonneg _ _ _)
    hRcut hRcutRouter hHalf hBreg hRemainder hCutoffScale hPeriodicScale
    (le_of_eq hScale.symm)

/-! ### Explicit connection to the sector-correct energy theorem

The following is a REDUCTION theorem: hPT is an outstanding quantitative tail
premise, not an agreed background assumption.  Unlike the old two-register
specialization, this reduction now uses the full molecular operator, with its
form estimate and symmetry proved.  Discharging hPT is the next analytic step.
-/

/-!
## One-hundred-fourteenth milestone: assumption and scope audit

The pair estimate is no longer pending: for i != j it is obtained by applying
arbitrary-support periodic Coulomb Hardy to each exact momentum-conserving fiber.
One selected electron's momentum is injective on that fiber.  Summing the fiber
squared norms is exact and introduces no multiplicity or basis-size constant.
The result also bounds the pair by either selected electron's H1 mass alone.

Writing P_eta for the cardinality of the unordered-pair type, the complete signed
molecular potential satisfies

  ||W u||_2 <= (eta * lambda_zeta + P_eta) * B * ||u||_H1,
  |Re <u,Wu>| <= (eta * lambda_zeta + P_eta) * B * ||u||_H1^2.

The exact pair type counts i < j once; a coarse P_eta <= eta^2 inequality is proved
to make polynomial dependence explicit without using a basis-dependent estimate.
At the physical cell scale, B is the existing explicit square-root constant with
g=2*pi/L and gamma=1/(pi*L).  The theorem holds for every finite ambient count with
those same constants.  Nuclear positions do not enlarge the bound.

No pair H1, full-W H1, hPotential, symmetry, or decomposition premise is assumed
in bo_onehundredfourteen_milestone.  Its only analytic background is the same
essential bound on the specified periodic Coulomb remainder, with scalar choices
of radii and constants.  The real-space Hardy proof is reused without changes.

The named energy reduction uses the full physical finite operator and the
fermionic variational predicates, but deliberately still exposes hPT.  Proving
that full molecular tail estimate (including pair high-pass estimates and the
signed all-term sum) remains INSIDE the chosen formalization scope; hPT is NOT
reclassified as standard background.  Particle-exchange invariance, the cubic
cutoff/basis-count comparison, and the exact continuum interpretation likewise
remain separate checks.  The H2 and spectral background results remain external
as agreed.  No full molecular N^-1 theorem is claimed by this milestone alone.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open MeasureTheory

/-! ## One-hundred-fifteenth milestone: quantitative tails for the genuine pair operator

The pair interaction acts on fibers of the exact total pair momentum and all
spectator momenta.  One electron's momentum embeds each fiber into the finite
one-particle mode set.  Restricting a nonnegative column sum or inverse Sobolev
weight sum along this embedding cannot increase it.  The estimates below use
this fact and milestone 114's exact fiber recombination, not the size or shape
of a fiber.

The final pair-tail statements discharge the low-pass Schur and high-pass
column/Sobolev estimates.  No pair-tail bound is added as a background input.
The periodic remainder and H2/spectral background boundary is unchanged.
-/

/-! ### Restricting a kernel to an arbitrary injective finite support -/

/-- A nonnegative sum decreases on an injectively parametrized subset. -/
lemma finite_nonneg_sum_comp_le_of_injective
    {α μ : Type*} [Fintype α] [Fintype μ]
    (mode : α → μ) (hMode : Function.Injective mode)
    (f : μ → ℝ) (hf : ∀ v : μ, 0 ≤ f v) :
    (∑ p : α, f (mode p)) ≤ ∑ v : μ, f v := by
  classical
  calc
    (∑ p : α, f (mode p)) = ∑ v ∈ Finset.univ.image mode, f v := by
      symm
      exact Finset.sum_image (fun p hp q hq hpq => hMode hpq)
    _ ≤ ∑ v : μ, f v :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
        (fun v hv hNot => hf v)

/-- Weighted Cauchy--Schwarz followed by a column-square bound.
The positive weight is arbitrary.  The two constants are an inverse-weight
sum and a column-square bound, not cardinalities of the matrix. -/
lemma finiteKernel_weighted_column_sq_bound
    {α : Type*} [Fintype α]
    (kernel : α → α → ℂ) (weight : α → ℝ) (S Q : ℝ)
    (hWeight : ∀ p : α, 0 < weight p) (hS : 0 ≤ S)
    (hInverse : (∑ p : α, (1 / weight p) ^ 2) ≤ S)
    (hColumn : ∀ p : α, (∑ q : α, ‖kernel q p‖ ^ 2) ≤ Q)
    (c : α → ℂ) :
    (∑ q : α, ‖∑ p : α, c p * kernel q p‖ ^ 2) ≤
      S * Q * (∑ p : α, (weight p) ^ 2 * ‖c p‖ ^ 2) := by
  classical
  have hPoint (q : α) :
      ‖∑ p : α, c p * kernel q p‖ ^ 2 ≤
        S * (∑ p : α, (weight p) ^ 2 * ‖c p‖ ^ 2 * ‖kernel q p‖ ^ 2) := by
    have hTriangle := norm_sum_le (Finset.univ : Finset α)
      (fun p => c p * kernel q p)
    have hTriangleSq := sq_le_sq_of_nonneg
      (norm_nonneg (∑ p : α, c p * kernel q p)) hTriangle
    have hCS := Finset.sum_mul_sq_le_sq_mul_sq (Finset.univ : Finset α)
      (fun p => 1 / weight p) (fun p => weight p * ‖c p * kernel q p‖)
    have hProduct :
        (∑ p : α, (1 / weight p) * (weight p * ‖c p * kernel q p‖)) =
          ∑ p : α, ‖c p * kernel q p‖ := by
      apply Finset.sum_congr rfl
      intro p hp
      field_simp [ne_of_gt (hWeight p)]
    have hSquare :
        (∑ p : α, (weight p * ‖c p * kernel q p‖) ^ 2) =
          ∑ p : α, (weight p) ^ 2 * ‖c p‖ ^ 2 * ‖kernel q p‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro p hp
      rw [norm_mul]
      ring
    rw [hProduct, hSquare] at hCS
    exact hTriangleSq.trans (hCS.trans
      (mul_le_mul_of_nonneg_right hInverse
        (Finset.sum_nonneg (fun p hp =>
          mul_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _)) (sq_nonneg _)))))
  calc
    (∑ q : α, ‖∑ p : α, c p * kernel q p‖ ^ 2) ≤
        ∑ q : α, S * (∑ p : α,
          (weight p) ^ 2 * ‖c p‖ ^ 2 * ‖kernel q p‖ ^ 2) :=
      Finset.sum_le_sum (fun q hq => hPoint q)
    _ = S * (∑ q : α, ∑ p : α,
          (weight p) ^ 2 * ‖c p‖ ^ 2 * ‖kernel q p‖ ^ 2) := by
      symm
      apply Finset.mul_sum
    _ = S * (∑ p : α,
          ((weight p) ^ 2 * ‖c p‖ ^ 2) * (∑ q : α, ‖kernel q p‖ ^ 2)) := by
      congr 1
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro p hp
      rw [Finset.mul_sum]
    _ ≤ S * (∑ p : α, ((weight p) ^ 2 * ‖c p‖ ^ 2) * Q) := by
      apply mul_le_mul_of_nonneg_left _ hS
      apply Finset.sum_le_sum
      intro p hp
      exact mul_le_mul_of_nonneg_left (hColumn p)
        (mul_nonneg (sq_nonneg _) (sq_nonneg _))
    _ = S * Q * (∑ p : α, (weight p) ^ 2 * ‖c p‖ ^ 2) := by
      rw [← Finset.sum_mul]
      ring

/-- Restriction of the weighted column estimate to any injective finite support.
This is the analytic estimate used on an irregular conserved-momentum fiber. -/
lemma finiteKernel_pullback_weighted_column_sq_bound
    {α μ : Type*} [Fintype α] [Fintype μ]
    (mode : α → μ) (hMode : Function.Injective mode)
    (kernel : μ → μ → ℂ) (weight : μ → ℝ) (S Q : ℝ)
    (hWeight : ∀ v : μ, 0 < weight v) (hS : 0 ≤ S)
    (hInverse : (∑ v : μ, (1 / weight v) ^ 2) ≤ S)
    (hColumn : ∀ v : μ, (∑ w : μ, ‖kernel w v‖ ^ 2) ≤ Q)
    (c : α → ℂ) :
    (∑ q : α, ‖∑ p : α, c p * kernel (mode q) (mode p)‖ ^ 2) ≤
      S * Q * (∑ p : α, (weight (mode p)) ^ 2 * ‖c p‖ ^ 2) := by
  apply finiteKernel_weighted_column_sq_bound
    (fun q p => kernel (mode q) (mode p)) (fun p => weight (mode p))
    S Q (fun p => hWeight (mode p)) hS
  · exact (finite_nonneg_sum_comp_le_of_injective mode hMode
      (fun v => (1 / weight v) ^ 2) (fun v => sq_nonneg _)).trans hInverse
  · intro p
    exact (finite_nonneg_sum_comp_le_of_injective mode hMode
      (fun v => ‖kernel v (mode p)‖ ^ 2) (fun v => sq_nonneg _)).trans
        (hColumn (mode p))

/-- Restriction also preserves the row/column constants in the finite Schur test. -/
lemma finiteKernel_pullback_schur_sq_bound
    {α μ : Type*} [Fintype α] [Fintype μ]
    (mode : α → μ) (hMode : Function.Injective mode)
    (kernel : μ → μ → ℂ) (A : ℝ) (hA : 0 ≤ A)
    (hRow : ∀ v : μ, (∑ w : μ, ‖kernel v w‖) ≤ A)
    (hColumn : ∀ w : μ, (∑ v : μ, ‖kernel v w‖) ≤ A)
    (c : α → ℂ) :
    (∑ q : α, ‖∑ p : α, c p * kernel (mode q) (mode p)‖ ^ 2) ≤
      A ^ 2 * (∑ p : α, ‖c p‖ ^ 2) := by
  have hRow' : ∀ q : α, (∑ p : α, ‖kernel (mode q) (mode p)‖) ≤ A := by
    intro q
    exact (finite_nonneg_sum_comp_le_of_injective mode hMode
      (fun v => ‖kernel (mode q) v‖) (fun v => norm_nonneg _)).trans (hRow (mode q))
  have hColumn' : ∀ p : α, (∑ q : α, ‖kernel (mode q) (mode p)‖) ≤ A := by
    intro p
    exact (finite_nonneg_sum_comp_le_of_injective mode hMode
      (fun v => ‖kernel v (mode p)‖) (fun v => norm_nonneg _)).trans (hColumn (mode p))
  simpa only [pow_two] using finite_schur_sum_sq
    (fun q p => kernel (mode q) (mode p)) c A A hA hA hRow' hColumn'

/-! ### The same conserved-momentum lift for arbitrary one-particle kernels -/

/-- Lift a kernel to the exact pair fibers.  No inverse of a modular shift is
used: input and output configurations both belong to the original mode set. -/
noncomputable def finiteElectronPairLiftKernel
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) : ℂ := by
  classical
  exact if finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
    then kernel (q i) (p i) else 0

noncomputable def finiteElectronPairKernelOperator
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  finiteCoefficientKernelOperator (finiteElectronPairLiftKernel i j count kernel)

@[simp] lemma finiteElectronPairKernelOperator_apply
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    (finiteElectronPairKernelOperator i j count kernel u).ofLp q =
      ∑ p, u.ofLp p * finiteElectronPairLiftKernel i j count kernel q p := by
  rfl

/-- The pair lift is additive in its one-particle kernel. -/
lemma finiteElectronPairKernelOperator_add_kernel
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (A D : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ) :
    finiteElectronPairKernelOperator i j count (fun v w => A v w + D v w) =
      finiteElectronPairKernelOperator i j count A + finiteElectronPairKernelOperator i j count D := by
  classical
  apply LinearMap.ext
  intro u
  ext q
  change (finiteElectronPairKernelOperator i j count (fun v w => A v w + D v w) u).ofLp q =
    (finiteElectronPairKernelOperator i j count A u).ofLp q +
      (finiteElectronPairKernelOperator i j count D u).ofLp q
  simp only [finiteElectronPairKernelOperator_apply, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro p hp
  by_cases h : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
  · simp [finiteElectronPairLiftKernel, h, mul_add]
  · simp [finiteElectronPairLiftKernel, h]

/-- H2 column/Sobolev estimate on pair fibers.  The one-particle constants
survive exact recombination without a fiber multiplicity or total-momentum factor. -/
lemma finiteElectronPairKernelOperator_h2_column_bound
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j) (count : ℕ)
    (kabs : FinitePlaneWaveMode count → ℝ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ)
    (Cs Q : ℝ) (hQ : 0 ≤ Q)
    (hInverse : HasOneParticleInverseH2WeightBound kabs Cs)
    (hColumn : ∀ p : FinitePlaneWaveMode count,
      (∑ q : FinitePlaneWaveMode count, ‖kernel q p‖ ^ 2) ≤ Q)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    ‖finiteElectronPairKernelOperator i j count kernel u‖ ^ 2 ≤
      Cs ^ 2 * Q * (∑ p : FourierConfig eta (FinitePlaneWaveMode count),
        (1 + boKineticSymbol kabs p) ^ 2 * ‖u.ofLp p‖ ^ 2) := by
  classical
  have hFirst : ‖finiteElectronPairKernelOperator i j count kernel u‖ ^ 2 ≤
      Cs ^ 2 * Q * (∑ p : FourierConfig eta (FinitePlaneWaveMode count),
        (1 + (kabs (p i)) ^ 2) ^ 2 * ‖u.ofLp p‖ ^ 2) := by
    unfold finiteElectronPairKernelOperator
    refine finiteCoefficientKernelOperator_norm_sq_le_of_fibers
      (finiteElectronPairSliceLabel i j count) (finiteElectronPairLiftKernel i j count kernel)
      (fun p => (1 + (kabs (p i)) ^ 2) ^ 2) (Cs ^ 2 * Q) ?_ ?_ u
    · intro q p hNe
      simp only [finiteElectronPairLiftKernel, if_neg hNe]
    · intro b c
      let mode : {p : FourierConfig eta (FinitePlaneWaveMode count) //
          finiteElectronPairSliceLabel i j count p = b} → FinitePlaneWaveMode count :=
        fun p => p.1 i
      have hMode : Function.Injective mode := by
        intro p q hEq
        apply Subtype.ext
        apply finiteElectronPairSliceLabel_with_first_injective i j hij count
        exact Prod.ext (p.2.trans q.2.symm) hEq
      have hEntry : ∀ q p : {p : FourierConfig eta (FinitePlaneWaveMode count) //
          finiteElectronPairSliceLabel i j count p = b},
          finiteElectronPairLiftKernel i j count kernel q.1 p.1 = kernel (mode q) (mode p) := by
        intro q p
        exact if_pos (q.2.trans p.2.symm)
      simp_rw [hEntry]
      exact finiteKernel_pullback_weighted_column_sq_bound mode hMode kernel
        (fun v => 1 + (kabs v) ^ 2) (Cs ^ 2) Q
        (fun v => by positivity) (sq_nonneg Cs) hInverse hColumn c
  apply hFirst.trans
  apply mul_le_mul_of_nonneg_left _ (mul_nonneg (sq_nonneg Cs) hQ)
  apply Finset.sum_le_sum
  intro p hp
  have hWeight : 1 + (kabs (p i)) ^ 2 ≤ 1 + boKineticSymbol kabs p :=
    add_le_add (le_refl (1 : ℝ)) (component_sq_le_boKineticSymbol kabs p i)
  exact mul_le_mul_of_nonneg_right
    (sq_le_sq_of_nonneg (by positivity : 0 ≤ 1 + (kabs (p i)) ^ 2) hWeight)
    (sq_nonneg ‖u.ofLp p‖)

/-- The same pair-fiber reduction for the L2 Schur estimate. -/
lemma finiteElectronPairKernelOperator_norm_sq_le_of_schur
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j) (count : ℕ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ)
    (A : ℝ) (hA : 0 ≤ A)
    (hRow : ∀ v : FinitePlaneWaveMode count, (∑ w, ‖kernel v w‖) ≤ A)
    (hColumn : ∀ w : FinitePlaneWaveMode count, (∑ v, ‖kernel v w‖) ≤ A)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    ‖finiteElectronPairKernelOperator i j count kernel u‖ ^ 2 ≤ A ^ 2 * ‖u‖ ^ 2 := by
  classical
  have hBound : ‖finiteElectronPairKernelOperator i j count kernel u‖ ^ 2 ≤
      A ^ 2 * (∑ p : FourierConfig eta (FinitePlaneWaveMode count), (1 : ℝ) * ‖u.ofLp p‖ ^ 2) := by
    unfold finiteElectronPairKernelOperator
    refine finiteCoefficientKernelOperator_norm_sq_le_of_fibers
      (finiteElectronPairSliceLabel i j count) (finiteElectronPairLiftKernel i j count kernel)
      (fun _ => (1 : ℝ)) (A ^ 2) ?_ ?_ u
    · intro q p hNe
      simp only [finiteElectronPairLiftKernel, if_neg hNe]
    · intro b c
      let mode : {p : FourierConfig eta (FinitePlaneWaveMode count) //
          finiteElectronPairSliceLabel i j count p = b} → FinitePlaneWaveMode count :=
        fun p => p.1 i
      have hMode : Function.Injective mode := by
        intro p q hEq
        apply Subtype.ext
        apply finiteElectronPairSliceLabel_with_first_injective i j hij count
        exact Prod.ext (p.2.trans q.2.symm) hEq
      have hEntry : ∀ q p : {p : FourierConfig eta (FinitePlaneWaveMode count) //
          finiteElectronPairSliceLabel i j count p = b},
          finiteElectronPairLiftKernel i j count kernel q.1 p.1 = kernel (mode q) (mode p) := by
        intro q p
        exact if_pos (q.2.trans p.2.symm)
      simp_rw [hEntry]
      simpa only [one_mul] using
        finiteKernel_pullback_schur_sq_bound mode hMode kernel A hA hRow hColumn c
  simpa only [one_mul, EuclideanSpace.norm_sq_eq] using hBound

/-! ### The high-pass pair estimate, with the established doubled transfer horizon -/

noncomputable def finiteElectronPairHighPassOperator
    {eta : ℕ} (i j : Fin eta) (K g C : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  finiteElectronPairKernelOperator i j count (finiteHighPassCoulombKernel K g C count)

noncomputable def finiteElectronPairLowPassOperator
    {eta : ℕ} (i j : Fin eta) (K g C : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  finiteElectronPairKernelOperator i j count (finiteLowPassCoulombKernel K g C count)

/-- The shell budget already used for a reference-particle high-pass kernel,
extracted as a stand-alone theorem for reuse by the pair lift. -/
lemma finiteHighPassKernelTailSq_scaled_bound
    (K g C Bker : ℝ) (basisExtra : ℕ)
    (hK : 0 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hBudget : 432 * C * g ≤ Bker ^ 2) :
    HasKernelL2TailBound K
      (finiteHighPassKernelTailSq K g C (cutoffShellIndex K g)
        (coulombTransferShellCount (cutoffShellIndex K g) basisExtra)) Bker := by
  let m := cutoffShellIndex K g
  let transfers := coulombTransferShellCount m basisExtra
  let Q := finiteHighPassKernelTailSq K g C m transfers
  rcases cutoffShellIndex_placement K g hK hg with ⟨hUpper, hLower⟩
  have hCutBudget := cutoff_and_budget_from_shell_index_placement K g C Bker m
    hK (le_of_lt hg) hC hUpper hLower hBudget
  have hBelow := all_earlier_cubic_shells_below_half_cutoff K g m hCutBudget.1
  have hCover := finiteHighPassKernelTailSq_shell_cover K g C m transfers hC hBelow
  have hDecay := finiteShellMass_decay_on_range cubicSupShell
    (latticeCoulombSquareWeight C) 54 C m transfers (by norm_num) hC
    cubicSupShell_hasQuadraticShellCount (cubicSupShell_hasInverseFourthCoulombWeight C hC)
  exact kernel_tail_bound_from_inverse_square_shells K Q Bker (54 * C)
    (finiteShellMass cubicSupShell (latticeCoulombSquareWeight C)) m transfers
    hK (mul_nonneg (by norm_num) hC) hCover hDecay hCutBudget.2

/-- Pair high-pass H2 bound.  All conserved total momenta share the same Q and Cs. -/
lemma finiteElectronPairHighPassOperator_hasHighPassSliceBound
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (K g C Cs : ℝ) (basisExtra : ℕ)
    (hC : 0 ≤ C) (hg : 0 < g) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ) :
    HasHighPassSliceBound
      (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra))
      (finiteElectronPairHighPassOperator i j K g C (cutoffShellIndex K g + basisExtra))
      coeff Cs
      (finiteHighPassKernelTailSq K g C (cutoffShellIndex K g)
        (coulombTransferShellCount (cutoffShellIndex K g) basisExtra)) := by
  let m := cutoffShellIndex K g
  let count := m + basisExtra
  let Q := finiteHighPassKernelTailSq K g C m (coulombTransferShellCount m basisExtra)
  have hQ : 0 ≤ Q := finiteHighPassKernelTailSq_nonneg K g C m _ hC
  have hColumn := finiteHighPassCoulombKernel_hasColumnSqBound K g C m basisExtra hC
  have hInverse := finitePlaneWave_hasOneParticleInverseH2WeightBound g Cs count hg hCsScale
  exact finiteElectronPairKernelOperator_h2_column_bound i j hij count
    (finitePlaneWaveKabs g count) (finiteHighPassCoulombKernel K g C count)
    Cs Q hQ hInverse hColumn (fullCoeffVector coeff)

/-- The genuine pair high-pass interaction satisfies the same K^(-1/2) estimate
as the one-body high-pass interaction.  There is no assumed pair estimate. -/
lemma finiteElectronPairHighPassOperator_norm_le_of_h2
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (K g C rho Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖finiteElectronPairHighPassOperator i j K g C
        (cutoffShellIndex K g + basisExtra) (fullCoeffVector coeff)‖ ≤
      (Cs * Bker * M2) * rho := by
  have hK : 0 ≤ K := le_trans (by norm_num : (0 : ℝ) ≤ 1) hK1
  have hQ := finiteHighPassKernelTailSq_nonneg K g C (cutoffShellIndex K g)
    (coulombTransferShellCount (cutoffShellIndex K g) basisExtra) hC
  have hKernel := finiteHighPassKernelTailSq_scaled_bound K g C Bker basisExtra
    hK hg hC hBkerScale
  have hSlice := finiteElectronPairHighPassOperator_hasHighPassSliceBound i j hij
    K g C Cs basisExtra hC hg hCsScale coeff
  exact high_pass_bound_from_kernel_and_slice K rho Cs Bker M2 _
    (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff
    (finiteElectronPairHighPassOperator i j K g C (cutoffShellIndex K g + basisExtra))
    hK1 hRho hRhoScale hCs hBker hM2 hQ hKernel hH2 hSlice

/-! ### Low-pass support and the tail of the unsplit pair -/

/-- The pair low-pass operator has the same Schur bound as the one-particle
kernel, since both row and column sums decrease on each fiber. -/
lemma finiteElectronPairLowPassOperator_norm_le
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (K g C Blow : ℝ) (count : ℕ)
    (hK : 0 ≤ K) (hg : 0 < g) (hC : 0 ≤ C) (hBlow : 0 ≤ Blow)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    ‖finiteElectronPairLowPassOperator i j K g C count u‖ ≤ (Blow * K) * ‖u‖ := by
  have hTransfer : finiteLowPassTransferL1 K g C (2 * count) ≤ Blow * K :=
    (finiteLowPassTransferL1_le_cutoffShellCount_mul K g C (2 * count) hK hg hC).trans
      (lowPassScale_of_amplitudeScale K g C Blow hK hg h2gK hBlow hAmplitude)
  have hRow : ∀ v : FinitePlaneWaveMode count,
      (∑ w : FinitePlaneWaveMode count, ‖finiteLowPassCoulombKernel K g C count v w‖) ≤ Blow * K := by
    intro v
    exact (finiteLowPassCoulombKernel_rowL1_le_transferL1 K g C count v).trans hTransfer
  have hColumn : ∀ w : FinitePlaneWaveMode count,
      (∑ v : FinitePlaneWaveMode count, ‖finiteLowPassCoulombKernel K g C count v w‖) ≤ Blow * K := by
    intro w
    exact (finiteLowPassCoulombKernel_columnL1_le_transferL1 K g C count w).trans hTransfer
  have hSq := finiteElectronPairKernelOperator_norm_sq_le_of_schur i j hij count
    (finiteLowPassCoulombKernel K g C count) (Blow * K) (mul_nonneg hBlow hK) hRow hColumn u
  have hSquare : ‖finiteElectronPairLowPassOperator i j K g C count u‖ ^ 2 ≤
      ((Blow * K) * ‖u‖) ^ 2 := by
    rw [mul_pow]
    exact hSq
  have hRight : 0 ≤ (Blow * K) * ‖u‖ := mul_nonneg (mul_nonneg hBlow hK) (norm_nonneg _)
  nlinarith only [hSquare, hRight,
    norm_nonneg (finiteElectronPairLowPassOperator i j K g C count u)]

/-- The one-particle support condition survives the momentum-conserving pair lift.
Only the affected first register is projected; the second momentum is not frozen. -/
lemma finiteElectronPairKernelOperator_hasLowPassSupport
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (K : ℝ) (kabs : FinitePlaneWaveMode count → ℝ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ)
    (hSupport : HasReferenceKernelLowPassSupport K kabs kernel) :
    HasLowPassReferenceSupport K kabs i (finiteElectronPairKernelOperator i j count kernel) := by
  classical
  intro u
  ext q
  simp only [referenceTailOperator_apply, finiteElectronPairKernelOperator_apply]
  by_cases hq : K < kabs (q i)
  · simp only [if_pos hq]
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hpTail : K / 2 < kabs (p i)
    · simp only [if_pos hpTail]
    · have hZero : finiteElectronPairLiftKernel i j count kernel q p = 0 := by
        have hk := hSupport (q i) (p i) hq hpTail
        by_cases hLabel : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
        · simp only [finiteElectronPairLiftKernel, if_pos hLabel, hk]
        · simp only [finiteElectronPairLiftKernel, if_neg hLabel]
      simp only [hZero, mul_zero]
  · simp only [if_neg hq]

lemma finiteElectronPairLowPassOperator_hasLowPassSupport
    {eta : ℕ} (i j : Fin eta) (K g C : ℝ) (count : ℕ) :
    HasLowPassReferenceSupport K (finitePlaneWaveKabs g count) i
      (finiteElectronPairLowPassOperator i j K g C count) := by
  exact finiteElectronPairKernelOperator_hasLowPassSupport i j count K
    (finitePlaneWaveKabs g count) (finiteLowPassCoulombKernel K g C count)
    (finiteLowPassCoulombKernel_hasReferenceSupport K g C count)

/-- The pair low/high splitting reconstructs exactly the full pair interaction,
with the same boundary restrictions and conserved total lattice momentum. -/
lemma finiteElectronPairCoulombOperator_low_add_high
    {eta : ℕ} (i j : Fin eta) (K g C : ℝ) (count : ℕ)
    (hK : 0 ≤ K) (hg : 0 ≤ g) :
    finiteElectronPairCoulombOperator i j C count =
      finiteElectronPairLowPassOperator i j K g C count +
        finiteElectronPairHighPassOperator i j K g C count := by
  have hKernel :
      (fun v w : FinitePlaneWaveMode count =>
        finiteLowPassCoulombKernel K g C count v w + finiteHighPassCoulombKernel K g C count v w) =
        finiteCoulombKernel C count := by
    funext v w
    exact finiteLowHighCoulombKernel_eq_full K g C count hK hg v w
  calc
    finiteElectronPairCoulombOperator i j C count =
        finiteElectronPairKernelOperator i j count (finiteCoulombKernel C count) := rfl
    _ = finiteElectronPairKernelOperator i j count
        (fun v w => finiteLowPassCoulombKernel K g C count v w +
          finiteHighPassCoulombKernel K g C count v w) :=
      congrArg (finiteElectronPairKernelOperator i j count) hKernel.symm
    _ = _ := finiteElectronPairKernelOperator_add_kernel i j count _ _

/-- Strong two-scale tail estimate on either named first electron of the pair:
low transfer is O(K^-1), high transfer is O(K^-1/2).  All kernel estimates
are proved, and the only state-regularity input is the agreed H2 bound. -/
lemma finiteElectronPairCoulombOperator_tail_bound_first_two_scale
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (K g C rho Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) i
        (finiteElectronPairCoulombOperator i j C (cutoffShellIndex K g + basisExtra)
          (fullCoeffVector coeff))‖ ≤
      (4 * Blow * M2) * rho ^ 2 + (Cs * Bker * M2) * rho := by
  let count := cutoffShellIndex K g + basisExtra
  let kabs := finitePlaneWaveKabs g count
  let Wlow := finiteElectronPairLowPassOperator i j K g C count
  let Whigh := finiteElectronPairHighPassOperator i j K g C count
  have hK : 0 ≤ K := le_trans (by norm_num : (0 : ℝ) ≤ 1) hK1
  have hkabs : ∀ v, 0 ≤ kabs v := finitePlaneWaveKabs_nonneg g count (le_of_lt hg)
  have hLowOp : ∀ u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
      ‖referenceTailOperator K kabs i (Wlow u)‖ ≤ Blow * K * ‖u‖ := by
    intro u
    exact (referenceTailOperator_norm_le K kabs i (Wlow u)).trans
      (finiteElectronPairLowPassOperator_norm_le i j hij K g C Blow count
        hK hg hC hBlow h2gK hAmplitude u)
  have hLow := low_pass_bound_from_h2_tail K rho Blow M2 kabs i coeff Wlow
    hK1 hRhoScale hkabs hBlow hM2 hH2 hLowOp
  have hSupport := finiteElectronPairLowPassOperator_hasLowPassSupport i j K g C count
  have hLowTail : ‖referenceTailOperator K kabs i (Wlow (fullCoeffVector coeff))‖ ≤
      (4 * Blow * M2) * rho ^ 2 := by
    rw [hSupport (fullCoeffVector coeff)]
    exact hLow
  have hHigh := finiteElectronPairHighPassOperator_norm_le_of_h2 i j hij
    K g C rho Cs Bker M2 basisExtra coeff hK1 hg hC hRho hRhoScale hCs hBker hM2
    hBkerScale hCsScale hH2
  have hHighTail : ‖referenceTailOperator K kabs i (Whigh (fullCoeffVector coeff))‖ ≤
      (Cs * Bker * M2) * rho :=
    (referenceTailOperator_norm_le K kabs i (Whigh (fullCoeffVector coeff))).trans hHigh
  have hSplit := finiteElectronPairCoulombOperator_low_add_high i j K g C count hK (le_of_lt hg)
  rw [hSplit, LinearMap.add_apply, map_add]
  exact (norm_add_le _ _).trans (add_le_add hLowTail hHighTail)

/-- Common K^(-1/2) form for a pair involving the reference electron. -/
lemma finiteElectronPairCoulombOperator_tail_bound_first
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (K g C rho Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) i
        (finiteElectronPairCoulombOperator i j C (cutoffShellIndex K g + basisExtra)
          (fullCoeffVector coeff))‖ ≤
      (4 * Blow * M2 + Cs * Bker * M2) * rho := by
  have hTwo := finiteElectronPairCoulombOperator_tail_bound_first_two_scale i j hij
    K g C rho Blow Cs Bker M2 basisExtra coeff hK1 hg hC hRho hRhoScale
    hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hH2
  have hSqLeOne : rho ^ 2 ≤ 1 := by
    nlinarith only [hRhoScale,
      mul_nonneg (sq_nonneg rho) (sub_nonneg.mpr hK1)]
  have hLeOne : rho ≤ 1 := by nlinarith only [hSqLeOne, sq_nonneg (rho - 1)]
  have hSqLe : rho ^ 2 ≤ rho := by
    nlinarith only [mul_nonneg hRho (sub_nonneg.mpr hLeOne)]
  have hLow0 : 0 ≤ 4 * Blow * M2 := mul_nonneg (mul_nonneg (by norm_num) hBlow) hM2
  calc
    _ ≤ (4 * Blow * M2) * rho ^ 2 + (Cs * Bker * M2) * rho := hTwo
    _ ≤ (4 * Blow * M2) * rho + (Cs * Bker * M2) * rho :=
      add_le_add (mul_le_mul_of_nonneg_left hSqLe hLow0) (le_refl _)
    _ = _ := by ring

/-- The same tail estimate when the reference electron is named second. -/
lemma finiteElectronPairCoulombOperator_tail_bound_second
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (K g C rho Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) j
        (finiteElectronPairCoulombOperator i j C (cutoffShellIndex K g + basisExtra)
          (fullCoeffVector coeff))‖ ≤
      (4 * Blow * M2 + Cs * Bker * M2) * rho := by
  rw [finiteElectronPairCoulombOperator_swap_particles i j C]
  exact finiteElectronPairCoulombOperator_tail_bound_first j i (Ne.symm hij)
    K g C rho Blow Cs Bker M2 basisExtra coeff hK1 hg hC hRho hRhoScale
    hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hH2

/-! ### Unaffected pairs and the complete electron--electron tail -/

/-- A pair preserves each spectator momentum, so its operator commutes with a
tail projector on a register outside the pair. -/
lemma finiteElectronPairKernelOperator_commutesWithReferenceTail
    {eta : ℕ} (i j r : Fin eta) (hri : r ≠ i) (hrj : r ≠ j) (count : ℕ)
    (K : ℝ) (kabs : FinitePlaneWaveMode count → ℝ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ) :
    CommutesWithReferenceTail K kabs r (finiteElectronPairKernelOperator i j count kernel) := by
  classical
  intro u
  ext q
  simp only [referenceTailOperator_apply, finiteElectronPairKernelOperator_apply]
  by_cases hq : K < kabs (q r)
  · rw [if_pos hq]
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hFiber : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
    · have href : q r = p r :=
        ((finiteElectronPairSliceLabel_eq_iff i j count q p).mp hFiber).1 r hri hrj
      have hpTail : K < kabs (p r) := by simpa only [href] using hq
      simp only [if_pos hpTail]
    · simp only [finiteElectronPairLiftKernel, if_neg hFiber, mul_zero]
  · rw [if_neg hq]
    symm
    apply Finset.sum_eq_zero
    intro p hp
    by_cases hFiber : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
    · have href : q r = p r :=
        ((finiteElectronPairSliceLabel_eq_iff i j count q p).mp hFiber).1 r hri hrj
      have hpTail : ¬ K < kabs (p r) := by simpa only [href] using hq
      simp only [if_neg hpTail, zero_mul]
    · simp only [finiteElectronPairLiftKernel, if_neg hFiber, mul_zero]

/-- A pair not involving the reference register has the stronger K^(-1) tail.
The required H1 estimate is the already proved genuine pair estimate. -/
lemma finiteElectronPairCoulombOperator_far_tail_bound
    {eta : ℕ} (i j r : Fin eta) (hij : i ≠ j) (hri : r ≠ i) (hrj : r ≠ j)
    (K g C rho B Hunit M2 : ℝ) (count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 ≤ g) (hC : 0 ≤ C)
    (hRhoScale : rho ^ 2 * K = 1) (hB : 0 ≤ B) (hM2 : 0 ≤ M2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g count) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g count) r
        (finiteElectronPairCoulombOperator i j C count (fullCoeffVector coeff))‖ ≤
      (B * M2) * rho ^ 2 := by
  have hComm : CommutesWithReferenceTail K (finitePlaneWaveKabs g count) r
      (finiteElectronPairCoulombOperator i j C count) :=
    finiteElectronPairKernelOperator_commutesWithReferenceTail i j r hri hrj count
      K (finitePlaneWaveKabs g count) (finiteCoulombKernel C count)
  have hPair := finiteElectronPairCoulombOperator_h1Bound_of_periodic
    i j hij g C B Hunit count hC hPeriodic hScale
  rw [hComm (fullCoeffVector coeff)]
  exact far_bound_from_h1_h2_tail K rho B M2 (finitePlaneWaveKabs g count) r coeff
    (finiteElectronPairCoulombOperator i j C count) hK1 hRhoScale
    (finitePlaneWaveKabs_nonneg g count hg) hB hM2 hH2 hPair

/-- A uniform all-reference bound for one pair.  This deliberately uses a common
budget for the affected and unaffected cases, suitable for a simple finite sum.
The stronger two-scale affected and far estimates remain separately available. -/
lemma finiteElectronPairCoulombOperator_tail_bound_any_reference
    {eta : ℕ} (i j r : Fin eta) (hij : i ≠ j)
    (K g C rho B Hunit Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hB : 0 ≤ B) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) r
        (finiteElectronPairCoulombOperator i j C (cutoffShellIndex K g + basisExtra)
          (fullCoeffVector coeff))‖ ≤
      (B * M2 + (4 * Blow * M2 + Cs * Bker * M2)) * rho := by
  have hFar0 : 0 ≤ B * M2 := mul_nonneg hB hM2
  have hNear0 : 0 ≤ 4 * Blow * M2 + Cs * Bker * M2 :=
    add_nonneg (mul_nonneg (mul_nonneg (by norm_num) hBlow) hM2)
      (mul_nonneg (mul_nonneg hCs hBker) hM2)
  have hNearBudget : (4 * Blow * M2 + Cs * Bker * M2) * rho ≤
      (B * M2 + (4 * Blow * M2 + Cs * Bker * M2)) * rho := by
    apply mul_le_mul_of_nonneg_right _ hRho
    linarith only [hFar0]
  by_cases hri : r = i
  · subst r
    exact (finiteElectronPairCoulombOperator_tail_bound_first i j hij
      K g C rho Blow Cs Bker M2 basisExtra coeff hK1 hg hC hRho hRhoScale
      hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hH2).trans hNearBudget
  · by_cases hrj : r = j
    · subst r
      exact (finiteElectronPairCoulombOperator_tail_bound_second i j hij
        K g C rho Blow Cs Bker M2 basisExtra coeff hK1 hg hC hRho hRhoScale
        hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hH2).trans hNearBudget
    · have hFar := finiteElectronPairCoulombOperator_far_tail_bound i j r hij hri hrj
        K g C rho B Hunit M2 (cutoffShellIndex K g + basisExtra) coeff
        hK1 (le_of_lt hg) hC hRhoScale hB hM2 hPeriodic hScale hH2
      have hSqLeOne : rho ^ 2 ≤ 1 := by
        nlinarith only [hRhoScale,
          mul_nonneg (sq_nonneg rho) (sub_nonneg.mpr hK1)]
      have hLeOne : rho ≤ 1 := by nlinarith only [hSqLeOne, sq_nonneg (rho - 1)]
      have hSqLe : rho ^ 2 ≤ rho := by
        nlinarith only [mul_nonneg hRho (sub_nonneg.mpr hLeOne)]
      calc
        _ ≤ (B * M2) * rho ^ 2 := hFar
        _ ≤ (B * M2) * rho := mul_le_mul_of_nonneg_left hSqLe hFar0
        _ ≤ (B * M2 + (4 * Blow * M2 + Cs * Bker * M2)) * rho := by
          apply mul_le_mul_of_nonneg_right _ hRho
          linarith only [hNear0]

/-!
## Milestone 115: assumption and constant audit

For a pair containing the reference register, the full pair tail is bounded by
4*Blow*M2*rho^2 + Cs*Bker*M2*rho.  The exact low/high split, its support property,
the low-pass Schur bound and high-pass H2 estimate have all been proved.
For a pair outside the reference register, its actual spectator conservation
proves commutation and the established pair H1 estimate gives B*M2*rho^2.

The final theorem sums every unordered pair once.  It uses the conservative
common budget P_eta*(B*M2 + 4*Blow*M2 + Cs*Bker*M2), where P_eta is the physical
number of pairs.  This is not an extra factor for the number/sizes of fibers,
conserved total momenta or finite basis states.  The stronger case-specific
bounds are retained so that the physical pair counting can later be sharpened.
All scalar norm choices can be independent of K and the auxiliary basis size.
The doubled transfer-shell horizon is preserved exactly.

The periodic Hardy premise is discharged in bo_onehundredfifteen_milestone;
only the agreed scalar remainder bound and the H2 state bound remain analytic
inputs.  Antisymmetry, an eigenvalue equation, and a spectral gap are not needed
for this potential-tail estimate.  No pair-tail hypothesis is introduced.

Still needed for the full molecular error theorem: the signed nuclear tails,
combining attraction and repulsion in the generic fermionic energy theorem,
particle-exchange invariance and the final cutoff/continuum interface.  The
new result is the complete electron--electron tail, not yet the full molecular
N^-1 energy bound.  All previously compiled declarations remain unchanged.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open MeasureTheory

/-! ## One-hundred-sixteenth milestone: signed nuclear tails and the full molecular energy bound

A translated nuclear kernel has the exact input/output factorization
z(v) * conj(z(w)) * kernel(v,w).  Multiplication of Fourier coefficients by
these factors cannot increase a diagonal Sobolev mass or a projected output
norm when their norms are at most one.  This transfers the proved unshifted
one-body tail estimate to every nuclear position, without changing its constant.

After summing the signed nuclear terms and the already bounded genuine pair
terms, the full molecular potential-tail premise is discharged.  The final
physical-cell theorem combines this with the previously proved molecular form
bound and the fermionic variational theorem.  Its cutoff is STILL the existing
Euclidean one-particle cutoff in a finite ambient mode set; neither a continuum
limit nor the manuscript's cubic-basis identification is asserted here.
-/

/-! ### Diagonal Fourier multipliers and exact nuclear gauge factors -/

/-- A coefficient multiplier bounded by one does not increase the H2 mass.
There is no regularity or measurability premise on a finite coefficient family. -/
lemma fullH2Sq_mul_coeff_le_of_norm_le_one
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ) (z coeff : FourierConfig eta μ → ℂ)
    (hz : ∀ p, ‖z p‖ ≤ 1) :
    fullH2Sq kabs (fun p => z p * coeff p) ≤ fullH2Sq kabs coeff := by
  classical
  unfold fullH2Sq coeffMass
  apply Finset.sum_le_sum
  intro p hp
  have hNorm : ‖z p * coeff p‖ ≤ ‖coeff p‖ := by
    rw [norm_mul]
    exact (mul_le_mul_of_nonneg_right (hz p) (norm_nonneg _)).trans_eq (one_mul _)
  exact mul_le_mul_of_nonneg_left
    (sq_le_sq_of_nonneg (norm_nonneg _) hNorm)
    (sq_nonneg (1 + boKineticSymbol kabs p))

/-- Exact gauge factorization at each configuration coefficient.  The kernel and
phases may be complex, and no modulus replacement is made in this identity. -/
lemma referenceKernelConvolutionOperator_gauge_apply
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (i : Fin eta) (z : μ → ℂ) (kernel : μ → μ → ℂ)
    (coeff : FourierConfig eta μ → ℂ) (q : FourierConfig eta μ) :
    (referenceKernelConvolutionOperator i
        (fun v w => (z v * (starRingEnd ℂ) (z w)) * kernel v w)
        (fullCoeffVector coeff)).ofLp q =
      z (q i) *
        (referenceKernelConvolutionOperator i kernel
          (fullCoeffVector (fun p => (starRingEnd ℂ) (z (p i)) * coeff p))).ofLp q := by
  classical
  rw [referenceKernelConvolutionOperator_apply,
    referenceKernelConvolutionOperator_apply, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p hp
  by_cases h : outerConfigOf i q = outerConfigOf i p
  · rw [referenceConfigurationKernel_of_outer_eq i
      (fun v w => (z v * (starRingEnd ℂ) (z w)) * kernel v w) q p h,
      referenceConfigurationKernel_of_outer_eq i kernel q p h]
    simp only [fullCoeffVector_apply]
    ring
  · rw [referenceConfigurationKernel_of_outer_ne i
      (fun v w => (z v * (starRingEnd ℂ) (z w)) * kernel v w) q p h,
      referenceConfigurationKernel_of_outer_ne i kernel q p h]
    simp only [mul_zero]

/-- The output gauge is a contraction even after a tail projection on ANY
register.  Only the input coefficients change on the right-hand side. -/
lemma referenceKernelConvolutionOperator_gauge_tail_norm_le
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (i r : Fin eta) (K : ℝ) (kabs : μ → ℝ)
    (z : μ → ℂ) (hz : ∀ v, ‖z v‖ ≤ 1) (kernel : μ → μ → ℂ)
    (coeff : FourierConfig eta μ → ℂ) :
    ‖referenceTailOperator K kabs r
        (referenceKernelConvolutionOperator i
          (fun v w => (z v * (starRingEnd ℂ) (z w)) * kernel v w)
          (fullCoeffVector coeff))‖ ≤
      ‖referenceTailOperator K kabs r
        (referenceKernelConvolutionOperator i kernel
          (fullCoeffVector (fun p => (starRingEnd ℂ) (z (p i)) * coeff p)))‖ := by
  classical
  let a := referenceKernelConvolutionOperator i
    (fun v w => (z v * (starRingEnd ℂ) (z w)) * kernel v w) (fullCoeffVector coeff)
  let b := referenceKernelConvolutionOperator i kernel
    (fullCoeffVector (fun p => (starRingEnd ℂ) (z (p i)) * coeff p))
  have hAction : ∀ q : FourierConfig eta μ, a.ofLp q = z (q i) * b.ofLp q := by
    intro q
    exact referenceKernelConvolutionOperator_gauge_apply i z kernel coeff q
  have hSq : ‖referenceTailOperator K kabs r a‖ ^ 2 ≤
      ‖referenceTailOperator K kabs r b‖ ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq]
    apply Finset.sum_le_sum
    intro q hq
    simp only [referenceTailOperator_apply]
    by_cases hTail : K < kabs (q r)
    · simp only [if_pos hTail, hAction q]
      apply sq_le_sq_of_nonneg (norm_nonneg _)
      rw [norm_mul]
      exact (mul_le_mul_of_nonneg_right (hz (q i)) (norm_nonneg _)).trans_eq (one_mul _)
    · simp only [if_neg hTail, le_refl]
  change ‖referenceTailOperator K kabs r a‖ ≤ ‖referenceTailOperator K kabs r b‖
  nlinarith only [hSq, norm_nonneg (referenceTailOperator K kabs r a),
    norm_nonneg (referenceTailOperator K kabs r b)]

/-! ### The unshifted and translated one-body tails -/

/-- Direct unshifted one-body tail with its two different powers of rho.
This uses only the already compiled low/high estimates, not a spectral theorem. -/
lemma referenceCoulombOperator_tail_bound_two_scale
    {eta : ℕ} (i : Fin eta)
    (K g C rho Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) i
        (referenceKernelConvolutionOperator i
          (finiteCoulombKernel C (cutoffShellIndex K g + basisExtra))
          (fullCoeffVector coeff))‖ ≤
      (4 * Blow * M2) * rho ^ 2 + (Cs * Bker * M2) * rho := by
  let count := cutoffShellIndex K g + basisExtra
  let kabs := finitePlaneWaveKabs g count
  let Wlow := referenceKernelConvolutionOperator i (finiteLowPassCoulombKernel K g C count)
  let Whigh := explicitHighPassCoulombOperator eta i K g C count
  have hK : 0 ≤ K := le_trans (by norm_num : (0 : ℝ) ≤ 1) hK1
  have hkabs : ∀ v, 0 ≤ kabs v := finitePlaneWaveKabs_nonneg g count (le_of_lt hg)
  have hLowOp : ∀ u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
      ‖referenceTailOperator K kabs i (Wlow u)‖ ≤ Blow * K * ‖u‖ := by
    intro u
    exact (referenceTailOperator_norm_le K kabs i (Wlow u)).trans
      (finiteLowPassCoulombOperator_norm_le_of_amplitudeScale i K g C Blow count
        hK hg hC hBlow h2gK hAmplitude u)
  have hLow := low_pass_bound_from_h2_tail K rho Blow M2 kabs i coeff Wlow
    hK1 hRhoScale hkabs hBlow hM2 hH2 hLowOp
  have hSupport := referenceKernelConvolutionOperator_hasLowPassSupport K kabs i
    (finiteLowPassCoulombKernel K g C count)
    (finiteLowPassCoulombKernel_hasReferenceSupport K g C count)
  have hLowTail : ‖referenceTailOperator K kabs i (Wlow (fullCoeffVector coeff))‖ ≤
      (4 * Blow * M2) * rho ^ 2 := by
    rw [hSupport (fullCoeffVector coeff)]
    exact hLow
  have hHigh := explicitHighPassCoulombOperator_norm_le_of_h2 i
    K g C rho Cs Bker M2 basisExtra coeff hK1 hg hC hRho hRhoScale hCs hBker hM2
    hBkerScale hCsScale hH2
  have hHighTail : ‖referenceTailOperator K kabs i (Whigh (fullCoeffVector coeff))‖ ≤
      (Cs * Bker * M2) * rho :=
    (referenceTailOperator_norm_le K kabs i (Whigh (fullCoeffVector coeff))).trans hHigh
  rw [referenceLowHighCoulombOperator_eq_full i K g C count hK (le_of_lt hg),
    LinearMap.add_apply, map_add]
  exact (norm_add_le _ _).trans (add_le_add hLowTail hHighTail)

/-- Nuclear positions enter only through diagonal Fourier phases.  The transformed
input has no larger H2 mass, and the projected output is a contraction. -/
lemma finiteTranslatedCoulombOperator_tail_bound_self_two_scale
    {eta : ℕ} (i : Fin eta)
    (K g C rho Blow Cs Bker M2 : ℝ) (basisExtra : ℕ) (R : UnitTorus3)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) i
        (referenceKernelConvolutionOperator i
          (finiteTranslatedCoulombKernel C (cutoffShellIndex K g + basisExtra) R)
          (fullCoeffVector coeff))‖ ≤
      (4 * Blow * M2) * rho ^ 2 + (Cs * Bker * M2) * rho := by
  let count := cutoffShellIndex K g + basisExtra
  let z : FinitePlaneWaveMode count → ℂ := finiteNuclearFourierPhase count R
  let c : FourierConfig eta (FinitePlaneWaveMode count) → ℂ :=
    fun p => (starRingEnd ℂ) (z (p i)) * coeff p
  have hz : ∀ v, ‖z v‖ ≤ 1 := finiteNuclearFourierPhase_norm_le_one count R
  have hConj : ∀ p : FourierConfig eta (FinitePlaneWaveMode count),
      ‖(starRingEnd ℂ) (z (p i))‖ ≤ 1 := by
    intro p
    simpa using hz (p i)
  have hH2c : fullH2Sq (finitePlaneWaveKabs g count) c ≤ M2 ^ 2 :=
    (fullH2Sq_mul_coeff_le_of_norm_le_one (finitePlaneWaveKabs g count)
      (fun p => (starRingEnd ℂ) (z (p i))) coeff hConj).trans hH2
  have hGauge := referenceKernelConvolutionOperator_gauge_tail_norm_le i i K
    (finitePlaneWaveKabs g count) z hz (finiteCoulombKernel C count) coeff
  exact hGauge.trans (referenceCoulombOperator_tail_bound_two_scale i
    K g C rho Blow Cs Bker M2 basisExtra c hK1 hg hC hRho hRhoScale
    hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hH2c)

/-- Any one-body kernel leaves every other register fixed and therefore commutes
with its tail projector.  This applies to the signed and phased coefficients. -/
lemma referenceKernelConvolutionOperator_commutesWith_other_tail
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (i r : Fin eta) (hri : r ≠ i) (K : ℝ) (kabs : μ → ℝ)
    (kernel : μ → μ → ℂ) :
    CommutesWithReferenceTail K kabs r (referenceKernelConvolutionOperator i kernel) := by
  classical
  intro u
  ext q
  simp only [referenceTailOperator_apply, referenceKernelConvolutionOperator_apply]
  by_cases hq : K < kabs (q r)
  · rw [if_pos hq]
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hOuter : outerConfigOf i q = outerConfigOf i p
    · have href : q r = p r := congrFun hOuter ⟨r, hri⟩
      have hpTail : K < kabs (p r) := by simpa only [href] using hq
      simp only [if_pos hpTail]
    · simp only [referenceConfigurationKernel_of_outer_ne i kernel q p hOuter, mul_zero]
  · rw [if_neg hq]
    symm
    apply Finset.sum_eq_zero
    intro p hp
    by_cases hOuter : outerConfigOf i q = outerConfigOf i p
    · have href : q r = p r := congrFun hOuter ⟨r, hri⟩
      have hpTail : ¬ K < kabs (p r) := by simpa only [href] using hq
      simp only [if_neg hpTail, zero_mul]
    · simp only [referenceConfigurationKernel_of_outer_ne i kernel q p hOuter, mul_zero]

/-- The translated one-body term has an O(K^-1) tail on an unaffected register. -/
lemma finiteTranslatedCoulombOperator_far_tail_bound
    {eta : ℕ} (i r : Fin eta) (hri : r ≠ i)
    (K g C rho B M2 : ℝ) (count : ℕ) (R : UnitTorus3)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 ≤ g)
    (hRhoScale : rho ^ 2 * K = 1) (hB : 0 ≤ B) (hM2 : 0 ≤ M2)
    (hOne : HasOneParticleCoulombH1Bound g C B count)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g count) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g count) r
        (referenceKernelConvolutionOperator i (finiteTranslatedCoulombKernel C count R)
          (fullCoeffVector coeff))‖ ≤ (B * M2) * rho ^ 2 := by
  have hComm := referenceKernelConvolutionOperator_commutesWith_other_tail i r hri K
    (finitePlaneWaveKabs g count) (finiteTranslatedCoulombKernel C count R)
  rw [hComm (fullCoeffVector coeff)]
  exact far_bound_from_h1_h2_tail K rho B M2 (finitePlaneWaveKabs g count) r coeff
    (referenceKernelConvolutionOperator i (finiteTranslatedCoulombKernel C count R))
    hK1 hRhoScale (finitePlaneWaveKabs_nonneg g count hg) hB hM2 hH2
    (finiteTranslatedCoulombOperator_h1Bound i g C B count R hOne)

/-- The scale relation used to put stronger O(K^-1) terms in a common O(K^-1/2)
budget.  This includes all cases permitted by rho >= 0 and K >= 1. -/
lemma rho_sq_le_rho_of_cutoff_scale
    {K rho : ℝ} (hK : 1 ≤ K) (hRho : 0 ≤ rho) (hScale : rho ^ 2 * K = 1) :
    rho ^ 2 ≤ rho := by
  have hSqLeOne : rho ^ 2 ≤ 1 := by
    nlinarith only [hScale, mul_nonneg (sq_nonneg rho) (sub_nonneg.mpr hK)]
  have hLeOne : rho ≤ 1 := by nlinarith only [hSqLeOne, sq_nonneg (rho - 1)]
  nlinarith only [mul_nonneg hRho (sub_nonneg.mpr hLeOne)]

/-- Uniform all-reference tail of a translated one-body term.  Its constant is
the same conservative common budget used for genuine pairs in milestone 115. -/
lemma finiteTranslatedCoulombOperator_tail_bound_any_reference
    {eta : ℕ} (i r : Fin eta)
    (K g C rho B Blow Cs Bker M2 : ℝ) (basisExtra : ℕ) (R : UnitTorus3)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hB : 0 ≤ B) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2) (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hOne : HasOneParticleCoulombH1Bound g C B (cutoffShellIndex K g + basisExtra))
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) r
        (referenceKernelConvolutionOperator i
          (finiteTranslatedCoulombKernel C (cutoffShellIndex K g + basisExtra) R)
          (fullCoeffVector coeff))‖ ≤
      (B * M2 + (4 * Blow * M2 + Cs * Bker * M2)) * rho := by
  have hSqLe := rho_sq_le_rho_of_cutoff_scale hK1 hRho hRhoScale
  have hFar0 : 0 ≤ B * M2 := mul_nonneg hB hM2
  have hLow0 : 0 ≤ 4 * Blow * M2 := mul_nonneg (mul_nonneg (by norm_num) hBlow) hM2
  have hHigh0 : 0 ≤ Cs * Bker * M2 := mul_nonneg (mul_nonneg hCs hBker) hM2
  by_cases hri : r = i
  · subst r
    have hTwo := finiteTranslatedCoulombOperator_tail_bound_self_two_scale i
      K g C rho Blow Cs Bker M2 basisExtra R coeff hK1 hg hC hRho hRhoScale
      hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hH2
    calc
      _ ≤ (4 * Blow * M2) * rho ^ 2 + (Cs * Bker * M2) * rho := hTwo
      _ ≤ (4 * Blow * M2) * rho + (Cs * Bker * M2) * rho :=
        add_le_add (mul_le_mul_of_nonneg_left hSqLe hLow0) (le_refl _)
      _ ≤ (B * M2 + (4 * Blow * M2 + Cs * Bker * M2)) * rho := by
        nlinarith only [mul_nonneg hFar0 hRho]
  · have hFar := finiteTranslatedCoulombOperator_far_tail_bound i r hri
      K g C rho B M2 (cutoffShellIndex K g + basisExtra) R coeff
      hK1 (le_of_lt hg) hRhoScale hB hM2 hOne hH2
    calc
      _ ≤ (B * M2) * rho ^ 2 := hFar
      _ ≤ (B * M2) * rho := mul_le_mul_of_nonneg_left hSqLe hFar0
      _ ≤ (B * M2 + (4 * Blow * M2 + Cs * Bker * M2)) * rho := by
        nlinarith only [mul_nonneg (add_nonneg hLow0 hHigh0) hRho]

/-! ### Attractive charge weights and the full nuclear sum -/

/-- The attractive sign and nuclear phase are retained in the operator.  Only
its scalar charge is replaced by its absolute value in the norm estimate. -/
lemma finiteElectronNuclearTerm_tail_bound_any_reference
    {ν : Type*} {eta : ℕ} (i r : Fin eta) (data : FiniteBONuclearData ν) (ell : ν)
    (K g gamma rho B Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hB : 0 ≤ B) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt (gamma ^ 2) ≤ Blow * g)
    (hBkerScale : 432 * gamma ^ 2 * g ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hOne : HasOneParticleCoulombH1Bound g (gamma ^ 2) B (cutoffShellIndex K g + basisExtra))
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) r
        (referenceKernelConvolutionOperator i
          (finiteElectronNuclearKernel data gamma (cutoffShellIndex K g + basisExtra) ell)
          (fullCoeffVector coeff))‖ ≤
      data.charge ell * ((B * M2 + (4 * Blow * M2 + Cs * Bker * M2)) * rho) := by
  have hTranslated := finiteTranslatedCoulombOperator_tail_bound_any_reference i r
    K g (gamma ^ 2) rho B Blow Cs Bker M2 basisExtra (data.position ell) coeff
    hK1 hg (sq_nonneg gamma) hRho hRhoScale hB hBlow hCs hBker hM2
    h2gK hAmplitude hBkerScale hCsScale hOne hH2
  unfold finiteElectronNuclearKernel
  rw [referenceKernelConvolutionOperator_smul_kernel, LinearMap.smul_apply,
    map_smul, norm_smul]
  simp only [norm_neg, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (data.charge_nonneg ell)]
  exact mul_le_mul_of_nonneg_left hTranslated (data.charge_nonneg ell)

/-! ### Full signed potential tail; hPT is no longer external -/

/-- A conservative common budget for all nuclear terms and unordered pairs.
It has no K or ambient-basis-count argument.  Constants can be sharpened by
counting affected and unaffected terms separately, without altering the proof. -/
noncomputable def finiteMolecularCoulombTailConstant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (B Blow Cs Bker M2 : ℝ) : ℝ :=
  ((eta : ℝ) * data.totalCharge + (Fintype.card (FiniteElectronPair eta) : ℝ)) *
    (B * M2 + (4 * Blow * M2 + Cs * Bker * M2))

/-! ### Physical cell normalization and the fermionic molecular energy estimate -/

/-- The physical tail budget uses the same explicit one-particle H1 constant as
the completed molecular form estimate.  No cutoff K or basis count occurs here. -/
noncomputable def finiteMolecularCoulombPhysicalTailConstant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (L Hunit Blow Cs Bker M2 : ℝ) : ℝ :=
  finiteMolecularCoulombTailConstant eta data
    (coulombPhysicalH1Constant (2 * Real.pi / L) ((coulombCellAmplitude L) ^ 2) Hunit)
    Blow Cs Bker M2

