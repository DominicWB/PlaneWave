    molecularPositionFourierTest_hasDerivAt_coordinateLine eta s c x a t
  hasSecond a x t :=
    molecularPositionFourierTest_hasDerivAt_coordinateLine eta s
      (fun p => c p * (2 * (Real.pi : ℂ) * Complex.I * (p a.1 a.2 : ℂ)))
      x a t

