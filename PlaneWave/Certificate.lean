  coulombLatticeNuclearKernel sys (coulombCellAmplitude L) q p +
    coulombLatticePairKernel sys (coulombCellAmplitude L) q p

lemma fourierKernelFiniteOutput_pot_eq (N : ℕ) (u : MolecularFourierH2 eta) (count : ℕ) :
    fourierKernelFiniteOutput (2 * Real.pi / L) (potKernel sys L) N u count =
      finiteCoulombPotential sys (coulombCellAmplitude L) count
        (fullCoeffVector (finiteFourierCoeffExtract count
          (molecularH2Coeff (2 * Real.pi / L) (molecularH2Truncate N u)))) := by
  ext q
  rw [finiteCoulombPotential_eq_latticeKernel]
  rfl

include hKernel in
/-- The compressions of the completed potential are the finite potentials. -/
lemma truncate_potential_eq (N count : ℕ) (hN : N ≤ count) (u : MolecularFourierH2 eta) :
