    (Ξ₁ := 2 * ‖h₁‖ + 2 * relB sys L molecularCanonicalUnitHardyConstant * ‖h₀‖)
    (c0 := finiteCoulombPhysicalTailConstant sys L molecularCanonicalUnitHardyConstant
