Fourier coefficients. The argument uses preservation of the L2 inner product. -/
theorem torusFourierPullback_Lp_coeff_image {d e : Type*} [Fintype d] [Fintype e]
    (F : UnitAddTorus d → UnitAddTorus e)
    (hF : MeasurePreserving F (volume : Measure (UnitAddTorus d)) volume)
    (J : (e → ℤ) → (d → ℤ))
    (hChar : ∀ n x, UnitAddTorus.mFourier n (F x) = UnitAddTorus.mFourier (J n) x)
    (f : Lp ℂ 2 (volume : Measure (UnitAddTorus e))) (n : e → ℤ) :
    UnitAddTorus.mFourierCoeff ((Lp.compMeasurePreservingₗᵢ ℂ F hF) f) (J n) =
      UnitAddTorus.mFourierCoeff f n := by
  rw [← torus_mFourier_inner_eq_coeff, ← torus_mFourier_inner_eq_coeff,
    ← torusFourierPullback_basis F hF J hChar n]
  exact (Lp.compMeasurePreservingₗᵢ ℂ F hF).inner_map_map _ f

/-- Every frequency outside the pullback image has zero coefficient. This
uses the complete L2 Fourier series, so no regularity beyond L2 is needed. -/
theorem torusFourierPullback_Lp_coeff_eq_zero {d e : Type*} [Fintype d] [Fintype e]
    (F : UnitAddTorus d → UnitAddTorus e)
    (hF : MeasurePreserving F (volume : Measure (UnitAddTorus d)) volume)
    (J : (e → ℤ) → (d → ℤ))
    (hChar : ∀ n x, UnitAddTorus.mFourier n (F x) = UnitAddTorus.mFourier (J n) x)
    (f : Lp ℂ 2 (volume : Measure (UnitAddTorus e)))
    (q : d → ℤ) (hq : ∀ n, J n ≠ q) :
    UnitAddTorus.mFourierCoeff ((Lp.compMeasurePreservingₗᵢ ℂ F hF) f) q = 0 := by
  classical
  let T : Lp ℂ 2 (volume : Measure (UnitAddTorus e)) →ₗᵢ[ℂ]
      Lp ℂ 2 (volume : Measure (UnitAddTorus d)) :=
    Lp.compMeasurePreservingₗᵢ ℂ F hF
  have hZero : ∀ n : e → ℤ,
      inner ℂ (UnitAddTorus.mFourierLp 2 q) (T (UnitAddTorus.mFourierLp 2 n)) = 0 := by
    intro n
    change inner ℂ (UnitAddTorus.mFourierLp 2 q)
      ((Lp.compMeasurePreservingₗᵢ ℂ F hF) (UnitAddTorus.mFourierLp 2 n)) = 0
    rw [torusFourierPullback_basis F hF J hChar n]
    simpa only [if_neg (Ne.symm (hq n))] using
      (orthonormal_iff_ite.mp UnitAddTorus.orthonormal_mFourier) q (J n)
  have hSum := (UnitAddTorus.hasSum_mFourier_series_L2 f).mapL
    ((innerSL ℂ (UnitAddTorus.mFourierLp 2 q)).comp T.toContinuousLinearMap)
  change HasSum
    (fun n => inner ℂ (UnitAddTorus.mFourierLp 2 q)
      (T (UnitAddTorus.mFourierCoeff f n • UnitAddTorus.mFourierLp 2 n)))
    (inner ℂ (UnitAddTorus.mFourierLp 2 q) (T f)) at hSum
  simp only [map_smul, inner_smul_right, hZero, mul_zero] at hSum
  rw [← torus_mFourier_inner_eq_coeff]
  exact hSum.unique hasSum_zero

/-- Pulling back the L2 class of V has the literal representative V composed
with F, with both representative ambiguities handled by measure preservation. -/
theorem torusFourierPullback_coeFn_toLp {d e : Type*} [Fintype d] [Fintype e]
    (F : UnitAddTorus d → UnitAddTorus e)
    (hF : MeasurePreserving F (volume : Measure (UnitAddTorus d)) volume)
    (V : UnitAddTorus e → ℂ) (hV : MemLp V 2 volume) :
    ((Lp.compMeasurePreservingₗᵢ ℂ F hF) (hV.toLp V) : UnitAddTorus d → ℂ)
      =ᵐ[volume] (fun x => V (F x)) := by
  filter_upwards [Lp.coeFn_compMeasurePreserving (hV.toLp V) hF,
    hF.quasiMeasurePreserving.ae (MemLp.coeFn_toLp hV)] with x hComp hVx
  exact hComp.trans hVx

/-- The image-frequency pullback formula for an actual L2 potential function. -/
theorem torusFourierPullback_coeff_image {d e : Type*} [Fintype d] [Fintype e]
    (F : UnitAddTorus d → UnitAddTorus e)
    (hF : MeasurePreserving F (volume : Measure (UnitAddTorus d)) volume)
    (J : (e → ℤ) → (d → ℤ))
    (hChar : ∀ n x, UnitAddTorus.mFourier n (F x) = UnitAddTorus.mFourier (J n) x)
    (V : UnitAddTorus e → ℂ) (hV : MemLp V 2 volume) (n : e → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => V (F x)) (J n) =
      UnitAddTorus.mFourierCoeff V n := by
  have h := torusFourierPullback_Lp_coeff_image F hF J hChar (hV.toLp V) n
  rw [torus_mFourierCoeff_congr_ae (torusFourierPullback_coeFn_toLp F hF V hV),
    torus_mFourierCoeff_congr_ae (MemLp.coeFn_toLp hV)] at h
  exact h

/-- The vanishing formula outside the frequency image for an actual L2
potential function. No Fourier coefficient hypothesis is imposed on V. -/
theorem torusFourierPullback_coeff_eq_zero {d e : Type*} [Fintype d] [Fintype e]
    (F : UnitAddTorus d → UnitAddTorus e)
    (hF : MeasurePreserving F (volume : Measure (UnitAddTorus d)) volume)
    (J : (e → ℤ) → (d → ℤ))
    (hChar : ∀ n x, UnitAddTorus.mFourier n (F x) = UnitAddTorus.mFourier (J n) x)
    (V : UnitAddTorus e → ℂ) (hV : MemLp V 2 volume)
    (q : d → ℤ) (hq : ∀ n, J n ≠ q) :
    UnitAddTorus.mFourierCoeff (fun x => V (F x)) q = 0 := by
  have h := torusFourierPullback_Lp_coeff_eq_zero F hF J hChar (hV.toLp V) q hq
  rw [torus_mFourierCoeff_congr_ae (torusFourierPullback_coeFn_toLp F hF V hV)] at h
  exact h

end
end PlaneWaveCertificate

/-! ## character lifts -/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped BigOperators Topology ComplexConjugate

noncomputable section

/-- A three-dimensional frequency supported on particle `i`. -/
def molecularParticleFrequency {eta : ℕ} (i : Fin eta) (n : Lattice3) :
    (Fin eta × Fin 3) → ℤ :=
  fun a => if a.1 = i then n a.2 else 0

/-- Opposite frequencies on two particles, as required by a potential
depending only on their position difference. -/
def molecularPairFrequency {eta : ℕ} (i j : Fin eta) (n : Lattice3) :
    (Fin eta × Fin 3) → ℤ :=
  molecularParticleFrequency i n - molecularParticleFrequency j n

/-- Addition in the position argument multiplies the corresponding Fourier
characters. -/
theorem mFourier_add_position {d : Type*} [Fintype d]
    (n : d → ℤ) (x y : UnitAddTorus d) :
    UnitAddTorus.mFourier n (x + y) =
      UnitAddTorus.mFourier n x * UnitAddTorus.mFourier n y := by
  change (∏ a : d, fourier (n a) (x a + y a)) =
    (∏ a : d, fourier (n a) (x a)) * ∏ a : d, fourier (n a) (y a)
  simp only [fourier_add_argument, Finset.prod_mul_distrib]

/-- Negating positions agrees with negating Fourier frequencies. -/
theorem mFourier_neg_position {d : Type*} [Fintype d]
    (n : d → ℤ) (x : UnitAddTorus d) :
    UnitAddTorus.mFourier n (-x) = UnitAddTorus.mFourier (-n) x := by
  change (∏ a : d, fourier (n a) (-x a)) =
    ∏ a : d, fourier (-n a) (x a)
  apply Finset.prod_congr rfl
  intro a _
  simp only [fourier_apply, smul_neg, neg_smul]

/-- The lifted one-particle character is the original character evaluated at
that particle's actual position. -/
theorem mFourier_molecularParticleFrequency {eta : ℕ}
    (i : Fin eta) (n : Lattice3) (x : MolecularPositionTorus eta) :
    UnitAddTorus.mFourier (molecularParticleFrequency i n) x =
      UnitAddTorus.mFourier n (molecularPositionParticle i x) := by
  change (∏ a : Fin eta × Fin 3,
      fourier (if a.1 = i then n a.2 else 0) (x a)) =
    ∏ a : Fin 3, fourier (n a) (x (i, a))
  rw [Fintype.prod_prod_type]
  rw [Finset.prod_eq_single i]
  · simp only [ite_true]
  · intro k _ hki
    simp only [if_neg hki, fourier_zero, Finset.prod_const_one]
  · intro hi
    exact (hi (Finset.mem_univ i)).elim

/-- The lifted opposite-particle character is the original character
evaluated at the relative position. -/
theorem mFourier_molecularPairFrequency {eta : ℕ}
    (i j : Fin eta) (n : Lattice3) (x : MolecularPositionTorus eta) :
    UnitAddTorus.mFourier (molecularPairFrequency i j n) x =
      UnitAddTorus.mFourier n (molecularPositionDifference i j x) := by
  unfold molecularPairFrequency molecularPositionDifference
  rw [sub_eq_add_neg, UnitAddTorus.mFourier_add, UnitAddTorus.mFourier_neg,
    mFourier_molecularParticleFrequency, mFourier_molecularParticleFrequency]
  rw [sub_eq_add_neg, mFourier_add_position, mFourier_neg_position,
    UnitAddTorus.mFourier_neg]

/-- A frequency is supported on particle `i` precisely when all spectator
frequencies vanish. -/
theorem molecularParticleFrequency_eq_iff {eta : ℕ} (i : Fin eta)
    (r : (Fin eta × Fin 3) → ℤ) :
    molecularParticleFrequency i (fun a => r (i, a)) = r ↔
      ∀ k : Fin eta, k ≠ i → ∀ a : Fin 3, r (k, a) = 0 := by
  constructor
  · intro h k hki a
    have ha := congrFun h (k, a)
    simpa only [molecularParticleFrequency, if_neg hki] using ha.symm
  · intro h
    funext z
    rcases z with ⟨k, a⟩
    by_cases hki : k = i
    · subst k
      simp only [molecularParticleFrequency, ite_true]
    · simp only [molecularParticleFrequency, if_neg hki, h k hki a]

theorem molecularParticleFrequency_mem_range_iff {eta : ℕ} (i : Fin eta)
    (r : (Fin eta × Fin 3) → ℤ) :
    r ∈ Set.range (molecularParticleFrequency i) ↔
      ∀ k : Fin eta, k ≠ i → ∀ a : Fin 3, r (k, a) = 0 := by
  constructor
  · rintro ⟨n, rfl⟩ k hki a
    simp only [molecularParticleFrequency, if_neg hki]
  · intro h
    exact ⟨fun a => r (i, a), (molecularParticleFrequency_eq_iff i r).mpr h⟩

/-- A pair frequency has equal and opposite active components and zero
spectators. -/
theorem molecularPairFrequency_eq_iff {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) (r : (Fin eta × Fin 3) → ℤ) :
    molecularPairFrequency i j (fun a => r (i, a)) = r ↔
      (∀ a : Fin 3, r (j, a) = -r (i, a)) ∧
      (∀ k : Fin eta, k ≠ i → k ≠ j → ∀ a : Fin 3, r (k, a) = 0) := by
  constructor
  · intro h
    constructor
    · intro a
      have ha := congrFun h (j, a)
      simpa only [molecularPairFrequency, Pi.sub_apply, molecularParticleFrequency,
        if_neg (Ne.symm hij), ite_true, zero_sub] using ha.symm
    · intro k hki hkj a
      have ha := congrFun h (k, a)
      simpa only [molecularPairFrequency, Pi.sub_apply, molecularParticleFrequency,
        if_neg hki, if_neg hkj, sub_self] using ha.symm
  · rintro ⟨hOpp, hOther⟩
    funext z
    rcases z with ⟨k, a⟩
    by_cases hki : k = i
    · subst k
      simp only [molecularPairFrequency, Pi.sub_apply, molecularParticleFrequency,
        ite_true, if_neg hij, sub_zero]
    · by_cases hkj : k = j
      · subst k
        simp only [molecularPairFrequency, Pi.sub_apply, molecularParticleFrequency,
          if_neg (Ne.symm hij), ite_true, zero_sub, hOpp a]
      · simp only [molecularPairFrequency, Pi.sub_apply, molecularParticleFrequency,
          if_neg hki, if_neg hkj, sub_self, hOther k hki hkj a]

theorem molecularPairFrequency_mem_range_iff {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) (r : (Fin eta × Fin 3) → ℤ) :
    r ∈ Set.range (molecularPairFrequency i j) ↔
      (∀ a : Fin 3, r (j, a) = -r (i, a)) ∧
      (∀ k : Fin eta, k ≠ i → k ≠ j → ∀ a : Fin 3, r (k, a) = 0) := by
  constructor
  · rintro ⟨n, rfl⟩
    constructor
    · intro a
      simp only [molecularPairFrequency, Pi.sub_apply, molecularParticleFrequency,
        ite_true, if_neg hij, if_neg (Ne.symm hij), sub_zero, zero_sub]
    · intro k hki hkj a
      simp only [molecularPairFrequency, Pi.sub_apply, molecularParticleFrequency,
        if_neg hki, if_neg hkj, sub_self]
  · intro h
    exact ⟨fun a => r (i, a), (molecularPairFrequency_eq_iff i j hij r).mpr h⟩

/-- For an output-minus-input transfer, the one-particle character selection
rule is exactly preservation of all spectator momenta. -/
theorem molecularParticleFrequency_transfer_eq_iff {eta : ℕ}
    (i : Fin eta) (q p : FourierConfig eta Lattice3) :
    molecularParticleFrequency i (latticeSub (q i) (p i)) =
        molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p ↔
      ∀ k : Fin eta, k ≠ i → q k = p k := by
  change molecularParticleFrequency i
      (fun a => (molecularFourierIndexEquiv eta q -
        molecularFourierIndexEquiv eta p) (i, a)) = _ ↔ _
  rw [molecularParticleFrequency_eq_iff]
  constructor
  · intro h k hki
    funext a
    exact sub_eq_zero.mp (h k hki a)
  · intro h k hki a
    change q k a - p k a = 0
    rw [h k hki, sub_self]

theorem molecularParticleFrequency_transfer_mem_range_iff {eta : ℕ}
    (i : Fin eta) (q p : FourierConfig eta Lattice3) :
    (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) ∈
        Set.range (molecularParticleFrequency i) ↔
      ∀ k : Fin eta, k ≠ i → q k = p k := by
  rw [molecularParticleFrequency_mem_range_iff]
  exact (molecularParticleFrequency_eq_iff i _).symm.trans
    (molecularParticleFrequency_transfer_eq_iff i q p)

/-- For pair interactions the frequency selection rule is exactly the
existing kernel's spectator preservation and total pair momentum constraint. -/
theorem molecularPairFrequency_transfer_eq_iff {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) (q p : FourierConfig eta Lattice3) :
    molecularPairFrequency i j (latticeSub (q i) (p i)) =
        molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p ↔
      (∀ k : Fin eta, k ≠ i → k ≠ j → q k = p k) ∧
        q i + q j = p i + p j := by
  change molecularPairFrequency i j
      (fun a => (molecularFourierIndexEquiv eta q -
        molecularFourierIndexEquiv eta p) (i, a)) = _ ↔ _
  rw [molecularPairFrequency_eq_iff i j hij]
  constructor
  · rintro ⟨hOpp, hOther⟩
    constructor
    · intro k hki hkj
      funext a
      exact sub_eq_zero.mp (hOther k hki hkj a)
    · funext a
      have h := hOpp a
      change q j a - p j a = -(q i a - p i a) at h
      change q i a + q j a = p i a + p j a
      omega
  · rintro ⟨hOther, hTotal⟩
    constructor
    · intro a
      have h := congrFun hTotal a
      change q i a + q j a = p i a + p j a at h
      change q j a - p j a = -(q i a - p i a)
      omega
    · intro k hki hkj a
      change q k a - p k a = 0
      rw [hOther k hki hkj, sub_self]

theorem molecularPairFrequency_transfer_mem_range_iff {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) (q p : FourierConfig eta Lattice3) :
    (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) ∈
        Set.range (molecularPairFrequency i j) ↔
      (∀ k : Fin eta, k ≠ i → k ≠ j → q k = p k) ∧
        q i + q j = p i + p j := by
  rw [molecularPairFrequency_mem_range_iff i j hij]
  exact (molecularPairFrequency_eq_iff i j hij _).symm.trans
    (molecularPairFrequency_transfer_eq_iff i j hij q p)

end
end PlaneWaveCertificate

/-! ## fourier linearity -/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped BigOperators

noncomputable section

local instance unitAddCircleMeasureSpaceForLinearity138 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/- The almost-everywhere congruence lemma is supplied by the preceding
Fourier-pullback fragment of milestone 138. -/

@[simp]
theorem torus_mFourierCoeff_zero {d : Type*} [Fintype d] (n : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun _ : UnitAddTorus d => (0 : ℂ)) n = 0 := by
  simp [UnitAddTorus.mFourierCoeff]

/-- Additivity on L2 classes follows from linearity of the Fourier Hilbert
basis representation. -/
theorem torusL2_mFourierCoeff_add {d : Type*} [Fintype d]
    (f g : Lp ℂ 2 (volume : Measure (UnitAddTorus d))) (n : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => (f + g) x) n =
      UnitAddTorus.mFourierCoeff (fun x => f x) n +
        UnitAddTorus.mFourierCoeff (fun x => g x) n := by
  calc
    UnitAddTorus.mFourierCoeff (fun x => (f + g) x) n =
        UnitAddTorus.mFourierBasis.repr (f + g) n :=
      (UnitAddTorus.mFourierBasis_repr (f + g) n).symm
    _ = UnitAddTorus.mFourierBasis.repr f n +
        UnitAddTorus.mFourierBasis.repr g n :=
      congrArg (fun u : lp (fun _ : d → ℤ => ℂ) 2 => u n)
        (map_add UnitAddTorus.mFourierBasis.repr f g)
    _ = _ := by rw [UnitAddTorus.mFourierBasis_repr, UnitAddTorus.mFourierBasis_repr]

/-- Additivity of Fourier coefficients for concrete square-integrable
representatives, obtained by transporting the L2 identity. -/
theorem torus_mFourierCoeff_add_of_memLp {d : Type*} [Fintype d]
    (f g : UnitAddTorus d → ℂ) (hf : MemLp f 2 volume) (hg : MemLp g 2 volume)
    (n : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => f x + g x) n =
      UnitAddTorus.mFourierCoeff f n + UnitAddTorus.mFourierCoeff g n := by
  have hF : (fun x => hf.toLp f x) =ᵐ[volume] f := MemLp.coeFn_toLp hf
  have hG : (fun x => hg.toLp g x) =ᵐ[volume] g := MemLp.coeFn_toLp hg
  have hAdd : (fun x => (hf.toLp f + hg.toLp g) x) =ᵐ[volume]
      (fun x => f x + g x) := by
    filter_upwards [Lp.coeFn_add (hf.toLp f) (hg.toLp g), hF, hG]
      with x hx hfx hgx
    rw [hx]
    change hf.toLp f x + hg.toLp g x = f x + g x
    rw [hfx, hgx]
  rw [← torus_mFourierCoeff_congr_ae hAdd n,
    torusL2_mFourierCoeff_add,
    torus_mFourierCoeff_congr_ae hF n,
    torus_mFourierCoeff_congr_ae hG n]

/-- Subtraction on L2 classes is transported from the same Fourier
representation; no pointwise representative is chosen in the proof. -/
theorem torusL2_mFourierCoeff_sub {d : Type*} [Fintype d]
    (f g : Lp ℂ 2 (volume : Measure (UnitAddTorus d))) (n : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => (f - g) x) n =
      UnitAddTorus.mFourierCoeff (fun x => f x) n -
        UnitAddTorus.mFourierCoeff (fun x => g x) n := by
  calc
    UnitAddTorus.mFourierCoeff (fun x => (f - g) x) n =
        UnitAddTorus.mFourierBasis.repr (f - g) n :=
      (UnitAddTorus.mFourierBasis_repr (f - g) n).symm
    _ = UnitAddTorus.mFourierBasis.repr f n -
        UnitAddTorus.mFourierBasis.repr g n :=
      congrArg (fun u : lp (fun _ : d → ℤ => ℂ) 2 => u n)
        (map_sub UnitAddTorus.mFourierBasis.repr f g)
    _ = _ := by rw [UnitAddTorus.mFourierBasis_repr, UnitAddTorus.mFourierBasis_repr]

/-- Subtraction of Fourier coefficients for concrete L2 representatives. -/
theorem torus_mFourierCoeff_sub_of_memLp {d : Type*} [Fintype d]
    (f g : UnitAddTorus d → ℂ) (hf : MemLp f 2 volume) (hg : MemLp g 2 volume)
    (n : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => f x - g x) n =
      UnitAddTorus.mFourierCoeff f n - UnitAddTorus.mFourierCoeff g n := by
  have hF : (fun x => hf.toLp f x) =ᵐ[volume] f := MemLp.coeFn_toLp hf
  have hG : (fun x => hg.toLp g x) =ᵐ[volume] g := MemLp.coeFn_toLp hg
  have hSub : (fun x => (hf.toLp f - hg.toLp g) x) =ᵐ[volume]
      (fun x => f x - g x) := by
    filter_upwards [Lp.coeFn_sub (hf.toLp f) (hg.toLp g), hF, hG]
      with x hx hfx hgx
    rw [hx]
    change hf.toLp f x - hg.toLp g x = f x - g x
    rw [hfx, hgx]
  rw [← torus_mFourierCoeff_congr_ae hSub n,
    torusL2_mFourierCoeff_sub,
    torus_mFourierCoeff_congr_ae hF n,
    torus_mFourierCoeff_congr_ae hG n]

/-- A scalar factor can be taken outside the Fourier integral even when
integrability has not been assumed. -/
theorem torus_mFourierCoeff_const_mul {d : Type*} [Fintype d]
    (c : ℂ) (f : UnitAddTorus d → ℂ) (n : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => c * f x) n =
      c * UnitAddTorus.mFourierCoeff f n := by
  unfold UnitAddTorus.mFourierCoeff
  simp only [smul_eq_mul]
  calc
    (∫ x, UnitAddTorus.mFourier (-n) x * (c * f x)) =
        ∫ x, c * (UnitAddTorus.mFourier (-n) x * f x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      ring
    _ = _ := integral_const_mul c _

/-- Finite additivity for an arbitrary family of square-integrable concrete
torus functions. -/
theorem torus_mFourierCoeff_finsetSum_of_memLp {d α : Type*} [Fintype d]
    (s : Finset α) (f : α → UnitAddTorus d → ℂ)
    (hf : ∀ i ∈ s, MemLp (f i) 2 volume) (n : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => ∑ i ∈ s, f i x) n =
      ∑ i ∈ s, UnitAddTorus.mFourierCoeff (f i) n := by
  classical
  revert hf
  induction s using Finset.induction_on with
  | empty =>
      intro _hf
      simp only [Finset.sum_empty, torus_mFourierCoeff_zero]
  | @insert i s hi ih =>
      intro hf
      have hfi : MemLp (f i) 2 volume := hf i (Finset.mem_insert_self i s)
      have hfs : ∀ j ∈ s, MemLp (f j) 2 volume :=
        fun j hj => hf j (Finset.mem_insert_of_mem hj)
      simp only [Finset.sum_insert hi]
      rw [torus_mFourierCoeff_add_of_memLp (f i) (fun x => ∑ j ∈ s, f j x)
        hfi (memLp_finsetSum s hfs) n, ih hfs]

/-- The corresponding identity when the summation index is a finite type. -/
theorem torus_mFourierCoeff_fintypeSum_of_memLp {d α : Type*}
    [Fintype d] [Fintype α] (f : α → UnitAddTorus d → ℂ)
