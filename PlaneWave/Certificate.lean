theorem molecularPositionFourierTest_apply (eta : ℕ)
    (s : Finset (FourierConfig eta Lattice3))
    (c : FourierConfig eta Lattice3 → ℂ) (x : MolecularPositionTorus eta) :
    molecularPositionFourierTest eta s c x =
      ∑ p ∈ s, c p * UnitAddTorus.mFourier (molecularFourierIndexEquiv eta p) x := by
  simp [molecularPositionFourierTest]

