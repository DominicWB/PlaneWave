    rw [map_smul]
    change c ν • (UnitAddTorus.mFourierBasis (d := Fin 3)).repr (UnitAddTorus.mFourierLp 2 ν) n = _
    rw [← UnitAddTorus.coe_mFourierBasis, HilbertBasis.repr_self, lp.single_apply]
    by_cases h : ν = n
    · subst h
      simp
    · rw [if_neg h, Pi.single_eq_of_ne (Ne.symm h), smul_zero]
  have h := (unitTorus3AbsoluteFourierSeries_summable _ hc).hasSum.mapL Φ
  have h2 : HasSum (fun ν => Φ (c ν • UnitAddTorus.mFourier ν)) (c n) := by
    simp only [hterm]
    exact hasSum_ite_eq n (c n)
  rw [← hΦ]
  exact h.unique h2

lemma norm_coeffFun_le_of_forall {c : Lattice3 → ℂ} {D : ℝ} (hD : 0 ≤ D)
    (h : ∀ y : Fin 3 → ℝ, ‖coeffFun c (fun j => (y j : UnitAddCircle))‖ ≤ D) :
    ‖coeffFun c‖ ≤ D := by
  refine (ContinuousMap.norm_le _ hD).mpr fun x => ?_
  have hx : ∃ y : Fin 3 → ℝ, (fun j => (y j : UnitAddCircle)) = x := by
    refine ⟨fun j => (QuotientAddGroup.mk_surjective (x j)).choose, ?_⟩
    funext j
    exact (QuotientAddGroup.mk_surjective (x j)).choose_spec
  obtain ⟨y, rfl⟩ := hx
  exact h y

/-! ## The torus characters along coordinate lines -/

/-- The covering map `ℝ³ → T³` of the unit torus. -/
def torusProj (y : Fin 3 → ℝ) : UnitAddTorus (Fin 3) := fun j => (y j : UnitAddCircle)

/-- `ν · y`. -/
def latDot (ν : Lattice3) (y : Fin 3 → ℝ) : ℝ := ∑ k : Fin 3, ((ν k : ℤ) : ℝ) * y k

lemma mFourier_torusProj (ν : Lattice3) (y : Fin 3 → ℝ) :
    UnitAddTorus.mFourier ν (torusProj y) =
      Complex.exp (2 * Real.pi * Complex.I * (latDot ν y : ℂ)) := by
  change (∏ k : Fin 3, fourier (ν k) ((y k : ℝ) : UnitAddCircle)) = _
  simp only [fourier_coe_apply]
  rw [← Complex.exp_sum]
  congr 1
  unfold latDot
  push_cast
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  ring

lemma latDot_line (ν : Lattice3) (y : Fin 3 → ℝ) (j : Fin 3) (r : ℝ) :
    latDot ν (y + r • Pi.single j 1) = latDot ν y + r * ((ν j : ℤ) : ℝ) := by
  classical
  unfold latDot
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib]
  congr 1
  rw [Finset.sum_eq_single j]
  · simp
    ring
  · intro k _ hk
    simp [Pi.single_eq_of_ne hk]
  · intro h
    exact absurd (Finset.mem_univ j) h

/-- The phase `e^{2πi ν·(y + r e_j)}` has modulus one. -/
lemma norm_exp_phase (ν : Lattice3) (z : Fin 3 → ℝ) :
    ‖Complex.exp (2 * Real.pi * Complex.I * (latDot ν z : ℂ))‖ = 1 := by
  rw [show 2 * Real.pi * Complex.I * (latDot ν z : ℂ) =
      ((2 * Real.pi * latDot ν z : ℝ) : ℂ) * Complex.I by
    push_cast
    ring]
  exact Complex.norm_exp_ofReal_mul_I _

lemma norm_twoPiI_int (k : ℤ) :
    ‖2 * (Real.pi : ℂ) * Complex.I * (k : ℂ)‖ = 2 * Real.pi * |(k : ℝ)| := by
  rw [norm_mul, norm_mul, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
    Complex.norm_intCast, Real.norm_eq_abs, abs_of_pos Real.pi_pos, Complex.norm_ofNat]

lemma norm_coeff_mul_phase (c : ℂ) (k : ℤ) (ν : Lattice3) (z : Fin 3 → ℝ) :
    ‖c * (2 * (Real.pi : ℂ) * Complex.I * (k : ℂ)) *
        Complex.exp (2 * Real.pi * Complex.I * (latDot ν z : ℂ))‖ =
      ‖c‖ * (2 * Real.pi * |(k : ℝ)|) := by
  rw [norm_mul, norm_mul, norm_exp_phase, mul_one, norm_twoPiI_int]

/-- **Termwise differentiation along a coordinate line.** -/
theorem hasDerivAt_lineSeries (c : Lattice3 → ℂ) (y : Fin 3 → ℝ) (j : Fin 3)
    (hc : Summable fun ν => ‖c ν‖) (hcj : Summable fun ν => |((ν j : ℤ) : ℝ)| * ‖c ν‖) (s : ℝ) :
    HasDerivAt (fun r => ∑' ν, c ν * Complex.exp (2 * Real.pi * Complex.I *
        (latDot ν (y + r • Pi.single j 1) : ℂ)))
      (∑' ν, c ν * (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)) *
        Complex.exp (2 * Real.pi * Complex.I * (latDot ν (y + s • Pi.single j 1) : ℂ))) s := by
  set g : Lattice3 → ℝ → ℂ := fun ν r =>
    c ν * Complex.exp (2 * Real.pi * Complex.I * (latDot ν (y + r • Pi.single j 1) : ℂ))
  set g' : Lattice3 → ℝ → ℂ := fun ν r =>
    c ν * (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)) *
      Complex.exp (2 * Real.pi * Complex.I * (latDot ν (y + r • Pi.single j 1) : ℂ))
  have hg : ∀ ν r, HasDerivAt (g ν) (g' ν r) r := by
    intro ν r
    have hφ : HasDerivAt (fun r : ℝ => 2 * Real.pi * Complex.I *
        ((latDot ν y + r * ((ν j : ℤ) : ℝ) : ℝ) : ℂ))
        (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)) r := by
      have h1 : HasDerivAt (fun r : ℝ => latDot ν y + r * ((ν j : ℤ) : ℝ)) ((ν j : ℤ) : ℝ) r := by
        simpa using ((hasDerivAt_id r).mul_const ((ν j : ℤ) : ℝ)).const_add (latDot ν y)
      have h2 := h1.ofReal_comp.const_mul (2 * Real.pi * Complex.I)
      simpa using h2
    have h3 := (hφ.cexp).const_mul (c ν)
    have efun : g ν = fun r => c ν * Complex.exp (2 * Real.pi * Complex.I *
        ((latDot ν y + r * ((ν j : ℤ) : ℝ) : ℝ) : ℂ)) := by
      funext r'
      simp only [g, latDot_line]
    have eder : g' ν r = c ν * (Complex.exp (2 * Real.pi * Complex.I *
        ((latDot ν y + r * ((ν j : ℤ) : ℝ) : ℝ) : ℂ)) *
            (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ))) := by
      simp only [g', latDot_line]
      ring
    rw [efun, eder]
    exact h3
  have hg' : ∀ ν r, ‖g' ν r‖ ≤ 2 * Real.pi * (|((ν j : ℤ) : ℝ)| * ‖c ν‖) := by
    intro ν r
    simp only [g']
    rw [norm_mul, norm_mul, norm_exp_phase, mul_one]
    have : ‖2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)‖ = 2 * Real.pi * |((ν j : ℤ) : ℝ)| := by
      rw [norm_mul, norm_mul, Complex.norm_I, mul_one, norm_mul, Complex.norm_real,
        Complex.norm_intCast]
      simp [Real.norm_eq_abs, abs_of_pos Real.pi_pos]
    rw [this]
    exact le_of_eq (by ring)
  have hg0 : Summable fun ν => g ν 0 :=
    Summable.of_norm_bounded hc (fun ν => by
      simp only [g]
      rw [norm_mul, norm_exp_phase, mul_one])
  exact hasDerivAt_tsum (hcj.mul_left (2 * Real.pi)) hg hg' hg0 s

/-! ## The derivatives of `χ` -/

variable {eta : ℕ} (χ : C(UnitAddTorus (Fin 3), ℂ))

/-- The lift of `χ` to `ℝ³` restricted to the line through `y` in the direction `j`. -/
def chiLine (y : Fin 3 → ℝ) (j : Fin 3) (r : ℝ) : ℂ := χ (torusProj (y + r • Pi.single j 1))

/-- The physical partial derivative `∂_{x_j} χ` at `x = L y` (`∂_{x_j} = L⁻¹ ∂_{y_j}`). -/
def partialX (L : ℝ) (y : Fin 3 → ℝ) (j : Fin 3) : ℂ :=
  ((L⁻¹ : ℝ) : ℂ) * deriv (chiLine χ y j) 0

/-- The physical Laplacian `Δ_x χ` at `x = L y`. -/
def lapX (L : ℝ) (y : Fin 3 → ℝ) : ℂ :=
  (((L ^ 2)⁻¹ : ℝ) : ℂ) *
    ∑ j : Fin 3, deriv (fun s : ℝ => deriv (chiLine χ (y + s • Pi.single j 1) j) 0) 0

variable {χ}

lemma chi_series (hχ : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖) (z : Fin 3 → ℝ) :
    χ (torusProj z) = ∑' ν, UnitAddTorus.mFourierCoeff χ ν *
      Complex.exp (2 * Real.pi * Complex.I * (latDot ν z : ℂ)) := by
  have h := UnitAddTorus.hasSum_mFourier_series_apply_of_summable hχ.of_norm (torusProj z)
  simp only [smul_eq_mul, mFourier_torusProj] at h
  exact h.tsum_eq.symm

lemma summable_unweighted {g : ℝ} (hg : 0 < g)
    (hχ2 : Summable fun ν => (1 + g ^ 2 * latticeNormSq ν) * ‖UnitAddTorus.mFourierCoeff χ ν‖) :
    Summable fun ν => (1 + latticeNormSq ν) * ‖UnitAddTorus.mFourierCoeff χ ν‖ := by
  refine Summable.of_nonneg_of_le (fun ν => mul_nonneg (add_nonneg zero_le_one
    (latticeNormSq_nonneg ν)) (norm_nonneg _)) (fun ν => ?_) (hχ2.mul_left (1 + (g ^ 2)⁻¹))
  have hn := latticeNormSq_nonneg ν
  have hg2 : 0 < g ^ 2 := by positivity
  have h : 1 + latticeNormSq ν ≤ (1 + (g ^ 2)⁻¹) * (1 + g ^ 2 * latticeNormSq ν) := by
    have : (g ^ 2)⁻¹ * (g ^ 2 * latticeNormSq ν) = latticeNormSq ν := by field_simp
    nlinarith [inv_pos.mpr hg2, mul_nonneg hg2.le hn]
  calc (1 + latticeNormSq ν) * ‖UnitAddTorus.mFourierCoeff χ ν‖ ≤
        ((1 + (g ^ 2)⁻¹) * (1 + g ^ 2 * latticeNormSq ν)) * ‖UnitAddTorus.mFourierCoeff χ ν‖ :=
        mul_le_mul_of_nonneg_right h (norm_nonneg _)
    _ = _ := by ring

lemma coord_abs_le (ν : Lattice3) (j : Fin 3) : |((ν j : ℤ) : ℝ)| ≤ 1 + latticeNormSq ν := by
  have h1 := abs_le_one_add_sq ((ν j : ℤ) : ℝ)
  have h2 := lattice_coordinate_sq_le_latticeNormSq ν j
  linarith

lemma coord_sq_le (ν : Lattice3) (j : Fin 3) : ((ν j : ℤ) : ℝ) ^ 2 ≤ 1 + latticeNormSq ν := by
  have h2 := lattice_coordinate_sq_le_latticeNormSq ν j
  linarith

/-- The first derivative of `χ` along a coordinate line, termwise. -/
theorem hasDerivAt_chiLine (hχ1 : Summable fun ν => (1 + latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖) (y : Fin 3 → ℝ) (j : Fin 3) (s : ℝ) :
    HasDerivAt (chiLine χ y j)
      (∑' ν, UnitAddTorus.mFourierCoeff χ ν * (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)) *
        Complex.exp (2 * Real.pi * Complex.I * (latDot ν (y + s • Pi.single j 1) : ℂ))) s := by
  have hc : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖ :=
    Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => by
      have := latticeNormSq_nonneg ν
      nlinarith [norm_nonneg (UnitAddTorus.mFourierCoeff χ ν)]) hχ1
  have hcj : Summable fun ν => |((ν j : ℤ) : ℝ)| * ‖UnitAddTorus.mFourierCoeff χ ν‖ :=
    Summable.of_nonneg_of_le (fun ν => mul_nonneg (abs_nonneg _) (norm_nonneg _))
      (fun ν => mul_le_mul_of_nonneg_right (coord_abs_le ν j) (norm_nonneg _)) hχ1
  have e : chiLine χ y j = fun r => ∑' ν, UnitAddTorus.mFourierCoeff χ ν *
      Complex.exp (2 * Real.pi * Complex.I * (latDot ν (y + r • Pi.single j 1) : ℂ)) := by
    funext r
    exact chi_series hc _
  rw [e]
  exact hasDerivAt_lineSeries _ y j hc hcj s

variable {L : ℝ}

/-- **The physical gradient.** `∂_{x_j} χ (L y) = i G_j(y)`, where `G_j` has the Fourier
coefficients
`g ν_j χ̂(ν)` (`g = 2π/L`). -/
theorem partialX_eq (hL : 0 < L) (hχ1 : Summable fun ν => (1 + latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖) (y : Fin 3 → ℝ) (j : Fin 3) :
    partialX χ L y j = Complex.I *
      coeffFun (coeffDer (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ) j) (torusProj y) := by
  have hL0 : (L : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hL.ne'
  have hc : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖ :=
    Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => by
      have := latticeNormSq_nonneg ν
      nlinarith [norm_nonneg (UnitAddTorus.mFourierCoeff χ ν)]) hχ1
  have hder : Summable fun ν => ‖coeffDer (2 * Real.pi / L)
      (UnitAddTorus.mFourierCoeff χ) j ν‖ := by
    refine Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => ?_)
      (hχ1.mul_left (2 * Real.pi / L))
    rw [coeffDer, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_mul,
      abs_of_pos (by positivity : 0 < 2 * Real.pi / L), mul_assoc]
    exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (coord_abs_le ν j) (norm_nonneg _))
      (by positivity)
  unfold partialX
  rw [(hasDerivAt_chiLine hχ1 y j 0).deriv, coeffFun_apply hder, ← tsum_mul_left, ← tsum_mul_left]
  congr 1
  funext ν
  rw [zero_smul, add_zero, mFourier_torusProj, coeffDer]
  push_cast
  field_simp

/-- **The physical Laplacian.** `Δ_x χ (L y) = - G_Δ(y)`, where `G_Δ` has the Fourier coefficients
`g² |ν|² χ̂(ν)`. -/
theorem lapX_eq (hL : 0 < L) (hχ1 : Summable fun ν => (1 + latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖) (y : Fin 3 → ℝ) :
    lapX χ L y = -coeffFun (coeffLap (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ))
        (torusProj y) := by
  have hL0 : (L : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hL.ne'
  have hc : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖ :=
    Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => by
      have := latticeNormSq_nonneg ν
      nlinarith [norm_nonneg (UnitAddTorus.mFourierCoeff χ ν)]) hχ1
  -- the first derivative along the line through `y + s e_j`, at its base point
  set c' : Fin 3 → Lattice3 → ℂ := fun j ν =>
    UnitAddTorus.mFourierCoeff χ ν * (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)) with hc'
  have hfirst : ∀ (j : Fin 3) (s : ℝ), deriv (chiLine χ (y + s • Pi.single j 1) j) 0 =
      ∑' ν, c' j ν * Complex.exp (2 * Real.pi * Complex.I *
          (latDot ν (y + s • Pi.single j 1) : ℂ)) := by
    intro j s
    rw [(hasDerivAt_chiLine hχ1 (y + s • Pi.single j 1) j 0).deriv]
    simp only [zero_smul, add_zero, c']
  have hc'n : ∀ j, Summable fun ν => ‖c' j ν‖ := by
    intro j
    refine Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => ?_)
        (hχ1.mul_left (2 * Real.pi))
    have e : ‖c' j ν‖ = ‖UnitAddTorus.mFourierCoeff χ ν‖ * (2 * Real.pi * |((ν j : ℤ) : ℝ)|) := by
      simp only [c']
      rw [norm_mul, norm_twoPiI_int]
    rw [e]
    have := mul_le_mul_of_nonneg_left (coord_abs_le ν j)
      (mul_nonneg
          (by positivity : (0:ℝ) ≤ 2 * Real.pi) (norm_nonneg (UnitAddTorus.mFourierCoeff χ ν)))
    linarith
  have hc'j : ∀ j, Summable fun ν => |((ν j : ℤ) : ℝ)| * ‖c' j ν‖ := by
    intro j
    refine Summable.of_nonneg_of_le (fun ν => mul_nonneg (abs_nonneg _) (norm_nonneg _))
      (fun ν => ?_) (hχ1.mul_left (2 * Real.pi))
    have e : |((ν j : ℤ) : ℝ)| * ‖c' j ν‖ =
        2 * Real.pi * ‖UnitAddTorus.mFourierCoeff χ ν‖ * ((ν j : ℤ) : ℝ) ^ 2 := by
      simp only [c']
      rw [norm_mul, norm_twoPiI_int]
      have h2 : |((ν j : ℤ) : ℝ)| * |((ν j : ℤ) : ℝ)| = ((ν j : ℤ) : ℝ) ^ 2 := by
        rw [← sq, sq_abs]
      calc |((ν j : ℤ) : ℝ)| *
            (‖UnitAddTorus.mFourierCoeff χ ν‖ * (2 * Real.pi * |((ν j : ℤ) : ℝ)|))
          = 2 * Real.pi * ‖UnitAddTorus.mFourierCoeff χ ν‖ *
              (|((ν j : ℤ) : ℝ)| * |((ν j : ℤ) : ℝ)|) := by
            ring
        _ = _ := by rw [h2]
    rw [e]
    have := mul_le_mul_of_nonneg_left (coord_sq_le ν j)
      (mul_nonneg
          (by positivity : (0:ℝ) ≤ 2 * Real.pi) (norm_nonneg (UnitAddTorus.mFourierCoeff χ ν)))
    linarith
  have hsecond : ∀ j : Fin 3, deriv (fun s : ℝ => deriv (chiLine χ (y + s • Pi.single j 1) j) 0) 0 =
      ∑' ν, c' j ν * (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)) *
        Complex.exp (2 * Real.pi * Complex.I * (latDot ν y : ℂ)) := by
    intro j
    have e : (fun s : ℝ => deriv (chiLine χ (y + s • Pi.single j 1) j) 0) = fun s =>
        ∑' ν, c' j ν * Complex.exp (2 * Real.pi * Complex.I *
          (latDot ν (y + s • Pi.single j 1) : ℂ)) := funext (hfirst j)
    rw [e, (hasDerivAt_lineSeries (c' j) y j (hc'n j) (hc'j j) 0).deriv]
    simp only [zero_smul, add_zero]
  have hlap : Summable fun ν => ‖coeffLap (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ) ν‖ := by
    refine Summable.of_nonneg_of_le (fun ν => norm_nonneg _) (fun ν => ?_)
      (hχ1.mul_left ((2 * Real.pi / L) ^ 2))
    have h0 := mul_nonneg (sq_nonneg (2 * Real.pi / L)) (latticeNormSq_nonneg ν)
    rw [coeffLap, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0, mul_assoc]
    exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _))
      (sq_nonneg _)
  have hsum : ∀ j ∈ (Finset.univ : Finset (Fin 3)), Summable fun ν =>
      c' j ν * (2 * Real.pi * Complex.I * ((ν j : ℤ) : ℂ)) *
        Complex.exp (2 * Real.pi * Complex.I * (latDot ν y : ℂ)) := by
    intro j _
    refine Summable.of_norm_bounded ((hc'j j).mul_left (2 * Real.pi)) (fun ν => ?_)
    rw [norm_coeff_mul_phase]
    exact le_of_eq (by ring)
  unfold lapX
  simp only [hsecond]
  rw [← Summable.tsum_finsetSum hsum, coeffFun_apply hlap, ← tsum_mul_left, ← tsum_neg]
  congr 1
  funext ν
  simp only [c', coeffLap, mFourier_torusProj, Fin.sum_univ_three, latticeNormSq]
  push_cast
  field_simp
  ring_nf
  rw [Complex.I_sq]
  ring

/-- **`D_χ` by derivatives.** If `|∂_{x_j} χ| ≤ D₁` for every `j` and `|Δ_x χ| ≤ D₂` everywhere,
then the commutator constant of `thm:dyn` is at most `D₂ + 3 D₁`. -/
theorem commConst_le_derivs (a : Fin eta) (hL : 0 < L)
    (hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖)
    {D₁ D₂ : ℝ} (hD₁ : ∀ y j, ‖partialX χ L y j‖ ≤ D₁) (hD₂ : ∀ y, ‖lapX χ L y‖ ≤ D₂) :
    commConst (2 * Real.pi / L) a (UnitAddTorus.mFourierCoeff χ) ≤ D₂ + 3 * D₁ := by
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hχ1 := summable_unweighted hg hχ2
  have hD₁0 : 0 ≤ D₁ := (norm_nonneg _).trans (hD₁ 0 0)
  have hD₂0 : 0 ≤ D₂ := (norm_nonneg _).trans (hD₂ 0)
  have hlap := summable_coeffLap (2 * Real.pi / L) hχ2
  have hder := fun j => summable_coeffDer (2 * Real.pi / L) j hχ2
  have h := commConst_le_sup a (2 * Real.pi / L) hχ2
    (coeffFun (coeffLap (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ)))
    (fun j => coeffFun (coeffDer (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ) j))
    (mFourierCoeff_coeffFun hlap) (fun j => mFourierCoeff_coeffFun (hder j))
  refine h.trans (add_le_add ?_ ?_)
  · refine norm_coeffFun_le_of_forall hD₂0 fun y => ?_
    have e := lapX_eq hL hχ1 y
    have : ‖coeffFun (coeffLap (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ)) (torusProj y)‖ =
        ‖lapX χ L y‖ := by rw [e, norm_neg]
    exact this.le.trans (hD₂ y) |>.trans_eq' rfl
  · rw [Fin.sum_univ_three]
    have hj : ∀ j, ‖coeffFun (coeffDer (2 * Real.pi / L)
        (UnitAddTorus.mFourierCoeff χ) j)‖ ≤ D₁ := by
      intro j
      refine norm_coeffFun_le_of_forall hD₁0 fun y => ?_
      have e := partialX_eq hL hχ1 y j
      have : ‖coeffFun (coeffDer (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ) j)
          (torusProj y)‖ =
          ‖partialX χ L y j‖ := by rw [e, norm_mul, Complex.norm_I, one_mul]
      exact this.le.trans (hD₁ y j) |>.trans_eq' rfl
    linarith [hj 0, hj 1, hj 2]

end

