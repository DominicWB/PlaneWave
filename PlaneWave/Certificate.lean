/-- **Rates** (`eq:dyn-main`). With `ρ = K^{-1/2}`, the observable error of
`coulomb_observable_error` is at most `A₁ K^{-5} + A₂ t K^{-3} + A₃ K^{-5/2} τ_χ(K/2)`, with
constants `A₁, A₂, A₃` that depend on the system, on `‖ψ₀‖, ‖H ψ₀‖, ‖H² ψ₀‖`, on `χ` (through
`‖O‖`, `C_χ` and `D_χ`) and on the auxiliary constants `Blow, Cs, Bker` (which depend on `L`
only), but not on `K` or `t`; `τ_χ(K/2) = Σ_{g|ν| > K/2} |χ̂(ν)|` is the
coefficient tail of `χ`, `O(K^{-M})` for every `M` when `χ` is smooth. -/
theorem coulomb_observable_rate (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h4g : 4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (a : Fin eta) (χ : Lattice3 → ℂ)
    (hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) * ‖χ ν‖)
    (hreal : ∀ ν, χ (-ν) = conj (χ ν)) {t : ℝ} (ht : 0 ≤ t) :
    let g : ℝ := 2 * Real.pi / L
    let K : ℝ := g * n
    let b : ℝ := relB sys L Hunit
    let S0 : ℝ := ‖molecularH2StateMap eta g u₀‖
    let Ξ₀ : ℝ := 2 * ‖H u₀‖ + 2 * b * S0
    let Ξ₁ : ℝ := 2 * ‖H v₀‖ + 2 * b * ‖molecularH2StateMap eta g v₀‖
    let Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
    let CO : ℝ := ‖convOp (eta := eta) a χ‖
    let Cχ : ℝ := ∑' ν, ‖χ ν‖
    let τχ : ℝ := ∑' ν, if K / 2 < g * Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0
    let D : ℝ := commConst g a χ
    let Hw1 : ℝ := 2 * ((CO + 2 * D) * Ξ₀ + D * S0) + 2 * b * (CO * S0)
    let M1 : ℝ := sys.maxMass * (CO * S0 + 2 * (2 * Hw1 + 2 * b * (CO * S0)))
    let Tη : ℝ := 2 * (2 * (2 * Ξ₀ + 2 * b * S0)) + 2 * b * (2 * S0)
    let Hw2 : ℝ := 2 * ((CO + 2 * D) * Tη + D * (2 * S0)) + 2 * b * (CO * (2 * S0))
    let M2 : ℝ := sys.maxMass * (CO * (2 * S0) + 2 * (2 * Hw2 + 2 * b * (CO * (2 * S0))))
    let β : ℝ := 2 * sys.maxMass * Ξ₁ + Ct (sys.maxMass * (S0 + 2 * Ξ₀))
    let δ₁ : ℝ := eta * (2 * sys.maxMass * β)
    let τ₁ : ℝ := 8 * sys.maxMass * (8 * sys.maxMass * Ξ₁ + 2 * Ct (sys.maxMass * (S0 + 2 * Ξ₀)))
    let N₁ : ℝ := finiteCoulombPhysicalMassConstant sys L Hunit *
      Real.sqrt (δ₁ * (eta * ((2 * sys.maxMass + 2) * β)))
    let A₁ : ℝ := 2 * δ₁ * (Cχ * τ₁ + CO * δ₁) + CO * δ₁ ^ 2
    let A₂ : ℝ := 2 * δ₁ * (eta * Ct M1) + 2 * CO * δ₁ * N₁ + δ₁ * (eta * Ct M2)
    let A₃ : ℝ := 2 * δ₁ * S0
    ‖⟪U t (molecularH2StateMap eta g u₀),
        convOp a χ (U t (molecularH2StateMap eta g u₀))⟫_ℂ -
      ⟪finiteFourierLpIsometry eta n (UN t (extractCLM n (molecularH2StateMap eta g u₀))),
        convOp a χ (finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta g u₀))))⟫_ℂ‖ ≤
      A₁ * rho ^ 10 + A₂ * t * rho ^ 6 + A₃ * rho ^ 5 * τχ := by
  intro g K b S0 Ξ₀ Ξ₁ Ct CO Cχ τχ D Hw1 M1 Tη Hw2 M2 β δ₁ τ₁ N₁ A₁ A₂ A₃
  have hM := sys.one_le_maxMass
  have hb : 0 ≤ relB sys L Hunit := relB_nonneg sys L Hunit hC
  have hS0 : 0 ≤ S0 := norm_nonneg _
  have hΞ₀ : 0 ≤ Ξ₀ := add_nonneg (mul_nonneg zero_le_two (norm_nonneg _))
    (mul_nonneg (mul_nonneg zero_le_two hb) hS0)
  have hΞ₁ : 0 ≤ Ξ₁ := add_nonneg (mul_nonneg zero_le_two (norm_nonneg _))
    (mul_nonneg (mul_nonneg zero_le_two hb) (norm_nonneg _))
  have hCt : ∀ M, 0 ≤ M → 0 ≤ Ct M := fun M hM' =>
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker hM'
  have hM20 : 0 ≤ sys.maxMass * (S0 + 2 * Ξ₀) := mul_nonneg (by linarith) (by linarith)
  have hCO : 0 ≤ CO := norm_nonneg _
  have hD : 0 ≤ D := commConst_nonneg _ _ _
  have hHw1 : 0 ≤ Hw1 := add_nonneg (mul_nonneg zero_le_two (add_nonneg
    (mul_nonneg (by linarith) hΞ₀) (mul_nonneg hD hS0))) (mul_nonneg (mul_nonneg zero_le_two hb)
      (mul_nonneg hCO hS0))
  have hM1 : 0 ≤ M1 := mul_nonneg (by linarith) (add_nonneg (mul_nonneg hCO hS0)
    (mul_nonneg zero_le_two (add_nonneg (mul_nonneg zero_le_two hHw1)
      (mul_nonneg (mul_nonneg zero_le_two hb) (mul_nonneg hCO hS0)))))
  have hTη : 0 ≤ Tη := add_nonneg (mul_nonneg zero_le_two (mul_nonneg zero_le_two
    (add_nonneg (mul_nonneg zero_le_two hΞ₀) (mul_nonneg (mul_nonneg zero_le_two hb) hS0))))
      (mul_nonneg (mul_nonneg zero_le_two hb) (mul_nonneg zero_le_two hS0))
  have hHw2 : 0 ≤ Hw2 := add_nonneg (mul_nonneg zero_le_two (add_nonneg
    (mul_nonneg (by linarith) hTη) (mul_nonneg hD (mul_nonneg zero_le_two hS0))))
      (mul_nonneg (mul_nonneg zero_le_two hb) (mul_nonneg hCO (mul_nonneg zero_le_two hS0)))
  have hM2 : 0 ≤ M2 := mul_nonneg (by linarith) (add_nonneg (mul_nonneg hCO
    (mul_nonneg zero_le_two hS0)) (mul_nonneg zero_le_two (add_nonneg
      (mul_nonneg zero_le_two hHw2) (mul_nonneg (mul_nonneg zero_le_two hb)
        (mul_nonneg hCO (mul_nonneg zero_le_two hS0))))))
  refine le_trans (coulomb_observable_error sys L H hKernel Hunit hL hPeriodic hC U
      h0 hgraph hderiv n
    UN hN0 hNadd hNcomm hNderiv rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h4g hAmplitude
    hBkerScale hCsScale u₀ v₀ huv a χ hχ2 hreal ht) ?_
  exact rate_arith (Nat.cast_nonneg eta) hM hΞ₁ (hCt _ hM20) hRho hRhoScale hK2 hC
    (tsum_nonneg fun ν => norm_nonneg _) (tsum_nonneg fun ν => by split_ifs <;> simp) hS0 hCO
    (hCt _ hM1) (hCt _ hM2) ht rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl

end Observable

