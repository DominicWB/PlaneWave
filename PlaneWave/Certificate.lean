      ‖H u‖ + ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H u‖ := by
    rw [hT]
    exact norm_sub_le _ _
  linarith

/-- The regularity functional `Θ(u) = ‖(1 + A) ĉ‖ = ‖S u + T u‖`. -/
noncomputable def theta (u : MolecularFourierH2 eta) : ℝ :=
  ‖molecularH2StateMap eta (2 * Real.pi / L) u + coulombFourierKineticH2 sys (2 * Real.pi / L) u‖

include hKernel hL hPeriodic in
