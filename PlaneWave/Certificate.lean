/-! ## Ninety-fourth milestone: explicit regularized Hardy vector field and divergence -/

/-- The `j`-th component of the regularized Hardy vector field
`x / (|x|^2 + eps^2)`. -/
noncomputable def hardyRegularizedFieldComponent
    (eps : ℝ)
    (j : Fin 3)
    (x : CenteredCube3Ambient) : ℝ :=
  x j / hardyRegularizedDenominator eps x

/-- The full regularized Hardy vector field.  We keep the ambient space as
`Fin 3 -> ℝ`; the Euclidean squared norm is represented explicitly by the sum
of component squares below. -/
noncomputable def hardyRegularizedField
    (eps : ℝ)
    (x : CenteredCube3Ambient) : CenteredCube3Ambient :=
  fun j => hardyRegularizedFieldComponent eps j x

/-- The scalar value that should be the derivative of the `j`-th field
component in the `j`-th coordinate direction.  Separating this algebraic
expression from the differentiability proof keeps the later integration-by-
parts step clean. -/
noncomputable def hardyRegularizedCoordinateDivergence
    (eps : ℝ)
    (j : Fin 3)
    (x : CenteredCube3Ambient) : ℝ :=
  (hardyRegularizedDenominator eps x - 2 * (x j) ^ 2) /
    (hardyRegularizedDenominator eps x) ^ 2

/-- The explicit vector field has exactly the squared Euclidean norm introduced
in milestone 92. -/
lemma hardyRegularizedField_sum_sq
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    (∑ j : Fin 3, (hardyRegularizedField eps x j) ^ 2) =
      hardyRegularizedFieldNormSq eps x := by
  classical
  let d : ℝ := hardyRegularizedDenominator eps x
  unfold hardyRegularizedField hardyRegularizedFieldComponent
  unfold hardyRegularizedFieldNormSq
  change
    (∑ j : Fin 3, (x j / d) ^ 2) =
      centeredCube3AmbientRadiusSq x / d ^ 2
  simp only [div_pow]
  rw [← Finset.sum_div]
  unfold centeredCube3AmbientRadiusSq
  rfl

/-- Consequently the sum of squared regularized field components is bounded by
its regularized Hardy weight.  This is the exact pointwise input needed for the
Cauchy--Schwarz step after integration by parts. -/
lemma hardyRegularizedField_sum_sq_le_weight
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    (∑ j : Fin 3, (hardyRegularizedField eps x j) ^ 2) ≤
      hardyRegularizedWeight eps x := by
  rw [hardyRegularizedField_sum_sq heps x]
  exact hardyRegularizedFieldNormSq_le_weight heps x

/-- Summing the three coordinate-divergence expressions gives the regularized
three-dimensional divergence from milestone 92:

`sum_j partial_j (x_j / (|x|^2 + eps^2))
   = (|x|^2 + 3 eps^2) / (|x|^2 + eps^2)^2`.

Only the derivative identification remains; the algebraic sum is now proved. -/
lemma hardyRegularizedCoordinateDivergence_sum
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    (∑ j : Fin 3, hardyRegularizedCoordinateDivergence eps j x) =
      hardyRegularizedDivergence eps x := by
  classical
  let d : ℝ := hardyRegularizedDenominator eps x
  unfold hardyRegularizedCoordinateDivergence
  unfold hardyRegularizedDivergence
  change
    (∑ j : Fin 3, (d - 2 * (x j) ^ 2) / d ^ 2) =
      (centeredCube3AmbientRadiusSq x + 3 * eps ^ 2) / d ^ 2
  rw [← Finset.sum_div]
  apply congrArg (fun z : ℝ => z / d ^ 2)
  dsimp [d, hardyRegularizedDenominator]
  unfold centeredCube3AmbientRadiusSq
  simp only [Fin.sum_univ_succ]
  ring

/-- Each coordinate-divergence term has the expected equivalent quotient form.
This form is often easier to match against the quotient rule in the next
milestone. -/
lemma hardyRegularizedCoordinateDivergence_eq
    {eps : ℝ}
    (heps : 0 < eps)
    (j : Fin 3)
    (x : CenteredCube3Ambient) :
    hardyRegularizedCoordinateDivergence eps j x =
      1 / hardyRegularizedDenominator eps x -
        2 * (x j) ^ 2 / (hardyRegularizedDenominator eps x) ^ 2 := by
  let d : ℝ := hardyRegularizedDenominator eps x
  have hd : d ≠ 0 := by
    exact ne_of_gt (by
      dsimp [d]
      exact hardyRegularizedDenominator_pos heps x)
  unfold hardyRegularizedCoordinateDivergence
  change
    (d - 2 * (x j) ^ 2) / d ^ 2 =
      1 / d - 2 * (x j) ^ 2 / d ^ 2
  field_simp [hd]

/-!
## Ninety-fourth milestone

The regularized Hardy vector field is now an explicit `Fin 3 -> ℝ` function.
Lean proves both algebraic identities needed by the analytic argument:

* the sum of its component squares is
  `|x|^2 / (|x|^2 + eps^2)^2`, hence is bounded by the regularized Hardy
  weight;
* the sum of the three candidate coordinate derivatives is exactly
  `(|x|^2 + 3 eps^2) / (|x|^2 + eps^2)^2`.

The next step can therefore concentrate solely on proving that each candidate
coordinate derivative is the actual line derivative of the corresponding field
component.  Once this is available, the remaining issue in applying Mathlib's
classical integration-by-parts theorem is the piecewise-linear cutoff's two
measure-zero nondifferentiability spheres; that will be handled separately
rather than hidden in the vector-field algebra.
-/

end

end PlaneWaveCertificate

