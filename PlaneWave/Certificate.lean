section DevSP1

/-!
# Spin transfer and the Galerkin kinetic-energy theorems with internal spin

The dynamics of the manuscript acts on `L²(T^{η_tot}; 𝒱)`; the Hamiltonian, the projector, the
observables `χ(x_a)` and the kinetic energies `A_r` do not act on the spin, so every spin
component evolves on its own and the spin-inclusive error is the sum of the component errors.
The bounds of the dynamics theorems are explicit functions `B(x)` of the data norms
`x = (‖ψ₀‖, ‖H ψ₀‖, ‖H ψ₀‖, ‖H² ψ₀‖)`. This section proves, once for all such bounds, that
`Σ_σ B(x_σ) ≤ B(X)` with `X_j = (Σ_σ x_{σ j}²)^{1/2}` (the `ℓ²` combination, which for the norms
of the components of a spin-inclusive state is the norm of that state), whenever `B` is built
from the data by

* `ℓ²`-subadditive pieces (`L2Sub`): the coordinates, zero, sums, nonnegative multiples and
  quotients by nonnegative constants, the tail constant `C_tail(M) = M C_tail(1)` of such a
  piece, and square roots of nonnegative combinations of squares (`sqrt_add_sq`, `sqrt_quad3`);
  `flow2`, linear with nonnegative coefficients, is unfolded and handled by these rules;
* and then (`L2Quad`) products of two such pieces, squares, sums and nonnegative multiples.

The tactics `l2sub` and `l2quad` apply these closure rules recursively, with `positivity` for
the side conditions (and `assumption` for `0 ≤ C_tail(1)`, which must be in the context). This
generalises `obsRateBound_sum_le` of DevU15 (one product of two linear forms) to the bounds of
the grid dynamics and of the kinetic-energy theorems.

* `spinProp_spec`: `U ⊗ 1` (`spinProp`) is the propagator on `CoulombSpinL2 eta D`,
  characterised as in `thm_dyn_spin`; `l2comb_spinData`: the `ℓ²` combination of the component
  norms is the spin-inclusive norm.
* `kinetic_galerkin_position_spin`, `kinetic_capped_position_spin`,
  `kinetic_capped_min_position_spin`, `thm_mult_gal_spin`, `thm_mult_cap_spin`,
  `stopping_galerkin_spin`, `stopping_window_spin` (`thm:mult-gal`, `thm:mult-cap`,
  `cor:stopping`, `cor:stopping2`, Galerkin route): the multiplier `μ ⊗ 1` (`spinPosExpect`) in
  `(U(t) ⊗ 1) Ψ₀` and in the Galerkin state `spinGalerkin`, with the spinless constants at the
  spin-inclusive norms.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveSpin

open PlaneWaveCertificate PlaneWaveDynamics PlaneWaveKinetic

/-! ## The `ℓ²` combination and the two classes -/

/-- The `ℓ²` combination of a finite family of data vectors: `X_j = (Σ_σ x_{σ j}²)^{1/2}`. -/
noncomputable def l2comb {n : ℕ} {S : Type} [Fintype S] (x : S → Fin n → ℝ) : Fin n → ℝ :=
  fun j => Real.sqrt (∑ σ, x σ j ^ 2)

/-- A data function is **`ℓ²`-subadditive** if for every finite family of nonnegative data the
`ℓ²` norm of its values is at most its value at the `ℓ²` combination of the data. -/
def L2Sub {n : ℕ} (f : (Fin n → ℝ) → ℝ) : Prop :=
  ∀ (S : Type) [Fintype S] (x : S → Fin n → ℝ), (∀ σ j, 0 ≤ x σ j) →
    Real.sqrt (∑ σ, f (x σ) ^ 2) ≤ f (l2comb x)

/-- A data function is **superadditive under `ℓ²` combination** if for every finite family of
nonnegative data the sum of its values is at most its value at the `ℓ²` combination. -/
def L2Quad {n : ℕ} (B : (Fin n → ℝ) → ℝ) : Prop :=
  ∀ (S : Type) [Fintype S] (x : S → Fin n → ℝ), (∀ σ j, 0 ≤ x σ j) →
    ∑ σ, B (x σ) ≤ B (l2comb x)

/-- Minkowski's inequality for finite sums. -/
lemma sqrt_sum_sq_add_le {S : Type} [Fintype S] (a b : S → ℝ) :
    Real.sqrt (∑ σ, (a σ + b σ) ^ 2) ≤ Real.sqrt (∑ σ, a σ ^ 2) + Real.sqrt (∑ σ, b σ ^ 2) := by
  have h := norm_add_le (WithLp.toLp 2 a : EuclideanSpace ℝ S) (WithLp.toLp 2 b)
  simp only [EuclideanSpace.norm_eq, Real.norm_eq_abs, sq_abs] at h
  simpa using h

namespace L2Sub

variable {n : ℕ}

lemma nonneg_at {f : (Fin n → ℝ) → ℝ} (hf : L2Sub f) {S : Type} [Fintype S]
    (x : S → Fin n → ℝ) (hx : ∀ σ j, 0 ≤ x σ j) : 0 ≤ f (l2comb x) :=
  (Real.sqrt_nonneg _).trans (hf S x hx)

lemma sum_sq_le {f : (Fin n → ℝ) → ℝ} (hf : L2Sub f) {S : Type} [Fintype S]
    (x : S → Fin n → ℝ) (hx : ∀ σ j, 0 ≤ x σ j) : ∑ σ, f (x σ) ^ 2 ≤ f (l2comb x) ^ 2 :=
  (Real.sqrt_le_left (hf.nonneg_at x hx)).1 (hf S x hx)

lemma congr {f g : (Fin n → ℝ) → ℝ} (h : ∀ x, f x = g x) (hf : L2Sub f) : L2Sub g := by
  have e : f = g := funext h
  exact e ▸ hf

lemma coord (j : Fin n) : L2Sub (fun x : Fin n → ℝ => x j) := fun _ _ _ _ => le_rfl

lemma zero : L2Sub (fun _ : Fin n → ℝ => (0 : ℝ)) := fun _ _ _ _ => by simp

lemma add {f g : (Fin n → ℝ) → ℝ} (hf : L2Sub f) (hg : L2Sub g) :
    L2Sub (fun x => f x + g x) := fun S _ x hx =>
  (sqrt_sum_sq_add_le (fun σ => f (x σ)) (fun σ => g (x σ))).trans
    (add_le_add (hf S x hx) (hg S x hx))

lemma smul {c : ℝ} {f : (Fin n → ℝ) → ℝ} (hf : L2Sub f) (hc : 0 ≤ c) :
    L2Sub (fun x => c * f x) := fun S _ x hx => by
  have e : ∑ σ, (c * f (x σ)) ^ 2 = c ^ 2 * ∑ σ, f (x σ) ^ 2 := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun σ _ => by ring
  rw [e, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hc]
  exact mul_le_mul_of_nonneg_left (hf S x hx) hc

lemma mul_const {c : ℝ} {f : (Fin n → ℝ) → ℝ} (hf : L2Sub f) (hc : 0 ≤ c) :
    L2Sub (fun x => f x * c) :=
  congr (fun x => mul_comm c (f x)) (smul hf hc)

lemma div_const {c : ℝ} {f : (Fin n → ℝ) → ℝ} (hf : L2Sub f) (hc : 0 ≤ c) :
    L2Sub (fun x => f x / c) :=
  congr (fun x => (div_eq_mul_inv (f x) c).symm) (mul_const hf (inv_nonneg.mpr hc))

/-- Square roots of nonnegative combinations of squares. -/
lemma sqrt_add_sq {f g : (Fin n → ℝ) → ℝ} (hf : L2Sub f) (hg : L2Sub g) {a b : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) :
    L2Sub (fun x => Real.sqrt (a * f x ^ 2 + b * g x ^ 2)) := fun S _ x hx => by
  have hpos : ∀ y, 0 ≤ a * f y ^ 2 + b * g y ^ 2 := fun y =>
    add_nonneg (mul_nonneg ha (sq_nonneg _)) (mul_nonneg hb (sq_nonneg _))
  have e : ∑ σ, Real.sqrt (a * f (x σ) ^ 2 + b * g (x σ) ^ 2) ^ 2 =
      a * ∑ σ, f (x σ) ^ 2 + b * ∑ σ, g (x σ) ^ 2 := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun σ _ => Real.sq_sqrt (hpos _)
  rw [e]
  exact Real.sqrt_le_sqrt (add_le_add (mul_le_mul_of_nonneg_left (hf.sum_sq_le x hx) ha)
    (mul_le_mul_of_nonneg_left (hg.sum_sq_le x hx) hb))

/-- `√(c₁ f² + c₂ g²/d₂ + c₃ h²/d₃)`, the shape of the quadratic budget `Q` of `lem:grid-data2`. -/
lemma sqrt_quad3 {f g h : (Fin n → ℝ) → ℝ} (hf : L2Sub f) (hg : L2Sub g) (hh : L2Sub h)
    {c₁ c₂ d₂ c₃ d₃ : ℝ} (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) (hd₂ : 0 ≤ d₂) (hc₃ : 0 ≤ c₃)
    (hd₃ : 0 ≤ d₃) :
    L2Sub (fun x => Real.sqrt (c₁ * f x ^ 2 + c₂ * g x ^ 2 / d₂ + c₃ * h x ^ 2 / d₃)) := by
  have hfg : L2Sub (fun x => Real.sqrt (c₁ * f x ^ 2 + (c₂ / d₂) * g x ^ 2)) :=
    sqrt_add_sq hf hg hc₁ (div_nonneg hc₂ hd₂)
  refine congr (fun x => ?_) (sqrt_add_sq hfg hh zero_le_one (div_nonneg hc₃ hd₃))
  rw [Real.sq_sqrt (add_nonneg (mul_nonneg hc₁ (sq_nonneg _))
    (mul_nonneg (div_nonneg hc₂ hd₂) (sq_nonneg _)))]
  congr 1
  ring

end L2Sub

namespace L2Quad

variable {n : ℕ}

lemma congr {f g : (Fin n → ℝ) → ℝ} (h : ∀ x, f x = g x) (hf : L2Quad f) : L2Quad g := by
  have e : f = g := funext h
  exact e ▸ hf

lemma zero : L2Quad (fun _ : Fin n → ℝ => (0 : ℝ)) := fun _ _ _ _ => by simp

/-- **Products of two `ℓ²`-subadditive functions** (Cauchy–Schwarz). -/
lemma mul {f g : (Fin n → ℝ) → ℝ} (hf : L2Sub f) (hg : L2Sub g) :
    L2Quad (fun x => f x * g x) := fun S _ x hx =>
  (Real.sum_mul_le_sqrt_mul_sqrt Finset.univ (fun σ => f (x σ)) (fun σ => g (x σ))).trans
    (mul_le_mul (hf S x hx) (hg S x hx) (Real.sqrt_nonneg _) (hf.nonneg_at x hx))

lemma sq {f : (Fin n → ℝ) → ℝ} (hf : L2Sub f) : L2Quad (fun x => f x ^ 2) :=
  congr (fun x => (pow_two (f x)).symm) (mul hf hf)

lemma add {f g : (Fin n → ℝ) → ℝ} (hf : L2Quad f) (hg : L2Quad g) :
    L2Quad (fun x => f x + g x) := fun S _ x hx => by
  rw [Finset.sum_add_distrib]
  exact add_le_add (hf S x hx) (hg S x hx)

lemma smul {c : ℝ} {f : (Fin n → ℝ) → ℝ} (hf : L2Quad f) (hc : 0 ≤ c) :
    L2Quad (fun x => c * f x) := fun S _ x hx => by
  rw [← Finset.mul_sum]
  exact mul_le_mul_of_nonneg_left (hf S x hx) hc

lemma mul_const {c : ℝ} {f : (Fin n → ℝ) → ℝ} (hf : L2Quad f) (hc : 0 ≤ c) :
    L2Quad (fun x => f x * c) :=
  congr (fun x => mul_comm c (f x)) (smul hf hc)

lemma div_const {c : ℝ} {f : (Fin n → ℝ) → ℝ} (hf : L2Quad f) (hc : 0 ≤ c) :
    L2Quad (fun x => f x / c) :=
  congr (fun x => (div_eq_mul_inv (f x) c).symm) (mul_const hf (inv_nonneg.mpr hc))

/-- **The transfer.** If the error of every member of a finite family is at most `B` at the data
of that member, the sum of the errors is at most `B` at the `ℓ²` combination of the data. -/
lemma norm_sum_le_l2comb {E : Type*} [SeminormedAddCommGroup E] {B : (Fin n → ℝ) → ℝ}
    (hB : L2Quad B) {S : Type} [Fintype S] (z : S → E) (x : S → Fin n → ℝ)
    (hx : ∀ σ j, 0 ≤ x σ j) (hz : ∀ σ, ‖z σ‖ ≤ B (x σ)) : ‖∑ σ, z σ‖ ≤ B (l2comb x) :=
  (_root_.norm_sum_le _ _).trans ((Finset.sum_le_sum fun σ _ => hz σ).trans (hB S x hx))

end L2Quad

/-! ## The tail constant -/

section Tail

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-- The tail constant of an `ℓ²`-subadditive argument is `ℓ²`-subadditive (it is linear,
`C_tail(M) = M C_tail(1)`, with `C_tail(1) ≥ 0`). -/
lemma L2Sub.tail {n : ℕ} (sys : CoulombSystem eta ν) {L Hunit Blow Cs Bker : ℝ}
    (hCt : 0 ≤ finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1)
    {f : (Fin n → ℝ) → ℝ} (hf : L2Sub f) :
    L2Sub (fun x => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker (f x)) :=
  L2Sub.congr (fun x => (tailConstant_linear sys L Hunit Blow Cs Bker (f x)).symm)
    (L2Sub.mul_const hf hCt)

end Tail

/-! ## The tactics -/

/-- Prove `L2Sub (fun x => e x)` by the closure rules (each rule is tried by reducible
unification, so that a rule whose head symbol does not match fails at once). -/
scoped syntax "l2sub" : tactic
macro_rules
  | `(tactic| l2sub) => `(tactic| first
      | with_reducible assumption
      | with_reducible exact L2Sub.coord _
      | with_reducible exact L2Sub.zero
      | ((with_reducible refine L2Sub.add ?_ ?_) <;> l2sub)
      | ((with_reducible refine L2Sub.smul ?_ ?_) <;> first | positivity | l2sub)
      | ((with_reducible refine L2Sub.mul_const ?_ ?_) <;> first | positivity | l2sub)
      | ((with_reducible refine L2Sub.div_const ?_ ?_) <;> first | positivity | l2sub)
      | ((with_reducible refine L2Sub.tail _ ?_ ?_) <;> first | assumption | l2sub)
      | ((with_reducible refine L2Sub.sqrt_quad3 ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_) <;>
          first | positivity | l2sub))

/-- Prove `L2Quad (fun x => e x)` by the closure rules. -/
scoped syntax "l2quad" : tactic
macro_rules
  | `(tactic| l2quad) => `(tactic| first
      | with_reducible assumption
      | with_reducible exact L2Quad.zero
      | ((with_reducible refine L2Quad.add ?_ ?_) <;> l2quad)
      | ((with_reducible refine L2Quad.smul ?_ ?_) <;> first | positivity | l2quad)
      | ((with_reducible refine L2Quad.mul_const ?_ ?_) <;> first | positivity | l2quad)
      | ((with_reducible refine L2Quad.div_const ?_ ?_) <;> first | positivity | l2quad)
      | ((with_reducible refine L2Quad.sq ?_) <;> l2sub)
      | ((with_reducible refine L2Quad.mul ?_ ?_) <;> l2sub))

/-! ## The spin-inclusive propagator and data -/

section SpinSpace

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-- **The spin-inclusive propagator.** If `U` is the propagator of the Coulomb Hamiltonian on
`L²((T³)^η)` (unitary group, strongly continuous, preserving the graph, solving the
Schrödinger equation on it, and the only evolution that does), then `U ⊗ 1` (`spinProp U`) has
the same properties on `CoulombSpinL2 eta D` for the spin-independent Hamiltonian, and acts on
every spin component by `U(t)` (the argument of `thm_dyn_spin`). -/
theorem spinProp_spec (sys : CoulombSystem eta ν) (L : ℝ) (D : ℕ)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (h0 : ∀ ψ, U 0 ψ = ψ)
    (hadd : ∀ s t ψ, U (s + t) ψ = U s (U t ψ)) (hcont : ∀ ψ, Continuous fun t => U t ψ)
    (hgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (huniq : ∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
      (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) :
    (∀ Ψ, spinProp (D := D) U 0 Ψ = Ψ) ∧
      (∀ s t Ψ, spinProp (D := D) U (s + t) Ψ = spinProp U s (spinProp U t Ψ)) ∧
      (∀ Ψ, Continuous fun t => spinProp (D := D) U t Ψ) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasCoulombSpinHamiltonian sys L (spinProp (D := D) U t Ψ) (spinProp U t Φ)) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasDerivAt (fun s => spinProp (D := D) U s Ψ) (-(Complex.I • spinProp U t Φ)) t) ∧
      (∀ φ ζ : ℝ → CoulombSpinL2 eta D, (∀ t, HasCoulombSpinHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = spinProp U t (φ 0)) ∧
      (∀ t, ∃ V : MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
        ∀ Ψ σ, spinProp (D := D) U t Ψ σ = V (Ψ σ)) := by
  refine ⟨fun Ψ => ?_, fun s t Ψ => ?_, fun Ψ => ?_, fun t Ψ Φ hH => ?_,
    fun t Ψ Φ hH => ?_, fun φ ζ hH hφ t => ?_, fun t => ⟨U t, fun Ψ σ => spinProp_apply U t Ψ σ⟩⟩
  · refine PiLp.ext fun σ => ?_
    rw [spinProp_apply]
    exact h0 _
  · refine PiLp.ext fun σ => ?_
    rw [spinProp_apply, spinProp_apply, spinProp_apply]
    exact hadd s t _
  · exact (PiLp.continuous_toLp 2 (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).comp
      (continuous_pi fun σ => hcont (Ψ σ))
  · intro σ
    rw [spinProp_apply, spinProp_apply]
    exact hgraph t _ _ (hH σ)
  · have hd : HasDerivAt (fun s => (fun σ => U s (Ψ σ) : (Fin eta → Fin D) →
        MolecularPositionL2 eta)) (fun σ => -(Complex.I • U t (Φ σ))) t :=
      hasDerivAt_pi.2 fun σ => hderiv t (Ψ σ) (Φ σ) (hH σ)
    have hd2 := (PiLp.continuousLinearEquiv 2 ℝ
      (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).symm.hasFDerivAt.comp_hasDerivAt t hd
    have e1 : (fun s => spinProp (D := D) U s Ψ) = (PiLp.continuousLinearEquiv 2 ℝ
        (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).symm ∘ fun s σ => U s (Ψ σ) :=
      rfl
    have e2 : -(Complex.I • spinProp U t Φ) = (PiLp.continuousLinearEquiv 2 ℝ
        (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).symm
          (fun σ => -(Complex.I • U t (Φ σ))) :=
      rfl
    rw [e1, e2]
    exact hd2
  · refine PiLp.ext fun σ => ?_
    rw [spinProp_apply]
    have hd : ∀ s, HasDerivAt (fun r => φ r σ) (-(Complex.I • ζ s σ)) s := fun s =>
      (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)
        σ).hasFDerivAt.comp_hasDerivAt s (hφ s)
    exact huniq (fun r => φ r σ) (fun r => ζ r σ) (fun r => hH r σ) hd t

/-- The data norms of the spin components: `(‖Ψ₀ σ‖, ‖H₀ σ‖, ‖H₀ σ‖, ‖H₁ σ‖)`. -/
noncomputable def spinData {D : ℕ} (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) :
    (Fin eta → Fin D) → Fin 4 → ℝ :=
  fun σ => ![‖Ψ₀ σ‖, ‖H₀ σ‖, ‖H₀ σ‖, ‖H₁ σ‖]

lemma spinData_nonneg {D : ℕ} (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (σ : Fin eta → Fin D)
    (j : Fin 4) : 0 ≤ spinData Ψ₀ H₀ H₁ σ j := by
  fin_cases j <;> simp [spinData]

/-- The `ℓ²` combination of the component norms is the spin-inclusive norm. -/
lemma l2comb_spinData {D : ℕ} (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) :
    l2comb (spinData Ψ₀ H₀ H₁) = ![‖Ψ₀‖, ‖H₀‖, ‖H₀‖, ‖H₁‖] := by
  funext j
  fin_cases j <;> simp [l2comb, spinData, PiLp.norm_eq_of_L2]

/-- The expectation of a kinetic multiplier in a spin-inclusive state:
`⟨Ψ, (μ ⊗ 1) Ψ⟩ = Σ_σ ⟨Ψ_σ, μ Ψ_σ⟩`. -/
noncomputable def spinPosExpect {sys : CoulombSystem eta ν} {g : ℝ} {D : ℕ} (μ : KinMult sys g)
    (Ψ : CoulombSpinL2 eta D) : ℝ :=
  ∑ σ, μ.posExpect (Ψ σ)

/-- The expectation of `O ⊗ 1` is the sum of the component expectations. -/
lemma inner_spinLift {D : ℕ} (O : MolecularPositionL2 eta →L[ℂ] MolecularPositionL2 eta)
    (Ψ : CoulombSpinL2 eta D) : ⟪Ψ, spinLift O Ψ⟫_ℂ = ∑ σ, ⟪Ψ σ, O (Ψ σ)⟫_ℂ := by
  rw [PiLp.inner_apply]
  rfl

end SpinSpace

/-! ## The kinetic-energy bounds as `ℓ²`-superadditive functions of the data -/

section KinBounds

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-- The bound of `thm:mult-gal` (`kinConsts`) is superadditive under `ℓ²` combination. -/
lemma l2quad_kinBound (sys : CoulombSystem eta ν) {L Hunit Blow Cs Bker : ℝ}
    (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) {c₁ c₂ : ℝ} (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    L2Quad (fun x : Fin 4 → ℝ =>
      (kinConsts sys L Hunit Blow Cs Bker (x 0) (x 1) (x 3)).1 * c₁ +
        (kinConsts sys L Hunit Blow Cs Bker (x 0) (x 1) (x 3)).2 * c₂) := by
  have hb : 0 ≤ relB sys L Hunit := relB_nonneg sys L Hunit hC
  have hm : 0 ≤ sys.maxMass := by linarith [sys.one_le_maxMass]
  have hCt : 0 ≤ finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1 :=
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker zero_le_one
  simp only [kinConsts]
  l2quad

/-- The bound of the capped Galerkin rate (`capRateConsts`) is superadditive under `ℓ²`
combination. -/
lemma l2quad_capRateBound (sys : CoulombSystem eta ν) {L Hunit Blow Cs Bker lam0 : ℝ}
    (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hl : 0 ≤ lam0) {c₁ c₂ : ℝ} (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    L2Quad (fun x : Fin 4 → ℝ =>
      (capRateConsts sys L Hunit Blow Cs Bker lam0 (x 0) (x 1) (x 2) (x 3)).1 * c₁ +
        (capRateConsts sys L Hunit Blow Cs Bker lam0 (x 0) (x 1) (x 2) (x 3)).2 * c₂) := by
  have hb : 0 ≤ relB sys L Hunit := relB_nonneg sys L Hunit hC
  have hm : 0 ≤ sys.maxMass := by linarith [sys.one_le_maxMass]
  have hCt : 0 ≤ finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1 :=
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker zero_le_one
  simp only [capRateConsts, capConsts, kinTrivConst]
  l2quad

end KinBounds

/-! ## `thm:mult-gal`, `thm:mult-cap` and the stopping power with internal spin -/

section KinSpin

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-- The spin-inclusive Galerkin state `Ψ_N(t) = e^{-iH_N t} P Ψ₀`, componentwise. -/
noncomputable def spinGalerkin {D n : ℕ}
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (Ψ₀ : CoulombSpinL2 eta D) (t : ℝ) : CoulombSpinL2 eta D :=
  WithLp.toLp 2 fun σ => physMap eta (finiteFourierLpIsometry eta n
    (UN t (extractCLM n ((physMap eta).symm (Ψ₀ σ)))))

lemma spinGalerkin_apply {D n : ℕ}
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (Ψ₀ : CoulombSpinL2 eta D) (t : ℝ) (σ : Fin eta → Fin D) :
    spinGalerkin UN Ψ₀ t σ = physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n ((physMap eta).symm (Ψ₀ σ))))) :=
  rfl

lemma spinPosExpect_sub {sys : CoulombSystem eta ν} {g : ℝ} {D : ℕ} (μ : KinMult sys g)
    (Ψ Φ : CoulombSpinL2 eta D) :
    spinPosExpect μ Ψ - spinPosExpect μ Φ = ∑ σ, (μ.posExpect (Ψ σ) - μ.posExpect (Φ σ)) := by
  simp only [spinPosExpect, ← Finset.sum_sub_distrib]

/-- **`thm:mult-gal` with internal spin**, position space. In the setting of
`kinetic_galerkin_position`, for a spin-inclusive `Ψ₀ ∈ D(H²)` (`H Ψ₀ = H₀`, `H H₀ = H₁`) and
every kinetic multiplier `μ`, the expectations of `μ ⊗ 1` in `Ψ(t) = (U(t) ⊗ 1) Ψ₀` and in the
Galerkin state `Ψ_N(t)` differ by at most `A₁ K^{-3} + A₂ t K^{-3/2}`, with
`(A₁, A₂) = kinConsts` at the spin-inclusive norms. -/
theorem kinetic_galerkin_position_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (hn : 2 ≤ n) (hK1 : 1 ≤ (2 * Real.pi / L) * n) {D : ℕ}
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁)
    (μ : KinMult sys (2 * Real.pi / L)) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let A := kinConsts sys L molecularCanonicalUnitHardyConstant
      (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
      (molecularCanonicalKernelConstant L) ‖Ψ₀‖ ‖H₀‖ ‖H₁‖
    |spinPosExpect μ (spinProp U t Ψ₀) - spinPosExpect μ (spinGalerkin UN Ψ₀ t)| ≤
      A.1 * (1 / K) ^ 3 + A.2 * t * Real.sqrt (1 / K) ^ 3 := by
  intro K A
  obtain ⟨hBlow, hCs, hBker, -⟩ := molecularCanonicalTailConstants_spec L hL
  have hC := finiteCoulombPhysicalMassConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  have hB := l2quad_kinBound sys hC hBlow hCs hBker (c₁ := (1 / K) ^ 3)
    (c₂ := t * Real.sqrt (1 / K) ^ 3) (by positivity) (by positivity)
  have h := hB.norm_sum_le_l2comb
    (fun σ => (μ.posExpect (U t (Ψ₀ σ)) - μ.posExpect (spinGalerkin UN Ψ₀ t σ)))
    (spinData Ψ₀ H₀ H₁) (spinData_nonneg Ψ₀ H₀ H₁) (fun σ => by
      have hσ := kinetic_galerkin_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
        hNderiv hn hK1 (Ψ₀ σ) (H₀ σ) (H₁ σ) (hΨ₀ σ) (hH₀ σ) μ ht
      rw [Real.norm_eq_abs]
      refine hσ.trans_eq ?_
      simp only [spinData, Matrix.cons_val]
      ring)
  rw [l2comb_spinData] at h
  rw [spinPosExpect_sub, ← Real.norm_eq_abs]
  simp only [spinProp_apply]
  refine h.trans_eq ?_
  simp only [Matrix.cons_val, A]
  ring

/-- **`thm:mult-cap` (Galerkin) with internal spin, the sublinear branch**, position space:
`C₁ K^{-3} + C₂ t^{2/3} K^{-2}` with `(C₁, C₂) = capRateConsts` at the spin-inclusive norms. -/
theorem kinetic_capped_position_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x)
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t) {D : ℕ}
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁)
    (r : Fin eta) {lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlK : lam0 ≤ (2 * Real.pi / L) * n) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let C := capRateConsts sys L molecularCanonicalUnitHardyConstant
      (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
      (molecularCanonicalKernelConstant L) lam0 ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖
    |spinPosExpect (regKin sys (2 * Real.pi / L) r) (spinProp U t Ψ₀) -
        spinPosExpect (regKin sys (2 * Real.pi / L) r) (spinGalerkin UN Ψ₀ t)| ≤
      C.1 * (1 / K) ^ 3 + C.2 * t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2 := by
  intro K C
  obtain ⟨hBlow, hCs, hBker, -⟩ := molecularCanonicalTailConstants_spec L hL
  have hC := finiteCoulombPhysicalMassConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  have hB := l2quad_capRateBound sys hC hBlow hCs hBker (lam0 := lam0) (by linarith)
    (c₁ := (1 / K) ^ 3) (c₂ := t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2) (by positivity) (by positivity)
  have h := hB.norm_sum_le_l2comb
    (fun σ => ((regKin sys (2 * Real.pi / L) r).posExpect (U t (Ψ₀ σ)) -
      (regKin sys (2 * Real.pi / L) r).posExpect (spinGalerkin UN Ψ₀ t σ)))
    (spinData Ψ₀ H₀ H₁) (spinData_nonneg Ψ₀ H₀ H₁) (fun σ => by
      have hσ := kinetic_capped_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNcomm hNderiv
        (Ψ₀ σ) (H₀ σ) (H₁ σ) (hΨ₀ σ) (hH₀ σ) r hl h2g hlK ht
      rw [Real.norm_eq_abs]
      refine hσ.trans_eq ?_
      simp only [spinData, Matrix.cons_val]
      ring)
  rw [l2comb_spinData] at h
  rw [spinPosExpect_sub, ← Real.norm_eq_abs]
  simp only [spinProp_apply]
  refine h.trans_eq ?_
  simp only [Matrix.cons_val, C]
  ring

/-- **`thm:mult-cap` (Galerkin) with internal spin**, position space, minimum form:
`D₁ K^{-3} + D₂ min(t K^{-3/2}, t^{2/3} K^{-2})` with `(D₁, D₂) = multCapConsts` at the
spin-inclusive norms. The two branches are transferred separately and combined at the
spin-inclusive norms (the maxima of the constants are not `ℓ²`-superadditive). -/
theorem kinetic_capped_min_position_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t) {D : ℕ}
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁)
    (r : Fin eta) {lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlK : lam0 ≤ (2 * Real.pi / L) * n) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let Dc := multCapConsts sys L lam0 ‖Ψ₀‖ ‖H₀‖ ‖H₁‖
    |spinPosExpect (regKin sys (2 * Real.pi / L) r) (spinProp U t Ψ₀) -
        spinPosExpect (regKin sys (2 * Real.pi / L) r) (spinGalerkin UN Ψ₀ t)| ≤
      Dc.1 * (1 / K) ^ 3 +
        Dc.2 * min (t * Real.sqrt (1 / K) ^ 3) (t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2) := by
  intro K Dc
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hK1 : 1 ≤ K := hl.trans hlK
  have hKpos : 0 < K := lt_of_lt_of_le zero_lt_one hK1
  have hn : 2 ≤ n := by
    have h2 : (2 * Real.pi / L) * 2 ≤ (2 * Real.pi / L) * n := by
      have := h2g.trans hlK
      linarith
    have : (2 : ℝ) ≤ n := le_of_mul_le_mul_left h2 hg
    exact_mod_cast this
  have hA := kinetic_galerkin_position_spin sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
      hNderiv hn hK1 Ψ₀ H₀ H₁ hΨ₀ hH₀ (regKin sys (2 * Real.pi / L) r) ht
  have hB := kinetic_capped_position_spin sys L hL U hU0 hUgraph hUderiv n UN hN0 hNcomm hNderiv Ψ₀
      H₀ H₁ hΨ₀ hH₀ r hl h2g hlK ht
  dsimp only at hA hB
  refine le_max_min_combine (pow_nonneg (one_div_nonneg.mpr hKpos.le) 3)
    (mul_nonneg ht (pow_nonneg (Real.sqrt_nonneg _) 3))
    (mul_nonneg (Real.rpow_nonneg ht _) (sq_nonneg _)) (hA.trans_eq ?_) (hB.trans_eq ?_)
  · ring
  · ring

/-- **`thm:mult-gal` with internal spin and its propagators.** On `CoulombSpinL2 eta D` the
propagator `e^{-iHt}` of the spin-independent Coulomb Hamiltonian (characterised as in
`thm_dyn_spin`, acting on every spin component by one isometry) and the Galerkin propagators
`U_N` on the spin components satisfy, for every spin-inclusive `Ψ₀ ∈ D(H²)` and every kinetic
multiplier `μ`, `|⟨Ψ(t), (μ ⊗ 1) Ψ(t)⟩ - ⟨Ψ_N(t), (μ ⊗ 1) Ψ_N(t)⟩| ≤ A₁ K^{-3} + A₂ t K^{-3/2}`
for every cube `n ≥ 2` with `K = 2πn/L ≥ 1` and `t ≥ 0`, with `(A₁, A₂) = kinConsts` at the
spin-inclusive norms (the constants of `thm_mult_gal`). -/
theorem thm_mult_gal_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (D : ℕ) :
    ∃ U : ℝ → CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D,
      (∀ Ψ, U 0 Ψ = Ψ) ∧
      (∀ s t Ψ, U (s + t) Ψ = U s (U t Ψ)) ∧
      (∀ Ψ, Continuous fun t => U t Ψ) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasCoulombSpinHamiltonian sys L (U t Ψ) (U t Φ)) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasDerivAt (fun s => U s Ψ) (-(Complex.I • U t Φ)) t) ∧
      (∀ φ ζ : ℝ → CoulombSpinL2 eta D, (∀ t, HasCoulombSpinHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      (∀ t, ∃ V : MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
        ∀ Ψ σ, U t Ψ σ = V (Ψ σ)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ Ψ₀ H₀ H₁ : CoulombSpinL2 eta D, HasCoulombSpinHamiltonian sys L Ψ₀ H₀ →
          HasCoulombSpinHamiltonian sys L H₀ H₁ →
          let A := kinConsts sys L molecularCanonicalUnitHardyConstant
            (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
            (molecularCanonicalKernelConstant L) ‖Ψ₀‖ ‖H₀‖ ‖H₁‖
          ∀ (μ : KinMult sys (2 * Real.pi / L)) (n : ℕ), 2 ≤ n → 1 ≤ (2 * Real.pi / L) * n →
            ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            |spinPosExpect μ (U t Ψ₀) - spinPosExpect μ (spinGalerkin (UN n) Ψ₀ t)| ≤
              A.1 * (1 / K) ^ 3 + A.2 * t * Real.sqrt (1 / K) ^ 3 := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, -, -⟩ := exists_coulombPropagator sys L hL
  choose UN hN0 hNadd _ hNcomm hNderiv _ using
    fun n => exists_finitePropagator (finiteCoulombHamiltonian_isSymmetric sys L n)
  obtain ⟨s0, s1, s2, s3, s4, s5, s6⟩ := spinProp_spec sys L D U h0 hadd hcont hgraph hderiv huniq
  refine ⟨spinProp U, s0, s1, s2, s3, s4, s5, s6, UN, hN0, hNadd, hNderiv, ?_⟩
  intro Ψ₀ H₀ H₁ hΨ₀ hH₀ A μ n hn hK1 t ht
  exact kinetic_galerkin_position_spin sys L hL U h0 hgraph hderiv n (UN n) (hN0 n) (hNadd n)
      (hNcomm n) (hNderiv n) hn hK1 Ψ₀ H₀ H₁ hΨ₀ hH₀ μ ht

/-- **`thm:mult-cap` (Galerkin) with internal spin and its propagators**: as `thm_mult_gal_spin`,
for the kinetic energy `A_r` of a particle `r` and every lowest cap `λ₀ ≥ max(1, 2g)`, the bound
`D₁ K^{-3} + D₂ min(t K^{-3/2}, t^{2/3} K^{-2})` with `(D₁, D₂) = multCapConsts` at
`(λ₀, ‖Ψ₀‖, ‖H₀‖, ‖H₁‖)` for every cube with `K ≥ λ₀` and `t ≥ 0`. -/
theorem thm_mult_cap_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (D : ℕ) :
    ∃ U : ℝ → CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D,
      (∀ Ψ, U 0 Ψ = Ψ) ∧
      (∀ s t Ψ, U (s + t) Ψ = U s (U t Ψ)) ∧
      (∀ Ψ, Continuous fun t => U t Ψ) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasCoulombSpinHamiltonian sys L (U t Ψ) (U t Φ)) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasDerivAt (fun s => U s Ψ) (-(Complex.I • U t Φ)) t) ∧
      (∀ φ ζ : ℝ → CoulombSpinL2 eta D, (∀ t, HasCoulombSpinHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      (∀ t, ∃ V : MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
        ∀ Ψ σ, U t Ψ σ = V (Ψ σ)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ Ψ₀ H₀ H₁ : CoulombSpinL2 eta D, HasCoulombSpinHamiltonian sys L Ψ₀ H₀ →
          HasCoulombSpinHamiltonian sys L H₀ H₁ →
          ∀ (r : Fin eta) (lam0 : ℝ), 1 ≤ lam0 → 2 * (2 * Real.pi / L) ≤ lam0 →
          let Dc := multCapConsts sys L lam0 ‖Ψ₀‖ ‖H₀‖ ‖H₁‖
          ∀ n : ℕ, lam0 ≤ (2 * Real.pi / L) * n →
            ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            |spinPosExpect (regKin sys (2 * Real.pi / L) r) (U t Ψ₀) -
                spinPosExpect (regKin sys (2 * Real.pi / L) r) (spinGalerkin (UN n) Ψ₀ t)| ≤
              Dc.1 * (1 / K) ^ 3 +
                Dc.2 * min (t * Real.sqrt (1 / K) ^ 3) (t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2) := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, -, -⟩ := exists_coulombPropagator sys L hL
  choose UN hN0 hNadd _ hNcomm hNderiv _ using
    fun n => exists_finitePropagator (finiteCoulombHamiltonian_isSymmetric sys L n)
  obtain ⟨s0, s1, s2, s3, s4, s5, s6⟩ := spinProp_spec sys L D U h0 hadd hcont hgraph hderiv huniq
  refine ⟨spinProp U, s0, s1, s2, s3, s4, s5, s6, UN, hN0, hNadd, hNderiv, ?_⟩
  intro Ψ₀ H₀ H₁ hΨ₀ hH₀ r lam0 hl h2g Dc n hlK t ht
  exact kinetic_capped_min_position_spin sys L hL U h0 hgraph hderiv n (UN n) (hN0 n) (hNadd n)
      (hNcomm n) (hNderiv n) Ψ₀ H₀ H₁ hΨ₀ hH₀ r hl h2g hlK ht

/-- **`cor:stopping`, Galerkin route, with internal spin.** In the setting of
`kinetic_galerkin_position_spin`, the secant-slope estimator of the stopping power over `[0, T]`,
evaluated on the spin-inclusive Galerkin trajectory, deviates from the same functional of the
exact trajectory by at most `(A₂ K^{-3/2} + 2 A₁ K^{-3}/T)/v_p`. -/
theorem stopping_galerkin_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (hn : 2 ≤ n) (hK1 : 1 ≤ (2 * Real.pi / L) * n) {D : ℕ}
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁)
    (μ : KinMult sys (2 * Real.pi / L)) {vp T : ℝ} (hvp : 0 < vp) (hT : 0 < T) :
    let K := (2 * Real.pi / L) * n
    let A := kinConsts sys L molecularCanonicalUnitHardyConstant
      (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
      (molecularCanonicalKernelConstant L) ‖Ψ₀‖ ‖H₀‖ ‖H₁‖
    |(spinPosExpect μ (spinProp U T Ψ₀) - spinPosExpect μ (spinProp U 0 Ψ₀)) / (vp * T) -
        (spinPosExpect μ (spinGalerkin UN Ψ₀ T) - spinPosExpect μ (spinGalerkin UN Ψ₀ 0)) /
          (vp * T)| ≤
      (A.2 * Real.sqrt (1 / K) ^ 3 + 2 * A.1 * (1 / K) ^ 3 / T) / vp := by
  intro K A
  have h0 := kinetic_galerkin_position_spin sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
      hNderiv hn hK1 Ψ₀ H₀ H₁ hΨ₀ hH₀ μ (le_refl 0)
  have hT' := kinetic_galerkin_position_spin sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
      hNderiv hn hK1 Ψ₀ H₀ H₁ hΨ₀ hH₀ μ hT.le
  exact (secant_slope_le hvp hT h0 hT').trans (le_of_eq (stopping_arith hvp hT))

/-- **`cor:stopping2`, Galerkin route, with internal spin (window law).** In the setting of
`kinetic_capped_min_position_spin`, the secant-slope estimator deviates by at most
`(D₂ min(K^{-3/2}, T^{-1/3} K^{-2}) + 2 D₁ K^{-3}/T)/v_p`. -/
theorem stopping_window_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t) {D : ℕ}
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁)
    (r : Fin eta) {lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlK : lam0 ≤ (2 * Real.pi / L) * n) {vp T : ℝ} (hvp : 0 < vp) (hT : 0 < T) :
    let K := (2 * Real.pi / L) * n
    let Dc := multCapConsts sys L lam0 ‖Ψ₀‖ ‖H₀‖ ‖H₁‖
    let μ := regKin sys (2 * Real.pi / L) r
    |(spinPosExpect μ (spinProp U T Ψ₀) - spinPosExpect μ (spinProp U 0 Ψ₀)) / (vp * T) -
        (spinPosExpect μ (spinGalerkin UN Ψ₀ T) - spinPosExpect μ (spinGalerkin UN Ψ₀ 0)) /
          (vp * T)| ≤
      (Dc.2 * min (Real.sqrt (1 / K) ^ 3) ((1 / K) ^ 2 / T ^ ((1 : ℝ) / 3)) +
        2 * Dc.1 * (1 / K) ^ 3 / T) / vp := by
  intro K Dc μ
  have h0 := kinetic_capped_min_position_spin sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
      hNderiv Ψ₀ H₀ H₁ hΨ₀ hH₀ r hl h2g hlK (le_refl 0)
  have hT' := kinetic_capped_min_position_spin sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
      hNderiv Ψ₀ H₀ H₁ hΨ₀ hH₀ r hl h2g hlK hT.le
  exact (secant_slope_le hvp hT h0 hT').trans (le_of_eq (window_arith hvp hT))

