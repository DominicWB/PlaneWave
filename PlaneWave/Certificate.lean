/-- Norm convergence to a normalized domain vector makes the approximating
vectors nonzero eventually. No condition on the Hamiltonian is needed. -/
theorem eventually_ne_zero_of_tendsto_norm_one
    {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X]
    {D : Submodule ℂ X} (psi : D) (trial : ℕ → D)
    (hNorm : ‖psi‖ = 1)
    (hTrial : Tendsto (fun n => (trial n : X)) atTop (𝓝 (psi : X))) :
    ∀ᶠ n : ℕ in atTop, trial n ≠ 0 := by
  have hNormLimit : Tendsto (fun n => ‖trial n‖) atTop (𝓝 (1 : ℝ)) := by
    have h : Tendsto (fun n => ‖trial n‖) atTop (𝓝 ‖psi‖) := hTrial.norm
    simpa only [hNorm] using h
  have hPositive : ∀ᶠ n : ℕ in atTop, 0 < ‖trial n‖ :=
    hNormLimit.eventually (Ioi_mem_nhds (zero_lt_one : (0 : ℝ) < 1))
  filter_upwards [hPositive] with n hn
  exact norm_pos_iff.mp hn

/-- Convergence of a vector and its Hamiltonian image implies convergence of
its Rayleigh quotient at a normalized eigenvector. The Hamiltonian is a linear
map on its domain; continuity or boundedness on the ambient normed space is
not assumed. -/
theorem tendsto_rayleigh_of_graph_convergence
    {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X]
    {D : Submodule ℂ X} (H : D →ₗ[ℂ] X) (psi : D) (E : ℝ)
    (trial : ℕ → D) (hNorm : ‖psi‖ = 1)
    (hEigen : H psi = (E : ℂ) • (psi : X))
    (hTrial : Tendsto (fun n => (trial n : X)) atTop (𝓝 (psi : X)))
    (hAction : Tendsto (fun n => H (trial n)) atTop (𝓝 (H psi))) :
    Tendsto
      (fun n => (inner ℂ (trial n : X) (H (trial n))).re / ‖trial n‖ ^ 2)
      atTop (𝓝 E) := by
  have hNumerator :
      Tendsto (fun n => (inner ℂ (trial n : X) (H (trial n))).re)
        atTop (𝓝 ((inner ℂ (psi : X) (H psi)).re)) :=
    (Complex.continuous_re.tendsto _).comp (hTrial.inner (𝕜 := ℂ) hAction)
  have hDenominator :
      Tendsto (fun n => ‖trial n‖ ^ 2) atTop (𝓝 (‖psi‖ ^ 2)) :=
    hTrial.norm.pow 2
  have hDenominatorNe : ‖psi‖ ^ 2 ≠ 0 := by
    rw [hNorm]
    norm_num
  have hNormX : ‖(psi : X)‖ = 1 := hNorm
  have hEnergy : (inner ℂ (psi : X) (H psi)).re = E := by
    rw [hEigen, inner_smul_right, inner_self_eq_norm_sq_to_K]
    simp [hNormX]
  have hQuotient := hNumerator.div hDenominator hDenominatorNe
  rw [Pi.div_def] at hQuotient
  simpa only [hEnergy, hNorm, one_pow, div_one] using hQuotient

