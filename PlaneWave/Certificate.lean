local instance unitAddCircleMeasureSpaceForIdentification138 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-- Matching the coefficients of an independently specified potential with
the signed Coulomb kernel identifies its actual product on each Fourier core. -/
theorem molecularPositionPotentialH2_core_eq_of_fourierCoeff
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeHamiltonianKernel eta L data) N u q)
    (V : MolecularPositionTorus eta → ℂ) (hV : MemLp V 2 volume)
    (hCoeff : ∀ q p : FourierConfig eta Lattice3,
      UnitAddTorus.mFourierCoeff V
          (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
        molecularLatticeNuclearKernel eta data (coulombCellAmplitude L) q p +
          molecularLatticeElectronKernel eta (coulombCellAmplitude L) q p)
    (N : ℕ) (u : MolecularFourierH2 eta) :
    molecularPositionPotentialH2 (2 * Real.pi / L) H (molecularH2Truncate N u) =
      molecularPositionPotentialFourierProduct eta V hV (fourierConfigCube eta N)
        (molecularH2Coeff (2 * Real.pi / L) u) := by
  apply (molecularPositionSynthesis eta).symm.injective
  apply lp.ext
  funext q
  change (molecularPositionSynthesis eta).symm
      (molecularPositionSynthesis eta
        (molecularFourierPotentialH2 (2 * Real.pi / L) H
          (molecularH2Truncate N u))) q = _
  rw [LinearIsometryEquiv.symm_apply_apply,
    molecularFourierPotentialH2_core eta L data H hKernel,
    molecularPositionPotentialFourierProduct_fourier]
  unfold fourierCubeKernelAction
  apply Finset.sum_congr rfl
  intro p _hp
  rw [hCoeff]

/-- The coefficient identity identifies pointwise multiplication on the full
H2 domain. The passage from finite Fourier inputs is a theorem, not a
boundedness hypothesis on the singular potential. -/
theorem molecularPositionPotentialH2_pointwise_of_fourierCoeff
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeHamiltonianKernel eta L data) N u q)
    (V : MolecularPositionTorus eta → ℂ) (hV : MemLp V 2 volume)
    (hCoeff : ∀ q p : FourierConfig eta Lattice3,
      UnitAddTorus.mFourierCoeff V
          (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
        molecularLatticeNuclearKernel eta data (coulombCellAmplitude L) q p +
          molecularLatticeElectronKernel eta (coulombCellAmplitude L) q p)
    (u : MolecularFourierH2 eta) :
    HasL2PointwisePotential volume V
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (molecularPositionPotentialH2 (2 * Real.pi / L) H u) := by
  refine (molecularPositionPotentialH2_pointwise_iff_core eta (2 * Real.pi / L) V H).mpr
    (fun N v => ?_) u
  rw [molecularPositionPotentialH2_core_eq_of_fourierCoeff
    eta L data H hKernel V hV hCoeff N v,
    molecularPositionPotentialFourierProduct_eq_continuousProduct,
    ← molecularPositionFourierTest_cube_toLp]
  exact torusPotentialContinuousProduct_graph V hV
    (molecularPositionFourierTest eta (fourierConfigCube eta N)
      (molecularH2Coeff (2 * Real.pi / L) v))

