  have hb := relB_nonneg sys L Hunit hC
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hMw0 : 0 ≤ Mw := le_trans (mul_nonneg (by linarith) (add_nonneg (norm_nonneg _)
    (mul_nonneg zero_le_two (add_nonneg (mul_nonneg zero_le_two (norm_nonneg _))
