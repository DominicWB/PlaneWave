theorem periodicCoulombCubicAccuracyOfBasisBudget {eta : ℕ} {ν : Type*} [Fintype ν]
    (sys : CoulombSystem eta ν) {D : ℕ} {dim : ℕ → ℕ}
    (hdim : ∀ a, 0 < dim (sys.species a) ∧ dim (sys.species a) ≤ D)
    (L : ℝ) (hL : 0 < L)
    (Ψ : CoulombSpinL2 eta D) (E : ℝ)
    (hPair : HasCoulombSpinGroundPair sys dim L Ψ E)
    (ε : ℝ) (m : ℕ) (hm : coulombDataCubicThreshold sys L ≤ m)
    (hBudget : coulombDataBasisErrorConstant sys L ≤ ε * (((2 * m + 1) ^ 3 : ℕ) : ℝ)) :
    (∃ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε :=
  coulombSpin_data_accuracy_of_basis_budget sys hdim L hL Ψ E hPair ε m hm hBudget

/-- An explicit sufficient cube radius for any requested positive energy accuracy on the
spin-inclusive space of a periodic Coulomb system. -/
theorem periodicCoulombCubicAccuracy {eta : ℕ} {ν : Type*} [Fintype ν]
    (sys : CoulombSystem eta ν) {D : ℕ} {dim : ℕ → ℕ}
    (hdim : ∀ a, 0 < dim (sys.species a) ∧ dim (sys.species a) ≤ D)
    (L : ℝ) (hL : 0 < L)
    (Ψ : CoulombSpinL2 eta D) (E : ℝ)
    (hPair : HasCoulombSpinGroundPair sys dim L Ψ E)
    (ε : ℝ) (hε : 0 < ε) (m : ℕ) (hm : coulombDataAccuracyThreshold sys L ε ≤ m) :
    (∃ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε :=
  coulombSpin_data_accuracy_for_ground_pair sys hdim L hL Ψ E hPair ε hε m hm

end
end PlaneWaveCertificate

