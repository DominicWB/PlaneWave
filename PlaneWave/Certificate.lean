/-- **`H¹` bound of the completed potential.** `‖W u‖² ≤ C² Σ_p (1 + 2 kin) |c_p|²`. -/
theorem potential_sq_le_h1 (u : MolecularFourierH2 eta) :
    ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H u‖ ^ 2 ≤
      finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 * ∑' p, h1f sys L u p := by
  set g := 2 * Real.pi / L
  set C := finiteCoulombPhysicalMassConstant sys L Hunit
  set W := coulombFourierPotentialH2 sys g H
  have hfin : ∀ N count, N ≤ count →
      ‖molecularH2Truncate count (W (molecularH2Truncate N u))‖ ^ 2 ≤ C ^ 2 * ∑' p,
          h1f sys L u p := by
    intro N count hc
    rw [truncate_potential_eq sys L H hKernel N count hc u,
      finiteFourierLpEmbed_norm_eq_fullCoeffVector]
    have hmass := finiteCoulombPotential_physical_massBound sys L Hunit count hL hPeriodic
      (fullCoeffVector (finiteFourierCoeffExtract count
          (molecularH2Coeff g (molecularH2Truncate N u))))
    have hw := weightedNormSq_extract_le_tsum sys L (molecularH2Truncate N u) count
    have hmono : ∑' p, h1f sys L (molecularH2Truncate N u) p ≤ ∑' p, h1f sys L u p :=
      (summable_h1f sys L _).tsum_le_tsum (h1f_truncate_le sys L N u) (summable_h1f sys L u)
    calc ‖fullCoeffVector (finiteCoulombPotential sys (coulombCellAmplitude L) count
          (fullCoeffVector (finiteFourierCoeffExtract count
            (molecularH2Coeff g (molecularH2Truncate N u))))).ofLp‖ ^ 2
        = ‖finiteCoulombPotential sys (coulombCellAmplitude L) count
          (fullCoeffVector (finiteFourierCoeffExtract count
            (molecularH2Coeff g (molecularH2Truncate N u))))‖ ^ 2 := rfl
      _ ≤ C ^ 2 * weightedNormSq
            (fun p => 1 + massKineticSymbol sys.mass (finitePlaneWaveKabs g count) p)
            (fullCoeffVector (finiteFourierCoeffExtract count
              (molecularH2Coeff g (molecularH2Truncate N u)))) := hmass
      _ ≤ C ^ 2 * ∑' p, h1f sys L u p :=
          mul_le_mul_of_nonneg_left (hw.trans hmono) (sq_nonneg _)
  have hN : ∀ N, ‖W (molecularH2Truncate N u)‖ ^ 2 ≤ C ^ 2 * ∑' p, h1f sys L u p := by
    intro N
    have ht := (molecularH2Truncate_tendsto (W (molecularH2Truncate N u))).norm.pow 2
    exact le_of_tendsto ht (eventually_atTop.mpr ⟨N, fun count hc => hfin N count hc⟩)
  have hL1 : Tendsto (fun N => ‖W (molecularH2Truncate N u)‖ ^ 2) atTop (𝓝 (‖W u‖ ^ 2)) :=
    ((W.continuous.tendsto u).comp (molecularH2Truncate_tendsto u)).norm.pow 2
  exact le_of_tendsto' hL1 hN

omit [Fintype ν] in
/-- Outside the cube of radius `n` some register has momentum beyond `g n`. -/
lemma exists_tail_of_not_mem_cube {g : ℝ} (hg : 0 < g) {n : ℕ} {p : FourierConfig eta Lattice3}
    (hp : p ∉ fourierConfigCube eta n) :
    ∃ a : Fin eta, g * n < g * Real.sqrt (latticeNormSq (p a)) := by
  rw [mem_fourierConfigCube_iff] at hp
  push Not at hp
  obtain ⟨i, d, hid⟩ := hp
  refine ⟨i, mul_lt_mul_of_pos_left ?_ hg⟩
  have h1 : (n : ℤ) + 1 ≤ |p i d| := by
    by_cases h : -(n : ℤ) ≤ p i d
    · have := hid h
      rw [abs_of_pos (by omega)]
      omega
    · push Not at h
      rw [abs_of_neg (by omega)]
      omega
  have h2 : ((n : ℝ) + 1) ≤ |((p i d : ℤ) : ℝ)| := by
    have := (Int.cast_le (R := ℝ)).mpr h1
    push_cast at this
    exact this
  have hsq : ((n : ℝ) + 1) ^ 2 ≤ latticeNormSq (p i) := by
    have h3 : ((n : ℝ) + 1) ^ 2 ≤ ((p i d : ℤ) : ℝ) ^ 2 := by
      calc ((n : ℝ) + 1) ^ 2 ≤ |((p i d : ℤ) : ℝ)| ^ 2 := pow_le_pow_left₀ (by positivity) h2 2
        _ = ((p i d : ℤ) : ℝ) ^ 2 := sq_abs _
    have h4 : ((p i d : ℤ) : ℝ) ^ 2 ≤ latticeNormSq (p i) := by
      unfold latticeNormSq
      fin_cases d <;> simp <;> nlinarith [sq_nonneg ((p i 0 : ℤ) : ℝ), sq_nonneg ((p i 1 : ℤ) : ℝ),
        sq_nonneg ((p i 2 : ℤ) : ℝ)]
    linarith
  have h5 : (n : ℝ) + 1 ≤ Real.sqrt (latticeNormSq (p i)) :=
    Real.le_sqrt_of_sq_le hsq
  linarith

omit [Fintype ν] in
/-- **Union bound.** `‖(1 - P) x‖ ≤ Σ_a ‖1_{a, > g n} x‖`. -/
lemma norm_sub_truncate_le {g : ℝ} (hg : 0 < g) (n : ℕ)
    (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖x - molecularH2Truncate n x‖ ≤ ∑ a : Fin eta, ‖tailMask g (g * n) a x‖ := by
  classical
  have hsq : ‖x - molecularH2Truncate n x‖ ^ 2 ≤ ∑ a : Fin eta, ‖tailMask g (g * n) a x‖ ^ 2 := by
    rw [l2_norm_sq]
    have hsum : ∀ a ∈ (Finset.univ : Finset (Fin eta)),
        Summable fun p => ‖tailMask g (g * n) a x p‖ ^ 2 := fun a _ => l2_summable_sq _
    calc ∑' p, ‖(x - molecularH2Truncate n x) p‖ ^ 2
        ≤ ∑' p, ∑ a : Fin eta, ‖tailMask g (g * n) a x p‖ ^ 2 := by
          refine (l2_summable_sq _).tsum_le_tsum (fun p => ?_)
            (summable_sum fun a _ => l2_summable_sq _)
          rw [lp.coeFn_sub, Pi.sub_apply, molecularH2Truncate_apply]
          by_cases hp : p ∈ fourierConfigCube eta n
          · rw [cubicLatticeCoeffTruncate_eq_of_mem n _ p hp, sub_self, norm_zero]
            simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]
            exact Finset.sum_nonneg (fun a _ => sq_nonneg _)
          · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp, sub_zero]
            obtain ⟨a, ha⟩ := exists_tail_of_not_mem_cube hg hp
            have hterm : ‖tailMask g (g * n) a x p‖ ^ 2 =
                ‖(x : FourierConfig eta Lattice3 → ℂ) p‖ ^ 2 := by
              rw [tailMask_apply, if_pos ha, one_mul]
            rw [← hterm]
            exact Finset.single_le_sum (f := fun a => ‖tailMask g (g * n) a x p‖ ^ 2)
              (fun a _ => sq_nonneg _) (Finset.mem_univ a)
      _ = ∑ a : Fin eta, ∑' p, ‖tailMask g (g * n) a x p‖ ^ 2 := Summable.tsum_finsetSum hsum
      _ = ∑ a : Fin eta, ‖tailMask g (g * n) a x‖ ^ 2 := by
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [l2_norm_sq]
  have h2 : ∑ a : Fin eta, ‖tailMask g (g * n) a x‖ ^ 2 ≤
      (∑ a : Fin eta, ‖tailMask g (g * n) a x‖) ^ 2 :=
    Finset.sum_sq_le_sq_sum_of_nonneg (fun a _ => norm_nonneg _)
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (Finset.sum_nonneg fun a _ => norm_nonneg _)
    two_ne_zero).mp (hsq.trans h2)

