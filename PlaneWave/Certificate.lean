  set c := molecularH2Coeff g x
  set F : FourierConfig eta Lattice3 → ℝ :=
    fun q => (1 + 2 * coulombKineticEnergySymbol sys g q) * ‖c q‖ ^ 2 with hF
  have hF0 : ∀ q, 0 ≤ F q := fun q => mul_nonneg
    (by linarith [coulombKineticEnergySymbol_nonneg sys g q]) (sq_nonneg _)
  have hFle : ∀ q, F q ≤ α * (coulombKineticEnergySymbol sys g q ^ 2 * ‖c q‖ ^ 2) +
