is an absorbed constant shift. No new analytic assumptions, axioms, proof
placeholders, or warning suppressions are introduced.

Validation: independent source/API review and static dependency/assumption
checks. Compilation is pending; no Lean compiler is installed here.
-/

/-! ## Physical form and ground-energy lower bounds -/

/-! ## Finite-reference upper bound -/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-- A fixed, finite reference Hamiltonian, on the integer cube of radius eta.
Its coefficients are determined by the molecular data. Symmetry supplies the
continuous operator without a continuity or spectral hypothesis. -/
def molecularReferenceHamiltonian
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode eta)) →L[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode eta)) :=
  (finiteMolecularBOHamiltonian_isSymmetric eta L data eta).toSelfAdjoint.val

/-- A data-only upper budget for the ground energy. This is the operator norm
of one specified finite matrix; it contains no unknown continuum energy. -/
def molecularFiniteReferenceEnergyBound
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) : ℝ :=
  ‖molecularReferenceHamiltonian eta L data‖

/-! ### Explicit bound on the reference norm -/

/-- Every mode of the finite plane-wave basis with `count` shells has squared
momentum at most `3 g² count²`. -/
lemma finitePlaneWaveKabs_sq_le (g : ℝ) (count : ℕ) (u : FinitePlaneWaveMode count) :
    finitePlaneWaveKabs g count u ^ 2 ≤ 3 * g ^ 2 * (count : ℝ) ^ 2 := by
  rw [finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq]
  have hCoord : ∀ d : Fin 3,
      ((finitePlaneWaveLatticeIndex count u d : ℤ) : ℝ) ^ 2 ≤ (count : ℝ) ^ 2 := by
    intro d
    obtain ⟨hlo, hhi⟩ := finitePlaneWaveLatticeIndex_coord_bounds count u d
    have hlo' : -((count : ℝ)) ≤ ((finitePlaneWaveLatticeIndex count u d : ℤ) : ℝ) := by
      exact_mod_cast hlo
    have hhi' : ((finitePlaneWaveLatticeIndex count u d : ℤ) : ℝ) ≤ (count : ℝ) := by
      exact_mod_cast hhi
    nlinarith [hlo', hhi']
  have hN : latticeNormSq (finitePlaneWaveLatticeIndex count u) ≤ 3 * (count : ℝ) ^ 2 := by
    unfold latticeNormSq
    linarith [hCoord 0, hCoord 1, hCoord 2]
  nlinarith [sq_nonneg g, hN]

/-- On the finite basis with `count` shells, the kinetic symbol of `eta` particles is at
most `3 g² eta count²`. -/
lemma boKineticSymbol_finitePlaneWaveKabs_le {eta : ℕ} (g : ℝ) (count : ℕ)
    (p : FourierConfig eta (FinitePlaneWaveMode count)) :
    boKineticSymbol (finitePlaneWaveKabs g count) p ≤
      3 * g ^ 2 * (eta : ℝ) * (count : ℝ) ^ 2 := by
  unfold boKineticSymbol
  calc ∑ a : Fin eta, (finitePlaneWaveKabs g count (p a)) ^ 2
      ≤ ∑ _a : Fin eta, 3 * g ^ 2 * (count : ℝ) ^ 2 :=
        Finset.sum_le_sum (fun a _ => finitePlaneWaveKabs_sq_le g count (p a))
    _ = 3 * g ^ 2 * (eta : ℝ) * (count : ℝ) ^ 2 := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

/-- An H¹ operator bound gives an operator-norm bound on a space where the kinetic
symbol is at most `M`. -/
lemma norm_apply_le_of_h1OperatorBound {eta : ℕ} {μ : Type*} [Fintype μ]
    {kabs : μ → ℝ}
    {A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ)}
    {B M : ℝ} (hB : HasH1OperatorBound kabs A B) (hB0 : 0 ≤ B) (hM0 : 0 ≤ M)
    (hM : ∀ p : FourierConfig eta μ, boKineticSymbol kabs p ≤ M)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖A u‖ ≤ B * Real.sqrt (1 + M) * ‖u‖ := by
  have hH1 : fourierH1Sq kabs u ≤ (1 + M) * ‖u‖ ^ 2 := by
    unfold fourierH1Sq
    rw [EuclideanSpace.norm_sq_eq, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro p _
    exact mul_le_mul_of_nonneg_right (by linarith [hM p]) (sq_nonneg _)
  have hSq : ‖A u‖ ^ 2 ≤ (B * Real.sqrt (1 + M) * ‖u‖) ^ 2 := by
    rw [mul_pow, mul_pow, Real.sq_sqrt (by linarith)]
    calc ‖A u‖ ^ 2 ≤ B ^ 2 * fourierH1Sq kabs u := hB u
      _ ≤ B ^ 2 * ((1 + M) * ‖u‖ ^ 2) := mul_le_mul_of_nonneg_left hH1 (sq_nonneg B)
      _ = B ^ 2 * (1 + M) * ‖u‖ ^ 2 := by ring
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hSq

end
end PlaneWaveCertificate

/-! ## Monotonicity of the analytic budgets -/

/-! ## Explicit scalar cutoff and accuracy thresholds -/

namespace PlaneWaveCertificate

noncomputable section

/-- An explicit conservative threshold for all six cubic cutoff side conditions.
The supplied `A` is an energy bound; no sign assumption on `A` or `T` is needed. -/
def molecularExplicitCubicThreshold (eta : ℕ) (g A T : ℝ) : ℕ :=
  max 1 (max eta (Nat.ceil
    ((1 + 2 * g + 4 * (|A| + 1) + 32 * (eta : ℝ) * T ^ 2) / g) + 1))

/-- A ceiling gives an explicit sufficient half-width for any positive
accuracy budget; the inequality is valid for every larger cube. -/
lemma molecularCubicCount_accuracy_budget_of_ceil
    (C ε : ℝ) (hε : 0 < ε) (m : ℕ)
    (hm : Nat.ceil (C / ε) ≤ m) :
    C ≤ ε * (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  have hceil : C / ε ≤ (Nat.ceil (C / ε) : ℝ) :=
    (Nat.ceil_le).mp (le_refl (Nat.ceil (C / ε)))
  have hCount : (Nat.ceil (C / ε) : ℝ) ≤
      (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
    exact_mod_cast hm.trans (enough_cubic_modes_of_particle_le_count m m le_rfl)
  have hBudget : C ≤ ε * (Nat.ceil (C / ε) : ℝ) := by
    simpa only [mul_comm] using (div_le_iff₀ hε).mp hceil
  exact hBudget.trans (mul_le_mul_of_nonneg_left hCount hε.le)

end

end PlaneWaveCertificate

/-! ## Budgets depending only on molecular data -/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-- An absolute ground-energy budget using only the fixed finite reference
matrix and the proved molecular form constant. -/
def molecularGroundEnergyBudget
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) : ℝ :=
  molecularFiniteReferenceEnergyBound eta data L +
    (finiteMolecularCoulombPhysicalFormConstant eta data L
      molecularCanonicalUnitHardyConstant) ^ 2 + (1 / 4 : ℝ)

/-- Cutoff error coefficient with no unknown ground-energy argument. -/
def molecularDataCubicErrorConstant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) : ℝ :=
  molecularCanonicalCubicErrorConstant eta data (molecularGroundEnergyBudget eta data L) L

/-- Basis-count error coefficient with no unknown ground-energy argument. -/
def molecularDataBasisErrorConstant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) : ℝ :=
  molecularCanonicalBasisErrorConstant eta data (molecularGroundEnergyBudget eta data L) L

/-- The potential-tail budget after replacing the exact ground energy. -/
def molecularDataTailBudget
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) : ℝ :=
  finiteMolecularCoulombPhysicalTailConstant eta data L
    molecularCanonicalUnitHardyConstant (molecularCanonicalLowConstant L)
    (molecularCanonicalSobolevConstant L) (molecularCanonicalKernelConstant L)
    (continuumMolecularBOH2Constant eta data (molecularGroundEnergyBudget eta data L) L
      molecularCanonicalUnitHardyConstant)

/-- An explicit integer cube threshold determined entirely by physical data. -/
def molecularDataCubicThreshold
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ) : ℕ :=
  molecularExplicitCubicThreshold eta (2 * Real.pi / L)
    (molecularGroundEnergyBudget eta data L) (molecularDataTailBudget eta data L)

end
end PlaneWaveCertificate

/-! ## Physical certificate with data-only constants -/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-- A fully specified sufficient cube radius for a requested energy accuracy.
This coarse ceiling is convenient; the preceding basis-budget criterion
allows smaller radii whenever its sharper count condition is satisfied. -/
def molecularDataAccuracyThreshold
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (L ε : ℝ) : ℕ :=
  max (molecularDataCubicThreshold eta data L)
    (Nat.ceil (molecularDataBasisErrorConstant eta data L / ε))

end
end PlaneWaveCertificate

