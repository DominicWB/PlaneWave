/-- Extend a finite family by zero along a map into the full coordinate set.
Injectivity is required by the coordinate and norm theorems below. -/
def lpFiniteEmbed {α ι : Type*} [Fintype α] (e : α → ι) (c : α → ℂ) :
    lp (fun _ : ι => ℂ) 2 := by
  classical
  exact ∑ a, lp.single (E := fun _ : ι => ℂ) 2 (e a) (c a)

theorem lpFiniteEmbed_apply_image {α ι : Type*} [Fintype α]
    (e : α → ι) (he : Function.Injective e) (c : α → ℂ) (a : α) :
    lpFiniteEmbed e c (e a) = c a := by
  classical
  rw [lpFiniteEmbed, lp.coeFn_sum, Finset.sum_apply]
  calc
    (∑ b, (lp.single (E := fun _ : ι => ℂ) 2 (e b) (c b)) (e a)) =
        (lp.single (E := fun _ : ι => ℂ) 2 (e a) (c a)) (e a) := by
      apply Finset.sum_eq_single a
      · intro b _ hba
        apply lp.single_apply_ne (E := fun _ : ι => ℂ) 2 (e b) (c b)
        intro hab
        exact hba (he hab.symm)
      · intro ha
        exact (ha (Finset.mem_univ a)).elim
    _ = c a := lp.single_apply_self (E := fun _ : ι => ℂ) 2 (e a) (c a)

theorem lpFiniteEmbed_apply_not_mem_range {α ι : Type*} [Fintype α]
    (e : α → ι) (c : α → ℂ) (i : ι) (hi : i ∉ Set.range e) :
    lpFiniteEmbed e c i = 0 := by
  classical
  rw [lpFiniteEmbed, lp.coeFn_sum, Finset.sum_apply]
  apply Finset.sum_eq_zero
  intro a _
  apply lp.single_apply_ne (E := fun _ : ι => ℂ) 2 (e a) (c a)
  intro hia
  exact hi ⟨a, hia.symm⟩

theorem lpFiniteEmbed_truncate_eq {α ι : Type*} [Fintype α] [DecidableEq ι]
    (e : α → ι) (c : α → ℂ) :
    lpTruncate (Finset.univ.image e) (lpFiniteEmbed e c) = lpFiniteEmbed e c := by
  classical
  apply lp.ext
  funext i
  rw [lpTruncate_apply]
  by_cases hi : i ∈ Finset.univ.image e
  · rw [if_pos hi]
  · rw [if_neg hi]
    symm
    apply lpFiniteEmbed_apply_not_mem_range
    rintro ⟨a, rfl⟩
    exact hi (Finset.mem_image.mpr ⟨a, Finset.mem_univ a, rfl⟩)

/-- Zero-extension preserves exactly the sum of squared coefficient norms. -/
theorem lpFiniteEmbed_norm_sq {α ι : Type*} [Fintype α]
    (e : α → ι) (he : Function.Injective e) (c : α → ℂ) :
    ‖lpFiniteEmbed e c‖ ^ 2 = ∑ a, ‖c a‖ ^ 2 := by
  classical
  calc
    ‖lpFiniteEmbed e c‖ ^ 2 =
        ‖lpTruncate (Finset.univ.image e) (lpFiniteEmbed e c)‖ ^ 2 := by
      rw [lpFiniteEmbed_truncate_eq]
    _ = ∑ i ∈ Finset.univ.image e, ‖lpFiniteEmbed e c i‖ ^ 2 :=
      lpTruncate_norm_sq _ _
    _ = ∑ a, ‖c a‖ ^ 2 := by
      rw [Finset.sum_image]
      · simp only [lpFiniteEmbed_apply_image e he c]
      · intro a _ b _ hab
        exact he hab

/-- Restricting an `lp` vector and then extending by zero is coordinate truncation. -/
theorem lpFiniteEmbed_extract_eq_truncate {α ι : Type*} [Fintype α]
    [DecidableEq ι] (e : α → ι) (he : Function.Injective e)
    (u : lp (fun _ : ι => ℂ) 2) :
    lpFiniteEmbed e (fun a => u (e a)) = lpTruncate (Finset.univ.image e) u := by
  classical
  apply lp.ext
  funext i
  rw [lpTruncate_apply]
  by_cases hi : i ∈ Finset.univ.image e
  · rw [if_pos hi]
    rcases Finset.mem_image.mp hi with ⟨a, _, rfl⟩
    exact lpFiniteEmbed_apply_image e he _ a
  · rw [if_neg hi]
    apply lpFiniteEmbed_apply_not_mem_range
    rintro ⟨a, rfl⟩
    exact hi (Finset.mem_image.mpr ⟨a, Finset.mem_univ a, rfl⟩)

/-- The actual finite many-particle Fourier coefficients, extended by zero to
the full reciprocal lattice. -/
def finiteFourierLpEmbed (eta count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  lpFiniteEmbed (finiteConfigLatticeIndex eta count) coeff

theorem finiteFourierLpEmbed_apply_index (eta count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteFourierLpEmbed eta count coeff (finiteConfigLatticeIndex eta count p) =
      coeff p :=
  lpFiniteEmbed_apply_image _ (finiteConfigLatticeIndex_injective eta count) coeff p

theorem finiteFourierLpEmbed_apply_not_mem_cube (eta count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (p : FourierConfig eta Lattice3) (hp : p ∉ fourierConfigCube eta count) :
    finiteFourierLpEmbed eta count coeff p = 0 := by
  apply lpFiniteEmbed_apply_not_mem_range
  rintro ⟨q, rfl⟩
  exact hp (finiteConfigLatticeIndex_mem_cube eta count q)

theorem finiteFourierLpEmbed_norm_sq (eta count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ) :
    ‖finiteFourierLpEmbed eta count coeff‖ ^ 2 = ∑ p, ‖coeff p‖ ^ 2 :=
  lpFiniteEmbed_norm_sq _ (finiteConfigLatticeIndex_injective eta count) coeff

/-- The infinite zero-extension has the same norm as the finite Euclidean
coefficient vector used by the molecular Hamiltonian. -/
theorem finiteFourierLpEmbed_norm_eq_fullCoeffVector (eta count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ) :
    ‖finiteFourierLpEmbed eta count coeff‖ = ‖fullCoeffVector coeff‖ := by
  have hsq : ‖finiteFourierLpEmbed eta count coeff‖ ^ 2 =
      ‖fullCoeffVector coeff‖ ^ 2 := by
    simpa only [EuclideanSpace.norm_sq_eq, fullCoeffVector_apply] using
      (finiteFourierLpEmbed_norm_sq eta count coeff)
  nlinarith [norm_nonneg (finiteFourierLpEmbed eta count coeff),
    norm_nonneg (fullCoeffVector coeff)]

theorem finiteFourierLpEmbed_extract_eq_truncate {eta : ℕ} (count : ℕ)
    (u : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    finiteFourierLpEmbed eta count (finiteFourierCoeffExtract count (fun p => u p)) =
      lpTruncate (fourierConfigCube eta count) u := by
  classical
  change lpFiniteEmbed (finiteConfigLatticeIndex eta count)
      (fun p => u (finiteConfigLatticeIndex eta count p)) =
    lpTruncate (Finset.univ.image (finiteConfigLatticeIndex eta count)) u
  exact lpFiniteEmbed_extract_eq_truncate (finiteConfigLatticeIndex eta count)
    (finiteConfigLatticeIndex_injective eta count) u

end

