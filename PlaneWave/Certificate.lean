    (hA₁ : A₁ = 2 * δ₁ * (Cχ * τ₁ + CO * δ₁) + CO * δ₁ ^ 2)
    (hA₂ : A₂ = 2 * δ₁ * (e * c1) + 2 * CO * δ₁ * N₁ + δ₁ * (e * c2))
