end Compact

/-! ## D6, D7: the resolvent operator and the propagator on the Fourier side -/

section Propagator

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

/-- The resolvent operator `R = S (H + c S)⁻¹` on `ℓ²`. -/
noncomputable def resolventR : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  (molecularH2StateMap eta (2 * Real.pi / L)).comp (resolventG sys L H hKernel Hunit hL hPeriodic)

lemma resolventR_compact : IsCompactOperator (resolventR sys L H hKernel Hunit hL hPeriodic) := by
  have hS : IsCompactOperator (molecularH2StateMap eta (2 * Real.pi / L)) :=
    isCompactOperator_stateMap (2 * Real.pi / L) (by positivity)
  exact hS.comp_clm (resolventG sys L H hKernel Hunit hL hPeriodic)

lemma resolventR_symm :
    (resolventR sys L H hKernel Hunit hL hPeriodic :
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →ₗ[ℂ]
        lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2).IsSymmetric := by
  intro f f'
  set G := resolventG sys L H hKernel Hunit hL hPeriodic
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set c := shiftC sys L Hunit
  have hf := H_add_shift_resolventG sys L H hKernel Hunit hL hPeriodic f
  have hf' := H_add_shift_resolventG sys L H hKernel Hunit hL hPeriodic f'
  change ⟪S (G f), f'⟫_ℂ = ⟪f, S (G f')⟫_ℂ
  conv_lhs => rw [← hf']
  conv_rhs => rw [← hf]
  rw [inner_add_right, inner_add_left, inner_smul_right, inner_smul_left, Complex.conj_ofReal,
    coulombH2_symm sys L H hKernel]

lemma resolventR_injective : Function.Injective
    (resolventR sys L H hKernel Hunit hL hPeriodic) := by
  intro f f' h
  have h1 : resolventG sys L H hKernel Hunit hL hPeriodic f =
      resolventG sys L H hKernel Hunit hL hPeriodic f' :=
    molecularH2StateMap_injective eta (2 * Real.pi / L) h
  rw [← H_add_shift_resolventG sys L H hKernel Hunit hL hPeriodic f,
    ← H_add_shift_resolventG sys L H hKernel Hunit hL hPeriodic f', h1]

lemma resolventR_apply_H (u : MolecularFourierH2 eta) :
    resolventR sys L H hKernel Hunit hL hPeriodic
      (H u + (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) u) =
      molecularH2StateMap eta (2 * Real.pi / L) u := by
  change molecularH2StateMap eta (2 * Real.pi / L) (resolventG sys L H hKernel Hunit hL hPeriodic
    (H u + (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) u)) = _
  rw [resolventG_H_add_shift]

end Propagator

/-- **Propagator of a periodic Coulomb system, Fourier side.** For the completed Fourier
Hamiltonian `H : H² → ℓ²` of the certificate there is a strongly continuous unitary group `U`
on `ℓ²` such that, with the decoding map `S : H² → ℓ²`,
* `U t` maps the domain `S(H²)` to itself and commutes with `H`: for every `u` there is `u'`
  with `S u' = U t (S u)` and `H u' = U t (H u)`;
* `t ↦ U t (S u)` solves the Schrödinger equation `i ψ' = H ψ`;
* every differentiable curve in `S(H²)` that solves it is `U t` applied to its initial value. -/
theorem exists_coulombFourierPropagator (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q) :
    ∃ U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
        lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
      (∀ x, U 0 x = x) ∧
      (∀ s t x, U (s + t) x = U s (U t x)) ∧
      (∀ x, Continuous fun t => U t x) ∧
      (∀ t u, ∃ u' : MolecularFourierH2 eta,
        molecularH2StateMap eta (2 * Real.pi / L) u' =
          U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u)) ∧
      (∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
        (-(Complex.I • U t (H u))) t) ∧
      (∀ (φ : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (v : ℝ → MolecularFourierH2 eta),
        (∀ t, φ t = molecularH2StateMap eta (2 * Real.pi / L) (v t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • H (v t))) t) → ∀ t, φ t = U t (φ 0)) := by
  set Hunit := molecularCanonicalUnitHardyConstant
  have hPeriodic := canonicalPeriodicCoulombHardyBound_explicit
  set R := resolventR sys L H hKernel Hunit hL hPeriodic
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set G := resolventG sys L H hKernel Hunit hL hPeriodic
  set c := shiftC sys L Hunit
  obtain ⟨U, h0, hadd, hcont, hcomm, hderiv, huniq⟩ := exists_propagator
    (resolventR_compact sys L H hKernel Hunit hL hPeriodic)
    (resolventR_symm sys L H hKernel Hunit hL hPeriodic)
    (resolventR_injective sys L H hKernel Hunit hL hPeriodic) c
  -- `S u = R y` with `y = H u + c S u`, and `y - c R y = H u`
  have hRy : ∀ u, R (H u + (c : ℂ) • S u) = S u :=
      resolventR_apply_H sys L H hKernel Hunit hL hPeriodic
  have hyc : ∀ u, (H u + (c : ℂ) • S u) - (c : ℂ) • R (H u + (c : ℂ) • S u) = H u := by
    intro u
    rw [hRy]
    abel
  refine ⟨U, h0, hadd, hcont, ?_, ?_, ?_⟩
  · intro t u
    set y := H u + (c : ℂ) • S u
    refine ⟨G (U t y), ?_, ?_⟩
    · change R (U t y) = U t (S u)
      rw [← hcomm, hRy]
    · have h1 := H_add_shift_resolventG sys L H hKernel Hunit hL hPeriodic (U t y)
      have h2 : S (G (U t y)) = U t (S u) := by
        change R (U t y) = U t (S u)
        rw [← hcomm, hRy]
      have h3 : H (G (U t y)) = U t y - (c : ℂ) • S (G (U t y)) := eq_sub_of_add_eq h1
      rw [h3, h2, ← map_smul, ← map_sub]
      congr 1
      simp only [y]
      abel
  · intro t u
    have h := hderiv t (H u + (c : ℂ) • S u)
    rw [show resolventR sys L H hKernel Hunit hL hPeriodic (H u + (c : ℂ) • S u) = S u from
      hRy u] at h
    simp only [add_sub_cancel_right] at h
    exact h
  · intro φ v hφ hd t
    refine huniq φ (fun s => H (v s) + (c : ℂ) • S (v s)) (fun s => ?_) (fun s => ?_) t
    · rw [hRy, hφ]
    · have := hd s
      have e : H (v s) + (c : ℂ) • S (v s) - (c : ℂ) • φ s = H (v s) := by
        rw [hφ]
        abel
      rw [e]
      exact this

/-! ## D8: the propagator in position space, with the physical Hamiltonian relation -/

section Position

/-- Fourier synthesis followed by the reflection `x ↦ -x`: the identification of `ℓ²` with the
physical position space of `HasCoulombHamiltonian`. -/
noncomputable def physMap (eta : ℕ) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ] MolecularPositionL2 eta :=
  (molecularPositionSynthesis eta).trans (molecularPositionReflection eta)

lemma hasCoulombHamiltonian_iff_phys (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (f h : MolecularPositionL2 eta) :
    HasCoulombHamiltonian sys L f h ↔
      ∃ u : MolecularFourierH2 eta, physMap eta (molecularH2StateMap eta (2 * Real.pi / L) u) = f ∧
        physMap eta (H u) = h := by
  rw [hasCoulombHamiltonian_iff_reflectedH2 sys L hL H hKernel]
  rfl

omit [Fintype ν] in
/-- Cubic truncations of any `ℓ²` vector lie in the range of the decoding map. -/
lemma truncate_mem_range_stateMap (g : ℝ) (n : ℕ)
    (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    molecularH2StateMap eta g
        (finiteFourierH2Lift eta g n (finiteFourierCoeffExtract n (fun p => x p))) =
      molecularH2Truncate n x := by
  rw [molecularH2StateMap_finiteFourierH2Lift, finiteFourierLpEmbed_extract_eq_truncate]
  rfl

/-- **Propagator of a periodic Coulomb system.** On the position space `L²((T³)^η)` there is a
strongly continuous unitary group `U` that preserves the graph of the Hamiltonian
(`HasCoulombHamiltonian`), solves the Schrödinger equation `i ψ' = H ψ` on its domain, is the
only evolution that does so, commutes with every relabelling within species, and preserves the
exchange sector of every admissible labelling. -/
theorem exists_coulombPropagator (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      (∀ π : Equiv.Perm (Fin eta), sys.IsSpeciesPerm π → ∀ t ψ,
        U t (molecularPositionPermLp π ψ) = molecularPositionPermLp π (U t ψ)) ∧
      (∀ (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ), sys.IsAdmissible lab → ∀ t ψ,
        IsPositionSector sgn lab ψ → IsPositionSector sgn lab (U t ψ)) := by
  obtain ⟨H, hKernel, -⟩ := exists_coulombFourierH2Operator sys L
      molecularCanonicalUnitHardyConstant
    hL canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨UF, h0, hadd, hcont, hgraph, hderiv, huniq⟩ :=
    exists_coulombFourierPropagator sys L hL H hKernel
  have hiff := hasCoulombHamiltonian_iff_phys sys L hL H hKernel
  set Φ := physMap eta
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta :=
    fun t => (Φ.symm.trans (UF t)).trans Φ with hU
  have hUapply : ∀ t ψ, U t ψ = Φ (UF t (Φ.symm ψ)) := fun t ψ => rfl
  -- the Hamiltonian relation is preserved
  have hgraphU : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h) := by
    intro t f h hfh
    obtain ⟨u, rfl, rfl⟩ := (hiff f h).mp hfh
    obtain ⟨u', hu'1, hu'2⟩ := hgraph t u
    refine (hiff _ _).mpr ⟨u', ?_, ?_⟩
    · rw [hUapply, LinearIsometryEquiv.symm_apply_apply, hu'1]
    · rw [hUapply, LinearIsometryEquiv.symm_apply_apply, hu'2]
  -- the Schrödinger equation
  have hΦd : ∀ (γ : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) γ' t,
      HasDerivAt γ γ' t → HasDerivAt (fun s => Φ (γ s)) (Φ γ') t := fun γ γ' t hγ =>
    ((Φ.toContinuousLinearEquiv.toContinuousLinearMap).restrictScalars
        ℝ).hasFDerivAt.comp_hasDerivAt
      t hγ
  have hΦsd : ∀ (γ : ℝ → MolecularPositionL2 eta) γ' t,
      HasDerivAt γ γ' t → HasDerivAt (fun s => Φ.symm (γ s)) (Φ.symm γ') t := fun γ γ' t hγ =>
    ((Φ.symm.toContinuousLinearEquiv.toContinuousLinearMap).restrictScalars
        ℝ).hasFDerivAt.comp_hasDerivAt
      t hγ
  have hderivU : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t := by
    intro t f h hfh
    obtain ⟨u, rfl, rfl⟩ := (hiff f h).mp hfh
    have h1 := hΦd _ _ t (hderiv t u)
    simp only [hUapply, LinearIsometryEquiv.symm_apply_apply]
    rw [map_neg, map_smul] at h1
    exact h1
  -- uniqueness
  have huniqU : ∀ φ ζ : ℝ → MolecularPositionL2 eta,
      (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
      (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0) := by
    intro φ ζ hφζ hd t
    choose v hv1 hv2 using fun s => (hiff (φ s) (ζ s)).mp (hφζ s)
    have hF := huniq (fun s => Φ.symm (φ s)) v
      (fun s => by rw [← hv1 s, LinearIsometryEquiv.symm_apply_apply])
      (fun s => by
        have := hΦsd φ _ s (hd s)
        rw [map_neg, map_smul, ← hv2 s, LinearIsometryEquiv.symm_apply_apply] at this
        exact this) t
    rw [hUapply, ← hF, LinearIsometryEquiv.apply_symm_apply]
  -- the domain is dense
  have hdense : ∀ ψ : MolecularPositionL2 eta, ∃ f : ℕ → MolecularPositionL2 eta,
      (∀ n, ∃ h, HasCoulombHamiltonian sys L (f n) h) ∧ Tendsto f atTop (𝓝 ψ) := by
    intro ψ
    set x := Φ.symm ψ
    refine ⟨fun n => Φ (molecularH2Truncate n x), fun n => ?_, ?_⟩
    · set u := finiteFourierH2Lift eta (2 * Real.pi / L) n
        (finiteFourierCoeffExtract n (fun p => x p))
      refine ⟨Φ (H u), (hiff _ _).mpr ⟨u, ?_, rfl⟩⟩
      rw [truncate_mem_range_stateMap]
    · have h := (Φ.continuous.tendsto x).comp (molecularH2Truncate_tendsto x)
      rw [LinearIsometryEquiv.apply_symm_apply] at h
      exact h
  -- commutation with relabellings within species
  have hperm : ∀ π : Equiv.Perm (Fin eta), sys.IsSpeciesPerm π → ∀ t ψ,
      U t (molecularPositionPermLp π ψ) = molecularPositionPermLp π (U t ψ) := by
    intro π hπ t ψ
    set P := molecularPositionPermLp (eta := eta) π
    -- on the domain, by uniqueness
    have hdom : ∀ f h, HasCoulombHamiltonian sys L f h → ∀ t, U t (P f) = P (U t f) := by
      intro f h hfh t
      have hsol := huniqU (fun s => P (U s f)) (fun s => P (U s h))
        (fun s => (hgraphU s f h hfh).permute hπ)
        (fun s => by
          have h1 := ((P.toContinuousLinearMap).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt s
            (hderivU s f h hfh)
          simp only [ContinuousLinearMap.coe_restrictScalars',
              LinearIsometry.coe_toContinuousLinearMap]
            at h1
          rw [map_neg, map_smul] at h1
          exact h1) t
      rw [hsol, (show U 0 f = f from by rw [hUapply]; simp [h0])]
    obtain ⟨f, hf, hlim⟩ := hdense ψ
    have hL1 : Tendsto (fun n => U t (P (f n))) atTop (𝓝 (U t (P ψ))) :=
      ((U t).continuous.tendsto _).comp ((P.continuous.tendsto ψ).comp hlim)
    have hR1 : Tendsto (fun n => P (U t (f n))) atTop (𝓝 (P (U t ψ))) :=
      (P.continuous.tendsto _).comp (((U t).continuous.tendsto ψ).comp hlim)
    refine tendsto_nhds_unique hL1 (hR1.congr fun n => ?_)
    obtain ⟨h, hfh⟩ := hf n
    exact (hdom (f n) h hfh t).symm
  refine ⟨U, fun ψ => ?_, fun s t ψ => ?_, fun ψ => ?_, hgraphU, hderivU, huniqU, hperm, ?_⟩
  · rw [hUapply, h0, LinearIsometryEquiv.apply_symm_apply]
  · rw [hUapply, hUapply, hUapply, LinearIsometryEquiv.symm_apply_apply, hadd]
  · exact Φ.continuous.comp (hcont _)
  · intro sgn lab hlab t ψ hψ i j hij hl
    have hsp : sys.IsSpeciesPerm (Equiv.swap i j) := by
      intro a
      by_cases hai : a = i
      · subst hai
        rw [Equiv.swap_apply_left]
        exact (hlab a j hl).symm
      · by_cases haj : a = j
        · subst haj
          rw [Equiv.swap_apply_right]
          exact hlab i a hl
        · rw [Equiv.swap_apply_of_ne_of_ne hai haj]
    have h1 := (molecularPositionSwapLp_eq_smul_iff i j (sgn i) ψ).mpr (hψ i j hij hl)
    apply (molecularPositionSwapLp_eq_smul_iff i j (sgn i) (U t ψ)).mp
    rw [← molecularPositionPermLp_swap, ← hperm _ hsp t ψ, molecularPositionPermLp_swap, h1,
      map_smul]

end Position

