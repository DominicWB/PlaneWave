/-! ## Ninety-fifth milestone: reduce each Hardy field coordinate to one variable -/

/-- The standard coordinate direction in the ambient copy of `R^3`. -/
noncomputable def hardyCoordinateDirection
    (j : Fin 3) : CenteredCube3Ambient :=
  Pi.single j 1

@[simp] lemma hardyCoordinateDirection_same
    (j : Fin 3) :
    hardyCoordinateDirection j j = 1 := by
  simp [hardyCoordinateDirection]

/-- Moving in the `j`-th coordinate direction is the same as updating only
that coordinate by `x_j + t`. -/
lemma add_smul_hardyCoordinateDirection_eq_update
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) :
    x + t • hardyCoordinateDirection j =
      Function.update x j (x j + t) := by
  classical
  funext i
  by_cases hij : i = j
  · subst i
    simp [hardyCoordinateDirection]
  · simp [hardyCoordinateDirection, hij]

/-- Along a coordinate line, the squared Euclidean radius is a scalar
quadratic polynomial. -/
lemma centeredCube3AmbientRadiusSq_add_coordinate
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) :
    centeredCube3AmbientRadiusSq
        (x + t • hardyCoordinateDirection j)
      =
    centeredCube3AmbientRadiusSq x + 2 * t * x j + t ^ 2 := by
  classical
  fin_cases j <;>
    simp [centeredCube3AmbientRadiusSq, hardyCoordinateDirection,
      Pi.single_apply, Fin.sum_univ_succ] <;>
    ring

/-- Hence the regularized denominator restricted to a coordinate line is
`d + 2 t x_j + t^2`, where `d = |x|^2 + eps^2`. -/
lemma hardyRegularizedDenominator_add_coordinate
    (eps : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) :
    hardyRegularizedDenominator eps
        (x + t • hardyCoordinateDirection j)
      =
    hardyRegularizedDenominator eps x + 2 * t * x j + t ^ 2 := by
  unfold hardyRegularizedDenominator
  rw [centeredCube3AmbientRadiusSq_add_coordinate]
  ring

/-- The `j`-th coordinate itself changes by exactly `t` along its coordinate
line. -/
@[simp] lemma add_smul_hardyCoordinateDirection_apply_same
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) :
    (x + t • hardyCoordinateDirection j) j = x j + t := by
  simp [hardyCoordinateDirection]

/-- The one-variable numerator occurring in a coordinate slice of the
regularized Hardy field. -/
noncomputable def hardyRegularizedCoordinateLineNumerator
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) : ℝ :=
  x j + t

/-- The one-variable denominator occurring in a coordinate slice of the
regularized Hardy field. -/
noncomputable def hardyRegularizedCoordinateLineDenominator
    (eps : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) : ℝ :=
  hardyRegularizedDenominator eps x + 2 * t * x j + t ^ 2

/-- The resulting scalar rational function on the coordinate line. -/
noncomputable def hardyRegularizedCoordinateLine
    (eps : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) : ℝ :=
  hardyRegularizedCoordinateLineNumerator x j t /
    hardyRegularizedCoordinateLineDenominator eps x j t

/-- Restricting the ambient field component to the line `x + t e_j` is
literally the scalar rational function defined above. -/
lemma hardyRegularizedFieldComponent_coordinateLine
    (eps : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ) :
    hardyRegularizedFieldComponent eps j
        (x + t • hardyCoordinateDirection j)
      =
    hardyRegularizedCoordinateLine eps x j t := by
  unfold hardyRegularizedFieldComponent
  unfold hardyRegularizedCoordinateLine
  unfold hardyRegularizedCoordinateLineNumerator
  unfold hardyRegularizedCoordinateLineDenominator
  rw [hardyRegularizedDenominator_add_coordinate]
  simp [hardyCoordinateDirection]

/-- At `t = 0`, the scalar line recovers the original field component. -/
@[simp] lemma hardyRegularizedCoordinateLine_zero
    (eps : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    hardyRegularizedCoordinateLine eps x j 0 =
      hardyRegularizedFieldComponent eps j x := by
  unfold hardyRegularizedCoordinateLine
  unfold hardyRegularizedCoordinateLineNumerator
  unfold hardyRegularizedCoordinateLineDenominator
  unfold hardyRegularizedFieldComponent
  simp

/-- The candidate coordinate derivative from milestone 94 is exactly the
quotient-rule scalar expression at the base point. -/
lemma hardyRegularizedCoordinateDivergence_as_line_derivative_value
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    hardyRegularizedCoordinateDivergence eps j x =
      (hardyRegularizedDenominator eps x - 2 * (x j) ^ 2) /
        (hardyRegularizedDenominator eps x) ^ 2 := by
  rfl

/-!
## Ninety-fifth milestone

Every coordinate derivative of the regularized Hardy field has now been
reduced to an ordinary one-variable derivative.  Along the line `x + t e_j`,
Lean proves

`F_j(x + t e_j) = (x_j + t) / (d + 2 t x_j + t^2)`,

where `d = |x|^2 + eps^2`.  Thus no multivariable differential geometry remains
in the field derivative calculation.  The next milestone can apply the ordinary
`HasDerivAt` quotient rule at `t = 0` and transport that result back to
`HasLineDerivAt` for the ambient vector field.
-/

end

end PlaneWaveCertificate

