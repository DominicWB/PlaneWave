    (C : ℝ) (q p : FourierConfig eta Lattice3) : ℂ := by
  classical
  exact if (∀ k : Fin eta, k ≠ i → k ≠ j → q k = p k) ∧
      q i + q j = p i + p j then latticeCoulombKernel C (q i) (p i) else 0

