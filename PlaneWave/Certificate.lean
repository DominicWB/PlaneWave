noncomputable section

/-- The physical H2 weight on the full many-particle reciprocal lattice. -/
def molecularFourierH2Weight (eta : ℕ) (g : ℝ)
    (p : FourierConfig eta Lattice3) : ℝ :=
  1 + ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i)

lemma molecularFourierH2Weight_ge_one (eta : ℕ) (g : ℝ)
    (p : FourierConfig eta Lattice3) : 1 ≤ molecularFourierH2Weight eta g p := by
  have hSum : 0 ≤ ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) :=
    Finset.sum_nonneg (fun i _ => mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg (p i)))
  unfold molecularFourierH2Weight
  linarith only [hSum]

lemma molecularFourierH2Weight_pos (eta : ℕ) (g : ℝ)
    (p : FourierConfig eta Lattice3) : 0 < molecularFourierH2Weight eta g p :=
  lt_of_lt_of_le zero_lt_one (molecularFourierH2Weight_ge_one eta g p)

/-- Exact agreement with the H2 weight already used in every finite estimate. -/
lemma molecularFourierH2Weight_finite (eta : ℕ) (g : ℝ) (count : ℕ)
    (p : FourierConfig eta (FinitePlaneWaveMode count)) :
    molecularFourierH2Weight eta g (finiteConfigLatticeIndex eta count p) =
      1 + boKineticSymbol (finitePlaneWaveKabs g count) p := by
  unfold molecularFourierH2Weight boKineticSymbol finiteConfigLatticeIndex
  congr 1
  apply Finset.sum_congr rfl
  intro i _hi
  exact (finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq g count (p i)).symm

/-- Weighted coordinates: u(p) represents (1+|k|^2) times the physical Fourier
coefficient. Thus the ordinary lp2 norm here is the H2 coefficient norm. -/
abbrev MolecularFourierH2 (eta : ℕ) := lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2

def molecularH2Coeff {eta : ℕ} (g : ℝ) (u : MolecularFourierH2 eta)
    (p : FourierConfig eta Lattice3) : ℂ :=
  u p / (molecularFourierH2Weight eta g p : ℂ)

lemma molecularH2Coeff_weight_mul {eta : ℕ} (g : ℝ) (u : MolecularFourierH2 eta)
    (p : FourierConfig eta Lattice3) :
    (molecularFourierH2Weight eta g p : ℂ) * molecularH2Coeff g u p = u p := by
  have hw : (molecularFourierH2Weight eta g p : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt (molecularFourierH2Weight_pos eta g p))
  unfold molecularH2Coeff
  field_simp [hw]

lemma molecularH2Coeff_weight_mass {eta : ℕ} (g : ℝ) (u : MolecularFourierH2 eta)
    (p : FourierConfig eta Lattice3) :
    (molecularFourierH2Weight eta g p) ^ 2 * ‖molecularH2Coeff g u p‖ ^ 2 = ‖u p‖ ^ 2 := by
  have h := congrArg norm (molecularH2Coeff_weight_mul g u p)
  rw [norm_mul, Complex.norm_of_nonneg (molecularFourierH2Weight_pos eta g p).le] at h
  calc
    (molecularFourierH2Weight eta g p) ^ 2 * ‖molecularH2Coeff g u p‖ ^ 2 =
        (molecularFourierH2Weight eta g p * ‖molecularH2Coeff g u p‖) ^ 2 := by ring
    _ = ‖u p‖ ^ 2 := congrArg (fun x : ℝ => x ^ 2) h

/-- The actual cubic truncation in weighted H2 coordinates. -/
def molecularH2Truncate {eta : ℕ} (count : ℕ) (u : MolecularFourierH2 eta) :
    MolecularFourierH2 eta :=
  lpTruncate (fourierConfigCube eta count) u

@[simp] lemma molecularH2Truncate_apply {eta : ℕ} (count : ℕ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    molecularH2Truncate count u p = cubicLatticeCoeffTruncate count (fun q => u q) p := by
  classical
  exact lpTruncate_apply (fourierConfigCube eta count) u p

/-- Cubic Fourier polynomials converge in the physical H2 coefficient norm. -/
theorem molecularH2Truncate_tendsto {eta : ℕ} (u : MolecularFourierH2 eta) :
    Tendsto (fun count => molecularH2Truncate count u) atTop (𝓝 u) := by
  exact lp_norm_truncation_tendsto (fourierConfigCube eta) (fourierConfigCube_mono eta)
    (fun p => exists_mem_fourierConfigCube p) u

lemma molecularH2Truncate_norm_le {eta : ℕ} (count : ℕ) (u : MolecularFourierH2 eta) :
    ‖molecularH2Truncate count u‖ ≤ ‖u‖ :=
  lpTruncate_norm_le (fourierConfigCube eta count) u

/-- Decoding commutes with truncation, so these are actual Fourier cutoffs. -/
lemma molecularH2Coeff_truncate {eta : ℕ} (g : ℝ) (count : ℕ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    molecularH2Coeff g (molecularH2Truncate count u) p =
      cubicLatticeCoeffTruncate count (molecularH2Coeff g u) p := by
  classical
  change molecularH2Truncate count u p / (molecularFourierH2Weight eta g p : ℂ) = _
  rw [molecularH2Truncate_apply]
  by_cases hp : p ∈ fourierConfigCube eta count
  · rw [cubicLatticeCoeffTruncate_eq_of_mem count _ p hp,
      cubicLatticeCoeffTruncate_eq_of_mem count _ p hp]
    rfl
  · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem count _ p hp,
      cubicLatticeCoeffTruncate_eq_zero_of_not_mem count _ p hp, zero_div]

/-- Exact comparison of the finite H2 quantity with the norm of the infinite
weighted-coordinate truncation. This links the new space to the proved physical
finite estimates without postulating a Sobolev bound. -/
lemma fullH2Sq_extract_eq_truncation_norm_sq {eta : ℕ} (g : ℝ) (count : ℕ)
    (u : MolecularFourierH2 eta) :
    fullH2Sq (finitePlaneWaveKabs g count)
      (finiteFourierCoeffExtract count (molecularH2Coeff g u)) =
      ‖molecularH2Truncate count u‖ ^ 2 := by
  classical
  unfold fullH2Sq coeffMass
  have hSum :
      (∑ p : FourierConfig eta (FinitePlaneWaveMode count),
        (1 + boKineticSymbol (finitePlaneWaveKabs g count) p) ^ 2 *
          ‖finiteFourierCoeffExtract count (molecularH2Coeff g u) p‖ ^ 2) =
      ∑ p : FourierConfig eta (FinitePlaneWaveMode count),
        ‖u (finiteConfigLatticeIndex eta count p)‖ ^ 2 := by
    apply Finset.sum_congr rfl
    intro p _hp
    rw [← molecularFourierH2Weight_finite]
    exact molecularH2Coeff_weight_mass g u (finiteConfigLatticeIndex eta count p)
  rw [hSum]
  change _ = ‖lpTruncate (fourierConfigCube eta count) u‖ ^ 2
  rw [lpTruncate_norm_sq]
  symm
  change (∑ p ∈ Finset.univ.image (finiteConfigLatticeIndex eta count), ‖u p‖ ^ 2) = _
  apply Finset.sum_image
  intro p _hp q _hq hpq
  exact finiteConfigLatticeIndex_injective eta count hpq

lemma sqrt_fullH2Sq_extract_le_norm {eta : ℕ} (g : ℝ) (count : ℕ)
    (u : MolecularFourierH2 eta) :
    Real.sqrt (fullH2Sq (finitePlaneWaveKabs g count)
      (finiteFourierCoeffExtract count (molecularH2Coeff g u))) ≤ ‖u‖ := by
  rw [fullH2Sq_extract_eq_truncation_norm_sq, Real.sqrt_sq_eq_abs,
    abs_of_nonneg (norm_nonneg _)]
  exact molecularH2Truncate_norm_le count u

end
end PlaneWaveCertificate

namespace PlaneWaveCertificate

open scoped Topology
open Filter

noncomputable section

lemma molecularH2_inverse_weight_norm_le_one (eta : ℕ) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    ‖(molecularFourierH2Weight eta g p : ℂ)⁻¹‖ ≤ 1 := by
  have hw := molecularFourierH2Weight_pos eta g p
  rw [norm_inv, Complex.norm_of_nonneg hw.le, inv_eq_one_div]
  apply (div_le_iff₀ hw).mpr
  simpa only [one_mul] using molecularFourierH2Weight_ge_one eta g p

/-- Concrete reconstruction of ordinary square-summable Fourier coefficients
from weighted H2 coordinates. It is a contraction, proved without a synthesis
or state-convergence assumption. -/
def molecularH2StateMap (eta : ℕ) (g : ℝ) :
    MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  lp2DiagonalCLM (fun p => (molecularFourierH2Weight eta g p : ℂ)⁻¹)
    (molecularH2_inverse_weight_norm_le_one eta g)

@[simp] lemma molecularH2StateMap_apply {eta : ℕ} (g : ℝ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    molecularH2StateMap eta g u p = molecularH2Coeff g u p := by
  rw [molecularH2StateMap, lp2DiagonalCLM_apply]
