include hKernel hL hPeriodic in
/-- **The secular term** (`eq:secular`). With the tails `t_a = ‖1_{a,>K} S u‖` and
`τ_a = ‖1_{a,>K} T u‖` at `K = g n`,
`‖W (1 - P) u‖² ≤ C² (Σ_a t_a) (Σ_a (t_a + 2 τ_a))`. -/
theorem potential_tail_sq_le (n : ℕ) (u : MolecularFourierH2 eta) :
    ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H (u - molecularH2Truncate n u)‖ ^ 2 ≤
      finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 *
        ((∑ a : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a
            (molecularH2StateMap eta (2 * Real.pi / L) u)‖) *
          (∑ a : Fin eta, (‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a
            (molecularH2StateMap eta (2 * Real.pi / L) u)‖ +
            2 * ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a
              (coulombFourierKineticH2 sys (2 * Real.pi / L) u)‖))) := by
  set g := 2 * Real.pi / L
  have hg : 0 < g := by positivity
  set x := u - molecularH2Truncate n u
  set S := molecularH2StateMap eta g
  set T := coulombFourierKineticH2 sys g
  have h1 := potential_sq_le_h1 sys L H hKernel Hunit hL hPeriodic x
  have h2 := tsum_h1f_le sys L x
  have hSx : S x = S u - molecularH2Truncate n (S u) := by
    change molecularH2StateMap eta g (u - molecularH2Truncate n u) =
      molecularH2StateMap eta g u - molecularH2Truncate n (molecularH2StateMap eta g u)
    rw [map_sub, stateMap_truncate]
  have hTx : T x = T u - molecularH2Truncate n (T u) := by
    change coulombFourierKineticH2 sys g (u - molecularH2Truncate n u) =
      coulombFourierKineticH2 sys g u - molecularH2Truncate n (coulombFourierKineticH2 sys g u)
    rw [map_sub, kinetic_truncate]
  have hA : ‖S x‖ ≤ ∑ a : Fin eta, ‖tailMask g (g * n) a (S u)‖ := by
    rw [hSx]
    exact norm_sub_truncate_le hg n (S u)
  have hB : ‖S x + (2 : ℂ) • T x‖ ≤ ∑ a : Fin eta, (‖tailMask g (g * n) a (S u)‖ +
      2 * ‖tailMask g (g * n) a (T u)‖) := by
    refine (norm_add_le _ _).trans ?_
    rw [norm_smul, Finset.sum_add_distrib, ← Finset.mul_sum]
    have hT' : ‖T x‖ ≤ ∑ a : Fin eta, ‖tailMask g (g * n) a (T u)‖ := by
      rw [hTx]
      exact norm_sub_truncate_le hg n (T u)
    have : ‖(2 : ℂ)‖ = 2 := by norm_num
    rw [this]
    linarith
  have hC := sq_nonneg (finiteCoulombPhysicalMassConstant sys L Hunit)
  calc _ ≤ finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 * ∑' p, h1f sys L x p := h1
    _ ≤ finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 * (‖S x‖ * ‖S x + (2 : ℂ) • T x‖) :=
        mul_le_mul_of_nonneg_left h2 hC
    _ ≤ _ := by
        apply mul_le_mul_of_nonneg_left _ hC
        exact mul_le_mul hA hB (norm_nonneg _) (Finset.sum_nonneg fun a _ => norm_nonneg _)

include hKernel hL hPeriodic in
/-- The register tails of the evolved state and of its kinetic energy, at one time:
`τ_a ≤ B` and `t_a ≤ (2m̄/K²) B` with `B = (2m̄/K²) Ξ₁ + C_tail(M₂) K^{-1/2}`. -/
theorem tails_at_time (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (a : Fin eta) (K rho Blow Cs Bker : ℝ) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (t : ℝ) (u : MolecularFourierH2 eta)
    (hu1 : molecularH2StateMap eta (2 * Real.pi / L) u =
      U t (molecularH2StateMap eta (2 * Real.pi / L) u₀))
    (hu2 : H u = U t (H u₀)) :
    let B := (2 * sys.maxMass / K ^ 2) * (2 * ‖H v₀‖ + 2 * relB sys L Hunit *
            ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖) +
          finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
            (sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ +
              2 * (2 * ‖H u₀‖ + 2 * relB sys L Hunit *
                ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖))) * rho
    ‖tailMask (2 * Real.pi / L) K a (coulombFourierKineticH2 sys (2 * Real.pi / L) u)‖ ≤ B ∧
      ‖tailMask (2 * Real.pi / L) K a (molecularH2StateMap eta (2 * Real.pi / L) u)‖ ≤
        (2 * sys.maxMass / K ^ 2) * B := by
  intro B
  set g := 2 * Real.pi / L
  set S := molecularH2StateMap eta g
  set T := coulombFourierKineticH2 sys g
  set b := relB sys L Hunit
  have hM := sys.one_le_maxMass
  have hK : 0 < K := by linarith
  have hb := relB_nonneg sys L Hunit hC
  obtain ⟨v, hv1, hv2⟩ := hgraph t v₀
  have huv' : H u = S v := by rw [hu2, huv, hv1]
  have hTu : ‖T u‖ ≤ 2 * ‖H u₀‖ + 2 * b * ‖S u₀‖ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u
    rwa [hu1, hu2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
  have hTv : ‖T v‖ ≤ 2 * ‖H v₀‖ + 2 * b * ‖S v₀‖ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC v
    rwa [hv1, hv2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
  have hu_le : ‖u‖ ≤ sys.maxMass * (‖S u₀‖ + 2 * (2 * ‖H u₀‖ + 2 * b * ‖S u₀‖)) := by
    have h := h2norm_le sys L u
    rw [hu1, LinearIsometryEquiv.norm_map] at h
    refine h.trans (mul_le_mul_of_nonneg_left ?_ (by linarith))
    linarith
  set M2 := sys.maxMass * (‖S u₀‖ + 2 * (2 * ‖H u₀‖ + 2 * b * ‖S u₀‖))
  have hM2 : 0 ≤ M2 := (norm_nonneg u).trans hu_le
  have hkin := tail_kinetic_le sys L H hKernel Hunit hL hPeriodic a K rho Blow Cs Bker M2 hK1 hRho
    hRhoScale hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale u v hu_le huv'
  have hkinB : ‖tailMask g K a (T u)‖ ≤ B := by
    refine hkin.trans ?_
    simp only [B]
    gcongr
  exact ⟨hkinB, (tail_stateMap_le sys L hK a u).trans
    (mul_le_mul_of_nonneg_left hkinB (by positivity))⟩

omit [Fintype ν] in
lemma norm_extractCLM_le (n : ℕ) (y : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖extractCLM n y‖ ≤ ‖y‖ := by
  have h := (extractCLM (eta := eta) n).le_opNorm y
  have h1 : ‖extractCLM (eta := eta) n‖ ≤ 1 := LinearMap.mkContinuous_norm_le _ zero_le_one _
  calc ‖extractCLM n y‖ ≤ ‖extractCLM (eta := eta) n‖ * ‖y‖ := h
    _ ≤ 1 * ‖y‖ := mul_le_mul_of_nonneg_right h1 (norm_nonneg _)
    _ = ‖y‖ := one_mul _

include hKernel hL hPeriodic in
/-- **Norm-level error** (`prop:duhamel`, `eq:secular` and the Galerkin part of
`eq:normlevel`). For `ψ₀ = S u₀ ∈ D(H²)` and the cube of radius `n` (`K = g n`), the Galerkin
error inside the cube is at most `t · C √((η_tot t_K)(η_tot (t_K + 2B)))` (`η_tot = eta` particles),
where `B` bounds the kinetic
tails and `t_K = (2m̄/K²) B` the state tails, uniformly in time; this is `O(t K^{-3/2})`. -/
theorem coulomb_normlevel (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK1 : 1 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let B := (2 * sys.maxMass / K ^ 2) * (2 * ‖H v₀‖ + 2 * relB sys L Hunit *
            ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖) +
          finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
            (sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ +
              2 * (2 * ‖H u₀‖ + 2 * relB sys L Hunit *
                ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖))) * rho
    let tK := (2 * sys.maxMass / K ^ 2) * B
    ‖extractCLM n (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) -
        UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀))‖ ≤
      finiteCoulombPhysicalMassConstant sys L Hunit *
        Real.sqrt ((eta * tK) * (eta * (tK + 2 * B))) * t := by
  intro K B tK
  have hM := sys.one_le_maxMass
  have hb := relB_nonneg sys L Hunit hC
  have hN2 : ∀ x y : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
      0 ≤ 2 * ‖x‖ + 2 * relB sys L Hunit * ‖y‖ := fun x y =>
    add_nonneg (mul_nonneg zero_le_two (norm_nonneg _))
      (mul_nonneg (mul_nonneg zero_le_two hb) (norm_nonneg _))
  have hM2 : 0 ≤ sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ +
      2 * (2 * ‖H u₀‖ + 2 * relB sys L Hunit * ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖)) :=
    mul_nonneg (by linarith) (add_nonneg (norm_nonneg _) (mul_nonneg zero_le_two (hN2 _ _)))
  have hB0 : 0 ≤ B := add_nonneg
    (mul_nonneg (div_nonneg (by linarith) (sq_nonneg _)) (hN2 _ _))
    (mul_nonneg (finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker hM2) hRho)
  have htK0 : 0 ≤ tK := mul_nonneg (div_nonneg (by linarith) (sq_nonneg _)) hB0
  refine coulomb_duhamel sys L H hKernel n U h0 hgraph hderiv UN hN0 hNadd hNcomm hNderiv u₀ ht
    (fun s _ u' hu' => ?_)
  -- the state at time `s`
  obtain ⟨u'', hu''1, hu''2⟩ := hgraph s u₀
  have hu'eq : u' = u'' := molecularH2StateMap_injective eta _ (hu'.trans hu''1.symm)
  subst hu'eq
  have htails := fun a => tails_at_time sys L H hKernel Hunit hL hPeriodic hC U
      hgraph a K rho Blow Cs
    Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude hBkerScale hCsScale u₀ v₀ huv s u' hu'
    hu''2
  -- the per-register tails, summed over the registers
  have hsum1 : ∑ a : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a
      (molecularH2StateMap eta (2 * Real.pi / L) u')‖ ≤ eta * tK := by
    calc _ ≤ ∑ _a : Fin eta, tK := Finset.sum_le_sum fun a _ => (htails a).2
      _ = eta * tK := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hsum2 : ∑ a : Fin eta, (‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a
      (molecularH2StateMap eta (2 * Real.pi / L) u')‖ + 2 * ‖tailMask (2 * Real.pi / L)
        ((2 * Real.pi / L) * n) a (coulombFourierKineticH2 sys (2 * Real.pi / L) u')‖) ≤
      eta * (tK + 2 * B) := by
    calc _ ≤ ∑ _a : Fin eta, (tK + 2 * B) := Finset.sum_le_sum fun a _ =>
          add_le_add (htails a).2 (mul_le_mul_of_nonneg_left (htails a).1 zero_le_two)
      _ = eta * (tK + 2 * B) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hX := (potential_tail_sq_le sys L H hKernel Hunit hL hPeriodic n u').trans
    (mul_le_mul_of_nonneg_left (mul_le_mul hsum1 hsum2
      (Finset.sum_nonneg fun a _ => add_nonneg (norm_nonneg _)
          (mul_nonneg zero_le_two (norm_nonneg _)))
      (mul_nonneg (Nat.cast_nonneg _) htK0)) (sq_nonneg _))
  calc _ ≤ ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H (u' - molecularH2Truncate n u')‖ :=
        norm_extractCLM_le n _
    _ ≤ Real.sqrt (finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 *
        ((eta * tK) * (eta * (tK + 2 * B)))) := Real.le_sqrt_of_sq_le hX
    _ = _ := by rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hC]

