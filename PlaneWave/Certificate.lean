/-! ## One-hundredth milestone: radial support lies strictly inside the cell -/

/-- Any ambient point with Euclidean radius strictly less than `1/2` belongs
to the half-open centered cube.  In fact every coordinate then lies strictly
between `-1/2` and `1/2`, so the half-open convention causes no boundary issue. -/
lemma centeredCube3Ambient_mem_of_radius_lt_half
    (x : CenteredCube3Ambient)
    (hRadius : centeredCube3AmbientRadius x < (1 / 2 : ℝ)) :
    x ∈ centeredCube3AmbientSet := by
  unfold centeredCube3AmbientSet
  intro i
  have hAbs :
      |x i| < (1 / 2 : ℝ) :=
    lt_of_le_of_lt
      (centeredCube3Ambient_abs_coord_le_radius x i)
      hRadius
  have hBounds :
      -(1 / 2 : ℝ) < x i ∧ x i < (1 / 2 : ℝ) := by
    exact (abs_lt).1 hAbs
  dsimp [centeredCube3Base]
  constructor
  · exact hBounds.1
  · linarith [hBounds.2]

/-- If the cutoff outer radius satisfies `R < 1/2`, every point strictly
inside the outer cutoff ball belongs to the centered cube. -/
lemma centeredCube3Ambient_mem_of_radius_lt_outer
    {R : ℝ}
    (hOuterHalf : R < (1 / 2 : ℝ))
    (x : CenteredCube3Ambient)
    (hRadius : centeredCube3AmbientRadius x < R) :
    x ∈ centeredCube3AmbientSet := by
  exact
    centeredCube3Ambient_mem_of_radius_lt_half x
      (lt_trans hRadius hOuterHalf)

/-- The corresponding centered-cube subtype representative for a point in the
strict outer ball. -/
noncomputable def centeredCube3OfRadiusLtOuter
    {R : ℝ}
    (hOuterHalf : R < (1 / 2 : ℝ))
    (x : CenteredCube3Ambient)
    (hRadius : centeredCube3AmbientRadius x < R) :
    CenteredCube3 :=
  ⟨x, by
    have hx :
        x ∈ centeredCube3AmbientSet :=
      centeredCube3Ambient_mem_of_radius_lt_outer hOuterHalf x hRadius
    simpa [centeredCube3AmbientSet] using hx⟩

@[simp] lemma centeredCube3OfRadiusLtOuter_val
    {R : ℝ}
    (hOuterHalf : R < (1 / 2 : ℝ))
    (x : CenteredCube3Ambient)
    (hRadius : centeredCube3AmbientRadius x < R) :
    (centeredCube3OfRadiusLtOuter hOuterHalf x hRadius).1 = x := by
  rfl

/-- Away from the finite radial exceptional set, the coordinate line is not on
the inner cutoff sphere. -/
lemma hardyRadialSlice_radius_ne_rho_of_not_mem
    (rho R : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ)
    (ht : t ∉ hardyRadialSliceExceptionalSet rho R x j) :
    centeredCube3AmbientRadius
        (x + t • hardyCoordinateDirection j) ≠ rho := by
  intro hEq
  exact
    ht
      (mem_hardyRadialSliceExceptionalSet_of_radius_eq_rho
        rho R x j t hEq)

/-- Away from the finite radial exceptional set, the coordinate line is not on
the outer cutoff sphere. -/
lemma hardyRadialSlice_radius_ne_outer_of_not_mem
    (rho R : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ)
    (ht : t ∉ hardyRadialSliceExceptionalSet rho R x j) :
    centeredCube3AmbientRadius
        (x + t • hardyCoordinateDirection j) ≠ R := by
  intro hEq
  exact
    ht
      (mem_hardyRadialSliceExceptionalSet_of_radius_eq_outer
        rho R x j t hEq)

/-!
## One-hundredth milestone

The zero extension introduces no additional one-dimensional exceptional points
for the Hardy cutoff.  The manuscript hypothesis `R < 1/2` implies that the
entire strict support ball `|x| < R` lies strictly inside the centered
fundamental cube.  Hence:

* inside `|x| < R`, the ambient zero extension is exactly the original
  centered-cube cutoff wave (and likewise for the explicit raw gradient);
* outside `|x| >= R`, milestone 99 already proves both zero extensions vanish;
* away from the finite radial crossing set, every coordinate parameter lies
  strictly in one of the three smooth branches `r < rho`, `rho < r < R`, or
  `R < r`.

Thus there is no separate cube-face contribution to the weak derivative.  The
next milestone can prove the ordinary one-dimensional derivative on each of
these three open branches and combine them into a derivative-away-from-the-
finite-exceptional-set statement.
-/

end

end PlaneWaveCertificate

