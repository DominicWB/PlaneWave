-- BEGIN RELEASE SOURCE 150a: relabelling within species and symmetrization
section ReleaseMilestone150a

/-!
# Milestone 150a: relabelling within species, fermionic signs and symmetrization

The Hamiltonian of a Coulomb system commutes with every relabelling of the particles that
maps each particle to one of the same species. On the exchange sector of an admissible
labelling, a relabelling that preserves the labels acts by its fermionic sign: the sign of
the permutation it induces on the fermions. A state in the sector of a valid spin pattern
symmetrizes, over the rearrangements of the pattern within species, to a spin state of the
Coulomb system: exchanging the positions and spins of two particles of one species
multiplies it by the exchange sign of the species, and it vanishes when a spin value is at
or above the multiplicity of its species.
-/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped BigOperators

noncomputable section

local instance unitAddCircleMeasureSpaceForCoulombSpin :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-! ## Relabelling within species -/

lemma perm_apply_inv_self {α : Type*} (π : Equiv.Perm α) (x : α) : π (π⁻¹ x) = x :=
  π.apply_symm_apply x

namespace CoulombParticles

variable {eta : ℕ} (P : CoulombParticles eta)

/-- A relabelling of the particles that maps every particle to one of the same species. -/
def IsSpeciesPerm (π : Equiv.Perm (Fin eta)) : Prop :=
  ∀ a, P.species (π a) = P.species a

lemma isSpeciesPerm_one : P.IsSpeciesPerm 1 := fun _ => rfl

variable {P}

lemma IsSpeciesPerm.mul {π ρ : Equiv.Perm (Fin eta)} (hπ : P.IsSpeciesPerm π)
    (hρ : P.IsSpeciesPerm ρ) : P.IsSpeciesPerm (π * ρ) := by
  intro a
  rw [Equiv.Perm.mul_apply, hπ, hρ]

lemma IsSpeciesPerm.inv {π : Equiv.Perm (Fin eta)} (hπ : P.IsSpeciesPerm π) :
    P.IsSpeciesPerm π⁻¹ := by
  intro a
  have h := hπ (π⁻¹ a)
  rw [perm_apply_inv_self] at h
  exact h.symm

lemma IsSpeciesPerm.mass {π : Equiv.Perm (Fin eta)} (hπ : P.IsSpeciesPerm π) (a : Fin eta) :
    P.mass (π a) = P.mass a :=
  P.mass_eq _ _ (hπ a)

lemma IsSpeciesPerm.charge {π : Equiv.Perm (Fin eta)} (hπ : P.IsSpeciesPerm π)
    (a : Fin eta) : P.charge (π a) = P.charge a :=
  P.charge_eq _ _ (hπ a)

lemma IsSpeciesPerm.isFermion_iff {π : Equiv.Perm (Fin eta)} (hπ : P.IsSpeciesPerm π)
    (a : Fin eta) : P.IsFermion (π a) ↔ P.IsFermion a := by
  unfold IsFermion
  rw [hπ a]

variable (P)

lemma isSpeciesPerm_swap {i j : Fin eta} (h : P.species i = P.species j) :
    P.IsSpeciesPerm (Equiv.swap i j) := by
  intro a
  rw [Equiv.swap_apply_def]
  split_ifs with h1 h2
  · subst h1
    exact h.symm
  · subst h2
    exact h
  · rfl

/-! ## The fermionic sign -/

/-- The sign of the permutation that a relabelling induces on the fermions; `1` for a
relabelling that does not map the fermions onto themselves. -/
def fermionSign (π : Equiv.Perm (Fin eta)) : ℤˣ :=
  if h : ∀ a, (P.IsFermion (π a) ↔ P.IsFermion a) then
    Equiv.Perm.sign (Equiv.Perm.subtypePerm (p := P.IsFermion) π h)
  else 1

lemma fermionSign_eq {π : Equiv.Perm (Fin eta)}
    (h : ∀ a, (P.IsFermion (π a) ↔ P.IsFermion a)) :
    P.fermionSign π = Equiv.Perm.sign (Equiv.Perm.subtypePerm (p := P.IsFermion) π h) := by
  unfold fermionSign
  rw [dif_pos h]

lemma fermionSign_one : P.fermionSign 1 = 1 := by
  rw [P.fermionSign_eq P.isSpeciesPerm_one.isFermion_iff]
  have h1 : Equiv.Perm.subtypePerm (p := P.IsFermion) (1 : Equiv.Perm (Fin eta))
      P.isSpeciesPerm_one.isFermion_iff = 1 := Equiv.Perm.subtypePerm_one _ _
  rw [h1, Equiv.Perm.sign_one]

/-- The fermionic sign is multiplicative on relabellings within species. -/
lemma fermionSign_mul {π ρ : Equiv.Perm (Fin eta)} (hπ : P.IsSpeciesPerm π)
    (hρ : P.IsSpeciesPerm ρ) :
    P.fermionSign (π * ρ) = P.fermionSign π * P.fermionSign ρ := by
  rw [P.fermionSign_eq hπ.isFermion_iff, P.fermionSign_eq hρ.isFermion_iff,
    P.fermionSign_eq (hπ.mul hρ).isFermion_iff, ← Equiv.Perm.sign_mul,
    Equiv.Perm.subtypePerm_mul]

lemma fermionSign_inv {π : Equiv.Perm (Fin eta)} (hπ : P.IsSpeciesPerm π) :
    P.fermionSign π⁻¹ = P.fermionSign π := by
  have h := P.fermionSign_mul hπ.inv hπ
  rw [inv_mul_cancel, P.fermionSign_one] at h
  calc P.fermionSign π⁻¹ = P.fermionSign π⁻¹ * (P.fermionSign π * P.fermionSign π) := by
        rw [Int.units_mul_self, mul_one]
    _ = (P.fermionSign π⁻¹ * P.fermionSign π) * P.fermionSign π := by rw [mul_assoc]
    _ = P.fermionSign π := by rw [← h, one_mul]

/-- The exchange of two particles of one species has the exchange sign of the species. -/
lemma fermionSign_swap {i j : Fin eta} (hij : i ≠ j) (h : P.species i = P.species j) :
    (((P.fermionSign (Equiv.swap i j) : ℤˣ) : ℤ) : ℂ) = P.sign i := by
  have hsp := P.isSpeciesPerm_swap h
  have hiff : P.IsFermion i ↔ P.IsFermion j := by
    unfold IsFermion
    rw [h]
  rw [P.fermionSign_eq hsp.isFermion_iff, P.sign_eq_ite]
  by_cases hi : P.IsFermion i
  · have hj : P.IsFermion j := hiff.mp hi
    have h2 : ∀ x, Equiv.swap i j x ≠ x → P.IsFermion x := by
      intro x hx
      rcases eq_or_ne x i with rfl | hxi
      · exact hi
      rcases eq_or_ne x j with rfl | hxj
      · exact hj
      exact absurd (Equiv.swap_apply_of_ne_of_ne hxi hxj) hx
    rw [if_pos hi, Equiv.Perm.sign_subtypePerm _ _ h2, Equiv.Perm.sign_swap hij]
    simp
  · have hj : ¬ P.IsFermion j := fun hj => hi (hiff.mpr hj)
    have h1 : Equiv.Perm.subtypePerm (p := P.IsFermion) (Equiv.swap i j)
        hsp.isFermion_iff = 1 := by
      apply Equiv.ext
      intro x
      apply Subtype.ext
      have hxi : (x : Fin eta) ≠ i := fun hx => hi (hx ▸ x.2)
      have hxj : (x : Fin eta) ≠ j := fun hx => hj (hx ▸ x.2)
      simp only [Equiv.Perm.subtypePerm_apply, Equiv.Perm.one_apply]
      exact Equiv.swap_apply_of_ne_of_ne hxi hxj
    rw [if_neg hi, h1, Equiv.Perm.sign_one]
    simp

/-! ## Spin configurations of a Coulomb system -/

/-- A spin configuration is valid when the spin value of every particle is below the spin
multiplicity `dim s` of its species `s`. -/
def IsValidSpin {D : ℕ} (dim : ℕ → ℕ) (σ : Fin eta → Fin D) : Prop :=
  ∀ a, (σ a : ℕ) < dim (P.species a)

/-- The exchange-sector labelling of a spin configuration: two particles have equal labels
exactly when they are of the same species and have the same spin value. -/
def spinSectorLabel {D : ℕ} (σ : Fin eta → Fin D) : Fin eta → ℕ :=
  fun a => Nat.pair (P.species a) (σ a)

lemma spinSectorLabel_eq_iff {D : ℕ} (σ : Fin eta → Fin D) (i j : Fin eta) :
    P.spinSectorLabel σ i = P.spinSectorLabel σ j ↔
      P.species i = P.species j ∧ σ i = σ j := by
  unfold spinSectorLabel
  constructor
  · intro h
    have h' := congrArg Nat.unpair h
    simp only [Nat.unpair_pair, Prod.mk.injEq] at h'
    exact ⟨h'.1, Fin.ext h'.2⟩
  · rintro ⟨h1, h2⟩
    rw [h1, h2]

lemma spinSectorLabel_isAdmissible {D : ℕ} (σ : Fin eta → Fin D) :
    P.IsAdmissible (P.spinSectorLabel σ) :=
  fun i j h => ((P.spinSectorLabel_eq_iff σ i j).mp h).1

/-- The number of rearrangements of a spin configuration within species. -/
def spinOrbitCount {D : ℕ} (σ₀ : Fin eta → Fin D) : ℕ := by
  classical
  exact (Finset.univ.filter (fun σ : Fin eta → Fin D =>
    ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀)).card

lemma spinOrbitCount_pos {D : ℕ} (σ₀ : Fin eta → Fin D) : 0 < P.spinOrbitCount σ₀ := by
  classical
  unfold spinOrbitCount
  apply Finset.card_pos.mpr
  refine ⟨σ₀, ?_⟩
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨1, P.isSpeciesPerm_one, rfl⟩

end CoulombParticles

lemma comp_swap_of_eq {eta : ℕ} {α : Type*} (σ : Fin eta → α) {i j : Fin eta}
    (h : σ i = σ j) : σ ∘ Equiv.swap i j = σ := by
  funext k
  simp only [Function.comp_apply]
  rcases eq_or_ne k i with hki | hki
  · rw [hki, Equiv.swap_apply_left, h]
  · rcases eq_or_ne k j with hkj | hkj
    · rw [hkj, Equiv.swap_apply_right, h]
    · rw [Equiv.swap_apply_of_ne_of_ne hki hkj]

/-- A componentwise lower bound gives the lower bound for a state with finitely many
components. -/
theorem pi_lower_bound_of_components {ι : Type*} [Fintype ι] {V : Type*}
    [NormedAddCommGroup V] [InnerProductSpace ℂ V] (E₀ : ℝ) (F G : PiLp 2 (fun _ : ι => V))
    (hcomp : ∀ σ, E₀ * ‖F σ‖ ^ 2 ≤ (inner ℂ (F σ) (G σ)).re) :
    E₀ * ‖F‖ ^ 2 ≤ (inner ℂ F G).re := by
  rw [PiLp.norm_sq_eq_of_L2, PiLp.inner_apply, Complex.re_sum, Finset.mul_sum]
  exact Finset.sum_le_sum fun σ _ => hcomp σ

/-! ## Signed sectors and spin states in a relabelling representation -/

namespace ParticleRelabelling

variable {eta : ℕ} {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]

/-- The exchange sector of the labelling `lab` with exchange signs `sgn`: exchanging two
particles with equal labels multiplies the state by the sign of the particle. -/
def IsSignedSector (R : ParticleRelabelling eta V) (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ)
    (v : V) : Prop :=
  ∀ i j : Fin eta, i ≠ j → lab i = lab j → R.act (Equiv.swap i j) v = sgn i • v

/-- On the sector of an admissible labelling, a label-preserving relabelling acts by its
fermionic sign. The proof decomposes it into exchanges of particles with equal labels. -/
theorem act_eq_fermionSign_of_isSignedSector {R : ParticleRelabelling eta V}
    {P : CoulombParticles eta} {lab : Fin eta → ℕ} (hlab : P.IsAdmissible lab) {v : V}
    (hv : R.IsSignedSector P.sign lab v) (κ : Equiv.Perm (Fin eta))
    (hκ : ∀ k, lab (κ k) = lab k) :
    R.act κ v = (((P.fermionSign κ : ℤˣ) : ℤ) : ℂ) • v := by
  classical
  suffices H : ∀ n (κ : Equiv.Perm (Fin eta)), κ.support.card = n →
      (∀ k, lab (κ k) = lab k) →
      R.act κ v = (((P.fermionSign κ : ℤˣ) : ℤ) : ℂ) • v from
    H _ κ rfl hκ
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro κ hn hκ
    by_cases h1 : κ = 1
    · subst h1
      rw [R.act_one, P.fermionSign_one]
      simp
    · obtain ⟨x, hx⟩ : ∃ x, κ x ≠ x := by
        by_contra hcon
        apply h1
        apply Equiv.ext
        intro x
        by_contra hx
        exact hcon ⟨x, hx⟩
      have hlabx : lab x = lab (κ x) := (hκ x).symm
      have hspx : P.species x = P.species (κ x) := hlab x (κ x) hlabx
      have hτ : R.act (Equiv.swap x (κ x)) v = P.sign x • v :=
        hv x (κ x) (Ne.symm hx) hlabx
      have hτlab : ∀ k, lab (Equiv.swap x (κ x) k) = lab k := by
        intro k
        rcases eq_or_ne k x with rfl | hkx
        · rw [Equiv.swap_apply_left]
          exact hlabx.symm
        · rcases eq_or_ne k (κ x) with rfl | hkk
          · rw [Equiv.swap_apply_right]
            exact hlabx
          · rw [Equiv.swap_apply_of_ne_of_ne hkx hkk]
      have hρlab : ∀ k, lab ((Equiv.swap x (κ x) * κ) k) = lab k := by
        intro k
        rw [Equiv.Perm.mul_apply, hτlab, hκ]
      have hcard : (Equiv.swap x (κ x) * κ).support.card < n :=
        hn ▸ Equiv.Perm.card_support_swap_mul hx
      have ih' := ih _ hcard (Equiv.swap x (κ x) * κ) rfl hρlab
      have hκeq : κ = Equiv.swap x (κ x) * (Equiv.swap x (κ x) * κ) := by
        rw [← mul_assoc, Equiv.swap_mul_self, one_mul]
      have hτsp : P.IsSpeciesPerm (Equiv.swap x (κ x)) := P.isSpeciesPerm_swap hspx
      have hκsp : P.IsSpeciesPerm κ := fun k => hlab _ _ (hκ k)
      have hρsp : P.IsSpeciesPerm (Equiv.swap x (κ x) * κ) := hτsp.mul hκsp
      have hsign : P.fermionSign κ =
          P.fermionSign (Equiv.swap x (κ x)) * P.fermionSign (Equiv.swap x (κ x) * κ) := by
        conv_lhs => rw [hκeq]
        exact P.fermionSign_mul hτsp hρsp
      have hτsign := P.fermionSign_swap (Ne.symm hx) hspx
      calc R.act κ v
          = R.act (Equiv.swap x (κ x) * (Equiv.swap x (κ x) * κ)) v := by
            rw [← hκeq]
        _ = R.act (Equiv.swap x (κ x)) (R.act (Equiv.swap x (κ x) * κ) v) :=
            (R.act_mul _ _ v).symm
        _ = (((P.fermionSign κ : ℤˣ) : ℤ) : ℂ) • v := by
            rw [ih', LinearIsometry.map_smul, hτ, smul_smul, hsign, Units.val_mul, Int.cast_mul,
              hτsign, mul_comm]

/-- Spin states of a Coulomb system with spin values in `Fin D` and spin multiplicity
`dim s` for the species `s`: exchanging the positions and spins of two particles of one
species multiplies the state by the exchange sign of the species, and the components with
a spin value at or above the multiplicity of its species vanish. -/
def IsCoulombSpinSector (R : ParticleRelabelling eta V) (P : CoulombParticles eta) {D : ℕ}
    (dim : ℕ → ℕ) (Ψ : PiLp 2 (fun _ : Fin eta → Fin D => V)) : Prop :=
  (∀ i j : Fin eta, i ≠ j → P.species i = P.species j → ∀ σ : Fin eta → Fin D,
    R.act (Equiv.swap i j) (Ψ (σ ∘ Equiv.swap i j)) = P.sign i • Ψ σ) ∧
  ∀ σ : Fin eta → Fin D, ∀ a : Fin eta, dim (P.species a) ≤ σ a → Ψ σ = 0

/-- Each component of a spin state lies in the exchange sector of its spin pattern. -/
theorem IsCoulombSpinSector.component {R : ParticleRelabelling eta V}
    {P : CoulombParticles eta} {D : ℕ} {dim : ℕ → ℕ}
    {Ψ : PiLp 2 (fun _ : Fin eta → Fin D => V)} (hΨ : R.IsCoulombSpinSector P dim Ψ)
    (σ : Fin eta → Fin D) : R.IsSignedSector P.sign (P.spinSectorLabel σ) (Ψ σ) := by
  intro i j hij hlab
  obtain ⟨hs, hσ⟩ := (P.spinSectorLabel_eq_iff σ i j).mp hlab
  have h := hΨ.1 i j hij hs σ
  rwa [comp_swap_of_eq σ hσ] at h

/-- The components of a spin state at invalid configurations vanish. -/
theorem IsCoulombSpinSector.eq_zero_of_not_valid {R : ParticleRelabelling eta V}
    {P : CoulombParticles eta} {D : ℕ} {dim : ℕ → ℕ}
    {Ψ : PiLp 2 (fun _ : Fin eta → Fin D => V)} (hΨ : R.IsCoulombSpinSector P dim Ψ)
    {σ : Fin eta → Fin D} (hσ : ¬ P.IsValidSpin dim σ) : Ψ σ = 0 := by
  unfold CoulombParticles.IsValidSpin at hσ
  obtain ⟨a, ha⟩ := not_forall.mp hσ
  exact hΨ.2 σ a (not_lt.mp ha)

theorem IsCoulombSpinSector.smul {R : ParticleRelabelling eta V}
    {P : CoulombParticles eta} {D : ℕ} {dim : ℕ → ℕ}
    {Ψ : PiLp 2 (fun _ : Fin eta → Fin D => V)} (hΨ : R.IsCoulombSpinSector P dim Ψ)
    (c : ℂ) : R.IsCoulombSpinSector P dim (c • Ψ) := by
  refine ⟨?_, ?_⟩
  · intro i j hij hs σ
    rw [PiLp.smul_apply, PiLp.smul_apply, LinearIsometry.map_smul, hΨ.1 i j hij hs σ,
      smul_comm]
  · intro σ a ha
    rw [PiLp.smul_apply, hΨ.2 σ a ha, smul_zero]

open Classical in
/-- Symmetrization within species with reference spin pattern `σ₀`. The component at a
rearrangement `σ` of `σ₀` within species is `ε(π) • act π f` for a chosen relabelling `π`
within species with `σ ∘ π = σ₀`, where `ε` is the fermionic sign; the other components
vanish. For `f` in the exchange sector of `σ₀` the result does not depend on the choices. -/
def symmetrize (R : ParticleRelabelling eta V) (P : CoulombParticles eta) {D : ℕ}
    (σ₀ : Fin eta → Fin D) (f : V) : PiLp 2 (fun _ : Fin eta → Fin D => V) :=
  WithLp.toLp 2 (fun σ =>
    if h : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀ then
      (((P.fermionSign h.choose : ℤˣ) : ℤ) : ℂ) • R.act h.choose f
    else 0)

lemma symmetrize_apply_of_mem (R : ParticleRelabelling eta V) (P : CoulombParticles eta)
    {D : ℕ} (σ₀ : Fin eta → Fin D) (f : V) {σ : Fin eta → Fin D}
    (h : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀) :
    R.symmetrize P σ₀ f σ = (((P.fermionSign h.choose : ℤˣ) : ℤ) : ℂ) • R.act h.choose f := by
  classical
  change (if h : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀ then
      (((P.fermionSign h.choose : ℤˣ) : ℤ) : ℂ) • R.act h.choose f
    else 0) = _
  rw [dif_pos h]

lemma symmetrize_apply_of_not_mem (R : ParticleRelabelling eta V) (P : CoulombParticles eta)
    {D : ℕ} (σ₀ : Fin eta → Fin D) (f : V) {σ : Fin eta → Fin D}
    (h : ¬ ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀) :
    R.symmetrize P σ₀ f σ = 0 := by
  classical
  change (if h : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀ then
      (((P.fermionSign h.choose : ℤˣ) : ℤ) : ℂ) • R.act h.choose f
    else 0) = _
  rw [dif_neg h]

/-- Symmetrization multiplies inner products by the number of rearrangements of the
reference spin pattern within species. -/
theorem symmetrize_inner (R : ParticleRelabelling eta V) (P : CoulombParticles eta) {D : ℕ}
    (σ₀ : Fin eta → Fin D) (f g : V) :
    inner ℂ (R.symmetrize P σ₀ f) (R.symmetrize P σ₀ g) =
      (P.spinOrbitCount σ₀ : ℂ) * inner ℂ f g := by
  classical
  rw [PiLp.inner_apply]
  have hterm : ∀ σ : Fin eta → Fin D,
      inner ℂ (R.symmetrize P σ₀ f σ) (R.symmetrize P σ₀ g σ) =
        if (∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀) then inner ℂ f g
        else 0 := by
    intro σ
    by_cases h : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀
    · rw [R.symmetrize_apply_of_mem P σ₀ f h, R.symmetrize_apply_of_mem P σ₀ g h,
        if_pos h, inner_smul_left, inner_smul_right, LinearIsometry.inner_map_map]
      rcases Int.units_eq_one_or (P.fermionSign h.choose) with hs | hs <;> simp [hs]
    · rw [R.symmetrize_apply_of_not_mem P σ₀ f h, R.symmetrize_apply_of_not_mem P σ₀ g h,
        if_neg h, inner_zero_left]
  rw [Finset.sum_congr rfl (fun σ _ => hterm σ), Finset.sum_ite, Finset.sum_const_zero,
    add_zero, Finset.sum_const, nsmul_eq_mul]
  unfold CoulombParticles.spinOrbitCount
  congr

theorem symmetrize_norm_sq (R : ParticleRelabelling eta V) (P : CoulombParticles eta)
    {D : ℕ} (σ₀ : Fin eta → Fin D) (f : V) :
    ‖R.symmetrize P σ₀ f‖ ^ 2 = (P.spinOrbitCount σ₀ : ℝ) * ‖f‖ ^ 2 := by
  have h := R.symmetrize_inner P σ₀ f f
  rw [inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K] at h
  apply Complex.ofReal_injective
  push_cast
  exact h

lemma symmetrize_norm_ne_zero (R : ParticleRelabelling eta V) (P : CoulombParticles eta)
    {D : ℕ} (σ₀ : Fin eta → Fin D) {f : V} (hf : ‖f‖ = 1) :
    ‖R.symmetrize P σ₀ f‖ ≠ 0 := by
  intro h0
  have h := R.symmetrize_norm_sq P σ₀ f
  rw [h0, hf] at h
  have hc : (P.spinOrbitCount σ₀ : ℝ) = 0 := by linarith
  exact (Nat.cast_ne_zero.mpr (P.spinOrbitCount_pos σ₀).ne') hc

theorem symmetrize_smul (R : ParticleRelabelling eta V) (P : CoulombParticles eta) {D : ℕ}
    (σ₀ : Fin eta → Fin D) (c : ℂ) (f : V) :
    R.symmetrize P σ₀ (c • f) = c • R.symmetrize P σ₀ f := by
  classical
  apply PiLp.ext
  intro σ
  by_cases h : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀
  · rw [PiLp.smul_apply, R.symmetrize_apply_of_mem P σ₀ _ h,
      R.symmetrize_apply_of_mem P σ₀ f h, LinearIsometry.map_smul, smul_comm]
  · rw [PiLp.smul_apply, R.symmetrize_apply_of_not_mem P σ₀ _ h,
      R.symmetrize_apply_of_not_mem P σ₀ f h, smul_zero]

/-- Symmetrization of a state in the exchange sector of a valid spin pattern `σ₀` is a spin
state of the Coulomb system. -/
theorem symmetrize_isCoulombSpinSector (R : ParticleRelabelling eta V)
    (P : CoulombParticles eta) {D : ℕ} (dim : ℕ → ℕ) {σ₀ : Fin eta → Fin D}
    (hσ₀ : P.IsValidSpin dim σ₀) {f : V}
    (hf : R.IsSignedSector P.sign (P.spinSectorLabel σ₀) f) :
    R.IsCoulombSpinSector P dim (R.symmetrize P σ₀ f) := by
  classical
  refine ⟨?_, ?_⟩
  · intro i j hij hs σ
    have hτ : P.IsSpeciesPerm (Equiv.swap i j) := P.isSpeciesPerm_swap hs
    by_cases h : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀
    · have h' : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧
          (σ ∘ Equiv.swap i j) ∘ π = σ₀ := by
        obtain ⟨π, hπ, hπσ⟩ := h
        refine ⟨Equiv.swap i j * π, hτ.mul hπ, ?_⟩
        funext k
        simp only [Function.comp_apply, Equiv.Perm.mul_apply, Equiv.swap_apply_self]
        exact congrFun hπσ k
      rw [R.symmetrize_apply_of_mem P σ₀ f h', R.symmetrize_apply_of_mem P σ₀ f h]
      obtain ⟨hsp₁, hπ₁⟩ := h'.choose_spec
      obtain ⟨hsp₂, hπ₂⟩ := h.choose_spec
      let κ : Equiv.Perm (Fin eta) := h.choose⁻¹ * (Equiv.swap i j * h'.choose)
      have hκsp : P.IsSpeciesPerm κ := hsp₂.inv.mul (hτ.mul hsp₁)
      have hκlab : ∀ k, P.spinSectorLabel σ₀ (κ k) = P.spinSectorLabel σ₀ k := by
        intro k
        have e1 : σ₀ (κ k) = σ (h.choose (κ k)) := (congrFun hπ₂ (κ k)).symm
        have e2 : h.choose (κ k) = Equiv.swap i j (h'.choose k) := by
          simp only [κ, Equiv.Perm.mul_apply, perm_apply_inv_self]
        have e3 : σ (Equiv.swap i j (h'.choose k)) = σ₀ k := congrFun hπ₁ k
        unfold CoulombParticles.spinSectorLabel
        rw [hκsp k, e1, e2, e3]
      have hκ := act_eq_fermionSign_of_isSignedSector (P.spinSectorLabel_isAdmissible σ₀) hf κ
        hκlab
      have hmul : Equiv.swap i j * h'.choose = h.choose * κ := by
        simp only [κ, mul_inv_cancel_left]
      have hsign : P.fermionSign h'.choose * P.fermionSign κ =
          P.fermionSign (Equiv.swap i j) * P.fermionSign h.choose := by
        have hκs : P.fermionSign κ =
            P.fermionSign h.choose * (P.fermionSign (Equiv.swap i j) *
              P.fermionSign h'.choose) := by
          simp only [κ]
          rw [P.fermionSign_mul hsp₂.inv (hτ.mul hsp₁), P.fermionSign_mul hτ hsp₁,
            P.fermionSign_inv hsp₂]
        rw [hκs]
        rcases Int.units_eq_one_or (P.fermionSign h'.choose) with h1 | h1 <;>
          rcases Int.units_eq_one_or (P.fermionSign h.choose) with h2 | h2 <;>
          rcases Int.units_eq_one_or (P.fermionSign (Equiv.swap i j)) with h3 | h3 <;>
          simp [h1, h2, h3]
      rw [LinearIsometry.map_smul, R.act_mul, hmul, ← R.act_mul, hκ, LinearIsometry.map_smul,
        smul_smul, smul_smul]
      congr 1
      rw [← P.fermionSign_swap hij hs]
      have hc := congrArg (fun u : ℤˣ => ((u : ℤ) : ℂ)) hsign
      push_cast at hc
      exact hc
    · have h' : ¬ ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧
          (σ ∘ Equiv.swap i j) ∘ π = σ₀ := by
        rintro ⟨π, hπ, hπσ⟩
        exact h ⟨Equiv.swap i j * π, hτ.mul hπ, by funext k; exact congrFun hπσ k⟩
      rw [R.symmetrize_apply_of_not_mem P σ₀ f h', R.symmetrize_apply_of_not_mem P σ₀ f h,
        map_zero, smul_zero]
  · intro σ a ha
    apply R.symmetrize_apply_of_not_mem P σ₀ f
    rintro ⟨π, hπ, hπσ⟩
    have h1 := hσ₀ (π⁻¹ a)
    have h2 : σ₀ (π⁻¹ a) = σ a := by
      rw [← hπσ, Function.comp_apply, perm_apply_inv_self]
    rw [h2, hπ.inv a] at h1
    exact absurd ha (not_le.mpr h1)

/-- A relation that is covariant under relabelling within species and closed under scalar
multiplication holds for corresponding components of symmetrizations. -/
theorem symmetrize_rel (R : ParticleRelabelling eta V) (P : CoulombParticles eta)
    {Rel : V → V → Prop}
    (hcov : ∀ π, P.IsSpeciesPerm π → ∀ f h, Rel f h → Rel (R.act π f) (R.act π h))
    (hsmul : ∀ (c : ℂ) f h, Rel f h → Rel (c • f) (c • h))
    {D : ℕ} (σ₀ : Fin eta → Fin D) {f h : V} (hfh : Rel f h) (σ : Fin eta → Fin D) :
    Rel (R.symmetrize P σ₀ f σ) (R.symmetrize P σ₀ h σ) := by
  classical
  by_cases hσ : ∃ π : Equiv.Perm (Fin eta), P.IsSpeciesPerm π ∧ σ ∘ π = σ₀
  · rw [R.symmetrize_apply_of_mem P σ₀ f hσ, R.symmetrize_apply_of_mem P σ₀ h hσ]
    exact hsmul _ _ _ (hcov _ hσ.choose_spec.1 _ _ hfh)
  · rw [R.symmetrize_apply_of_not_mem P σ₀ f hσ, R.symmetrize_apply_of_not_mem P σ₀ h hσ]
    simpa only [zero_smul] using hsmul 0 _ _ hfh

/-- A predicate that is invariant under relabelling within species and closed under scalar
multiplication holds for every component of a symmetrization. -/
theorem symmetrize_pred (R : ParticleRelabelling eta V) (P : CoulombParticles eta)
    {Q : V → Prop} (hcov : ∀ π, P.IsSpeciesPerm π → ∀ f, Q f → Q (R.act π f))
    (hsmul : ∀ (c : ℂ) f, Q f → Q (c • f)) {D : ℕ} (σ₀ : Fin eta → Fin D) {f : V}
    (hf : Q f) (σ : Fin eta → Fin D) : Q (R.symmetrize P σ₀ f σ) :=
  R.symmetrize_rel P (Rel := fun a _ => Q a) (fun π hπ a _ ha => hcov π hπ a ha)
    (fun c a _ ha => hsmul c a ha) σ₀ (h := f) hf σ

/-- Rayleigh quotients are preserved by normalized symmetrization. -/
theorem symmetrize_rayleigh (R : ParticleRelabelling eta V) (P : CoulombParticles eta)
    {D : ℕ} (σ₀ : Fin eta → Fin D) {f h : V} (hf : ‖f‖ = 1) :
    (inner ℂ (((‖R.symmetrize P σ₀ f‖⁻¹ : ℝ) : ℂ) • R.symmetrize P σ₀ f)
      (((‖R.symmetrize P σ₀ f‖⁻¹ : ℝ) : ℂ) • R.symmetrize P σ₀ h)).re =
      (inner ℂ f h).re := by
  have hA2 := R.symmetrize_norm_sq P σ₀ f
  rw [hf, one_pow, mul_one] at hA2
  have hAne := R.symmetrize_norm_ne_zero P σ₀ hf
  rw [inner_smul_left, inner_smul_right, R.symmetrize_inner, Complex.conj_ofReal,
    ← mul_assoc, ← mul_assoc]
  have hcast : ((‖R.symmetrize P σ₀ f‖⁻¹ : ℝ) : ℂ) *
      ((‖R.symmetrize P σ₀ f‖⁻¹ : ℝ) : ℂ) * (P.spinOrbitCount σ₀ : ℂ) =
      ((‖R.symmetrize P σ₀ f‖⁻¹ * ‖R.symmetrize P σ₀ f‖⁻¹ *
        (P.spinOrbitCount σ₀ : ℝ) : ℝ) : ℂ) := by
    push_cast
    ring
  rw [hcast, Complex.re_ofReal_mul, ← hA2]
  field_simp

end ParticleRelabelling

/-! ## The Hamiltonian commutes with relabelling within species -/

section Covariance

variable {eta : ℕ} {ν : Type*} [Fintype ν]

omit [Fintype ν] in
lemma coulombKineticEnergySymbol_permute (sys : CoulombSystem eta ν) (g : ℝ)
    {π : Equiv.Perm (Fin eta)} (hπ : sys.IsSpeciesPerm π) (p : FourierConfig eta Lattice3) :
    coulombKineticEnergySymbol sys g (p ∘ π) = coulombKineticEnergySymbol sys g p := by
  unfold coulombKineticEnergySymbol
  congr 1
  calc ∑ i : Fin eta, g ^ 2 * latticeNormSq ((p ∘ π) i) / sys.mass i
      = ∑ i : Fin eta, g ^ 2 * latticeNormSq (p (π i)) / sys.mass (π i) := by
        apply Finset.sum_congr rfl
        intro i _
        rw [hπ.mass i]
        rfl
    _ = ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i :=
        Equiv.sum_comp π (fun i => g ^ 2 * latticeNormSq (p i) / sys.mass i)

omit [Fintype ν] in
/-- Relabelling within species transports the weak kinetic equation with masses. -/
theorem HasCoulombWeakKinetic.permute {sys : CoulombSystem eta ν} {g : ℝ}
    {f k : MolecularPositionL2 eta} (h : HasCoulombWeakKinetic sys g f k)
    {π : Equiv.Perm (Fin eta)} (hπ : sys.IsSpeciesPerm π) :
    HasCoulombWeakKinetic sys g (molecularPositionPermLp π f) (molecularPositionPermLp π k) := by
  apply (hasCoulombWeakKinetic_iff_coeff sys g _ _).mpr
  intro p
  rw [molecularPositionPermLp_fourier, molecularPositionPermLp_fourier,
    (hasCoulombWeakKinetic_iff_coeff sys g f k).mp h (p ∘ π),
    coulombKineticEnergySymbol_permute sys g hπ]

omit [Fintype ν] in
theorem HasCoulombContDiffWeakKinetic.permute {sys : CoulombSystem eta ν} {L : ℝ}
    {f k : MolecularPositionL2 eta} (h : HasCoulombContDiffWeakKinetic sys L f k)
    {π : Equiv.Perm (Fin eta)} (hπ : sys.IsSpeciesPerm π) :
    HasCoulombContDiffWeakKinetic sys L
      (molecularPositionPermLp π f) (molecularPositionPermLp π k) :=
  (hasCoulombContDiffWeakKinetic_iff sys L _ _).mpr
    (((hasCoulombContDiffWeakKinetic_iff sys L f k).mp h).permute hπ)

/-- The Coulomb potential is invariant under relabelling within species, almost
everywhere. -/
theorem coulombPotential_permute_ae (sys : CoulombSystem eta ν) (L : ℝ)
    {π : Equiv.Perm (Fin eta)} (hπ : sys.IsSpeciesPerm π) :
    (fun x => coulombPotential sys L (molecularPositionPermute π x)) =ᵐ[volume]
      coulombPotential sys L := by
  have hPair : ∀ᵐ x ∂(volume : Measure (MolecularPositionTorus eta)), ∀ i j : Fin eta,
      canonicalUnitTorus3CoulombPotential.potential (molecularPositionDifference i j x) =
        canonicalUnitTorus3CoulombPotential.potential (molecularPositionDifference j i x) := by
    rw [ae_all_iff]
    intro i
    rw [ae_all_iff]
    intro j
    by_cases hij : i = j
    · subst hij
      exact Filter.Eventually.of_forall fun _ => rfl
    · filter_upwards [molecularPositionPairCoulomb_swap_ae i j hij] with x hx
      exact hx.symm
  filter_upwards [hPair] with x hx
  have hPairSum : (∑ pair : FiniteElectronPair eta,
      ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 (molecularPositionPermute π x))) =
      ∑ pair : FiniteElectronPair eta,
        ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionDifference pair.1.1 pair.1.2 x) := by
    have h := sum_finiteElectronPair_permute π
      (fun i j => ((sys.charge i * sys.charge j : ℝ) : ℂ) *
        canonicalUnitTorus3CoulombPotential.potential (molecularPositionDifference i j x))
      (fun i j => by rw [mul_comm (sys.charge i), hx i j])
    rw [← h]
    apply Finset.sum_congr rfl
    intro pair _
    exact congrArg₂ (· * ·) (by rw [hπ.charge, hπ.charge]) rfl
  have hNuclearSum : (∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) *
        ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearDifference i (sys.nuclei.position ell)
              (molecularPositionPermute π x))) =
      ∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) *
        ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearDifference i (sys.nuclei.position ell) x) := by
    calc (∑ i : Fin eta, ((sys.charge i : ℝ) : ℂ) *
          ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
            canonicalUnitTorus3CoulombPotential.potential
              (molecularPositionNuclearDifference i (sys.nuclei.position ell)
                (molecularPositionPermute π x)))
        = ∑ i : Fin eta, ((sys.charge (π i) : ℝ) : ℂ) *
            ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
              canonicalUnitTorus3CoulombPotential.potential
                (molecularPositionNuclearDifference (π i) (sys.nuclei.position ell) x) := by
          apply Finset.sum_congr rfl
          intro i _
          exact congrArg₂ (· * ·) (by rw [hπ.charge]) rfl
      _ = _ := Equiv.sum_comp π (fun i => ((sys.charge i : ℝ) : ℂ) *
            ∑ ell : ν, (sys.nuclei.charge ell : ℂ) *
              canonicalUnitTorus3CoulombPotential.potential
                (molecularPositionNuclearDifference i (sys.nuclei.position ell) x))
  simp only [coulombPotential, hPairSum, hNuclearSum]

/-- The Hamiltonian of a Coulomb system commutes with every relabelling within species. -/
theorem HasCoulombHamiltonian.permute {sys : CoulombSystem eta ν} {L : ℝ}
    {f h : MolecularPositionL2 eta} (hH : HasCoulombHamiltonian sys L f h)
    {π : Equiv.Perm (Fin eta)} (hπ : sys.IsSpeciesPerm π) :
    HasCoulombHamiltonian sys L (molecularPositionPermLp π f) (molecularPositionPermLp π h) := by
  obtain ⟨v, hv, hweak⟩ := hH
  refine ⟨molecularPositionPermLp π v,
    hv.permute π (coulombPotential_permute_ae sys L hπ), ?_⟩
  simpa only [map_sub] using hweak.permute hπ

/-- The Hamiltonian graph is closed under scalar multiplication. -/
theorem HasCoulombHamiltonian.smul {sys : CoulombSystem eta ν} {L : ℝ}
    {f h : MolecularPositionL2 eta} (hH : HasCoulombHamiltonian sys L f h) (c : ℂ) :
    HasCoulombHamiltonian sys L (c • f) (c • h) := by
  obtain ⟨v, hv, hweak⟩ := hH
  refine ⟨c • v, ?_, ?_⟩
  · filter_upwards [hv, MeasureTheory.Lp.coeFn_smul c f, MeasureTheory.Lp.coeFn_smul c v]
      with x hx hf hvx
    rw [hvx, hf, Pi.smul_apply, Pi.smul_apply, hx, smul_eq_mul, smul_eq_mul]
    ring
  · intro φ hφ
    rw [← smul_sub, inner_smul_right, inner_smul_right, hweak φ hφ]

end Covariance

end
end PlaneWaveCertificate

end ReleaseMilestone150a
-- END RELEASE SOURCE 150a

-- BEGIN RELEASE SOURCE 150b: the spin-inclusive space of a Coulomb system
section ReleaseMilestone150b

/-!
# Milestone 150b: the spin-inclusive space of a Coulomb system

The state space `L²((T³)^η; 𝒱)`, `𝒱 = ⊗_a ℂ^{d_a}`, of the manuscript's `app:nbo`, written in
spin components: spin values in `Fin D` for every particle, multiplicity `dim s ≤ D` for the
species `s`, and components that vanish when a spin value is at or above the multiplicity of
its species. The physical sector is antisymmetric under simultaneous exchange of the
positions and spins of two identical fermions and symmetric for two identical bosons. The
spin-independent Hamiltonian acts on every component. Its ground energy is the lowest
ground energy of the exchange sectors of the valid spin patterns, and its cubic Ritz energy
the lowest sector cubic Ritz energy, so every sector bound passes to the spin space with the
same constants.
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology BigOperators

noncomputable section

local instance unitAddCircleMeasureSpaceForCoulombSpin2 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-! ## Valid spin configurations -/

namespace CoulombParticles

variable {eta : ℕ} (P : CoulombParticles eta)

/-- With every multiplicity between one and `D` there is a valid spin configuration. -/
lemma exists_isValidSpin {D : ℕ} {dim : ℕ → ℕ}
    (hdim : ∀ a, 0 < dim (P.species a) ∧ dim (P.species a) ≤ D) :
    ∃ σ : Fin eta → Fin D, P.IsValidSpin dim σ :=
  ⟨fun a => ⟨0, lt_of_lt_of_le (hdim a).1 (hdim a).2⟩, fun a => (hdim a).1⟩

/-- A real function of the spin configurations attains its minimum over the valid ones. -/
lemma exists_min_valid {D : ℕ} {dim : ℕ → ℕ}
    (hdim : ∀ a, 0 < dim (P.species a) ∧ dim (P.species a) ≤ D)
    (E : (Fin eta → Fin D) → ℝ) :
    ∃ σ₀ : Fin eta → Fin D, P.IsValidSpin dim σ₀ ∧
      ∀ σ : Fin eta → Fin D, P.IsValidSpin dim σ → E σ₀ ≤ E σ := by
  classical
  obtain ⟨σz, hσz⟩ := P.exists_isValidSpin hdim
  obtain ⟨σ₀, hmem, hmin⟩ := Finset.exists_min_image
    (Finset.univ.filter (P.IsValidSpin dim)) E
    ⟨σz, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hσz⟩⟩
  exact ⟨σ₀, (Finset.mem_filter.mp hmem).2,
    fun σ hv => hmin σ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hv⟩)⟩

end CoulombParticles

/-! ## Position-space sectors and spin states -/

/-- The position-space sector is the signed sector of the relabelling representation. -/
theorem isPositionSector_iff_isSignedSector {eta : ℕ} (sgn : Fin eta → ℂ)
    (lab : Fin eta → ℕ) (f : MolecularPositionL2 eta) :
    IsPositionSector sgn lab f ↔ (molecularPositionRelabelling eta).IsSignedSector sgn lab f := by
  apply forall_congr'
  intro i
  apply forall_congr'
  intro j
  apply forall_congr'
  intro _hij
  apply forall_congr'
  intro _hlab
  change _ ↔ molecularPositionPermLp (Equiv.swap i j) f = sgn i • f
  rw [molecularPositionPermLp_swap]
  exact (molecularPositionSwapLp_eq_smul_iff i j (sgn i) f).symm

/-- Spin-dependent wavefunctions of `eta` particles with spin values in `Fin D`: one `L²`
component for each spin configuration `σ : Fin eta → Fin D`, with the squared norm summed
over configurations. -/
abbrev CoulombSpinL2 (eta D : ℕ) :=
  PiLp 2 (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)

/-- The physical states of a Coulomb system whose species `s` has `dim s` spin states:
`Ψ (σ ∘ τ) (τ x) = sign_i Ψ σ x` for almost every `x`, for every exchange `τ` of two
particles `i, j` of the same species (positions and spins are exchanged together; the sign
is `-1` for fermions and `+1` for bosons), and `Ψ σ = 0` when some particle has a spin value
at or above the multiplicity of its species. When `dim s ≤ D` for every species `s` present,
under `Ψ ↦ (Ψ σ)_σ valid` these are the states of `L²((T³)^η; ⊗_a ℂ^{d_a})` in the
manuscript's sector `𝒮`. -/
def IsCoulombSpinSector {eta : ℕ} {ν : Type*} (sys : CoulombSystem eta ν) {D : ℕ}
    (dim : ℕ → ℕ) (Ψ : CoulombSpinL2 eta D) : Prop :=
  (∀ i j : Fin eta, i ≠ j → sys.species i = sys.species j → ∀ σ : Fin eta → Fin D,
    ∀ᵐ x ∂(volume : Measure (MolecularPositionTorus eta)),
      Ψ (σ ∘ Equiv.swap i j) (molecularPositionSwap i j x) = sys.sign i * Ψ σ x) ∧
  ∀ σ : Fin eta → Fin D, ∀ a : Fin eta, dim (sys.species a) ≤ σ a → Ψ σ = 0

/-- The same condition for the relabelling representation. -/
theorem isCoulombSpinSector_iff {eta : ℕ} {ν : Type*} (sys : CoulombSystem eta ν) {D : ℕ}
    (dim : ℕ → ℕ) (Ψ : CoulombSpinL2 eta D) :
    IsCoulombSpinSector sys dim Ψ ↔
      (molecularPositionRelabelling eta).IsCoulombSpinSector sys.toCoulombParticles dim Ψ := by
  unfold IsCoulombSpinSector ParticleRelabelling.IsCoulombSpinSector
  refine and_congr ?_ Iff.rfl
  apply forall_congr'
  intro i
  apply forall_congr'
  intro j
  apply forall_congr'
  intro _hij
  apply forall_congr'
  intro _hs
  apply forall_congr'
  intro σ
  change _ ↔ molecularPositionPermLp (Equiv.swap i j) (Ψ (σ ∘ Equiv.swap i j)) =
    sys.sign i • Ψ σ
  rw [molecularPositionPermLp_swap]
  constructor
  · intro h
    apply MeasureTheory.Lp.ext
    filter_upwards [molecularPositionSwapLp_coeFn i j (Ψ (σ ∘ Equiv.swap i j)),
      MeasureTheory.Lp.coeFn_smul (sys.sign i) (Ψ σ), h] with x h1 h2 h3
    rw [h1, h2, Pi.smul_apply, h3, smul_eq_mul]
  · intro h
    filter_upwards [molecularPositionSwapLp_coeFn i j (Ψ (σ ∘ Equiv.swap i j)),
      MeasureTheory.Lp.coeFn_smul (sys.sign i) (Ψ σ)] with x h1 h2
    rw [← h1, h, h2, Pi.smul_apply, smul_eq_mul]

section SpinSpace

variable {eta : ℕ} {ν : Type*}

/-- Each spin component of a physical state lies in the exchange sector of its spin
pattern. -/
theorem IsCoulombSpinSector.component {sys : CoulombSystem eta ν} {D : ℕ} {dim : ℕ → ℕ}
    {Ψ : CoulombSpinL2 eta D} (hΨ : IsCoulombSpinSector sys dim Ψ) (σ : Fin eta → Fin D) :
    IsPositionSector sys.sign (sys.spinSectorLabel σ) (Ψ σ) :=
  (isPositionSector_iff_isSignedSector _ _ _).mpr
    (((isCoulombSpinSector_iff sys dim Ψ).mp hΨ).component σ)

theorem IsCoulombSpinSector.eq_zero_of_not_valid {sys : CoulombSystem eta ν} {D : ℕ}
    {dim : ℕ → ℕ} {Ψ : CoulombSpinL2 eta D} (hΨ : IsCoulombSpinSector sys dim Ψ)
    {σ : Fin eta → Fin D} (hσ : ¬ sys.IsValidSpin dim σ) : Ψ σ = 0 :=
  ((isCoulombSpinSector_iff sys dim Ψ).mp hΨ).eq_zero_of_not_valid hσ

theorem IsCoulombSpinSector.smul {sys : CoulombSystem eta ν} {D : ℕ} {dim : ℕ → ℕ}
    {Ψ : CoulombSpinL2 eta D} (hΨ : IsCoulombSpinSector sys dim Ψ) (c : ℂ) :
    IsCoulombSpinSector sys dim (c • Ψ) :=
  (isCoulombSpinSector_iff sys dim _).mpr (((isCoulombSpinSector_iff sys dim Ψ).mp hΨ).smul c)

variable [Fintype ν]

/-- The spin-independent Hamiltonian of a Coulomb system acts on each spin component. -/
def HasCoulombSpinHamiltonian (sys : CoulombSystem eta ν) (L : ℝ) {D : ℕ}
    (Ψ Φ : CoulombSpinL2 eta D) : Prop :=
  ∀ σ : Fin eta → Fin D, HasCoulombHamiltonian sys L (Ψ σ) (Φ σ)

theorem HasCoulombSpinHamiltonian.smul {sys : CoulombSystem eta ν} {L : ℝ} {D : ℕ}
    {Ψ Φ : CoulombSpinL2 eta D} (hH : HasCoulombSpinHamiltonian sys L Ψ Φ) (c : ℂ) :
    HasCoulombSpinHamiltonian sys L (c • Ψ) (c • Φ) := by
  intro σ
  rw [PiLp.smul_apply, PiLp.smul_apply]
  exact (hH σ).smul c

omit [Fintype ν] in
/-- Cubic Fourier support in every spin component: the range of `P ⊗ I`. -/
def IsCoulombSpinCubic (eta : ℕ) (L K : ℝ) {D : ℕ} (Ψ : CoulombSpinL2 eta D) : Prop :=
  ∀ σ : Fin eta → Fin D, IsMolecularPositionCubic eta L K (Ψ σ)

omit [Fintype ν] in
theorem IsCoulombSpinCubic.smul {L K : ℝ} {D : ℕ} {Ψ : CoulombSpinL2 eta D}
    (hΨ : IsCoulombSpinCubic eta L K Ψ) (c : ℂ) : IsCoulombSpinCubic eta L K (c • Ψ) := by
  intro σ
  rw [PiLp.smul_apply]
  exact (hΨ σ).smul c

omit [Fintype ν] in
theorem IsCoulombSpinCubic.mono {L K K' : ℝ} {D : ℕ} {Ψ : CoulombSpinL2 eta D}
    (hΨ : IsCoulombSpinCubic eta L K Ψ) (hKK' : K ≤ K') : IsCoulombSpinCubic eta L K' Ψ :=
  fun σ => (hΨ σ).mono hKK'

/-- A normalized ground eigenpair on the spin-inclusive space of a Coulomb system, with the
lower bound over all physical graph elements. -/
def HasCoulombSpinGroundPair (sys : CoulombSystem eta ν) (dim : ℕ → ℕ) (L : ℝ) {D : ℕ}
    (Ψ : CoulombSpinL2 eta D) (E : ℝ) : Prop :=
  IsCoulombSpinSector sys dim Ψ ∧ ‖Ψ‖ = 1 ∧
    HasCoulombSpinHamiltonian sys L Ψ ((E : ℂ) • Ψ) ∧
    ∀ F G : CoulombSpinL2 eta D, IsCoulombSpinSector sys dim F →
      HasCoulombSpinHamiltonian sys L F G →
      E * ‖F‖ ^ 2 ≤ (inner ℂ F G).re

/-- The attained cubic Ritz minimum on the spin-inclusive space of a Coulomb system: the
lowest eigenvalue of `P H P` on the physical states in `ran (P ⊗ I)`. -/
def IsCoulombSpinCubicGroundEnergy (sys : CoulombSystem eta ν) (D : ℕ) (dim : ℕ → ℕ)
    (L K EN : ℝ) : Prop :=
  (∀ F G : CoulombSpinL2 eta D, IsCoulombSpinSector sys dim F → IsCoulombSpinCubic eta L K F →
    HasCoulombSpinHamiltonian sys L F G →
    EN * ‖F‖ ^ 2 ≤ (inner ℂ F G).re) ∧
  ∃ F G : CoulombSpinL2 eta D, IsCoulombSpinSector sys dim F ∧ IsCoulombSpinCubic eta L K F ∧
    ‖F‖ = 1 ∧ HasCoulombSpinHamiltonian sys L F G ∧ (inner ℂ F G).re = EN

/-! ### Cubic states lie in the Hamiltonian's domain -/

/-- Every spin state whose components have cubic Fourier support has an image under the
spin-independent Hamiltonian. -/
theorem IsCoulombSpinCubic.exists_hamiltonian (sys : CoulombSystem eta ν) {L K : ℝ}
    (hL : 0 < L) {D : ℕ} {Ψ : CoulombSpinL2 eta D} (hΨ : IsCoulombSpinCubic eta L K Ψ) :
    ∃ Φ : CoulombSpinL2 eta D, HasCoulombSpinHamiltonian sys L Ψ Φ := by
  choose h hh using fun σ : Fin eta → Fin D => (hΨ σ).exists_coulombHamiltonian sys hL
  exact ⟨WithLp.toLp 2 h, fun σ => hh σ⟩

/-- The cubic Ritz minimum on the spin-inclusive space bounds the energy of every physical
state of `ran (P ⊗ I)`. -/
theorem IsCoulombSpinCubicGroundEnergy.le_of_cubic {sys : CoulombSystem eta ν} {D : ℕ}
    {dim : ℕ → ℕ} {L K EN : ℝ} (hL : 0 < L)
    (hEN : IsCoulombSpinCubicGroundEnergy sys D dim L K EN)
    {Ψ : CoulombSpinL2 eta D} (hF : IsCoulombSpinSector sys dim Ψ)
    (hC : IsCoulombSpinCubic eta L K Ψ) :
    ∃ Φ : CoulombSpinL2 eta D, HasCoulombSpinHamiltonian sys L Ψ Φ ∧
      EN * ‖Ψ‖ ^ 2 ≤ (inner ℂ Ψ Φ).re := by
  obtain ⟨Φ, hΦ⟩ := hC.exists_hamiltonian sys hL
  exact ⟨Φ, hΦ, hEN.1 Ψ Φ hF hC hΦ⟩

/-! ### Symmetrization of position-space sector states -/

omit [Fintype ν] in
/-- Symmetrization within species of a position-space state, with reference spin pattern
`σ₀`. -/
abbrev coulombSymmetrize (sys : CoulombSystem eta ν) {D : ℕ} (σ₀ : Fin eta → Fin D)
    (f : MolecularPositionL2 eta) : CoulombSpinL2 eta D :=
  (molecularPositionRelabelling eta).symmetrize sys.toCoulombParticles σ₀ f

omit [Fintype ν] in
theorem coulombSymmetrize_smul (sys : CoulombSystem eta ν) {D : ℕ} (σ₀ : Fin eta → Fin D)
    (c : ℂ) (f : MolecularPositionL2 eta) :
    coulombSymmetrize sys σ₀ (c • f) = c • coulombSymmetrize sys σ₀ f :=
  (molecularPositionRelabelling eta).symmetrize_smul sys.toCoulombParticles σ₀ c f

omit [Fintype ν] in
theorem coulombSymmetrize_isCoulombSpinSector (sys : CoulombSystem eta ν) {D : ℕ}
    (dim : ℕ → ℕ) {σ₀ : Fin eta → Fin D} (hσ₀ : sys.IsValidSpin dim σ₀)
    {f : MolecularPositionL2 eta} (hf : IsPositionSector sys.sign (sys.spinSectorLabel σ₀) f) :
    IsCoulombSpinSector sys dim (coulombSymmetrize sys σ₀ f) :=
  (isCoulombSpinSector_iff sys dim _).mpr
    ((molecularPositionRelabelling eta).symmetrize_isCoulombSpinSector
      sys.toCoulombParticles dim hσ₀ ((isPositionSector_iff_isSignedSector _ _ f).mp hf))

/-- Symmetrization commutes with the spin-independent Hamiltonian. -/
theorem coulombSymmetrize_hamiltonian (sys : CoulombSystem eta ν) {L : ℝ} {D : ℕ}
    (σ₀ : Fin eta → Fin D) {f h : MolecularPositionL2 eta}
    (hH : HasCoulombHamiltonian sys L f h) :
    HasCoulombSpinHamiltonian sys L (coulombSymmetrize sys σ₀ f) (coulombSymmetrize sys σ₀ h) :=
  (molecularPositionRelabelling eta).symmetrize_rel sys.toCoulombParticles
    (Rel := HasCoulombHamiltonian sys L)
    (fun _ hπ _ _ hfh => hfh.permute hπ) (fun c _ _ hfh => hfh.smul c) σ₀ hH

omit [Fintype ν] in
/-- Symmetrization preserves cubic Fourier support. -/
theorem coulombSymmetrize_cubic (sys : CoulombSystem eta ν) {L K : ℝ} {D : ℕ}
    (σ₀ : Fin eta → Fin D) {f : MolecularPositionL2 eta}
    (hf : IsMolecularPositionCubic eta L K f) :
    IsCoulombSpinCubic eta L K (coulombSymmetrize sys σ₀ f) :=
  (molecularPositionRelabelling eta).symmetrize_pred sys.toCoulombParticles
    (Q := IsMolecularPositionCubic eta L K)
    (fun π _ _ hf => hf.permute π) (fun c _ hf => hf.smul c) σ₀ hf

/-! ### Assembly from the exchange sectors -/

/-- The lowest ground pair over the sectors of the valid spin patterns, symmetrized and
normalized, is a ground pair on the spin-inclusive space. -/
theorem HasCoulombSpinGroundPair.of_sectors {sys : CoulombSystem eta ν} {D : ℕ}
    {dim : ℕ → ℕ} {L : ℝ} (E : (Fin eta → Fin D) → ℝ)
    (ψ : (Fin eta → Fin D) → MolecularPositionL2 eta)
    (hPair : ∀ σ, HasCoulombSectorGroundPair sys (sys.spinSectorLabel σ) L (ψ σ) (E σ))
    (σ₀ : Fin eta → Fin D) (hσ₀ : sys.IsValidSpin dim σ₀)
    (hmin : ∀ σ, sys.IsValidSpin dim σ → E σ₀ ≤ E σ) :
    HasCoulombSpinGroundPair sys dim L
      (((‖coulombSymmetrize sys σ₀ (ψ σ₀)‖⁻¹ : ℝ) : ℂ) • coulombSymmetrize sys σ₀ (ψ σ₀))
      (E σ₀) := by
  obtain ⟨hF, hNorm, hEig, -⟩ := hPair σ₀
  have hAne := (molecularPositionRelabelling eta).symmetrize_norm_ne_zero
    sys.toCoulombParticles σ₀ hNorm
  refine ⟨(coulombSymmetrize_isCoulombSpinSector sys dim hσ₀ hF).smul _,
    norm_inv_smul_self_eq_one hAne, ?_, ?_⟩
  · have h1 := coulombSymmetrize_hamiltonian sys σ₀ hEig
    rw [coulombSymmetrize_smul] at h1
    have h2 := h1.smul ((‖coulombSymmetrize sys σ₀ (ψ σ₀)‖⁻¹ : ℝ) : ℂ)
    rwa [smul_comm ((‖coulombSymmetrize sys σ₀ (ψ σ₀)‖⁻¹ : ℝ) : ℂ) (E σ₀ : ℂ)] at h2
  · intro F G hSpin hG
    apply pi_lower_bound_of_components
    intro σ
    by_cases hv : sys.IsValidSpin dim σ
    · exact (mul_le_mul_of_nonneg_right (hmin σ hv) (sq_nonneg _)).trans
        ((hPair σ).2.2.2 (F σ) (G σ) (hSpin.component σ) (hG σ))
    · rw [hSpin.eq_zero_of_not_valid hv, norm_zero, inner_zero_left]
      simp

/-- The lowest cubic Ritz energy over the sectors of the valid spin patterns is the cubic
Ritz energy on the spin-inclusive space. -/
theorem IsCoulombSpinCubicGroundEnergy.of_sectors {sys : CoulombSystem eta ν} {D : ℕ}
    {dim : ℕ → ℕ} {L K : ℝ} (EN : (Fin eta → Fin D) → ℝ)
    (hEN : ∀ σ, IsCoulombSectorCubicGroundEnergy sys (sys.spinSectorLabel σ) L K (EN σ))
    (σ₁ : Fin eta → Fin D) (hσ₁ : sys.IsValidSpin dim σ₁)
    (hmin : ∀ σ, sys.IsValidSpin dim σ → EN σ₁ ≤ EN σ) :
    IsCoulombSpinCubicGroundEnergy sys D dim L K (EN σ₁) := by
  constructor
  · intro F G hSpin hCube hG
    apply pi_lower_bound_of_components
    intro σ
    by_cases hv : sys.IsValidSpin dim σ
    · exact (mul_le_mul_of_nonneg_right (hmin σ hv) (sq_nonneg _)).trans
        ((hEN σ).1 (F σ) (G σ) (hSpin.component σ) (hCube σ) (hG σ))
    · rw [hSpin.eq_zero_of_not_valid hv, norm_zero, inner_zero_left]
      simp
  · obtain ⟨f, h, hf, hCube, hNorm, hGraph, hEnergy⟩ := (hEN σ₁).2
    have hAne := (molecularPositionRelabelling eta).symmetrize_norm_ne_zero
      sys.toCoulombParticles σ₁ hNorm
    refine ⟨((‖coulombSymmetrize sys σ₁ f‖⁻¹ : ℝ) : ℂ) • coulombSymmetrize sys σ₁ f,
      ((‖coulombSymmetrize sys σ₁ f‖⁻¹ : ℝ) : ℂ) • coulombSymmetrize sys σ₁ h,
      (coulombSymmetrize_isCoulombSpinSector sys dim hσ₁ hf).smul _,
      (coulombSymmetrize_cubic sys σ₁ hCube).smul _, norm_inv_smul_self_eq_one hAne,
      (coulombSymmetrize_hamiltonian sys σ₁ hGraph).smul _, ?_⟩
    rw [ParticleRelabelling.symmetrize_rayleigh _ _ σ₁ hNorm, hEnergy]

/-! ### Uniqueness and monotonicity -/

theorem HasCoulombSpinGroundPair.energy_unique {sys : CoulombSystem eta ν} {dim : ℕ → ℕ}
    {L : ℝ} {D : ℕ} {Ψ Φ : CoulombSpinL2 eta D} {E F : ℝ}
    (hE : HasCoulombSpinGroundPair sys dim L Ψ E)
    (hF : HasCoulombSpinGroundPair sys dim L Φ F) : E = F := by
  apply le_antisymm
  · have h := hE.2.2.2 Φ ((F : ℂ) • Φ) hF.1 hF.2.2.1
    rw [inner_smul_right, inner_self_eq_norm_sq_to_K] at h
    simpa [hF.2.1] using h
  · have h := hF.2.2.2 Ψ ((E : ℂ) • Ψ) hE.1 hE.2.2.1
    rw [inner_smul_right, inner_self_eq_norm_sq_to_K] at h
    simpa [hE.2.1] using h

theorem IsCoulombSpinCubicGroundEnergy.unique {sys : CoulombSystem eta ν} {D : ℕ}
    {dim : ℕ → ℕ} {L K : ℝ} {E F : ℝ}
    (hE : IsCoulombSpinCubicGroundEnergy sys D dim L K E)
    (hF : IsCoulombSpinCubicGroundEnergy sys D dim L K F) : E = F := by
  obtain ⟨f, h, hf, hCube, hNorm, hGraph, hEnergy⟩ := hF.2
  obtain ⟨g, k, hg, hgCube, hgNorm, hgGraph, hgEnergy⟩ := hE.2
  apply le_antisymm
  · have hLower := hE.1 f h hf hCube hGraph
    simpa only [hNorm, one_pow, mul_one, hEnergy] using hLower
  · have hLower := hF.1 g k hg hgCube hgGraph
    simpa only [hgNorm, one_pow, mul_one, hgEnergy] using hLower

theorem IsCoulombSpinCubicGroundEnergy.antitone_cutoff {sys : CoulombSystem eta ν} {D : ℕ}
    {dim : ℕ → ℕ} {L K K' : ℝ} {EN EN' : ℝ}
    (hEN : IsCoulombSpinCubicGroundEnergy sys D dim L K EN)
    (hEN' : IsCoulombSpinCubicGroundEnergy sys D dim L K' EN')
    (hKK' : K ≤ K') : EN' ≤ EN := by
  obtain ⟨f, h, hf, hCube, hNorm, hGraph, hEnergy⟩ := hEN.2
  have hLower := hEN'.1 f h hf (hCube.mono hKK') hGraph
  simpa only [hNorm, one_pow, mul_one, hEnergy] using hLower

theorem IsCoulombSpinCubicGroundEnergy.antitone_integer {sys : CoulombSystem eta ν}
    {D : ℕ} {dim : ℕ → ℕ} {L : ℝ} {m n : ℕ} {EN EN' : ℝ}
    (hEN : IsCoulombSpinCubicGroundEnergy sys D dim L ((2 * Real.pi / L) * (m : ℝ)) EN)
    (hEN' : IsCoulombSpinCubicGroundEnergy sys D dim L ((2 * Real.pi / L) * (n : ℝ)) EN')
    (hL : 0 < L) (hmn : m ≤ n) : EN' ≤ EN := by
  apply hEN.antitone_cutoff hEN'
  have hg : 0 ≤ 2 * Real.pi / L := le_of_lt (by positivity)
  have hmnReal : (m : ℝ) ≤ (n : ℝ) := by exact_mod_cast hmn
  exact mul_le_mul_of_nonneg_left hmnReal hg

/-- If the sector of every spin pattern has a cubic Ritz energy at `K`, so does the
spin-inclusive space. Its value lies between the lowest ground energy over the sectors of
the valid spin patterns and the cubic Ritz energy of the sector attaining it. -/
theorem coulombSpinCubic_of_sectors {sys : CoulombSystem eta ν} {D : ℕ} {dim : ℕ → ℕ}
    {L K : ℝ} (E : (Fin eta → Fin D) → ℝ)
    (ψ : (Fin eta → Fin D) → MolecularPositionL2 eta)
    (hPair : ∀ σ, HasCoulombSectorGroundPair sys (sys.spinSectorLabel σ) L (ψ σ) (E σ))
    (σ₀ : Fin eta → Fin D) (hσ₀ : sys.IsValidSpin dim σ₀)
    (hmin : ∀ σ, sys.IsValidSpin dim σ → E σ₀ ≤ E σ)
    (hEx : ∀ σ : Fin eta → Fin D,
      ∃ EN, IsCoulombSectorCubicGroundEnergy sys (sys.spinSectorLabel σ) L K EN) :
    ∃ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L K EN ∧ E σ₀ ≤ EN ∧
      ∀ EN₀ : ℝ, IsCoulombSectorCubicGroundEnergy sys (sys.spinSectorLabel σ₀) L K EN₀ →
        EN ≤ EN₀ := by
  classical
  choose EN hEN using hEx
  obtain ⟨σ₁, hσ₁mem, hσ₁⟩ := Finset.exists_min_image
    (Finset.univ.filter (sys.IsValidSpin dim)) EN
    ⟨σ₀, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hσ₀⟩⟩
  have hσ₁v : sys.IsValidSpin dim σ₁ := (Finset.mem_filter.mp hσ₁mem).2
  have hmin₁ : ∀ σ, sys.IsValidSpin dim σ → EN σ₁ ≤ EN σ :=
    fun σ hv => hσ₁ σ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hv⟩)
  refine ⟨EN σ₁, IsCoulombSpinCubicGroundEnergy.of_sectors EN hEN σ₁ hσ₁v hmin₁, ?_, ?_⟩
  · exact (hmin σ₁ hσ₁v).trans ((hPair σ₁).le_cubicGroundEnergy (hEN σ₁))
  · intro EN₀ hEN₀
    rw [← (hEN σ₀).unique hEN₀]
    exact hmin₁ σ₀ hσ₀

/-! ### Spin-inclusive certificates -/

/-- The error estimate with the canonical constants at the ground energy applies to any
ground pair of a sector and to every cubic Ritz energy of that sector. -/
theorem coulombSector_cubic_bound_for_ground_pair (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab) (L : ℝ) (hL : 0 < L)
    (psi : MolecularPositionL2 eta) (E : ℝ)
    (hPair : HasCoulombSectorGroundPair sys lab L psi E) :
    ∃ m0 : ℕ, ∀ m : ℕ, m0 ≤ m →
      (∃ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
        ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
      ∀ EN : ℝ, IsCoulombSectorCubicGroundEnergy sys lab L
        ((2 * Real.pi / L) * (m : ℝ)) EN →
        (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
        0 ≤ EN - E ∧
        EN - E ≤ coulombCanonicalCubicErrorConstant sys E L /
          ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
        coulombCanonicalCubicErrorConstant sys E L /
            ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ≤
          ((3 * L / (2 * Real.pi)) ^ 3 * coulombCanonicalCubicErrorConstant sys E L) /
            (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨E0, psi0, hPair0, _hConstant, m0, hm0⟩ :=
    coulomb_sector_canonical_cubic_error sys lab hlab L hL
  have hEnergy : E0 = E := hPair0.energy_unique hPair
  subst E0
  refine ⟨m0, ?_⟩
  intro m hm
  obtain ⟨EN0, hEN0, hCard, hNonneg, hRate, hCountRate⟩ := hm0 m hm
  refine ⟨⟨EN0, hEN0⟩, ?_⟩
  intro EN hEN
  have hEnergyN : EN = EN0 := hEN.unique hEN0
  subst EN
  exact ⟨hCard, hNonneg, hRate, hCountRate⟩

/-- The ground pair on the spin-inclusive space of a Coulomb system and the cubic error
bounds, with the same data-only constants and threshold as every exchange sector. -/
theorem coulombSpin_data_cubic_error (sys : CoulombSystem eta ν) (D : ℕ) (dim : ℕ → ℕ)
    (hdim : ∀ a, 0 < dim (sys.species a) ∧ dim (sys.species a) ≤ D) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ Ψ : CoulombSpinL2 eta D,
      HasCoulombSpinGroundPair sys dim L Ψ E ∧
      |E| ≤ coulombGroundEnergyBudget sys L ∧
      ∀ m : ℕ, coulombDataCubicThreshold sys L ≤ m →
        ∃ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
          ((2 * Real.pi / L) * (m : ℝ)) EN ∧
          (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
          0 ≤ EN - E ∧
          EN - E ≤ coulombDataCubicErrorConstant sys L /
            ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
          EN - E ≤ coulombDataBasisErrorConstant sys L /
            (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  classical
  choose E ψ hPair hBudget hCubic using
    fun σ : Fin eta → Fin D => coulomb_sector_data_cubic_error sys (sys.spinSectorLabel σ)
      (sys.spinSectorLabel_isAdmissible σ) L hL
  obtain ⟨σ₀, hσ₀, hmin⟩ := sys.exists_min_valid hdim E
  refine ⟨E σ₀, _, HasCoulombSpinGroundPair.of_sectors E ψ hPair σ₀ hσ₀ hmin,
    hBudget σ₀, ?_⟩
  intro m hm
  obtain ⟨EN₀, hEN₀, hCard, -, hRate, hNRate⟩ := hCubic σ₀ m hm
  obtain ⟨EN, hEN, hLow, hUp⟩ := coulombSpinCubic_of_sectors E ψ hPair σ₀ hσ₀ hmin
    (fun σ => (hCubic σ m hm).imp fun _ h => h.1)
  have hle := hUp EN₀ hEN₀
  exact ⟨EN, hEN, hCard, by linarith, by linarith, by linarith⟩

/-- Monotone convergence of the cubic Ritz energies on the spin-inclusive space, their
infimum, and certified error intervals with the canonical constants at the ground
energy. -/
theorem coulombSpin_cubic_convergence (sys : CoulombSystem eta ν) (D : ℕ) (dim : ℕ → ℕ)
    (hdim : ∀ a, 0 < dim (sys.species a) ∧ dim (sys.species a) ≤ D) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ Ψ : CoulombSpinL2 eta D,
      HasCoulombSpinGroundPair sys dim L Ψ E ∧
      ∃ m0 : ℕ, 1 ≤ m0 ∧ ∃ energy : ℕ → ℝ,
        (∀ n : ℕ, IsCoulombSpinCubicGroundEnergy sys D dim L
          ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) (energy n)) ∧
        Antitone energy ∧
        Tendsto energy atTop (𝓝 E) ∧
        E = (⨅ n : ℕ, energy n) ∧
        ∀ n : ℕ,
          (cubicPlaneWaveBox (m0 + n)).card = (2 * (m0 + n) + 1) ^ 3 ∧
          0 ≤ energy n - E ∧
          energy n - E ≤ coulombCanonicalCubicErrorConstant sys E L /
            ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) ^ 3 ∧
          energy n - E ≤ coulombCanonicalBasisErrorConstant sys E L /
            (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ∧
          energy n - coulombCanonicalBasisErrorConstant sys E L /
              (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ≤ E ∧
          E ≤ energy n := by
  classical
  choose E ψ hPair _hBudget hCubic using
    fun σ : Fin eta → Fin D => coulomb_sector_data_cubic_error sys (sys.spinSectorLabel σ)
      (sys.spinSectorLabel_isAdmissible σ) L hL
  obtain ⟨σ₀, hσ₀, hmin⟩ := sys.exists_min_valid hdim E
  obtain ⟨m₁, hm₁⟩ := coulombSector_cubic_bound_for_ground_pair sys
    (sys.spinSectorLabel_isAdmissible σ₀) L hL (ψ σ₀) (E σ₀) (hPair σ₀)
  let m0 : ℕ := max 1 (max m₁ (coulombDataCubicThreshold sys L))
  have hm0 : 1 ≤ m0 := le_max_left _ _
  have hA (n : ℕ) : m₁ ≤ m0 + n := by
    have : m₁ ≤ m0 := (le_max_left _ _).trans (le_max_right _ _)
    omega
  have hB (n : ℕ) : coulombDataCubicThreshold sys L ≤ m0 + n := by
    have : coulombDataCubicThreshold sys L ≤ m0 :=
      (le_max_right _ _).trans (le_max_right _ _)
    omega
  have hSpin (n : ℕ) := coulombSpinCubic_of_sectors E ψ hPair σ₀ hσ₀ hmin
    (K := (2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ))
    (fun σ => (hCubic σ (m0 + n) (hB n)).imp fun _ h => h.1)
  choose energy hSpec hLow hUp using hSpin
  have hBounds (n : ℕ) :
      (cubicPlaneWaveBox (m0 + n)).card = (2 * (m0 + n) + 1) ^ 3 ∧
      0 ≤ energy n - E σ₀ ∧
      energy n - E σ₀ ≤ coulombCanonicalCubicErrorConstant sys (E σ₀) L /
        ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) ^ 3 ∧
      energy n - E σ₀ ≤ coulombCanonicalBasisErrorConstant sys (E σ₀) L /
        (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) := by
    obtain ⟨⟨EN₀, hEN₀⟩, hAll⟩ := hm₁ (m0 + n) (hA n)
    obtain ⟨hCard, -, hRate, hCount⟩ := hAll EN₀ hEN₀
    have hle := hUp n EN₀ hEN₀
    refine ⟨hCard, by linarith [hLow n], by linarith, ?_⟩
    unfold coulombCanonicalBasisErrorConstant
    linarith
  have hMono : Antitone energy := by
    intro i j hij
    exact (hSpec i).antitone_integer (hSpec j) hL (by omega)
  have hLimit : Tendsto energy atTop (𝓝 (E σ₀)) :=
    molecularCubicRate_tendsto energy (E σ₀)
      (coulombCanonicalBasisErrorConstant sys (E σ₀) L) m0
      (fun n => (hBounds n).2.1) (fun n => (hBounds n).2.2.2)
  have hBdd : BddBelow (Set.range energy) := by
    refine ⟨E σ₀, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact hLow n
  have hInf : E σ₀ = (⨅ n : ℕ, energy n) :=
    tendsto_nhds_unique hLimit (tendsto_atTop_ciInf hMono hBdd)
  refine ⟨E σ₀, _, HasCoulombSpinGroundPair.of_sectors E ψ hPair σ₀ hσ₀ hmin, m0, hm0,
    energy, hSpec, hMono, hLimit, hInf, ?_⟩
  intro n
  obtain ⟨hCard, hNonneg, hRate, hNRate⟩ := hBounds n
  exact ⟨hCard, hNonneg, hRate, hNRate, by linarith, hLow n⟩

/-- The data-only certificate applies to every ground pair on the spin-inclusive space and
every attained cubic minimum above the threshold. -/
theorem coulombSpin_data_bound_for_ground_pair (sys : CoulombSystem eta ν) {D : ℕ}
    {dim : ℕ → ℕ} (hdim : ∀ a, 0 < dim (sys.species a) ∧ dim (sys.species a) ≤ D)
    (L : ℝ) (hL : 0 < L) (Ψ : CoulombSpinL2 eta D) (E : ℝ)
    (hPair : HasCoulombSpinGroundPair sys dim L Ψ E)
    (m : ℕ) (hm : coulombDataCubicThreshold sys L ≤ m) :
    (∃ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
      0 ≤ EN - E ∧
      EN - E ≤ coulombDataCubicErrorConstant sys L /
        ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
      EN - E ≤ coulombDataBasisErrorConstant sys L /
        (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨E0, Ψ0, hPair0, _hBudget, hCubic⟩ := coulombSpin_data_cubic_error sys D dim hdim L hL
  have hE : E0 = E := hPair0.energy_unique hPair
  subst E0
  obtain ⟨EN0, hEN0, hCard, hNonneg, hRate, hNRate⟩ := hCubic m hm
  refine ⟨⟨EN0, hEN0⟩, ?_⟩
  intro EN hEN
  have hENeq : EN = EN0 := hEN.unique hEN0
  subst EN
  exact ⟨hCard, hNonneg, hRate, hNRate⟩

/-- The basis-count budget certifies the requested energy interval on the spin-inclusive
space. -/
theorem coulombSpin_data_accuracy_of_basis_budget (sys : CoulombSystem eta ν) {D : ℕ}
    {dim : ℕ → ℕ} (hdim : ∀ a, 0 < dim (sys.species a) ∧ dim (sys.species a) ≤ D)
    (L : ℝ) (hL : 0 < L) (Ψ : CoulombSpinL2 eta D) (E : ℝ)
    (hPair : HasCoulombSpinGroundPair sys dim L Ψ E)
    (ε : ℝ) (m : ℕ) (hm : coulombDataCubicThreshold sys L ≤ m)
    (hBudget : coulombDataBasisErrorConstant sys L ≤ ε * (((2 * m + 1) ^ 3 : ℕ) : ℝ)) :
    (∃ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  obtain ⟨hExists, hEvery⟩ :=
    coulombSpin_data_bound_for_ground_pair sys hdim L hL Ψ E hPair m hm
  refine ⟨hExists, ?_⟩
  intro EN hEN
  obtain ⟨_hCard, hNonneg, _hRate, hNRate⟩ := hEvery EN hEN
  exact cubicEnergy_interval_of_count_budget E EN
    (coulombDataBasisErrorConstant sys L) (((2 * m + 1) ^ 3 : ℕ) : ℝ) ε
    (by positivity) hNonneg hNRate hBudget

/-- The explicit data threshold certifies every positive accuracy on the spin-inclusive
space. -/
theorem coulombSpin_data_accuracy_for_ground_pair (sys : CoulombSystem eta ν) {D : ℕ}
    {dim : ℕ → ℕ} (hdim : ∀ a, 0 < dim (sys.species a) ∧ dim (sys.species a) ≤ D)
    (L : ℝ) (hL : 0 < L) (Ψ : CoulombSpinL2 eta D) (E : ℝ)
    (hPair : HasCoulombSpinGroundPair sys dim L Ψ E)
    (ε : ℝ) (hε : 0 < ε) (m : ℕ) (hm : coulombDataAccuracyThreshold sys L ε ≤ m) :
    (∃ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsCoulombSpinCubicGroundEnergy sys D dim L
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  have hmBase : coulombDataCubicThreshold sys L ≤ m := (le_max_left _ _).trans hm
  have hmBudget : Nat.ceil (coulombDataBasisErrorConstant sys L / ε) ≤ m :=
    (le_max_right _ _).trans hm
  exact coulombSpin_data_accuracy_of_basis_budget sys hdim L hL Ψ E hPair ε m hmBase
    (molecularCubicCount_accuracy_budget_of_ceil
      (coulombDataBasisErrorConstant sys L) ε hε m hmBudget)

/-! ## The Born--Oppenheimer electronic space as an instance -/

omit [Fintype ν] in
/-- With two spin states per electron, the physical states of the Born--Oppenheimer system
are the fermionic states of the electronic space. -/
theorem isCoulombSpinSector_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (Ψ : MolecularSpinL2 eta) :
    IsCoulombSpinSector (CoulombSystem.bo eta data) (fun _ => 2) Ψ ↔ IsSpinFermionic Ψ := by
  rw [IsCoulombSpinSector, CoulombSystem.bo_sign_eq]
  constructor
  · intro h i j hij σ
    filter_upwards [h.1 i j hij rfl σ] with x hx
    rw [hx, neg_one_mul]
  · intro h
    refine ⟨?_, ?_⟩
    · intro i j hij _ σ
      filter_upwards [h i j hij σ] with x hx
      rw [hx, neg_one_mul]
    · intro σ a ha
      exact absurd ha (not_le.mpr (σ a).isLt)

theorem hasCoulombSpinHamiltonian_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ)
    (Ψ Φ : MolecularSpinL2 eta) :
    HasCoulombSpinHamiltonian (CoulombSystem.bo eta data) L Ψ Φ ↔
      HasMolecularSpinCoulombHamiltonian eta L data Ψ Φ :=
  forall_congr' fun σ => hasCoulombHamiltonian_bo eta data L (Ψ σ) (Φ σ)

theorem hasCoulombSpinGroundPair_bo (eta : ℕ) (data : FiniteBONuclearData ν) (L : ℝ)
    (Ψ : MolecularSpinL2 eta) (E : ℝ) :
    HasCoulombSpinGroundPair (CoulombSystem.bo eta data) (fun _ => 2) L Ψ E ↔
      HasMolecularSpinGroundPair eta L data Ψ E := by
  constructor
  · rintro ⟨hS, hN, hH, hLow⟩
    refine ⟨(isCoulombSpinSector_bo eta data Ψ).mp hS, hN,
      (hasCoulombSpinHamiltonian_bo eta data L _ _).mp hH, ?_⟩
    intro F G hF hG
    exact hLow F G ((isCoulombSpinSector_bo eta data F).mpr hF)
      ((hasCoulombSpinHamiltonian_bo eta data L F G).mpr hG)
  · rintro ⟨hS, hN, hH, hLow⟩
    refine ⟨(isCoulombSpinSector_bo eta data Ψ).mpr hS, hN,
      (hasCoulombSpinHamiltonian_bo eta data L _ _).mpr hH, ?_⟩
    intro F G hF hG
    exact hLow F G ((isCoulombSpinSector_bo eta data F).mp hF)
      ((hasCoulombSpinHamiltonian_bo eta data L F G).mp hG)

theorem isCoulombSpinCubicGroundEnergy_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (L K EN : ℝ) :
    IsCoulombSpinCubicGroundEnergy (CoulombSystem.bo eta data) 2 (fun _ => 2) L K EN ↔
      IsMolecularSpinCubicGroundEnergy eta L data K EN := by
  constructor
  · rintro ⟨hLow, F, G, hS, hC, hN, hH, hE⟩
    refine ⟨?_, F, G, (isCoulombSpinSector_bo eta data F).mp hS, hC, hN,
      (hasCoulombSpinHamiltonian_bo eta data L F G).mp hH, hE⟩
    intro F' G' hF' hC' hG'
    exact hLow F' G' ((isCoulombSpinSector_bo eta data F').mpr hF') hC'
      ((hasCoulombSpinHamiltonian_bo eta data L F' G').mpr hG')
  · rintro ⟨hLow, F, G, hS, hC, hN, hH, hE⟩
    refine ⟨?_, F, G, (isCoulombSpinSector_bo eta data F).mpr hS, hC, hN,
      (hasCoulombSpinHamiltonian_bo eta data L F G).mpr hH, hE⟩
    intro F' G' hF' hC' hG'
    exact hLow F' G' ((isCoulombSpinSector_bo eta data F').mp hF') hC'
      ((hasCoulombSpinHamiltonian_bo eta data L F' G').mp hG')

omit [Fintype ν] in
lemma CoulombSystem.bo_spinDim (eta : ℕ) (data : FiniteBONuclearData ν) (a : Fin eta) :
    0 < (fun _ : ℕ => 2) ((CoulombSystem.bo eta data).species a) ∧
      (fun _ : ℕ => 2) ((CoulombSystem.bo eta data).species a) ≤ 2 :=
  ⟨two_pos, le_rfl⟩

end SpinSpace

end
