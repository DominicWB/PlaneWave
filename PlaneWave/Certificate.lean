/-- Multiplication of an L2 potential by any continuous torus test function
is in L2. The potential itself need not be bounded. -/
theorem torusPotential_mul_continuousMap_memLp {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume)
    (φ : C(UnitAddTorus d, ℂ)) :
    MemLp (fun x => V x * φ x) 2 volume := by
  have hMeas : AEStronglyMeasurable (fun x => V x * φ x) volume :=
    hV.1.fun_mul φ.continuous.aestronglyMeasurable
  have hScaled : MemLp (fun x => (‖φ‖ : ℂ) * V x) 2 volume :=
    hV.const_mul (‖φ‖ : ℂ)
  apply hScaled.of_le hMeas
  filter_upwards with x
  rw [norm_mul, norm_mul, Complex.norm_of_nonneg (norm_nonneg φ), mul_comm ‖φ‖]
  exact mul_le_mul_of_nonneg_left (φ.norm_coe_le_norm x) (norm_nonneg (V x))

/-- The actual pointwise product of an L2 potential and a continuous test,
as an L2 equivalence class. -/
def torusPotentialContinuousProduct {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume)
    (φ : C(UnitAddTorus d, ℂ)) : Lp ℂ 2 (volume : Measure (UnitAddTorus d)) :=
  (torusPotential_mul_continuousMap_memLp V hV φ).toLp (fun x => V x * φ x)

theorem torusPotentialContinuousProduct_coeFn {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume)
    (φ : C(UnitAddTorus d, ℂ)) :
    (torusPotentialContinuousProduct V hV φ : UnitAddTorus d → ℂ) =ᵐ[volume]
      (fun x => V x * φ x) :=
  MemLp.coeFn_toLp (torusPotential_mul_continuousMap_memLp V hV φ)

/-- The continuous-test product has precisely the pointwise multiplication
graph, with the input interpreted as its L2 class. -/
theorem torusPotentialContinuousProduct_graph {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume)
    (φ : C(UnitAddTorus d, ℂ)) :
    HasL2PointwisePotential volume V ((ContinuousMap.toLp 2 volume ℂ) φ)
      (torusPotentialContinuousProduct V hV φ) := by
  filter_upwards [torusPotentialContinuousProduct_coeFn V hV φ,
    ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) volume φ] with x hProduct hTest
  exact hProduct.trans (congrArg (fun z : ℂ => V x * z) hTest.symm)

/-- A continuous H2-to-L2 operator is pointwise multiplication by V on the
whole H2 domain exactly when this holds on every Fourier truncation.
This is an extension theorem, not an assertion of the remaining Coulomb
core identity. No global boundedness assumption on V is used. -/
theorem molecularPositionH2Operator_pointwise_iff_core (eta : ℕ) (g : ℝ)
    (V : MolecularPositionTorus eta → ℂ)
    (W : MolecularFourierH2 eta →L[ℂ] MolecularPositionL2 eta) :
    (∀ u : MolecularFourierH2 eta,
      HasL2PointwisePotential volume V (molecularPositionH2StateMap eta g u) (W u)) ↔
    (∀ (N : ℕ) (u : MolecularFourierH2 eta),
      HasL2PointwisePotential volume V
        (molecularPositionH2StateMap eta g (molecularH2Truncate N u))
        (W (molecularH2Truncate N u))) := by
  constructor
  · intro h N u
    exact h (molecularH2Truncate N u)
  · intro h u
    apply HasL2PointwisePotential.of_tendsto (fun N => h N u)
    · exact ((molecularPositionH2StateMap eta g).continuous.tendsto u).comp
        (molecularH2Truncate_tendsto u)
    · exact (W.continuous.tendsto u).comp (molecularH2Truncate_tendsto u)

