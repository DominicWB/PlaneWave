/-- The mass-weighted `H¹` integrand `(1 + 2 kin(p)) |c_p|²`. -/
noncomputable def h1f (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) : ℝ :=
  (1 + 2 * coulombKineticEnergySymbol sys (2 * Real.pi / L) p) *
    ‖molecularH2Coeff (2 * Real.pi / L) u p‖ ^ 2

omit [Fintype ν] in
lemma h1f_nonneg (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    0 ≤ h1f sys L u p :=
  mul_nonneg (by linarith [coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p])
    (sq_nonneg _)

