  set l := cubeLift (2 * Real.pi / L) n φ
  set x := u s - molecularH2Truncate n (u s)
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set W := coulombFourierPotentialH2 sys (2 * Real.pi / L) H
  have hpair : ⟪r s, φ⟫_ℂ = ⟪S (u s) - molecularH2Truncate n (S (u s)),
      W l - molecularH2Truncate n (W l)⟫_ℂ := by
    have hSx : S x = S (u s) - molecularH2Truncate n (S (u s)) := by
      show S (u s - molecularH2Truncate n (u s)) = _
      rw [map_sub, stateMap_truncate]
    change ⟪extractCLM n (W x), φ⟫_ℂ = _
    rw [inner_extract_left, ← stateMap_cubeLift (2 * Real.pi / L) n φ,
        ← potential_symm sys L H hKernel,
      hSx, inner_sub_truncate_left]
  rw [hpair]
  refine (norm_inner_le_norm _ _).trans ?_
  have htails := fun b => tails_at_time sys L H hKernel Hunit hL hPeriodic hC U
      hgraph b K rho Blow Cs
    Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude hBkerScale hCsScale u₀ v₀ huv s (u s)
    (hu1 s) (hu2 s)
  have hδ : ‖S (u s) - molecularH2Truncate n (S (u s))‖ ≤ eta * tK := by
    refine (norm_sub_truncate_le hg n _).trans ?_
    calc ∑ b : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) b (S (u s))‖
        ≤ ∑ _b : Fin eta, tK := Finset.sum_le_sum fun b _ => (htails b).2
      _ = eta * tK := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hl : ‖l‖ ≤ Mw :=
    (cubeFlow_h2norm_le sys L H hKernel Hunit hL hPeriodic hC n UN hNcomm w (s - t)).trans hMw
  have hΛ : ‖W l - molecularH2Truncate n (W l)‖ ≤
      eta * (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker Mw * rho) := by
    refine (norm_sub_truncate_le hg n _).trans ?_
    calc ∑ b : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) b (W l)‖
        ≤ ∑ _b : Fin eta, finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker Mw * rho :=
          Finset.sum_le_sum fun b _ => potential_tail_le sys L H hKernel Hunit hL hPeriodic b K rho
            Blow Cs Bker Mw hK1 hRho hRhoScale hBlow hCs hBker hMw0 h2gK hAmplitude hBkerScale
