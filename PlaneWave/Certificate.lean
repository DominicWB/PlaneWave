/-- Membership is exactly simultaneous coordinate bounds on every particle. -/
lemma mem_fourierConfigCube_iff (eta count : ℕ) (p : FourierConfig eta Lattice3) :
    p ∈ fourierConfigCube eta count ↔
      ∀ i : Fin eta, ∀ d : Fin 3,
        -(count : ℤ) ≤ p i d ∧ p i d ≤ (count : ℤ) := by
  classical
  constructor
  · intro hp
    rcases Finset.mem_image.mp hp with ⟨v, _hv, rfl⟩
    intro i d
    exact finitePlaneWaveLatticeIndex_coord_bounds count (v i) d
  · intro hp
    have hModes : ∀ i : Fin eta, ∃ v : FinitePlaneWaveMode count,
        finitePlaneWaveLatticeIndex count v = p i := by
      intro i
      exact exists_finitePlaneWaveMode_of_coord_bounds count (p i) (hp i)
    choose v hv using hModes
    exact Finset.mem_image.mpr ⟨v, Finset.mem_univ v, funext hv⟩

lemma fourierConfigCube_mono (eta : ℕ) : Monotone (fourierConfigCube eta) := by
  intro m n hmn p hp
  apply (mem_fourierConfigCube_iff eta n p).mpr
  have hBounds := (mem_fourierConfigCube_iff eta m p).mp hp
  intro i d
  have h := hBounds i d
  constructor <;> omega

/-- An explicit, possibly nonminimal coordinate radius for a configuration. -/
def fourierConfigRadius {eta : ℕ} (p : FourierConfig eta Lattice3) : ℕ :=
  ∑ i : Fin eta, ∑ d : Fin 3, ((p i d).toNat + (-p i d).toNat)

lemma mem_fourierConfigCube_radius {eta : ℕ} (p : FourierConfig eta Lattice3) :
    p ∈ fourierConfigCube eta (fourierConfigRadius p) := by
  classical
  apply (mem_fourierConfigCube_iff eta _ p).mpr
  intro i d
  have hInner : (p i d).toNat + (-p i d).toNat ≤
      ∑ j : Fin 3, ((p i j).toNat + (-p i j).toNat) :=
    Finset.single_le_sum
      (fun j _hj => Nat.zero_le ((p i j).toNat + (-p i j).toNat))
      (Finset.mem_univ d)
  have hOuter : (∑ j : Fin 3, ((p i j).toNat + (-p i j).toNat)) ≤
      fourierConfigRadius p :=
    Finset.single_le_sum
      (fun a _ha =>
        Nat.zero_le (∑ j : Fin 3, ((p a j).toNat + (-p a j).toNat)))
      (Finset.mem_univ i)
  have h := hInner.trans hOuter
  constructor <;> omega

lemma exists_mem_fourierConfigCube {eta : ℕ} (p : FourierConfig eta Lattice3) :
    ∃ count : ℕ, p ∈ fourierConfigCube eta count :=
  ⟨fourierConfigRadius p, mem_fourierConfigCube_radius p⟩

lemma mem_fourierConfigCube_swap_iff {eta : ℕ} (count : ℕ)
    (i j : Fin eta) (p : FourierConfig eta Lattice3) :
    swapConfig i j p ∈ fourierConfigCube eta count ↔
      p ∈ fourierConfigCube eta count := by
  rw [mem_fourierConfigCube_iff, mem_fourierConfigCube_iff]
  constructor
  · intro hp a d
    simpa [swapConfig] using hp ((Equiv.swap i j) a) d
  · intro hp a d
    exact hp ((Equiv.swap i j) a) d

/-- Truncate an arbitrary infinite coefficient family to the literal integer cube. -/
def cubicLatticeCoeffTruncate {eta : ℕ} (count : ℕ)
    (coeff : FourierConfig eta Lattice3 → ℂ) : FourierConfig eta Lattice3 → ℂ := by
  classical
  exact fun p => if p ∈ fourierConfigCube eta count then coeff p else 0

lemma cubicLatticeCoeffTruncate_eq_of_mem {eta : ℕ} (count : ℕ)
    (coeff : FourierConfig eta Lattice3 → ℂ) (p : FourierConfig eta Lattice3)
    (hp : p ∈ fourierConfigCube eta count) :
    cubicLatticeCoeffTruncate count coeff p = coeff p := by
  classical
  simp only [cubicLatticeCoeffTruncate, if_pos hp]

lemma cubicLatticeCoeffTruncate_eq_zero_of_not_mem {eta : ℕ} (count : ℕ)
    (coeff : FourierConfig eta Lattice3 → ℂ) (p : FourierConfig eta Lattice3)
    (hp : p ∉ fourierConfigCube eta count) :
    cubicLatticeCoeffTruncate count coeff p = 0 := by
  classical
  simp only [cubicLatticeCoeffTruncate, if_neg hp]

/-- Restrict an infinite family to the exact finite mode indexing used by the
compiler-confirmed molecular matrices. -/
def finiteFourierCoeffExtract {eta : ℕ} (count : ℕ)
    (coeff : FourierConfig eta Lattice3 → ℂ) :
    FourierConfig eta (FinitePlaneWaveMode count) → ℂ :=
  fun p => coeff (finiteConfigLatticeIndex eta count p)

lemma finiteConfigLatticeIndex_swap {eta : ℕ} (count : ℕ) (i j : Fin eta)
    (p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteConfigLatticeIndex eta count (swapConfig i j p) =
      swapConfig i j (finiteConfigLatticeIndex eta count p) := by
  funext a
  rfl

end
end PlaneWaveCertificate

