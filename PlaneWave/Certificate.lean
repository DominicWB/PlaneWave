/-! ## One-hundred-sixth milestone: ambient regularized integration by parts

The finite-interval identity from milestone 105 is first promoted to an integral
on the whole coordinate line, using the actual support of the derivative density.
A measure-preserving coordinate split and Fubini then give its zero integral over
ambient three-space.  Finally we sum the three coordinate identities.

No Fubini identity, integration-by-parts identity, or Hardy inequality is added
as an analytic hypothesis.  Ambient integrability comes from milestone 105.
-/

/-- The derivative density on a coordinate line vanishes outside its support
interval, including the left endpoint.  The half-open interval is convenient for
identifying its interval integral with its integral over the whole real line. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivativeSlice_support_subset
    {α : Type} [Fintype α]
    {rho R : ℝ} (hRhoR : rho < R)
    (eps : ℝ) (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3) :
    Function.support
        (centeredCube3RadialCutoffRegularizedFluxDerivativeSlice
          rho R eps index f x j) ⊆
      Set.Ioc (-R - x j) (R - x j) := by
  intro t ht
  change
    centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j
      (x + t • hardyCoordinateDirection j) ≠ 0 at ht
  have hInside :
      centeredCube3AmbientRadius (x + t • hardyCoordinateDirection j) < R := by
    by_contra h
    exact ht
      (centeredCube3RadialCutoffRegularizedFluxDerivative_eq_zero_of_outer_le
        hRhoR eps index f j (x + t • hardyCoordinateDirection j)
        (le_of_not_gt h))
  have hAbs : |x j + t| < R :=
    lt_of_le_of_lt (centeredCube3AmbientRadius_coordinate_ge_abs x j t) hInside
  rcases abs_lt.mp hAbs with ⟨hLeft, hRight⟩
  constructor <;> linarith

/-- The coordinate flux derivative has zero integral on the entire real line,
not just on the bounded interval used for the fundamental theorem of calculus. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivativeSlice_integral_eq_zero
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) (j : Fin 3) :
    (∫ t : ℝ,
      centeredCube3RadialCutoffRegularizedFluxDerivativeSlice
        rho R eps index f x j t) = 0 := by
  have hSupport :=
    centeredCube3RadialCutoffRegularizedFluxDerivativeSlice_support_subset
      hRhoR eps index f x j
  calc
    (∫ t : ℝ,
        centeredCube3RadialCutoffRegularizedFluxDerivativeSlice
          rho R eps index f x j t) =
        (∫ t in (-R - x j)..(R - x j),
          centeredCube3RadialCutoffRegularizedFluxDerivativeSlice
            rho R eps index f x j t) :=
      (intervalIntegral.integral_eq_integral_of_support_subset
        (μ := volume) hSupport).symm
    _ = 0 :=
      centeredCube3RadialCutoffRegularizedFluxSlice_integral_derivative_eq_zero
        hrho hRhoR hOuterHalf heps index f x j

/-- Separate one coordinate from the remaining two.  The inverse inserts the
moving coordinate into a transverse pair.  This is an actual measurable
equivalence, with the standard product Lebesgue measure on both sides. -/
noncomputable def hardyCoordinateMeasureEquiv
    (j : Fin 3) :
    CenteredCube3Ambient ≃ᵐ (ℝ × (Fin 2 → ℝ)) :=
  MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) j

lemma hardyCoordinateMeasureEquiv_measurePreserving
    (j : Fin 3) :
    MeasurePreserving (hardyCoordinateMeasureEquiv j) volume volume := by
  unfold hardyCoordinateMeasureEquiv
  exact volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) j

lemma hardyCoordinateMeasureEquiv_symm_measurePreserving
    (j : Fin 3) :
    MeasurePreserving (hardyCoordinateMeasureEquiv j).symm volume volume := by
  exact MeasurePreserving.symm (hardyCoordinateMeasureEquiv j)
    (hardyCoordinateMeasureEquiv_measurePreserving j)

/-- Pointwise form of the inverse coordinate split. -/
lemma hardyCoordinateMeasureEquiv_symm_apply
    (j : Fin 3) (t : ℝ) (y : Fin 2 → ℝ) :
    (hardyCoordinateMeasureEquiv j).symm (t, y) = j.insertNth t y := by
  rfl

/-- A fiber of the product-coordinate equivalence is the same affine line used
by the derivative and fundamental-theorem calculations.  Its base point has
moving coordinate zero; no translation factor or Jacobian is introduced. -/
lemma hardyCoordinateMeasureEquiv_symm_coordinateLine
    (j : Fin 3) (y : Fin 2 → ℝ) (t : ℝ) :
    (hardyCoordinateMeasureEquiv j).symm (t, y) =
      (hardyCoordinateMeasureEquiv j).symm ((0 : ℝ), y) +
        t • hardyCoordinateDirection j := by
  simp only [hardyCoordinateMeasureEquiv_symm_apply]
  rw [add_smul_hardyCoordinateDirection_eq_update]
  simp only [Fin.insertNth_apply_same, zero_add, Fin.update_insertNth]

/-- Fubini in a chosen coordinate direction: an ambient integrable function
whose affine coordinate-line integrals all vanish has zero ambient integral.
The integrability premise is essential and will be discharged for the actual
flux density using the theorem proved in milestone 105. -/
lemma hardyCoordinate_integral_eq_zero_of_slices
    (j : Fin 3) (g : CenteredCube3Ambient → ℝ)
    (hg : Integrable g volume)
    (hSlices : ∀ x : CenteredCube3Ambient,
      (∫ t : ℝ, g (x + t • hardyCoordinateDirection j)) = 0) :
    (∫ x : CenteredCube3Ambient, g x) = 0 := by
  have hPres := hardyCoordinateMeasureEquiv_symm_measurePreserving j
  have hPull :
      Integrable
        (fun z : ℝ × (Fin 2 → ℝ) =>
          g ((hardyCoordinateMeasureEquiv j).symm z))
        ((volume : Measure ℝ).prod (volume : Measure (Fin 2 → ℝ))) := by
    change Integrable
      (g ∘ (hardyCoordinateMeasureEquiv j).symm)
      (volume : Measure (ℝ × (Fin 2 → ℝ)))
    exact hPres.integrable_comp_of_integrable hg
  have hFiber : ∀ y : Fin 2 → ℝ,
      (∫ t : ℝ, g ((hardyCoordinateMeasureEquiv j).symm (t, y))) = 0 := by
    intro y
    calc
      (∫ t : ℝ, g ((hardyCoordinateMeasureEquiv j).symm (t, y))) =
          (∫ t : ℝ,
            g ((hardyCoordinateMeasureEquiv j).symm ((0 : ℝ), y) +
              t • hardyCoordinateDirection j)) := by
        apply integral_congr_ae
        filter_upwards with t
        exact congrArg g (hardyCoordinateMeasureEquiv_symm_coordinateLine j y t)
      _ = 0 := hSlices ((hardyCoordinateMeasureEquiv j).symm ((0 : ℝ), y))
  calc
    (∫ x : CenteredCube3Ambient, g x) =
        (∫ z : ℝ × (Fin 2 → ℝ), g ((hardyCoordinateMeasureEquiv j).symm z)) :=
      (hPres.integral_comp' g).symm
    _ = (∫ y : Fin 2 → ℝ,
          ∫ t : ℝ, g ((hardyCoordinateMeasureEquiv j).symm (t, y))) :=
      integral_prod_symm _ hPull
    _ = 0 := by
      simp only [hFiber, integral_zero]

/-- Ambient zero integral of each actual coordinate flux derivative.  All
analytic premises of the Fubini step are now supplied by the preceding
milestones; this is not an assumed integration-by-parts interface. -/
lemma centeredCube3RadialCutoffRegularizedFluxDerivative_integral_eq_zero
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) (j : Fin 3) :
    (∫ x : CenteredCube3Ambient,
      centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j x) = 0 := by
  apply hardyCoordinate_integral_eq_zero_of_slices j
    (centeredCube3RadialCutoffRegularizedFluxDerivative rho R eps index f j)
    (centeredCube3RadialCutoffRegularizedFluxDerivative_integrable
      hrho hRhoR heps index f j)
  intro x
  simpa only [centeredCube3RadialCutoffRegularizedFluxDerivativeSlice] using
    centeredCube3RadialCutoffRegularizedFluxDerivativeSlice_integral_eq_zero
      hrho hRhoR hOuterHalf heps index f x j

/-- Each signed coordinate-divergence energy is integrable.  The pointwise
bound by the regularized weighted energy is used before splitting the integral
of the flux derivative into its two summands. -/
lemma hardyRegularizedCoordinateDivergence_mul_sq_integrable
    {eps : ℝ} (heps : 0 < eps) (j : Fin 3)
    (u : CenteredCube3Ambient → ℂ)
    (hu : Integrable (fun x : CenteredCube3Ambient => ‖u x‖ ^ 2) volume) :
    Integrable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedCoordinateDivergence eps j x * ‖u x‖ ^ 2) volume := by
  have hD : Measurable (hardyRegularizedCoordinateDivergence eps j) := by
    unfold hardyRegularizedCoordinateDivergence hardyRegularizedDenominator
      centeredCube3AmbientRadiusSq
    measurability
  have hMeas : AEStronglyMeasurable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedCoordinateDivergence eps j x * ‖u x‖ ^ 2) volume :=
    hD.aestronglyMeasurable.fun_mul hu.aestronglyMeasurable
  apply Integrable.mono' (hardyRegularizedWeight_mul_sq_integrable heps u hu) hMeas
  filter_upwards with x
  rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (sq_nonneg ‖u x‖)]
  exact mul_le_mul_of_nonneg_right
    (hardyRegularizedCoordinateDivergence_abs_le_weight heps x j) (sq_nonneg _)

/-- The real part of each actual complex cross term is integrable. -/
lemma centeredCube3RadialCutoffRegularizedCrossTerm_re_integrable
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) (j : Fin 3) :
    Integrable
      (fun x : CenteredCube3Ambient =>
        (hardyRegularizedComplexCrossTerm eps j
          (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
          (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x).re)
      volume := by
  exact (centeredCube3RadialCutoff_regularizedCrossTerm_integrable
    hrho hRhoR heps index f j).re

/-- The fully split coordinatewise integration-by-parts identity over ambient
three-space.  Both summands are integrable separately. -/
lemma centeredCube3RadialCutoff_regularized_coordinate_integrationByParts
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) (j : Fin 3) :
    (∫ x : CenteredCube3Ambient,
      hardyRegularizedCoordinateDivergence eps j x *
        ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) =
      -2 * (∫ x : CenteredCube3Ambient,
        (hardyRegularizedComplexCrossTerm eps j
          (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
          (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x).re) := by
  have hDiv := hardyRegularizedCoordinateDivergence_mul_sq_integrable heps j
    (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
    (centeredCube3RadialCutoffWaveZeroExtension_sq_integrable hRhoR index f)
  have hCross := centeredCube3RadialCutoffRegularizedCrossTerm_re_integrable
    hrho hRhoR heps index f j
  have hZero := centeredCube3RadialCutoffRegularizedFluxDerivative_integral_eq_zero
    hrho hRhoR hOuterHalf heps index f j
  unfold centeredCube3RadialCutoffRegularizedFluxDerivative
    hardyRegularizedFluxDerivative at hZero
  rw [integral_add hDiv (hCross.const_mul 2), integral_const_mul] at hZero
  linarith

/-- The total regularized-divergence energy is the pointwise sum of its three
coordinate energies.  This uses the actual divergence identity from milestone
94, not a fresh specification of the field. -/
lemma centeredCube3RadialCutoffRegularizedDivergenceEnergy_eq_sum
    {α : Type} [Fintype α]
    (rho R : ℝ) {eps : ℝ} (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ)
    (x : CenteredCube3Ambient) :
    hardyRegularizedDivergence eps x *
        ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2 =
      ∑ j : Fin 3,
        hardyRegularizedCoordinateDivergence eps j x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2 := by
  rw [← Finset.sum_mul, hardyRegularizedCoordinateDivergence_sum heps x]

/-- Finiteness of the total divergence energy, recorded explicitly for the
subsequent regularized Hardy estimate. -/
lemma centeredCube3RadialCutoffRegularizedDivergenceEnergy_integrable
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hRhoR : rho < R) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) :
    Integrable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedDivergence eps x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) volume := by
  have hEach : ∀ j : Fin 3, Integrable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedCoordinateDivergence eps j x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) volume := by
    intro j
    exact hardyRegularizedCoordinateDivergence_mul_sq_integrable heps j
      (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
      (centeredCube3RadialCutoffWaveZeroExtension_sq_integrable hRhoR index f)
  have hSum : Integrable
      (fun x : CenteredCube3Ambient =>
        ∑ j : Fin 3,
          hardyRegularizedCoordinateDivergence eps j x *
            ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) volume := by
    exact integrable_finsetSum (Finset.univ : Finset (Fin 3))
      (fun j _ => hEach j)
  apply hSum.congr
  filter_upwards with x
  exact (centeredCube3RadialCutoffRegularizedDivergenceEnergy_eq_sum
    rho R heps index f x).symm

/-- Three-dimensional regularized integration by parts for the original cutoff
wave, with the cross term written as a sum of three real integrals. -/
lemma centeredCube3RadialCutoff_regularized_integrationByParts
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) :
    (∫ x : CenteredCube3Ambient,
      hardyRegularizedDivergence eps x *
        ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) =
      -2 * (∑ j : Fin 3,
        ∫ x : CenteredCube3Ambient,
          (hardyRegularizedComplexCrossTerm eps j
            (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
            (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x).re) := by
  have hEach : ∀ j : Fin 3, Integrable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedCoordinateDivergence eps j x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) volume := by
    intro j
    exact hardyRegularizedCoordinateDivergence_mul_sq_integrable heps j
      (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
      (centeredCube3RadialCutoffWaveZeroExtension_sq_integrable hRhoR index f)
  calc
    (∫ x : CenteredCube3Ambient,
        hardyRegularizedDivergence eps x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) =
        (∫ x : CenteredCube3Ambient,
          ∑ j : Fin 3,
            hardyRegularizedCoordinateDivergence eps j x *
              ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) := by
      apply integral_congr_ae
      filter_upwards with x
      exact centeredCube3RadialCutoffRegularizedDivergenceEnergy_eq_sum
        rho R heps index f x
    _ = (∑ j : Fin 3,
          ∫ x : CenteredCube3Ambient,
            hardyRegularizedCoordinateDivergence eps j x *
              ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) :=
      integral_finsetSum (Finset.univ : Finset (Fin 3)) (fun j _ => hEach j)
    _ = (∑ j : Fin 3,
          -2 * (∫ x : CenteredCube3Ambient,
            (hardyRegularizedComplexCrossTerm eps j
              (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
              (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x).re)) := by
      apply Finset.sum_congr rfl
      intro j hj
      exact centeredCube3RadialCutoff_regularized_coordinate_integrationByParts
        hrho hRhoR hOuterHalf heps index f j
    _ = -2 * (∑ j : Fin 3,
          ∫ x : CenteredCube3Ambient,
            (hardyRegularizedComplexCrossTerm eps j
              (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
              (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x).re) := by
      rw [Finset.mul_sum]

/-- Equivalent single-integral form, convenient for the energy Cauchy--Schwarz
argument.  The finite sum may pass through the integral because each cross term
was already proved integrable. -/
lemma centeredCube3RadialCutoff_regularized_integrationByParts_integral_sum
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) :
    (∫ x : CenteredCube3Ambient,
      hardyRegularizedDivergence eps x *
        ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2) =
      -2 * (∫ x : CenteredCube3Ambient,
        ∑ j : Fin 3,
          (hardyRegularizedComplexCrossTerm eps j
            (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
            (centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j) x).re) := by
  rw [integral_finsetSum (Finset.univ : Finset (Fin 3))
    (fun j _ => centeredCube3RadialCutoffRegularizedCrossTerm_re_integrable
      hrho hRhoR heps index f j)]
  exact centeredCube3RadialCutoff_regularized_integrationByParts
    hrho hRhoR hOuterHalf heps index f

/-!
## One-hundred-sixth milestone

The regularized integration-by-parts identity now holds over all of ambient
three-space, not only on a coordinate interval.  The proof chain is:

* the actual derivative density is zero outside the coordinate support interval;
* the finite-interval FTC identity therefore gives a zero whole-line integral;
* the standard coordinate split preserves the exact product Lebesgue measure;
* ambient integrability justifies transverse Fubini;
* separate integrability of the divergence energy and cross term justifies
  splitting the coordinate identity and summing the three coordinates.

The conclusion for the original wave U and original raw gradients G_j is

`integral (div F_eps * |U|^2)
   = -2 * integral (sum_j Re(F_eps,j * conj(U) * G_j))`.

No coordinate identity or integration-by-parts statement is assumed for U.
The generic Fubini helper's premises are all discharged at its specialization.
The auxiliary coefficient supremum bounds are still used only for integrability;
no coefficient-dependent constant has entered this exact identity.

The energy Cauchy--Schwarz step, the limit eps -> 0, and the final identification
with the centered-cube L2 norm formulation remain before Hardy itself is closed.
-/

end

end PlaneWaveCertificate

