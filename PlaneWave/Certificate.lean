/-- A surjective continuous additive map between finite unit tori preserves
their normalized Haar measures. The normalization removes the scalar in Haar
uniqueness. -/
theorem unitAddTorus_measurePreserving_of_surjective_addHom
    {d e : Type*} [Fintype d] [Fintype e]
    (f : UnitAddTorus d →+ UnitAddTorus e)
    (hf : Continuous f) (hsurj : Function.Surjective f) :
    MeasurePreserving f (volume : Measure (UnitAddTorus d)) volume := by
  letI : Measure.IsAddLeftInvariant
      (Measure.map f (volume : Measure (UnitAddTorus d))) :=
    isAddLeftInvariant_map f.toAddHom hf.measurable hsurj
  refine ⟨hf.measurable, ?_⟩
  have h := measure_eq_sub_vadd
    (Measure.map f (volume : Measure (UnitAddTorus d)))
    (volume : Measure (UnitAddTorus e))
    (s := Set.univ) (by simp) (by simp)
