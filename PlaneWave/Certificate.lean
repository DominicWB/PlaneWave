-- BEGIN RELEASE SOURCE 150c: Born--Oppenheimer spin theorems as instances
section ReleaseMilestone150c

/-!
# Milestone 150c: the Born--Oppenheimer spin theorems as instances

Four theorems of milestone 143 on the electronic space `Λ^η(L²(T³) ⊗ ℂ²)`, those behind
the main Born--Oppenheimer entry points, with their statements unchanged. Each is derived from the theorem for the spin-inclusive space of a
Coulomb system (milestone 150b) at `CoulombSystem.bo eta data` with spin values in `Fin 2`
and two spin states per electron, using the agreement at that system of the physical
states, the Hamiltonian, the ground pair and the cubic Ritz energy (`isCoulombSpinSector_bo`,
`hasCoulombSpinHamiltonian_bo`, `hasCoulombSpinGroundPair_bo`,
`isCoulombSpinCubicGroundEnergy_bo`) and of the budgets, constants and thresholds
(milestone 149).
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology

noncomputable section

/-- The physical ground pair on the electronic space `Λ^η(L²(T³) ⊗ ℂ²)` and
the cubic error bounds, with the same data-only constants and threshold as
every exchange sector. -/
theorem molecularSpin_cubic_error {ν : Type*} [Fintype ν] (eta : ℕ) (_heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ Ψ : MolecularSpinL2 eta,
      HasMolecularSpinGroundPair eta L data Ψ E ∧
      |E| ≤ molecularGroundEnergyBudget eta data L ∧
      ∀ m : ℕ, molecularDataCubicThreshold eta data L ≤ m →
        ∃ EN : ℝ, IsMolecularSpinCubicGroundEnergy eta L data
          ((2 * Real.pi / L) * (m : ℝ)) EN ∧
          (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
          0 ≤ EN - E ∧
          EN - E ≤ molecularDataCubicErrorConstant eta data L /
            ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
          EN - E ≤ molecularDataBasisErrorConstant eta data L /
            (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨E, Ψ, hPair, hBudget, hCubic⟩ := coulombSpin_data_cubic_error
    (CoulombSystem.bo eta data) 2 (fun _ => 2) (CoulombSystem.bo_spinDim eta data) L hL
  rw [coulombGroundEnergyBudget_bo] at hBudget
  refine ⟨E, Ψ, (hasCoulombSpinGroundPair_bo eta data L Ψ E).mp hPair, hBudget, ?_⟩
  intro m hm
  rw [← coulombDataCubicThreshold_bo] at hm
  obtain ⟨EN, hEN, hCard, hNonneg, hRate, hCountRate⟩ := hCubic m hm
  rw [coulombDataCubicErrorConstant_bo] at hRate
  rw [coulombDataBasisErrorConstant_bo] at hCountRate
  exact ⟨EN, (isCoulombSpinCubicGroundEnergy_bo eta data L _ EN).mp hEN, hCard, hNonneg,
    hRate, hCountRate⟩

/-- Monotone convergence of the cubic Ritz energies on the electronic space,
their infimum, and certified error intervals with the energy-dependent
constants. -/
theorem molecularSpin_cubic_convergence {ν : Type*} [Fintype ν] (eta : ℕ) (_heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ Ψ : MolecularSpinL2 eta,
      HasMolecularSpinGroundPair eta L data Ψ E ∧
      ∃ m0 : ℕ, 1 ≤ m0 ∧ ∃ energy : ℕ → ℝ,
        (∀ n : ℕ, IsMolecularSpinCubicGroundEnergy eta L data
          ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) (energy n)) ∧
        Antitone energy ∧
        Filter.Tendsto energy Filter.atTop (nhds E) ∧
        E = (⨅ n : ℕ, energy n) ∧
        ∀ n : ℕ,
          (cubicPlaneWaveBox (m0 + n)).card = (2 * (m0 + n) + 1) ^ 3 ∧
          0 ≤ energy n - E ∧
          energy n - E ≤ molecularCanonicalCubicErrorConstant eta data E L /
            ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) ^ 3 ∧
          energy n - E ≤ molecularCanonicalBasisErrorConstant eta data E L /
            (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ∧
          energy n - molecularCanonicalBasisErrorConstant eta data E L /
              (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ≤ E ∧
          E ≤ energy n := by
  obtain ⟨E, Ψ, hPair, m0, hm0, energy, hSpec, hMono, hLimit, hInf, hBounds⟩ :=
    coulombSpin_cubic_convergence (CoulombSystem.bo eta data) 2 (fun _ => 2)
      (CoulombSystem.bo_spinDim eta data) L hL
  refine ⟨E, Ψ, (hasCoulombSpinGroundPair_bo eta data L Ψ E).mp hPair, m0, hm0,
    energy, fun n => (isCoulombSpinCubicGroundEnergy_bo eta data L _ _).mp (hSpec n),
    hMono, hLimit, hInf, ?_⟩
  intro n
  simpa only [coulombCanonicalCubicErrorConstant_bo, coulombCanonicalBasisErrorConstant_bo]
    using hBounds n

/-- The basis-count budget certifies the requested energy interval on the
electronic space. -/
theorem molecularSpin_data_accuracy_of_basis_budget {ν : Type*} [Fintype ν] (eta : ℕ)
    (_heta : 0 < eta) (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L)
    (Ψ : MolecularSpinL2 eta) (E : ℝ)
    (hPair : HasMolecularSpinGroundPair eta L data Ψ E)
    (ε : ℝ) (m : ℕ) (hm : molecularDataCubicThreshold eta data L ≤ m)
    (hBudget : molecularDataBasisErrorConstant eta data L ≤
      ε * (((2 * m + 1) ^ 3 : ℕ) : ℝ)) :
    (∃ EN : ℝ, IsMolecularSpinCubicGroundEnergy eta L data
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsMolecularSpinCubicGroundEnergy eta L data
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  rw [← coulombDataCubicThreshold_bo] at hm
  rw [← coulombDataBasisErrorConstant_bo] at hBudget
  obtain ⟨hExists, hEvery⟩ := coulombSpin_data_accuracy_of_basis_budget
    (CoulombSystem.bo eta data) (CoulombSystem.bo_spinDim eta data) L hL Ψ E
    ((hasCoulombSpinGroundPair_bo eta data L Ψ E).mpr hPair) ε m hm hBudget
  obtain ⟨EN, hEN⟩ := hExists
  refine ⟨⟨EN, (isCoulombSpinCubicGroundEnergy_bo eta data L _ EN).mp hEN⟩, ?_⟩
  intro EN' hEN'
  exact hEvery EN' ((isCoulombSpinCubicGroundEnergy_bo eta data L _ EN').mpr hEN')

/-- The explicit molecular-data threshold certifies every positive accuracy on
the electronic space. -/
theorem molecularSpin_data_accuracy_for_ground_pair {ν : Type*} [Fintype ν] (eta : ℕ)
    (_heta : 0 < eta) (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L)
    (Ψ : MolecularSpinL2 eta) (E : ℝ)
    (hPair : HasMolecularSpinGroundPair eta L data Ψ E)
    (ε : ℝ) (hε : 0 < ε) (m : ℕ)
    (hm : molecularDataAccuracyThreshold eta data L ε ≤ m) :
    (∃ EN : ℝ, IsMolecularSpinCubicGroundEnergy eta L data
      ((2 * Real.pi / L) * (m : ℝ)) EN) ∧
    ∀ EN : ℝ, IsMolecularSpinCubicGroundEnergy eta L data
      ((2 * Real.pi / L) * (m : ℝ)) EN →
      E ≤ EN ∧ EN ≤ E + ε ∧ |EN - E| ≤ ε := by
  rw [← coulombDataAccuracyThreshold_bo] at hm
  obtain ⟨hExists, hEvery⟩ := coulombSpin_data_accuracy_for_ground_pair
    (CoulombSystem.bo eta data) (CoulombSystem.bo_spinDim eta data) L hL Ψ E
    ((hasCoulombSpinGroundPair_bo eta data L Ψ E).mpr hPair) ε hε m hm
  obtain ⟨EN, hEN⟩ := hExists
  refine ⟨⟨EN, (isCoulombSpinCubicGroundEnergy_bo eta data L _ EN).mp hEN⟩, ?_⟩
  intro EN' hEN'
  exact hEvery EN' ((isCoulombSpinCubicGroundEnergy_bo eta data L _ EN').mpr hEN')

end
end PlaneWaveCertificate

end ReleaseMilestone150c
-- END RELEASE SOURCE 150c

-- BEGIN RELEASE SOURCE 151: polynomial bounds on the constants
section ReleaseMilestone151

/-!
# Milestone 151: polynomial bounds on the constants

The canonical cutoff constant of a Coulomb system in factored form; the bound
`(1 + W + |E|) S₁ S₂ m̄² W² (1 + |E| + W_m²)²` in the form of the manuscript's `eq:nbo-main`,
with the coupling weights `W`, `W_m` of milestone 146; and the coarse bound
`η² m̄⁷ Q¹⁴ (1 + |E|)³` of `thm:nbo`, with the charge weight `Q = 1 + Σ_a |q_a| + Z_tot`. The
factors in front depend only on the cell side `L`. The data-only energy budget, cutoff
constant and cutoff threshold of a Coulomb system are bounded by polynomials in `η`, `m̄` and
`Q` (`coulombGroundEnergyBudget_add_one_le`, `coulombDataCubicErrorConstant_le_coarse`,
`coulombDataCubicThreshold_le_poly`), and the Born--Oppenheimer cutoff constants and
threshold by polynomials in `η` and `λ_ζ = Z_tot`, as `thm:main` states. The basis-count
constants are `(3L/(2π))³` times the cutoff constants, by definition.
-/

namespace PlaneWaveCertificate

open scoped BigOperators

noncomputable section

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-! ## Cell factors -/

/-- The cell factor `κ_L = c_L + 4 B_low + C_s B_ker` of the tail constant. -/
def coulombTailCellFactor (L : ℝ) : ℝ :=
  coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant +
    4 * molecularCanonicalLowConstant L +
    molecularCanonicalSobolevConstant L * molecularCanonicalKernelConstant L

lemma coulombTailCellFactor_nonneg (L : ℝ) (hL : 0 < L) : 0 ≤ coulombTailCellFactor L := by
  unfold coulombTailCellFactor
  have h1 := coulombPhysicalCellConstant_nonneg L molecularCanonicalUnitHardyConstant
  have h2 := molecularCanonicalLowConstant_nonneg L hL
  have h3 := molecularCanonicalSobolevConstant_nonneg L
  have h4 := molecularCanonicalKernelConstant_nonneg L
  positivity

/-- The cell factor of the polynomial bound: `2¹⁴ max(1, c_L)⁵ κ_L²`. -/
def coulombPolyCellFactor (L : ℝ) : ℝ :=
  16384 * (max 1 (coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant)) ^ 5 *
    coulombTailCellFactor L ^ 2

lemma coulombPolyCellFactor_nonneg (L : ℝ) : 0 ≤ coulombPolyCellFactor L := by
  unfold coulombPolyCellFactor
  have : 0 ≤ max 1 (coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant) :=
    le_trans zero_le_one (le_max_left _ _)
  positivity

/-! ## The canonical constant in factored form -/

/-- The canonical cutoff constant `64 C₁ S₁ S₂ C_W²` with `C₁ = 1/2 + W c_L + |E|` and
`C_W = W m̄ (10 + 8|E| + 16 W_m² c_L²) κ_L`. -/
theorem coulombCanonicalCubicErrorConstant_eq (sys : CoulombSystem eta ν) (E L : ℝ) :
    coulombCanonicalCubicErrorConstant sys E L =
      64 * ((1 / 2 : ℝ) + sys.couplingWeight *
          coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant + |E|) *
        sys.massMoment 1 * sys.massMoment 2 *
        (sys.couplingWeight * (sys.maxMass * (10 + 8 * |E| + 16 *
          (sys.massCouplingWeight *
            coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant) ^ 2)) *
          coulombTailCellFactor L) ^ 2 := by
  unfold coulombCanonicalCubicErrorConstant continuumCoulombCubicConstant
    finiteCoulombPhysicalTailConstant finiteCoulombTailConstant continuumCoulombH2Constant
    finiteCoulombH2Constant uniformBOEigenH2Constant finiteCoulombPhysicalFormConstant
    finiteCoulombPhysicalMassConstant coulombTailCellFactor
  ring

/-- The canonical cutoff constant in the form of the manuscript's `eq:nbo-main`:
`C₁ m̄² S₁ S₂ W² Θ²` with `C₁ ≲ 1 + W + |E|` and `Θ ≲ 1 + |E| + W_m²`, times a factor that
depends only on the cell. The factor `W²` is the coupling weight of the tail constant. -/
theorem coulombCanonicalCubicErrorConstant_le_poly (sys : CoulombSystem eta ν) (E L : ℝ)
    (hL : 0 < L) :
    coulombCanonicalCubicErrorConstant sys E L ≤
      coulombPolyCellFactor L *
        ((1 + sys.couplingWeight + |E|) * sys.massMoment 1 * sys.massMoment 2 *
          sys.maxMass ^ 2 * sys.couplingWeight ^ 2 *
          (1 + |E| + sys.massCouplingWeight ^ 2) ^ 2) := by
  rw [coulombCanonicalCubicErrorConstant_eq]
  set c := coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant with hc
  set W := sys.couplingWeight
  set Wm := sys.massCouplingWeight
  set S1 := sys.massMoment 1
  set S2 := sys.massMoment 2
  set M := sys.maxMass
  set k := coulombTailCellFactor L
  set c' := max 1 c with hc'
  have hc0 : 0 ≤ c := coulombPhysicalCellConstant_nonneg L _
  have hW : 0 ≤ W := sys.couplingWeight_nonneg
  have hWm : 0 ≤ Wm := sys.massCouplingWeight_nonneg
  have hS1 : 0 ≤ S1 := sys.massMoment_nonneg 1
  have hS2 : 0 ≤ S2 := sys.massMoment_nonneg 2
  have hM : 0 ≤ M := sys.maxMass_pos.le
  have hk : 0 ≤ k := coulombTailCellFactor_nonneg L hL
  have hE : 0 ≤ |E| := abs_nonneg E
  have hc'1 : 1 ≤ c' := le_max_left _ _
  have hcc' : c ≤ c' := le_max_right _ _
  -- the sandwich factor
  have hC1 : (1 / 2 : ℝ) + W * c + |E| ≤ c' * (1 + W + |E|) := by
    nlinarith [mul_le_mul_of_nonneg_left hcc' hW]
  -- the a priori H² factor
  have hTheta : 10 + 8 * |E| + 16 * (Wm * c) ^ 2 ≤ 16 * c' ^ 2 * (1 + |E| + Wm ^ 2) := by
    have hc2 : c ^ 2 ≤ c' ^ 2 := pow_le_pow_left₀ hc0 hcc' 2
    have hc'2 : 1 ≤ c' ^ 2 := one_le_pow₀ hc'1
    have h1 : Wm ^ 2 * c ^ 2 ≤ Wm ^ 2 * c' ^ 2 := mul_le_mul_of_nonneg_left hc2 (sq_nonneg _)
    nlinarith [mul_le_mul_of_nonneg_left hc'2 hE]
  have hTheta0 : 0 ≤ 10 + 8 * |E| + 16 * (Wm * c) ^ 2 := by positivity
  have hX0 : 0 ≤ 1 + |E| + Wm ^ 2 := by positivity
  have hC10 : 0 ≤ (1 / 2 : ℝ) + W * c + |E| := by positivity
  calc 64 * ((1 / 2 : ℝ) + W * c + |E|) * S1 * S2 *
        (W * (M * (10 + 8 * |E| + 16 * (Wm * c) ^ 2)) * k) ^ 2
      = 64 * ((1 / 2 : ℝ) + W * c + |E|) * S1 * S2 * W ^ 2 * M ^ 2 * k ^ 2 *
          (10 + 8 * |E| + 16 * (Wm * c) ^ 2) ^ 2 := by ring
    _ ≤ 64 * (c' * (1 + W + |E|)) * S1 * S2 * W ^ 2 * M ^ 2 * k ^ 2 *
          (16 * c' ^ 2 * (1 + |E| + Wm ^ 2)) ^ 2 := by
        have hA : 0 ≤ S1 * S2 * W ^ 2 * M ^ 2 * k ^ 2 := by positivity
        have hsq := pow_le_pow_left₀ hTheta0 hTheta 2
        have h1 := mul_le_mul hC1 hsq (by positivity) (by positivity)
        have h2 := mul_le_mul_of_nonneg_left h1
          (by positivity : (0 : ℝ) ≤ 64 * (S1 * S2 * W ^ 2 * M ^ 2 * k ^ 2))
        nlinarith [h2]
    _ = coulombPolyCellFactor L * ((1 + W + |E|) * S1 * S2 * M ^ 2 * W ^ 2 *
          (1 + |E| + Wm ^ 2) ^ 2) := by
        unfold coulombPolyCellFactor
        rw [← hc]
        ring

/-! ## Charge weight, masses and the coarse bound -/

/-- A sum over unordered pairs of a nonnegative function is at most the full double sum. -/
lemma sum_finiteElectronPair_le_sum_sum {eta : ℕ} (f : Fin eta → Fin eta → ℝ)
    (hf : ∀ a b, 0 ≤ f a b) :
    ∑ pair : FiniteElectronPair eta, f pair.1.1 pair.1.2 ≤ ∑ a, ∑ b, f a b := by
  classical
  have hsub : ∑ pair : FiniteElectronPair eta, f pair.1.1 pair.1.2 =
      ∑ x ∈ Finset.univ.filter (fun x : Fin eta × Fin eta => x.1 < x.2), f x.1 x.2 := by
    rw [Finset.sum_subtype (p := fun x : Fin eta × Fin eta => x.1 < x.2)
      (Finset.univ.filter (fun x : Fin eta × Fin eta => x.1 < x.2))
      (fun x => by simp) (fun x : Fin eta × Fin eta => f x.1 x.2)]
  rw [hsub, ← Finset.sum_product', Finset.univ_product_univ]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
    (fun x _ _ => hf x.1 x.2)

namespace CoulombSystem

/-- The charge weight `Q = 1 + Σ_a |q_a| + Z_tot` of a Coulomb system. -/
def chargeWeight (sys : CoulombSystem eta ν) : ℝ :=
  1 + ∑ a, |sys.charge a| + sys.nuclei.totalCharge

lemma one_le_chargeWeight (sys : CoulombSystem eta ν) : 1 ≤ sys.chargeWeight := by
  unfold chargeWeight
  have h1 : 0 ≤ ∑ a, |sys.charge a| := Finset.sum_nonneg fun _ _ => abs_nonneg _
  have h2 := sys.nuclei.totalCharge_nonneg
  linarith

/-- `1 + W ≤ Q²`. -/
lemma one_add_couplingWeight_le (sys : CoulombSystem eta ν) :
    1 + sys.couplingWeight ≤ sys.chargeWeight ^ 2 := by
  set s := ∑ a, |sys.charge a| with hs
  set Z := sys.nuclei.totalCharge
  have hs0 : 0 ≤ s := Finset.sum_nonneg fun _ _ => abs_nonneg _
  have hZ0 : 0 ≤ Z := sys.nuclei.totalCharge_nonneg
  have hPair : ∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| ≤
      s ^ 2 := by
    have h := sum_finiteElectronPair_le_sum_sum
      (fun a b => |sys.charge a| * |sys.charge b|) (fun a b => by positivity)
    have hEq : ∑ a, ∑ b, |sys.charge a| * |sys.charge b| = s ^ 2 := by
      rw [hs, sq, Finset.sum_mul_sum]
    simpa only [abs_mul, hEq] using h
  unfold couplingWeight chargeWeight
  rw [← hs]
  nlinarith [hPair, mul_nonneg hs0 hZ0, sq_nonneg Z]

lemma couplingWeight_le (sys : CoulombSystem eta ν) :
    sys.couplingWeight ≤ sys.chargeWeight ^ 2 := by
  linarith [sys.one_add_couplingWeight_le]

/-- `W_m ≤ √m̄ W`: the mass weights are at most `√m̄`. -/
lemma massCouplingWeight_le (sys : CoulombSystem eta ν) :
    sys.massCouplingWeight ≤ Real.sqrt sys.maxMass * sys.couplingWeight := by
  have hsq : ∀ x, x ≤ sys.maxMass → Real.sqrt x ≤ Real.sqrt sys.maxMass :=
    fun x hx => Real.sqrt_le_sqrt hx
  unfold massCouplingWeight couplingWeight
  have hPair : ∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| *
        Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2)) ≤
      Real.sqrt sys.maxMass *
        ∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro pair _
    rw [mul_comm (Real.sqrt sys.maxMass)]
    exact mul_le_mul_of_nonneg_left
      (hsq _ ((min_le_left _ _).trans (sys.mass_le_maxMass _))) (abs_nonneg _)
  have hNuc : ∑ a, |sys.charge a| * Real.sqrt (sys.mass a) ≤
      Real.sqrt sys.maxMass * ∑ a, |sys.charge a| := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro a _
    rw [mul_comm (Real.sqrt sys.maxMass)]
    exact mul_le_mul_of_nonneg_left (hsq _ (sys.mass_le_maxMass a)) (abs_nonneg _)
  have hZ := sys.nuclei.totalCharge_nonneg
  nlinarith [mul_le_mul_of_nonneg_right hNuc hZ]

/-- `W_m² ≤ m̄ W²`. -/
lemma massCouplingWeight_sq_le (sys : CoulombSystem eta ν) :
    sys.massCouplingWeight ^ 2 ≤ sys.maxMass * sys.couplingWeight ^ 2 := by
  have h := sys.massCouplingWeight_le
  have h0 := sys.massCouplingWeight_nonneg
  have hsq := pow_le_pow_left₀ h0 h 2
  rwa [mul_pow, Real.sq_sqrt sys.maxMass_pos.le] at hsq

omit [Fintype ν] in
/-- `S_r ≤ η m̄^r`. -/
lemma massMoment_le (sys : CoulombSystem eta ν) (r : ℕ) :
    sys.massMoment r ≤ (eta : ℝ) * sys.maxMass ^ r := by
  unfold CoulombParticles.massMoment
  calc ∑ a, sys.mass a ^ r ≤ ∑ _a : Fin eta, sys.maxMass ^ r :=
        Finset.sum_le_sum fun a _ =>
          pow_le_pow_left₀ (sys.mass_pos a).le (sys.mass_le_maxMass a) r
    _ = (eta : ℝ) * sys.maxMass ^ r := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

end CoulombSystem

/-- The coarse bound in the form of the manuscript's `thm:nbo`: `η² m̄⁷ (1 + |E|)³` times a
polynomial in the charge weight `Q` and a factor that depends only on the cell. -/
theorem coulombCanonicalCubicErrorConstant_le_coarse (sys : CoulombSystem eta ν) (E L : ℝ)
    (hL : 0 < L) :
    coulombCanonicalCubicErrorConstant sys E L ≤
      4 * coulombPolyCellFactor L * (eta : ℝ) ^ 2 * sys.maxMass ^ 7 *
        sys.chargeWeight ^ 14 * (1 + |E|) ^ 3 := by
  refine (coulombCanonicalCubicErrorConstant_le_poly sys E L hL).trans ?_
  set F := coulombPolyCellFactor L
  set W := sys.couplingWeight
  set Wm := sys.massCouplingWeight
  set S1 := sys.massMoment 1
  set S2 := sys.massMoment 2
  set M := sys.maxMass
  set Λ := sys.chargeWeight
  set e := |E|
  have hF : 0 ≤ F := coulombPolyCellFactor_nonneg L
  have hW : 0 ≤ W := sys.couplingWeight_nonneg
  have hWm : 0 ≤ Wm := sys.massCouplingWeight_nonneg
  have hS1 : 0 ≤ S1 := sys.massMoment_nonneg 1
  have hS2 : 0 ≤ S2 := sys.massMoment_nonneg 2
  have hM1 : 1 ≤ M := sys.one_le_maxMass
  have hΛ1 : 1 ≤ Λ := sys.one_le_chargeWeight
  have he : 0 ≤ e := abs_nonneg E
  have hη : (0 : ℝ) ≤ eta := Nat.cast_nonneg eta
  have hWΛ : 1 + W ≤ Λ ^ 2 := sys.one_add_couplingWeight_le
  have hWm2 : Wm ^ 2 ≤ M * W ^ 2 := sys.massCouplingWeight_sq_le
  have hS1le : S1 ≤ eta * M := by simpa using sys.massMoment_le 1
  have hS2le : S2 ≤ eta * M ^ 2 := sys.massMoment_le 2
  have hΛ2 : 1 ≤ Λ ^ 2 := one_le_pow₀ hΛ1
  have hΛ4 : 1 ≤ Λ ^ 4 := one_le_pow₀ hΛ1
  have hW2 : W ^ 2 ≤ Λ ^ 4 := by
    have h := pow_le_pow_left₀ hW (by linarith : W ≤ Λ ^ 2) 2
    rwa [← pow_mul] at h
  -- the three factors
  have hA : 1 + W + e ≤ Λ ^ 2 * (1 + e) := by nlinarith
  have hB : 1 + e + Wm ^ 2 ≤ 2 * M * Λ ^ 4 * (1 + e) := by
    have h1 : Wm ^ 2 ≤ M * Λ ^ 4 := hWm2.trans (mul_le_mul_of_nonneg_left hW2 (by linarith))
    have h2 : 1 ≤ M * Λ ^ 4 := by nlinarith
    nlinarith
  have hB0 : 0 ≤ 1 + e + Wm ^ 2 := by positivity
  have hBsq := pow_le_pow_left₀ hB0 hB 2
  have hP0 : 0 ≤ S1 * S2 := mul_nonneg hS1 hS2
  have hS : S1 * S2 ≤ (eta * M) * (eta * M ^ 2) :=
    mul_le_mul hS1le hS2le hS2 (by positivity)
  calc F * ((1 + W + e) * S1 * S2 * M ^ 2 * W ^ 2 * (1 + e + Wm ^ 2) ^ 2)
      = F * (1 + W + e) * (S1 * S2) * M ^ 2 * W ^ 2 * (1 + e + Wm ^ 2) ^ 2 := by ring
    _ ≤ F * (Λ ^ 2 * (1 + e)) * ((eta * M) * (eta * M ^ 2)) * M ^ 2 * Λ ^ 4 *
          (2 * M * Λ ^ 4 * (1 + e)) ^ 2 := by
        gcongr
    _ = 4 * F * (eta : ℝ) ^ 2 * M ^ 7 * Λ ^ 14 * (1 + e) ^ 3 := by ring

/-! ## The data-only constants -/

/-- The cell factor of the energy budget, `(3/2) g² + c_L (1 + 3 g²) + c_L² + 1/4`. -/
def coulombBudgetCellFactor (L : ℝ) : ℝ :=
  (3 / 2) * (2 * Real.pi / L) ^ 2 +
    coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant *
      (1 + 3 * (2 * Real.pi / L) ^ 2) +
    coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant ^ 2 + 1 / 4

lemma coulombBudgetCellFactor_nonneg (L : ℝ) : 0 ≤ coulombBudgetCellFactor L := by
  unfold coulombBudgetCellFactor
  have := coulombPhysicalCellConstant_nonneg L molecularCanonicalUnitHardyConstant
  positivity

/-- The data-only energy budget is at most `G_L (1 + η³)(1 + W + W_m²)`. -/
theorem coulombGroundEnergyBudget_le_poly (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    coulombGroundEnergyBudget sys L ≤
      coulombBudgetCellFactor L * (1 + (eta : ℝ) ^ 3) *
        (1 + sys.couplingWeight + sys.massCouplingWeight ^ 2) := by
  have h := coulombGroundEnergyBudget_le_explicit sys L hL
  set g := 2 * Real.pi / L
  set c := coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant
  set W := sys.couplingWeight
  set Wm := sys.massCouplingWeight
  have hc : 0 ≤ c := coulombPhysicalCellConstant_nonneg L _
  have hW : 0 ≤ W := sys.couplingWeight_nonneg
  have hWm : 0 ≤ Wm := sys.massCouplingWeight_nonneg
  have hη : (0 : ℝ) ≤ (eta : ℝ) ^ 3 := by positivity
  have hg : 0 ≤ g ^ 2 := sq_nonneg g
  have hsqrt : Real.sqrt (1 + 3 * g ^ 2 * (eta : ℝ) ^ 3) ≤ 1 + 3 * g ^ 2 * (eta : ℝ) ^ 3 := by
    have h1 : 1 ≤ 1 + 3 * g ^ 2 * (eta : ℝ) ^ 3 := by nlinarith
    calc Real.sqrt (1 + 3 * g ^ 2 * (eta : ℝ) ^ 3)
        ≤ Real.sqrt ((1 + 3 * g ^ 2 * (eta : ℝ) ^ 3) ^ 2) :=
          Real.sqrt_le_sqrt (by nlinarith)
      _ = 1 + 3 * g ^ 2 * (eta : ℝ) ^ 3 := Real.sqrt_sq (by linarith)
  simp only [finiteCoulombPhysicalFormConstant, finiteCoulombPhysicalMassConstant] at h
  rw [← show c = coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant from rfl] at h
  have hB : W * c * Real.sqrt (1 + 3 * g ^ 2 * (eta : ℝ) ^ 3) ≤
      W * c * (1 + 3 * g ^ 2 * (eta : ℝ) ^ 3) :=
    mul_le_mul_of_nonneg_left hsqrt (mul_nonneg hW hc)
  unfold coulombBudgetCellFactor
  set x := (eta : ℝ) ^ 3
  -- each term is at most its coefficient times (1 + x)(1 + W + Wm²)
  have hP : 1 ≤ (1 + x) * (1 + W + Wm ^ 2) := by nlinarith [sq_nonneg Wm]
  have hT1 : (3 / 2) * g ^ 2 * x ≤ (3 / 2) * g ^ 2 * ((1 + x) * (1 + W + Wm ^ 2)) := by
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    nlinarith [sq_nonneg Wm]
  have hT2 : W * c * (1 + 3 * g ^ 2 * x) ≤
      c * (1 + 3 * g ^ 2) * ((1 + x) * (1 + W + Wm ^ 2)) := by
    have h1 : 1 + 3 * g ^ 2 * x ≤ (1 + 3 * g ^ 2) * (1 + x) := by nlinarith
    have h2 : W ≤ 1 + W + Wm ^ 2 := by nlinarith [sq_nonneg Wm]
    have h3 : 0 ≤ 1 + 3 * g ^ 2 * x := by positivity
    calc W * c * (1 + 3 * g ^ 2 * x) = c * (W * (1 + 3 * g ^ 2 * x)) := by ring
      _ ≤ c * ((1 + W + Wm ^ 2) * ((1 + 3 * g ^ 2) * (1 + x))) := by
          apply mul_le_mul_of_nonneg_left _ hc
          exact mul_le_mul h2 h1 h3 (by positivity)
      _ = c * (1 + 3 * g ^ 2) * ((1 + x) * (1 + W + Wm ^ 2)) := by ring
  have hT3 : (Wm * c) ^ 2 ≤ c ^ 2 * ((1 + x) * (1 + W + Wm ^ 2)) := by
    rw [mul_pow, mul_comm]
    apply mul_le_mul_of_nonneg_left _ (sq_nonneg c)
    nlinarith [sq_nonneg Wm]
  have hT4 : (1 / 4 : ℝ) ≤ 1 / 4 * ((1 + x) * (1 + W + Wm ^ 2)) := by nlinarith
  nlinarith [h, hB, hT1, hT2, hT3, hT4]

lemma coulombGroundEnergyBudget_nonneg (sys : CoulombSystem eta ν) (L : ℝ) :
    0 ≤ coulombGroundEnergyBudget sys L := by
  unfold coulombGroundEnergyBudget
  have := coulombFiniteReferenceEnergyBound_nonneg sys L
  positivity

namespace CoulombSystem

/-- `1 + W + W_m² ≤ 2 m̄ Q⁴`. -/
lemma one_add_weights_le (sys : CoulombSystem eta ν) :
    1 + sys.couplingWeight + sys.massCouplingWeight ^ 2 ≤
      2 * sys.maxMass * sys.chargeWeight ^ 4 := by
  have hW : 0 ≤ sys.couplingWeight := sys.couplingWeight_nonneg
  have hM1 : 1 ≤ sys.maxMass := sys.one_le_maxMass
  have hΛ1 : 1 ≤ sys.chargeWeight := sys.one_le_chargeWeight
  have hWΛ := sys.one_add_couplingWeight_le
  have hW2 : sys.couplingWeight ^ 2 ≤ sys.chargeWeight ^ 4 := by
    have h := pow_le_pow_left₀ hW (by linarith : sys.couplingWeight ≤ sys.chargeWeight ^ 2) 2
    rwa [← pow_mul] at h
  have hWm2 : sys.massCouplingWeight ^ 2 ≤ sys.maxMass * sys.chargeWeight ^ 4 :=
    sys.massCouplingWeight_sq_le.trans (mul_le_mul_of_nonneg_left hW2 (by linarith))
  have h2 : sys.chargeWeight ^ 2 ≤ sys.chargeWeight ^ 4 := pow_le_pow_right₀ hΛ1 (by norm_num)
  have h3 : sys.chargeWeight ^ 4 ≤ sys.maxMass * sys.chargeWeight ^ 4 :=
    le_mul_of_one_le_left (by positivity) hM1
  linarith

end CoulombSystem

/-- `1 + E_b ≤ 2 (1 + G_L) (1 + η³) m̄ Q⁴`. -/
theorem coulombGroundEnergyBudget_add_one_le (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    1 + coulombGroundEnergyBudget sys L ≤
      2 * (1 + coulombBudgetCellFactor L) * (1 + (eta : ℝ) ^ 3) * sys.maxMass *
        sys.chargeWeight ^ 4 := by
  have hEb := coulombGroundEnergyBudget_le_poly sys L hL
  have hY := sys.one_add_weights_le
  have hG : 0 ≤ coulombBudgetCellFactor L := coulombBudgetCellFactor_nonneg L
  have hx : 1 ≤ 1 + (eta : ℝ) ^ 3 := by
    have : (0 : ℝ) ≤ (eta : ℝ) ^ 3 := by positivity
    linarith
  have hM1 : 1 ≤ sys.maxMass := sys.one_le_maxMass
  have hΛ4 : 1 ≤ sys.chargeWeight ^ 4 := one_le_pow₀ sys.one_le_chargeWeight
  have h1 : coulombGroundEnergyBudget sys L ≤
      coulombBudgetCellFactor L * (1 + (eta : ℝ) ^ 3) *
        (2 * sys.maxMass * sys.chargeWeight ^ 4) :=
    hEb.trans (mul_le_mul_of_nonneg_left hY (by positivity))
  have h2 : 1 ≤ (1 + (eta : ℝ) ^ 3) * sys.maxMass * sys.chargeWeight ^ 4 := by
    calc (1 : ℝ) = 1 * 1 * 1 := by ring
      _ ≤ (1 + (eta : ℝ) ^ 3) * sys.maxMass * sys.chargeWeight ^ 4 := by gcongr
  nlinarith

/-- The data-only cutoff constant is bounded by a polynomial in `η`, `m̄` and the charge
weight `Q`: `32 F_L (1 + G_L)³ η² m̄¹⁰ Q²⁶ (1 + η³)³`. -/
theorem coulombDataCubicErrorConstant_le_coarse (sys : CoulombSystem eta ν) (L : ℝ)
    (hL : 0 < L) :
    coulombDataCubicErrorConstant sys L ≤
      32 * coulombPolyCellFactor L * (1 + coulombBudgetCellFactor L) ^ 3 *
        (eta : ℝ) ^ 2 * sys.maxMass ^ 10 * sys.chargeWeight ^ 26 *
        (1 + (eta : ℝ) ^ 3) ^ 3 := by
  have hData : coulombDataCubicErrorConstant sys L =
      coulombCanonicalCubicErrorConstant sys (coulombGroundEnergyBudget sys L) L := rfl
  rw [hData]
  refine (coulombCanonicalCubicErrorConstant_le_coarse sys _ L hL).trans ?_
  set F := coulombPolyCellFactor L
  set G := coulombBudgetCellFactor L
  set Eb := coulombGroundEnergyBudget sys L
  set M := sys.maxMass
  set Λ := sys.chargeWeight
  set x := (1 + (eta : ℝ) ^ 3)
  have hF : 0 ≤ F := coulombPolyCellFactor_nonneg L
  have hEb0 : 0 ≤ Eb := coulombGroundEnergyBudget_nonneg sys L
  have hM1 : 1 ≤ M := sys.one_le_maxMass
  have hΛ1 : 1 ≤ Λ := sys.one_le_chargeWeight
  have hE1 : 1 + |Eb| ≤ 2 * (1 + G) * x * M * Λ ^ 4 := by
    rw [abs_of_nonneg hEb0]
    exact coulombGroundEnergyBudget_add_one_le sys L hL
  have hE10 : 0 ≤ 1 + |Eb| := by positivity
  have hcube := pow_le_pow_left₀ hE10 hE1 3
  calc 4 * F * (eta : ℝ) ^ 2 * M ^ 7 * Λ ^ 14 * (1 + |Eb|) ^ 3
      ≤ 4 * F * (eta : ℝ) ^ 2 * M ^ 7 * Λ ^ 14 * (2 * (1 + G) * x * M * Λ ^ 4) ^ 3 := by
        gcongr
    _ = 32 * F * (1 + G) ^ 3 * (eta : ℝ) ^ 2 * M ^ 10 * Λ ^ 26 * x ^ 3 := by ring

/-! ## The cutoff threshold -/

/-- The canonical tail budget in factored form: `W m̄ (10 + 8|E| + 16 W_m² c_L²) κ_L`. -/
theorem coulombCanonicalTailBudget_eq (sys : CoulombSystem eta ν) (E L : ℝ) :
    coulombCanonicalTailBudget sys E L =
      sys.couplingWeight * (sys.maxMass * (10 + 8 * |E| + 16 *
        (sys.massCouplingWeight *
          coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant) ^ 2)) *
        coulombTailCellFactor L := by
  unfold coulombCanonicalTailBudget finiteCoulombPhysicalTailConstant finiteCoulombTailConstant
    continuumCoulombH2Constant finiteCoulombH2Constant uniformBOEigenH2Constant
    finiteCoulombPhysicalMassConstant coulombTailCellFactor
  ring

/-- The data-only tail budget is at most `64 c'² κ_L (1 + G_L) (1 + η³) m̄³ Q¹⁰`, with
`c' = max(1, c_L)`. -/
theorem coulombDataTailBudget_le (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    coulombDataTailBudget sys L ≤
      64 * (max 1 (coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant)) ^ 2 *
        coulombTailCellFactor L * (1 + coulombBudgetCellFactor L) * (1 + (eta : ℝ) ^ 3) *
        sys.maxMass ^ 3 * sys.chargeWeight ^ 10 := by
  have hTeq := coulombCanonicalTailBudget_eq sys (coulombGroundEnergyBudget sys L) L
  have hT : coulombDataTailBudget sys L =
      coulombCanonicalTailBudget sys (coulombGroundEnergyBudget sys L) L := rfl
  rw [hT, hTeq, abs_of_nonneg (coulombGroundEnergyBudget_nonneg sys L)]
  have hE1 := coulombGroundEnergyBudget_add_one_le sys L hL
  have hEb0 := coulombGroundEnergyBudget_nonneg sys L
  generalize coulombGroundEnergyBudget sys L = Eb at hE1 hEb0 ⊢
  generalize hc : coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant = c
  have hc0 : 0 ≤ c := hc ▸ coulombPhysicalCellConstant_nonneg L _
  have hk : 0 ≤ coulombTailCellFactor L := coulombTailCellFactor_nonneg L hL
  have hG : 0 ≤ coulombBudgetCellFactor L := coulombBudgetCellFactor_nonneg L
  have hW : 0 ≤ sys.couplingWeight := sys.couplingWeight_nonneg
  have hM1 : 1 ≤ sys.maxMass := sys.one_le_maxMass
  have hΛ1 : 1 ≤ sys.chargeWeight := sys.one_le_chargeWeight
  have hWle : sys.couplingWeight ≤ sys.chargeWeight ^ 2 := sys.couplingWeight_le
  have hY := sys.one_add_weights_le
  have hc'1 : 1 ≤ max 1 c := le_max_left _ _
  have hcc' : c ≤ max 1 c := le_max_right _ _
  have hc2 : c ^ 2 ≤ (max 1 c) ^ 2 := pow_le_pow_left₀ hc0 hcc' 2
  have hc'2 : 1 ≤ (max 1 c) ^ 2 := one_le_pow₀ hc'1
  have hWm1 : 1 + sys.massCouplingWeight ^ 2 ≤ 2 * sys.maxMass * sys.chargeWeight ^ 4 := by
    linarith
  have hTheta : 10 + 8 * Eb + 16 * (sys.massCouplingWeight * c) ^ 2 ≤
      16 * (max 1 c) ^ 2 * ((1 + Eb) * (1 + sys.massCouplingWeight ^ 2)) := by
    have h1 : sys.massCouplingWeight ^ 2 * c ^ 2 ≤ sys.massCouplingWeight ^ 2 * (max 1 c) ^ 2 :=
      mul_le_mul_of_nonneg_left hc2 (sq_nonneg _)
    nlinarith [mul_nonneg hEb0 (sq_nonneg sys.massCouplingWeight),
      mul_le_mul_of_nonneg_left hc'2 hEb0]
  have hP : (1 + Eb) * (1 + sys.massCouplingWeight ^ 2) ≤
      (2 * (1 + coulombBudgetCellFactor L) * (1 + (eta : ℝ) ^ 3) * sys.maxMass *
        sys.chargeWeight ^ 4) * (2 * sys.maxMass * sys.chargeWeight ^ 4) :=
    mul_le_mul hE1 hWm1 (by positivity) (by positivity)
  calc sys.couplingWeight * (sys.maxMass * (10 + 8 * Eb + 16 *
          (sys.massCouplingWeight * c) ^ 2)) * coulombTailCellFactor L
      ≤ sys.chargeWeight ^ 2 * (sys.maxMass * (16 * (max 1 c) ^ 2 *
          ((2 * (1 + coulombBudgetCellFactor L) * (1 + (eta : ℝ) ^ 3) * sys.maxMass *
            sys.chargeWeight ^ 4) * (2 * sys.maxMass * sys.chargeWeight ^ 4)))) *
          coulombTailCellFactor L := by
        gcongr
        exact hTheta.trans (mul_le_mul_of_nonneg_left hP (by positivity))
    _ = 64 * (max 1 c) ^ 2 * coulombTailCellFactor L * (1 + coulombBudgetCellFactor L) *
          (1 + (eta : ℝ) ^ 3) * sys.maxMass ^ 3 * sys.chargeWeight ^ 10 := by ring

/-- The explicit threshold is at most `3 + η + (1 + 2g + 4M(|A| + 1) + 32 S T²)/g`. -/
lemma coulombExplicitCubicThreshold_le (eta : ℕ) (g M S A T : ℝ) (hg : 0 < g) (hM : 0 ≤ M)
    (hS : 0 ≤ S) :
    (coulombExplicitCubicThreshold eta g M S A T : ℝ) ≤
      3 + eta + (1 + 2 * g + 4 * M * (|A| + 1) + 32 * S * T ^ 2) / g := by
  have hx : 0 ≤ (1 + 2 * g + 4 * M * (|A| + 1) + 32 * S * T ^ 2) / g := by positivity
  have hceil := Nat.ceil_lt_add_one hx
  have hη : (0 : ℝ) ≤ eta := Nat.cast_nonneg eta
  unfold coulombExplicitCubicThreshold
  push_cast
  refine max_le (by linarith) (max_le (by linarith) (by linarith))

/-- The cell factor of the threshold bound. -/
def coulombThresholdCellFactor (L : ℝ) : ℝ :=
  3 + (1 + 2 * (2 * Real.pi / L) + 8 * (1 + coulombBudgetCellFactor L) +
    131072 * (max 1 (coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant)) ^ 4 *
      coulombTailCellFactor L ^ 2 * (1 + coulombBudgetCellFactor L) ^ 2) / (2 * Real.pi / L)

/-- The arithmetic of the threshold bound. -/
lemma coulombThreshold_poly_arith {g e x M Λ G c k T S : ℝ} (hg : 0 < g) (he : 0 ≤ e)
    (hx : 1 ≤ x) (hM1 : 1 ≤ M) (hΛ1 : 1 ≤ Λ) (hG : 0 ≤ G) (hc : 1 ≤ c)
    (hT0 : 0 ≤ T) (hS : S ≤ e * M ^ 2)
    (hT : T ≤ 64 * c ^ 2 * k * (1 + G) * x * M ^ 3 * Λ ^ 10) {A : ℝ}
    (hA : 1 + A ≤ 2 * (1 + G) * x * M * Λ ^ 4) :
    3 + e + (1 + 2 * g + 4 * M * (A + 1) + 32 * S * T ^ 2) / g ≤
      (3 + (1 + 2 * g + 8 * (1 + G) + 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2) / g) *
        (1 + e) * x ^ 2 * M ^ 8 * Λ ^ 20 := by
  set P := (1 + e) * x ^ 2 * M ^ 8 * Λ ^ 20 with hPdef
  have hx2 : 1 ≤ x ^ 2 := one_le_pow₀ hx
  have hM8 : 1 ≤ M ^ 8 := one_le_pow₀ hM1
  have hΛ20 : 1 ≤ Λ ^ 20 := one_le_pow₀ hΛ1
  have hQ : 1 ≤ x ^ 2 * M ^ 8 * Λ ^ 20 := by
    calc (1 : ℝ) = 1 * 1 * 1 := by ring
      _ ≤ x ^ 2 * M ^ 8 * Λ ^ 20 := by gcongr
  have hP1 : 1 ≤ P := by
    calc (1 : ℝ) = 1 * 1 := by ring
      _ ≤ (1 + e) * (x ^ 2 * M ^ 8 * Λ ^ 20) := by gcongr; linarith
      _ = P := by rw [hPdef]; ring
  have heP : e ≤ P := by
    calc e = e * 1 := by ring
      _ ≤ (1 + e) * (x ^ 2 * M ^ 8 * Λ ^ 20) := by gcongr; linarith
      _ = P := by rw [hPdef]; ring
  have hTerm1 : 4 * M * (A + 1) ≤ 8 * (1 + G) * P := by
    have h2 : M * (x * M * Λ ^ 4) ≤ P := by
      have hxx : x ≤ x ^ 2 := le_self_pow₀ hx (by norm_num)
      have hMM : M ^ 2 ≤ M ^ 8 := pow_le_pow_right₀ hM1 (by norm_num)
      have hΛΛ : Λ ^ 4 ≤ Λ ^ 20 := pow_le_pow_right₀ hΛ1 (by norm_num)
      calc M * (x * M * Λ ^ 4) = 1 * x * M ^ 2 * Λ ^ 4 := by ring
        _ ≤ (1 + e) * x ^ 2 * M ^ 8 * Λ ^ 20 := by gcongr; linarith
    calc 4 * M * (A + 1) ≤ 4 * M * (2 * (1 + G) * x * M * Λ ^ 4) := by
          apply mul_le_mul_of_nonneg_left _ (by linarith); linarith
      _ = 8 * (1 + G) * (M * (x * M * Λ ^ 4)) := by ring
      _ ≤ 8 * (1 + G) * P := mul_le_mul_of_nonneg_left h2 (by positivity)
  have hTerm2 : 32 * S * T ^ 2 ≤ 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2 * P := by
    have hTsq := pow_le_pow_left₀ hT0 hT 2
    calc 32 * S * T ^ 2
        ≤ 32 * (e * M ^ 2) * (64 * c ^ 2 * k * (1 + G) * x * M ^ 3 * Λ ^ 10) ^ 2 :=
          mul_le_mul (mul_le_mul_of_nonneg_left hS (by norm_num)) hTsq (sq_nonneg _)
            (by positivity)
      _ = 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2 * (e * x ^ 2 * M ^ 8 * Λ ^ 20) := by ring
      _ ≤ 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2 * P := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          rw [hPdef]
          gcongr
          linarith
  have hTerm0 : 1 + 2 * g ≤ (1 + 2 * g) * P := le_mul_of_one_le_right (by positivity) hP1
  have hNum : 1 + 2 * g + 4 * M * (A + 1) + 32 * S * T ^ 2 ≤
      (1 + 2 * g + 8 * (1 + G) + 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2) * P := by
    have h := add_le_add (add_le_add hTerm0 hTerm1) hTerm2
    calc 1 + 2 * g + 4 * M * (A + 1) + 32 * S * T ^ 2
        = (1 + 2 * g) + 4 * M * (A + 1) + 32 * S * T ^ 2 := by ring
      _ ≤ (1 + 2 * g) * P + 8 * (1 + G) * P + 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2 * P := h
      _ = (1 + 2 * g + 8 * (1 + G) + 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2) * P := by ring
  have hDiv : (1 + 2 * g + 4 * M * (A + 1) + 32 * S * T ^ 2) / g ≤
      (1 + 2 * g + 8 * (1 + G) + 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2) / g * P := by
    rw [div_mul_eq_mul_div]
    exact div_le_div_of_nonneg_right hNum hg.le
  have h1e : 1 + e ≤ P := by
    calc 1 + e = (1 + e) * 1 := by ring
      _ ≤ (1 + e) * (x ^ 2 * M ^ 8 * Λ ^ 20) := by gcongr
      _ = P := by rw [hPdef]; ring
  have h3 : 3 + e ≤ 3 * P := by linarith
  calc 3 + e + (1 + 2 * g + 4 * M * (A + 1) + 32 * S * T ^ 2) / g
      ≤ 3 * P + (1 + 2 * g + 8 * (1 + G) + 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2) / g * P := by
        linarith
    _ = (3 + (1 + 2 * g + 8 * (1 + G) + 131072 * c ^ 4 * k ^ 2 * (1 + G) ^ 2) / g) *
          (1 + e) * x ^ 2 * M ^ 8 * Λ ^ 20 := by
        rw [hPdef]; ring

/-- The data-only cutoff threshold is bounded by a polynomial in `η`, `m̄` and the charge
weight `Q`. -/
theorem coulombDataCubicThreshold_le_poly (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    (coulombDataCubicThreshold sys L : ℝ) ≤
      coulombThresholdCellFactor L * (1 + (eta : ℝ)) * (1 + (eta : ℝ) ^ 3) ^ 2 *
        sys.maxMass ^ 8 * sys.chargeWeight ^ 20 := by
  have hg : 0 < 2 * Real.pi / L := div_pos (by positivity) hL
  have hEb0 := coulombGroundEnergyBudget_nonneg sys L
  have hThr := coulombExplicitCubicThreshold_le eta (2 * Real.pi / L) sys.maxMass
    (sys.massMoment 2) (coulombGroundEnergyBudget sys L) (coulombDataTailBudget sys L) hg
    sys.maxMass_pos.le (sys.massMoment_nonneg 2)
  have hData : coulombDataCubicThreshold sys L =
      coulombExplicitCubicThreshold eta (2 * Real.pi / L) sys.maxMass (sys.massMoment 2)
        (coulombGroundEnergyBudget sys L) (coulombDataTailBudget sys L) := rfl
  rw [hData]
  refine hThr.trans ?_
  rw [abs_of_nonneg hEb0]
  have hx : 1 ≤ 1 + (eta : ℝ) ^ 3 := by
    have : (0 : ℝ) ≤ (eta : ℝ) ^ 3 := by positivity
    linarith
  have h := coulombThreshold_poly_arith hg (Nat.cast_nonneg eta) hx sys.one_le_maxMass
    sys.one_le_chargeWeight (coulombBudgetCellFactor_nonneg L)
    (le_max_left 1 (coulombPhysicalCellConstant L molecularCanonicalUnitHardyConstant))
    (coulombCanonicalTailBudget_nonneg sys _ L hL) (sys.massMoment_le 2)
    (coulombDataTailBudget_le sys L hL)
    (coulombGroundEnergyBudget_add_one_le sys L hL)
  refine h.trans (le_of_eq ?_)
  unfold coulombThresholdCellFactor
  ring

/-! ## The Born--Oppenheimer constants -/

/-- For electrons and clamped nuclei the charge weight is `1 + η + Z_tot`. -/
lemma CoulombSystem.chargeWeight_bo (eta : ℕ) (data : FiniteBONuclearData ν) :
    (CoulombSystem.bo eta data).chargeWeight = 1 + eta + data.totalCharge := by
  unfold CoulombSystem.chargeWeight
  simp

/-- The Born--Oppenheimer cutoff constant is polynomial in `η` and `λ_ζ = Z_tot`, as in the
manuscript's `thm:main`: `4 F_L η² (1 + η + Z_tot)¹⁴ (1 + |E|)³`. -/
theorem molecularCanonicalCubicErrorConstant_le_coarse (eta : ℕ)
    (data : FiniteBONuclearData ν) (E L : ℝ) (hL : 0 < L) :
    molecularCanonicalCubicErrorConstant eta data E L ≤
      4 * coulombPolyCellFactor L * (eta : ℝ) ^ 2 *
        (1 + eta + data.totalCharge) ^ 14 * (1 + |E|) ^ 3 := by
  have h := coulombCanonicalCubicErrorConstant_le_coarse (CoulombSystem.bo eta data) E L hL
  rw [coulombCanonicalCubicErrorConstant_bo, CoulombSystem.maxMass_bo,
    CoulombSystem.chargeWeight_bo] at h
  simpa using h

/-- The data-only Born--Oppenheimer cutoff constant is polynomial in `η` and `Z_tot`. -/
theorem molecularDataCubicErrorConstant_le_coarse (eta : ℕ) (data : FiniteBONuclearData ν)
    (L : ℝ) (hL : 0 < L) :
    molecularDataCubicErrorConstant eta data L ≤
      32 * coulombPolyCellFactor L * (1 + coulombBudgetCellFactor L) ^ 3 *
        (eta : ℝ) ^ 2 * (1 + eta + data.totalCharge) ^ 26 * (1 + (eta : ℝ) ^ 3) ^ 3 := by
  have h := coulombDataCubicErrorConstant_le_coarse (CoulombSystem.bo eta data) L hL
  rw [coulombDataCubicErrorConstant_bo, CoulombSystem.maxMass_bo,
    CoulombSystem.chargeWeight_bo] at h
  simpa using h

/-- The data-only Born--Oppenheimer cutoff threshold is polynomial in `η` and `Z_tot`. -/
theorem molecularDataCubicThreshold_le_poly (eta : ℕ) (data : FiniteBONuclearData ν)
    (L : ℝ) (hL : 0 < L) :
    (molecularDataCubicThreshold eta data L : ℝ) ≤
      coulombThresholdCellFactor L * (1 + (eta : ℝ)) * (1 + (eta : ℝ) ^ 3) ^ 2 *
        (1 + eta + data.totalCharge) ^ 20 := by
  have h := coulombDataCubicThreshold_le_poly (CoulombSystem.bo eta data) L hL
  rw [coulombDataCubicThreshold_bo, CoulombSystem.maxMass_bo,
    CoulombSystem.chargeWeight_bo] at h
  simpa using h

end
