  · rw [finiteFourierLpEmbed_apply_not_mem_cube eta n _ p hp,
      finiteFourierLpEmbed_apply_not_mem_cube eta n _ p hp, mul_zero]

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **Potential tail of a general `H²` state** (`eq:lam-gen`). For every register `r` and
`K ≥ 1`, the part of `W u` beyond `K` in register `r` is at most `C(M₂) K^{-1/2}` when the `H²`
norm of `u` is at most `M₂`, with the certificate's tail constant. -/
theorem potential_tail_le (r : Fin eta) (K rho Blow Cs Bker M2 : ℝ) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u : MolecularFourierH2 eta) (hu : ‖u‖ ≤ M2) :
    ‖tailMask (2 * Real.pi / L) K r (coulombFourierPotentialH2 sys (2 * Real.pi / L) H u)‖ ≤
      finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2 * rho := by
  set g := 2 * Real.pi / L
  set W := coulombFourierPotentialH2 sys g H
  set M := tailMask g K r
  set C := finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2 * rho
  set c0 := cutoffShellIndex K g
  -- finite compressions, for cubes `c0 + b` with `N ≤ c0 + b`
  have hfin : ∀ N b, N ≤ c0 + b →
      ‖molecularH2Truncate (c0 + b) (M (W (molecularH2Truncate N u)))‖ ≤ C := by
    intro N b hNb
    rw [truncate_tailMask, truncate_potential_eq sys L H hKernel N (c0 + b) hNb u, tailMask_embed,
      finiteFourierLpEmbed_norm_eq_fullCoeffVector]
    have hH2 : fullH2Sq (finitePlaneWaveKabs g (c0 + b))
        (finiteFourierCoeffExtract (c0 + b) (molecularH2Coeff g (molecularH2Truncate N u))) ≤
        M2 ^ 2 := by
      rw [fullH2Sq_extract_eq_truncation_norm_sq]
      have h1 := molecularH2Truncate_norm_le (c0 + b) (molecularH2Truncate N u)
      have h2 := molecularH2Truncate_norm_le N u
      have h3 : ‖molecularH2Truncate (c0 + b) (molecularH2Truncate N u)‖ ≤ M2 := by linarith
      exact pow_le_pow_left₀ (norm_nonneg _) h3 2
    have h := finiteCoulomb_physical_tail_bound sys r K rho L Hunit Blow Cs Bker M2 b
      (finiteFourierCoeffExtract (c0 + b) (molecularH2Coeff g (molecularH2Truncate N u)))
      hL hK1 hRho hRhoScale hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hPeriodic hH2
    exact h
  -- remove the output truncation
  have hN : ∀ N, ‖M (W (molecularH2Truncate N u))‖ ≤ C := by
    intro N
    have ht : Tendsto (fun b => molecularH2Truncate (c0 + b) (M (W (molecularH2Truncate N u))))
        atTop (𝓝 (M (W (molecularH2Truncate N u)))) :=
      (molecularH2Truncate_tendsto _).comp
        (tendsto_atTop_atTop.mpr fun n => ⟨n, fun b hb => by omega⟩)
    exact le_of_tendsto ht.norm (eventually_atTop.mpr ⟨N, fun b hb => hfin N b (by omega)⟩)
  -- remove the input truncation
  have hL1 : Tendsto (fun N => ‖M (W (molecularH2Truncate N u))‖) atTop (𝓝 ‖M (W u)‖) :=
    ((M.continuous.comp W.continuous).tendsto u |>.comp (molecularH2Truncate_tendsto u)).norm
  exact le_of_tendsto' hL1 hN

end Tail

/-! ## C. Time-uniform tails (`prop:dyn-boot`) -/

