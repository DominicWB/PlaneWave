/-- A one-particle pullback leaves every spectator Fourier momentum unchanged. -/
theorem molecularPositionParticle_fourierCoeff_transfer {eta : ℕ}
    (i : Fin eta) (V : UnitTorus3 → ℂ) (hV : MemLp V 2 volume)
    (q p : FourierConfig eta Lattice3) :
    UnitAddTorus.mFourierCoeff
        (fun x : MolecularPositionTorus eta => V (molecularPositionParticle i x))
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      if (∀ k : Fin eta, k ≠ i → q k = p k) then
        UnitAddTorus.mFourierCoeff V (latticeSub (q i) (p i)) else 0 := by
  classical
  by_cases hs : ∀ k : Fin eta, k ≠ i → q k = p k
  · rw [if_pos hs, ← (molecularParticleFrequency_transfer_eq_iff i q p).mpr hs]
    exact torusFourierPullback_coeff_image (molecularPositionParticle i)
      (molecularPositionParticle_measurePreserving i) (molecularParticleFrequency i)
      (fun n x => (mFourier_molecularParticleFrequency i n x).symm)
      V hV (latticeSub (q i) (p i))
  · rw [if_neg hs]
    apply torusFourierPullback_coeff_eq_zero (molecularPositionParticle i)
      (molecularPositionParticle_measurePreserving i) (molecularParticleFrequency i)
      (fun n x => (mFourier_molecularParticleFrequency i n x).symm) V hV
    intro n hn
    exact hs ((molecularParticleFrequency_transfer_mem_range_iff i q p).mp ⟨n, hn⟩)

/-- A pair-coordinate pullback has the exact spectator and total-momentum
selection rules used by the molecular pair kernel. -/
theorem molecularPositionDifference_fourierCoeff_transfer {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) (V : UnitTorus3 → ℂ) (hV : MemLp V 2 volume)
    (q p : FourierConfig eta Lattice3) :
    UnitAddTorus.mFourierCoeff
        (fun x : MolecularPositionTorus eta => V (molecularPositionDifference i j x))
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      if (∀ k : Fin eta, k ≠ i → k ≠ j → q k = p k) ∧ q i + q j = p i + p j then
        UnitAddTorus.mFourierCoeff V (latticeSub (q i) (p i)) else 0 := by
  classical
  by_cases hs : (∀ k : Fin eta, k ≠ i → k ≠ j → q k = p k) ∧
      q i + q j = p i + p j
  · rw [if_pos hs, ← (molecularPairFrequency_transfer_eq_iff i j hij q p).mpr hs]
    exact torusFourierPullback_coeff_image (molecularPositionDifference i j)
      (molecularPositionDifference_measurePreserving i j hij) (molecularPairFrequency i j)
      (fun n x => (mFourier_molecularPairFrequency i j n x).symm)
      V hV (latticeSub (q i) (p i))
  · rw [if_neg hs]
    apply torusFourierPullback_coeff_eq_zero (molecularPositionDifference i j)
      (molecularPositionDifference_measurePreserving i j hij) (molecularPairFrequency i j)
      (fun n x => (mFourier_molecularPairFrequency i j n x).symm) V hV
    intro n hn
    exact hs ((molecularPairFrequency_transfer_mem_range_iff i j hij q p).mp ⟨n, hn⟩)

/-- The literal nuclear translation has the existing positive transfer phase. -/
theorem molecularPositionNuclearCoulomb_fourierCoeff {eta : ℕ}
    (i : Fin eta) (R : UnitTorus3) (q p : FourierConfig eta Lattice3) :
    UnitAddTorus.mFourierCoeff
        (fun x : MolecularPositionTorus eta =>
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearArgument i R x))
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      if (∀ k : Fin eta, k ≠ i → q k = p k) then
        UnitAddTorus.mFourier (latticeSub (q i) (p i)) R *
          unitLatticeCoulombKernel (latticeSub (q i) (p i)) else 0 := by
  classical
  change UnitAddTorus.mFourierCoeff
    (fun x : MolecularPositionTorus eta =>
      (fun y : UnitTorus3 => canonicalUnitTorus3CoulombPotential.potential (y + R))
        (molecularPositionParticle i x)) _ = _
  rw [molecularPositionParticle_fourierCoeff_transfer i _
    (canonicalUnitTorus3CoulombPotential_translate_memLp R),
    canonicalUnitTorus3CoulombPotential_translate_fourierCoeff]

/-- The literal pair potential has exactly the pair kernel's selection rule. -/
theorem molecularPositionPairCoulomb_fourierCoeff {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) (q p : FourierConfig eta Lattice3) :
    UnitAddTorus.mFourierCoeff
        (fun x : MolecularPositionTorus eta =>
          canonicalUnitTorus3CoulombPotential.potential (molecularPositionDifference i j x))
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      if (∀ k : Fin eta, k ≠ i → k ≠ j → q k = p k) ∧ q i + q j = p i + p j then
        unitLatticeCoulombKernel (latticeSub (q i) (p i)) else 0 := by
  classical
  rw [molecularPositionDifference_fourierCoeff_transfer i j hij _
    canonicalUnitTorus3CoulombPotential.potential_memLp,
    canonicalUnitTorus3CoulombPotential.fourier_coeff]

/-- Restoring the physical amplitude gives the repulsive pair matrix element. -/
theorem molecularPositionPairCoulomb_scaled_fourierCoeff {eta : ℕ}
    (L : ℝ) (hL : 0 < L) (i j : Fin eta) (hij : i ≠ j)
    (q p : FourierConfig eta Lattice3) :
    (coulombCellAmplitude L : ℂ) *
      UnitAddTorus.mFourierCoeff
        (fun x : MolecularPositionTorus eta =>
          canonicalUnitTorus3CoulombPotential.potential (molecularPositionDifference i j x))
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      latticeElectronPairConfigurationKernel i j ((coulombCellAmplitude L) ^ 2) q p := by
  classical
  rw [molecularPositionPairCoulomb_fourierCoeff i j hij, latticeElectronPairConfigurationKernel]
  split_ifs
  · exact (latticeCoulombKernel_eq_scaled_unitKernel _
      (coulombCellAmplitude_pos hL).le (q i) (p i)).symm
  · exact mul_zero _

/-- Restoring the amplitude and negative charge gives the attractive nuclear
matrix element, including its phase and all spectator constraints. -/
theorem molecularPositionNuclearCoulomb_scaled_fourierCoeff
    {ν : Type*} [Fintype ν] {eta : ℕ} (L : ℝ) (hL : 0 < L)
    (data : FiniteBONuclearData ν) (i : Fin eta) (ell : ν)
    (q p : FourierConfig eta Lattice3) :
    -(coulombCellAmplitude L : ℂ) * (data.charge ell : ℂ) *
      UnitAddTorus.mFourierCoeff
        (fun x : MolecularPositionTorus eta =>
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearArgument i (data.position ell) x))
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      latticeReferenceConfigurationKernel i
        (latticeElectronNuclearKernel data (coulombCellAmplitude L) ell) q p := by
  classical
  rw [molecularPositionNuclearCoulomb_fourierCoeff, latticeReferenceConfigurationKernel]
  split_ifs
  · rw [latticeElectronNuclearKernel, latticeCoulombKernel_eq_scaled_unitKernel _
      (coulombCellAmplitude_pos hL).le]
    ring
  · exact mul_zero _

/-- The complete signed pointwise Coulomb function has exactly the nuclear
plus electron-pair Fourier kernel. Every coefficient, spectator constraint,
charge sign, and phase is derived from the independently defined function. -/
theorem molecularFourierConventionCoulombPotential_fourierCoeff
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (hL : 0 < L) (q p : FourierConfig eta Lattice3) :
    UnitAddTorus.mFourierCoeff (molecularFourierConventionCoulombPotential eta L data)
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) =
      molecularLatticeNuclearKernel eta data (coulombCellAmplitude L) q p +
        molecularLatticeElectronKernel eta (coulombCellAmplitude L) q p := by
  classical
  let pairV : FiniteElectronPair eta → MolecularPositionTorus eta → ℂ :=
    fun pair x => canonicalUnitTorus3CoulombPotential.potential
      (molecularPositionDifference pair.1.1 pair.1.2 x)
  let nucV : Fin eta → ν → MolecularPositionTorus eta → ℂ :=
    fun i ell x => canonicalUnitTorus3CoulombPotential.potential
      (molecularPositionNuclearArgument i (data.position ell) x)
  have hPair : ∀ pair : FiniteElectronPair eta, MemLp (pairV pair) 2 volume :=
    fun pair => molecularPositionPairCoulomb_memLp pair.1.1 pair.1.2 (ne_of_lt pair.2)
  have hNuc : ∀ i ell, MemLp (nucV i ell) 2 volume :=
    fun i ell => molecularPositionNuclearCoulomb_memLp i (data.position ell)
  have hWeighted : ∀ i ell,
      MemLp (fun x => (data.charge ell : ℂ) * nucV i ell x) 2 volume :=
    fun i ell => (hNuc i ell).const_mul (data.charge ell : ℂ)
  have hNucSum : ∀ i, MemLp (fun x => ∑ ell : ν,
      (data.charge ell : ℂ) * nucV i ell x) 2 volume := by
    intro i
    exact memLp_finsetSum _ (fun ell _ => hWeighted i ell)
  have hPairSum : MemLp (fun x => ∑ pair : FiniteElectronPair eta, pairV pair x) 2 volume :=
    memLp_finsetSum _ (fun pair _ => hPair pair)
  have hAllNuc : MemLp (fun x => ∑ i : Fin eta, ∑ ell : ν,
      (data.charge ell : ℂ) * nucV i ell x) 2 volume :=
    memLp_finsetSum _ (fun i _ => hNucSum i)
  change UnitAddTorus.mFourierCoeff
    (fun x => (coulombCellAmplitude L : ℂ) *
      ((∑ pair : FiniteElectronPair eta, pairV pair x) -
        ∑ i : Fin eta, ∑ ell : ν, (data.charge ell : ℂ) * nucV i ell x)) _ = _
  rw [torus_mFourierCoeff_const_mul,
    torus_mFourierCoeff_sub_of_memLp _ _ hPairSum hAllNuc,
    torus_mFourierCoeff_fintypeSum_of_memLp _ hPair,
    torus_mFourierCoeff_fintypeSum_of_memLp _ hNucSum]
  simp_rw [torus_mFourierCoeff_fintypeSum_of_memLp _ (hWeighted _),
    torus_mFourierCoeff_const_mul]
  rw [mul_sub, sub_eq_add_neg, add_comm, ← neg_mul]
  simp_rw [Finset.mul_sum, ← mul_assoc]
  unfold molecularLatticeNuclearKernel molecularLatticeElectronKernel
  congr 1
  · apply Finset.sum_congr rfl
    intro i _hi
    apply Finset.sum_congr rfl
    intro ell _hell
    exact molecularPositionNuclearCoulomb_scaled_fourierCoeff L hL data i ell q p
  · apply Finset.sum_congr rfl
    intro pair _hpair
    exact molecularPositionPairCoulomb_scaled_fourierCoeff L hL
      pair.1.1 pair.1.2 (ne_of_lt pair.2) q p

end
