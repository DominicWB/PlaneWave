/-!
# `thm:mult-cap` and `cor:stopping2`, Galerkin route

The fixed-cap bound `kinetic_capped_error`,
`|Δ⟨A_r⟩(t)| ≤ c₁ K^{-3} + c₂ κ^{-3} + c₃ t κ^{3/2} K^{-3}` for `λ₀ ≤ κ ≤ K`, is optimised over the
cap. With `s = t^{1/3}`:

* `s² K ≤ 1` (`t ≤ K^{-3/2}`): the cap `κ = K`, and `t K^{-3/2} ≤ t^{2/3} K^{-2}`
  (`cap_regime_small`);
* `1 ≤ s² K` and `λ₀³ s² ≤ K²`: the cap `κ = w²` with `w³ s = K`, which balances
  `κ^{-3} = t κ^{3/2} K^{-3} = t^{2/3} K^{-2}` (`cap_regime_mid`, `cap_mid_bounds`);
* `K² < λ₀³ s²` (`t ≳ K³`): the energy bound `|Δ⟨A_r⟩| ≤ ‖ψ₀‖ (Ξ₀ + T_N)`
  (`kinetic_expect_pair_le`) is at most `λ₀³ ‖ψ₀‖ (Ξ₀ + T_N) t^{2/3} K^{-2}`.

This gives `|Δ⟨A_r⟩(t)| ≤ C₁ K^{-3} + C₂ t^{2/3} K^{-2}` for all `t ≥ 0` and `K ≥ λ₀`
(`kinetic_capped_rate`). Together with `thm:mult-gal` it gives `thm:mult-cap` (Galerkin) in the
minimum form `D₁ K^{-3} + D₂ min(t K^{-3/2}, t^{2/3} K^{-2})` in position space
(`kinetic_capped_min_position`, and `thm_mult_cap` with its propagators), and the window law
`cor:stopping2` (Galerkin) for the secant-slope estimator (`stopping_window`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveKinetic

open PlaneWaveCertificate PlaneWaveDynamics

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-! ## The arithmetic of the optimisation -/

/-- The regime `s² K ≤ 1` (`t = s³ ≤ K^{-3/2}`): with the cap `κ = K` the secular term
`t K^{3/2} K^{-3} = t K^{-3/2}` is at most `t^{2/3} K^{-2} = s² K^{-2}`. -/
lemma cap_regime_small {c1 c2 c3 K s t : ℝ} (hK : 0 < K) (hs : 0 ≤ s) (hc3 : 0 ≤ c3)
    (hst : s ^ 3 = t) (h : s ^ 2 * K ≤ 1) :
    c1 * (1 / K) ^ 3 + c2 * (1 / K) ^ 3 + c3 * t * (K * Real.sqrt K) * (1 / K) ^ 3 ≤
      (c1 + c2) * (1 / K) ^ 3 + c3 * s ^ 2 * (1 / K) ^ 2 := by
  subst hst
  have hsK : s * Real.sqrt K ≤ 1 := by
    have h1 := Real.sqrt_le_sqrt h
    rwa [Real.sqrt_mul' _ hK.le, Real.sqrt_sq hs, Real.sqrt_one] at h1
  have e : c3 * s ^ 3 * (K * Real.sqrt K) * (1 / K) ^ 3 =
      (c3 * s ^ 2 * (1 / K) ^ 2) * (s * Real.sqrt K) := by
    field_simp
  have h0 : 0 ≤ c3 * s ^ 2 * (1 / K) ^ 2 :=
    mul_nonneg (mul_nonneg hc3 (sq_nonneg s)) (sq_nonneg _)
  rw [e]
  have := mul_le_mul_of_nonneg_left hsK h0
  linarith

/-- The regime `1 ≤ s² K`, `λ₀³ s² ≤ K²`: the cap `κ = w²` with `w³ s = K` makes both
`κ^{-3}` and `t κ^{3/2} K^{-3}` equal to `t^{2/3} K^{-2} = s² K^{-2}`. -/
lemma cap_regime_mid {c1 c2 c3 K s t w : ℝ} (hs : 0 < s) (hw : 0 < w) (hst : s ^ 3 = t)
    (hws : w ^ 3 * s = K) :
    c1 * (1 / K) ^ 3 + c2 * (1 / w ^ 2) ^ 3 + c3 * t * (w ^ 2 * Real.sqrt (w ^ 2)) * (1 / K) ^ 3 =
      c1 * (1 / K) ^ 3 + (c2 + c3) * s ^ 2 * (1 / K) ^ 2 := by
  subst hst hws
  rw [Real.sqrt_sq hw.le]
  field_simp
  ring

/-- In the middle regime the balancing cap is admissible: `λ₀ ≤ w² ≤ K`. -/
lemma cap_mid_bounds {K s w lam0 : ℝ} (hK : 0 < K) (hs : 0 < s)
    (hws : w ^ 3 * s = K) (h1 : 1 ≤ s ^ 2 * K) (h2 : lam0 ^ 3 * s ^ 2 ≤ K ^ 2) :
    lam0 ≤ w ^ 2 ∧ w ^ 2 ≤ K := by
  have hw6 : (w ^ 2) ^ 3 * s ^ 2 = K ^ 2 := by rw [← hws]; ring
  have hs2 : 0 < s ^ 2 := pow_pos hs 2
  constructor
  · refine le_of_pow_le_pow_left₀ (n := 3) (by norm_num) (sq_nonneg w) ?_
    refine le_of_mul_le_mul_right ?_ hs2
    rw [hw6]
    exact h2
  · refine le_of_pow_le_pow_left₀ (n := 3) (by norm_num) hK.le ?_
    refine le_of_mul_le_mul_right ?_ hs2
    rw [hw6]
    calc K ^ 2 = K ^ 2 * 1 := (mul_one _).symm
      _ ≤ K ^ 2 * (s ^ 2 * K) := mul_le_mul_of_nonneg_left h1 (sq_nonneg K)
      _ = K ^ 3 * s ^ 2 := by ring

/-- Two bounds `A₁ x + A₂ a` and `C₁ x + C₂ b` combine into
`max A₁ C₁ · x + max A₂ C₂ · min a b`. -/
lemma le_max_min_combine {E A1 A2 C1 C2 x a b : ℝ} (hx : 0 ≤ x) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (h1 : E ≤ A1 * x + A2 * a) (h2 : E ≤ C1 * x + C2 * b) :
    E ≤ max A1 C1 * x + max A2 C2 * min a b := by
  rcases le_total a b with hab | hab
  · rw [min_eq_left hab]
    have e1 := mul_le_mul_of_nonneg_right (le_max_left A1 C1) hx
    have e2 := mul_le_mul_of_nonneg_right (le_max_left A2 C2) ha
    linarith
  · rw [min_eq_right hab]
    have e1 := mul_le_mul_of_nonneg_right (le_max_right A1 C1) hx
    have e2 := mul_le_mul_of_nonneg_right (le_max_right A2 C2) hb
    linarith

/-! ## The constants -/

/-- The constants of the fixed-cap bound are nonnegative. -/
lemma capConsts_nonneg (sys : CoulombSystem eta ν) (L Hunit : ℝ)
    (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) {Blow Cs Bker lam0 s0 hu hs hv : ℝ}
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hs0 : 0 ≤ s0) (hhu : 0 ≤ hu)
    (hhs : 0 ≤ hs) (hhv : 0 ≤ hv) :
    0 ≤ (capConsts sys L Hunit Blow Cs Bker lam0 s0 hu hs hv).1 ∧
      0 ≤ (capConsts sys L Hunit Blow Cs Bker lam0 s0 hu hs hv).2.1 ∧
      0 ≤ (capConsts sys L Hunit Blow Cs Bker lam0 s0 hu hs hv).2.2 := by
  have hb0 : 0 ≤ relB sys L Hunit := relB_nonneg sys L Hunit hC
  have hm0 : 0 ≤ sys.maxMass := by linarith [sys.one_le_maxMass]
  have hCt0 : ∀ M, 0 ≤ M → 0 ≤ finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M :=
    fun M hM => finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker hM
  unfold capConsts
  dsimp only
  generalize relB sys L Hunit = b at hb0 ⊢
  generalize sys.maxMass = m at hm0 ⊢
  generalize finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker = Ct at hCt0 ⊢
  generalize finiteCoulombPhysicalMassConstant sys L Hunit = Cm at hC ⊢
  have hΞ₀ : 0 ≤ 2 * hu + 2 * b * s0 := by positivity
  have hΞ₁ : 0 ≤ 2 * hv + 2 * b * hs := by positivity
  have hTN : 0 ≤ 2 * (2 * (2 * hu + 2 * b * s0) + 2 * b * s0) + 2 * b * s0 := by positivity
  have hΞN : 0 ≤ 2 * (2 * (2 * hv + 2 * b * hs) + 2 * b * hs) + 2 * b * hs := by positivity
  have hc0 := hCt0 (m * (s0 + 2 * (2 * hu + 2 * b * s0))) (by positivity)
  have hcN := hCt0 (m * (s0 + 2 * (2 * (2 * (2 * hu + 2 * b * s0) + 2 * b * s0) +
    2 * b * s0))) (by positivity)
  have hc1 := hCt0 1 zero_le_one
  have hβ : 0 ≤ 2 * m * (2 * hv + 2 * b * hs) + Ct (m * (s0 + 2 * (2 * hu + 2 * b * s0))) := by
    positivity
  refine ⟨by positivity, by positivity, ?_⟩
  positivity

/-- The energy bound `‖ψ₀‖ (Ξ₀ + T_N)` on kinetic expectations (`Ξ₀ = 2 hu + 2b s0` bounds the
exact kinetic norm, `T_N = 2 (2 Ξ₀ + 2b s0) + 2b s0` the Galerkin one). -/
noncomputable def kinTrivConst (sys : CoulombSystem eta ν) (L Hunit s0 hu : ℝ) : ℝ :=
  let b : ℝ := relB sys L Hunit
  let Ξ₀ : ℝ := 2 * hu + 2 * b * s0
  s0 * (Ξ₀ + (2 * (2 * Ξ₀ + 2 * b * s0) + 2 * b * s0))

/-- The constants `(C₁, C₂)` of `|Δ⟨A_r⟩(t)| ≤ C₁ K^{-3} + C₂ t^{2/3} K^{-2}` for the data
norms `(s0, hu, hs, hv)` (as in `capConsts`) and the lowest cap `λ₀`. -/
noncomputable def capRateConsts (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker lam0 : ℝ)
    (s0 hu hs hv : ℝ) : ℝ × ℝ :=
  let c := capConsts sys L Hunit Blow Cs Bker lam0 s0 hu hs hv
  (c.1 + c.2.1, c.2.1 + c.2.2 + kinTrivConst sys L Hunit s0 hu * lam0 ^ 3)

/-! ## The optimised bound on the Fourier side -/

section CappedRate

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **The energy bound.** For every kinetic multiplier `μ`, the expectations of `μ` in
`ψ(t) = U t ψ₀` and in `ψ_N(t) = e^{-iH_N t} P ψ₀` differ by at most `‖ψ₀‖ (Ξ₀ + T_N)`,
uniformly in the time and the cube. -/
theorem kinetic_expect_pair_le (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (u₀ : MolecularFourierH2 eta) (m : KinMult sys (2 * Real.pi / L)) (t : ℝ) :
    |m.expect (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) -
        m.expect (finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀))))| ≤
      kinTrivConst sys L Hunit ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ ‖H u₀‖ := by
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set T := coulombFourierKineticH2 sys (2 * Real.pi / L)
  set b := relB sys L Hunit with hbdef
  set S0 := ‖S u₀‖ with hS0def
  set Ξ₀ := 2 * ‖H u₀‖ + 2 * b * S0 with hΞ₀def
  have hb : 0 ≤ b := relB_nonneg sys L Hunit hC
  have hS0 : 0 ≤ S0 := norm_nonneg _
  obtain ⟨u, hu1, hu2⟩ := hgraph t u₀
  set y := UN t (extractCLM n (S u₀))
  have hSb : finiteFourierLpIsometry eta n y = S (cubeLift (2 * Real.pi / L) n y) :=
    (stateMap_cubeLift _ n y).symm
  -- the exact state
  have hSu : ‖S u‖ = S0 := by rw [hu1, LinearIsometryEquiv.norm_map]
  have hTu : ‖T u‖ ≤ Ξ₀ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u
    rwa [hu1, hu2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
  have ha : m.expect (S u) ≤ S0 * Ξ₀ := by
    refine (m.expect_le_norm_mul u).trans ?_
    rw [hSu]
    exact mul_le_mul_of_nonneg_left ((m.norm_h2_le u).trans hTu) hS0
  -- the Galerkin state
  have hy2 : ‖y‖ = ‖extractCLM n (S u₀)‖ := LinearIsometryEquiv.norm_map _ _
  have hE : ‖extractCLM n (S u₀)‖ ≤ S0 := norm_extractCLM_le n (S u₀)
  have hSl : ‖S (cubeLift (2 * Real.pi / L) n y)‖ ≤ S0 := by
    rw [← hSb, LinearIsometry.norm_map, hy2]
    exact hE
  have hTl : ‖T (cubeLift (2 * Real.pi / L) n y)‖ ≤
      2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0 := by
    have h := elliptic_cube sys L H hKernel Hunit hL hPeriodic hC n y
    have hy : ‖finiteCoulombHamiltonian sys L n y‖ =
        ‖finiteCoulombHamiltonian sys L n (extractCLM n (S u₀))‖ := by
      rw [← hNcomm, LinearIsometryEquiv.norm_map]
    have hH := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n u₀
    have hT0 : ‖T u₀‖ ≤ Ξ₀ := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u₀
    have hbE : b * ‖extractCLM n (S u₀)‖ ≤ b * S0 := mul_le_mul_of_nonneg_left hE hb
    rw [hy, hy2] at h
    linarith
  have hb' : m.expect (S (cubeLift (2 * Real.pi / L) n y)) ≤
      S0 * (2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0) :=
    (m.expect_le_norm_mul _).trans
      (mul_le_mul hSl ((m.norm_h2_le _).trans hTl) (norm_nonneg _) hS0)
  have h0a := m.expect_nonneg (S u)
  have h0b := m.expect_nonneg (S (cubeLift (2 * Real.pi / L) n y))
  have key : |m.expect (S u) - m.expect (S (cubeLift (2 * Real.pi / L) n y))| ≤
      S0 * (Ξ₀ + (2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0)) := by
    rw [abs_le]
    constructor <;> linarith
  rw [← hu1, hSb]
  exact key

include hKernel hL hPeriodic in
/-- **`thm:mult-cap` (Galerkin), the sublinear branch.** For `ψ₀ = S u₀ ∈ D(H²)`
(`H u₀ = S v₀`), a particle `r`, a lowest cap `λ₀ ≥ max(1, 2g)` and every cube with
`K = gn ≥ λ₀`, for all `t ≥ 0`:
`|⟨ψ(t), A_r ψ(t)⟩ - ⟨ψ_N(t), A_r ψ_N(t)⟩| ≤ C₁ K^{-3} + C₂ t^{2/3} K^{-2}`, with
`(C₁, C₂) = capRateConsts` (fixed before the cube and the time). -/
theorem kinetic_capped_rate (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x)
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (Blow Cs Bker : ℝ) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (r : Fin eta) {lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlK : lam0 ≤ (2 * Real.pi / L) * n) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let C := capRateConsts sys L Hunit Blow Cs Bker lam0
      ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ ‖H u₀‖
      ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ ‖H v₀‖
    |(regKin sys (2 * Real.pi / L) r).expect (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) -
        (regKin sys (2 * Real.pi / L) r).expect (finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀))))| ≤
      C.1 * (1 / K) ^ 3 + C.2 * t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2 := by
  intro K C
  have hK1 : 1 ≤ K := hl.trans hlK
  have hKpos : 0 < K := lt_of_lt_of_le zero_lt_one hK1
  have hl0 : 0 ≤ lam0 := zero_le_one.trans hl
  have hX3 : 0 ≤ (1 / K) ^ 3 := pow_nonneg (one_div_nonneg.mpr hKpos.le) 3
  have hX2 : 0 ≤ (1 / K) ^ 2 := sq_nonneg _
  obtain ⟨hc1, hc2, hc3⟩ := capConsts_nonneg sys L Hunit hC (lam0 := lam0)
    (s0 := ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖) (hu := ‖H u₀‖)
    (hs := ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖) (hv := ‖H v₀‖) hBlow hCs hBker
    (norm_nonneg _) (norm_nonneg _) (norm_nonneg _) (norm_nonneg _)
  set c := capConsts sys L Hunit Blow Cs Bker lam0
    ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ ‖H u₀‖
    ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ ‖H v₀‖ with hcdef
  set D := kinTrivConst sys L Hunit ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ ‖H u₀‖
    with hDdef
  set E := (regKin sys (2 * Real.pi / L) r).expect
      (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) -
    (regKin sys (2 * Real.pi / L) r).expect (finiteFourierLpIsometry eta n
      (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀)))) with hEdef
  have hC1 : C.1 = c.1 + c.2.1 := rfl
  have hC2 : C.2 = c.2.1 + c.2.2 + D * lam0 ^ 3 := rfl
  have htriv : |E| ≤ D := kinetic_expect_pair_le sys L H hKernel Hunit hL hPeriodic hC U hgraph n
    UN hNcomm u₀ (regKin sys (2 * Real.pi / L) r) t
  have hD0 : 0 ≤ D := (abs_nonneg _).trans htriv
  rw [hC1, hC2]
  -- the time scale `s = t^{1/3}`
  obtain ⟨s, hs0, hst, hs2⟩ : ∃ s : ℝ, 0 ≤ s ∧ s ^ 3 = t ∧ t ^ ((2 : ℝ) / 3) = s ^ 2 := by
    refine ⟨t ^ ((1 : ℝ) / 3), Real.rpow_nonneg ht _, ?_, ?_⟩
    · rw [← Real.rpow_natCast, ← Real.rpow_mul ht]
      norm_num
    · rw [← Real.rpow_natCast, ← Real.rpow_mul ht]
      norm_num
  rw [hs2]
  have hY : 0 ≤ s ^ 2 * (1 / K) ^ 2 := mul_nonneg (sq_nonneg s) hX2
  have hDl : 0 ≤ D * lam0 ^ 3 := mul_nonneg hD0 (pow_nonneg hl0 3)
  by_cases h3 : K ^ 2 < lam0 ^ 3 * s ^ 2
  · -- `t ≳ K³`: the energy bound
    have hq : 1 ≤ lam0 ^ 3 * s ^ 2 * (1 / K) ^ 2 := by
      have e : lam0 ^ 3 * s ^ 2 * (1 / K) ^ 2 = lam0 ^ 3 * s ^ 2 / K ^ 2 := by ring
      rw [e, le_div_iff₀ (pow_pos hKpos 2), one_mul]
      exact h3.le
    have e1 := mul_le_mul_of_nonneg_left hq hD0
    have e2 : 0 ≤ (c.1 + c.2.1) * (1 / K) ^ 3 := mul_nonneg (add_nonneg hc1 hc2) hX3
    have e3 : 0 ≤ (c.2.1 + c.2.2) * (s ^ 2 * (1 / K) ^ 2) := mul_nonneg (add_nonneg hc2 hc3) hY
    refine htriv.trans ?_
    linarith
  replace h3 : lam0 ^ 3 * s ^ 2 ≤ K ^ 2 := not_lt.mp h3
  by_cases h1 : s ^ 2 * K ≤ 1
  · -- `t ≤ K^{-3/2}`: the cap `κ = K`
    have h : |E| ≤ c.1 * (1 / K) ^ 3 + c.2.1 * (1 / K) ^ 3 +
        c.2.2 * t * (K * Real.sqrt K) * (1 / K) ^ 3 :=
      kinetic_capped_error sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph hderiv n UN hN0
        hNcomm hNderiv Blow Cs Bker hBlow hCs hBker hAmplitude hBkerScale hCsScale u₀ v₀ huv r hl
        h2g hlK le_rfl ht
    have h' := cap_regime_small (c1 := c.1) (c2 := c.2.1) hKpos hs0 hc3 hst h1
    have e1 : 0 ≤ c.2.1 * (s ^ 2 * (1 / K) ^ 2) := mul_nonneg hc2 hY
    have e2 : 0 ≤ D * lam0 ^ 3 * (s ^ 2 * (1 / K) ^ 2) := mul_nonneg hDl hY
    refine h.trans (h'.trans ?_)
    linarith
  · -- the balancing cap `κ = w²`, `w³ s = K`
    have h1' : 1 ≤ s ^ 2 * K := (not_le.mp h1).le
    have hspos : 0 < s := by
      rcases hs0.lt_or_eq with h | h
      · exact h
      · exfalso
        apply h1
        rw [← h]
        simp
    have hKs : 0 < K / s := div_pos hKpos hspos
    obtain ⟨w, hw, hws⟩ : ∃ w : ℝ, 0 < w ∧ w ^ 3 * s = K := by
      refine ⟨(K / s) ^ ((1 : ℝ) / 3), Real.rpow_pos_of_pos hKs _, ?_⟩
      have e : ((K / s) ^ ((1 : ℝ) / 3)) ^ 3 = K / s := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hKs.le]
        norm_num
      rw [e, div_mul_cancel₀ K hspos.ne']
    obtain ⟨hlw, hwK⟩ := cap_mid_bounds hKpos hspos hws h1' h3
    have h : |E| ≤ c.1 * (1 / K) ^ 3 + c.2.1 * (1 / w ^ 2) ^ 3 +
        c.2.2 * t * (w ^ 2 * Real.sqrt (w ^ 2)) * (1 / K) ^ 3 :=
      kinetic_capped_error sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph hderiv n UN hN0
        hNcomm hNderiv Blow Cs Bker hBlow hCs hBker hAmplitude hBkerScale hCsScale u₀ v₀ huv r hl
        h2g hlw hwK ht
    rw [cap_regime_mid hspos hw hst hws] at h
    have e1 : 0 ≤ c.2.1 * (1 / K) ^ 3 := mul_nonneg hc2 hX3
    have e2 : 0 ≤ D * lam0 ^ 3 * (s ^ 2 * (1 / K) ^ 2) := mul_nonneg hDl hY
    refine h.trans ?_
    linarith

end CappedRate

/-! ## Position space -/

section Position

/-- **`thm:mult-cap` (Galerkin) in position space, the sublinear branch.** In the setting of
`kinetic_galerkin_position`, for a particle `r`, a lowest cap `λ₀ ≥ max(1, 2g)` and every cube
with `K = 2πn/L ≥ λ₀`, for all `t ≥ 0`:
`|⟨ψ(t), A_r ψ(t)⟩ - ⟨ψ_N(t), A_r ψ_N(t)⟩| ≤ C₁ K^{-3} + C₂ t^{2/3} K^{-2}`, with
`(C₁, C₂) = capRateConsts` at `(‖ψ₀‖, ‖h₀‖, ‖h₀‖, ‖h₁‖)`. -/
theorem kinetic_capped_position (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x)
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁)
    (r : Fin eta) {lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlK : lam0 ≤ (2 * Real.pi / L) * n) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let ψN := physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n ((physMap eta).symm ψ₀))))
    let C := capRateConsts sys L molecularCanonicalUnitHardyConstant
      (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
      (molecularCanonicalKernelConstant L) lam0 ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖
    |(regKin sys (2 * Real.pi / L) r).posExpect (U t ψ₀) -
        (regKin sys (2 * Real.pi / L) r).posExpect ψN| ≤
      C.1 * (1 / K) ^ 3 + C.2 * t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2 := by
  intro K ψN C
  have hPeriodic := canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨H, hKernel, -⟩ :=
    exists_coulombFourierH2Operator sys L molecularCanonicalUnitHardyConstant hL hPeriodic
  have hiff := hasCoulombHamiltonian_iff_phys sys L hL H hKernel
  have hC := finiteCoulombPhysicalMassConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  -- the propagator on the Fourier side
  set UF : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
    fun s => ((physMap eta).trans (U s)).trans (physMap eta).symm with hUFdef
  have hUF : ∀ s x, UF s x = (physMap eta).symm (U s (physMap eta x)) := fun s x => rfl
  have h0F : ∀ x, UF 0 x = x := by
    intro x
    rw [hUF, hU0, LinearIsometryEquiv.symm_apply_apply]
  have hgraphF : ∀ s u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        UF s (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = UF s (H u) := by
    intro s u
    obtain ⟨u', h1, h2⟩ := (hiff _ _).mp (hUgraph s _ _ ((hiff _ _).mpr ⟨u, rfl, rfl⟩))
    refine ⟨u', ?_, ?_⟩
    · rw [hUF, ← h1, LinearIsometryEquiv.symm_apply_apply]
    · rw [hUF, ← h2, LinearIsometryEquiv.symm_apply_apply]
  have hderivF : ∀ s u, HasDerivAt (fun r => UF r (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • UF s (H u))) s := by
    intro s u
    have h := hUderiv s _ _ ((hiff _ _).mpr ⟨u, rfl, rfl⟩)
    have h2 := (((physMap eta).symm.toContinuousLinearEquiv.toContinuousLinearMap).restrictScalars
      ℝ).hasFDerivAt.comp_hasDerivAt s h
    simp only [ContinuousLinearMap.coe_restrictScalars'] at h2
    rw [map_neg, map_smul] at h2
    exact h2
  -- the initial state in `D(H²)`
  obtain ⟨u₀, hu₀1, hu₀2⟩ := (hiff ψ₀ h₀).mp hψ₀
  obtain ⟨v₀, hv₀1, hv₀2⟩ := (hiff h₀ h₁).mp hh₀
  have huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀ :=
    (physMap eta).injective (hu₀2.trans hv₀1.symm)
  -- the canonical constants
  obtain ⟨hBlow, hCs, hBker, hLow, hKernelScale, hSobolev⟩ :=
    molecularCanonicalTailConstants_spec L hL
  have h := kinetic_capped_rate sys L H hKernel molecularCanonicalUnitHardyConstant hL hPeriodic
    hC UF h0F hgraphF hderivF n UN hN0 hNcomm hNderiv (molecularCanonicalLowConstant L)
    (molecularCanonicalSobolevConstant L) (molecularCanonicalKernelConstant L) hBlow hCs hBker
    hLow hKernelScale hSobolev u₀ v₀ huv r hl h2g hlK ht
  -- back to position space
  have hψt : U t ψ₀ = physMap eta (UF t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) := by
    rw [hUF, LinearIsometryEquiv.apply_symm_apply, hu₀1]
  have hψN : ψN = physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀)))) := by
    simp only [ψN]
    rw [← hu₀1, LinearIsometryEquiv.symm_apply_apply]
  rw [hψt, hψN, posExpect_physMap, posExpect_physMap]
  have e1 : ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ = ‖ψ₀‖ := by
    rw [← hu₀1, LinearIsometryEquiv.norm_map]
  have e2 : ‖H u₀‖ = ‖h₀‖ := by rw [← hu₀2, LinearIsometryEquiv.norm_map]
  have e3 : ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ = ‖h₀‖ := by
    rw [← hv₀1, LinearIsometryEquiv.norm_map]
  have e4 : ‖H v₀‖ = ‖h₁‖ := by rw [← hv₀2, LinearIsometryEquiv.norm_map]
  simp only [e1, e2, e3, e4] at h
  exact h

/-- The constants `(D₁, D₂)` of `thm:mult-cap` (Galerkin) in position space, for the data norms
`‖ψ₀‖ = s0`, `‖H ψ₀‖ = hu`, `‖H² ψ₀‖ = hv` and the lowest cap `λ₀`: the larger of the
`thm:mult-gal` constants and the sublinear-branch constants. -/
noncomputable def multCapConsts (sys : CoulombSystem eta ν) (L lam0 s0 hu hv : ℝ) : ℝ × ℝ :=
  let A := kinConsts sys L molecularCanonicalUnitHardyConstant (molecularCanonicalLowConstant L)
    (molecularCanonicalSobolevConstant L) (molecularCanonicalKernelConstant L) s0 hu hv
  let C := capRateConsts sys L molecularCanonicalUnitHardyConstant
    (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
    (molecularCanonicalKernelConstant L) lam0 s0 hu hu hv
  (max A.1 C.1, max A.2 C.2)

/-- **`thm:mult-cap` (Galerkin) in position space.** Let `U t` be unitaries on `L²((T³)^η)` with
`U 0 = 1` that preserve the graph of the Coulomb Hamiltonian and solve the Schrödinger equation on
it, and `U_N` the propagator of `H_N` on the cube `n`. For `ψ₀ ∈ D(H²)`
(`H ψ₀ = h₀`, `H h₀ = h₁`), a particle `r`, a lowest cap `λ₀ ≥ max(1, 2g)` and every cube with
`K = 2πn/L ≥ λ₀`, for all `t ≥ 0`:
`|⟨ψ(t), A_r ψ(t)⟩ - ⟨ψ_N(t), A_r ψ_N(t)⟩| ≤ D₁ K^{-3} + D₂ min(t K^{-3/2}, t^{2/3} K^{-2})`,
with `(D₁, D₂) = multCapConsts` at `(‖ψ₀‖, ‖h₀‖, ‖h₁‖)`. -/
theorem kinetic_capped_min_position (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁)
    (r : Fin eta) {lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlK : lam0 ≤ (2 * Real.pi / L) * n) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let ψN := physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n ((physMap eta).symm ψ₀))))
    let D := multCapConsts sys L lam0 ‖ψ₀‖ ‖h₀‖ ‖h₁‖
    |(regKin sys (2 * Real.pi / L) r).posExpect (U t ψ₀) -
        (regKin sys (2 * Real.pi / L) r).posExpect ψN| ≤
      D.1 * (1 / K) ^ 3 +
        D.2 * min (t * Real.sqrt (1 / K) ^ 3) (t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2) := by
  intro K ψN D
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hK1 : 1 ≤ K := hl.trans hlK
  have hKpos : 0 < K := lt_of_lt_of_le zero_lt_one hK1
  have hn : 2 ≤ n := by
    have h2 : (2 * Real.pi / L) * 2 ≤ (2 * Real.pi / L) * n := by
      have := h2g.trans hlK
      linarith
    have : (2 : ℝ) ≤ n := le_of_mul_le_mul_left h2 hg
    exact_mod_cast this
  have hA := kinetic_galerkin_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
    hNderiv hn hK1 ψ₀ h₀ h₁ hψ₀ hh₀ (regKin sys (2 * Real.pi / L) r) ht
  have hB := kinetic_capped_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNcomm hNderiv ψ₀ h₀
    h₁ hψ₀ hh₀ r hl h2g hlK ht
  dsimp only at hA hB
  refine le_max_min_combine (pow_nonneg (one_div_nonneg.mpr hKpos.le) 3)
    (mul_nonneg ht (pow_nonneg (Real.sqrt_nonneg _) 3))
    (mul_nonneg (Real.rpow_nonneg ht _) (sq_nonneg _)) (hA.trans_eq ?_) (hB.trans_eq ?_)
  · ring
  · ring

/-- **`thm:mult-cap` (Galerkin) with its propagators.** For a periodic Coulomb system there is a
propagator `U` on `L²((T³)^η)` (unitary group, strongly continuous, preserving the graph of the
Hamiltonian, solving the Schrödinger equation on it, and the only evolution that does so), and
for every cube `n` a Galerkin propagator `U_N` of `H_N`, such that for all `ψ₀ ∈ D(H²)`
(`H ψ₀ = h₀`, `H h₀ = h₁`), every particle `r` and every lowest cap `λ₀ ≥ max(1, 2g)`, with
`(D₁, D₂) = multCapConsts` at `(λ₀, ‖ψ₀‖, ‖h₀‖, ‖h₁‖)` fixed before the cube and the time: for
every cube with `K = 2πn/L ≥ λ₀` and every `t ≥ 0`,
`|⟨ψ(t), A_r ψ(t)⟩ - ⟨ψ_N(t), A_r ψ_N(t)⟩| ≤ D₁ K^{-3} + D₂ min(t K^{-3/2}, t^{2/3} K^{-2})`. -/
theorem thm_mult_cap (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ ψ₀ h₀ h₁ : MolecularPositionL2 eta, HasCoulombHamiltonian sys L ψ₀ h₀ →
          HasCoulombHamiltonian sys L h₀ h₁ →
          ∀ (r : Fin eta) (lam0 : ℝ), 1 ≤ lam0 → 2 * (2 * Real.pi / L) ≤ lam0 →
          let D := multCapConsts sys L lam0 ‖ψ₀‖ ‖h₀‖ ‖h₁‖
          ∀ n : ℕ, lam0 ≤ (2 * Real.pi / L) * n →
            ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            let ψN := physMap eta (finiteFourierLpIsometry eta n
              (UN n t (extractCLM n ((physMap eta).symm ψ₀))))
            |(regKin sys (2 * Real.pi / L) r).posExpect (U t ψ₀) -
                (regKin sys (2 * Real.pi / L) r).posExpect ψN| ≤
              D.1 * (1 / K) ^ 3 +
                D.2 * min (t * Real.sqrt (1 / K) ^ 3) (t ^ ((2 : ℝ) / 3) * (1 / K) ^ 2) := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, -, -⟩ := exists_coulombPropagator sys L hL
  choose UN hN0 hNadd _ hNcomm hNderiv _ using
    fun n => exists_finitePropagator (finiteCoulombHamiltonian_isSymmetric sys L n)
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, UN, hN0, hNadd, hNderiv, ?_⟩
  intro ψ₀ h₀ h₁ hψ₀ hh₀ r lam0 hl h2g D n hlK t ht
  exact kinetic_capped_min_position sys L hL U h0 hgraph hderiv n (UN n) (hN0 n) (hNadd n)
    (hNcomm n) (hNderiv n) ψ₀ h₀ h₁ hψ₀ hh₀ r hl h2g hlK ht

end Position

/-! ## `cor:stopping2`, Galerkin route -/

/-- The window arithmetic: `(D₁ x + D₂ min(0·a, 0^{2/3} b) + D₁ x + D₂ min(T a, T^{2/3} b))/(v T)`
equals `(D₂ min(a, b / T^{1/3}) + 2 D₁ x / T)/v`. -/
lemma window_arith {D1 D2 x a b v T : ℝ} (hv : 0 < v) (hT : 0 < T) :
    (D1 * x + D2 * min (0 * a) ((0 : ℝ) ^ ((2 : ℝ) / 3) * b) +
        (D1 * x + D2 * min (T * a) (T ^ ((2 : ℝ) / 3) * b))) / (v * T) =
      (D2 * min a (b / T ^ ((1 : ℝ) / 3)) + 2 * D1 * x / T) / v := by
  have hτ : T ^ ((2 : ℝ) / 3) * b = T * (b / T ^ ((1 : ℝ) / 3)) := by
    have h3 : 0 < T ^ ((1 : ℝ) / 3) := Real.rpow_pos_of_pos hT _
    have e : T ^ ((2 : ℝ) / 3) * T ^ ((1 : ℝ) / 3) = T := by
      rw [← Real.rpow_add hT]
      norm_num
    rw [eq_comm, mul_div_assoc', div_eq_iff h3.ne']
    calc T * b = (T ^ ((2 : ℝ) / 3) * T ^ ((1 : ℝ) / 3)) * b := by rw [e]
      _ = T ^ ((2 : ℝ) / 3) * b * T ^ ((1 : ℝ) / 3) := by ring
  rw [Real.zero_rpow (by norm_num), zero_mul, zero_mul, min_self, mul_zero, add_zero, hτ,
    ← mul_min_of_nonneg _ _ hT.le]
  field_simp
  ring

/-- **`cor:stopping2`, Galerkin route (window law).** In the setting of
`kinetic_capped_min_position`, the secant-slope estimator
`Ŝ = (⟨A_r⟩(T) - ⟨A_r⟩(0))/(v_p T)` over a window `[0, T]`, evaluated on the Galerkin trajectory,
deviates from the same functional of the exact trajectory by at most
`(D₂ min(K^{-3/2}, T^{-1/3} K^{-2}) + 2 D₁ K^{-3}/T)/v_p`. -/
theorem stopping_window (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁)
    (r : Fin eta) {lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlK : lam0 ≤ (2 * Real.pi / L) * n) {vp T : ℝ} (hvp : 0 < vp) (hT : 0 < T) :
    let K := (2 * Real.pi / L) * n
    let ψN : ℝ → MolecularPositionL2 eta := fun s => physMap eta (finiteFourierLpIsometry eta n
      (UN s (extractCLM n ((physMap eta).symm ψ₀))))
    let D := multCapConsts sys L lam0 ‖ψ₀‖ ‖h₀‖ ‖h₁‖
    let μ := regKin sys (2 * Real.pi / L) r
    |(μ.posExpect (U T ψ₀) - μ.posExpect (U 0 ψ₀)) / (vp * T) -
        (μ.posExpect (ψN T) - μ.posExpect (ψN 0)) / (vp * T)| ≤
      (D.2 * min (Real.sqrt (1 / K) ^ 3) ((1 / K) ^ 2 / T ^ ((1 : ℝ) / 3)) +
        2 * D.1 * (1 / K) ^ 3 / T) / vp := by
  intro K ψN D μ
  have h0 := kinetic_capped_min_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
    hNderiv ψ₀ h₀ h₁ hψ₀ hh₀ r hl h2g hlK (le_refl 0)
  have hT' := kinetic_capped_min_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
    hNderiv ψ₀ h₀ h₁ hψ₀ hh₀ r hl h2g hlK hT.le
  exact (secant_slope_le hvp hT h0 hT').trans (le_of_eq (window_arith hvp hT))

end PlaneWaveKinetic

