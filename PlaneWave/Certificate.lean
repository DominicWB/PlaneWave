/-- The classical kinetic expression with masses of a torus function with a `C²` real
lift. -/
def coulombPositionContDiffKinetic (sys : CoulombSystem eta ν) (L : ℝ)
    (φ : C(MolecularPositionTorus eta, ℂ))
    (hφ : ContDiff ℝ 2 (torusRealLift φ)) : C(MolecularPositionTorus eta, ℂ) :=
  coulombPositionC2Kinetic sys L (TorusCoordinateC2Test.ofContDiffLift φ hφ)

