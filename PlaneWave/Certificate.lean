        rw [div_le_iff₀ (molecularFourierH2Weight_pos eta g p)]
        calc ‖(x : FourierConfig eta Lattice3 → ℂ) p‖ =
              ε n * ‖(x : FourierConfig eta Lattice3 → ℂ) p‖ *
                (1 + g ^ 2 * ((n : ℝ) + 1) ^ 2) := by
              simp only [ε]
