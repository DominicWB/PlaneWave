/-- Physical ground-pair existence on the electronic space and the
molecular-data cubic error bounds. -/
theorem periodicMolecularCubicError
    {ν : Type*} [Fintype ν] (eta : ℕ) (heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ Ψ : MolecularSpinL2 eta,
      HasMolecularSpinGroundPair eta L data Ψ E ∧
      |E| ≤ molecularGroundEnergyBudget eta data L ∧
      ∀ m : ℕ, molecularDataCubicThreshold eta data L ≤ m →
        ∃ EN : ℝ, IsMolecularSpinCubicGroundEnergy eta L data
          ((2 * Real.pi / L) * (m : ℝ)) EN ∧
          (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
          0 ≤ EN - E ∧
          EN - E ≤ molecularDataCubicErrorConstant eta data L /
            ((2 * Real.pi / L) * (m : ℝ)) ^ 3 ∧
          EN - E ≤ molecularDataBasisErrorConstant eta data L /
            (((2 * m + 1) ^ 3 : ℕ) : ℝ) :=
  molecularSpin_cubic_error eta heta data L hL

/-- Monotone physical Ritz convergence on the electronic space, its infimum,
and certified intervals. -/
theorem periodicMolecularCubicConvergence
    {ν : Type*} [Fintype ν] (eta : ℕ) (heta : 0 < eta)
    (data : FiniteBONuclearData ν) (L : ℝ) (hL : 0 < L) :
    ∃ E : ℝ, ∃ Ψ : MolecularSpinL2 eta,
      HasMolecularSpinGroundPair eta L data Ψ E ∧
      ∃ m0 : ℕ, 1 ≤ m0 ∧ ∃ energy : ℕ → ℝ,
        (∀ n : ℕ, IsMolecularSpinCubicGroundEnergy eta L data
          ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) (energy n)) ∧
        Antitone energy ∧
        Tendsto energy atTop (𝓝 E) ∧
        E = (⨅ n : ℕ, energy n) ∧
        ∀ n : ℕ,
          (cubicPlaneWaveBox (m0 + n)).card = (2 * (m0 + n) + 1) ^ 3 ∧
          0 ≤ energy n - E ∧
          energy n - E ≤ molecularCanonicalCubicErrorConstant eta data E L /
            ((2 * Real.pi / L) * ((m0 + n : ℕ) : ℝ)) ^ 3 ∧
          energy n - E ≤ molecularCanonicalBasisErrorConstant eta data E L /
            (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ∧
          energy n - molecularCanonicalBasisErrorConstant eta data E L /
              (((2 * (m0 + n) + 1) ^ 3 : ℕ) : ℝ) ≤ E ∧
          E ≤ energy n :=
  molecularSpin_cubic_convergence eta heta data L hL

