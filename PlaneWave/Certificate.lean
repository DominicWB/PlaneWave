        ⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ‖ := norm_sub_rev _ _
  linarith only [htri, hswap, hmain, hnormal', hdef', h1]

/-- **The threshold of `cor:norm` with spin.** For `‖Ψ₀‖ = 1` and `Ψ₀ ∈ D(H²)` on the
spin-inclusive space, as soon as `(δ₁ K^{-5/2})² ≤ 1/2` (spin-inclusive norms),
`‖P Ψ₀‖² ≥ 1/2`; in particular `P Ψ₀ ≠ 0`. -/
theorem coulomb_normalisation_threshold_spin {D : ℕ} (sys : CoulombSystem eta ν) (L : ℝ)
    (hL : 0 < L) (n : ℕ) (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁) (hnorm : ‖Ψ₀‖ = 1)
    (hthr : (obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀‖ ‖H₀‖ ‖H₀‖
      ‖H₁‖ * rho ^ 5) ^ 2 ≤ 1 / 2) :
    let ΨP : CoulombSpinL2 eta D := WithLp.toLp 2 fun σ =>
      physMap eta (molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ)))
    1 / 2 ≤ ‖ΨP‖ ^ 2 ∧ ΨP ≠ 0 := by
  intro ΨP
  obtain ⟨-, hdef⟩ := spin_proj_defect sys L hL n rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs
    hBker h2gK hAmplitude hBkerScale hCsScale Ψ₀ H₀ H₁ hΨ₀ hH₀
  have hdef' : ‖Ψ₀‖ ^ 2 - ‖ΨP‖ ^ 2 ≤
      (obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ *
        rho ^ 5) ^ 2 := hdef
  have h1 : ‖Ψ₀‖ ^ 2 = 1 := by rw [hnorm]; norm_num
  have hhalf : 1 / 2 ≤ ‖ΨP‖ ^ 2 := by linarith only [hdef', h1, hthr]
  refine ⟨hhalf, fun h0 => ?_⟩
  rw [h0, norm_zero] at hhalf
  norm_num at hhalf

