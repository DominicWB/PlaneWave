lemma tsum_h1f_le (u : MolecularFourierH2 eta) :
    ∑' p, h1f sys L u p ≤ ‖molecularH2StateMap eta (2 * Real.pi / L) u‖ *
      ‖molecularH2StateMap eta (2 * Real.pi / L) u +
        (2 : ℂ) • coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ := by
