/-! ## Ninety-third milestone: transfer the Hardy data to ambient `R^3` -/

/-- Generic zero extension from the centered half-open cube to its ambient
three-dimensional real vector space. -/
noncomputable def centeredCube3ZeroExtension
    (g : CenteredCube3 → ℂ) :
    CenteredCube3Ambient → ℂ :=
  Function.extend
    (Subtype.val : CenteredCube3 → CenteredCube3Ambient)
    g
    0

@[simp] lemma centeredCube3ZeroExtension_subtype
    (g : CenteredCube3 → ℂ)
    (y : CenteredCube3) :
    centeredCube3ZeroExtension g y.1 = g y := by
  unfold centeredCube3ZeroExtension
  exact Function.extend_val_apply y.2

/-- The generic zero extension vanishes outside the centered cube. -/
lemma centeredCube3ZeroExtension_eq_zero_of_not_mem
    (g : CenteredCube3 → ℂ)
    (x : CenteredCube3Ambient)
    (hx : x ∉ centeredCube3AmbientSet) :
    centeredCube3ZeroExtension g x = 0 := by
  classical
  unfold centeredCube3ZeroExtension
  have hx' :
      ¬ ∀ i : Fin 3,
        x i ∈ Set.Ioc
          (centeredCube3Base i)
          (centeredCube3Base i + 1) := by
    simpa [centeredCube3AmbientSet] using hx
  rw [Function.extend_val_apply' hx']
  simp

/-- A centered-cube `L²` function has square-integrable zero extension to
ambient `R^3`.  This is the measure-theoretic bridge needed before applying
ambient integration by parts. -/
lemma centeredCube3ZeroExtension_sq_integrable
    (g : CenteredCube3 → ℂ)
    (hg : MeasureTheory.MemLp g 2 centeredCube3Measure) :
    MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        ‖centeredCube3ZeroExtension g x‖ ^ 2)
      MeasureTheory.volume := by
  classical

  have hSub :
      MeasureTheory.Integrable
        (fun y : CenteredCube3 => ‖g y‖ ^ 2)
        centeredCube3Measure :=
    (MeasureTheory.memLp_two_iff_integrable_sq_norm
      hg.aestronglyMeasurable).1 hg

  have hSetMeas :
      MeasurableSet
        {x : CenteredCube3Ambient |
          ∀ i : Fin 3,
            x i ∈ Set.Ioc
              (centeredCube3Base i)
              (centeredCube3Base i + 1)} := by
    simpa [centeredCube3AmbientSet] using
      centeredCube3AmbientSet_measurable

  have hEmbedding :
      MeasurableEmbedding
        (Subtype.val : CenteredCube3 → CenteredCube3Ambient) := by
    exact MeasurableEmbedding.subtype_coe hSetMeas

  have hOnRange :
      MeasureTheory.IntegrableOn
        (fun x : CenteredCube3Ambient =>
          ‖centeredCube3ZeroExtension g x‖ ^ 2)
        (Set.range (Subtype.val : CenteredCube3 → CenteredCube3Ambient))
        MeasureTheory.volume := by
    apply hEmbedding.integrableOn_range_iff_comap.mpr
    simpa [centeredCube3Measure, Function.comp_def] using hSub

  have hRange :
      Set.range (Subtype.val : CenteredCube3 → CenteredCube3Ambient) =
        centeredCube3AmbientSet := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact y.2
    · intro hx
      have hx' :
          ∀ i : Fin 3,
            x i ∈ Set.Ioc
              (centeredCube3Base i)
              (centeredCube3Base i + 1) := by
        simpa [centeredCube3AmbientSet] using hx
      exact ⟨⟨x, hx'⟩, rfl⟩

  have hOn :
      MeasureTheory.IntegrableOn
        (fun x : CenteredCube3Ambient =>
          ‖centeredCube3ZeroExtension g x‖ ^ 2)
        centeredCube3AmbientSet
        MeasureTheory.volume := by
    rw [← hRange]
    exact hOnRange

  have hIndicator :
      MeasureTheory.Integrable
        (centeredCube3AmbientSet.indicator
          (fun x : CenteredCube3Ambient =>
            ‖centeredCube3ZeroExtension g x‖ ^ 2))
        MeasureTheory.volume :=
    hOn.integrable_indicator centeredCube3AmbientSet_measurable

  have hEq :
      centeredCube3AmbientSet.indicator
          (fun x : CenteredCube3Ambient =>
            ‖centeredCube3ZeroExtension g x‖ ^ 2)
        =
      (fun x : CenteredCube3Ambient =>
        ‖centeredCube3ZeroExtension g x‖ ^ 2) := by
    funext x
    by_cases hx : x ∈ centeredCube3AmbientSet
    · simp [hx]
    · have hz : centeredCube3ZeroExtension g x = 0 :=
        centeredCube3ZeroExtension_eq_zero_of_not_mem g x hx
      simp [hx, hz]

  rw [hEq] at hIndicator
  exact hIndicator

/-- The pointwise cutoff wave `chi * psi` belongs to `L²` on the centered cube.
The proof uses the existing bounded-cutoff multiplier state and only changes to
the continuous finite-Fourier representative a.e. -/
lemma centeredCube3RadialCutoffWaveFunction_memLp
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ) :
    MeasureTheory.MemLp
      (centeredCube3RadialCutoffWaveFunction rho R index f)
      2 centeredCube3Measure := by

  let psi : CenteredCube3L2 :=
    centeredCube3StateFromTorus
      (torus3FourierPolynomial index f)

  have hProd :
      MeasureTheory.MemLp
        (fun y : CenteredCube3 =>
          (centeredCube3RadialCutoffMultiplier rho R hRhoR).multiplier y *
            psi y)
        2 centeredCube3Measure :=
    (centeredCube3RadialCutoffMultiplier rho R hRhoR).product_memLp psi

  have hPull :=
    centeredCube3StateFromTorus_eq_ae
      (torus3FourierPolynomial index f)

  have hTorus :=
    torus3FourierPolynomial_eq_continuous_ae index f

  have hContinuous :
      ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
        torus3FourierPolynomial index f
            (unitTorus3CenteredEquiv.symm y)
          =
        torus3FourierContinuousPolynomial index f
            (unitTorus3CenteredEquiv.symm y) :=
    unitTorus3CenteredEquiv_symm_measurePreserving.quasiMeasurePreserving.ae
      hTorus

  have hEq :
      (fun y : CenteredCube3 =>
        (centeredCube3RadialCutoffMultiplier rho R hRhoR).multiplier y *
          psi y)
        =ᵐ[centeredCube3Measure]
      centeredCube3RadialCutoffWaveFunction rho R index f := by
    filter_upwards [hPull, hContinuous] with y hpull hcont
    change
      (centeredCube3RadialCutoff rho R y : ℂ) *
          centeredCube3StateFromTorus
            (torus3FourierPolynomial index f) y
        =
      centeredCube3RadialCutoffWaveFunction rho R index f y
    unfold centeredCube3RadialCutoffWaveFunction
    rw [hpull, hcont]

  exact (MeasureTheory.memLp_congr_ae hEq).1 hProd

/-- The ambient zero extension of `chi * psi` is square integrable. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_sq_integrable
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ) :
    MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        ‖centeredCube3RadialCutoffWaveZeroExtension
            rho R index f x‖ ^ 2)
      MeasureTheory.volume := by
  change
    MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        ‖centeredCube3ZeroExtension
            (centeredCube3RadialCutoffWaveFunction rho R index f) x‖ ^ 2)
      MeasureTheory.volume
  exact
    centeredCube3ZeroExtension_sq_integrable
      (centeredCube3RadialCutoffWaveFunction rho R index f)
      (centeredCube3RadialCutoffWaveFunction_memLp hRhoR index f)

/-- Every ambient zero-extended product-rule gradient component is square
integrable. -/
lemma centeredCube3RadialCutoffRawGradientZeroExtension_sq_integrable
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        ‖centeredCube3RadialCutoffRawGradientZeroExtension
            rho R index f j x‖ ^ 2)
      MeasureTheory.volume := by
  change
    MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        ‖centeredCube3ZeroExtension
            (centeredCube3RadialCutoffRawGradientFunction
              rho R index f j) x‖ ^ 2)
      MeasureTheory.volume
  exact
    centeredCube3ZeroExtension_sq_integrable
      (centeredCube3RadialCutoffRawGradientFunction rho R index f j)
      (centeredCube3RadialCutoffRawGradientFunction_memLp
        hrho hRhoR index f j)

/-!
## Ninety-third milestone

The Hardy proof can now be carried out entirely in ambient `R^3`: the zero
extension of `chi * psi` and every component of its explicit product-rule
gradient have square-integrable representatives with respect to ambient
Lebesgue measure.  The next step can therefore formulate the regularized
integration-by-parts and Cauchy--Schwarz argument without returning to subtype
measure bookkeeping.
-/

end

end PlaneWaveCertificate

