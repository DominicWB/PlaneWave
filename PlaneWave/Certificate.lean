      _ = _ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hΛ0 : 0 ≤ eta * (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker Mw * rho) :=
    mul_nonneg (Nat.cast_nonneg _) (mul_nonneg
      (finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker hMw0) hRho)
