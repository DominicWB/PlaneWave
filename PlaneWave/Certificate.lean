open MeasureTheory

/-- Use the same torus measure instance as the compiled Fourier constructions. -/
local instance unitAddCircleMeasureSpaceForFourier110 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-! ## One-hundred-tenth milestone: derive the potential quadratic-form bound

The periodic Green-function remainder bound, target-state H2 estimate, and
spectral/Galerkin facts remain explicit background hypotheses.  In contrast,
`hPotential` is proved below for the explicit finite operator already used by
the certificate.  We do not replace it by an assumed full-potential H1 estimate:
the needed H1 estimates are derived from the proved local Hardy theorem, the
specified remainder bound, and finite-dimensional coefficient domination.
-/

/-- The ordinary squared norm is bounded by its finite Fourier H1 mass. -/
lemma norm_sq_le_fourierH1Sq
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ) (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖u‖ ^ 2 ≤ fourierH1Sq kabs u := by
  classical
  rw [EuclideanSpace.norm_sq_eq]
  unfold fourierH1Sq
  apply Finset.sum_le_sum
  intro p hp
  have h := mul_nonneg (boKineticSymbol_nonneg kabs p) (sq_nonneg ‖u.ofLp p‖)
  nlinarith only [h]

/-- The finite Fourier H1 norm of the discarded vector is exactly the existing
`discardedH1Sq`, not just an upper bound for it. -/
lemma fourierH1Sq_discardedGalerkinVector
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ) :
    fourierH1Sq kabs (discardedGalerkinVector K kabs coeff) =
      discardedH1Sq K kabs coeff := by
  classical
  let d : Finset (FourierConfig eta μ) :=
    discardedConfigFinset (eta := eta) K kabs
  have hd : (Finset.univ.filter (fun p : FourierConfig eta μ => p ∈ d)) = d := by
    ext p
    simp
  calc
    fourierH1Sq kabs (discardedGalerkinVector K kabs coeff) =
        ∑ p : FourierConfig eta μ,
          if p ∈ d then coeffMass coeff p + coeffTotalDerivMass kabs coeff p else 0 := by
      unfold fourierH1Sq
      apply Finset.sum_congr rfl
      intro p hp
      by_cases h : p ∈ d
      · have h' : p ∈ discardedConfigFinset K kabs := h
        simp only [discardedGalerkinVector_apply, if_pos h', if_pos h]
        rw [← boKineticSymbol_mul_coeffMass]
        unfold coeffMass
        ring
      · have h' : p ∉ discardedConfigFinset K kabs := h
        simp [discardedGalerkinVector_apply, h', h]
    _ = discardedH1Sq K kabs coeff := by
      rw [← Finset.sum_filter, hd]
      rfl

/-- Unsquared form of an H1 operator bound, including the zero-vector case. -/
lemma norm_le_sqrt_fourierH1Sq_of_operatorBound
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ))
    {B : ℝ} (hB : 0 ≤ B) (hA : HasH1OperatorBound kabs A B)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖A u‖ ≤ B * Real.sqrt (fourierH1Sq kabs u) := by
  have hBound := hA u
  have hRootSq := Real.sq_sqrt (fourierH1Sq_nonneg kabs u)
  have hRight : 0 ≤ B * Real.sqrt (fourierH1Sq kabs u) :=
    mul_nonneg hB (Real.sqrt_nonneg _)
  have hSquare : ‖A u‖ ^ 2 ≤ (B * Real.sqrt (fourierH1Sq kabs u)) ^ 2 := by
    rw [mul_pow, hRootSq]
    exact hBound
  nlinarith only [hSquare, hRight, norm_nonneg (A u)]

/-- Addition of H1-bounded operators adds their norm constants, rather than
introducing a factor from squaring the summands separately. -/
lemma hasH1OperatorBound_add
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (A D : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ))
    {B C : ℝ} (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hA : HasH1OperatorBound kabs A B) (hD : HasH1OperatorBound kabs D C) :
    HasH1OperatorBound kabs (A + D) (B + C) := by
  intro u
  have hNorm : ‖(A + D) u‖ ≤ (B + C) * Real.sqrt (fourierH1Sq kabs u) := by
    calc
      ‖(A + D) u‖ = ‖A u + D u‖ := rfl
      _ ≤ ‖A u‖ + ‖D u‖ := norm_add_le _ _
      _ ≤ B * Real.sqrt (fourierH1Sq kabs u) +
          C * Real.sqrt (fourierH1Sq kabs u) :=
        add_le_add (norm_le_sqrt_fourierH1Sq_of_operatorBound kabs A hB hA u)
          (norm_le_sqrt_fourierH1Sq_of_operatorBound kabs D hC hD u)
      _ = (B + C) * Real.sqrt (fourierH1Sq kabs u) := by ring
  have hSquare := sq_le_sq_of_nonneg (norm_nonneg ((A + D) u)) hNorm
  rw [mul_pow, Real.sq_sqrt (fourierH1Sq_nonneg kabs u)] at hSquare
  exact hSquare

/-- An H1-to-L2 operator estimate implies the absolute potential form estimate
by Cauchy--Schwarz.  Symmetry is not needed for this inequality. -/
lemma potentialQuadratic_abs_le_of_h1OperatorBound
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ))
    {B : ℝ} (hB : 0 ≤ B) (hW : HasH1OperatorBound kabs W B)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    |potentialQuadratic W u| ≤ B * fourierH1Sq kabs u := by
  have huSq := norm_sq_le_fourierH1Sq kabs u
  have huRoot : ‖u‖ ≤ Real.sqrt (fourierH1Sq kabs u) := by
    have hRootSq := Real.sq_sqrt (fourierH1Sq_nonneg kabs u)
    have hRoot0 := Real.sqrt_nonneg (fourierH1Sq kabs u)
    nlinarith only [huSq, hRootSq, hRoot0, norm_nonneg u]
  have hWRoot := norm_le_sqrt_fourierH1Sq_of_operatorBound kabs W hB hW u
  calc
    |potentialQuadratic W u| ≤ ‖inner ℂ u (W u)‖ :=
      Complex.abs_re_le_norm _
    _ ≤ ‖u‖ * ‖W u‖ := norm_inner_le_norm (𝕜 := ℂ) _ _
    _ ≤ Real.sqrt (fourierH1Sq kabs u) *
        (B * Real.sqrt (fourierH1Sq kabs u)) :=
      mul_le_mul huRoot hWRoot (norm_nonneg _) (Real.sqrt_nonneg _)
    _ = B * fourierH1Sq kabs u := by
      calc
        Real.sqrt (fourierH1Sq kabs u) * (B * Real.sqrt (fourierH1Sq kabs u)) =
            B * (Real.sqrt (fourierH1Sq kabs u)) ^ 2 := by ring
        _ = B * fourierH1Sq kabs u := by
          rw [Real.sq_sqrt (fourierH1Sq_nonneg kabs u)]

/-- Discharge the exact hPotential input once the full operator H1 bound has
been proved.  The only extra condition is the scalar comparison B <= Cpot. -/
lemma discarded_potential_form_of_h1OperatorBound
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ))
    {B Cpot : ℝ} (hB : 0 ≤ B) (hW : HasH1OperatorBound kabs W B)
    (hScale : B ≤ Cpot) :
    potentialQuadratic W (discardedGalerkinVector K kabs coeff) ≤
      Cpot * discardedH1Sq K kabs coeff := by
  have hAbs := potentialQuadratic_abs_le_of_h1OperatorBound kabs W hB hW
    (discardedGalerkinVector K kabs coeff)
  rw [fourierH1Sq_discardedGalerkinVector] at hAbs
  exact le_trans (le_abs_self _) (hAbs.trans
    (mul_le_mul_of_nonneg_right hScale (discardedH1Sq_nonneg K kabs coeff)))

/-! ### The proved periodic Hardy estimate under the agreed scalar background input -/

/-- Package the proved local Hardy theorem into the already existing inverse-
radius cutoff construction.  There is no independent Hardy data argument. -/
noncomputable def canonicalCenteredCube3InverseRadiusCutoffData
    {rho R : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (hHalf : R < (1 / 2 : ℝ)) :
    CenteredCube3InverseRadiusCutoffData
      (centeredCube3RadialCutoffAinnerCoarse rho R) (1 / rho) :=
  CenteredCube3InnerRadiusHardyData.toCutoffData
    (CenteredCube3RadialCutoffHardyData.toInnerRadiusHardyData
      (CenteredCube3RadialCutoffExplicitGradientData.toRadialCutoffHardyData
        (CenteredCube3RadialCutoffRawHardyData.toExplicitGradientData
          (CenteredCube3RadialCutoffInverseRadiusHardyData.toRawHardyData
            (CenteredCube3RadialCutoffHardyOnlyData.toInverseRadiusHardyData
              (CenteredCube3RadialCutoffPointwiseHardyData.toHardyOnlyData
                (centeredCube3RadialCutoffPointwiseHardyData_of_radii hrho hRhoR hHalf)))))))
    hrho

/-- The periodic H1-to-L2 bound is now a theorem from the specified bounded-
remainder assumption and scalar choices of the constants. -/
lemma canonicalPeriodicCoulombHardyBound_of_remainder_bound
    {rho R Clocal Breg Hunit : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R) (hHalf : R < (1 / 2 : ℝ))
    (hBreg : 0 ≤ Breg)
    (hRemainder : ∀ᵐ x : UnitTorus3 ∂volume,
      ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ Breg)
    (hCutoffScale :
      2 * (centeredCube3RadialCutoffAinnerCoarse rho R ^ 2 + (1 / rho) ^ 2) ≤ Clocal ^ 2)
    (hPeriodicScale : 2 * (Real.pi ^ 2 * Clocal ^ 2 + Breg ^ 2) ≤ Hunit ^ 2) :
    HasCanonicalPeriodicCoulombHardyBound Hunit := by
  let cutoff := canonicalCenteredCube3InverseRadiusCutoffData hrho hRhoR hHalf
  let split : CanonicalPeriodicCoulombCenteredCubeH1Split Clocal Breg :=
    { singular := cutoff.toInverseRadiusH1Data hCutoffScale
      regular := canonicalUnitTorus3CoulombRemainderMultiplier hBreg hRemainder
      product_eq := by
        intro α inst index f
        exact canonicalUnitTorus3Coulomb_decomposition_of_remainder_bound
          cutoff hBreg hRemainder index f }
  exact hasCanonicalPeriodicCoulombHardyBound_of_centeredCubeH1Split split hPeriodicScale

/-- Positive reciprocal-lattice scale makes the physical H1 comparison positive. -/
lemma physicalH1Scale_pos {g : ℝ} (hg : 0 < g) : 0 < physicalH1Scale g := by
  unfold physicalH1Scale
  exact lt_min (by norm_num) (by positivity)

/-- A concrete nonnegative choice for the physical Coulomb H1 constant.
This depends only on g, the squared kernel strength C, and the unit-torus
constant H; it does not depend on K or the finite basis size. -/
noncomputable def coulombPhysicalH1Constant (g C H : ℝ) : ℝ :=
  Real.sqrt (C * H ^ 2 / physicalH1Scale g)

lemma coulombPhysicalH1Constant_nonneg (g C H : ℝ) :
    0 ≤ coulombPhysicalH1Constant g C H := Real.sqrt_nonneg _

/-- The scalar near-term inequality in the new BO wrapper always has this
explicit choice when g > 0 and C >= 0. -/
lemma coulombPhysicalH1Constant_sq_mul_scale
    {g C : ℝ} (H : ℝ) (hg : 0 < g) (hC : 0 ≤ C) :
    (coulombPhysicalH1Constant g C H) ^ 2 * physicalH1Scale g = C * H ^ 2 := by
  have hs : 0 < physicalH1Scale g := physicalH1Scale_pos hg
  have hNum : 0 ≤ C * H ^ 2 := mul_nonneg hC (sq_nonneg H)
  unfold coulombPhysicalH1Constant
  rw [Real.sq_sqrt (div_nonneg hNum (le_of_lt hs))]
  field_simp [ne_of_gt hs]

/-- Reuse the established Fourier/Bessel bridges to get the unsplit finite
one-particle Coulomb estimate, uniformly in the auxiliary basis size. -/
lemma oneParticleCoulombH1Bound_of_canonicalPeriodic
    (g C B Hunit : ℝ) (count : ℕ)
    (hC : 0 ≤ C) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasOneParticleCoulombH1Bound g C B count := by
  have hPotential : HasUnitTorus3CoulombPotentialH1L2Bound
      canonicalUnitTorus3CoulombPotential.toPotentialRealization Hunit := hPeriodic
  have hProduct := unitTorus3CoulombProductH1L2Bound_of_potential
    canonicalUnitTorus3CoulombPotential.toPotentialRealization Hunit hPotential
  have hPartial := unitTorus3CoulombFourierPartialSumH1L2Bound_of_product
    canonicalUnitTorus3CoulombPotential.toPotentialRealization.toProductRealization
    Hunit hProduct
  have hFinite := finiteSupportUnitLatticeCoulombHardyBound_of_fourierPartialSums
    Hunit hPartial
  have hUniversal := universalUnitLatticeCoulombHardyBound_of_finiteSupport Hunit hFinite
  have hUnit := dimensionlessFiniteCoulombHardyBound_of_universalUnitLattice
    Hunit count hUniversal
  intro f
  rw [finiteCoulombOneParticleOutputSq_eq_C_mul_unit C count hC f]
  calc
    C * finiteCoulombOneParticleOutputSq 1 count f ≤
        C * (Hunit ^ 2 * finitePlaneWaveLatticeH1Sq count f) :=
      mul_le_mul_of_nonneg_left (hUnit f) hC
    _ = (C * Hunit ^ 2) * finitePlaneWaveLatticeH1Sq count f := by ring
    _ ≤ (B ^ 2 * physicalH1Scale g) * finitePlaneWaveLatticeH1Sq count f :=
      mul_le_mul_of_nonneg_right hScale (finitePlaneWaveLatticeH1Sq_nonneg count f)
    _ = B ^ 2 * (physicalH1Scale g * finitePlaneWaveLatticeH1Sq count f) := by ring
    _ ≤ B ^ 2 * finiteOneParticleH1Sq (finitePlaneWaveKabs g count) f :=
      mul_le_mul_of_nonneg_left
        (physicalH1Scale_mul_latticeH1Sq_le_finiteOneParticleH1Sq g count f) (sq_nonneg B)

/-! ### Complex-kernel domination and exact finite spectator summation -/

/-- Configurations are exactly an outer configuration and one reference momentum. -/
noncomputable def referenceSliceConfigEquiv
    {eta : ℕ} {μ : Type*} (r : Fin eta) :
    (OuterConfig eta r μ × μ) ≃ FourierConfig eta μ where
  toFun z := referenceSliceConfig r z.1 z.2
  invFun p := (outerConfigOf r p, p r)
  left_inv := by
    rintro ⟨b, v⟩
    simp only [outerConfigOf_referenceSliceConfig, referenceSliceConfig_ref]
  right_inv p := referenceSliceConfig_of_outerConfig_eq r (outerConfigOf r p) p rfl

/-- Finite Fubini for reference-momentum slices, with no multiplicity constant. -/
lemma sum_fourierConfig_eq_sum_referenceSlices
    {eta : ℕ} {μ : Type*} [Fintype μ]
    {M : Type*} [AddCommMonoid M] (r : Fin eta) (F : FourierConfig eta μ → M) :
    (∑ p : FourierConfig eta μ, F p) =
      ∑ b : OuterConfig eta r μ, ∑ v : μ, F (referenceSliceConfig r b v) := by
  classical
  calc
    (∑ p : FourierConfig eta μ, F p) =
        ∑ z : OuterConfig eta r μ × μ, F (referenceSliceConfigEquiv r z) :=
      (Equiv.sum_comp (referenceSliceConfigEquiv r) F).symm
    _ = _ := Fintype.sum_prod_type _

/-- The reference convolution is the one-particle matrix action on each slice. -/
lemma referenceKernelConvolutionOperator_apply_referenceSlice
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (r : Fin eta) (kernel : μ → μ → ℂ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ))
    (b : OuterConfig eta r μ) (v : μ) :
    (referenceKernelConvolutionOperator r kernel u).ofLp (referenceSliceConfig r b v) =
      ∑ w : μ, u.ofLp (referenceSliceConfig r b w) * kernel v w := by
  classical
  rw [referenceKernelConvolutionOperator_apply, sum_fourierConfig_eq_sum_referenceSlices r]
  have hEntry : ∀ (b' : OuterConfig eta r μ) (w : μ),
      referenceConfigurationKernel r kernel (referenceSliceConfig r b v)
          (referenceSliceConfig r b' w) = if b = b' then kernel v w else 0 := by
    intro b' w
    by_cases h : b = b'
    · rw [if_pos h]
      have hOuter : outerConfigOf r (referenceSliceConfig r b v) =
          outerConfigOf r (referenceSliceConfig r b' w) := by
        rw [outerConfigOf_referenceSliceConfig, outerConfigOf_referenceSliceConfig]
        exact h
      simpa only [referenceSliceConfig_ref] using
        referenceConfigurationKernel_of_outer_eq r kernel
          (referenceSliceConfig r b v) (referenceSliceConfig r b' w) hOuter
    · rw [if_neg h]
      apply referenceConfigurationKernel_of_outer_ne
      simpa only [outerConfigOf_referenceSliceConfig] using h
  simp_rw [hEntry]
  rw [Finset.sum_eq_single b]
  · simp
  · intro b' hb' hne
    simp [Ne.symm hne]
  · intro hb
    exact (hb (Finset.mem_univ b)).elim

/-- A one-particle H1 bound lifts to the full reference operator, without an
extra factor from the number of spectators or the basis size. -/
lemma referenceKernelConvolutionOperator_h1Bound_of_oneParticle
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (r : Fin eta) (kabs : μ → ℝ) (kernel : μ → μ → ℂ) (B : ℝ)
    (hOne : ∀ a : μ → ℂ,
      (∑ v : μ, ‖∑ w : μ, a w * kernel v w‖ ^ 2) ≤
        B ^ 2 * finiteOneParticleH1Sq kabs a) :
    HasH1OperatorBound kabs (referenceKernelConvolutionOperator r kernel) B := by
  classical
  intro u
  rw [EuclideanSpace.norm_sq_eq, sum_fourierConfig_eq_sum_referenceSlices r]
  simp_rw [referenceKernelConvolutionOperator_apply_referenceSlice]
  calc
    (∑ b : OuterConfig eta r μ,
        ∑ v : μ, ‖∑ w : μ, u.ofLp (referenceSliceConfig r b w) * kernel v w‖ ^ 2) ≤
        ∑ b : OuterConfig eta r μ,
          B ^ 2 * finiteOneParticleH1Sq kabs (fun w => u.ofLp (referenceSliceConfig r b w)) := by
      apply Finset.sum_le_sum
      intro b hb
      exact hOne (fun w => u.ofLp (referenceSliceConfig r b w))
    _ = B ^ 2 * (∑ b : OuterConfig eta r μ, ∑ w : μ,
          (1 + (kabs w) ^ 2) * ‖u.ofLp (referenceSliceConfig r b w)‖ ^ 2) := by
      unfold finiteOneParticleH1Sq
      rw [Finset.mul_sum]
    _ ≤ B ^ 2 * (∑ b : OuterConfig eta r μ, ∑ w : μ,
          (1 + boKineticSymbol kabs (referenceSliceConfig r b w)) *
            ‖u.ofLp (referenceSliceConfig r b w)‖ ^ 2) := by
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg B)
      apply Finset.sum_le_sum
      intro b hb
      apply Finset.sum_le_sum
      intro w hw
      have hComponent : (kabs w) ^ 2 ≤ boKineticSymbol kabs (referenceSliceConfig r b w) := by
        simpa only [referenceSliceConfig_ref] using
          component_sq_le_boKineticSymbol kabs (referenceSliceConfig r b w) r
      exact mul_le_mul_of_nonneg_right
        (add_le_add (le_refl (1 : ℝ)) hComponent) (sq_nonneg _)
    _ = B ^ 2 * fourierH1Sq kabs u := by
      unfold fourierH1Sq
      rw [sum_fourierConfig_eq_sum_referenceSlices r]

/-- An arbitrary complex kernel bounded entrywise by the positive Coulomb
amplitude inherits the one-particle H1 estimate.  Taking coefficient magnitudes
preserves the H1 mass exactly; this permits phases and signs in the kernel. -/
lemma coulomb_dominated_kernel_oneParticle_h1
    (g C B : ℝ) (count : ℕ)
    (kernel : FinitePlaneWaveMode count → FinitePlaneWaveMode count → ℂ)
    (hDom : ∀ v w,
      ‖kernel v w‖ ≤ Real.sqrt (finiteCoulombDifferenceSquareWeight C count v w))
    (hOne : HasOneParticleCoulombH1Bound g C B count)
    (a : FinitePlaneWaveMode count → ℂ) :
    (∑ v : FinitePlaneWaveMode count,
        ‖∑ w : FinitePlaneWaveMode count, a w * kernel v w‖ ^ 2) ≤
      B ^ 2 * finiteOneParticleH1Sq (finitePlaneWaveKabs g count) a := by
  classical
  let b : FinitePlaneWaveMode count → ℂ := fun w => (‖a w‖ : ℂ)
  have hMass : finiteOneParticleH1Sq (finitePlaneWaveKabs g count) b =
      finiteOneParticleH1Sq (finitePlaneWaveKabs g count) a := by
    unfold finiteOneParticleH1Sq
    apply Finset.sum_congr rfl
    intro w hw
    simp only [b, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
  have hPoint : ∀ v : FinitePlaneWaveMode count,
      ‖∑ w : FinitePlaneWaveMode count, a w * kernel v w‖ ≤
        ‖finiteCoulombOneParticleAction C count b v‖ := by
    intro v
    let S : ℝ := ∑ w : FinitePlaneWaveMode count,
      ‖a w‖ * Real.sqrt (finiteCoulombDifferenceSquareWeight C count v w)
    have hS : 0 ≤ S := by
      exact Finset.sum_nonneg (fun w hw => mul_nonneg (norm_nonneg _) (Real.sqrt_nonneg _))
    have hAction : finiteCoulombOneParticleAction C count b v = (S : ℂ) := by
      unfold finiteCoulombOneParticleAction finiteCoulombKernel
      dsimp [b, S]
      push_cast
      rfl
    rw [hAction, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hS]
    calc
      ‖∑ w : FinitePlaneWaveMode count, a w * kernel v w‖ ≤
          ∑ w : FinitePlaneWaveMode count, ‖a w * kernel v w‖ := norm_sum_le _ _
      _ ≤ S := by
        apply Finset.sum_le_sum
        intro w hw
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_left (hDom v w) (norm_nonneg _)
  calc
    (∑ v : FinitePlaneWaveMode count,
        ‖∑ w : FinitePlaneWaveMode count, a w * kernel v w‖ ^ 2) ≤
        finiteCoulombOneParticleOutputSq C count b := by
      unfold finiteCoulombOneParticleOutputSq
      apply Finset.sum_le_sum
      intro v hv
      exact sq_le_sq_of_nonneg (norm_nonneg _) (hPoint v)
    _ ≤ B ^ 2 * finiteOneParticleH1Sq (finitePlaneWaveKabs g count) b := hOne b
    _ = B ^ 2 * finiteOneParticleH1Sq (finitePlaneWaveKabs g count) a := by rw [hMass]

/-- Linearity with respect to the one-particle kernel. -/
lemma referenceKernelConvolutionOperator_add_kernel
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (r : Fin eta) (A D : μ → μ → ℂ) :
    referenceKernelConvolutionOperator r (fun v w => A v w + D v w) =
      referenceKernelConvolutionOperator r A + referenceKernelConvolutionOperator r D := by
  classical
  apply LinearMap.ext
  intro u
  ext q
  change (referenceKernelConvolutionOperator r (fun v w => A v w + D v w) u).ofLp q =
    (referenceKernelConvolutionOperator r A u).ofLp q +
      (referenceKernelConvolutionOperator r D u).ofLp q
  have hq := referenceSliceConfig_of_outerConfig_eq r (outerConfigOf r q) q rfl
  rw [← hq]
  simp only [referenceKernelConvolutionOperator_apply_referenceSlice,
    mul_add, Finset.sum_add_distrib]

/-!
## One-hundred-tenth milestone: assumption audit

The new wrapper no longer assumes hPotential, or a separate full-W H1 bound.
The form estimate follows from:
* the fully proved local cutoff Hardy inequality;
