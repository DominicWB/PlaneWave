      UN s (extractCLM n (W (u₀ - molecularH2Truncate n u₀))) := by
    rw [← hNcomm, hHN0, map_sub]
  -- the kinetic tail
  have hTl := kinetic_cubeLift_eq sys L H hKernel n y
  have h1 : ‖M (emb (UN s (extractCLM n (S v₀))))‖ ≤ (2 * sys.maxMass / lam ^ 2) * ΞN := by
    set χ := UN s (extractCLM n (S v₀))
    have hS : emb χ = S (cubeLift (2 * Real.pi / L) n χ) := (stateMap_cubeLift _ n χ).symm
    rw [hS]
    refine (tail_stateMap_le sys L hlam a _).trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
    refine (norm_tailMask_apply_le _ _ _ _).trans ?_
    have h := elliptic_cube sys L H hKernel Hunit hL hPeriodic hC n χ
    have hc1 : ‖HN χ‖ = ‖HN (extractCLM n (S v₀))‖ := by
      simp only [χ, HN]
      rw [← hNcomm, LinearIsometryEquiv.norm_map]
    have hc2 : ‖χ‖ = ‖extractCLM n (S v₀)‖ := LinearIsometryEquiv.norm_map _ _
    have hH := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n v₀
    have hT1 : ‖T v₀‖ ≤ Ξ₁ := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC v₀
    have hE : ‖extractCLM n (S v₀)‖ ≤ S1 := norm_extractCLM_le n (S v₀)
    have hbE : b * ‖extractCLM n (S v₀)‖ ≤ b * S1 := mul_le_mul_of_nonneg_left hE hb
    rw [hc1, hc2] at h
    simp only [ΞN]
    linarith
  have h2 : ‖M (emb (UN s (extractCLM n (W (u₀ - molecularH2Truncate n u₀)))))‖ ≤ N₀ := by
    refine (norm_tailMask_apply_le _ _ _ _).trans ?_
    rw [LinearIsometry.norm_map, LinearIsometryEquiv.norm_map]
    exact (norm_extractCLM_le n _).trans hN₀
  have hlnorm : ‖l‖ ≤ MN := by
    have h := cubeFlow_h2norm_le sys L H hKernel Hunit hL hPeriodic hC n UN hNcomm
      (extractCLM n (S u₀)) s
    refine h.trans (mul_le_mul_of_nonneg_left ?_ (by linarith))
    have hH := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n u₀
    have hT0 : ‖T u₀‖ ≤ Ξ₀ := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u₀
    have hE : ‖extractCLM n (S u₀)‖ ≤ S0 := norm_extractCLM_le n (S u₀)
    have hbE : b * ‖extractCLM n (S u₀)‖ ≤ b * S0 := mul_le_mul_of_nonneg_left hE hb
    linarith
  have hMN : 0 ≤ MN := (norm_nonneg _).trans hlnorm
  have h3 : ‖M (molecularH2Truncate n (W l))‖ ≤
