/-! ## Ninety-seventh milestone: finite regularized Hardy energy -/

/-- The regularized denominator is bounded below by `eps^2`. -/
lemma hardyRegularizedDenominator_ge_eps_sq
    (eps : ℝ)
    (x : CenteredCube3Ambient) :
    eps ^ 2 ≤ hardyRegularizedDenominator eps x := by
  unfold hardyRegularizedDenominator
  have hr := centeredCube3AmbientRadiusSq_nonneg x
  linarith

/-- For positive regularization parameter, the regularized Hardy weight is
pointwise nonnegative. -/
lemma hardyRegularizedWeight_nonneg
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    0 ≤ hardyRegularizedWeight eps x := by
  unfold hardyRegularizedWeight
  exact one_div_nonneg.mpr
    (le_of_lt (hardyRegularizedDenominator_pos heps x))

/-- The regularized Hardy weight is uniformly bounded by `1 / eps^2`. -/
lemma hardyRegularizedWeight_le_inv_eps_sq
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    hardyRegularizedWeight eps x ≤ 1 / eps ^ 2 := by
  unfold hardyRegularizedWeight
  have hepssq : 0 < eps ^ 2 := sq_pos_of_pos heps
  exact one_div_le_one_div_of_le hepssq
    (hardyRegularizedDenominator_ge_eps_sq eps x)

/-- The regularized Hardy weight is measurable on ambient `R^3`. -/
lemma hardyRegularizedWeight_aestronglyMeasurable
    (eps : ℝ) :
    MeasureTheory.AEStronglyMeasurable
      (hardyRegularizedWeight eps)
      MeasureTheory.volume := by
  apply Measurable.aestronglyMeasurable
  unfold hardyRegularizedWeight hardyRegularizedDenominator
  unfold centeredCube3AmbientRadiusSq
  measurability

/-- Multiplication by the regularized Hardy weight preserves integrability of
an already integrable squared norm.  This is the finite-`eps` energy estimate
used before the integration-by-parts identity. -/
lemma hardyRegularizedWeight_mul_sq_integrable
    {eps : ℝ}
    (heps : 0 < eps)
    (u : CenteredCube3Ambient → ℂ)
    (hu : MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient => ‖u x‖ ^ 2)
      MeasureTheory.volume) :
    MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedWeight eps x * ‖u x‖ ^ 2)
      MeasureTheory.volume := by
  have hMeas :
      MeasureTheory.AEStronglyMeasurable
        (fun x : CenteredCube3Ambient =>
          hardyRegularizedWeight eps x * ‖u x‖ ^ 2)
        MeasureTheory.volume :=
    (hardyRegularizedWeight_aestronglyMeasurable eps).mul
      hu.aestronglyMeasurable

  have hMajor :
      MeasureTheory.Integrable
        (fun x : CenteredCube3Ambient =>
          (1 / eps ^ 2) * ‖u x‖ ^ 2)
        MeasureTheory.volume :=
    hu.const_mul (1 / eps ^ 2)

  apply MeasureTheory.Integrable.mono' hMajor hMeas
  filter_upwards with x
  have hw0 := hardyRegularizedWeight_nonneg heps x
  have hwle := hardyRegularizedWeight_le_inv_eps_sq heps x
  rw [Real.norm_eq_abs]
  rw [abs_of_nonneg (mul_nonneg hw0 (sq_nonneg _))]
  exact mul_le_mul_of_nonneg_right hwle (sq_nonneg _)

/-- Hence the regularized Hardy energy of the zero-extended cutoff wave is
finite for every positive `eps`. -/
lemma centeredCube3RadialCutoffWaveZeroExtension_regularized_integrable
    {α : Type}
    [Fintype α]
    {rho R eps : ℝ}
    (heps : 0 < eps)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ) :
    MeasureTheory.Integrable
      (fun x : CenteredCube3Ambient =>
        hardyRegularizedWeight eps x *
          ‖centeredCube3RadialCutoffWaveZeroExtension
              rho R index f x‖ ^ 2)
      MeasureTheory.volume := by
  exact
    hardyRegularizedWeight_mul_sq_integrable
      heps
      (centeredCube3RadialCutoffWaveZeroExtension rho R index f)
      (centeredCube3RadialCutoffWaveZeroExtension_sq_integrable
        hRhoR index f)

/-!
## Ninety-seventh milestone

For every positive regularization parameter `eps`, the Hardy weight
`1 / (|x|^2 + eps^2)` is measurable, nonnegative, and bounded by `1 / eps^2`.
Consequently the zero-extended cutoff wave has finite regularized Hardy energy.
This supplies the integrability of the left-hand side of the regularized Hardy
argument independently of the remaining weak-derivative/integration-by-parts
issue at the two cutoff spheres.
-/

end

