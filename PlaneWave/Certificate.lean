-- BEGIN RELEASE SOURCE 146: finite Coulomb systems
section ReleaseMilestone146

/-!
# Milestone 146: finite Coulomb systems

The finite plane-wave Hamiltonian of a periodic Coulomb system with quantum particles of
masses at least one, arbitrary charges, and static nuclei:
`H = (1/2) Σ_a |k_a|²/m_a + Σ_{a<b} q_a q_b w(x_a - x_b) + Σ_a Σ_ℓ q_a Z_ℓ w(x_a - R_ℓ)`.
With electrons only it is the Born--Oppenheimer Hamiltonian of milestone 113.

The potential is bounded on the unweighted `H¹` space with a mass-free constant, which
gives a mass-free form constant in the variational argument. For the a priori `H²`
estimate each pair term is bounded on the `H¹` space of its lighter member, and the
attraction of a particle to the static nuclei on the `H¹` space of that particle, so that
only pairs of two heavy particles and the attraction of a heavy particle to the static
nuclei cost a mass factor.
-/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-! ## Weighted operator bounds -/

/-- The weighted squared norm `Σ_p w(p) |u_p|²`. -/
def weightedNormSq {eta : ℕ} {μ : Type*} [Fintype μ] (w : FourierConfig eta μ → ℝ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) : ℝ :=
  ∑ p, w p * ‖u.ofLp p‖ ^ 2

lemma weightedNormSq_nonneg {eta : ℕ} {μ : Type*} [Fintype μ] {w : FourierConfig eta μ → ℝ}
    (hw : ∀ p, 0 ≤ w p) (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    0 ≤ weightedNormSq w u :=
  Finset.sum_nonneg fun p _ => mul_nonneg (hw p) (sq_nonneg _)

/-- `‖A u‖² ≤ B² Σ_p w(p) |u_p|²` for every `u`. -/
def HasWeightedOperatorBound {eta : ℕ} {μ : Type*} [Fintype μ] (w : FourierConfig eta μ → ℝ)
    (A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (B : ℝ) : Prop :=
  ∀ u : EuclideanSpace ℂ (FourierConfig eta μ), ‖A u‖ ^ 2 ≤ B ^ 2 * weightedNormSq w u

/-- The `H¹` operator bound is the weighted bound with weight `1 + Σ_a |k_a|²`. -/
lemma hasH1OperatorBound_iff_weighted {eta : ℕ} {μ : Type*} [Fintype μ] (kabs : μ → ℝ)
    (A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (B : ℝ) :
    HasH1OperatorBound kabs A B ↔
      HasWeightedOperatorBound (fun p => 1 + boKineticSymbol kabs p) A B := Iff.rfl

lemma norm_le_of_weightedOperatorBound {eta : ℕ} {μ : Type*} [Fintype μ]
    {w : FourierConfig eta μ → ℝ} (hw : ∀ p, 0 ≤ w p)
    {A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ)}
    {B : ℝ} (hB : 0 ≤ B) (hA : HasWeightedOperatorBound w A B)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    ‖A u‖ ≤ B * Real.sqrt (weightedNormSq w u) := by
  have hBound := hA u
  have hRootSq := Real.sq_sqrt (weightedNormSq_nonneg hw u)
  have hRight : 0 ≤ B * Real.sqrt (weightedNormSq w u) := mul_nonneg hB (Real.sqrt_nonneg _)
  have hSquare : ‖A u‖ ^ 2 ≤ (B * Real.sqrt (weightedNormSq w u)) ^ 2 := by
    rw [mul_pow, hRootSq]
    exact hBound
  nlinarith only [hSquare, hRight, norm_nonneg (A u)]

lemma hasWeightedOperatorBound_smul {eta : ℕ} {μ : Type*} [Fintype μ]
    {w : FourierConfig eta μ → ℝ}
    {A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ)}
    {B : ℝ} (z : ℂ) (hA : HasWeightedOperatorBound w A B) :
    HasWeightedOperatorBound w (z • A) (‖z‖ * B) := by
  intro u
  change ‖z • A u‖ ^ 2 ≤ (‖z‖ * B) ^ 2 * weightedNormSq w u
  calc ‖z • A u‖ ^ 2 = ‖z‖ ^ 2 * ‖A u‖ ^ 2 := by rw [norm_smul, mul_pow]
    _ ≤ ‖z‖ ^ 2 * (B ^ 2 * weightedNormSq w u) :=
        mul_le_mul_of_nonneg_left (hA u) (sq_nonneg _)
    _ = (‖z‖ * B) ^ 2 * weightedNormSq w u := by ring

/-- A finite sum of bounded operators has the sum of the unsquared constants. -/
lemma hasWeightedOperatorBound_finset_sum {eta : ℕ} {μ ι : Type*} [Fintype μ]
    {w : FourierConfig eta μ → ℝ} (hw : ∀ p, 0 ≤ w p) (s : Finset ι)
    (A : ι → EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (B : ι → ℝ) (hB : ∀ i ∈ s, 0 ≤ B i)
    (hA : ∀ i ∈ s, HasWeightedOperatorBound w (A i) (B i)) :
    HasWeightedOperatorBound w (∑ i ∈ s, A i) (∑ i ∈ s, B i) := by
  classical
  intro u
  have hN : ‖(∑ i ∈ s, A i) u‖ ≤ (∑ i ∈ s, B i) * Real.sqrt (weightedNormSq w u) := by
    calc ‖(∑ i ∈ s, A i) u‖ = ‖∑ i ∈ s, A i u‖ := by rw [LinearMap.sum_apply]
      _ ≤ ∑ i ∈ s, ‖A i u‖ := norm_sum_le _ _
      _ ≤ ∑ i ∈ s, B i * Real.sqrt (weightedNormSq w u) :=
          Finset.sum_le_sum fun i hi => norm_le_of_weightedOperatorBound hw (hB i hi) (hA i hi) u
      _ = (∑ i ∈ s, B i) * Real.sqrt (weightedNormSq w u) := (Finset.sum_mul s B _).symm
  have hSq := pow_le_pow_left₀ (norm_nonneg _) hN 2
  rw [mul_pow, Real.sq_sqrt (weightedNormSq_nonneg hw u)] at hSq
  exact hSq

lemma hasWeightedOperatorBound_add {eta : ℕ} {μ : Type*} [Fintype μ]
    {w : FourierConfig eta μ → ℝ} (hw : ∀ p, 0 ≤ w p)
    {A D : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ)}
    {B C : ℝ} (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hA : HasWeightedOperatorBound w A B) (hD : HasWeightedOperatorBound w D C) :
    HasWeightedOperatorBound w (A + D) (B + C) := by
  intro u
  have hN : ‖(A + D) u‖ ≤ (B + C) * Real.sqrt (weightedNormSq w u) := by
    calc ‖(A + D) u‖ = ‖A u + D u‖ := rfl
      _ ≤ ‖A u‖ + ‖D u‖ := norm_add_le _ _
      _ ≤ B * Real.sqrt (weightedNormSq w u) + C * Real.sqrt (weightedNormSq w u) :=
          add_le_add (norm_le_of_weightedOperatorBound hw hB hA u)
            (norm_le_of_weightedOperatorBound hw hC hD u)
      _ = (B + C) * Real.sqrt (weightedNormSq w u) := by ring
  have hSq := pow_le_pow_left₀ (norm_nonneg _) hN 2
  rw [mul_pow, Real.sq_sqrt (weightedNormSq_nonneg hw u)] at hSq
  exact hSq

/-- A pointwise comparison of weights `w ≤ c w'` transfers a bound with the factor `√c`. -/
lemma hasWeightedOperatorBound_mono {eta : ℕ} {μ : Type*} [Fintype μ]
    {w w' : FourierConfig eta μ → ℝ} {c : ℝ} (hc : 0 ≤ c) (hw : ∀ p, w p ≤ c * w' p)
    {A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ)}
    {B : ℝ} (hA : HasWeightedOperatorBound w A B) :
    HasWeightedOperatorBound w' A (Real.sqrt c * B) := by
  intro u
  have h1 : weightedNormSq w u ≤ c * weightedNormSq w' u := by
    unfold weightedNormSq
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro p _
    calc w p * ‖u.ofLp p‖ ^ 2 ≤ c * w' p * ‖u.ofLp p‖ ^ 2 :=
          mul_le_mul_of_nonneg_right (hw p) (sq_nonneg _)
      _ = c * (w' p * ‖u.ofLp p‖ ^ 2) := by ring
  calc ‖A u‖ ^ 2 ≤ B ^ 2 * weightedNormSq w u := hA u
    _ ≤ B ^ 2 * (c * weightedNormSq w' u) := mul_le_mul_of_nonneg_left h1 (sq_nonneg B)
    _ = (Real.sqrt c * B) ^ 2 * weightedNormSq w' u := by
        rw [mul_pow, Real.sq_sqrt hc]
        ring

/-! ## Bounds on the `H¹` space of one register -/

/-- A one-particle `H¹` bound lifts to the reference operator with the `H¹` weight of the
reference register alone. -/
lemma referenceKernelConvolutionOperator_registerBound
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (r : Fin eta) (kabs : μ → ℝ) (kernel : μ → μ → ℂ) (B : ℝ)
    (hOne : ∀ a : μ → ℂ,
      (∑ v : μ, ‖∑ w : μ, a w * kernel v w‖ ^ 2) ≤
        B ^ 2 * finiteOneParticleH1Sq kabs a) :
    HasWeightedOperatorBound (fun p => 1 + kabs (p r) ^ 2)
      (referenceKernelConvolutionOperator r kernel) B := by
  classical
  intro u
  rw [EuclideanSpace.norm_sq_eq, sum_fourierConfig_eq_sum_referenceSlices r]
  simp_rw [referenceKernelConvolutionOperator_apply_referenceSlice]
  calc
    (∑ b : OuterConfig eta r μ,
        ∑ v : μ, ‖∑ w : μ, u.ofLp (referenceSliceConfig r b w) * kernel v w‖ ^ 2) ≤
        ∑ b : OuterConfig eta r μ,
          B ^ 2 * finiteOneParticleH1Sq kabs (fun w => u.ofLp (referenceSliceConfig r b w)) := by
      apply Finset.sum_le_sum
      intro b _
      exact hOne (fun w => u.ofLp (referenceSliceConfig r b w))
    _ = B ^ 2 * (∑ b : OuterConfig eta r μ, ∑ w : μ,
          (1 + (kabs w) ^ 2) * ‖u.ofLp (referenceSliceConfig r b w)‖ ^ 2) := by
      unfold finiteOneParticleH1Sq
      rw [Finset.mul_sum]
    _ = B ^ 2 * weightedNormSq (fun p => 1 + kabs (p r) ^ 2) u := by
      unfold weightedNormSq
      rw [sum_fourierConfig_eq_sum_referenceSlices r
        (fun p => (1 + kabs (p r) ^ 2) * ‖u.ofLp p‖ ^ 2)]
      simp only [referenceSliceConfig_ref]

/-- A nuclear term on register `i` is bounded on the `H¹` space of that register. -/
lemma finiteElectronNuclearTerm_registerBound
    {ν : Type*} {eta : ℕ} (i : Fin eta) (data : FiniteBONuclearData ν)
    (g gamma B : ℝ) (count : ℕ) (ell : ν)
    (hOne : HasOneParticleCoulombH1Bound g (gamma ^ 2) B count) :
    HasWeightedOperatorBound (fun p => 1 + finitePlaneWaveKabs g count (p i) ^ 2)
      (referenceKernelConvolutionOperator i (finiteElectronNuclearKernel data gamma count ell))
      (data.charge ell * B) := by
  have hTranslated : HasWeightedOperatorBound (fun p => 1 + finitePlaneWaveKabs g count (p i) ^ 2)
      (referenceKernelConvolutionOperator i
        (finiteTranslatedCoulombKernel (gamma ^ 2) count (data.position ell))) B := by
    apply referenceKernelConvolutionOperator_registerBound
    intro a
    exact coulomb_dominated_kernel_oneParticle_h1 g (gamma ^ 2) B count _
      (finiteTranslatedCoulombKernel_norm_le (gamma ^ 2) count (data.position ell)) hOne a
  unfold finiteElectronNuclearKernel
  rw [referenceKernelConvolutionOperator_smul_kernel]
  have h := hasWeightedOperatorBound_smul (-(data.charge ell : ℂ)) hTranslated
  simpa only [norm_neg, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (data.charge_nonneg ell)] using h

/-- A pair term is bounded on the `H¹` space of its first member. -/
lemma finiteElectronPairCoulombOperator_registerBound_first
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (g C B Hunit : ℝ) (count : ℕ) (hC : 0 ≤ C)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasWeightedOperatorBound (fun p => 1 + finitePlaneWaveKabs g count (p i) ^ 2)
      (finiteElectronPairCoulombOperator i j C count) B := by
  intro u
  exact finiteElectronPairCoulombOperator_norm_sq_le_first_h1 i j hij g C B Hunit count hC
    (finiteSupportUnitLatticeCoulombHardyBound_of_canonicalPeriodic Hunit hPeriodic) hScale u

/-- A pair term is bounded on the `H¹` space of its second member. -/
lemma finiteElectronPairCoulombOperator_registerBound_second
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j)
    (g C B Hunit : ℝ) (count : ℕ) (hC : 0 ≤ C)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasWeightedOperatorBound (fun p => 1 + finitePlaneWaveKabs g count (p j) ^ 2)
      (finiteElectronPairCoulombOperator i j C count) B := by
  rw [finiteElectronPairCoulombOperator_swap_particles]
  exact finiteElectronPairCoulombOperator_registerBound_first j i (Ne.symm hij)
    g C B Hunit count hC hPeriodic hScale

/-! ## The mass-weighted `H¹` space -/

/-- The weight `1 + Σ_a |k_a|²/m_a` of the mass-weighted `H¹` space. -/
lemma register_weight_le_mass_mul {eta : ℕ} {μ : Type*} {m : Fin eta → ℝ}
    (hm1 : ∀ a, 1 ≤ m a) (kabs : μ → ℝ) (r : Fin eta) (p : FourierConfig eta μ) :
    1 + kabs (p r) ^ 2 ≤ m r * (1 + massKineticSymbol m kabs p) := by
  have hm : ∀ a, 0 < m a := fun a => lt_of_lt_of_le one_pos (hm1 a)
  have h := component_sq_le_mass_mul_massKineticSymbol hm kabs p r
  have h1 := hm1 r
  nlinarith

/-- A bound on the `H¹` space of register `r` gives a bound on the mass-weighted `H¹`
space with the factor `√m_r`. -/
lemma registerBound_massBound {eta : ℕ} {μ : Type*} [Fintype μ] {m : Fin eta → ℝ}
    (hm1 : ∀ a, 1 ≤ m a) (kabs : μ → ℝ) (r : Fin eta)
    {A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ)}
    {B : ℝ} (hA : HasWeightedOperatorBound (fun p => 1 + kabs (p r) ^ 2) A B) :
    HasWeightedOperatorBound (fun p => 1 + massKineticSymbol m kabs p) A
      (Real.sqrt (m r) * B) :=
  hasWeightedOperatorBound_mono (le_trans zero_le_one (hm1 r))
    (register_weight_le_mass_mul hm1 kabs r) hA

/-- A pair term is bounded on the mass-weighted `H¹` space with the factor
`√(min m_i m_j)`: the derivative is placed on the lighter member. -/
lemma finiteElectronPairCoulombOperator_massBound
    {eta : ℕ} {m : Fin eta → ℝ} (hm1 : ∀ a, 1 ≤ m a) (i j : Fin eta) (hij : i ≠ j)
    (g C B Hunit : ℝ) (count : ℕ) (hC : 0 ≤ C)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : C * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasWeightedOperatorBound (fun p => 1 + massKineticSymbol m (finitePlaneWaveKabs g count) p)
      (finiteElectronPairCoulombOperator i j C count) (Real.sqrt (min (m i) (m j)) * B) := by
  rcases le_total (m i) (m j) with h | h
  · rw [min_eq_left h]
    exact registerBound_massBound hm1 _ i
      (finiteElectronPairCoulombOperator_registerBound_first i j hij g C B Hunit count hC
        hPeriodic hScale)
  · rw [min_eq_right h]
    exact registerBound_massBound hm1 _ j
      (finiteElectronPairCoulombOperator_registerBound_second i j hij g C B Hunit count hC
        hPeriodic hScale)

/-! ## Coupling weights of a Coulomb system -/

namespace CoulombSystem

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- `Σ_{a<b} |q_a q_b| + (Σ_a |q_a|) Z_tot`: the total charge weight of all pair and
nuclear terms. -/
def couplingWeight (sys : CoulombSystem eta ν) : ℝ :=
  (∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2|) +
    (∑ a, |sys.charge a|) * sys.nuclei.totalCharge

/-- The charge weight with each pair weighted by `√(min m_a m_b)` and each nuclear term
on particle `a` by `√m_a`. -/
def massCouplingWeight (sys : CoulombSystem eta ν) : ℝ :=
  (∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| *
      Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2))) +
    (∑ a, |sys.charge a| * Real.sqrt (sys.mass a)) * sys.nuclei.totalCharge

lemma couplingWeight_nonneg (sys : CoulombSystem eta ν) : 0 ≤ sys.couplingWeight := by
  unfold couplingWeight
  have h1 : 0 ≤ ∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| :=
    Finset.sum_nonneg fun _ _ => abs_nonneg _
  have h2 : 0 ≤ ∑ a, |sys.charge a| := Finset.sum_nonneg fun _ _ => abs_nonneg _
  exact add_nonneg h1 (mul_nonneg h2 sys.nuclei.totalCharge_nonneg)

lemma massCouplingWeight_nonneg (sys : CoulombSystem eta ν) : 0 ≤ sys.massCouplingWeight := by
  unfold massCouplingWeight
  have h1 : 0 ≤ ∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| *
      Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2)) :=
    Finset.sum_nonneg fun _ _ => mul_nonneg (abs_nonneg _) (Real.sqrt_nonneg _)
  have h2 : 0 ≤ ∑ a, |sys.charge a| * Real.sqrt (sys.mass a) :=
    Finset.sum_nonneg fun _ _ => mul_nonneg (abs_nonneg _) (Real.sqrt_nonneg _)
  exact add_nonneg h1 (mul_nonneg h2 sys.nuclei.totalCharge_nonneg)

/-- With all masses one the two weights agree. -/
lemma massCouplingWeight_bo (eta : ℕ) (data : FiniteBONuclearData ν) :
    (CoulombSystem.bo eta data).massCouplingWeight = (CoulombSystem.bo eta data).couplingWeight := by
  unfold massCouplingWeight couplingWeight
  simp

/-- The Born--Oppenheimer coupling weight: the number of pairs plus `η Z_tot`. -/
lemma couplingWeight_bo (eta : ℕ) (data : FiniteBONuclearData ν) :
    (CoulombSystem.bo eta data).couplingWeight =
      (Fintype.card (FiniteElectronPair eta) : ℝ) + (eta : ℝ) * data.totalCharge := by
  unfold couplingWeight
  simp

end CoulombSystem

/-! ## The finite Hamiltonian of a Coulomb system -/

section FinitePotential

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- All pair interactions `Σ_{a<b} q_a q_b w(x_a - x_b)`, each unordered pair once. -/
def finiteCoulombPairPotential (sys : CoulombSystem eta ν) (gamma : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  ∑ pair : FiniteElectronPair eta,
    ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) •
      finiteElectronPairCoulombOperator pair.1.1 pair.1.2 (gamma ^ 2) count

/-- All interactions with the static nuclei, `Σ_a Σ_ℓ q_a Z_ℓ w(x_a - R_ℓ)`. The nuclear
kernel carries the factor `-Z_ℓ`, so the particle factor is `-q_a`. -/
def finiteCoulombNuclearPotential (sys : CoulombSystem eta ν) (gamma : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  ∑ a : Fin eta, ((-sys.charge a : ℝ) : ℂ) •
    ∑ ell : ν, referenceKernelConvolutionOperator a
      (finiteElectronNuclearKernel sys.nuclei gamma count ell)

/-- The full finite Coulomb potential. -/
def finiteCoulombPotential (sys : CoulombSystem eta ν) (gamma : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  finiteCoulombNuclearPotential sys gamma count + finiteCoulombPairPotential sys gamma count

/-- The finite Hamiltonian `(1/2) Σ_a |k_a|²/m_a + W` in a cube of side `L`. -/
def finiteCoulombHamiltonian (sys : CoulombSystem eta ν) (L : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  diagHamiltonian (massKineticSymbol sys.mass (finitePlaneWaveKabs (2 * Real.pi / L) count))
    (finiteCoulombPotential sys (coulombCellAmplitude L) count)

omit [Fintype ν] in
lemma finiteCoulombPairPotential_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (gamma : ℝ) (count : ℕ) :
    finiteCoulombPairPotential (CoulombSystem.bo eta data) gamma count =
      finiteElectronElectronPotential eta gamma count := by
  unfold finiteCoulombPairPotential finiteElectronElectronPotential
  simp

lemma finiteCoulombNuclearPotential_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (gamma : ℝ) (count : ℕ) :
    finiteCoulombNuclearPotential (CoulombSystem.bo eta data) gamma count =
      finiteElectronNuclearPotential eta data gamma count := by
  unfold finiteCoulombNuclearPotential finiteElectronNuclearPotential
  simp

/-- With electrons only the potential is the Born--Oppenheimer potential. -/
lemma finiteCoulombPotential_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (gamma : ℝ) (count : ℕ) :
    finiteCoulombPotential (CoulombSystem.bo eta data) gamma count =
      finiteMolecularCoulombPotential eta data gamma count := by
  unfold finiteCoulombPotential finiteMolecularCoulombPotential
  rw [finiteCoulombPairPotential_bo, finiteCoulombNuclearPotential_bo]

/-- With electrons only the Hamiltonian is the Born--Oppenheimer Hamiltonian. -/
lemma finiteCoulombHamiltonian_bo (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (count : ℕ) :
    finiteCoulombHamiltonian (CoulombSystem.bo eta data) L count =
      finiteMolecularBOHamiltonian eta L data count := by
  unfold finiteCoulombHamiltonian
  rw [finiteCoulombPotential_bo]
  change diagHamiltonian (massKineticSymbol (fun _ => (1 : ℝ))
      (finitePlaneWaveKabs (2 * Real.pi / L) count)) _ =
    diagHamiltonian (boKineticSymbol (finitePlaneWaveKabs (2 * Real.pi / L) count)) _
  rw [massKineticSymbol_one]

lemma real_smul_isSymmetric {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (x : ℝ) {T : E →ₗ[ℂ] E} (hT : T.IsSymmetric) : ((x : ℂ) • T).IsSymmetric :=
  hT.smul (Complex.conj_ofReal x)

lemma finiteCoulombPotential_isSymmetric (sys : CoulombSystem eta ν) (gamma : ℝ)
    (count : ℕ) : (finiteCoulombPotential sys gamma count).IsSymmetric := by
  unfold finiteCoulombPotential finiteCoulombNuclearPotential finiteCoulombPairPotential
  apply LinearMap.IsSymmetric.add
  · apply LinearMap.isSymmetric_sum
    intro a _
    apply real_smul_isSymmetric
    apply LinearMap.isSymmetric_sum
    intro ell _
    exact referenceKernelConvolutionOperator_isSymmetric_of_conj a _
      (finiteElectronNuclearKernel_conj_swap sys.nuclei gamma count ell)
  · apply LinearMap.isSymmetric_sum
    intro pair _
    exact real_smul_isSymmetric _
      (finiteElectronPairCoulombOperator_isSymmetric pair.1.1 pair.1.2 (gamma ^ 2) count)

lemma finiteCoulombHamiltonian_isSymmetric (sys : CoulombSystem eta ν) (L : ℝ) (count : ℕ) :
    (finiteCoulombHamiltonian sys L count).IsSymmetric :=
  diagHamiltonian_isSymmetric _ _ (finiteCoulombPotential_isSymmetric sys _ count)

/-! ### `H¹` bounds -/

lemma norm_ofReal_neg (x : ℝ) : ‖((-x : ℝ) : ℂ)‖ = |x| := by
  rw [Complex.norm_real, Real.norm_eq_abs, abs_neg]

lemma norm_ofReal' (x : ℝ) : ‖((x : ℝ) : ℂ)‖ = |x| := by
  rw [Complex.norm_real, Real.norm_eq_abs]

/-- The nuclear terms of all particles, bounded on any weighted space on which each
single nuclear term on register `a` has the bound `Z_ℓ B_a`. -/
lemma finiteCoulombNuclearPotential_weightedBound (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) (w : FourierConfig eta (FinitePlaneWaveMode count) → ℝ)
    (hw : ∀ p, 0 ≤ w p) (Bpart : Fin eta → ℝ) (hB : ∀ a, 0 ≤ Bpart a)
    (hTerm : ∀ (a : Fin eta) (ell : ν), HasWeightedOperatorBound w
      (referenceKernelConvolutionOperator a (finiteElectronNuclearKernel sys.nuclei gamma count ell))
      (sys.nuclei.charge ell * Bpart a)) :
    HasWeightedOperatorBound w (finiteCoulombNuclearPotential sys gamma count)
      ((∑ a, |sys.charge a| * Bpart a) * sys.nuclei.totalCharge) := by
  classical
  have hInner : ∀ a : Fin eta, HasWeightedOperatorBound w
      (∑ ell : ν, referenceKernelConvolutionOperator a
        (finiteElectronNuclearKernel sys.nuclei gamma count ell))
      (∑ ell : ν, sys.nuclei.charge ell * Bpart a) := fun a =>
    hasWeightedOperatorBound_finset_sum hw Finset.univ _ _
      (fun ell _ => mul_nonneg (sys.nuclei.charge_nonneg ell) (hB a))
      (fun ell _ => hTerm a ell)
  have hScaled : ∀ a : Fin eta, HasWeightedOperatorBound w
      (((-sys.charge a : ℝ) : ℂ) • ∑ ell : ν, referenceKernelConvolutionOperator a
        (finiteElectronNuclearKernel sys.nuclei gamma count ell))
      (|sys.charge a| * (∑ ell : ν, sys.nuclei.charge ell * Bpart a)) := by
    intro a
    have h := hasWeightedOperatorBound_smul ((-sys.charge a : ℝ) : ℂ) (hInner a)
    rwa [norm_ofReal_neg] at h
  have hTotal := hasWeightedOperatorBound_finset_sum hw Finset.univ _ _
    (fun a _ => mul_nonneg (abs_nonneg _)
      (Finset.sum_nonneg fun ell _ => mul_nonneg (sys.nuclei.charge_nonneg ell) (hB a)))
    (fun a _ => hScaled a)
  have hConst : (∑ a : Fin eta, |sys.charge a| * ∑ ell : ν, sys.nuclei.charge ell * Bpart a) =
      (∑ a, |sys.charge a| * Bpart a) * sys.nuclei.totalCharge := by
    unfold FiniteBONuclearData.totalCharge
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro a _
    rw [← Finset.sum_mul, mul_assoc, mul_comm (∑ ell : ν, sys.nuclei.charge ell)]
  rw [hConst] at hTotal
  exact hTotal

omit [Fintype ν] in
/-- The pair terms, bounded on any weighted space on which each pair term has the bound
`B_pair`. -/
lemma finiteCoulombPairPotential_weightedBound (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) (w : FourierConfig eta (FinitePlaneWaveMode count) → ℝ)
    (hw : ∀ p, 0 ≤ w p) (Bpair : FiniteElectronPair eta → ℝ) (hB : ∀ pair, 0 ≤ Bpair pair)
    (hTerm : ∀ pair : FiniteElectronPair eta, HasWeightedOperatorBound w
      (finiteElectronPairCoulombOperator pair.1.1 pair.1.2 (gamma ^ 2) count) (Bpair pair)) :
    HasWeightedOperatorBound w (finiteCoulombPairPotential sys gamma count)
      (∑ pair : FiniteElectronPair eta,
        |sys.charge pair.1.1 * sys.charge pair.1.2| * Bpair pair) := by
  classical
  have hScaled : ∀ pair : FiniteElectronPair eta, HasWeightedOperatorBound w
      (((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) •
        finiteElectronPairCoulombOperator pair.1.1 pair.1.2 (gamma ^ 2) count)
      (|sys.charge pair.1.1 * sys.charge pair.1.2| * Bpair pair) := by
    intro pair
    have h := hasWeightedOperatorBound_smul
      ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) (hTerm pair)
    rwa [norm_ofReal'] at h
  exact hasWeightedOperatorBound_finset_sum hw Finset.univ _ _
    (fun pair _ => mul_nonneg (abs_nonneg _) (hB pair)) (fun pair _ => hScaled pair)

/-- The unweighted `H¹` bound of the full potential, with the mass-free constant
`couplingWeight * B`. -/
lemma finiteCoulombPotential_h1Bound_of_periodic (sys : CoulombSystem eta ν)
    (g gamma B Hunit : ℝ) (count : ℕ) (hB : 0 ≤ B)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : gamma ^ 2 * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasH1OperatorBound (finitePlaneWaveKabs g count) (finiteCoulombPotential sys gamma count)
      (sys.couplingWeight * B) := by
  classical
  rw [hasH1OperatorBound_iff_weighted]
  have hw : ∀ p : FourierConfig eta (FinitePlaneWaveMode count),
      0 ≤ 1 + boKineticSymbol (finitePlaneWaveKabs g count) p :=
    fun p => by linarith [boKineticSymbol_nonneg (finitePlaneWaveKabs g count) p]
  have hOne := oneParticleCoulombH1Bound_of_canonicalPeriodic
    g (gamma ^ 2) B Hunit count (sq_nonneg gamma) hPeriodic hScale
  have hNuclear := finiteCoulombNuclearPotential_weightedBound sys gamma count _ hw
    (fun _ => B) (fun _ => hB)
    (fun a ell => (hasH1OperatorBound_iff_weighted _ _ _).mp
      (finiteElectronNuclearTerm_h1Bound a sys.nuclei g gamma B count ell hOne))
  have hPair := finiteCoulombPairPotential_weightedBound sys gamma count _ hw
    (fun _ => B) (fun _ => hB)
    (fun pair => (hasH1OperatorBound_iff_weighted _ _ _).mp
      (finiteElectronPairCoulombOperator_h1Bound_of_periodic pair.1.1 pair.1.2
        (ne_of_lt pair.2) g (gamma ^ 2) B Hunit count (sq_nonneg gamma) hPeriodic hScale))
  have hN0 : 0 ≤ (∑ a, |sys.charge a| * B) * sys.nuclei.totalCharge :=
    mul_nonneg (Finset.sum_nonneg fun _ _ => mul_nonneg (abs_nonneg _) hB)
      sys.nuclei.totalCharge_nonneg
  have hP0 : 0 ≤ ∑ pair : FiniteElectronPair eta,
      |sys.charge pair.1.1 * sys.charge pair.1.2| * B :=
    Finset.sum_nonneg fun _ _ => mul_nonneg (abs_nonneg _) hB
  have hSum := hasWeightedOperatorBound_add hw hN0 hP0 hNuclear hPair
  have hConst : (∑ a, |sys.charge a| * B) * sys.nuclei.totalCharge +
      (∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| * B) =
      sys.couplingWeight * B := by
    unfold CoulombSystem.couplingWeight
    rw [← Finset.sum_mul, ← Finset.sum_mul]
    ring
  rw [hConst] at hSum
  exact hSum

/-- The mass-weighted `H¹` bound of the full potential, with each pair bounded through
its lighter member. -/
lemma finiteCoulombPotential_massBound_of_periodic (sys : CoulombSystem eta ν)
    (g gamma B Hunit : ℝ) (count : ℕ) (hB : 0 ≤ B)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : gamma ^ 2 * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g) :
    HasWeightedOperatorBound
      (fun p => 1 + massKineticSymbol sys.mass (finitePlaneWaveKabs g count) p)
      (finiteCoulombPotential sys gamma count) (sys.massCouplingWeight * B) := by
  classical
  have hmpos : ∀ a, 0 < sys.mass a := fun a => sys.mass_pos a
  have hw : ∀ p : FourierConfig eta (FinitePlaneWaveMode count),
      0 ≤ 1 + massKineticSymbol sys.mass (finitePlaneWaveKabs g count) p :=
    fun p => by linarith [massKineticSymbol_nonneg hmpos (finitePlaneWaveKabs g count) p]
  have hOne := oneParticleCoulombH1Bound_of_canonicalPeriodic
    g (gamma ^ 2) B Hunit count (sq_nonneg gamma) hPeriodic hScale
  have hNuclear := finiteCoulombNuclearPotential_weightedBound sys gamma count _ hw
    (fun a => Real.sqrt (sys.mass a) * B) (fun a => mul_nonneg (Real.sqrt_nonneg _) hB)
    (fun a ell => by
      have h := registerBound_massBound sys.one_le_mass (finitePlaneWaveKabs g count) a
        (finiteElectronNuclearTerm_registerBound a sys.nuclei g gamma B count ell hOne)
      have heq : Real.sqrt (sys.mass a) * (sys.nuclei.charge ell * B) =
          sys.nuclei.charge ell * (Real.sqrt (sys.mass a) * B) := by ring
      rwa [heq] at h)
  have hPair := finiteCoulombPairPotential_weightedBound sys gamma count _ hw
    (fun pair => Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2)) * B)
    (fun _ => mul_nonneg (Real.sqrt_nonneg _) hB)
    (fun pair => finiteElectronPairCoulombOperator_massBound sys.one_le_mass pair.1.1 pair.1.2
      (ne_of_lt pair.2) g (gamma ^ 2) B Hunit count (sq_nonneg gamma) hPeriodic hScale)
  have hN0 : 0 ≤ (∑ a, |sys.charge a| * (Real.sqrt (sys.mass a) * B)) *
      sys.nuclei.totalCharge :=
    mul_nonneg (Finset.sum_nonneg fun _ _ =>
      mul_nonneg (abs_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) hB))
      sys.nuclei.totalCharge_nonneg
  have hP0 : 0 ≤ ∑ pair : FiniteElectronPair eta,
      |sys.charge pair.1.1 * sys.charge pair.1.2| *
        (Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2)) * B) :=
    Finset.sum_nonneg fun _ _ => mul_nonneg (abs_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) hB)
  have hSum := hasWeightedOperatorBound_add hw hN0 hP0 hNuclear hPair
  have hConst : (∑ a, |sys.charge a| * (Real.sqrt (sys.mass a) * B)) * sys.nuclei.totalCharge +
      (∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| *
        (Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2)) * B)) =
      sys.massCouplingWeight * B := by
    unfold CoulombSystem.massCouplingWeight
    have h1 : (∑ a, |sys.charge a| * (Real.sqrt (sys.mass a) * B)) =
        (∑ a, |sys.charge a| * Real.sqrt (sys.mass a)) * B := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun a _ => by ring
    have h2 : (∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| *
        (Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2)) * B)) =
        (∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2| *
          Real.sqrt (min (sys.mass pair.1.1) (sys.mass pair.1.2))) * B := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun pair _ => by ring
    rw [h1, h2]
    ring
  rw [hConst] at hSum
  exact hSum

/-! ### Physical constants -/

/-- The canonical periodic Hardy estimate, with the explicit universal constant. -/
lemma canonicalPeriodicCoulombHardyBound_explicit :
    HasCanonicalPeriodicCoulombHardyBound molecularCanonicalUnitHardyConstant := by
  obtain ⟨hRcut, hRcutRouter, hHalf, _hLocal, _hUnit, hCutoffScale, hPeriodicScale⟩ :=
    molecularCanonicalHardyConstants_spec
  exact canonicalPeriodicCoulombHardyBound_of_remainder_bound hRcut hRcutRouter hHalf
    canonicalUnitTorus3CoulombRemainderExplicitBound_nonneg
    canonicalUnitTorus3CoulombRemainder_bound_explicit hCutoffScale hPeriodicScale

/-- The one-particle Coulomb constant of a cube of side `L`. -/
def coulombPhysicalCellConstant (L Hunit : ℝ) : ℝ :=
  coulombPhysicalH1Constant (2 * Real.pi / L) ((coulombCellAmplitude L) ^ 2) Hunit

lemma coulombPhysicalCellConstant_nonneg (L Hunit : ℝ) :
    0 ≤ coulombPhysicalCellConstant L Hunit :=
  coulombPhysicalH1Constant_nonneg _ _ _

lemma coulombPhysicalCellConstant_scale (L Hunit : ℝ) (hL : 0 < L) :
    (coulombCellAmplitude L) ^ 2 * Hunit ^ 2 ≤
      (coulombPhysicalCellConstant L Hunit) ^ 2 * physicalH1Scale (2 * Real.pi / L) := by
  have hg : 0 < 2 * Real.pi / L := div_pos (mul_pos (by norm_num) Real.pi_pos) hL
  exact le_of_eq (coulombPhysicalH1Constant_sq_mul_scale Hunit hg
    (sq_nonneg (coulombCellAmplitude L))).symm

/-- The mass-free form constant of a Coulomb system in a cube of side `L`. -/
def finiteCoulombPhysicalFormConstant (sys : CoulombSystem eta ν) (L Hunit : ℝ) : ℝ :=
  sys.couplingWeight * coulombPhysicalCellConstant L Hunit

/-- The mass-weighted `H¹` constant of a Coulomb system in a cube of side `L`. -/
def finiteCoulombPhysicalMassConstant (sys : CoulombSystem eta ν) (L Hunit : ℝ) : ℝ :=
  sys.massCouplingWeight * coulombPhysicalCellConstant L Hunit

lemma finiteCoulombPhysicalFormConstant_nonneg (sys : CoulombSystem eta ν) (L Hunit : ℝ) :
    0 ≤ finiteCoulombPhysicalFormConstant sys L Hunit :=
  mul_nonneg sys.couplingWeight_nonneg (coulombPhysicalCellConstant_nonneg L Hunit)

lemma finiteCoulombPhysicalMassConstant_nonneg (sys : CoulombSystem eta ν) (L Hunit : ℝ) :
    0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit :=
  mul_nonneg sys.massCouplingWeight_nonneg (coulombPhysicalCellConstant_nonneg L Hunit)

lemma finiteCoulombPhysicalFormConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (L Hunit : ℝ) :
    finiteCoulombPhysicalFormConstant (CoulombSystem.bo eta data) L Hunit =
      finiteMolecularCoulombPhysicalFormConstant eta data L Hunit := by
  unfold finiteCoulombPhysicalFormConstant finiteMolecularCoulombPhysicalFormConstant
    finiteMolecularCoulombH1Constant coulombPhysicalCellConstant
  rw [CoulombSystem.couplingWeight_bo]
  ring

lemma finiteCoulombPhysicalMassConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (L Hunit : ℝ) :
    finiteCoulombPhysicalMassConstant (CoulombSystem.bo eta data) L Hunit =
      finiteCoulombPhysicalFormConstant (CoulombSystem.bo eta data) L Hunit := by
  unfold finiteCoulombPhysicalMassConstant finiteCoulombPhysicalFormConstant
  rw [CoulombSystem.massCouplingWeight_bo]

lemma finiteCoulombPotential_physical_h1Bound (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (count : ℕ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    HasH1OperatorBound (finitePlaneWaveKabs (2 * Real.pi / L) count)
      (finiteCoulombPotential sys (coulombCellAmplitude L) count)
      (finiteCoulombPhysicalFormConstant sys L Hunit) :=
  finiteCoulombPotential_h1Bound_of_periodic sys _ _ _ Hunit count
    (coulombPhysicalCellConstant_nonneg L Hunit) hPeriodic
    (coulombPhysicalCellConstant_scale L Hunit hL)

lemma finiteCoulombPotential_physical_massBound (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (count : ℕ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    HasWeightedOperatorBound
      (fun p => 1 + massKineticSymbol sys.mass (finitePlaneWaveKabs (2 * Real.pi / L) count) p)
      (finiteCoulombPotential sys (coulombCellAmplitude L) count)
      (finiteCoulombPhysicalMassConstant sys L Hunit) :=
  finiteCoulombPotential_massBound_of_periodic sys _ _ _ Hunit count
    (coulombPhysicalCellConstant_nonneg L Hunit) hPeriodic
    (coulombPhysicalCellConstant_scale L Hunit hL)

end FinitePotential

/-! ## A priori `H²` regularity with masses -/

/-- A weighted Young inequality absorbing the potential into half the squared kinetic
norm, for any real symbol `A`. -/
lemma weighted_eigen_absorption {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (B : ℝ) (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    8 * B ^ 2 * weightedNormSq (fun p => 1 + A p) u ≤
      (8 * B ^ 2 + 32 * B ^ 4) * ‖u‖ ^ 2 + (1 / 2 : ℝ) * ‖diagMul A u‖ ^ 2 := by
  classical
  have hsum :
      (∑ p : FourierConfig eta μ, 8 * B ^ 2 * ((1 + A p) * ‖u.ofLp p‖ ^ 2)) ≤
      ∑ p : FourierConfig eta μ,
        ((8 * B ^ 2 + 32 * B ^ 4) * ‖u.ofLp p‖ ^ 2 +
          (1 / 2 : ℝ) * ((A p) ^ 2 * ‖u.ofLp p‖ ^ 2)) := by
    apply Finset.sum_le_sum
    intro p _
    have hWeight :
        8 * B ^ 2 * (1 + A p) ≤ 8 * B ^ 2 + 32 * B ^ 4 + (1 / 2 : ℝ) * (A p) ^ 2 := by
      nlinarith only [sq_nonneg (A p - 8 * B ^ 2)]
    have h := mul_le_mul_of_nonneg_right hWeight (sq_nonneg ‖u.ofLp p‖)
    nlinarith only [h]
  unfold weightedNormSq
  rw [EuclideanSpace.norm_sq_eq, diagMul_norm_sq]
  simpa only [Finset.mul_sum, Finset.sum_add_distrib] using hsum

/-- The `H²` functional of a symbol `A` is bounded by the graph norm. -/
lemma diag_h2_le_two_norm_sq_add_kinetic_sq {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (coeff : FourierConfig eta μ → ℂ) :
    (∑ p, (1 + A p) ^ 2 * coeffMass coeff p) ≤ 2 * ‖fullCoeffVector coeff‖ ^ 2 +
      2 * ‖diagMul A (fullCoeffVector coeff)‖ ^ 2 := by
  classical
  rw [EuclideanSpace.norm_sq_eq, diagMul_norm_sq]
  unfold coeffMass
  simp only [fullCoeffVector_apply, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro p _
  have hWeight : (1 + A p) ^ 2 ≤ 2 + 2 * (A p) ^ 2 := by
    nlinarith only [sq_nonneg (A p - 1)]
  have h := mul_le_mul_of_nonneg_right hWeight (sq_nonneg ‖coeff p‖)
  nlinarith only [h]

/-- A normalized eigenvector of `(1/2) A + W`, with `W` bounded on the `H¹` space of the
symbol `A`, satisfies `Σ_p (1 + A(p))² |c_p|² ≤ (2 + 8 E₀ + 16 B²)²`. -/
lemma diag_eigen_h2_le_uniform {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (E E0 B : ℝ) (hE0 : 0 ≤ E0) (hEnergy : |E| ≤ E0)
    (hBound : HasWeightedOperatorBound (fun p => 1 + A p) W B)
    (hNormalized : (∑ p, coeffMass coeff p) = 1)
    (hEigen : diagHamiltonian A W (fullCoeffVector coeff) = (E : ℂ) • fullCoeffVector coeff) :
    (∑ p, (1 + A p) ^ 2 * coeffMass coeff p) ≤ (uniformBOEigenH2Constant E0 B) ^ 2 := by
  classical
  let u := fullCoeffVector coeff
  have huSq : ‖u‖ ^ 2 = 1 := by
    rw [EuclideanSpace.norm_sq_eq]
    simpa [u, coeffMass] using hNormalized
  have hu : ‖u‖ = 1 := by
    nlinarith only [huSq, norm_nonneg u]
  have hEigCoord := diag_fourier_eigen_equation A coeff W E hEigen
  have hVec : diagMul A u = (2 : ℂ) • ((E : ℂ) • u - W u) := by
    apply diagMul_eq_two_eigen_rhs
    intro p
    simpa [u, operatorPotentialCoeff] using hEigCoord p
  have hNorm : ‖diagMul A u‖ = 2 * ‖(E : ℂ) • u - W u‖ := by
    rw [hVec, norm_smul]
    norm_num
  have hRhs := eigen_rhs_norm_le u (W u) hEnergy
  rw [hu, mul_one] at hRhs
  have hNormBound : ‖diagMul A u‖ ≤ 2 * (E0 + ‖W u‖) := by
    nlinarith only [hNorm, hRhs]
  have hNormSq := pow_le_pow_left₀ (norm_nonneg (diagMul A u)) hNormBound 2
  have hKinetic : ‖diagMul A u‖ ^ 2 ≤ 8 * E0 ^ 2 + 8 * ‖W u‖ ^ 2 := by
    nlinarith only [hNormSq, sq_nonneg (E0 - ‖W u‖)]
  have hW := hBound u
  have hAbsorb := weighted_eigen_absorption A B u
  rw [huSq, mul_one] at hAbsorb
  have hKineticBound : ‖diagMul A u‖ ^ 2 ≤ 16 * E0 ^ 2 + 16 * B ^ 2 + 64 * B ^ 4 := by
    nlinarith only [hKinetic, hW, hAbsorb]
  have hH2 := diag_h2_le_two_norm_sq_add_kinetic_sq A coeff
  change (∑ p, (1 + A p) ^ 2 * coeffMass coeff p) ≤
    2 * ‖u‖ ^ 2 + 2 * ‖diagMul A u‖ ^ 2 at hH2
  rw [huSq, mul_one] at hH2
  unfold uniformBOEigenH2Constant
  nlinarith only [hH2, hKineticBound, hE0, sq_nonneg E0, sq_nonneg B,
    sq_nonneg (B ^ 2), mul_nonneg hE0 (sq_nonneg B)]

/-- The mass-weighted `H²` functional `Θ² = Σ_p (1 + A_m(p))² |c_p|²`. -/
def massH2Sq {eta : ℕ} {μ : Type*} [Fintype μ] (m : Fin eta → ℝ) (kabs : μ → ℝ)
    (coeff : FourierConfig eta μ → ℂ) : ℝ :=
  ∑ p, (1 + massKineticSymbol m kabs p) ^ 2 * coeffMass coeff p

/-- The Sobolev `H²` functional is at most `m̄²` times the mass-weighted one. -/
lemma fullH2Sq_le_mass_sq_mul_massH2Sq {eta : ℕ} {μ : Type*} [Fintype μ]
    {m : Fin eta → ℝ} {M : ℝ} (hm1 : ∀ a, 1 ≤ m a) (hM : ∀ a, m a ≤ M) (hM1 : 1 ≤ M)
    (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ) :
    fullH2Sq kabs coeff ≤ M ^ 2 * massH2Sq m kabs coeff := by
  have hm : ∀ a, 0 < m a := fun a => lt_of_lt_of_le one_pos (hm1 a)
  unfold fullH2Sq massH2Sq
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro p _
  have hS := boKineticSymbol_le_mul_massKineticSymbol hm hM kabs p
  have hA0 := massKineticSymbol_nonneg hm kabs p
  have hS0 := boKineticSymbol_nonneg kabs p
  have h1 : 1 + boKineticSymbol kabs p ≤ M * (1 + massKineticSymbol m kabs p) := by nlinarith
  have h0 : 0 ≤ 1 + boKineticSymbol kabs p := by linarith
  have h2 := pow_le_pow_left₀ h0 h1 2
  have hmass : 0 ≤ coeffMass coeff p := by unfold coeffMass; positivity
  calc (1 + boKineticSymbol kabs p) ^ 2 * coeffMass coeff p
      ≤ (M * (1 + massKineticSymbol m kabs p)) ^ 2 * coeffMass coeff p :=
        mul_le_mul_of_nonneg_right h2 hmass
    _ = M ^ 2 * ((1 + massKineticSymbol m kabs p) ^ 2 * coeffMass coeff p) := by ring

lemma CoulombParticles.maxMass_electrons (eta : ℕ) :
    (CoulombParticles.electrons eta).maxMass = 1 := by
  apply le_antisymm
  · unfold CoulombParticles.maxMass
    rw [Finset.fold_max_le]
    exact ⟨le_rfl, fun _ _ => le_rfl⟩
  · exact (CoulombParticles.electrons eta).one_le_maxMass

lemma CoulombSystem.maxMass_bo {ν : Type*} (eta : ℕ) (data : FiniteBONuclearData ν) :
    (CoulombSystem.bo eta data).maxMass = 1 :=
  CoulombParticles.maxMass_electrons eta

lemma CoulombParticles.massMoment_one {eta : ℕ} (P : CoulombParticles eta) :
    P.massMoment 1 = ∑ a, P.mass a := by
  simp [CoulombParticles.massMoment]

lemma CoulombSystem.massMoment_bo {ν : Type*} (eta : ℕ) (data : FiniteBONuclearData ν)
    (r : ℕ) : (CoulombSystem.bo eta data).massMoment r = eta := by
  change (CoulombParticles.electrons eta).massMoment r = eta
  simp [CoulombParticles.massMoment, CoulombParticles.electrons]

section FiniteRegularity

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- The uniform `H²` constant of normalized finite eigenvectors with `|E| ≤ E₀`:
`m̄ (2 + 8 E₀ + 16 B_m²)`, with `B_m` the mass-weighted `H¹` constant. -/
def finiteCoulombH2Constant (sys : CoulombSystem eta ν) (E0 L Hunit : ℝ) : ℝ :=
  sys.maxMass * uniformBOEigenH2Constant E0 (finiteCoulombPhysicalMassConstant sys L Hunit)

lemma finiteCoulombH2Constant_nonneg (sys : CoulombSystem eta ν) {E0 : ℝ} (hE0 : 0 ≤ E0)
    (L Hunit : ℝ) : 0 ≤ finiteCoulombH2Constant sys E0 L Hunit :=
  mul_nonneg (le_trans zero_le_one sys.one_le_maxMass) (uniformBOEigenH2Constant_nonneg hE0)

lemma finiteCoulombH2Constant_bo (eta : ℕ) (data : FiniteBONuclearData ν) (E0 L Hunit : ℝ) :
    finiteCoulombH2Constant (CoulombSystem.bo eta data) E0 L Hunit =
      uniformBOEigenH2Constant E0 (finiteMolecularCoulombPhysicalFormConstant eta data L Hunit) := by
  unfold finiteCoulombH2Constant
  rw [CoulombSystem.maxMass_bo, finiteCoulombPhysicalMassConstant_bo,
    finiteCoulombPhysicalFormConstant_bo, one_mul]

/-- The mass-weighted `H²` bound `Θ ≤ 2 + 8 E₀ + 16 B_m²` of a normalized finite
eigenvector (the manuscript's eq. `nbo-H2`). -/
theorem finiteCoulomb_eigen_massH2Sq_le_uniform (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (count : ℕ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (E E0 : ℝ) (hE0 : 0 ≤ E0) (hEnergy : |E| ≤ E0)
    (hNormalized : (∑ p, coeffMass coeff p) = 1)
    (hEigen : finiteCoulombHamiltonian sys L count (fullCoeffVector coeff) =
      (E : ℂ) • fullCoeffVector coeff) :
    massH2Sq sys.mass (finitePlaneWaveKabs (2 * Real.pi / L) count) coeff ≤
      (uniformBOEigenH2Constant E0 (finiteCoulombPhysicalMassConstant sys L Hunit)) ^ 2 :=
  diag_eigen_h2_le_uniform _ coeff _ E E0 _ hE0 hEnergy
    (finiteCoulombPotential_physical_massBound sys L Hunit count hL hPeriodic)
    hNormalized hEigen

/-- The Sobolev `H²` bound used by the tail estimates. -/
theorem finiteCoulomb_eigen_fullH2Sq_le_uniform (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (count : ℕ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (E E0 : ℝ) (hE0 : 0 ≤ E0) (hEnergy : |E| ≤ E0)
    (hNormalized : (∑ p, coeffMass coeff p) = 1)
    (hEigen : finiteCoulombHamiltonian sys L count (fullCoeffVector coeff) =
      (E : ℂ) • fullCoeffVector coeff) :
    fullH2Sq (finitePlaneWaveKabs (2 * Real.pi / L) count) coeff ≤
      (finiteCoulombH2Constant sys E0 L Hunit) ^ 2 := by
  have hTheta := finiteCoulomb_eigen_massH2Sq_le_uniform sys L Hunit count hL hPeriodic
    coeff E E0 hE0 hEnergy hNormalized hEigen
  have hFull := fullH2Sq_le_mass_sq_mul_massH2Sq sys.one_le_mass sys.mass_le_maxMass
    sys.one_le_maxMass (finitePlaneWaveKabs (2 * Real.pi / L) count) coeff
  unfold finiteCoulombH2Constant
  rw [mul_pow]
  exact hFull.trans (mul_le_mul_of_nonneg_left hTheta (sq_nonneg _))

end FiniteRegularity

/-! ## The potential tail -/

section FiniteTail

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- The common tail budget of all pair and nuclear terms. -/
def finiteCoulombTailConstant (sys : CoulombSystem eta ν) (B Blow Cs Bker M2 : ℝ) : ℝ :=
  sys.couplingWeight * (B * M2 + (4 * Blow * M2 + Cs * Bker * M2))

lemma finiteCoulombTailConstant_nonneg (sys : CoulombSystem eta ν) {B Blow Cs Bker M2 : ℝ}
    (hB : 0 ≤ B) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2) :
    0 ≤ finiteCoulombTailConstant sys B Blow Cs Bker M2 := by
  unfold finiteCoulombTailConstant
  exact mul_nonneg sys.couplingWeight_nonneg
    (add_nonneg (mul_nonneg hB hM2)
      (add_nonneg (mul_nonneg (mul_nonneg (by norm_num) hBlow) hM2)
        (mul_nonneg (mul_nonneg hCs hBker) hM2)))

lemma finiteCoulombNuclearPotential_tail_bound (sys : CoulombSystem eta ν) (r : Fin eta)
    (K g gamma rho B Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hB : 0 ≤ B) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt (gamma ^ 2) ≤ Blow * g)
    (hBkerScale : 432 * gamma ^ 2 * g ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hOne : HasOneParticleCoulombH1Bound g (gamma ^ 2) B (cutoffShellIndex K g + basisExtra))
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) r
        (finiteCoulombNuclearPotential sys gamma (cutoffShellIndex K g + basisExtra)
          (fullCoeffVector coeff))‖ ≤
      ((∑ a, |sys.charge a|) * sys.nuclei.totalCharge *
        (B * M2 + (4 * Blow * M2 + Cs * Bker * M2))) * rho := by
  classical
  let count := cutoffShellIndex K g + basisExtra
  let P := referenceTailOperator K (finitePlaneWaveKabs g count) r
  let S : ℝ := B * M2 + (4 * Blow * M2 + Cs * Bker * M2)
  let N := fun (a : Fin eta) (ell : ν) =>
    referenceKernelConvolutionOperator a (finiteElectronNuclearKernel sys.nuclei gamma count ell)
  have hEach : ∀ (a : Fin eta) (ell : ν),
      ‖P (N a ell (fullCoeffVector coeff))‖ ≤ sys.nuclei.charge ell * (S * rho) := fun a ell =>
    finiteElectronNuclearTerm_tail_bound_any_reference a r sys.nuclei ell
      K g gamma rho B Blow Cs Bker M2 basisExtra coeff hK1 hg hRho hRhoScale
      hB hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hOne hH2
  have hInner : ∀ a : Fin eta,
      ‖∑ ell : ν, P (N a ell (fullCoeffVector coeff))‖ ≤ sys.nuclei.totalCharge * (S * rho) := by
    intro a
    calc ‖∑ ell : ν, P (N a ell (fullCoeffVector coeff))‖
        ≤ ∑ ell : ν, ‖P (N a ell (fullCoeffVector coeff))‖ := norm_sum_le _ _
      _ ≤ ∑ ell : ν, sys.nuclei.charge ell * (S * rho) :=
          Finset.sum_le_sum fun ell _ => hEach a ell
      _ = sys.nuclei.totalCharge * (S * rho) := by
          rw [← Finset.sum_mul]
          rfl
  change ‖P (finiteCoulombNuclearPotential sys gamma count (fullCoeffVector coeff))‖ ≤ _
  have hExpand : P (finiteCoulombNuclearPotential sys gamma count (fullCoeffVector coeff)) =
      ∑ a : Fin eta, ((-sys.charge a : ℝ) : ℂ) •
        ∑ ell : ν, P (N a ell (fullCoeffVector coeff)) := by
    simp only [finiteCoulombNuclearPotential, LinearMap.sum_apply, LinearMap.smul_apply,
      map_sum, map_smul, N]
  rw [hExpand]
  calc ‖∑ a : Fin eta, ((-sys.charge a : ℝ) : ℂ) •
        ∑ ell : ν, P (N a ell (fullCoeffVector coeff))‖
      ≤ ∑ a : Fin eta, ‖((-sys.charge a : ℝ) : ℂ) •
          ∑ ell : ν, P (N a ell (fullCoeffVector coeff))‖ := norm_sum_le _ _
    _ ≤ ∑ a : Fin eta, |sys.charge a| * (sys.nuclei.totalCharge * (S * rho)) := by
        apply Finset.sum_le_sum
        intro a _
        rw [norm_smul, norm_ofReal_neg]
        exact mul_le_mul_of_nonneg_left (hInner a) (abs_nonneg _)
    _ = ((∑ a, |sys.charge a|) * sys.nuclei.totalCharge * S) * rho := by
        rw [← Finset.sum_mul]
        ring

omit [Fintype ν] in
lemma finiteCoulombPairPotential_tail_bound (sys : CoulombSystem eta ν) (r : Fin eta)
    (K g gamma rho B Hunit Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hB : 0 ≤ B) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt (gamma ^ 2) ≤ Blow * g)
    (hBkerScale : 432 * gamma ^ 2 * g ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : gamma ^ 2 * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) r
        (finiteCoulombPairPotential sys gamma (cutoffShellIndex K g + basisExtra)
          (fullCoeffVector coeff))‖ ≤
      ((∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2|) *
        (B * M2 + (4 * Blow * M2 + Cs * Bker * M2))) * rho := by
  classical
  let count := cutoffShellIndex K g + basisExtra
  let P := referenceTailOperator K (finitePlaneWaveKabs g count) r
  let S : ℝ := B * M2 + (4 * Blow * M2 + Cs * Bker * M2)
  let O := fun (pair : FiniteElectronPair eta) =>
    finiteElectronPairCoulombOperator pair.1.1 pair.1.2 (gamma ^ 2) count
  have hEach : ∀ pair : FiniteElectronPair eta,
      ‖P (O pair (fullCoeffVector coeff))‖ ≤ S * rho := fun pair =>
    finiteElectronPairCoulombOperator_tail_bound_any_reference
      pair.1.1 pair.1.2 r (ne_of_lt pair.2) K g (gamma ^ 2) rho B Hunit Blow Cs Bker M2
      basisExtra coeff hK1 hg (sq_nonneg gamma) hRho hRhoScale hB hBlow hCs hBker hM2
      h2gK hAmplitude hBkerScale hCsScale hPeriodic hScale hH2
  change ‖P (finiteCoulombPairPotential sys gamma count (fullCoeffVector coeff))‖ ≤ _
  have hExpand : P (finiteCoulombPairPotential sys gamma count (fullCoeffVector coeff)) =
      ∑ pair : FiniteElectronPair eta,
        ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) • P (O pair (fullCoeffVector coeff)) := by
    simp only [finiteCoulombPairPotential, LinearMap.sum_apply, LinearMap.smul_apply,
      map_sum, map_smul, O]
  rw [hExpand]
  calc ‖∑ pair : FiniteElectronPair eta,
        ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) • P (O pair (fullCoeffVector coeff))‖
      ≤ ∑ pair : FiniteElectronPair eta,
          ‖((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) •
            P (O pair (fullCoeffVector coeff))‖ := norm_sum_le _ _
    _ ≤ ∑ pair : FiniteElectronPair eta,
          |sys.charge pair.1.1 * sys.charge pair.1.2| * (S * rho) := by
        apply Finset.sum_le_sum
        intro pair _
        rw [norm_smul, norm_ofReal']
        exact mul_le_mul_of_nonneg_left (hEach pair) (abs_nonneg _)
    _ = ((∑ pair : FiniteElectronPair eta, |sys.charge pair.1.1 * sys.charge pair.1.2|) * S) *
          rho := by
        rw [← Finset.sum_mul]
        ring

/-- The tail of the full potential, uniformly in the reference particle. -/
lemma finiteCoulombPotential_tail_bound (sys : CoulombSystem eta ν) (r : Fin eta)
    (K g gamma rho B Hunit Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hB : 0 ≤ B) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt (gamma ^ 2) ≤ Blow * g)
    (hBkerScale : 432 * gamma ^ 2 * g ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hScale : gamma ^ 2 * Hunit ^ 2 ≤ B ^ 2 * physicalH1Scale g)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) r
        (finiteCoulombPotential sys gamma (cutoffShellIndex K g + basisExtra)
          (fullCoeffVector coeff))‖ ≤
      finiteCoulombTailConstant sys B Blow Cs Bker M2 * rho := by
  have hOne := oneParticleCoulombH1Bound_of_canonicalPeriodic
    g (gamma ^ 2) B Hunit (cutoffShellIndex K g + basisExtra)
    (sq_nonneg gamma) hPeriodic hScale
  have hNuclear := finiteCoulombNuclearPotential_tail_bound sys r
    K g gamma rho B Blow Cs Bker M2 basisExtra coeff hK1 hg hRho hRhoScale
    hB hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hOne hH2
  have hPair := finiteCoulombPairPotential_tail_bound sys r
    K g gamma rho B Hunit Blow Cs Bker M2 basisExtra coeff hK1 hg hRho hRhoScale
    hB hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hPeriodic hScale hH2
  unfold finiteCoulombPotential
  rw [LinearMap.add_apply, map_add]
  refine (norm_add_le _ _).trans ((add_le_add hNuclear hPair).trans_eq ?_)
  unfold finiteCoulombTailConstant CoulombSystem.couplingWeight
  ring

/-- The physical tail budget of a cube of side `L`. -/
def finiteCoulombPhysicalTailConstant (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker M2 : ℝ) :
    ℝ :=
  finiteCoulombTailConstant sys (coulombPhysicalCellConstant L Hunit) Blow Cs Bker M2

lemma finiteCoulombPhysicalTailConstant_nonneg (sys : CoulombSystem eta ν) (L Hunit : ℝ)
    {Blow Cs Bker M2 : ℝ} (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2) :
    0 ≤ finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2 :=
  finiteCoulombTailConstant_nonneg sys (coulombPhysicalCellConstant_nonneg L Hunit)
    hBlow hCs hBker hM2

lemma finiteCoulombPhysicalTailConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (L Hunit Blow Cs Bker M2 : ℝ) :
    finiteCoulombPhysicalTailConstant (CoulombSystem.bo eta data) L Hunit Blow Cs Bker M2 =
      finiteMolecularCoulombPhysicalTailConstant eta data L Hunit Blow Cs Bker M2 := by
  unfold finiteCoulombPhysicalTailConstant finiteCoulombTailConstant
    finiteMolecularCoulombPhysicalTailConstant finiteMolecularCoulombTailConstant
    coulombPhysicalCellConstant
  rw [CoulombSystem.couplingWeight_bo]
  ring

lemma finiteCoulomb_physical_tail_bound (sys : CoulombSystem eta ν) (r : Fin eta)
    (K rho L Hunit Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)) → ℂ)
    (hL : 0 < L) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hH2 : fullH2Sq (finitePlaneWaveKabs (2 * Real.pi / L)
      (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖referenceTailOperator K
        (finitePlaneWaveKabs (2 * Real.pi / L) (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)) r
        (finiteCoulombPotential sys (coulombCellAmplitude L)
          (cutoffShellIndex K (2 * Real.pi / L) + basisExtra) (fullCoeffVector coeff))‖ ≤
      finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2 * rho := by
  have hg : 0 < 2 * Real.pi / L := div_pos (mul_pos (by norm_num) Real.pi_pos) hL
  exact finiteCoulombPotential_tail_bound sys r K (2 * Real.pi / L) (coulombCellAmplitude L) rho
    (coulombPhysicalCellConstant L Hunit) Hunit Blow Cs Bker M2 basisExtra coeff
    hK1 hg hRho hRhoScale (coulombPhysicalCellConstant_nonneg L Hunit)
    hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale hPeriodic
    (coulombPhysicalCellConstant_scale L Hunit hL) hH2

end FiniteTail

/-! ## The finite energy estimate -/

/-- `Σ_a m_a (m_a + S₁) = S₂ + S₁² ≤ 2 S₁ S₂` for masses at least one. -/
lemma sum_mass_mul_add_le {eta : ℕ} (m : Fin eta → ℝ) (hm1 : ∀ a, 1 ≤ m a) :
    ∑ a, m a * (m a + ∑ b, m b) ≤ 2 * (∑ a, m a) * (∑ a, m a ^ 2) := by
  have hm0 : ∀ a, 0 ≤ m a := fun a => le_trans zero_le_one (hm1 a)
  have hS1 : 0 ≤ ∑ a, m a := Finset.sum_nonneg fun a _ => hm0 a
  have h12 : ∑ a, m a ≤ ∑ a, m a ^ 2 :=
    Finset.sum_le_sum fun a _ => by nlinarith [hm1 a]
  have hS2 : ∑ a, m a ^ 2 ≤ (∑ a, m a) * ∑ a, m a ^ 2 := by
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro a _
    have hsingle : m a ^ 2 ≤ ∑ b, m b ^ 2 :=
      Finset.single_le_sum (f := fun b => m b ^ 2) (fun b _ => sq_nonneg _) (Finset.mem_univ a)
    nlinarith [hm1 a, sq_nonneg (m a)]
  have hexp : ∑ a, m a * (m a + ∑ b, m b) = ∑ a, m a ^ 2 + (∑ a, m a) * (∑ b, m b) := by
    rw [Finset.sum_mul, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro a _
    ring
  rw [hexp]
  nlinarith [mul_le_mul_of_nonneg_left h12 hS1]

/-- The cubic Ritz error of a Hamiltonian `(1/2) Σ_a |k_a|²/m_a + W` in any exchange
sector, from the potential-tail and potential-form estimates. -/
theorem mass_sector_cubic_energy_bound_of_tail_and_form
    (eta : ℕ) {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ} (m : Fin eta → ℝ) (Mbar : ℝ)
    (K g E EN CW rho Cpot : ℝ) (count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (W : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (hm1 : ∀ a, 1 ≤ m a) (hM : ∀ a, m a ≤ Mbar)
    (hK1 : 1 ≤ K) (hg : 0 ≤ g)
    (hRhoScale : rho ^ 2 * K ≤ 1)
    (hPT : ∀ r : Fin eta, ‖referenceTailVector K (finitePlaneWaveKabs g count) r
      (operatorPotentialCoeff W coeff)‖ ≤ CW * rho)
    (hAbsorb : 4 * Mbar * |E| ≤ K ^ 2)
    (hSector : IsSectorCoeff sgn lab coeff)
    (hNormalized : (∑ p, coeffMass coeff p) = 1)
    (hLargeK : 32 * (∑ a, m a ^ 2) * CW ^ 2 ≤ K ^ 5)
    (hWSym : W.IsSymmetric)
    (hEigen : diagHamiltonian (massKineticSymbol m (finitePlaneWaveKabs g count)) W
      (fullCoeffVector coeff) = (E : ℂ) • fullCoeffVector coeff)
    (hGround : IsSectorGroundEnergy sgn lab
      (diagHamiltonian (massKineticSymbol m (finitePlaneWaveKabs g count)) W) E)
    (hGalerkin : IsSectorCubicGalerkinGroundEnergy eta sgn lab K g count
      (diagHamiltonian (massKineticSymbol m (finitePlaneWaveKabs g count)) W) EN)
    (hCpot0 : 0 ≤ Cpot)
    (hPotential : potentialQuadratic W
        (discardedGalerkinVector K (finitePlaneWaveKabs g count) coeff) ≤
      Cpot * discardedH1Sq K (finitePlaneWaveKabs g count) coeff) :
    0 ≤ EN - E ∧ K ^ 3 * (EN - E) ≤
      64 * ((1 / 2 : ℝ) + Cpot + |E|) * (∑ a, m a) * (∑ a, m a ^ 2) * CW ^ 2 := by
  let kabs := finitePlaneWaveKabs g count
  let H := diagHamiltonian (massKineticSymbol m kabs) W
  let C1 : ℝ := (1 / 2 : ℝ) + Cpot + |E|
  have hC1 : 0 ≤ C1 := by positivity
  have hEigFull := diag_fourier_eigen_equation (massKineticSymbol m kabs) coeff W E hEigen
  have hLower := sector_ground_le_cubic_galerkin eta K g E EN count H hGround hGalerkin
  have hTrial : EN * ‖retainedGalerkinVector K kabs coeff‖ ^ 2 ≤
      (inner ℂ (retainedGalerkinVector K kabs coeff)
        (H (retainedGalerkinVector K kabs coeff))).re :=
    hGalerkin.1 _ (retainedGalerkinVector_isSector K kabs coeff hSector)
      (retainedGalerkinVector_isCubicRetained eta K g count hg coeff)
  have hForm := discarded_full_form_bound_of_potential_diag K E Cpot kabs coeff
    (massKineticSymbol m kabs) (massKineticSymbol_le_boKineticSymbol hm1 kabs) W hPotential
  have hAbsorb' : ∀ a, 4 * m a * |E| ≤ K ^ 2 := by
    intro a
    have h := mul_le_mul_of_nonneg_right (hM a) (abs_nonneg E)
    nlinarith
  have hLargeK' : 32 * ∑ a, m a ^ 2 * (fun _ => CW) a ^ 2 ≤ K ^ 5 := by
    have h : (∑ a, m a ^ 2 * (fun _ => CW) a ^ 2) = (∑ a, m a ^ 2) * CW ^ 2 := by
      rw [Finset.sum_mul]
    rw [h]
    linarith
  obtain ⟨hNonneg, hRate⟩ := mass_eighth_milestone_perParticle eta K E EN rho C1 m
    (fun _ => CW) kabs coeff (operatorPotentialCoeff W coeff) H hK1 hm1
    (finitePlaneWaveKabs_nonneg g count hg) hEigFull hRhoScale hPT hAbsorb' hNormalized
    hLargeK' hLower (diagHamiltonian_isSymmetric _ W hWSym) hEigen hTrial hC1 hForm
  refine ⟨hNonneg, hRate.trans ?_⟩
  have hsum := sum_mass_mul_add_le m hm1
  have hfactor : (∑ a, m a * (fun _ => CW) a ^ 2 * (m a + ∑ b, m b)) =
      CW ^ 2 * ∑ a, m a * (m a + ∑ b, m b) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _
    ring
  rw [hfactor]
  have hCW2 : 0 ≤ CW ^ 2 := sq_nonneg CW
  have h := mul_le_mul_of_nonneg_left hsum
    (mul_nonneg (mul_nonneg (by norm_num : (0:ℝ) ≤ 32) hC1) hCW2)
  have hfinal : 32 * C1 * (CW ^ 2 * ∑ a, m a * (m a + ∑ b, m b)) ≤
      64 * C1 * (∑ a, m a) * (∑ a, m a ^ 2) * CW ^ 2 := by
    calc 32 * C1 * (CW ^ 2 * ∑ a, m a * (m a + ∑ b, m b))
        = 32 * C1 * CW ^ 2 * ∑ a, m a * (m a + ∑ b, m b) := by ring
      _ ≤ 32 * C1 * CW ^ 2 * (2 * (∑ a, m a) * (∑ a, m a ^ 2)) := h
      _ = 64 * C1 * (∑ a, m a) * (∑ a, m a ^ 2) * CW ^ 2 := by ring
  exact hfinal

section FiniteEnergy

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- The finite cubic energy estimate for a Coulomb system in any exchange sector: the
manuscript's eq. `nbo-main` at the finite level, `K³ (E_N - E) ≤ 64 C₁ S₁ S₂ C_W²`, with
the mass-free form constant in `C₁`. -/
theorem finiteCoulomb_cubic_energy_bound (sys : CoulombSystem eta ν)
    {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ}
    (K E EN rho L Hunit Blow Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)) → ℂ)
    (hL : 0 < L) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hH2 : fullH2Sq (finitePlaneWaveKabs (2 * Real.pi / L)
      (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)) coeff ≤ M2 ^ 2)
    (hAbsorb : 4 * sys.maxMass * |E| ≤ K ^ 2)
    (hSector : IsSectorCoeff sgn lab coeff)
    (hNormalized : (∑ p, coeffMass coeff p) = 1)
    (hLargeK : 32 * sys.massMoment 2 *
      (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2) ^ 2 ≤ K ^ 5)
    (hEigen : finiteCoulombHamiltonian sys L
        (cutoffShellIndex K (2 * Real.pi / L) + basisExtra) (fullCoeffVector coeff) =
      (E : ℂ) • fullCoeffVector coeff)
    (hGround : IsSectorGroundEnergy sgn lab (finiteCoulombHamiltonian sys L
      (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)) E)
    (hGalerkin : IsSectorCubicGalerkinGroundEnergy eta sgn lab K
      (2 * Real.pi / L) (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)
      (finiteCoulombHamiltonian sys L
        (cutoffShellIndex K (2 * Real.pi / L) + basisExtra)) EN) :
    0 ≤ EN - E ∧ K ^ 3 * (EN - E) ≤
      64 * ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit + |E|) *
        sys.massMoment 1 * sys.massMoment 2 *
        (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2) ^ 2 := by
  let count := cutoffShellIndex K (2 * Real.pi / L) + basisExtra
  have hg : 0 < 2 * Real.pi / L := div_pos (mul_pos (by norm_num) Real.pi_pos) hL
  have hTail : ∀ r : Fin eta,
      ‖referenceTailVector K (finitePlaneWaveKabs (2 * Real.pi / L) count) r
        (operatorPotentialCoeff
          (finiteCoulombPotential sys (coulombCellAmplitude L) count) coeff)‖ ≤
        finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2 * rho := by
    intro r
    have h := finiteCoulomb_physical_tail_bound sys r K rho L Hunit Blow Cs Bker M2 basisExtra
      coeff hL hK1 hRho hRhoScale hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale
      hPeriodic hH2
    rw [referenceTailOperator_potential] at h
    exact h
  have hW := finiteCoulombPotential_physical_h1Bound sys L Hunit count hL hPeriodic
  have hC := finiteCoulombPhysicalFormConstant_nonneg sys L Hunit
  have hForm := discarded_potential_form_of_h1OperatorBound K
    (finitePlaneWaveKabs (2 * Real.pi / L) count) coeff
    (finiteCoulombPotential sys (coulombCellAmplitude L) count) hC hW (le_refl _)
  have hLargeK' : 32 * (∑ a, sys.mass a ^ 2) *
      (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2) ^ 2 ≤ K ^ 5 := hLargeK
  have h := mass_sector_cubic_energy_bound_of_tail_and_form eta sys.mass sys.maxMass
    K (2 * Real.pi / L) E EN (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2)
    rho (finiteCoulombPhysicalFormConstant sys L Hunit) count coeff
    (finiteCoulombPotential sys (coulombCellAmplitude L) count)
    sys.one_le_mass sys.mass_le_maxMass hK1 hg.le (le_of_eq hRhoScale) hTail hAbsorb hSector
    hNormalized hLargeK' (finiteCoulombPotential_isSymmetric sys _ count) hEigen hGround
    hGalerkin hC hForm
  rw [CoulombParticles.massMoment_one]
  exact h

end FiniteEnergy

/-! ## Exchange symmetry and sector preservation -/

/-- A sector vector is a common eigenvector of the exchanges of equally labelled registers. -/
lemma isSectorVector_iff_particlePermutation_swap {eta : ℕ} (sgn : Fin eta → ℂ)
    (lab : Fin eta → ℕ) {μ : Type*} [Fintype μ] (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    IsSectorVector sgn lab u ↔ ∀ i j : Fin eta, i ≠ j → lab i = lab j →
      particlePermutationOperator (Equiv.swap i j) u = sgn i • u := by
  constructor
  · intro h i j hij hlab
    ext p
    exact h i j hij hlab p
  · intro h i j hij hlab p
    exact congrArg (fun v : EuclideanSpace ℂ (FourierConfig eta μ) => v.ofLp p) (h i j hij hlab)

/-- Commutation with the exchanges of equally labelled registers preserves every sector
of that labelling. -/
lemma isSectorVector_map_of_swap_commute {eta : ℕ} {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ}
    {μ : Type*} [Fintype μ]
    (A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    (hComm : ∀ i j : Fin eta, i ≠ j → lab i = lab j → ∀ u,
      A (particlePermutationOperator (Equiv.swap i j) u) =
        particlePermutationOperator (Equiv.swap i j) (A u))
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) (hS : IsSectorVector sgn lab u) :
    IsSectorVector sgn lab (A u) := by
  rw [isSectorVector_iff_particlePermutation_swap] at hS ⊢
  intro i j hij hlab
  rw [← hComm i j hij hlab, hS i j hij hlab, map_smul]

lemma massKineticSymbol_permute {eta : ℕ} {μ : Type*} (m : Fin eta → ℝ) (kabs : μ → ℝ)
    (σ : Equiv.Perm (Fin eta)) (hm : ∀ a, m (σ a) = m a) (p : FourierConfig eta μ) :
    massKineticSymbol m kabs (p ∘ σ) = massKineticSymbol m kabs p := by
  unfold massKineticSymbol
  exact Fintype.sum_equiv σ _ _ (fun a => by simp only [Function.comp_apply, hm a])

lemma diagOperator_particlePermutation_commute {eta : ℕ} {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (σ : Equiv.Perm (Fin eta)) (hA : ∀ p, A (p ∘ σ) = A p)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    diagOperator A (particlePermutationOperator σ u) =
      particlePermutationOperator σ (diagOperator A u) := by
  ext p
  simp only [diagOperator_apply, particlePermutationOperator_apply, hA]

lemma finiteCoefficientKernelOperator_smul_kernel {ι : Type*} [Fintype ι] (z : ℂ)
    (kernel : ι → ι → ℂ) :
    finiteCoefficientKernelOperator (fun q p => z * kernel q p) =
      z • finiteCoefficientKernelOperator kernel := by
  apply LinearMap.ext
  intro u
  ext q
  simp only [finiteCoefficientKernelOperator_apply, LinearMap.smul_apply, PiLp.smul_apply,
    smul_eq_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p _
  ring

section FiniteExchange

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- The output-first kernel of all charge-weighted pair terms. -/
def finiteCoulombPairConfigurationKernel (sys : CoulombSystem eta ν) (gamma : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) : ℂ :=
  ∑ pair : FiniteElectronPair eta, ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
    finiteElectronPairConfigurationKernel pair.1.1 pair.1.2 (gamma ^ 2) count q p

omit [Fintype ν] in
lemma finiteCoulombPairPotential_eq_kernel (sys : CoulombSystem eta ν) (gamma : ℝ)
    (count : ℕ) :
    finiteCoulombPairPotential sys gamma count =
      finiteCoefficientKernelOperator (finiteCoulombPairConfigurationKernel sys gamma count) := by
  unfold finiteCoulombPairPotential finiteCoulombPairConfigurationKernel
  rw [finiteCoefficientKernelOperator_sum (fun (pair : FiniteElectronPair eta) q p =>
    ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
      finiteElectronPairConfigurationKernel pair.1.1 pair.1.2 (gamma ^ 2) count q p)]
  apply Finset.sum_congr rfl
  intro pair _
  rw [finiteCoefficientKernelOperator_smul_kernel]
  rfl

omit [Fintype ν] in
/-- The pair kernel is invariant under relabellings that preserve the charges. -/
lemma finiteCoulombPairConfigurationKernel_permute (sys : CoulombSystem eta ν)
    (σ : Equiv.Perm (Fin eta)) (hq : ∀ a, sys.charge (σ a) = sys.charge a) (gamma : ℝ)
    (count : ℕ) (q p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteCoulombPairConfigurationKernel sys gamma count (q ∘ σ) (p ∘ σ) =
      finiteCoulombPairConfigurationKernel sys gamma count q p := by
  classical
  unfold finiteCoulombPairConfigurationKernel
  simp_rw [finiteElectronPairConfigurationKernel_permute]
  have h := sum_finiteElectronPair_permute σ
    (fun i j => ((sys.charge i * sys.charge j : ℝ) : ℂ) *
      finiteElectronPairConfigurationKernel i j (gamma ^ 2) count q p)
    (fun i j => by
      rw [mul_comm (sys.charge i), finiteElectronPairConfigurationKernel_swap_particles])
  simp only [hq] at h
  exact h

omit [Fintype ν] in
lemma finiteCoulombPairPotential_particlePermutation_commute (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) (σ : Equiv.Perm (Fin eta))
    (hq : ∀ a, sys.charge (σ a) = sys.charge a)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    finiteCoulombPairPotential sys gamma count (particlePermutationOperator σ u) =
      particlePermutationOperator σ (finiteCoulombPairPotential sys gamma count u) := by
  rw [finiteCoulombPairPotential_eq_kernel]
  exact finiteCoefficientKernelOperator_particlePermutation_commute σ _
    (finiteCoulombPairConfigurationKernel_permute sys σ hq gamma count) u

lemma finiteCoulombNuclearPotential_particlePermutation_commute (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) (σ : Equiv.Perm (Fin eta))
    (hq : ∀ a, sys.charge (σ a) = sys.charge a)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    finiteCoulombNuclearPotential sys gamma count (particlePermutationOperator σ u) =
      particlePermutationOperator σ (finiteCoulombNuclearPotential sys gamma count u) := by
  classical
  unfold finiteCoulombNuclearPotential
  simp only [LinearMap.sum_apply, LinearMap.smul_apply, map_sum, map_smul]
  symm
  apply Fintype.sum_equiv σ
  intro i
  rw [hq i]
  congr 1
  apply Finset.sum_congr rfl
  intro ell _
  exact (referenceKernelConvolutionOperator_particlePermutation_covariant σ i _ u).symm

lemma finiteCoulombPotential_particlePermutation_commute (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) (σ : Equiv.Perm (Fin eta))
    (hq : ∀ a, sys.charge (σ a) = sys.charge a)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    finiteCoulombPotential sys gamma count (particlePermutationOperator σ u) =
      particlePermutationOperator σ (finiteCoulombPotential sys gamma count u) := by
  simp only [finiteCoulombPotential, LinearMap.add_apply, map_add,
    finiteCoulombNuclearPotential_particlePermutation_commute sys gamma count σ hq,
    finiteCoulombPairPotential_particlePermutation_commute sys gamma count σ hq]

/-- The Hamiltonian commutes with every relabelling that preserves masses and charges. -/
lemma finiteCoulombHamiltonian_particlePermutation_commute (sys : CoulombSystem eta ν)
    (L : ℝ) (count : ℕ) (σ : Equiv.Perm (Fin eta))
    (hm : ∀ a, sys.mass (σ a) = sys.mass a) (hq : ∀ a, sys.charge (σ a) = sys.charge a)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    finiteCoulombHamiltonian sys L count (particlePermutationOperator σ u) =
      particlePermutationOperator σ (finiteCoulombHamiltonian sys L count u) := by
  unfold finiteCoulombHamiltonian diagHamiltonian
  rw [LinearMap.add_apply, LinearMap.add_apply, LinearMap.smul_apply, LinearMap.smul_apply,
    map_add, map_smul,
    diagOperator_particlePermutation_commute _ σ (massKineticSymbol_permute _ _ σ hm),
    finiteCoulombPotential_particlePermutation_commute sys _ count σ hq]

omit [Fintype ν] in
lemma CoulombSystem.mass_swap (sys : CoulombSystem eta ν) {i j : Fin eta}
    (h : sys.species i = sys.species j) (a : Fin eta) :
    sys.mass (Equiv.swap i j a) = sys.mass a := by
  rw [Equiv.swap_apply_def]
  split_ifs with h1 h2
  · subst h1
    exact (sys.mass_eq _ _ h).symm
  · subst h2
    exact sys.mass_eq _ _ h
  · rfl

omit [Fintype ν] in
lemma CoulombSystem.charge_swap (sys : CoulombSystem eta ν) {i j : Fin eta}
    (h : sys.species i = sys.species j) (a : Fin eta) :
    sys.charge (Equiv.swap i j a) = sys.charge a := by
  rw [Equiv.swap_apply_def]
  split_ifs with h1 h2
  · subst h1
    exact (sys.charge_eq _ _ h).symm
  · subst h2
    exact sys.charge_eq _ _ h
  · rfl

/-- The Hamiltonian preserves every exchange sector of an admissible labelling. -/
theorem finiteCoulombHamiltonian_preserves_sector (sys : CoulombSystem eta ν)
    {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab) (L : ℝ) (count : ℕ)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (hS : IsSectorVector sgn lab u) :
    IsSectorVector sgn lab (finiteCoulombHamiltonian sys L count u) := by
  apply isSectorVector_map_of_swap_commute _ _ u hS
  intro i j _ hl v
  have hs := hlab i j hl
  exact finiteCoulombHamiltonian_particlePermutation_commute sys L count (Equiv.swap i j)
    (sys.mass_swap hs) (sys.charge_swap hs) v

end FiniteExchange

/-! ## Trial states in every exchange sector -/

/-- A particle is a fermion. -/
def CoulombParticles.IsFermion {eta : ℕ} (P : CoulombParticles eta) (a : Fin eta) : Prop :=
  P.fermion (P.species a) = true

instance CoulombParticles.decidableIsFermion {eta : ℕ} (P : CoulombParticles eta) :
    DecidablePred P.IsFermion :=
  fun a => inferInstanceAs (Decidable (P.fermion (P.species a) = true))

lemma CoulombParticles.sign_eq_ite {eta : ℕ} (P : CoulombParticles eta) (a : Fin eta) :
    P.sign a = if P.IsFermion a then -1 else 1 := rfl

/-- The trial coefficient that antisymmetrizes the fermionic registers of the occupation
`φ` and keeps the bosonic registers fixed. -/
def sectorTrialCoeff {eta : ℕ} {μ : Type*} [DecidableEq μ] (isF : Fin eta → Prop)
    [DecidablePred isF] (φ : Fin eta → μ) (p : FourierConfig eta μ) : ℂ := by
  classical
  exact ∑ σ : Equiv.Perm (Fin eta),
    if (∀ k, ¬ isF k → σ k = k) ∧ p = φ ∘ σ then ((Equiv.Perm.sign σ : ℤ) : ℂ) else 0

lemma sectorTrialCoeff_swap_of_isF {eta : ℕ} {μ : Type*} [DecidableEq μ]
    (isF : Fin eta → Prop) [DecidablePred isF] (φ : Fin eta → μ) {i j : Fin eta}
    (hij : i ≠ j) (hi : isF i) (hj : isF j) (p : FourierConfig eta μ) :
    sectorTrialCoeff isF φ (swapConfig i j p) = -sectorTrialCoeff isF φ p := by
  classical
  unfold sectorTrialCoeff
  rw [← Finset.sum_neg_distrib]
  refine Fintype.sum_equiv (Equiv.mulRight (Equiv.swap i j)) _ _ (fun σ => ?_)
  simp only [Equiv.coe_mulRight]
  have hswap : ∀ k, ¬ isF k → Equiv.swap i j k = k := fun k hk =>
    Equiv.swap_apply_of_ne_of_ne (by rintro rfl; exact hk hi) (by rintro rfl; exact hk hj)
  have hfix : (∀ k, ¬ isF k → σ k = k) ↔ (∀ k, ¬ isF k → (σ * Equiv.swap i j) k = k) := by
    constructor
    · intro h k hk
      rw [Equiv.Perm.mul_apply, hswap k hk, h k hk]
    · intro h k hk
      have := h k hk
      rwa [Equiv.Perm.mul_apply, hswap k hk] at this
  have hfun : (swapConfig i j p = φ ∘ σ) ↔ (p = φ ∘ (σ * Equiv.swap i j)) := by
    constructor
    · intro h
      funext k
      have := congrFun h (Equiv.swap i j k)
      simp only [swapConfig, Equiv.swap_apply_self, Function.comp_apply] at this
      simpa [Equiv.Perm.mul_apply] using this
    · intro h
      funext k
      simp only [swapConfig, h, Function.comp_apply, Equiv.Perm.mul_apply, Equiv.swap_apply_self]
  have hsign : ((Equiv.Perm.sign (σ * Equiv.swap i j) : ℤ) : ℂ) =
      -((Equiv.Perm.sign σ : ℤ) : ℂ) := by
    rw [Equiv.Perm.sign_mul, Equiv.Perm.sign_swap hij]
    simp
  by_cases hc : (∀ k, ¬ isF k → σ k = k) ∧ swapConfig i j p = φ ∘ σ
  · have hc' : (∀ k, ¬ isF k → (σ * Equiv.swap i j) k = k) ∧
        p = φ ∘ (σ * Equiv.swap i j) := ⟨hfix.mp hc.1, hfun.mp hc.2⟩
    rw [if_pos hc, if_pos hc', hsign, neg_neg]
  · have hc' : ¬ ((∀ k, ¬ isF k → (σ * Equiv.swap i j) k = k) ∧
        p = φ ∘ (σ * Equiv.swap i j)) := fun h => hc ⟨hfix.mpr h.1, hfun.mpr h.2⟩
    rw [if_neg hc, if_neg hc', neg_zero]

lemma sectorTrialCoeff_swap_of_not_isF {eta : ℕ} {μ : Type*} [DecidableEq μ]
    (isF : Fin eta → Prop) [DecidablePred isF] (φ : Fin eta → μ) {i j : Fin eta}
    (hi : ¬ isF i) (hj : ¬ isF j) (hφ : φ i = φ j) (p : FourierConfig eta μ) :
    sectorTrialCoeff isF φ (swapConfig i j p) = sectorTrialCoeff isF φ p := by
  classical
  unfold sectorTrialCoeff
  apply Finset.sum_congr rfl
  intro σ _
  by_cases hfix : ∀ k, ¬ isF k → σ k = k
  · have hσ : ∀ k, φ (σ (Equiv.swap i j k)) = φ (σ k) := by
      intro k
      rcases eq_or_ne k i with rfl | hki
      · rw [Equiv.swap_apply_left, hfix _ hj, hfix _ hi, hφ]
      · rcases eq_or_ne k j with rfl | hkj
        · rw [Equiv.swap_apply_right, hfix _ hi, hfix _ hj, hφ]
        · rw [Equiv.swap_apply_of_ne_of_ne hki hkj]
    have hiff : swapConfig i j p = φ ∘ σ ↔ p = φ ∘ σ := by
      constructor
      · intro h
        funext k
        have := congrFun h (Equiv.swap i j k)
        simp only [swapConfig, Equiv.swap_apply_self, Function.comp_apply] at this
        simp only [Function.comp_apply]
        rw [this, hσ]
      · intro h
        funext k
        simp only [swapConfig, h, Function.comp_apply, hσ]
    by_cases hp : p = φ ∘ σ
    · rw [if_pos ⟨hfix, hiff.mpr hp⟩, if_pos ⟨hfix, hp⟩]
    · rw [if_neg (fun h => hp (hiff.mp h.2)), if_neg (fun h => hp h.2)]
  · rw [if_neg (fun h => hfix h.1), if_neg (fun h => hfix h.1)]

lemma sectorTrialCoeff_self {eta : ℕ} {μ : Type*} [DecidableEq μ]
    (isF : Fin eta → Prop) [DecidablePred isF] (φ : Fin eta → μ)
    (hinj : ∀ a b, isF a → isF b → φ a = φ b → a = b) :
    sectorTrialCoeff isF φ φ = 1 := by
  classical
  unfold sectorTrialCoeff
  rw [Finset.sum_eq_single (1 : Equiv.Perm (Fin eta))]
  · rw [if_pos ⟨fun k _ => rfl, rfl⟩]
    simp
  · intro σ _ hσ
    rw [if_neg]
    rintro ⟨hfix, hφσ⟩
    apply hσ
    refine Equiv.ext fun k => ?_
    rw [Equiv.Perm.one_apply]
    by_cases hk : isF k
    · have hσk : isF (σ k) := by
        by_contra hnot
        have h1 := hfix (σ k) hnot
        have h2 : σ k = k := σ.injective h1
        apply hnot
        rw [h2]
        exact hk
      have h3 := congrFun hφσ k
      exact hinj _ _ hσk hk h3.symm
    · exact hfix k hk
  · intro h
    exact absurd (Finset.mem_univ _) h

lemma sectorTrialCoeff_support {eta : ℕ} {μ : Type*} [DecidableEq μ]
    (isF : Fin eta → Prop) [DecidablePred isF] (φ : Fin eta → μ) (p : FourierConfig eta μ)
    (hp : sectorTrialCoeff isF φ p ≠ 0) : ∃ σ : Equiv.Perm (Fin eta), p = φ ∘ σ := by
  classical
  by_contra h
  apply hp
  unfold sectorTrialCoeff
  apply Finset.sum_eq_zero
  intro σ _
  rw [if_neg (fun hc => h ⟨σ, hc.2⟩)]

/-- The trial coefficient lies in the sector of the particles for every admissible
labelling, provided equal-species bosons share their occupation. -/
lemma CoulombParticles.sectorTrialCoeff_isSector {eta : ℕ} (P : CoulombParticles eta)
    {lab : Fin eta → ℕ} (hlab : P.IsAdmissible lab) {μ : Type*} [DecidableEq μ]
    (φ : Fin eta → μ) (hφ : ∀ i j, ¬ P.IsFermion i → ¬ P.IsFermion j → φ i = φ j) :
    IsSectorCoeff P.sign lab (sectorTrialCoeff P.IsFermion φ) := by
  intro i j hij hl p
  have hs : P.species i = P.species j := hlab i j hl
  have hiff : P.IsFermion i ↔ P.IsFermion j := by
    unfold CoulombParticles.IsFermion
    rw [hs]
  by_cases hi : P.IsFermion i
  · rw [sectorTrialCoeff_swap_of_isF P.IsFermion φ hij hi (hiff.mp hi) p,
      P.sign_eq_ite, if_pos hi, neg_one_mul]
  · rw [sectorTrialCoeff_swap_of_not_isF P.IsFermion φ hi (fun h => hi (hiff.mpr h))
      (hφ i j hi (fun h => hi (hiff.mpr h))) p, P.sign_eq_ite, if_neg hi, one_mul]

/-- Every exchange sector of an admissible labelling contains a nonzero vector supported
on any set of at least `η` one-particle modes. -/
theorem CoulombParticles.exists_nonzero_sectorVector_supported_of_card {eta : ℕ}
    (P : CoulombParticles eta) {lab : Fin eta → ℕ} (hlab : P.IsAdmissible lab)
    {μ : Type*} [Fintype μ] (modes : Finset μ) (hCard : eta ≤ modes.card) :
    ∃ u : EuclideanSpace ℂ (FourierConfig eta μ),
      IsSectorVector P.sign lab u ∧ u ≠ 0 ∧
        ∀ p : FourierConfig eta μ, u.ofLp p ≠ 0 → ∀ i : Fin eta, p i ∈ modes := by
  classical
  have hSubtype : eta ≤ Fintype.card ↥modes := by simpa using hCard
  let selected : Fin eta ↪ ↥modes := occupiedModesOfCard ↥modes hSubtype
  let φ : Fin eta → μ := fun a =>
    if P.IsFermion a then (selected a).val else (selected ⟨0, Fin.pos a⟩).val
  have hφB : ∀ i j, ¬ P.IsFermion i → ¬ P.IsFermion j → φ i = φ j := by
    intro i j hi hj
    simp only [φ, if_neg hi, if_neg hj]
  have hinj : ∀ a b, P.IsFermion a → P.IsFermion b → φ a = φ b → a = b := by
    intro a b ha hb h
    simp only [φ, if_pos ha, if_pos hb] at h
    exact selected.injective (Subtype.ext h)
  have hmem : ∀ a, φ a ∈ modes := by
    intro a
    simp only [φ]
    split_ifs
    · exact (selected a).property
    · exact (selected _).property
  refine ⟨fullCoeffVector (sectorTrialCoeff P.IsFermion φ), ?_, ?_, ?_⟩
  · exact fullCoeffVector_isSector _ (P.sectorTrialCoeff_isSector hlab φ hφB)
  · intro hZero
    have hAt := congrArg (fun u : EuclideanSpace ℂ (FourierConfig eta μ) => u.ofLp φ) hZero
    have hCoeff : sectorTrialCoeff P.IsFermion φ φ = 0 := by
      simpa only [fullCoeffVector_apply, WithLp.ofLp_zero, Pi.zero_apply] using hAt
    rw [sectorTrialCoeff_self P.IsFermion φ hinj] at hCoeff
    exact one_ne_zero hCoeff
  · intro p hp i
    have hp' : sectorTrialCoeff P.IsFermion φ p ≠ 0 := hp
    obtain ⟨σ, rfl⟩ := sectorTrialCoeff_support P.IsFermion φ p hp'
    exact hmem (σ i)

/-! ## Finite ground states and cubic Ritz minima -/

/-- The coefficient vectors of an exchange sector. -/
def sectorSubmodule (eta : ℕ) (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ) (μ : Type*)
    [Fintype μ] : Submodule ℂ (EuclideanSpace ℂ (FourierConfig eta μ)) where
  carrier := IsSectorVector sgn lab
  zero_mem' := by
    intro i _ _ _ _
    change (0 : ℂ) = sgn i * 0
    rw [mul_zero]
  add_mem' := by
    intro u v hu hv i j hij hlab p
    change u.ofLp (swapConfig i j p) + v.ofLp (swapConfig i j p) =
      sgn i * (u.ofLp p + v.ofLp p)
    have hu' : u.ofLp (swapConfig i j p) = sgn i * u.ofLp p := hu i j hij hlab p
    have hv' : v.ofLp (swapConfig i j p) = sgn i * v.ofLp p := hv i j hij hlab p
    rw [hu', hv', mul_add]
  smul_mem' := by
    intro z u hu i j hij hlab p
    change z * u.ofLp (swapConfig i j p) = sgn i * (z * u.ofLp p)
    have hu' : u.ofLp (swapConfig i j p) = sgn i * u.ofLp p := hu i j hij hlab p
    rw [hu']
    ring

@[simp] lemma mem_sectorSubmodule {eta : ℕ} (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ)
    {μ : Type*} [Fintype μ] (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    u ∈ sectorSubmodule eta sgn lab μ ↔ IsSectorVector sgn lab u := Iff.rfl

/-- The Galerkin trial space: cubic support and the exchange sector. -/
def sectorCubicSubmodule (eta : ℕ) (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ) (K g : ℝ)
    (count : ℕ) :
    Submodule ℂ (EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :=
  sectorSubmodule eta sgn lab (FinitePlaneWaveMode count) ⊓ cubicRetainedSubmodule eta K g count

section FiniteExistence

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- Finite ground states exist in every exchange sector of an admissible labelling when
there are at least `η` one-particle modes. -/
theorem finiteCoulomb_exists_sector_ground (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L : ℝ) (count : ℕ)
    (hEnough : eta ≤ Fintype.card (FinitePlaneWaveMode count)) :
    ∃ E : ℝ, ∃ u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
      IsSectorVector sys.sign lab u ∧ ‖u‖ = 1 ∧
      finiteCoulombHamiltonian sys L count u = (E : ℂ) • u ∧
      IsSectorGroundEnergy sys.sign lab (finiteCoulombHamiltonian sys L count) E := by
  have hInvariant : ∀ u ∈ sectorSubmodule eta sys.sign lab (FinitePlaneWaveMode count),
      finiteCoulombHamiltonian sys L count u ∈
        sectorSubmodule eta sys.sign lab (FinitePlaneWaveMode count) :=
    fun u hu => finiteCoulombHamiltonian_preserves_sector sys hlab L count u hu
  have hNonzero : ∃ u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
      u ∈ sectorSubmodule eta sys.sign lab (FinitePlaneWaveMode count) ∧ u ≠ 0 := by
    obtain ⟨u, hu, hu0, -⟩ := sys.exists_nonzero_sectorVector_supported_of_card hlab
      (Finset.univ : Finset (FinitePlaneWaveMode count)) (by simpa using hEnough)
    exact ⟨u, hu, hu0⟩
  obtain ⟨E, u, hu, hNorm, hEig, hLower⟩ := exists_ground_eigenpair_on_invariant_submodule
    (finiteCoulombHamiltonian sys L count) (finiteCoulombHamiltonian_isSymmetric sys L count)
    _ hInvariant hNonzero
  exact ⟨E, u, hu, hNorm, hEig, fun v hv => hLower v hv⟩

/-- Coefficient-form finite ground data. -/
theorem finiteCoulomb_exists_sector_ground_coeff (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (hlab : sys.IsAdmissible lab) (L : ℝ) (count : ℕ)
    (hEnough : eta ≤ Fintype.card (FinitePlaneWaveMode count)) :
    ∃ E : ℝ, ∃ coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ,
      IsSectorCoeff sys.sign lab coeff ∧ (∑ p, coeffMass coeff p) = 1 ∧
      finiteCoulombHamiltonian sys L count (fullCoeffVector coeff) =
        (E : ℂ) • fullCoeffVector coeff ∧
      IsSectorGroundEnergy sys.sign lab (finiteCoulombHamiltonian sys L count) E := by
  obtain ⟨E, u, hS, hNorm, hEigen, hGround⟩ :=
    finiteCoulomb_exists_sector_ground sys lab hlab L count hEnough
  refine ⟨E, (fun p => u.ofLp p), hS, ?_, ?_, hGround⟩
  · change (∑ p, ‖u.ofLp p‖ ^ 2) = 1
    rw [← EuclideanSpace.norm_sq_eq, hNorm, one_pow]
  · exact hEigen

/-- The cubic Ritz minimum exists in every exchange sector of an admissible labelling
when the cube contains at least `η` modes. -/
theorem finiteCoulomb_exists_cubic_ritz (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L K g : ℝ) (count : ℕ)
    (hEnough : eta ≤ (finiteCubicPlaneWaveModes K g count).card) :
    ∃ EN : ℝ, IsSectorCubicGalerkinGroundEnergy eta sys.sign lab K g count
      (finiteCoulombHamiltonian sys L count) EN := by
  have hNonzero : ∃ u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
      u ∈ sectorCubicSubmodule eta sys.sign lab K g count ∧ u ≠ 0 := by
    obtain ⟨u, hS, hZero, hSupport⟩ := sys.exists_nonzero_sectorVector_supported_of_card hlab
      (finiteCubicPlaneWaveModes K g count) hEnough
    exact ⟨u, ⟨hS, (isCubicRetainedVector_iff_mode_support eta K g count u).mpr hSupport⟩,
      hZero⟩
  obtain ⟨EN, hLower, phi, hPhi, hNorm, hEnergy⟩ := exists_ritz_minimum_on_submodule
    (finiteCoulombHamiltonian sys L count) (finiteCoulombHamiltonian_isSymmetric sys L count)
    (sectorCubicSubmodule eta sys.sign lab K g count) hNonzero
  refine ⟨EN, ?_, phi, hPhi.1, hPhi.2, hNorm, hEnergy⟩
  intro u hS hCube
  exact hLower u ⟨hS, hCube⟩

theorem finiteCoulomb_exists_cubic_ritz_at_integer_cutoff (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (hlab : sys.IsAdmissible lab) (L g : ℝ) (hg : 0 < g) (m count : ℕ)
    (hFits : m ≤ count) (hEnough : eta ≤ (2 * m + 1) ^ 3) :
    ∃ EN : ℝ, IsSectorCubicGalerkinGroundEnergy eta sys.sign lab (g * (m : ℝ)) g count
      (finiteCoulombHamiltonian sys L count) EN := by
  apply finiteCoulomb_exists_cubic_ritz sys lab hlab
  rw [finiteCubicPlaneWaveModes_card g hg m count hFits]
  exact hEnough

/-- Simultaneous finite ground data along a sequence of Fourier horizons. -/
theorem finiteCoulomb_exists_sector_ground_family (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (hlab : sys.IsAdmissible lab) (L : ℝ) (horizon : ℕ → ℕ)
    (hEnough : ∀ n : ℕ, eta ≤ Fintype.card (FinitePlaneWaveMode (horizon n))) :
    ∃ energy : ℕ → ℝ,
      ∃ coeff : ∀ n : ℕ, FourierConfig eta (FinitePlaneWaveMode (horizon n)) → ℂ,
        ∀ n : ℕ,
          IsSectorCoeff sys.sign lab (coeff n) ∧
          (∑ p, coeffMass (coeff n) p) = 1 ∧
          finiteCoulombHamiltonian sys L (horizon n) (fullCoeffVector (coeff n)) =
            (energy n : ℂ) • fullCoeffVector (coeff n) ∧
          IsSectorGroundEnergy sys.sign lab
            (finiteCoulombHamiltonian sys L (horizon n)) (energy n) := by
  classical
  have hex (n : ℕ) :=
    finiteCoulomb_exists_sector_ground_coeff sys lab hlab L (horizon n) (hEnough n)
  choose energy coeff hspec using hex
  exact ⟨energy, coeff, hspec⟩

end FiniteExistence

end
end PlaneWaveCertificate

end ReleaseMilestone146
-- END RELEASE SOURCE 146

-- BEGIN RELEASE SOURCE 147a: continuum bridges and ground-state exhaustion
section ReleaseMilestone147a

/-!
# Milestone 147a: continuum Galerkin bridges and ground-state exhaustion

The continuum layer of milestones 119--121 for a general Coulomb system: a continuum
operator identified with the finite Hamiltonians on the finite plane-wave spaces, the
transport of cubic Ritz minima, the passage of the finite energy estimate to the limit
along a Galerkin exhaustion, and the construction of that exhaustion from graph-norm
approximation of a continuum ground state.
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology BigOperators

noncomputable section

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-- A continuum Hamiltonian on a domain `D` of a Hilbert space `X`, identified with the
finite Hamiltonians of the Coulomb system on every finite plane-wave space: equal
quadratic forms, the exchange sector of the labelling `lab`, cubic support, and
surjectivity of the cubic lift. -/
structure ContinuumCoulombGalerkinBridge (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (L : ℝ) (X : Type*) [NormedAddCommGroup X] [InnerProductSpace ℂ X]
    (D : Submodule ℂ X) where
  hamiltonian : D →ₗ[ℂ] X
  sector : X → Prop
  cubic : ℝ → X → Prop
  embed : (count : ℕ) →
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗᵢ[ℂ] D
  form_eq : ∀ (count : ℕ) u,
    (inner ℂ ((embed count u : D) : X) (hamiltonian (embed count u))).re =
      (inner ℂ u (finiteCoulombHamiltonian sys L count u)).re
  sector_iff : ∀ (count : ℕ) u,
    sector ((embed count u : D) : X) ↔ IsSectorVector sys.sign lab u
  cubic_iff : ∀ (K : ℝ) (count : ℕ) u,
    cubic K ((embed count u : D) : X) ↔
      IsCubicRetainedVector eta K (2 * Real.pi / L) count u
  cubic_lift : ∀ (K : ℝ) (count m : ℕ),
    K * L = 2 * Real.pi * (m : ℝ) → m ≤ count →
    ∀ u : D, sector (u : X) → cubic K (u : X) →
      ∃ v : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
        embed count v = u

section Bridge

variable {sys : CoulombSystem eta ν} {lab : Fin eta → ℕ} {L : ℝ}
variable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X] {D : Submodule ℂ X}

/-- A normalized continuum ground eigenpair in the sector. -/
def HasContinuumSectorGroundPair (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (psi : D) (E : ℝ) : Prop :=
  bridge.sector (psi : X) ∧ ‖psi‖ = 1 ∧
    bridge.hamiltonian psi = (E : ℂ) • (psi : X) ∧
    ∀ u : D, bridge.sector (u : X) →
      E * ‖u‖ ^ 2 ≤ (inner ℂ (u : X) (bridge.hamiltonian u)).re

/-- The continuum cubic Ritz minimum in the sector. -/
def IsContinuumSectorCubicGroundEnergy
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (K EN : ℝ) : Prop :=
  (∀ u : D, bridge.sector (u : X) → bridge.cubic K (u : X) →
    EN * ‖u‖ ^ 2 ≤ (inner ℂ (u : X) (bridge.hamiltonian u)).re) ∧
  ∃ phi : D, bridge.sector (phi : X) ∧ bridge.cubic K (phi : X) ∧
    ‖phi‖ = 1 ∧ (inner ℂ (phi : X) (bridge.hamiltonian phi)).re = EN

/-- The continuum cubic minimum is the finite cubic minimum on every ambient space
containing the cube. -/
lemma continuum_sector_cubic_ground_to_finite
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (K EN : ℝ) (count m : ℕ)
    (hCutoff : K * L = 2 * Real.pi * (m : ℝ)) (hAmbient : m ≤ count)
    (hCube : IsContinuumSectorCubicGroundEnergy bridge K EN) :
    IsSectorCubicGalerkinGroundEnergy eta sys.sign lab K (2 * Real.pi / L) count
      (finiteCoulombHamiltonian sys L count) EN := by
  constructor
  · intro u hS hRetained
    have h := hCube.1 (bridge.embed count u)
      ((bridge.sector_iff count u).mpr hS)
      ((bridge.cubic_iff K count u).mpr hRetained)
    simpa only [(bridge.embed count).norm_map, bridge.form_eq] using h
  · rcases hCube.2 with ⟨phi, hS, hRetained, hNorm, hEnergy⟩
    rcases bridge.cubic_lift K count m hCutoff hAmbient phi hS hRetained with ⟨u, hu⟩
    refine ⟨u, ?_, ?_, ?_, ?_⟩
    · exact (bridge.sector_iff count u).mp (by simpa only [hu] using hS)
    · exact (bridge.cubic_iff K count u).mp (by simpa only [hu] using hRetained)
    · have h := congrArg norm hu
      rw [(bridge.embed count).norm_map, hNorm] at h
      exact h
    · rw [← bridge.form_eq, hu]
      exact hEnergy

/-- The finite cubic minimum on an ambient space containing the cube is the continuum
cubic minimum. -/
lemma finite_sector_cubic_ground_to_continuum
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (K EN : ℝ) (count m : ℕ)
    (hCutoff : K * L = 2 * Real.pi * (m : ℝ)) (hAmbient : m ≤ count)
    (hCube : IsSectorCubicGalerkinGroundEnergy eta sys.sign lab K (2 * Real.pi / L) count
      (finiteCoulombHamiltonian sys L count) EN) :
    IsContinuumSectorCubicGroundEnergy bridge K EN := by
  constructor
  · intro u hS hRetained
    rcases bridge.cubic_lift K count m hCutoff hAmbient u hS hRetained with ⟨v, hv⟩
    have hSv : IsSectorVector sys.sign lab v :=
      (bridge.sector_iff count v).mp (by simpa only [hv] using hS)
    have hR : IsCubicRetainedVector eta K (2 * Real.pi / L) count v :=
      (bridge.cubic_iff K count v).mp (by simpa only [hv] using hRetained)
    have h := hCube.1 v hSv hR
    rw [← bridge.form_eq] at h
    have hNorm : ‖v‖ = ‖u‖ := by
      simpa only [(bridge.embed count).norm_map] using congrArg norm hv
    simpa only [hv, hNorm] using h
  · rcases hCube.2 with ⟨phi, hS, hRetained, hNorm, hEnergy⟩
    refine ⟨bridge.embed count phi, (bridge.sector_iff count phi).mpr hS,
      (bridge.cubic_iff K count phi).mpr hRetained, ?_, ?_⟩
    · simpa only [(bridge.embed count).norm_map] using hNorm
    · rw [bridge.form_eq]
      exact hEnergy

end Bridge

/-- Closedness of a cubic estimate whose constant depends on the energy through
`a + |e|`: it passes to the limit of convergent energies. -/
lemma cubic_energy_bound_passes_to_limit_factor (K E EN a F : ℝ) (energy : ℕ → ℝ)
    (hEnergy : Tendsto energy atTop (𝓝 E))
    (hFinite : ∀ᶠ n in atTop,
      0 ≤ EN - energy n ∧ K ^ 3 * (EN - energy n) ≤ (a + |energy n|) * F) :
    0 ≤ EN - E ∧ K ^ 3 * (EN - E) ≤ (a + |E|) * F := by
  have hError : Tendsto (fun n => EN - energy n) atTop (𝓝 (EN - E)) :=
    tendsto_const_nhds.sub hEnergy
  have hRate : Tendsto (fun n => K ^ 3 * (EN - energy n) - (a + |energy n|) * F) atTop
      (𝓝 (K ^ 3 * (EN - E) - (a + |E|) * F)) := by
    have hA : Tendsto (fun n => a + |energy n|) atTop (𝓝 (a + |E|)) :=
      tendsto_const_nhds.add hEnergy.abs
    exact (tendsto_const_nhds.mul hError).sub (hA.mul tendsto_const_nhds)
  constructor
  · have hNeg : Tendsto (fun n => -(EN - energy n)) atTop (𝓝 (-(EN - E))) := hError.neg
    have h := le_of_tendsto hNeg (hFinite.mono (fun n hn => neg_nonpos.mpr hn.1))
    linarith
  · have h := le_of_tendsto hRate (hFinite.mono (fun n hn => sub_nonpos.mpr hn.2))
    exact sub_nonpos.mp h

/-- A Galerkin exhaustion: finite ground states in the sector along ambient horizons
running to infinity, with energies converging to `E`. -/
structure CoulombGalerkinGroundExhaustion (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (L K E : ℝ) where
  basisExtra : ℕ → ℕ
  exhausts : Tendsto basisExtra atTop atTop
  energy : ℕ → ℝ
  coeff : (n : ℕ) → FourierConfig eta
    (FinitePlaneWaveMode (cutoffShellIndex K (2 * Real.pi / L) + basisExtra n)) → ℂ
  normalized : ∀ n, (∑ p, coeffMass (coeff n) p) = 1
  sector : ∀ n, IsSectorCoeff sys.sign lab (coeff n)
  eigen : ∀ n, finiteCoulombHamiltonian sys L
    (cutoffShellIndex K (2 * Real.pi / L) + basisExtra n)
      (fullCoeffVector (coeff n)) = (energy n : ℂ) • fullCoeffVector (coeff n)
  ground : ∀ n, IsSectorGroundEnergy sys.sign lab (finiteCoulombHamiltonian sys L
    (cutoffShellIndex K (2 * Real.pi / L) + basisExtra n)) (energy n)
  converges : Tendsto energy atTop (𝓝 E)

/-- The uniform `H²` constant along an exhaustion with limit energy `E`. -/
def continuumCoulombH2Constant (sys : CoulombSystem eta ν) (E L Hunit : ℝ) : ℝ :=
  finiteCoulombH2Constant sys (|E| + 1) L Hunit

lemma continuumCoulombH2Constant_nonneg (sys : CoulombSystem eta ν) (E L Hunit : ℝ) :
    0 ≤ continuumCoulombH2Constant sys E L Hunit :=
  finiteCoulombH2Constant_nonneg sys (by positivity) L Hunit

/-- The continuum cubic error constant `64 C₁ S₁ S₂ C_W²`. -/
def continuumCoulombCubicConstant (sys : CoulombSystem eta ν) (E L Hunit Blow Cs Bker : ℝ) :
    ℝ :=
  64 * ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit + |E|) *
    sys.massMoment 1 * sys.massMoment 2 *
    (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
      (continuumCoulombH2Constant sys E L Hunit)) ^ 2

lemma continuumCoulombH2Constant_bo (eta : ℕ) (data : FiniteBONuclearData ν) (E L Hunit : ℝ) :
    continuumCoulombH2Constant (CoulombSystem.bo eta data) E L Hunit =
      continuumMolecularBOH2Constant eta data E L Hunit := by
  unfold continuumCoulombH2Constant continuumMolecularBOH2Constant
  exact finiteCoulombH2Constant_bo eta data (|E| + 1) L Hunit

/-- At the Born--Oppenheimer system the constant is the Born--Oppenheimer constant. -/
lemma continuumCoulombCubicConstant_bo (eta : ℕ) (data : FiniteBONuclearData ν)
    (E L Hunit Blow Cs Bker : ℝ) :
    continuumCoulombCubicConstant (CoulombSystem.bo eta data) E L Hunit Blow Cs Bker =
      continuumMolecularBOCubicConstant eta data E L Hunit Blow Cs Bker := by
  unfold continuumCoulombCubicConstant continuumMolecularBOCubicConstant
  rw [finiteCoulombPhysicalFormConstant_bo, CoulombSystem.massMoment_bo,
    CoulombSystem.massMoment_bo, continuumCoulombH2Constant_bo,
    finiteCoulombPhysicalTailConstant_bo]
  ring

section Continuum

variable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X]

/-- The continuum cubic energy estimate for a Coulomb system, from a continuum ground
pair, a Galerkin exhaustion, and the continuum cubic minimum. -/
theorem continuumCoulomb_cubic_energy_bound (sys : CoulombSystem eta ν) {lab : Fin eta → ℕ}
    (D : Submodule ℂ X) (K E EN rho L Hunit Blow Cs Bker : ℝ)
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (psi : D) (hPair : HasContinuumSectorGroundPair bridge psi E)
    (exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E)
    (hCube : IsContinuumSectorCubicGroundEnergy bridge K EN)
    (hL : 0 < L) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hAbsorb : 4 * sys.maxMass * (|E| + 1) ≤ K ^ 2)
    (hLargeK : 32 * sys.massMoment 2 *
      (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
        (continuumCoulombH2Constant sys E L Hunit)) ^ 2 ≤ K ^ 5)
    (m : ℕ) (hm : 1 ≤ m) (hCutoff : K * L = 2 * Real.pi * (m : ℝ)) :
    (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
    0 ≤ EN - E ∧
    K ^ 3 * (EN - E) ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker ∧
    (((2 * m + 1) ^ 3 : ℕ) : ℝ) * (EN - E) ≤
      (3 * L / (2 * Real.pi)) ^ 3 * continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker := by
  classical
  let M2 := continuumCoulombH2Constant sys E L Hunit
  let CW := finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2
  have hE0 : 0 ≤ |E| + 1 := by positivity
  have hM2 : 0 ≤ M2 := continuumCoulombH2Constant_nonneg sys E L Hunit
  have hMbar0 : 0 ≤ sys.maxMass := le_trans zero_le_one sys.one_le_maxMass
  have hEnergy := convergent_energy_eventually_abs_le exhaustion.energy E exhaustion.converges
  have hHorizon : ∀ᶠ n in atTop, m ≤ exhaustion.basisExtra n :=
    exhaustion.exhausts.eventually (eventually_ge_atTop m)
  have hFinite : ∀ᶠ n in atTop,
      0 ≤ EN - exhaustion.energy n ∧
      K ^ 3 * (EN - exhaustion.energy n) ≤
        ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit +
          |exhaustion.energy n|) *
          (64 * sys.massMoment 1 * sys.massMoment 2 * CW ^ 2) := by
    filter_upwards [hEnergy, hHorizon] with n hEnergyN hHorizonN
    have hAmbient : m ≤ cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n := by
      omega
    have hRegularity : fullH2Sq (finitePlaneWaveKabs (2 * Real.pi / L)
        (cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n))
          (exhaustion.coeff n) ≤ M2 ^ 2 :=
      finiteCoulomb_eigen_fullH2Sq_le_uniform sys L Hunit
        (cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n) hL hPeriodic
        (exhaustion.coeff n) (exhaustion.energy n) (|E| + 1) hE0 hEnergyN
        (exhaustion.normalized n) (exhaustion.eigen n)
    have hAbsorbN : 4 * sys.maxMass * |exhaustion.energy n| ≤ K ^ 2 := by
      have h := mul_le_mul_of_nonneg_left hEnergyN (mul_nonneg (by norm_num : (0:ℝ) ≤ 4) hMbar0)
      linarith
    have hGalerkin := continuum_sector_cubic_ground_to_finite bridge K EN
      (cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n) m
      hCutoff hAmbient hCube
    have h := finiteCoulomb_cubic_energy_bound sys
      K (exhaustion.energy n) EN rho L Hunit Blow Cs Bker M2
      (exhaustion.basisExtra n) (exhaustion.coeff n)
      hL hK1 hRho hRhoScale hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale
      hPeriodic hRegularity hAbsorbN (exhaustion.sector n) (exhaustion.normalized n)
      hLargeK (exhaustion.eigen n) (exhaustion.ground n) hGalerkin
    refine ⟨h.1, h.2.trans (le_of_eq ?_)⟩
    ring
  have hLimit := cubic_energy_bound_passes_to_limit_factor K E EN
    ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit)
    (64 * sys.massMoment 1 * sys.massMoment 2 * CW ^ 2)
    exhaustion.energy exhaustion.converges hFinite
  have hLower : 0 ≤ EN - E := by
    rcases hCube.2 with ⟨phi, hS, _, hNorm, hEnergyPhi⟩
    have h := hPair.2.2.2 phi hS
    rw [hNorm, one_pow, mul_one, hEnergyPhi] at h
    exact sub_nonneg.mpr h
  have hRate : K ^ 3 * (EN - E) ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker := by
    refine hLimit.2.trans (le_of_eq ?_)
    unfold continuumCoulombCubicConstant
    ring
  refine ⟨cubicPlaneWaveBox_card m, hLower, hRate, ?_⟩
  exact cubic_basis_count_energy_bound_of_cutoff m K L (EN - E)
    (continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker)
    hm hL hLower hCutoff hRate

/-- The same estimate in reciprocal-cutoff and reciprocal-basis-count form. -/
theorem continuumCoulomb_cubic_energy_bound_reciprocal (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ}
    (D : Submodule ℂ X) (K E EN rho L Hunit Blow Cs Bker : ℝ)
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (psi : D) (hPair : HasContinuumSectorGroundPair bridge psi E)
    (exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E)
    (hCube : IsContinuumSectorCubicGroundEnergy bridge K EN)
    (hL : 0 < L) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hAbsorb : 4 * sys.maxMass * (|E| + 1) ≤ K ^ 2)
    (hLargeK : 32 * sys.massMoment 2 *
      (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
        (continuumCoulombH2Constant sys E L Hunit)) ^ 2 ≤ K ^ 5)
    (m : ℕ) (hm : 1 ≤ m) (hCutoff : K * L = 2 * Real.pi * (m : ℝ)) :
    (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
    0 ≤ EN - E ∧
    EN - E ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ∧
    continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ≤
      ((3 * L / (2 * Real.pi)) ^ 3 *
        continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker) /
        (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  have h := continuumCoulomb_cubic_energy_bound sys D K E EN rho L Hunit Blow Cs Bker
    bridge psi hPair exhaustion hCube hL hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
    hBkerScale hCsScale hPeriodic hAbsorb hLargeK m hm hCutoff
  let C := continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker
  have hK : 0 < K := lt_of_lt_of_le zero_lt_one hK1
  have hRate : K ^ 3 * (EN - E) ≤ C := h.2.2.1
  have hC : 0 ≤ C := le_trans (mul_nonneg (pow_nonneg hK.le 3) h.2.1) hRate
  have hReciprocal : 0 ≤ C / K ^ 3 := div_nonneg hC (pow_nonneg hK.le 3)
  have hExactRate : K ^ 3 * (C / K ^ 3) ≤ C := by
    have hIdentity : K ^ 3 * (C / K ^ 3) = C := by
      field_simp [ne_of_gt hK]
    exact le_of_eq hIdentity
  refine ⟨h.1, h.2.1, cubic_energy_bound_unscaled K (EN - E) C hK hRate, ?_⟩
  exact cubic_basis_count_energy_bound_unscaled m K L (C / K ^ 3) C
    hm hL hReciprocal hCutoff hExactRate

variable {sys : CoulombSystem eta ν} {lab : Fin eta → ℕ} {L : ℝ} {D : Submodule ℂ X}

/-- The continuum cubic Ritz minimum exists in the sector of an admissible labelling
when the cube contains at least `η` modes. -/
theorem continuumCoulomb_exists_cubic_ritz
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (hlab : sys.IsAdmissible lab)
    (hL : 0 < L) (m : ℕ) (hEnough : eta ≤ (2 * m + 1) ^ 3) :
    ∃ EN : ℝ, IsContinuumSectorCubicGroundEnergy bridge ((2 * Real.pi / L) * (m : ℝ)) EN := by
  have hg : 0 < 2 * Real.pi / L := div_pos (mul_pos (by norm_num) Real.pi_pos) hL
  rcases finiteCoulomb_exists_cubic_ritz_at_integer_cutoff sys lab hlab L (2 * Real.pi / L)
      hg m m le_rfl hEnough with ⟨EN, hRitz⟩
  have hCutoff : ((2 * Real.pi / L) * (m : ℝ)) * L = 2 * Real.pi * (m : ℝ) := by
    field_simp [ne_of_gt hL]
  exact ⟨EN, finite_sector_cubic_ground_to_continuum bridge _ EN m m hCutoff le_rfl hRitz⟩

theorem continuumCoulomb_exists_cubic_ritz_of_cutoff
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (hlab : sys.IsAdmissible lab)
    (hL : 0 < L) (K : ℝ) (m : ℕ)
    (hCutoff : K * L = 2 * Real.pi * (m : ℝ))
    (hEnough : eta ≤ (2 * m + 1) ^ 3) :
    ∃ EN : ℝ, IsContinuumSectorCubicGroundEnergy bridge K EN := by
  have hK : K = (2 * Real.pi / L) * (m : ℝ) := by
    apply (mul_left_inj' (ne_of_gt hL)).mp
    calc
      K * L = 2 * Real.pi * (m : ℝ) := hCutoff
      _ = ((2 * Real.pi / L) * (m : ℝ)) * L := by
        field_simp [ne_of_gt hL]
  rw [hK]
  exact continuumCoulomb_exists_cubic_ritz bridge hlab hL m hEnough

/-! ## Monotonicity, convergence and the exhaustion -/

/-- Integer cubic spaces are nested on the sector. -/
lemma continuum_sector_cubic_mono_integer
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (hL : 0 < L) {m n : ℕ} (hmn : m ≤ n)
    (u : D) (hS : bridge.sector (u : X))
    (hSmall : bridge.cubic ((2 * Real.pi / L) * (m : ℝ)) (u : X)) :
    bridge.cubic ((2 * Real.pi / L) * (n : ℝ)) (u : X) := by
  have hCutoff : ((2 * Real.pi / L) * (m : ℝ)) * L = 2 * Real.pi * (m : ℝ) := by
    field_simp [ne_of_gt hL]
  rcases bridge.cubic_lift ((2 * Real.pi / L) * (m : ℝ)) n m hCutoff hmn u hS hSmall with
    ⟨v, hv⟩
  have hRetained := isCubicRetainedVector_physical_full_horizon eta L hL n v
  have hLarge := (bridge.cubic_iff ((2 * Real.pi / L) * (n : ℝ)) n v).mpr hRetained
  simpa only [hv] using hLarge

/-- Normalized finite ground data give the continuum cubic minimum at the full
ambient cube. -/
lemma finite_ground_coeff_to_continuum_sector_full_cube
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (hL : 0 < L) (count : ℕ) (E : ℝ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (hS : IsSectorCoeff sys.sign lab coeff) (hMass : (∑ p, coeffMass coeff p) = 1)
    (hEigen : finiteCoulombHamiltonian sys L count (fullCoeffVector coeff) =
      (E : ℂ) • fullCoeffVector coeff)
    (hGround : IsSectorGroundEnergy sys.sign lab (finiteCoulombHamiltonian sys L count) E) :
    IsContinuumSectorCubicGroundEnergy bridge ((2 * Real.pi / L) * (count : ℝ)) E := by
  have hg : 0 < 2 * Real.pi / L := div_pos (mul_pos (by norm_num) Real.pi_pos) hL
  have hNorm := fullCoeffVector_norm_eq_one_of_mass coeff hMass
  have hRitz : IsSectorCubicGalerkinGroundEnergy eta sys.sign lab
      ((2 * Real.pi / L) * (count : ℝ)) (2 * Real.pi / L) count
      (finiteCoulombHamiltonian sys L count) E := by
    refine ⟨?_, fullCoeffVector coeff, fullCoeffVector_isSector coeff hS, ?_, hNorm, ?_⟩
    · intro v hv _hCube
      exact hGround v hv
    · exact isCubicRetainedVector_full_horizon eta (2 * Real.pi / L) hg count _
    · exact normalized_eigen_quadratic _ E _ hNorm hEigen
  have hCutoff : ((2 * Real.pi / L) * (count : ℝ)) * L = 2 * Real.pi * (count : ℝ) := by
    field_simp [ne_of_gt hL]
  exact finite_sector_cubic_ground_to_continuum bridge _ E count count hCutoff le_rfl hRitz

lemma continuum_sector_cubic_ground_energy_antitone
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (hL : 0 < L) (m n : ℕ) (hmn : m ≤ n) (Em En : ℝ)
    (hM : IsContinuumSectorCubicGroundEnergy bridge ((2 * Real.pi / L) * (m : ℝ)) Em)
    (hN : IsContinuumSectorCubicGroundEnergy bridge ((2 * Real.pi / L) * (n : ℝ)) En) :
    En ≤ Em := by
  rcases hM.2 with ⟨phi, hS, hCube, hNorm, hEnergy⟩
  have hNcube := continuum_sector_cubic_mono_integer bridge hL hmn phi hS hCube
  have h := hN.1 phi hS hNcube
  simpa only [hNorm, one_pow, mul_one, hEnergy] using h

lemma continuum_sector_ground_le_cubic_ritz
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (psi : D) (E : ℝ) (hPair : HasContinuumSectorGroundPair bridge psi E)
    (K EN : ℝ) (hRitz : IsContinuumSectorCubicGroundEnergy bridge K EN) :
    E ≤ EN := by
  rcases hRitz.2 with ⟨phi, hS, _hCube, hNorm, hEnergy⟩
  have h := hPair.2.2.2 phi hS
  simpa only [hNorm, one_pow, mul_one, hEnergy] using h

/-- Finite Fourier states of the sector in the continuum domain. -/
def finiteSectorFourierStates (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) :
    Set D :=
  {u | ∃ count : ℕ,
    ∃ v : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
      IsSectorVector sys.sign lab v ∧ bridge.embed count v = u}

/-- Graph-norm approximation of a continuum state by finite Fourier states of its
sector. -/
def HasSectorFourierGraphApproximation
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (psi : D) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ v : D,
    v ∈ finiteSectorFourierStates bridge ∧
    ‖(v : X) - (psi : X)‖ < ε ∧
    ‖bridge.hamiltonian v - bridge.hamiltonian psi‖ < ε

lemma finiteSectorFourierStates_sector
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (u : D) (hu : u ∈ finiteSectorFourierStates bridge) : bridge.sector (u : X) := by
  rcases hu with ⟨count, v, hS, hv⟩
  have h := (bridge.sector_iff count v).mpr hS
  simpa only [hv] using h

lemma finiteSectorFourierStates_in_cube
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (hL : 0 < L) (u : D) (hu : u ∈ finiteSectorFourierStates bridge) :
    ∃ m : ℕ, bridge.cubic ((2 * Real.pi / L) * (m : ℝ)) (u : X) := by
  rcases hu with ⟨m, v, _hS, hv⟩
  refine ⟨m, ?_⟩
  have h := (bridge.cubic_iff ((2 * Real.pi / L) * (m : ℝ)) m v).mpr
    (isCubicRetainedVector_physical_full_horizon eta L hL m v)
  simpa only [hv] using h

/-- Graph approximation and the variational principle give convergence of the cubic
Ritz energies along every cofinal sequence of cubes. -/
theorem continuum_sector_cubic_ritz_tendsto_of_graph_approximation
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (hL : 0 < L) (psi : D) (E : ℝ)
    (hPair : HasContinuumSectorGroundPair bridge psi E)
    (hApprox : HasSectorFourierGraphApproximation bridge psi)
    (horizon : ℕ → ℕ) (hHorizon : Tendsto horizon atTop atTop)
    (energy : ℕ → ℝ)
    (hRitz : ∀ n, IsContinuumSectorCubicGroundEnergy bridge
      ((2 * Real.pi / L) * (horizon n : ℝ)) (energy n)) :
    Tendsto energy atTop (𝓝 E) := by
  rcases exists_graph_approximating_sequence D bridge.hamiltonian psi
      (finiteSectorFourierStates bridge) hApprox with ⟨trial, hMem, hTrial, hAction⟩
  let trialEnergy : ℕ → ℝ := fun k =>
    (inner ℂ (trial k : X) (bridge.hamiltonian (trial k))).re / ‖trial k‖ ^ 2
  have hTrialEnergy : Tendsto trialEnergy atTop (𝓝 E) :=
    tendsto_rayleigh_of_graph_convergence bridge.hamiltonian psi E trial
      hPair.2.1 hPair.2.2.1 hTrial hAction
  have hGood : ∀ᶠ k in atTop, trial k ≠ 0 :=
    eventually_ne_zero_of_tendsto_norm_one psi trial hPair.2.1 hTrial
  apply tendsto_energy_of_eventual_trial_upper energy trialEnergy E
    (fun n => continuum_sector_ground_le_cubic_ritz bridge psi E hPair _ (energy n) (hRitz n))
    hTrialEnergy (fun k => trial k ≠ 0) hGood
  intro k hk
  have hS := finiteSectorFourierStates_sector bridge (trial k) (hMem k)
  rcases finiteSectorFourierStates_in_cube bridge hL (trial k) (hMem k) with ⟨m, hCube⟩
  filter_upwards [hHorizon.eventually (eventually_ge_atTop m)] with n hn
  have hLarge := continuum_sector_cubic_mono_integer bridge hL hn (trial k) hS hCube
  have hBound := (hRitz n).1 (trial k) hS hLarge
  exact (le_div_iff₀ (sq_pos_of_pos (norm_pos_iff.mpr hk))).mpr hBound

theorem continuum_sector_cubic_ritz_family_antitone
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (hL : 0 < L) (horizon : ℕ → ℕ) (hMono : Monotone horizon)
    (energy : ℕ → ℝ)
    (hRitz : ∀ n, IsContinuumSectorCubicGroundEnergy bridge
      ((2 * Real.pi / L) * (horizon n : ℝ)) (energy n)) :
    Antitone energy := by
  intro i j hij
  exact continuum_sector_cubic_ground_energy_antitone bridge hL (horizon i) (horizon j)
    (hMono hij) (energy i) (energy j) (hRitz i) (hRitz j)

/-- Graph approximation of a continuum ground state constructs a Galerkin exhaustion,
with `basisExtra n = η + n`. -/
theorem coulombGalerkinGroundExhaustion_exists_of_graph_approximation
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (hlab : sys.IsAdmissible lab)
    (hL : 0 < L) (K : ℝ) (psi : D) (E : ℝ)
    (hPair : HasContinuumSectorGroundPair bridge psi E)
    (hApprox : HasSectorFourierGraphApproximation bridge psi) :
    ∃ exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E,
      Antitone exhaustion.energy ∧ ∀ n, exhaustion.basisExtra n = eta + n := by
  classical
  let extra : ℕ → ℕ := fun n => eta + n
  let horizon : ℕ → ℕ := fun n => cutoffShellIndex K (2 * Real.pi / L) + extra n
  have hExtra : Tendsto extra atTop atTop := by
    apply tendsto_atTop.mpr
    intro m
    filter_upwards [eventually_ge_atTop m] with n hn
    dsimp [extra]
    omega
  have hHorizon : Tendsto horizon atTop atTop := by
    apply tendsto_atTop.mpr
    intro m
    filter_upwards [eventually_ge_atTop m] with n hn
    dsimp [horizon, extra]
    omega
  have hMono : Monotone horizon := by
    intro i j hij
    dsimp [horizon, extra]
    omega
  have hEnough (n : ℕ) : eta ≤ Fintype.card (FinitePlaneWaveMode (horizon n)) := by
    apply enough_finitePlaneWaveModes_of_particle_le_count
    dsimp [horizon, extra]
    omega
  rcases finiteCoulomb_exists_sector_ground_family sys lab hlab L horizon hEnough with
    ⟨energy, coeff, hSpec⟩
  have hRitz (n : ℕ) : IsContinuumSectorCubicGroundEnergy bridge
      ((2 * Real.pi / L) * (horizon n : ℝ)) (energy n) :=
    finite_ground_coeff_to_continuum_sector_full_cube bridge hL (horizon n) (energy n) (coeff n)
      (hSpec n).1 (hSpec n).2.1 (hSpec n).2.2.1 (hSpec n).2.2.2
  have hConverges := continuum_sector_cubic_ritz_tendsto_of_graph_approximation bridge hL psi E
    hPair hApprox horizon hHorizon energy hRitz
  let exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E :=
    { basisExtra := extra
      exhausts := hExtra
      energy := energy
      coeff := coeff
      normalized := fun n => (hSpec n).2.1
      sector := fun n => (hSpec n).1
      eigen := fun n => (hSpec n).2.2.1
      ground := fun n => (hSpec n).2.2.2
      converges := hConverges }
  refine ⟨exhaustion, ?_, ?_⟩
  · exact continuum_sector_cubic_ritz_family_antitone bridge hL horizon hMono energy hRitz
  · intro n
    rfl

end Continuum

end
end PlaneWaveCertificate

end ReleaseMilestone147a
-- END RELEASE SOURCE 147a

-- BEGIN RELEASE SOURCE 147b: Fourier-space Hamiltonian of a Coulomb system
section ReleaseMilestone147b

/-!
# Milestone 147b: the Fourier-space Hamiltonian of a Coulomb system

The lattice kernel of the Hamiltonian with masses and charges, the identity of every
finite Hamiltonian with its compression, the uniform `H²`-to-`L²` bound, the completed
bounded operator on weighted `H²` coefficients, its Galerkin bridge on the `H²` domain,
symmetry and the lower bound `-(B_m² + 1/4)`, a ground state in every sector of an
admissible labelling, the cubic error theorem on the Fourier realization, and the
unitary transport of bridges (milestones 122--130 for a general system).
-/

namespace PlaneWaveCertificate

open Filter MeasureTheory
open scoped Topology BigOperators

noncomputable section

variable {eta : ℕ} {ν : Type*} [Fintype ν]

/-! ## The lattice kernel -/

/-- The charge-weighted nuclear coefficient on the unrestricted lattice. -/
def coulombLatticeNuclearKernel (sys : CoulombSystem eta ν) (gamma : ℝ)
    (q p : FourierConfig eta Lattice3) : ℂ :=
  ∑ i : Fin eta, ((-sys.charge i : ℝ) : ℂ) *
    ∑ ell : ν, latticeReferenceConfigurationKernel i
      (latticeElectronNuclearKernel sys.nuclei gamma ell) q p

/-- The charge-weighted pair coefficient on the unrestricted lattice. -/
def coulombLatticePairKernel (sys : CoulombSystem eta ν) (gamma : ℝ)
    (q p : FourierConfig eta Lattice3) : ℂ :=
  ∑ pair : FiniteElectronPair eta, ((sys.charge pair.1.1 * sys.charge pair.1.2 : ℝ) : ℂ) *
    latticeElectronPairConfigurationKernel pair.1.1 pair.1.2 (gamma ^ 2) q p

/-- The diagonal kinetic coefficient `(1/2) Σ_a (2π/L)² |q_a|² / m_a`. -/
def coulombLatticeKineticKernel (sys : CoulombSystem eta ν) (L : ℝ)
    (q p : FourierConfig eta Lattice3) : ℂ := by
  classical
  exact if p = q then (1 / 2 : ℂ) *
    ((∑ i : Fin eta, (2 * Real.pi / L) ^ 2 * latticeNormSq (q i) / sys.mass i : ℝ) : ℂ)
    else 0

/-- The full output-first lattice kernel of the Hamiltonian. -/
def coulombLatticeHamiltonianKernel (sys : CoulombSystem eta ν) (L : ℝ)
    (q p : FourierConfig eta Lattice3) : ℂ :=
  coulombLatticeKineticKernel sys L q p +
    (coulombLatticeNuclearKernel sys (coulombCellAmplitude L) q p +
      coulombLatticePairKernel sys (coulombCellAmplitude L) q p)

/-- One particle's nuclear terms as the compression of their lattice kernel. -/
lemma finiteNuclearTerms_eq_latticeKernel (data : FiniteBONuclearData ν) (i : Fin eta)
    (gamma : ℝ) (count : ℕ) :
    (∑ ell : ν, referenceKernelConvolutionOperator i
      (finiteElectronNuclearKernel data gamma count ell)) =
      finiteCoefficientKernelOperator (fun q p =>
        ∑ ell : ν, latticeReferenceConfigurationKernel i
          (latticeElectronNuclearKernel data gamma ell)
          (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  classical
  rw [finiteCoefficientKernelOperator_sum]
  apply Finset.sum_congr rfl
  intro ell _
  rw [referenceKernelConvolutionOperator_eq_finiteCoefficientKernelOperator]
  apply congrArg finiteCoefficientKernelOperator
  funext q p
  have hKernel : finiteElectronNuclearKernel data gamma count ell =
      (fun v w => latticeElectronNuclearKernel data gamma ell
        (finitePlaneWaveLatticeIndex count v) (finitePlaneWaveLatticeIndex count w)) := by
    funext v w
    exact finiteElectronNuclearKernel_eq_lattice data gamma count ell v w
  rw [hKernel]
  exact referenceConfigurationKernel_eq_lattice i count _ q p

lemma finiteCoulombNuclearPotential_eq_latticeKernel (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) :
    finiteCoulombNuclearPotential sys gamma count =
      finiteCoefficientKernelOperator (fun q p =>
        coulombLatticeNuclearKernel sys gamma
          (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  classical
  unfold finiteCoulombNuclearPotential coulombLatticeNuclearKernel
  rw [finiteCoefficientKernelOperator_sum (fun (i : Fin eta) q p =>
    ((-sys.charge i : ℝ) : ℂ) * ∑ ell : ν, latticeReferenceConfigurationKernel i
      (latticeElectronNuclearKernel sys.nuclei gamma ell)
      (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p))]
  apply Finset.sum_congr rfl
  intro i _
  rw [finiteCoefficientKernelOperator_smul_kernel, finiteNuclearTerms_eq_latticeKernel]

omit [Fintype ν] in
lemma finiteCoulombPairPotential_eq_latticeKernel (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) :
    finiteCoulombPairPotential sys gamma count =
      finiteCoefficientKernelOperator (fun q p =>
        coulombLatticePairKernel sys gamma
          (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  rw [finiteCoulombPairPotential_eq_kernel]
  apply congrArg finiteCoefficientKernelOperator
  funext q p
  unfold finiteCoulombPairConfigurationKernel coulombLatticePairKernel
  apply Finset.sum_congr rfl
  intro pair _
  rw [finiteElectronPairConfigurationKernel_eq_lattice]

lemma finiteCoulombPotential_eq_latticeKernel (sys : CoulombSystem eta ν)
    (gamma : ℝ) (count : ℕ) :
    finiteCoulombPotential sys gamma count =
      finiteCoefficientKernelOperator (fun q p =>
        coulombLatticeNuclearKernel sys gamma
            (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p) +
          coulombLatticePairKernel sys gamma
            (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  rw [finiteCoulombPotential, finiteCoulombNuclearPotential_eq_latticeKernel,
    finiteCoulombPairPotential_eq_latticeKernel]
  exact (map_add (finiteCoefficientKernelOperatorAddHom
    (ι := FourierConfig eta (FinitePlaneWaveMode count))) _ _).symm

omit [Fintype ν] in
lemma massKineticSymbol_eq_lattice_sum (sys : CoulombSystem eta ν) (g : ℝ) (count : ℕ)
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    massKineticSymbol sys.mass (finitePlaneWaveKabs g count) q =
      ∑ i : Fin eta, g ^ 2 * latticeNormSq (finiteConfigLatticeIndex eta count q i) /
        sys.mass i := by
  unfold massKineticSymbol
  apply Finset.sum_congr rfl
  intro i _
  rw [finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq]
  rfl

omit [Fintype ν] in
lemma finiteCoulombKinetic_eq_latticeKernel (sys : CoulombSystem eta ν) (L : ℝ)
    (count : ℕ) :
    (1 / 2 : ℂ) • diagOperator (eta := eta)
        (massKineticSymbol sys.mass (finitePlaneWaveKabs (2 * Real.pi / L) count)) =
      finiteCoefficientKernelOperator (fun q p => coulombLatticeKineticKernel sys L
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  classical
  apply LinearMap.ext
  intro u
  ext q
  change (1 / 2 : ℂ) *
      ((massKineticSymbol sys.mass (finitePlaneWaveKabs (2 * Real.pi / L) count) q : ℂ) *
        u.ofLp q) =
    ∑ p, u.ofLp p * coulombLatticeKineticKernel sys L
      (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)
  rw [massKineticSymbol_eq_lattice_sum]
  have hEq : ∀ p : FourierConfig eta (FinitePlaneWaveMode count),
      finiteConfigLatticeIndex eta count p = finiteConfigLatticeIndex eta count q ↔ p = q :=
    fun p => (finiteConfigLatticeIndex_injective eta count).eq_iff
  simp only [coulombLatticeKineticKernel, hEq, mul_ite, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true]
  ring

/-- Every finite Hamiltonian is the compression of the same lattice kernel. -/
lemma finiteCoulombHamiltonian_eq_latticeKernel (sys : CoulombSystem eta ν) (L : ℝ)
    (count : ℕ) :
    finiteCoulombHamiltonian sys L count =
      finiteCoefficientKernelOperator (fun q p => coulombLatticeHamiltonianKernel sys L
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) := by
  rw [finiteCoulombHamiltonian, diagHamiltonian, finiteCoulombKinetic_eq_latticeKernel,
    finiteCoulombPotential_eq_latticeKernel]
  exact (map_add (finiteCoefficientKernelOperatorAddHom
    (ι := FourierConfig eta (FinitePlaneWaveMode count))) _ _).symm

lemma finiteCoulombHamiltonian_fullCoeff_apply_latticeKernel (sys : CoulombSystem eta ν)
    (L : ℝ) (count : ℕ) (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ)
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    (finiteCoulombHamiltonian sys L count (fullCoeffVector coeff)).ofLp q =
      ∑ p, coeff p * coulombLatticeHamiltonianKernel sys L
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p) := by
  rw [finiteCoulombHamiltonian_eq_latticeKernel]
  rfl

/-! ## Uniform `H²`-to-`L²` bounds -/

/-- A symbol `0 ≤ A ≤ Σ_a |k_a|²` and an `H¹`-bounded potential give the bound
`‖((1/2) A + W) c‖ ≤ (1/2 + B) ‖c‖_{H²}`. -/
lemma diagHamiltonian_norm_le_sqrt_fullH2Sq {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ) (A : FourierConfig eta μ → ℝ) (hA0 : ∀ p, 0 ≤ A p)
    (hA : ∀ p, A p ≤ boKineticSymbol kabs p) (coeff : FourierConfig eta μ → ℂ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    {B : ℝ} (hB : 0 ≤ B) (hBound : HasH1OperatorBound kabs W B) :
    ‖diagHamiltonian A W (fullCoeffVector coeff)‖ ≤
      ((1 / 2 : ℝ) + B) * Real.sqrt (fullH2Sq kabs coeff) := by
  classical
  have hKineticSq : ‖diagOperator A (fullCoeffVector coeff)‖ ^ 2 ≤ fullH2Sq kabs coeff := by
    change ‖diagMul A (fullCoeffVector coeff)‖ ^ 2 ≤ _
    rw [diagMul_norm_sq]
    unfold fullH2Sq coeffMass
    simp only [fullCoeffVector_apply]
    apply Finset.sum_le_sum
    intro p _
    have hWeight : (A p) ^ 2 ≤ (1 + boKineticSymbol kabs p) ^ 2 := by
      have h1 : A p ≤ 1 + boKineticSymbol kabs p := by linarith [hA p]
      exact pow_le_pow_left₀ (hA0 p) h1 2
    exact mul_le_mul_of_nonneg_right hWeight (sq_nonneg ‖coeff p‖)
  have hKinetic : ‖diagOperator A (fullCoeffVector coeff)‖ ≤
      Real.sqrt (fullH2Sq kabs coeff) := by
    have hRootSq := Real.sq_sqrt (fullH2Sq_nonneg kabs coeff)
    have hRoot0 := Real.sqrt_nonneg (fullH2Sq kabs coeff)
    nlinarith only [hKineticSq, hRootSq, hRoot0,
      norm_nonneg (diagOperator A (fullCoeffVector coeff))]
  have hPotentialNorm : ‖W (fullCoeffVector coeff)‖ ≤
      B * Real.sqrt (fullH2Sq kabs coeff) := by
    calc
      ‖W (fullCoeffVector coeff)‖ ≤
          B * Real.sqrt (fourierH1Sq kabs (fullCoeffVector coeff)) :=
        norm_le_sqrt_fourierH1Sq_of_operatorBound kabs W hB hBound _
      _ ≤ B * Real.sqrt (fullH2Sq kabs coeff) :=
        mul_le_mul_of_nonneg_left
          (Real.sqrt_le_sqrt (fourierH1Sq_fullCoeffVector_le_fullH2Sq kabs coeff)) hB
  change ‖(1 / 2 : ℂ) • diagOperator A (fullCoeffVector coeff) +
      W (fullCoeffVector coeff)‖ ≤ _
  calc
    ‖(1 / 2 : ℂ) • diagOperator A (fullCoeffVector coeff) + W (fullCoeffVector coeff)‖ ≤
        ‖(1 / 2 : ℂ) • diagOperator A (fullCoeffVector coeff)‖ +
          ‖W (fullCoeffVector coeff)‖ := norm_add_le _ _
    _ = (1 / 2 : ℝ) * ‖diagOperator A (fullCoeffVector coeff)‖ +
        ‖W (fullCoeffVector coeff)‖ := by
      rw [norm_smul]
      norm_num
    _ ≤ (1 / 2 : ℝ) * Real.sqrt (fullH2Sq kabs coeff) +
        B * Real.sqrt (fullH2Sq kabs coeff) :=
      add_le_add (mul_le_mul_of_nonneg_left hKinetic (by norm_num)) hPotentialNorm
    _ = ((1 / 2 : ℝ) + B) * Real.sqrt (fullH2Sq kabs coeff) := by ring

theorem finiteCoulombHamiltonian_norm_le_sqrt_fullH2Sq (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (count : ℕ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ) :
    ‖finiteCoulombHamiltonian sys L count (fullCoeffVector coeff)‖ ≤
      ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) *
        Real.sqrt (fullH2Sq (finitePlaneWaveKabs (2 * Real.pi / L) count) coeff) :=
  diagHamiltonian_norm_le_sqrt_fullH2Sq _ _
    (massKineticSymbol_nonneg (fun a => sys.mass_pos a) _)
    (massKineticSymbol_le_boKineticSymbol sys.one_le_mass _) coeff _
    (finiteCoulombPhysicalFormConstant_nonneg sys L Hunit)
    (finiteCoulombPotential_physical_h1Bound sys L Hunit count hL hPeriodic)

theorem finiteCoulombHamiltonian_H2_extract_uniform (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (u : MolecularFourierH2 eta) (count : ℕ) :
    ‖finiteCoulombHamiltonian sys L count
      (fullCoeffVector (finiteFourierCoeffExtract count
        (molecularH2Coeff (2 * Real.pi / L) u)))‖ ≤
      ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) * ‖u‖ := by
  have hC : 0 ≤ (1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit := by
    linarith only [finiteCoulombPhysicalFormConstant_nonneg sys L Hunit]
  exact (finiteCoulombHamiltonian_norm_le_sqrt_fullH2Sq sys L Hunit count hL hPeriodic _).trans
    (mul_le_mul_of_nonneg_left (sqrt_fullH2Sq_extract_le_norm (2 * Real.pi / L) count u) hC)

/-! ## The core action and the completed operator -/

/-- The finite Hamiltonian applied to a fixed finite Fourier input. -/
def finiteCoulombCoreOutput (sys : CoulombSystem eta ν) (L : ℝ)
    (inputCutoff : ℕ) (u : MolecularFourierH2 eta) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  finiteCoulombHamiltonian sys L count
    (fullCoeffVector (finiteFourierCoeffExtract count
      (molecularH2Coeff (2 * Real.pi / L) (molecularH2Truncate inputCutoff u))))

def finiteCoulombCoreOutputLp (sys : CoulombSystem eta ν) (L : ℝ)
    (inputCutoff : ℕ) (u : MolecularFourierH2 eta) (count : ℕ) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  finiteFourierLpEmbed eta count (finiteCoulombCoreOutput sys L inputCutoff u count).ofLp

lemma fourierKernelFiniteOutput_coulomb_eq (sys : CoulombSystem eta ν) (L : ℝ)
    (inputCutoff : ℕ) (u : MolecularFourierH2 eta) (count : ℕ) :
    fourierKernelFiniteOutput (2 * Real.pi / L)
      (coulombLatticeHamiltonianKernel sys L) inputCutoff u count =
      finiteCoulombCoreOutput sys L inputCutoff u count := by
  ext q
  change (∑ p : FourierConfig eta (FinitePlaneWaveMode count),
    molecularH2Coeff (2 * Real.pi / L) (molecularH2Truncate inputCutoff u)
      (finiteConfigLatticeIndex eta count p) *
      coulombLatticeHamiltonianKernel sys L
        (finiteConfigLatticeIndex eta count q) (finiteConfigLatticeIndex eta count p)) =
    (finiteCoulombHamiltonian sys L count
      (fullCoeffVector (finiteFourierCoeffExtract count
        (molecularH2Coeff (2 * Real.pi / L) (molecularH2Truncate inputCutoff u))))).ofLp q
  exact (finiteCoulombHamiltonian_fullCoeff_apply_latticeKernel sys L count _ q).symm

lemma finiteCoulombCoreOutputLp_eq_truncate (sys : CoulombSystem eta ν) (L : ℝ)
    (inputCutoff : ℕ) (u : MolecularFourierH2 eta)
    (v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hv : ∀ q, v q = fourierCubeKernelAction (2 * Real.pi / L)
      (coulombLatticeHamiltonianKernel sys L) inputCutoff u q)
    (count : ℕ) (hCount : inputCutoff ≤ count) :
    finiteCoulombCoreOutputLp sys L inputCutoff u count = molecularH2Truncate count v := by
  unfold finiteCoulombCoreOutputLp
  rw [← fourierKernelFiniteOutput_coulomb_eq]
  exact fourierKernelFiniteOutput_embed_eq_truncate _ _ inputCutoff u v hv count hCount

/-- The full infinite output on each finite Fourier input, with the physical bound. -/
theorem exists_coulombFourierCoreAction (sys : CoulombSystem eta ν) (L Hunit : ℝ)
    (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (inputCutoff : ℕ) (u : MolecularFourierH2 eta) :
    ∃ v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
      (∀ q, v q = fourierCubeKernelAction (2 * Real.pi / L)
        (coulombLatticeHamiltonianKernel sys L) inputCutoff u q) ∧
      ‖v‖ ≤ ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) *
        ‖molecularH2Truncate inputCutoff u‖ := by
  let C := (1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit
  have hC : 0 ≤ C := by
    change 0 ≤ (1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit
    linarith only [finiteCoulombPhysicalFormConstant_nonneg sys L Hunit]
  have hBound : ∀ count, ‖fourierKernelFiniteOutput (2 * Real.pi / L)
      (coulombLatticeHamiltonianKernel sys L) inputCutoff u count‖ ≤
      C * ‖molecularH2Truncate inputCutoff u‖ := by
    intro count
    rw [fourierKernelFiniteOutput_coulomb_eq]
    exact finiteCoulombHamiltonian_H2_extract_uniform sys L Hunit hL hPeriodic
      (molecularH2Truncate inputCutoff u) count
  obtain ⟨v, hv, hNorm, _⟩ := exists_fourierCubeKernelAction_lp2 (2 * Real.pi / L)
    (coulombLatticeHamiltonianKernel sys L) inputCutoff u
    (C * ‖molecularH2Truncate inputCutoff u‖) (mul_nonneg hC (norm_nonneg _)) hBound
  exact ⟨v, hv, hNorm⟩

/-- The finite Hamiltonian applied to the coefficients of an arbitrary weighted `H²`
input, extended by zero. -/
def finiteCoulombH2OutputLp (sys : CoulombSystem eta ν) (L : ℝ)
    (u : MolecularFourierH2 eta) (count : ℕ) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  finiteFourierLpEmbed eta count
    (finiteCoulombHamiltonian sys L count
      (fullCoeffVector (finiteFourierCoeffExtract count
        (molecularH2Coeff (2 * Real.pi / L) u)))).ofLp

lemma finiteCoulombH2OutputLp_eq_core (sys : CoulombSystem eta ν) (L : ℝ)
    (u : MolecularFourierH2 eta) (count : ℕ) :
    finiteCoulombH2OutputLp sys L u count = finiteCoulombCoreOutputLp sys L count u count := by
  unfold finiteCoulombH2OutputLp finiteCoulombCoreOutputLp finiteCoulombCoreOutput
  rw [finiteFourierCoeffExtract_molecularH2Truncate]

lemma finiteCoulombH2OutputLp_eq_compression (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (u : MolecularFourierH2 eta) (count : ℕ) :
    finiteCoulombH2OutputLp sys L u count =
      molecularH2Truncate count (H (molecularH2Truncate count u)) := by
  rw [finiteCoulombH2OutputLp_eq_core]
  exact finiteCoulombCoreOutputLp_eq_truncate sys L count u
    (H (molecularH2Truncate count u)) (hKernel count u) count le_rfl

theorem finiteCoulombH2OutputLp_tendsto (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (u : MolecularFourierH2 eta) :
    Tendsto (fun count => finiteCoulombH2OutputLp sys L u count) atTop (𝓝 (H u)) := by
  have hAction : Tendsto (fun count => H (molecularH2Truncate count u))
      atTop (𝓝 (H u)) := (H.continuous.tendsto u).comp (molecularH2Truncate_tendsto u)
  have hBoth := molecularH2Truncate_tendsto_of_tendsto
    (fun count => H (molecularH2Truncate count u)) (H u) hAction
  simpa only [finiteCoulombH2OutputLp_eq_compression sys L H hKernel] using hBoth

/-- The completed Fourier Hamiltonian of the Coulomb system on weighted `H²`
coefficients. -/
theorem exists_coulombFourierH2Operator (sys : CoulombSystem eta ν) (L Hunit : ℝ)
    (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ∃ H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
      (∀ N u q, H (molecularH2Truncate N u) q =
        fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q) ∧
      (∀ u, ‖H u‖ ≤ ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) * ‖u‖) := by
  have hC : 0 ≤ (1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit := by
    linarith only [finiteCoulombPhysicalFormConstant_nonneg sys L Hunit]
  exact exists_fourierKernelH2Operator (2 * Real.pi / L)
    (coulombLatticeHamiltonianKernel sys L) _ hC
    (fun N u => exists_coulombFourierCoreAction sys L Hunit hL hPeriodic N u)

/-! ## The Fourier-domain Galerkin bridge -/

lemma finiteCoulombH2OutputLp_finiteFourierH2Lift (sys : CoulombSystem eta ν) (L : ℝ)
    (count : ℕ) (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    finiteCoulombH2OutputLp sys L (finiteFourierH2Lift eta (2 * Real.pi / L) count u.ofLp) count =
      finiteFourierLpEmbed eta count (finiteCoulombHamiltonian sys L count u).ofLp := by
  unfold finiteCoulombH2OutputLp
  rw [finiteFourierCoeffExtract_molecularH2Coeff_finiteFourierH2Lift]
  rfl

/-- The constructed domain operator has the finite sesquilinear form on every finite
Fourier subspace. -/
theorem coulombFourierDomainEmbedding_inner_eq (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (count : ℕ) (u v : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    inner ℂ
        ((finiteFourierDomainEmbedding eta (2 * Real.pi / L) count u :
          molecularFourierH2Domain eta (2 * Real.pi / L)) :
            lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator (2 * Real.pi / L) H
          (finiteFourierDomainEmbedding eta (2 * Real.pi / L) count v)) =
      inner ℂ u (finiteCoulombHamiltonian sys L count v) := by
  let w := finiteFourierH2Lift eta (2 * Real.pi / L) count v.ofLp
  have hAction : molecularFourierDomainOperator (2 * Real.pi / L) H
      (finiteFourierDomainEmbedding eta (2 * Real.pi / L) count v) = H w := by
    change molecularFourierDomainOperator (2 * Real.pi / L) H
      (molecularFourierH2DomainEquiv eta (2 * Real.pi / L) w) = H w
    exact molecularFourierDomainOperator_apply_equiv (2 * Real.pi / L) H w
  have hCompress := finiteCoulombH2OutputLp_eq_compression sys L H hKernel w count
  have hFixed : molecularH2Truncate count w = w :=
    molecularH2Truncate_finiteFourierH2Lift eta (2 * Real.pi / L) count v.ofLp
  rw [hFixed] at hCompress
  have hOutput : finiteCoulombH2OutputLp sys L w count =
      finiteFourierLpEmbed eta count (finiteCoulombHamiltonian sys L count v).ofLp :=
    finiteCoulombH2OutputLp_finiteFourierH2Lift sys L count v
  rw [finiteFourierDomainEmbedding_coe, hAction]
  calc
    inner ℂ (finiteFourierLpEmbed eta count u.ofLp) (H w) =
        inner ℂ (finiteFourierLpEmbed eta count u.ofLp)
          (lpTruncate (fourierConfigCube eta count) (H w)) :=
      finiteFourierLpEmbed_inner_truncate eta count u.ofLp (H w)
    _ = inner ℂ (finiteFourierLpEmbed eta count u.ofLp)
          (finiteCoulombH2OutputLp sys L w count) := by
      rw [hCompress]
      rfl
    _ = inner ℂ (finiteFourierLpEmbed eta count u.ofLp)
          (finiteFourierLpEmbed eta count (finiteCoulombHamiltonian sys L count v).ofLp) := by
      rw [hOutput]
    _ = inner ℂ u (finiteCoulombHamiltonian sys L count v) :=
      (finiteFourierLpIsometry eta count).inner_map_map u (finiteCoulombHamiltonian sys L count v)

theorem coulombFourierDomainEmbedding_form_eq (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (count : ℕ) (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    (inner ℂ
        ((finiteFourierDomainEmbedding eta (2 * Real.pi / L) count u :
          molecularFourierH2Domain eta (2 * Real.pi / L)) :
            lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator (2 * Real.pi / L) H
          (finiteFourierDomainEmbedding eta (2 * Real.pi / L) count u))).re =
      (inner ℂ u (finiteCoulombHamiltonian sys L count u)).re :=
  congrArg Complex.re (coulombFourierDomainEmbedding_inner_eq sys L H hKernel count u u)

/-- Zero extension preserves and reflects every exchange sector. -/
lemma finiteFourierLpEmbed_isSector_iff (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ) (count : ℕ)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ) :
    IsSectorCoeff sgn lab (fun p => finiteFourierLpEmbed eta count coeff p) ↔
      IsSectorCoeff sgn lab coeff := by
  classical
  constructor
  · intro h i j hij hlab p
    have hi := h i j hij hlab (finiteConfigLatticeIndex eta count p)
    change finiteFourierLpEmbed eta count coeff
        (swapConfig i j (finiteConfigLatticeIndex eta count p)) =
      sgn i * finiteFourierLpEmbed eta count coeff (finiteConfigLatticeIndex eta count p) at hi
    rw [← finiteConfigLatticeIndex_swap, finiteFourierLpEmbed_apply_index,
      finiteFourierLpEmbed_apply_index] at hi
    exact hi
  · intro h i j hij hlab p
    change finiteFourierLpEmbed eta count coeff (swapConfig i j p) =
      sgn i * finiteFourierLpEmbed eta count coeff p
    by_cases hp : p ∈ fourierConfigCube eta count
    · rcases Finset.mem_image.mp hp with ⟨q, _, rfl⟩
      rw [← finiteConfigLatticeIndex_swap, finiteFourierLpEmbed_apply_index,
        finiteFourierLpEmbed_apply_index]
      exact h i j hij hlab q
    · have hs : swapConfig i j p ∉ fourierConfigCube eta count :=
        fun hsp => hp ((mem_fourierConfigCube_swap_iff count i j p).mp hsp)
      rw [finiteFourierLpEmbed_apply_not_mem_cube eta count _ _ hs,
        finiteFourierLpEmbed_apply_not_mem_cube eta count _ _ hp, mul_zero]

lemma finiteFourierCoeffExtract_isSector {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ} (count : ℕ)
    (coeff : FourierConfig eta Lattice3 → ℂ) (hS : IsSectorCoeff sgn lab coeff) :
    IsSectorCoeff sgn lab (finiteFourierCoeffExtract count coeff) := by
  intro i j hij hlab p
  change coeff (finiteConfigLatticeIndex eta count (swapConfig i j p)) =
    sgn i * coeff (finiteConfigLatticeIndex eta count p)
  rw [finiteConfigLatticeIndex_swap]
  exact hS i j hij hlab (finiteConfigLatticeIndex eta count p)

/-- The Galerkin bridge of the completed Fourier operator on its `H²` range domain. -/
def coulombFourierGalerkinBridge (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ) (L : ℝ)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q) :
    ContinuumCoulombGalerkinBridge sys lab L
      (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
      (molecularFourierH2Domain eta (2 * Real.pi / L)) where
  hamiltonian := molecularFourierDomainOperator (2 * Real.pi / L) H
  sector u := IsSectorCoeff sys.sign lab (fun p => u p)
  cubic K u := IsLatticeCubicCoeff eta K (2 * Real.pi / L) (fun p => u p)
  embed := finiteFourierDomainEmbedding eta (2 * Real.pi / L)
  form_eq := coulombFourierDomainEmbedding_form_eq sys L H hKernel
  sector_iff count u := by
    rw [finiteFourierDomainEmbedding_coe]
    exact finiteFourierLpEmbed_isSector_iff sys.sign lab count u.ofLp
  cubic_iff K count u := by
    rw [finiteFourierDomainEmbedding_coe]
    exact isLatticeCubicCoeff_finiteFourierLpEmbed_iff eta K (2 * Real.pi / L) count u.ofLp
  cubic_lift K count m hCutoff hFits u _hS hCube := by
    refine ⟨fullCoeffVector (finiteFourierCoeffExtract count
      (fun p => (u : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) p)), ?_⟩
    apply Subtype.ext
    rw [finiteFourierDomainEmbedding_coe]
    exact finiteFourierLpEmbed_extract_eq_of_isLatticeCubicCoeff
      K L m count hL hCutoff hFits
      (u : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) hCube

section GraphApproximation

variable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X] {D : Submodule ℂ X}

/-- An `H²` realization of the continuum operator gives graph approximation by its
cubic Fourier truncations. -/
theorem hasSectorFourierGraphApproximation_of_H2_realization
    {sys : CoulombSystem eta ν} {lab : Fin eta → ℕ} {L : ℝ}
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (domainMap : MolecularFourierH2 eta →ₗ[ℂ] D)
    (stateMap actionMap : MolecularFourierH2 eta →L[ℂ] X)
    (hState : ∀ v, (domainMap v : X) = stateMap v)
    (hAction : ∀ v, bridge.hamiltonian (domainMap v) = actionMap v)
    (u : MolecularFourierH2 eta)
    (hFinite : ∀ count, domainMap (molecularH2Truncate count u) ∈
      finiteSectorFourierStates bridge) :
    HasSectorFourierGraphApproximation bridge (domainMap u) := by
  have hTrunc := molecularH2Truncate_tendsto u
  have hStateLimit : Tendsto (fun count => stateMap (molecularH2Truncate count u))
      atTop (𝓝 (stateMap u)) := (stateMap.continuous.tendsto u).comp hTrunc
  have hActionLimit : Tendsto (fun count => actionMap (molecularH2Truncate count u))
      atTop (𝓝 (actionMap u)) := (actionMap.continuous.tendsto u).comp hTrunc
  intro ε hε
  rcases Metric.tendsto_atTop.mp hStateLimit ε hε with ⟨nState, hNS⟩
  rcases Metric.tendsto_atTop.mp hActionLimit ε hε with ⟨nAction, hNA⟩
  let n := max nState nAction
  refine ⟨domainMap (molecularH2Truncate n u), hFinite n, ?_, ?_⟩
  · rw [hState, hState]
    simpa only [dist_eq_norm] using hNS n (le_max_left nState nAction)
  · rw [hAction, hAction]
    simpa only [dist_eq_norm] using hNA n (le_max_right nState nAction)

end GraphApproximation

/-- Every element of the sector in the `H²` domain has finite sector approximants in the
operator graph. -/
theorem coulombFourierGalerkinBridge_graph_approximation (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (psi : molecularFourierH2Domain eta (2 * Real.pi / L))
    (hS : IsSectorCoeff sys.sign lab
      (fun p => (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) p)) :
    HasSectorFourierGraphApproximation (coulombFourierGalerkinBridge sys lab L hL H hKernel)
      psi := by
  let u := (molecularFourierH2DomainEquiv eta (2 * Real.pi / L)).symm psi
  have hDecoded : molecularH2Coeff (2 * Real.pi / L) u =
      (fun p => (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) p) := by
    funext p
    simpa only [molecularH2StateMap_apply] using congrArg
      (fun z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 => z p)
      (molecularH2StateMap_domainEquiv_symm eta (2 * Real.pi / L) psi)
  have hCoeff : IsSectorCoeff sys.sign lab (molecularH2Coeff (2 * Real.pi / L) u) := by
    rw [hDecoded]
    exact hS
  have hApprox := hasSectorFourierGraphApproximation_of_H2_realization
    (coulombFourierGalerkinBridge sys lab L hL H hKernel)
    (molecularFourierH2DomainEquiv eta (2 * Real.pi / L)).toLinearMap
    (molecularH2StateMap eta (2 * Real.pi / L)) H
    (fun v => molecularFourierH2DomainEquiv_coe eta (2 * Real.pi / L) v)
    (fun v => molecularFourierDomainOperator_apply_equiv (2 * Real.pi / L) H v)
    u (by
      intro count
      refine ⟨count, fullCoeffVector
        (finiteFourierCoeffExtract count (molecularH2Coeff (2 * Real.pi / L) u)), ?_, ?_⟩
      · exact finiteFourierCoeffExtract_isSector count
          (molecularH2Coeff (2 * Real.pi / L) u) hCoeff
      · exact finiteFourierDomainEmbedding_extract eta (2 * Real.pi / L) count u)
  change HasSectorFourierGraphApproximation
    (coulombFourierGalerkinBridge sys lab L hL H hKernel)
    (molecularFourierH2DomainEquiv eta (2 * Real.pi / L) u) at hApprox
  simpa only [u, LinearEquiv.apply_symm_apply] using hApprox

/-! ## Symmetry, coercivity and the lower bound -/

/-- The closed exchange sector of the full coefficient space. -/
def molecularFourierSectorSubmodule (eta : ℕ) (sgn : Fin eta → ℂ) (lab : Fin eta → ℕ) :
    Submodule ℂ (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) where
  carrier := {u | IsSectorCoeff sgn lab (fun p => u p)}
  zero_mem' := by
    intro i _ _ _ _
    change (0 : ℂ) = sgn i * 0
    rw [mul_zero]
  add_mem' := by
    intro u v hu hv i j hij hlab p
    have hu' : u (swapConfig i j p) = sgn i * u p := hu i j hij hlab p
    have hv' : v (swapConfig i j p) = sgn i * v p := hv i j hij hlab p
    change u (swapConfig i j p) + v (swapConfig i j p) = sgn i * (u p + v p)
    rw [hu', hv', mul_add]
  smul_mem' := by
    intro a u hu i j hij hlab p
    have hu' : u (swapConfig i j p) = sgn i * u p := hu i j hij hlab p
    change a * u (swapConfig i j p) = sgn i * (a * u p)
    rw [hu']
    ring

theorem molecularFourierSectorSubmodule_isClosed (eta : ℕ) (sgn : Fin eta → ℂ)
    (lab : Fin eta → ℕ) :
    IsClosed (molecularFourierSectorSubmodule eta sgn lab :
      Set (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)) := by
  have hSet : (molecularFourierSectorSubmodule eta sgn lab :
      Set (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)) =
      ⋂ i : Fin eta, ⋂ j : Fin eta, ⋂ (_hij : i ≠ j), ⋂ (_hlab : lab i = lab j),
        ⋂ p : FourierConfig eta Lattice3,
          {u : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 |
            u (swapConfig i j p) = sgn i * u p} := by
    ext u
    simp only [Set.mem_iInter, Set.mem_setOf_eq]
    rfl
  rw [hSet]
  exact isClosed_iInter fun i => isClosed_iInter fun j =>
    isClosed_iInter fun _hij => isClosed_iInter fun _hlab => isClosed_iInter fun p =>
      isClosed_eq
        (lp.evalCLM ℂ (fun _ : FourierConfig eta Lattice3 => ℂ) 2
          (swapConfig i j p)).continuous
        (continuous_const.mul
          (lp.evalCLM ℂ (fun _ : FourierConfig eta Lattice3 => ℂ) 2 p).continuous)

lemma finiteCoulombH2OutputLp_symmetric_pairing (sys : CoulombSystem eta ν) (L : ℝ)
    (count : ℕ) (u v : MolecularFourierH2 eta) :
    inner ℂ (finiteCoulombH2OutputLp sys L u count)
        (molecularH2StateMap eta (2 * Real.pi / L) (molecularH2Truncate count v)) =
      inner ℂ
        (molecularH2StateMap eta (2 * Real.pi / L) (molecularH2Truncate count u))
        (finiteCoulombH2OutputLp sys L v count) := by
  rw [← finiteFourierLpEmbed_molecularH2Coeff_eq_state_truncate,
    ← finiteFourierLpEmbed_molecularH2Coeff_eq_state_truncate]
  let uN := fullCoeffVector
    (finiteFourierCoeffExtract count (molecularH2Coeff (2 * Real.pi / L) u))
  let vN := fullCoeffVector
    (finiteFourierCoeffExtract count (molecularH2Coeff (2 * Real.pi / L) v))
  change inner ℂ
      (finiteFourierLpIsometry eta count (finiteCoulombHamiltonian sys L count uN))
      (finiteFourierLpIsometry eta count vN) =
    inner ℂ (finiteFourierLpIsometry eta count uN)
      (finiteFourierLpIsometry eta count (finiteCoulombHamiltonian sys L count vN))
  rw [(finiteFourierLpIsometry eta count).inner_map_map,
    (finiteFourierLpIsometry eta count).inner_map_map]
  exact finiteCoulombHamiltonian_isSymmetric sys L count uN vN

theorem coulombFourierH2Operator_symmetric_pairing (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (u v : MolecularFourierH2 eta) :
    inner ℂ (H u) (molecularH2StateMap eta (2 * Real.pi / L) v) =
      inner ℂ (molecularH2StateMap eta (2 * Real.pi / L) u) (H v) := by
  have hLeft := (finiteCoulombH2OutputLp_tendsto sys L H hKernel u).inner
    (𝕜 := ℂ) (molecularH2StateMap_truncation_tendsto (2 * Real.pi / L) v)
  have hRight := (molecularH2StateMap_truncation_tendsto (2 * Real.pi / L) u).inner
    (𝕜 := ℂ) (finiteCoulombH2OutputLp_tendsto sys L H hKernel v)
  have hSeq :
      (fun count => inner ℂ (finiteCoulombH2OutputLp sys L u count)
        (molecularH2StateMap eta (2 * Real.pi / L) (molecularH2Truncate count v))) =
      (fun count => inner ℂ
        (molecularH2StateMap eta (2 * Real.pi / L) (molecularH2Truncate count u))
        (finiteCoulombH2OutputLp sys L v count)) := by
    funext count
    exact finiteCoulombH2OutputLp_symmetric_pairing sys L count u v
  rw [hSeq] at hLeft
  exact tendsto_nhds_unique hLeft hRight

theorem coulombFourierDomainOperator_symmetric_pairing (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (u v : molecularFourierH2Domain eta (2 * Real.pi / L)) :
    inner ℂ (molecularFourierDomainOperator (2 * Real.pi / L) H u)
        (v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) =
      inner ℂ (u : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator (2 * Real.pi / L) H v) := by
  have h := coulombFourierH2Operator_symmetric_pairing sys L H hKernel
    ((molecularFourierH2DomainEquiv eta (2 * Real.pi / L)).symm u)
    ((molecularFourierH2DomainEquiv eta (2 * Real.pi / L)).symm v)
  rw [molecularH2StateMap_domainEquiv_symm, molecularH2StateMap_domainEquiv_symm] at h
  exact h

/-- The weighted norm with weight `1 + A` is the norm plus the kinetic form. -/
lemma weightedNormSq_eq_norm_sq_add_diag_form {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    weightedNormSq (fun p => 1 + A p) u = ‖u‖ ^ 2 + (inner ℂ u (diagOperator A u)).re := by
  classical
  have hKin : (inner ℂ u (diagOperator A u)).re = ∑ p, A p * ‖u.ofLp p‖ ^ 2 := by
    rw [PiLp.inner_apply, Complex.re_sum]
    apply Finset.sum_congr rfl
    intro p _
    rw [diagOperator_apply, inner_real_mul_re]
  rw [hKin, EuclideanSpace.norm_sq_eq]
  unfold weightedNormSq
  simp only [add_mul, one_mul, Finset.sum_add_distrib]

/-- Coercivity of `(1/2) A + W` for a potential bounded on the `H¹` space of `A`. -/
lemma diagHamiltonian_coercive_of_weightedBound {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (hA0 : ∀ p, 0 ≤ A p)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    {B : ℝ} (hB : 0 ≤ B) (hBound : HasWeightedOperatorBound (fun p => 1 + A p) W B)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    (1 / 4 : ℝ) * weightedNormSq (fun p => 1 + A p) u ≤
      (inner ℂ u (diagHamiltonian A W u)).re + (B ^ 2 + (1 / 2 : ℝ)) * ‖u‖ ^ 2 := by
  have hw : ∀ p, 0 ≤ 1 + A p := fun p => by linarith [hA0 p]
  have hW := norm_le_of_weightedOperatorBound hw hB hBound u
  have hForm : |potentialQuadratic W u| ≤
      B * ‖u‖ * Real.sqrt (weightedNormSq (fun p => 1 + A p) u) := by
    calc
      |potentialQuadratic W u| ≤ ‖inner ℂ u (W u)‖ := Complex.abs_re_le_norm _
      _ ≤ ‖u‖ * ‖W u‖ := norm_inner_le_norm (𝕜 := ℂ) _ _
      _ ≤ ‖u‖ * (B * Real.sqrt (weightedNormSq (fun p => 1 + A p) u)) :=
        mul_le_mul_of_nonneg_left hW (norm_nonneg u)
      _ = B * ‖u‖ * Real.sqrt (weightedNormSq (fun p => 1 + A p) u) := by ring
  have hRoot := Real.sq_sqrt (weightedNormSq_nonneg hw u)
  have hYoung : B * ‖u‖ * Real.sqrt (weightedNormSq (fun p => 1 + A p) u) ≤
      (1 / 4 : ℝ) * weightedNormSq (fun p => 1 + A p) u + B ^ 2 * ‖u‖ ^ 2 := by
    nlinarith only [sq_nonneg (Real.sqrt (weightedNormSq (fun p => 1 + A p) u) / 2 - B * ‖u‖),
      hRoot]
  have hSplit : (inner ℂ u (diagHamiltonian A W u)).re =
      (1 / 2 : ℝ) * (weightedNormSq (fun p => 1 + A p) u - ‖u‖ ^ 2) +
        potentialQuadratic W u := by
    rw [weightedNormSq_eq_norm_sq_add_diag_form]
    unfold diagHamiltonian potentialQuadratic
    simp only [LinearMap.add_apply, LinearMap.smul_apply, inner_add_right,
      inner_smul_right, Complex.add_re]
    norm_num [Complex.mul_re]
  have hLower := neg_abs_le (potentialQuadratic W u)
  nlinarith only [hForm, hYoung, hSplit, hLower]

lemma diagHamiltonian_form_lower_bound_of_weightedBound {μ : Type*} [Fintype μ]
    (A : FourierConfig eta μ → ℝ) (hA0 : ∀ p, 0 ≤ A p)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ] EuclideanSpace ℂ (FourierConfig eta μ))
    {B : ℝ} (hB : 0 ≤ B) (hBound : HasWeightedOperatorBound (fun p => 1 + A p) W B)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    -(B ^ 2 + (1 / 4 : ℝ)) * ‖u‖ ^ 2 ≤ (inner ℂ u (diagHamiltonian A W u)).re := by
  have hCoercive := diagHamiltonian_coercive_of_weightedBound A hA0 W hB hBound u
  have hNorm : ‖u‖ ^ 2 ≤ weightedNormSq (fun p => 1 + A p) u := by
    rw [EuclideanSpace.norm_sq_eq]
    unfold weightedNormSq
    apply Finset.sum_le_sum
    intro p _
    nlinarith [hA0 p, sq_nonneg ‖u.ofLp p‖]
  nlinarith only [hCoercive, hNorm]

/-- The finite lower bound `-(B_m² + 1/4)` with the mass-weighted `H¹` constant. -/
theorem finiteCoulombHamiltonian_form_lower_bound (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (count : ℕ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    -((finiteCoulombPhysicalMassConstant sys L Hunit) ^ 2 + (1 / 4 : ℝ)) * ‖u‖ ^ 2 ≤
      (inner ℂ u (finiteCoulombHamiltonian sys L count u)).re :=
  diagHamiltonian_form_lower_bound_of_weightedBound _
    (massKineticSymbol_nonneg (fun a => sys.mass_pos a) _) _
    (finiteCoulombPhysicalMassConstant_nonneg sys L Hunit)
    (finiteCoulombPotential_physical_massBound sys L Hunit count hL hPeriodic) u

theorem coulombFourierDomainOperator_lower_bound_of_finite (sys : CoulombSystem eta ν)
    (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (B : ℝ)
    (hFinite : ∀ (count : ℕ)
      (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))),
      -B * ‖u‖ ^ 2 ≤ (inner ℂ u (finiteCoulombHamiltonian sys L count u)).re)
    (z : molecularFourierH2Domain eta (2 * Real.pi / L)) :
    -B * ‖(z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)‖ ^ 2 ≤
      (inner ℂ (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator (2 * Real.pi / L) H z)).re := by
  let g := 2 * Real.pi / L
  have hBounds : ∀ count : ℕ,
      -B * ‖((molecularFourierDomainTruncate g count z :
        molecularFourierH2Domain eta g) :
          lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)‖ ^ 2 ≤
      (inner ℂ ((molecularFourierDomainTruncate g count z :
        molecularFourierH2Domain eta g) :
          lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator g H
          (molecularFourierDomainTruncate g count z))).re := by
    intro count
    let u := fullCoeffVector (finiteFourierCoeffExtract count
      (molecularH2Coeff g ((molecularFourierH2DomainEquiv eta g).symm z)))
    have hEmbed : finiteFourierDomainEmbedding eta g count u =
        molecularFourierDomainTruncate g count z :=
      finiteFourierDomainEmbedding_extract eta g count
        ((molecularFourierH2DomainEquiv eta g).symm z)
    rw [← hEmbed, coulombFourierDomainEmbedding_form_eq sys L H hKernel]
    have hNorm : ‖((finiteFourierDomainEmbedding eta g count u :
        molecularFourierH2Domain eta g) :
          lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)‖ = ‖u‖ :=
      (finiteFourierDomainEmbedding eta g count).norm_map u
    rw [hNorm]
    exact hFinite count u
  have hState := molecularFourierDomainTruncate_state_tendsto g z
  have hAction := molecularFourierDomainTruncate_action_tendsto g H z
  exact le_of_tendsto_of_tendsto
    (tendsto_const_nhds.mul (hState.norm.pow 2))
    (Complex.continuous_re.continuousAt.tendsto.comp (hState.inner hAction))
    (Filter.Eventually.of_forall hBounds)

theorem coulombFourierDomainOperator_form_lower_bound (sys : CoulombSystem eta ν)
    (L Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (z : molecularFourierH2Domain eta (2 * Real.pi / L)) :
    -((finiteCoulombPhysicalMassConstant sys L Hunit) ^ 2 + (1 / 4 : ℝ)) *
      ‖(z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)‖ ^ 2 ≤
      (inner ℂ (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator (2 * Real.pi / L) H z)).re :=
  coulombFourierDomainOperator_lower_bound_of_finite sys L H hKernel _
    (fun count u => finiteCoulombHamiltonian_form_lower_bound sys L Hunit count hL hPeriodic u) z

/-! ## Existence of a continuum ground state -/

/-- A finite ground-state exhaustion in the sector with uniformly bounded `H²` norms,
constructed without a continuum ground pair. -/
theorem coulombGalerkinGroundExhaustion_exists_bounded (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (hlab : sys.IsAdmissible lab) (K L Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ∃ E : ℝ, ∃ exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E,
      ∃ E0 : ℝ, 0 ≤ E0 ∧ Antitone exhaustion.energy ∧
        (∀ n, exhaustion.basisExtra n = eta + n) ∧
        (∀ n, |exhaustion.energy n| ≤ E0 ∧
          fullH2Sq (finitePlaneWaveKabs (2 * Real.pi / L)
            (cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n))
            (exhaustion.coeff n) ≤ (finiteCoulombH2Constant sys E0 L Hunit) ^ 2) := by
  classical
  obtain ⟨H, hKernel, _hNorm⟩ := exists_coulombFourierH2Operator sys L Hunit hL hPeriodic
  let bridge := coulombFourierGalerkinBridge sys lab L hL H hKernel
  let extra : ℕ → ℕ := fun n => eta + n
  let horizon : ℕ → ℕ := fun n => cutoffShellIndex K (2 * Real.pi / L) + extra n
  have hExtra : Tendsto extra atTop atTop := by
    apply tendsto_atTop.mpr
    intro m
    filter_upwards [eventually_ge_atTop m] with n hn
    dsimp [extra]
    omega
  have hMono : Monotone horizon := by
    intro i j hij
    dsimp [horizon, extra]
    omega
  have hEnough (n : ℕ) : eta ≤ Fintype.card (FinitePlaneWaveMode (horizon n)) := by
    apply enough_finitePlaneWaveModes_of_particle_le_count
    dsimp [horizon, extra]
    omega
  obtain ⟨energy, coeff, hSpec⟩ :=
    finiteCoulomb_exists_sector_ground_family sys lab hlab L horizon hEnough
  have hRitz (n : ℕ) : IsContinuumSectorCubicGroundEnergy bridge
      ((2 * Real.pi / L) * (horizon n : ℝ)) (energy n) :=
    finite_ground_coeff_to_continuum_sector_full_cube bridge hL (horizon n) (energy n) (coeff n)
      (hSpec n).1 (hSpec n).2.1 (hSpec n).2.2.1 (hSpec n).2.2.2
  have hAnti : Antitone energy :=
    continuum_sector_cubic_ritz_family_antitone bridge hL horizon hMono energy hRitz
  let B : ℝ := (finiteCoulombPhysicalMassConstant sys L Hunit) ^ 2 + 1 / 4
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hLower (n : ℕ) : -B ≤ energy n := by
    have hUnit := fullCoeffVector_norm_eq_one_of_mass (coeff n) (hSpec n).2.1
    have hEnergy := normalized_eigen_quadratic
      (finiteCoulombHamiltonian sys L (horizon n)) (energy n)
      (fullCoeffVector (coeff n)) hUnit (hSpec n).2.2.1
    have h := finiteCoulombHamiltonian_form_lower_bound sys L Hunit (horizon n) hL hPeriodic
      (fullCoeffVector (coeff n))
    simpa only [hUnit, one_pow, mul_one, hEnergy] using h
  have hBdd : BddBelow (Set.range energy) := by
    refine ⟨-B, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact hLower n
  have hConverges : Tendsto energy atTop (𝓝 (⨅ n, energy n)) :=
    tendsto_atTop_ciInf hAnti hBdd
  let exhaustion : CoulombGalerkinGroundExhaustion sys lab L K (⨅ n, energy n) :=
    { basisExtra := extra
      exhausts := hExtra
      energy := energy
      coeff := coeff
      normalized := fun n => (hSpec n).2.1
      sector := fun n => (hSpec n).1
      eigen := fun n => (hSpec n).2.2.1
      ground := fun n => (hSpec n).2.2.2
      converges := hConverges }
  let E0 : ℝ := |energy 0| + B
  have hE0 : 0 ≤ E0 := add_nonneg (abs_nonneg _) hB
  have hAbs (n : ℕ) : |energy n| ≤ E0 := by
    apply abs_le.mpr
    have hLow := hLower n
    have hHigh := hAnti (Nat.zero_le n)
    dsimp [E0]
    constructor
    · linarith only [hLow, abs_nonneg (energy 0)]
    · linarith only [hHigh, le_abs_self (energy 0), hB]
  refine ⟨⨅ n, energy n, exhaustion, E0, hE0, hAnti, ?_, ?_⟩
  · intro n
    rfl
  · intro n
    refine ⟨hAbs n, ?_⟩
    exact finiteCoulomb_eigen_fullH2Sq_le_uniform sys L Hunit (horizon n) hL hPeriodic
      (coeff n) (energy n) E0 hE0 (hAbs n) (hSpec n).2.1 (hSpec n).2.2.1

/-- Strong limits of normalized sector states remain normalized and in the sector. -/
theorem molecularH2StateMap_exists_normalized_sector_subseq
    (eta : ℕ) {sgn : Fin eta → ℂ} {lab : Fin eta → ℕ} (g : ℝ) (hg : g ≠ 0)
    (u : ℕ → MolecularFourierH2 eta) (R : ℝ)
    (hBound : ∀ n, ‖u n‖ ≤ R)
    (hNorm : ∀ n, ‖molecularH2StateMap eta g (u n)‖ = 1)
    (hS : ∀ n, IsSectorCoeff sgn lab (fun p => molecularH2StateMap eta g (u n) p)) :
    ∃ w : MolecularFourierH2 eta, ∃ φ : ℕ → ℕ,
      StrictMono φ ∧ ‖w‖ ≤ R ∧
      ‖molecularH2StateMap eta g w‖ = 1 ∧
      IsSectorCoeff sgn lab (fun p => molecularH2StateMap eta g w p) ∧
      Tendsto (fun n => molecularH2StateMap eta g (u (φ n))) atTop
        (𝓝 (molecularH2StateMap eta g w)) := by
  obtain ⟨w, φ, hφ, hwBound, hLim⟩ :=
    molecularH2StateMap_exists_bounded_subseq eta g hg u R hBound
  have hwNorm : ‖molecularH2StateMap eta g w‖ = 1 := by
    apply tendsto_nhds_unique hLim.norm
    simpa only [hNorm] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (𝓝 1))
  have hwS : molecularH2StateMap eta g w ∈ molecularFourierSectorSubmodule eta sgn lab :=
    (molecularFourierSectorSubmodule_isClosed eta sgn lab).mem_of_tendsto hLim
      (Filter.Eventually.of_forall (fun n => hS (φ n)))
  exact ⟨w, φ, hφ, hwBound, hwNorm, hwS, hLim⟩

lemma finiteCoulombH2OutputLp_pairing_eigenvector (sys : CoulombSystem eta ν) (L : ℝ)
    (count : ℕ) (energy : ℝ) (u : MolecularFourierH2 eta)
    (v : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (hEigen : finiteCoulombHamiltonian sys L count v = (energy : ℂ) • v) :
    inner ℂ (finiteCoulombH2OutputLp sys L u count) (finiteFourierLpEmbed eta count v.ofLp) =
      inner ℂ
        (molecularH2StateMap eta (2 * Real.pi / L) (molecularH2Truncate count u))
        ((energy : ℂ) • finiteFourierLpEmbed eta count v.ofLp) := by
  rw [← finiteFourierLpEmbed_molecularH2Coeff_eq_state_truncate]
  let uN := fullCoeffVector
    (finiteFourierCoeffExtract count (molecularH2Coeff (2 * Real.pi / L) u))
  change inner ℂ
      (finiteFourierLpIsometry eta count (finiteCoulombHamiltonian sys L count uN))
      (finiteFourierLpIsometry eta count v) =
    inner ℂ (finiteFourierLpIsometry eta count uN)
      ((energy : ℂ) • finiteFourierLpIsometry eta count v)
  rw [← (finiteFourierLpIsometry eta count).map_smul (energy : ℂ) v,
    (finiteFourierLpIsometry eta count).inner_map_map,
    (finiteFourierLpIsometry eta count).inner_map_map, ← hEigen]
  exact finiteCoulombHamiltonian_isSymmetric sys L count uN v

theorem coulombFourierH2_weak_eigen_of_finite_eigen_limit (sys : CoulombSystem eta ν) (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (count : ℕ → ℕ) (hCount : Tendsto count atTop atTop)
    (energy : ℕ → ℝ) (E : ℝ) (hEnergy : Tendsto energy atTop (𝓝 E))
    (coeff : (n : ℕ) → FourierConfig eta (FinitePlaneWaveMode (count n)) → ℂ)
    (hEigen : ∀ n, finiteCoulombHamiltonian sys L (count n)
      (fullCoeffVector (coeff n)) = (energy n : ℂ) • fullCoeffVector (coeff n))
    (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hState : Tendsto (fun n => finiteFourierLpEmbed eta (count n) (coeff n)) atTop (𝓝 z))
    (u : MolecularFourierH2 eta) :
    inner ℂ (H u) z = inner ℂ (molecularH2StateMap eta (2 * Real.pi / L) u) ((E : ℂ) • z) := by
  have hAction := (finiteCoulombH2OutputLp_tendsto sys L H hKernel u).comp hCount
  have hTest := (molecularH2StateMap_truncation_tendsto (2 * Real.pi / L) u).comp hCount
  have hScalar : Tendsto (fun n => (energy n : ℂ)) atTop (𝓝 (E : ℂ)) :=
    (Complex.continuous_ofReal.tendsto E).comp hEnergy
  have hLeft := hAction.inner (𝕜 := ℂ) hState
  have hRight := hTest.inner (𝕜 := ℂ) (hScalar.smul hState)
  have hPairing :
      (fun n => inner ℂ (finiteCoulombH2OutputLp sys L u (count n))
        (finiteFourierLpEmbed eta (count n) (coeff n))) =
      (fun n => inner ℂ
        (molecularH2StateMap eta (2 * Real.pi / L) (molecularH2Truncate (count n) u))
        ((energy n : ℂ) • finiteFourierLpEmbed eta (count n) (coeff n))) := by
    funext n
    exact finiteCoulombH2OutputLp_pairing_eigenvector sys L
      (count n) (energy n) u (fullCoeffVector (coeff n)) (hEigen n)
  change Tendsto
    (fun n => inner ℂ (finiteCoulombH2OutputLp sys L u (count n))
      (finiteFourierLpEmbed eta (count n) (coeff n))) atTop
    (𝓝 (inner ℂ (H u) z)) at hLeft
  rw [hPairing] at hLeft
  exact tendsto_nhds_unique hLeft hRight

theorem coulombFourierDomainOperator_eigen_of_finite_eigen_limit (sys : CoulombSystem eta ν)
    (L : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (count : ℕ → ℕ) (hCount : Tendsto count atTop atTop)
    (energy : ℕ → ℝ) (E : ℝ) (hEnergy : Tendsto energy atTop (𝓝 E))
    (coeff : (n : ℕ) → FourierConfig eta (FinitePlaneWaveMode (count n)) → ℂ)
    (hEigen : ∀ n, finiteCoulombHamiltonian sys L (count n)
      (fullCoeffVector (coeff n)) = (energy n : ℂ) • fullCoeffVector (coeff n))
    (z : molecularFourierH2Domain eta (2 * Real.pi / L))
    (hState : Tendsto (fun n => finiteFourierLpEmbed eta (count n) (coeff n))
      atTop (𝓝 (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2))) :
    molecularFourierDomainOperator (2 * Real.pi / L) H z =
      (E : ℂ) • (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) := by
  have hTest (v : molecularFourierH2Domain eta (2 * Real.pi / L)) :
      inner ℂ (v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator (2 * Real.pi / L) H z) =
      inner ℂ (v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        ((E : ℂ) • (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)) := by
    have hWeak := coulombFourierH2_weak_eigen_of_finite_eigen_limit
      sys L H hKernel count hCount energy E hEnergy coeff hEigen
      (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) hState
      ((molecularFourierH2DomainEquiv eta (2 * Real.pi / L)).symm v)
    rw [molecularH2StateMap_domainEquiv_symm] at hWeak
    change inner ℂ (molecularFourierDomainOperator (2 * Real.pi / L) H v)
      (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) = _ at hWeak
    rw [coulombFourierDomainOperator_symmetric_pairing sys L H hKernel v z] at hWeak
    exact hWeak
  have hClosed : IsClosed
      {v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 |
        inner ℂ v (molecularFourierDomainOperator (2 * Real.pi / L) H z) =
          inner ℂ v ((E : ℂ) • (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2))} :=
    isClosed_eq (continuous_id.inner continuous_const)
      (continuous_id.inner continuous_const)
  have hSubset :
      (molecularFourierH2Domain eta (2 * Real.pi / L) :
        Set (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)) ⊆
      {v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 |
        inner ℂ v (molecularFourierDomainOperator (2 * Real.pi / L) H z) =
          inner ℂ v ((E : ℂ) • (z : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2))} := by
    intro v hv
    exact hTest ⟨v, hv⟩
  apply ext_inner_left ℂ
  intro v
  exact closure_minimal hSubset hClosed
    (molecularFourierH2Domain_dense eta (2 * Real.pi / L) v)

section GroundBound

variable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X] {D : Submodule ℂ X}

/-- The limit of cofinal cubic ground energies bounds the form of every graph-
approximable sector state. -/
theorem continuum_sector_cubic_limit_ground_bound_of_graph_approximation
    {sys : CoulombSystem eta ν} {lab : Fin eta → ℕ} {L : ℝ}
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (hL : 0 < L) (E : ℝ)
    (horizon : ℕ → ℕ) (hHorizon : Tendsto horizon atTop atTop)
    (energy : ℕ → ℝ)
    (hRitz : ∀ n, IsContinuumSectorCubicGroundEnergy bridge
      ((2 * Real.pi / L) * (horizon n : ℝ)) (energy n))
    (hEnergy : Tendsto energy atTop (𝓝 E))
    (psi : D) (hApprox : HasSectorFourierGraphApproximation bridge psi) :
    E * ‖psi‖ ^ 2 ≤ (inner ℂ (psi : X) (bridge.hamiltonian psi)).re := by
  obtain ⟨trial, hMem, hTrial, hAction⟩ :=
    exists_graph_approximating_sequence D bridge.hamiltonian psi
      (finiteSectorFourierStates bridge) hApprox
  have hBounds (k : ℕ) :
      E * ‖trial k‖ ^ 2 ≤ (inner ℂ (trial k : X) (bridge.hamiltonian (trial k))).re := by
    have hS := finiteSectorFourierStates_sector bridge (trial k) (hMem k)
    obtain ⟨m, hCube⟩ := finiteSectorFourierStates_in_cube bridge hL (trial k) (hMem k)
    have hEventual : ∀ᶠ n in atTop,
        energy n * ‖trial k‖ ^ 2 ≤
          (inner ℂ (trial k : X) (bridge.hamiltonian (trial k))).re := by
      filter_upwards [hHorizon.eventually (eventually_ge_atTop m)] with n hn
      exact (hRitz n).1 (trial k) hS
        (continuum_sector_cubic_mono_integer bridge hL hn (trial k) hS hCube)
    exact le_of_tendsto_of_tendsto
      (hEnergy.mul tendsto_const_nhds) tendsto_const_nhds hEventual
  exact le_of_tendsto_of_tendsto
    (tendsto_const_nhds.mul (hTrial.norm.pow 2))
    (Complex.continuous_re.continuousAt.tendsto.comp (hTrial.inner hAction))
    (Filter.Eventually.of_forall hBounds)

end GroundBound

theorem coulombGalerkinGroundExhaustion_ground_bound (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (K E : ℝ) (exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E)
    (psi : molecularFourierH2Domain eta (2 * Real.pi / L))
    (hS : IsSectorCoeff sys.sign lab
      (fun p => (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) p)) :
    E * ‖psi‖ ^ 2 ≤
      (inner ℂ (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
        (molecularFourierDomainOperator (2 * Real.pi / L) H psi)).re := by
  let bridge := coulombFourierGalerkinBridge sys lab L hL H hKernel
  let horizon : ℕ → ℕ :=
    fun n => cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n
  have hHorizon : Tendsto horizon atTop atTop := by
    apply tendsto_atTop.mpr
    intro m
    filter_upwards [exhaustion.exhausts.eventually (eventually_ge_atTop m)] with n hn
    dsimp [horizon]
    omega
  have hRitz (n : ℕ) : IsContinuumSectorCubicGroundEnergy bridge
      ((2 * Real.pi / L) * (horizon n : ℝ)) (exhaustion.energy n) :=
    finite_ground_coeff_to_continuum_sector_full_cube bridge hL (horizon n)
      (exhaustion.energy n) (exhaustion.coeff n) (exhaustion.sector n)
      (exhaustion.normalized n) (exhaustion.eigen n) (exhaustion.ground n)
  exact continuum_sector_cubic_limit_ground_bound_of_graph_approximation bridge hL E
    horizon hHorizon exhaustion.energy hRitz exhaustion.converges psi
    (coulombFourierGalerkinBridge_graph_approximation sys L hL H hKernel psi hS)

theorem coulombGalerkinGroundExhaustion_hasGroundPair (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (K E : ℝ) (exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E)
    (psi : molecularFourierH2Domain eta (2 * Real.pi / L))
    (hS : IsSectorCoeff sys.sign lab
      (fun p => (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) p))
    (hNorm : ‖psi‖ = 1)
    (hEigen : molecularFourierDomainOperator (2 * Real.pi / L) H psi =
      (E : ℂ) • (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)) :
    HasContinuumSectorGroundPair (coulombFourierGalerkinBridge sys lab L hL H hKernel) psi E := by
  refine ⟨hS, hNorm, hEigen, ?_⟩
  intro u hu
  exact coulombGalerkinGroundExhaustion_ground_bound sys L hL H hKernel K E exhaustion u hu

theorem coulombGalerkinGroundExhaustion_exists_groundPair_of_h2_bound (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (L : ℝ) (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
    (K E : ℝ) (exhaustion : CoulombGalerkinGroundExhaustion sys lab L K E)
    (R : ℝ) (hR : 0 ≤ R)
    (hBound : ∀ n, fullH2Sq (finitePlaneWaveKabs (2 * Real.pi / L)
      (cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n))
        (exhaustion.coeff n) ≤ R ^ 2) :
    ∃ psi : molecularFourierH2Domain eta (2 * Real.pi / L),
      HasContinuumSectorGroundPair (coulombFourierGalerkinBridge sys lab L hL H hKernel) psi E ∧
      ‖(molecularFourierH2DomainEquiv eta (2 * Real.pi / L)).symm psi‖ ≤ R := by
  let horizon : ℕ → ℕ := fun n =>
    cutoffShellIndex K (2 * Real.pi / L) + exhaustion.basisExtra n
  let u : ℕ → MolecularFourierH2 eta := fun n =>
    finiteFourierH2Lift eta (2 * Real.pi / L) (horizon n) (exhaustion.coeff n)
  have hLiftBound (n : ℕ) : ‖u n‖ ≤ R :=
    finiteFourierH2Lift_norm_le eta (2 * Real.pi / L) (horizon n)
      (exhaustion.coeff n) R hR (hBound n)
  have hUnit (n : ℕ) : ‖molecularH2StateMap eta (2 * Real.pi / L) (u n)‖ = 1 := by
    rw [show u n = finiteFourierH2Lift eta (2 * Real.pi / L)
      (horizon n) (exhaustion.coeff n) from rfl,
      molecularH2StateMap_finiteFourierH2Lift,
      finiteFourierLpEmbed_norm_eq_fullCoeffVector]
    exact fullCoeffVector_norm_eq_one_of_mass (exhaustion.coeff n) (exhaustion.normalized n)
  have hSector (n : ℕ) : IsSectorCoeff sys.sign lab
      (fun p => molecularH2StateMap eta (2 * Real.pi / L) (u n) p) := by
    rw [show u n = finiteFourierH2Lift eta (2 * Real.pi / L)
      (horizon n) (exhaustion.coeff n) from rfl,
      molecularH2StateMap_finiteFourierH2Lift]
    exact (finiteFourierLpEmbed_isSector_iff sys.sign lab (horizon n)
      (exhaustion.coeff n)).mpr (exhaustion.sector n)
  have hg : 2 * Real.pi / L ≠ 0 := ne_of_gt (div_pos (mul_pos (by norm_num) Real.pi_pos) hL)
  obtain ⟨w, φ, hφ, hwBound, hwNorm, hwS, hLim⟩ :=
    molecularH2StateMap_exists_normalized_sector_subseq
      eta (2 * Real.pi / L) hg u R hLiftBound hUnit hSector
  let psi := molecularFourierH2DomainEquiv eta (2 * Real.pi / L) w
  have hPsi : (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) =
      molecularH2StateMap eta (2 * Real.pi / L) w := rfl
  have hPsiNorm : ‖psi‖ = 1 := hwNorm
  have hPsiS : IsSectorCoeff sys.sign lab
      (fun p => (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) p) := hwS
  have hHorizon : Tendsto horizon atTop atTop := by
    apply tendsto_atTop.mpr
    intro m
    filter_upwards [exhaustion.exhausts.eventually (eventually_ge_atTop m)] with n hn
    dsimp [horizon]
    omega
  have hState : Tendsto (fun n => finiteFourierLpEmbed eta (horizon (φ n))
      (exhaustion.coeff (φ n))) atTop
      (𝓝 (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)) := by
    simpa only [u, molecularH2StateMap_finiteFourierH2Lift, hPsi] using hLim
  have hEigen : molecularFourierDomainOperator (2 * Real.pi / L) H psi =
      (E : ℂ) • (psi : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :=
    coulombFourierDomainOperator_eigen_of_finite_eigen_limit sys L H hKernel
      (fun n => horizon (φ n)) (hHorizon.comp hφ.tendsto_atTop)
      (fun n => exhaustion.energy (φ n)) E
      (exhaustion.converges.comp hφ.tendsto_atTop)
      (fun n => exhaustion.coeff (φ n))
      (fun n => exhaustion.eigen (φ n)) psi hState
  refine ⟨psi, coulombGalerkinGroundExhaustion_hasGroundPair
    sys L hL H hKernel K E exhaustion psi hPsiS hPsiNorm hEigen, ?_⟩
  simpa only [psi, LinearEquiv.symm_apply_apply] using hwBound

/-- The completed Fourier Hamiltonian has a normalized ground pair in every sector of
an admissible labelling. -/
theorem exists_coulombFourierH2Operator_groundPair (sys : CoulombSystem eta ν)
    (lab : Fin eta → ℕ) (hlab : sys.IsAdmissible lab) (L Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ∃ H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
    ∃ hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
        fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q,
      (∀ u, ‖H u‖ ≤ ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) * ‖u‖) ∧
      ∃ E : ℝ, ∃ psi : molecularFourierH2Domain eta (2 * Real.pi / L),
        HasContinuumSectorGroundPair (coulombFourierGalerkinBridge sys lab L hL H hKernel)
          psi E := by
  obtain ⟨H, hKernel, hNorm⟩ := exists_coulombFourierH2Operator sys L Hunit hL hPeriodic
  obtain ⟨E, exhaustion, E0, hE0, _hAnti, _hExtra, hBound⟩ :=
    coulombGalerkinGroundExhaustion_exists_bounded sys lab hlab 0 L Hunit hL hPeriodic
  obtain ⟨psi, hPair, _hPsiBound⟩ :=
    coulombGalerkinGroundExhaustion_exists_groundPair_of_h2_bound sys L hL H hKernel 0 E
      exhaustion (finiteCoulombH2Constant sys E0 L Hunit)
      (finiteCoulombH2Constant_nonneg sys hE0 L Hunit) (fun n => (hBound n).2)
  exact ⟨H, hKernel, hNorm, E, psi, hPair⟩

/-! ## The cubic error theorem on the Fourier realization -/

section ErrorTheorems

variable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X]

/-- The continuum cubic estimate from graph approximation of a continuum ground state:
both the exhaustion and the cubic minimum are constructed. -/
theorem continuumCoulomb_cubic_error_of_graph_approximation (sys : CoulombSystem eta ν)
    {lab : Fin eta → ℕ} (hlab : sys.IsAdmissible lab)
    (D : Submodule ℂ X) (K E rho L Hunit Blow Cs Bker : ℝ)
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D)
    (psi : D) (hPair : HasContinuumSectorGroundPair bridge psi E)
    (hApprox : HasSectorFourierGraphApproximation bridge psi)
    (hL : 0 < L) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (hAbsorb : 4 * sys.maxMass * (|E| + 1) ≤ K ^ 2)
    (hLargeK : 32 * sys.massMoment 2 *
      (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
        (continuumCoulombH2Constant sys E L Hunit)) ^ 2 ≤ K ^ 5)
    (m : ℕ) (hm : 1 ≤ m) (hCutoff : K * L = 2 * Real.pi * (m : ℝ))
    (hEnough : eta ≤ (2 * m + 1) ^ 3) :
    ∃ EN : ℝ, IsContinuumSectorCubicGroundEnergy bridge K EN ∧
    (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
    0 ≤ EN - E ∧
    EN - E ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ∧
    continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ≤
      ((3 * L / (2 * Real.pi)) ^ 3 *
        continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker) /
        (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨exhaustion, _hDecreasing, _hExtra⟩ :=
    coulombGalerkinGroundExhaustion_exists_of_graph_approximation bridge hlab hL K psi E
      hPair hApprox
  obtain ⟨EN, hRitz⟩ := continuumCoulomb_exists_cubic_ritz_of_cutoff bridge hlab hL K m
    hCutoff hEnough
  refine ⟨EN, hRitz, ?_⟩
  exact continuumCoulomb_cubic_energy_bound_reciprocal sys D K E EN rho L Hunit Blow Cs Bker
    bridge psi hPair exhaustion hRitz hL hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
    hBkerScale hCsScale hPeriodic hAbsorb hLargeK m hm hCutoff

end ErrorTheorems

/-- The Fourier Hamiltonian of the Coulomb system, its ground pair in the sector of an
admissible labelling, and the cubic error bounds for every admissible cube. -/
theorem coulomb_fourier_cubic_error (sys : CoulombSystem eta ν) (lab : Fin eta → ℕ)
    (hlab : sys.IsAdmissible lab) (L Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ∃ H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
    ∃ hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
        fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q,
      (∀ u, ‖H u‖ ≤ ((1 / 2 : ℝ) + finiteCoulombPhysicalFormConstant sys L Hunit) * ‖u‖) ∧
      ∃ E : ℝ, ∃ psi : molecularFourierH2Domain eta (2 * Real.pi / L),
        HasContinuumSectorGroundPair (coulombFourierGalerkinBridge sys lab L hL H hKernel)
          psi E ∧
        ∀ K rho Blow Cs Bker : ℝ,
          1 ≤ K → 0 ≤ rho → rho ^ 2 * K = 1 →
          0 ≤ Blow → 0 ≤ Cs → 0 ≤ Bker →
          2 * (2 * Real.pi / L) ≤ K →
          54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L) →
          432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2 →
          1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2 →
          4 * sys.maxMass * (|E| + 1) ≤ K ^ 2 →
          32 * sys.massMoment 2 *
            (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
              (continuumCoulombH2Constant sys E L Hunit)) ^ 2 ≤ K ^ 5 →
          ∀ m : ℕ, 1 ≤ m → K * L = 2 * Real.pi * (m : ℝ) →
            eta ≤ (2 * m + 1) ^ 3 →
          ∃ EN : ℝ, IsContinuumSectorCubicGroundEnergy
            (coulombFourierGalerkinBridge sys lab L hL H hKernel) K EN ∧
            (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 ∧
            0 ≤ EN - E ∧
            EN - E ≤ continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ∧
            continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker / K ^ 3 ≤
              ((3 * L / (2 * Real.pi)) ^ 3 *
                continuumCoulombCubicConstant sys E L Hunit Blow Cs Bker) /
                (((2 * m + 1) ^ 3 : ℕ) : ℝ) := by
  obtain ⟨H, hKernel, hNorm, E, psi, hPair⟩ :=
    exists_coulombFourierH2Operator_groundPair sys lab hlab L Hunit hL hPeriodic
  refine ⟨H, hKernel, hNorm, E, psi, hPair, ?_⟩
  intro K rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK
    hAmplitude hBkerScale hCsScale hAbsorb hLargeK m hm hCutoff hEnough
  have hApprox := coulombFourierGalerkinBridge_graph_approximation sys L hL H hKernel psi hPair.1
  exact continuumCoulomb_cubic_error_of_graph_approximation sys hlab
    (molecularFourierH2Domain eta (2 * Real.pi / L)) K E rho L Hunit Blow Cs Bker
    (coulombFourierGalerkinBridge sys lab L hL H hKernel) psi hPair hApprox
    hL hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude hBkerScale hCsScale hPeriodic
    hAbsorb hLargeK m hm hCutoff hEnough

/-! ## Unitary transport of bridges -/

section Transport

variable {X Y : Type*}
variable [NormedAddCommGroup X] [InnerProductSpace ℂ X]
variable [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
variable {sys : CoulombSystem eta ν} {lab : Fin eta → ℕ} {L : ℝ} {D : Submodule ℂ X}

/-- Unitary transport of the operator, sector, cubic subspaces and embeddings. -/
def continuumCoulombGalerkinBridge_unitaryTransport
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (U : X ≃ₗᵢ[ℂ] Y) :
    ContinuumCoulombGalerkinBridge sys lab L Y (D.map U.toLinearEquiv.toLinearMap) where
  hamiltonian := U.toLinearEquiv.toLinearMap.comp
    (bridge.hamiltonian.comp (continuumDomainUnitaryEquiv U D).symm.toLinearEquiv.toLinearMap)
  sector := fun y => bridge.sector (U.symm y)
  cubic := fun K y => bridge.cubic K (U.symm y)
  embed := fun count =>
    (continuumDomainUnitaryEquiv U D).toLinearIsometry.comp (bridge.embed count)
  form_eq := by
    intro count u
    change (inner ℂ (U (bridge.embed count u : X))
      (U (bridge.hamiltonian ((continuumDomainUnitaryEquiv U D).symm
        (continuumDomainUnitaryEquiv U D (bridge.embed count u)))))).re = _
    rw [(continuumDomainUnitaryEquiv U D).symm_apply_apply, U.inner_map_map]
    exact bridge.form_eq count u
  sector_iff := by
    intro count u
    change bridge.sector (U.symm (U (bridge.embed count u : X))) ↔ _
    rw [U.symm_apply_apply]
    exact bridge.sector_iff count u
  cubic_iff := by
    intro K count u
    change bridge.cubic K (U.symm (U (bridge.embed count u : X))) ↔ _
    rw [U.symm_apply_apply]
    exact bridge.cubic_iff K count u
  cubic_lift := by
    intro K count m hCutoff hCount u hS hCube
    have hS' : bridge.sector (((continuumDomainUnitaryEquiv U D).symm u : D) : X) := by
      simpa only [continuumDomainUnitaryEquiv_symm_apply_coe] using hS
    have hCube' : bridge.cubic K (((continuumDomainUnitaryEquiv U D).symm u : D) : X) := by
      simpa only [continuumDomainUnitaryEquiv_symm_apply_coe] using hCube
    obtain ⟨v, hv⟩ := bridge.cubic_lift K count m hCutoff hCount
      ((continuumDomainUnitaryEquiv U D).symm u) hS' hCube'
    refine ⟨v, ?_⟩
    change continuumDomainUnitaryEquiv U D (bridge.embed count v) = u
    rw [hv, (continuumDomainUnitaryEquiv U D).apply_symm_apply]

@[simp] theorem continuumCoulombGalerkinBridge_unitaryTransport_hamiltonian
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (U : X ≃ₗᵢ[ℂ] Y) (u : D) :
    (continuumCoulombGalerkinBridge_unitaryTransport bridge U).hamiltonian
      (continuumDomainUnitaryEquiv U D u) = U (bridge.hamiltonian u) := by
  change U (bridge.hamiltonian ((continuumDomainUnitaryEquiv U D).symm
    (continuumDomainUnitaryEquiv U D u))) = _
  rw [(continuumDomainUnitaryEquiv U D).symm_apply_apply]

@[simp] theorem continuumCoulombGalerkinBridge_unitaryTransport_sector
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (U : X ≃ₗᵢ[ℂ] Y) (u : D) :
    (continuumCoulombGalerkinBridge_unitaryTransport bridge U).sector
      ((continuumDomainUnitaryEquiv U D u : D.map U.toLinearEquiv.toLinearMap) : Y) ↔
      bridge.sector (u : X) := by
  change bridge.sector (U.symm (U (u : X))) ↔ _
  rw [U.symm_apply_apply]

@[simp] theorem continuumCoulombGalerkinBridge_unitaryTransport_cubic
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (U : X ≃ₗᵢ[ℂ] Y) (K : ℝ) (u : D) :
    (continuumCoulombGalerkinBridge_unitaryTransport bridge U).cubic K
      ((continuumDomainUnitaryEquiv U D u : D.map U.toLinearEquiv.toLinearMap) : Y) ↔
      bridge.cubic K (u : X) := by
  change bridge.cubic K (U.symm (U (u : X))) ↔ _
  rw [U.symm_apply_apply]

@[simp] theorem continuumCoulombGalerkinBridge_unitaryTransport_form
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (U : X ≃ₗᵢ[ℂ] Y) (u v : D) :
    inner ℂ
      ((continuumDomainUnitaryEquiv U D u : D.map U.toLinearEquiv.toLinearMap) : Y)
      ((continuumCoulombGalerkinBridge_unitaryTransport bridge U).hamiltonian
        (continuumDomainUnitaryEquiv U D v)) =
      inner ℂ (u : X) (bridge.hamiltonian v) := by
  rw [continuumCoulombGalerkinBridge_unitaryTransport_hamiltonian,
    continuumDomainUnitaryEquiv_apply_coe, U.inner_map_map]

theorem hasContinuumSectorGroundPair_unitaryTransport_iff
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (U : X ≃ₗᵢ[ℂ] Y) (psi : D)
    (E : ℝ) :
    HasContinuumSectorGroundPair (continuumCoulombGalerkinBridge_unitaryTransport bridge U)
      (continuumDomainUnitaryEquiv U D psi) E ↔
      HasContinuumSectorGroundPair bridge psi E := by
  constructor
  · intro h
    refine ⟨(continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U psi).mp h.1,
      ?_, ?_, ?_⟩
    · simpa only [(continuumDomainUnitaryEquiv U D).norm_map] using h.2.1
    · apply U.injective
      rw [U.map_smul]
      simpa only [continuumCoulombGalerkinBridge_unitaryTransport_hamiltonian,
        continuumDomainUnitaryEquiv_apply_coe] using h.2.2.1
    · intro u hu
      have hLower := h.2.2.2 (continuumDomainUnitaryEquiv U D u)
        ((continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U u).mpr hu)
      simpa only [(continuumDomainUnitaryEquiv U D).norm_map,
        continuumCoulombGalerkinBridge_unitaryTransport_form] using hLower
  · intro h
    refine ⟨(continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U psi).mpr h.1,
      ?_, ?_, ?_⟩
    · simpa only [(continuumDomainUnitaryEquiv U D).norm_map] using h.2.1
    · rw [continuumCoulombGalerkinBridge_unitaryTransport_hamiltonian,
        continuumDomainUnitaryEquiv_apply_coe, h.2.2.1, U.map_smul]
    · intro v hv
      obtain ⟨u, rfl⟩ := (continuumDomainUnitaryEquiv U D).surjective v
      have hLower := h.2.2.2 u
        ((continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U u).mp hv)
      simpa only [(continuumDomainUnitaryEquiv U D).norm_map,
        continuumCoulombGalerkinBridge_unitaryTransport_form] using hLower

theorem isContinuumSectorCubicGroundEnergy_unitaryTransport_iff
    (bridge : ContinuumCoulombGalerkinBridge sys lab L X D) (U : X ≃ₗᵢ[ℂ] Y) (K EN : ℝ) :
    IsContinuumSectorCubicGroundEnergy
      (continuumCoulombGalerkinBridge_unitaryTransport bridge U) K EN ↔
      IsContinuumSectorCubicGroundEnergy bridge K EN := by
  constructor
  · intro h
    constructor
    · intro u hS hCube
      have hLower := h.1 (continuumDomainUnitaryEquiv U D u)
        ((continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U u).mpr hS)
        ((continuumCoulombGalerkinBridge_unitaryTransport_cubic bridge U K u).mpr hCube)
      simpa only [(continuumDomainUnitaryEquiv U D).norm_map,
        continuumCoulombGalerkinBridge_unitaryTransport_form] using hLower
    · obtain ⟨v, hS, hCube, hNorm, hForm⟩ := h.2
      obtain ⟨u, rfl⟩ := (continuumDomainUnitaryEquiv U D).surjective v
      refine ⟨u, (continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U u).mp hS,
        (continuumCoulombGalerkinBridge_unitaryTransport_cubic bridge U K u).mp hCube, ?_, ?_⟩
      · simpa only [(continuumDomainUnitaryEquiv U D).norm_map] using hNorm
      · simpa only [continuumCoulombGalerkinBridge_unitaryTransport_form] using hForm
  · intro h
    constructor
    · intro v hS hCube
      obtain ⟨u, rfl⟩ := (continuumDomainUnitaryEquiv U D).surjective v
      have hLower := h.1 u
        ((continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U u).mp hS)
        ((continuumCoulombGalerkinBridge_unitaryTransport_cubic bridge U K u).mp hCube)
      simpa only [(continuumDomainUnitaryEquiv U D).norm_map,
        continuumCoulombGalerkinBridge_unitaryTransport_form] using hLower
    · obtain ⟨u, hS, hCube, hNorm, hForm⟩ := h.2
      refine ⟨continuumDomainUnitaryEquiv U D u,
        (continuumCoulombGalerkinBridge_unitaryTransport_sector bridge U u).mpr hS,
        (continuumCoulombGalerkinBridge_unitaryTransport_cubic bridge U K u).mpr hCube, ?_, ?_⟩
      · simpa only [(continuumDomainUnitaryEquiv U D).norm_map] using hNorm
      · simpa only [continuumCoulombGalerkinBridge_unitaryTransport_form] using hForm

end Transport

end
end PlaneWaveCertificate

end ReleaseMilestone147b
