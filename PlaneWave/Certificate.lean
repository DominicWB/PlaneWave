section DevK4

/-!
# Capped kinetic symbols and capped smearing: `lem:capsmear`

For a register `r` and a cap `κ > 0`, the capped symbol `μ_κ = min(|k_r|², κ²)/(2 m_r)`
(`capKin`) satisfies `0 ≤ μ_κ ≤ A_r` and `A_r - μ_κ ≤ A_r 1_{|k_r| > κ}` (`capRest`, a kinetic
multiplier that vanishes on `|k_r| ≤ κ`).

* `expect_le_tails_of_vanish`: a kinetic multiplier that vanishes on `|k_r| ≤ κ` has expectation
  at most `‖1_{r,>κ} S u‖ ‖1_{r,>κ} T u‖` (the replacement term of `thm:mult-cap`).
* `expect_regKin_eq`: `⟨A_r⟩ = ⟨μ_κ⟩ + ⟨A_r - μ_κ⟩` on `H²` states.
* `capLift`: `μ_κ` on the `H²` coordinates (a bounded operator, `μ_κ ≤ κ²/2`), with
  `S (μ_κ u) = μ_κ S u` and `T (μ_κ u) = μ_κ T u`.
* `layer_capped`, `norm_capped_le` (`lem:capsmear`): if `‖1_{r,>λ} F‖ ≤ D λ^{-1/2}` for all
  thresholds `λ₀ ≤ λ < κ` (`λ₀ ≥ 1`), then `‖μ F‖ ≤ ½ (λ₀² ‖F‖ + √15 D κ^{3/2})` for every
  `μ ≤ ½ min(|k_r|², κ²)`; with `F = (1 + A) û`, `Θ(μ_κ v) ≤ ½ (λ₀² Θ(v) + √15 D κ^{3/2})`
  (`norm_theta_capLift_le`, DevK5). The layer cake runs over the thresholds `λ₀ + k`,
  `k < ⌈κ - λ₀⌉` (`min(x, κ)⁴ ≤ λ₀⁴ + Σ_k ((λ₀+k+1)⁴ - (λ₀+k)⁴) 1_{x > λ₀+k}`), instead of
  dyadic shells.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set Finset

namespace PlaneWaveKinetic

open PlaneWaveCertificate PlaneWaveDynamics

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-! ## Capped symbols -/

section Capped

variable (sys : CoulombSystem eta ν) (g : ℝ)

/-- The capped kinetic symbol of particle `r`: `min(|k_r|², κ²)/(2 m_r)` at `k = g p`. -/
noncomputable def capSymbol (r : Fin eta) (κ : ℝ) (p : FourierConfig eta Lattice3) : ℝ :=
  (1 / 2 : ℝ) * (min (g ^ 2 * latticeNormSq (p r)) (κ ^ 2) / sys.mass r)

omit [Fintype ν] in
lemma capSymbol_nonneg (r : Fin eta) (κ : ℝ) (p : FourierConfig eta Lattice3) :
    0 ≤ capSymbol sys g r κ p := by
  unfold capSymbol
  have := sys.mass_pos r
  have := latticeNormSq_nonneg (p r)
  have : 0 ≤ min (g ^ 2 * latticeNormSq (p r)) (κ ^ 2) := le_min (by positivity) (sq_nonneg κ)
  positivity

omit [Fintype ν] in
lemma capSymbol_le_reg (r : Fin eta) (κ : ℝ) (p : FourierConfig eta Lattice3) :
    capSymbol sys g r κ p ≤ regSymbol sys g r p := by
  unfold capSymbol regSymbol
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  exact div_le_div_of_nonneg_right (min_le_left _ _) (sys.mass_pos r).le

omit [Fintype ν] in
lemma capSymbol_le_half (r : Fin eta) (κ : ℝ) (p : FourierConfig eta Lattice3) :
    capSymbol sys g r κ p ≤ (1 / 2 : ℝ) * min (g ^ 2 * latticeNormSq (p r)) (κ ^ 2) := by
  unfold capSymbol
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  have hm := sys.one_le_mass r
  have h0 : 0 ≤ min (g ^ 2 * latticeNormSq (p r)) (κ ^ 2) :=
    le_min (mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg _)) (sq_nonneg κ)
  exact div_le_self h0 hm

omit [Fintype ν] in
/-- On `|k_r| ≤ κ` the cap is inactive. -/
lemma capSymbol_eq_of_le (r : Fin eta) (κ : ℝ) (hg : 0 ≤ g) (p : FourierConfig eta Lattice3)
    (hp : ¬ κ < g * Real.sqrt (latticeNormSq (p r))) :
    capSymbol sys g r κ p = regSymbol sys g r p := by
  unfold capSymbol regSymbol
  congr 2
  apply min_eq_left
  push Not at hp
  have h0 : 0 ≤ g * Real.sqrt (latticeNormSq (p r)) := mul_nonneg hg (Real.sqrt_nonneg _)
  calc g ^ 2 * latticeNormSq (p r) = (g * Real.sqrt (latticeNormSq (p r))) ^ 2 := by
        rw [mul_pow, Real.sq_sqrt (latticeNormSq_nonneg _)]
    _ ≤ κ ^ 2 := pow_le_pow_left₀ h0 hp 2

omit [Fintype ν] in
/-- The cap in terms of the momentum `x = g |p_r|`: `μ_κ ≤ ½ min(x, κ)²`. -/
lemma capSymbol_le_min_sq (r : Fin eta) {κ : ℝ} (hκ : 0 ≤ κ) (hg : 0 ≤ g)
    (p : FourierConfig eta Lattice3) :
    capSymbol sys g r κ p ≤ (1 / 2 : ℝ) * min (g * Real.sqrt (latticeNormSq (p r))) κ ^ 2 := by
  refine (capSymbol_le_half sys g r κ p).trans (le_of_eq ?_)
  congr 1
  have h0 : 0 ≤ g * Real.sqrt (latticeNormSq (p r)) := mul_nonneg hg (Real.sqrt_nonneg _)
  have e : g ^ 2 * latticeNormSq (p r) = (g * Real.sqrt (latticeNormSq (p r))) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (latticeNormSq_nonneg _)]
  rw [e]
  rcases le_total (g * Real.sqrt (latticeNormSq (p r))) κ with h | h
  · rw [min_eq_left h, min_eq_left (pow_le_pow_left₀ h0 h 2)]
  · rw [min_eq_right h, min_eq_right (pow_le_pow_left₀ hκ h 2)]

/-- `μ_κ` as a kinetic multiplier. -/
noncomputable def capKin (r : Fin eta) (κ : ℝ) : KinMult sys g where
  μ := capSymbol sys g r κ
  nonneg := capSymbol_nonneg sys g r κ
  le_kin p := (capSymbol_le_reg sys g r κ p).trans (regSymbol_le_kin sys g r p)

/-- `A_r - μ_κ` as a kinetic multiplier. -/
noncomputable def capRest (r : Fin eta) (κ : ℝ) : KinMult sys g where
  μ p := regSymbol sys g r p - capSymbol sys g r κ p
  nonneg p := sub_nonneg.mpr (capSymbol_le_reg sys g r κ p)
  le_kin p := by
    have := capSymbol_nonneg sys g r κ p
    have := regSymbol_le_kin sys g r p
    linarith

omit [Fintype ν] in
/-- `A_r - μ_κ` vanishes on `|k_r| ≤ κ`. -/
lemma capRest_vanish (r : Fin eta) (κ : ℝ) (hg : 0 ≤ g) (p : FourierConfig eta Lattice3)
    (hp : ¬ κ < g * Real.sqrt (latticeNormSq (p r))) : (capRest sys g r κ).μ p = 0 := by
  change regSymbol sys g r p - capSymbol sys g r κ p = 0
  rw [capSymbol_eq_of_le sys g r κ hg p hp, sub_self]

omit [Fintype ν] in
/-- `⟨A_r⟩ = ⟨μ_κ⟩ + ⟨A_r - μ_κ⟩` on `H²` states. -/
lemma expect_regKin_eq (r : Fin eta) (κ : ℝ) (u : MolecularFourierH2 eta) :
    (regKin sys g r).expect (molecularH2StateMap eta g u) =
      (capKin sys g r κ).expect (molecularH2StateMap eta g u) +
        (capRest sys g r κ).expect (molecularH2StateMap eta g u) := by
  apply Complex.ofReal_injective
  push_cast
  rw [← KinMult.inner_stateMap_h2_self, ← KinMult.inner_stateMap_h2_self,
    ← KinMult.inner_stateMap_h2_self, ← inner_add_right]
  congr 1
  ext p
  rw [lp.coeFn_add, Pi.add_apply, KinMult.h2_apply, KinMult.h2_apply, KinMult.h2_apply]
  change (regSymbol sys g r p : ℂ) * _ = (capSymbol sys g r κ p : ℂ) * _ +
    ((regSymbol sys g r p - capSymbol sys g r κ p : ℝ) : ℂ) * _
  push_cast
  ring

end Capped

/-! ## The replacement term -/

section Replacement

omit [Fintype ν] in
lemma inner_tailMask_right (g K : ℝ) (r : Fin eta)
    (x y : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ⟪x, tailMask g K r y⟫_ℂ = ⟪tailMask g K r x, tailMask g K r y⟫_ℂ := by
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
  refine tsum_congr fun p => ?_
  rw [tailMask_apply, tailMask_apply]
  split_ifs <;> simp

omit [Fintype ν] in
/-- **The replacement term.** A kinetic multiplier that vanishes on `|k_r| ≤ κ` has expectation
at most `‖1_{r,>κ} S u‖ ‖1_{r,>κ} T u‖`. -/
lemma KinMult.expect_le_tails_of_vanish {sys : CoulombSystem eta ν} {g : ℝ} (m : KinMult sys g)
    (r : Fin eta) (κ : ℝ)
    (hvan : ∀ p, ¬ κ < g * Real.sqrt (latticeNormSq (p r)) → m.μ p = 0)
    (u : MolecularFourierH2 eta) :
    m.expect (molecularH2StateMap eta g u) ≤
      ‖tailMask g κ r (molecularH2StateMap eta g u)‖ *
        ‖tailMask g κ r (coulombFourierKineticH2 sys g u)‖ := by
  have hmask : tailMask g κ r (m.h2 u) = m.h2 u := by
    ext p
    rw [tailMask_apply]
    split_ifs with hp
    · rw [one_mul]
    · rw [KinMult.h2_apply, hvan p hp]
      simp
  have hT : ‖tailMask g κ r (m.h2 u)‖ ≤ ‖tailMask g κ r (coulombFourierKineticH2 sys g u)‖ := by
    have h := l2_norm_le_of_le (tailMask g κ r (m.h2 u))
      (tailMask g κ r (coulombFourierKineticH2 sys g u)) zero_le_one (fun p => by
        rw [tailMask_apply, tailMask_apply, KinMult.h2_apply, coulombFourierKineticH2_apply,
          one_mul]
        split_ifs
        · rw [one_mul, one_mul, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
            Real.norm_of_nonneg (m.nonneg p),
            Real.norm_of_nonneg (coulombKineticEnergySymbol_nonneg sys g p)]
          exact mul_le_mul_of_nonneg_right (m.le_kin p) (norm_nonneg _)
        · simp)
    rwa [one_mul] at h
  have h1 : (m.expect (molecularH2StateMap eta g u) : ℂ) =
      ⟪tailMask g κ r (molecularH2StateMap eta g u), tailMask g κ r (m.h2 u)⟫_ℂ := by
    rw [← m.inner_stateMap_h2_self, ← inner_tailMask_right, hmask]
  have h2 := norm_inner_le_norm (𝕜 := ℂ) (tailMask g κ r (molecularH2StateMap eta g u))
    (tailMask g κ r (m.h2 u))
  rw [← h1, Complex.norm_real, Real.norm_of_nonneg (m.expect_nonneg _)] at h2
  exact h2.trans (mul_le_mul_of_nonneg_left hT (norm_nonneg _))

end Replacement

/-! ## The capped state on the `H²` coordinates -/

section CapLift

variable (sys : CoulombSystem eta ν) (g : ℝ)

omit [Fintype ν] in
lemma norm_capSymbol_le (r : Fin eta) (κ : ℝ) (p : FourierConfig eta Lattice3) :
    ‖(capSymbol sys g r κ p : ℂ)‖ ≤ κ ^ 2 / 2 := by
  rw [Complex.norm_real, Real.norm_of_nonneg (capSymbol_nonneg sys g r κ p)]
  refine (capSymbol_le_half sys g r κ p).trans ?_
  have := min_le_right (g ^ 2 * latticeNormSq (p r)) (κ ^ 2)
  linarith

/-- `μ_κ` on the `H²` coordinates (bounded by `κ²/2`): the `H²` coordinates of the capped
state `μ_κ v`. -/
noncomputable def capLift (r : Fin eta) (κ : ℝ) :
    MolecularFourierH2 eta →L[ℂ] MolecularFourierH2 eta :=
  diagCLM (fun p => (capSymbol sys g r κ p : ℂ)) (κ ^ 2 / 2) (by positivity)
    (norm_capSymbol_le sys g r κ)

omit [Fintype ν] in
lemma coeff_capLift (r : Fin eta) (κ : ℝ) (u : MolecularFourierH2 eta)
    (p : FourierConfig eta Lattice3) :
    molecularH2Coeff g (capLift sys g r κ u) p =
      (capSymbol sys g r κ p : ℂ) * molecularH2Coeff g u p := by
  unfold molecularH2Coeff
  rw [capLift, diagCLM_apply]
  ring

omit [Fintype ν] in
/-- `S (μ_κ u) = μ_κ S u`. -/
lemma stateMap_capLift (r : Fin eta) (κ : ℝ) (u : MolecularFourierH2 eta) :
    molecularH2StateMap eta g (capLift sys g r κ u) = (capKin sys g r κ).h2 u := by
  ext p
  rw [molecularH2StateMap_apply, coeff_capLift, KinMult.h2_apply]
  rfl

omit [Fintype ν] in
/-- `(1 + A)(μ_κ u) = μ_κ (1 + A) u`, coefficientwise. -/
lemma theta_vec_capLift (r : Fin eta) (κ : ℝ) (u : MolecularFourierH2 eta)
    (p : FourierConfig eta Lattice3) :
    (molecularH2StateMap eta g (capLift sys g r κ u) +
        coulombFourierKineticH2 sys g (capLift sys g r κ u)) p =
      (capSymbol sys g r κ p : ℂ) *
        (molecularH2StateMap eta g u + coulombFourierKineticH2 sys g u) p := by
  rw [lp.coeFn_add, lp.coeFn_add, Pi.add_apply, Pi.add_apply, molecularH2StateMap_apply,
    molecularH2StateMap_apply, coulombFourierKineticH2_apply, coulombFourierKineticH2_apply,
    coeff_capLift]
  ring

omit [Fintype ν] in
/-- `‖T (μ_κ u)‖ ≤ ‖(1 + A)(μ_κ u)‖`. -/
lemma norm_kinetic_le_theta (u : MolecularFourierH2 eta) :
    ‖coulombFourierKineticH2 sys g u‖ ≤
      ‖molecularH2StateMap eta g u + coulombFourierKineticH2 sys g u‖ := by
  have h := l2_norm_le_of_le (coulombFourierKineticH2 sys g u)
    (molecularH2StateMap eta g u + coulombFourierKineticH2 sys g u) zero_le_one (fun p => by
      rw [one_mul, lp.coeFn_add, Pi.add_apply, molecularH2StateMap_apply,
        coulombFourierKineticH2_apply]
      have hk := coulombKineticEnergySymbol_nonneg sys g p
      have e : molecularH2Coeff g u p + (coulombKineticEnergySymbol sys g p : ℂ) *
          molecularH2Coeff g u p =
          ((1 + coulombKineticEnergySymbol sys g p : ℝ) : ℂ) * molecularH2Coeff g u p := by
        push_cast
        ring
      rw [e, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_of_nonneg hk,
        Real.norm_of_nonneg (by linarith)]
      exact mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _))
  rwa [one_mul] at h

end CapLift

/-! ## Capped smearing (`lem:capsmear`) -/

section CapSmear

/-- **Layer cake.** For `x ≥ 0` and `1 ≤ λ₀ ≤ κ`,
`min(x, κ)⁴ ≤ λ₀⁴ + Σ_{k < ⌈κ - λ₀⌉} ((λ₀+k+1)⁴ - (λ₀+k)⁴) 1_{x > λ₀+k}`. -/
lemma layer_capped {x lam0 κ : ℝ} (hx : 0 ≤ x) (hl : 1 ≤ lam0) (hlk : lam0 ≤ κ) :
    min x κ ^ 4 ≤ lam0 ^ 4 + ∑ k ∈ range ⌈κ - lam0⌉₊,
      if lam0 + k < x then ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) else 0 := by
  set N := ⌈κ - lam0⌉₊
  set j := min N ⌈x - lam0⌉₊ with hj
  have hfilter : (range N).filter (fun k : ℕ => lam0 + k < x) = range j := by
    ext k
    simp only [Finset.mem_filter, Finset.mem_range, hj, lt_min_iff]
    constructor
    · rintro ⟨hk, hx'⟩
      exact ⟨hk, Nat.lt_ceil.mpr (by linarith)⟩
    · rintro ⟨hk, hk'⟩
      have := Nat.lt_ceil.mp hk'
      exact ⟨hk, by linarith⟩
  rw [← sum_filter, hfilter]
  have e : ∑ k ∈ range j, ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) = (lam0 + j) ^ 4 - lam0 ^ 4 := by
    have h := Finset.sum_range_sub (fun k : ℕ => (lam0 + k) ^ 4) j
    simp only [Nat.cast_add, Nat.cast_one, Nat.cast_zero, add_zero] at h
    rw [← h]
    refine sum_congr rfl fun k _ => ?_
    ring
  rw [e]
  have hmin : min x κ ≤ lam0 + j := by
    rcases le_total N ⌈x - lam0⌉₊ with h | h
    · have hjN : j = N := min_eq_left h
      rw [hjN]
      have := Nat.le_ceil (κ - lam0)
      exact (min_le_right _ _).trans (by linarith)
    · have hjc : j = ⌈x - lam0⌉₊ := min_eq_right h
      rw [hjc]
      have := Nat.le_ceil (x - lam0)
      exact (min_le_left _ _).trans (by linarith)
  have h0 : 0 ≤ min x κ := le_min hx (by linarith)
  have := pow_le_pow_left₀ h0 hmin 4
  linarith

omit [Fintype ν] in
/-- The squared layer bound: if `‖G_p‖ ≤ ½ min(x_p, κ)² ‖F_p‖` with `x_p = g |p_r|`, then
`‖G‖² ≤ ¼ (λ₀⁴ ‖F‖² + Σ_k ((λ₀+k+1)⁴ - (λ₀+k)⁴) ‖1_{r,>λ₀+k} F‖²)`. -/
lemma norm_capped_sq_le (g : ℝ) (hg : 0 ≤ g) (r : Fin eta)
    (F G : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) {lam0 κ : ℝ} (hl : 1 ≤ lam0)
    (hlk : lam0 ≤ κ)
    (hG : ∀ p, ‖G p‖ ≤ (1 / 2 : ℝ) * min (g * Real.sqrt (latticeNormSq (p r))) κ ^ 2 * ‖F p‖) :
    ‖G‖ ^ 2 ≤ (1 / 4 : ℝ) * (lam0 ^ 4 * ‖F‖ ^ 2 + ∑ k ∈ range ⌈κ - lam0⌉₊,
      ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) * ‖tailMask g (lam0 + k) r F‖ ^ 2) := by
  classical
  set N := ⌈κ - lam0⌉₊
  have hpt : ∀ p, ‖G p‖ ^ 2 ≤ (1 / 4 : ℝ) * (lam0 ^ 4 * ‖F p‖ ^ 2 + ∑ k ∈ range N,
      ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) * ‖tailMask g (lam0 + k) r F p‖ ^ 2) := by
    intro p
    set x := g * Real.sqrt (latticeNormSq (p r))
    have hx : 0 ≤ x := mul_nonneg hg (Real.sqrt_nonneg _)
    have hl' := layer_capped hx hl hlk
    have h1 : ‖G p‖ ^ 2 ≤ (1 / 4 : ℝ) * (min x κ ^ 4 * ‖F p‖ ^ 2) := by
      have h := hG p
      have h0 : 0 ≤ ‖G p‖ := norm_nonneg _
      calc ‖G p‖ ^ 2 ≤ ((1 / 2 : ℝ) * min x κ ^ 2 * ‖F p‖) ^ 2 := pow_le_pow_left₀ h0 h 2
        _ = (1 / 4 : ℝ) * (min x κ ^ 4 * ‖F p‖ ^ 2) := by ring
    refine h1.trans (mul_le_mul_of_nonneg_left ?_ (by norm_num))
    have h2 : min x κ ^ 4 * ‖F p‖ ^ 2 ≤ (lam0 ^ 4 + ∑ k ∈ range N,
        if lam0 + k < x then ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) else 0) * ‖F p‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hl' (sq_nonneg _)
    refine h2.trans (le_of_eq ?_)
    rw [add_mul, Finset.sum_mul]
    congr 1
    refine sum_congr rfl fun k _ => ?_
    rw [tailMask_apply]
    split_ifs <;> simp
  rw [l2_norm_sq, l2_norm_sq]
  have hsum : ∀ k ∈ range N, Summable fun p =>
      ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) * ‖tailMask g (lam0 + k) r F p‖ ^ 2 :=
    fun k _ => (l2_summable_sq _).mul_left _
  have hS : Summable fun p => (1 / 4 : ℝ) * (lam0 ^ 4 * ‖F p‖ ^ 2 + ∑ k ∈ range N,
      ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) * ‖tailMask g (lam0 + k) r F p‖ ^ 2) :=
    (((l2_summable_sq F).mul_left _).add (summable_sum hsum)).mul_left _
  calc ∑' p, ‖G p‖ ^ 2 ≤ ∑' p, (1 / 4 : ℝ) * (lam0 ^ 4 * ‖F p‖ ^ 2 + ∑ k ∈ range N,
        ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) * ‖tailMask g (lam0 + k) r F p‖ ^ 2) :=
        (l2_summable_sq G).tsum_le_tsum hpt hS
    _ = (1 / 4 : ℝ) * (lam0 ^ 4 * ∑' p, ‖F p‖ ^ 2 + ∑ k ∈ range N,
        ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) * ‖tailMask g (lam0 + k) r F‖ ^ 2) := by
        rw [tsum_mul_left, Summable.tsum_add ((l2_summable_sq F).mul_left _) (summable_sum hsum),
          tsum_mul_left, Summable.tsum_finsetSum hsum]
        congr 2
        refine sum_congr rfl fun k _ => ?_
        rw [tsum_mul_left, l2_norm_sq]

lemma layer_weight_le {lam : ℝ} (hl : 1 ≤ lam) : (lam + 1) ^ 4 - lam ^ 4 ≤ 15 * lam ^ 3 := by
  have h1 : lam ≤ lam ^ 2 := by nlinarith
  have h2 : lam ^ 2 ≤ lam ^ 3 := by nlinarith
  have h3 : 1 ≤ lam ^ 3 := by nlinarith
  nlinarith

omit [Fintype ν] in
/-- **Capped smearing** (`lem:capsmear`, abstract form). If `‖1_{r,>λ} F‖ ≤ D λ^{-1/2}` for all
thresholds `λ₀ ≤ λ < κ` (`1 ≤ λ₀ ≤ κ`) and `‖G_p‖ ≤ ½ min(g |p_r|, κ)² ‖F_p‖`, then
`‖G‖ ≤ ½ (λ₀² ‖F‖ + √15 D κ^{3/2})`. -/
theorem norm_capped_le (g : ℝ) (hg : 0 ≤ g) (r : Fin eta)
    (F G : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) {lam0 κ D : ℝ} (hl : 1 ≤ lam0)
    (hlk : lam0 ≤ κ) (hD : 0 ≤ D)
    (hG : ∀ p, ‖G p‖ ≤ (1 / 2 : ℝ) * min (g * Real.sqrt (latticeNormSq (p r))) κ ^ 2 * ‖F p‖)
    (htail : ∀ lam, lam0 ≤ lam → lam < κ → ‖tailMask g lam r F‖ ≤ D * Real.sqrt (1 / lam)) :
    ‖G‖ ≤ (1 / 2 : ℝ) * (lam0 ^ 2 * ‖F‖ + Real.sqrt 15 * D * (κ * Real.sqrt κ)) := by
  have h := norm_capped_sq_le g hg r F G hl hlk hG
  set N := ⌈κ - lam0⌉₊
  have hκ1 : 1 ≤ κ := hl.trans hlk
  have hterm : ∀ k ∈ range N, ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) *
      ‖tailMask g (lam0 + k) r F‖ ^ 2 ≤ 15 * D ^ 2 * κ ^ 2 := by
    intro k hk
    have hkN : (k : ℝ) < κ - lam0 := Nat.lt_ceil.mp (mem_range.mp hk)
    have hlam1 : 1 ≤ lam0 + k := by have := Nat.cast_nonneg (α := ℝ) k; linarith
    have hlamκ : lam0 + k < κ := by linarith
    have ht := htail (lam0 + k) (by have := Nat.cast_nonneg (α := ℝ) k; linarith) hlamκ
    have hlampos : 0 < lam0 + k := by linarith
    have ht2 : ‖tailMask g (lam0 + k) r F‖ ^ 2 ≤ D ^ 2 / (lam0 + k) := by
      have h0 := norm_nonneg (tailMask g (lam0 + k) r F)
      calc ‖tailMask g (lam0 + k) r F‖ ^ 2 ≤ (D * Real.sqrt (1 / (lam0 + k))) ^ 2 :=
            pow_le_pow_left₀ h0 ht 2
        _ = D ^ 2 / (lam0 + k) := by
            rw [mul_pow, Real.sq_sqrt (by positivity)]
            ring
    have hw := layer_weight_le hlam1
    have hw0 : 0 ≤ (lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4 := by
      have : (lam0 + k) ^ 4 ≤ (lam0 + k + 1) ^ 4 := pow_le_pow_left₀ hlampos.le (by linarith) 4
      linarith
    calc ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) * ‖tailMask g (lam0 + k) r F‖ ^ 2
        ≤ (15 * (lam0 + k) ^ 3) * (D ^ 2 / (lam0 + k)) :=
          mul_le_mul hw ht2 (sq_nonneg _) (by positivity)
      _ = 15 * D ^ 2 * (lam0 + k) ^ 2 := by field_simp
      _ ≤ 15 * D ^ 2 * κ ^ 2 :=
          mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hlampos.le hlamκ.le 2) (by positivity)
  have hN : (N : ℝ) ≤ κ := by
    have := Nat.ceil_lt_add_one (by linarith : (0 : ℝ) ≤ κ - lam0)
    linarith
  have hsumle : ∑ k ∈ range N, ((lam0 + k + 1) ^ 4 - (lam0 + k) ^ 4) *
      ‖tailMask g (lam0 + k) r F‖ ^ 2 ≤ 15 * D ^ 2 * κ ^ 3 := by
    calc _ ≤ ∑ _k ∈ range N, 15 * D ^ 2 * κ ^ 2 := sum_le_sum hterm
      _ = N * (15 * D ^ 2 * κ ^ 2) := by rw [sum_const, card_range, nsmul_eq_mul]
      _ ≤ κ * (15 * D ^ 2 * κ ^ 2) := mul_le_mul_of_nonneg_right hN (by positivity)
      _ = 15 * D ^ 2 * κ ^ 3 := by ring
  have hsq : ‖G‖ ^ 2 ≤
      ((1 / 2 : ℝ) * (lam0 ^ 2 * ‖F‖ + Real.sqrt 15 * D * (κ * Real.sqrt κ))) ^ 2 := by
    refine h.trans ?_
    have hs15 : Real.sqrt 15 ^ 2 = 15 := Real.sq_sqrt (by norm_num)
    have hsκ : Real.sqrt κ ^ 2 = κ := Real.sq_sqrt (by linarith)
    have hcross : 0 ≤ lam0 ^ 2 * ‖F‖ * (Real.sqrt 15 * D * (κ * Real.sqrt κ)) := by positivity
    have e : (Real.sqrt 15 * D * (κ * Real.sqrt κ)) ^ 2 = 15 * D ^ 2 * κ ^ 3 := by
      rw [mul_pow, mul_pow, mul_pow, hs15, hsκ]
      ring
    nlinarith [hsumle, e, hcross]
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hsq

end CapSmear

