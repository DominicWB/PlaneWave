section DevK1

/-!
# Kinetic-energy observables: Fourier multipliers and `lem:mult-basic`

The kinetic energy of particle `r`, `A_r = -Δ_r/(2 m_r)`, is the Fourier multiplier with symbol
`|k_r|²/(2 m_r)` (`k = g p`, `g = 2π/L`). We treat every real multiplier `μ` with `0 ≤ μ ≤ A`,
`A` the total kinetic symbol (`KinMult`); `A_r` (`regKin`) and, later, its caps are instances.
The expectation of `μ` in a state with Fourier coefficients `x` is
`⟨x, μ x⟩ = Σ_p μ(p) |x_p|²` (`KinMult.expect`), and in a position-space state `ψ` it is that of
its Fourier coefficients (`KinMult.posExpect`).

* `KinMult.h2`: `μ` from the `H²` coordinates to `ℓ²`, with `‖μ u‖ ≤ ‖T u‖` (`norm_h2_le`,
  `lem:mult-basic` (ii)), symmetry (`inner_stateMap_h2`), commutation with the cube projection
  (`h2_truncate`), and `⟨S u, μ u⟩ = Σ_p μ(p) |c_p|²` (`inner_stateMap_h2_self`).
* `expect_split`, `expect_tail_nonneg`, `expect_tail_le` (`lem:mult-basic` (i)): with
  `δ = (1 - P) ψ`, `⟨ψ, μ ψ⟩ - ⟨P ψ, μ P ψ⟩ = ⟨δ, μ δ⟩ ∈ [0, ‖δ‖ ‖(1 - P) T u‖]`; the cross terms
  vanish exactly, and the truncation undercounts.
* `regKin`, `sum_expect_regKin`: the kinetic energies of the particles add up to the kinetic energy
  of the certificate.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveKinetic

open PlaneWaveCertificate PlaneWaveDynamics

variable {eta : ℕ} {ν : Type} [Fintype ν]

lemma conj_mul_ofReal_mul (c : ℂ) (a : ℝ) :
    (starRingEnd ℂ) c * ((a : ℂ) * c) = ((a * ‖c‖ ^ 2 : ℝ) : ℂ) := by
  rw [Complex.sq_norm, Complex.normSq_apply]
  apply Complex.ext <;> simp <;> ring

/-- A **kinetic multiplier**: a real Fourier multiplier `μ` with `0 ≤ μ ≤ A`, `A` the total
kinetic symbol of the system at `g`. The symbol may depend on all the momenta. This class is
narrower than the `0 ≤ μ ≤ c_μ (1 + A)` of `lem:mult-basic` (it excludes `μ(0) > 0`); it contains
the kinetic energies `A_r` and their caps, which is all the appendix uses. -/
structure KinMult (sys : CoulombSystem eta ν) (g : ℝ) where
  /-- The symbol. -/
  μ : FourierConfig eta Lattice3 → ℝ
  nonneg : ∀ p, 0 ≤ μ p
  le_kin : ∀ p, μ p ≤ coulombKineticEnergySymbol sys g p

namespace KinMult

variable {sys : CoulombSystem eta ν} {g : ℝ} (m : KinMult sys g)

omit [Fintype ν] in
lemma ratio_norm_le_one (p : FourierConfig eta Lattice3) :
    ‖((m.μ p / molecularFourierH2Weight eta g p : ℝ) : ℂ)‖ ≤ 1 := by
  have hw := molecularFourierH2Weight_pos eta g p
  have h := coulombKinetic_ratio_norm_le_one sys g p
  rw [Complex.norm_of_nonneg (div_nonneg (m.nonneg p) hw.le)]
  rw [Complex.norm_of_nonneg (div_nonneg (coulombKineticEnergySymbol_nonneg sys g p) hw.le)] at h
  exact (div_le_div_of_nonneg_right (m.le_kin p) hw.le).trans h

/-- `μ` on the `H²` coordinates. -/
noncomputable def h2 :
    MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  lp2DiagonalCLM (fun p => ((m.μ p / molecularFourierH2Weight eta g p : ℝ) : ℂ))
    m.ratio_norm_le_one

omit [Fintype ν] in
@[simp] lemma h2_apply (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    m.h2 u p = (m.μ p : ℂ) * molecularH2Coeff g u p := by
  rw [h2, lp2DiagonalCLM_apply]
  unfold molecularH2Coeff
  push_cast
  ring

omit [Fintype ν] in
/-- `‖μ u‖ ≤ ‖T u‖` (`lem:mult-basic` (ii)). -/
lemma norm_h2_le (u : MolecularFourierH2 eta) :
    ‖m.h2 u‖ ≤ ‖coulombFourierKineticH2 sys g u‖ := by
  have h := l2_norm_le_of_le (m.h2 u) (coulombFourierKineticH2 sys g u) zero_le_one (fun p => by
    rw [h2_apply, coulombFourierKineticH2_apply, one_mul, norm_mul, norm_mul, Complex.norm_real,
      Complex.norm_real, Real.norm_of_nonneg (m.nonneg p),
      Real.norm_of_nonneg (coulombKineticEnergySymbol_nonneg sys g p)]
    exact mul_le_mul_of_nonneg_right (m.le_kin p) (norm_nonneg _))
  rwa [one_mul] at h

omit [Fintype ν] in
/-- Symmetry: `⟪S u, μ u'⟫ = ⟪μ u, S u'⟫`. -/
lemma inner_stateMap_h2 (u u' : MolecularFourierH2 eta) :
    ⟪molecularH2StateMap eta g u, m.h2 u'⟫_ℂ = ⟪m.h2 u, molecularH2StateMap eta g u'⟫_ℂ := by
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
  refine tsum_congr fun p => ?_
  rw [molecularH2StateMap_apply, molecularH2StateMap_apply, h2_apply, h2_apply]
  simp only [RCLike.inner_apply, map_mul, Complex.conj_ofReal]
  ring

omit [Fintype ν] in
/-- `μ` commutes with the cube projection. -/
lemma h2_truncate (n : ℕ) (u : MolecularFourierH2 eta) :
    m.h2 (molecularH2Truncate n u) = molecularH2Truncate n (m.h2 u) := by
  classical
  ext p
  rw [h2_apply, molecularH2Coeff_truncate, molecularH2Truncate_apply]
  by_cases hp : p ∈ fourierConfigCube eta n
  · rw [cubicLatticeCoeffTruncate_eq_of_mem n _ p hp, cubicLatticeCoeffTruncate_eq_of_mem n _ p hp]
    simp only [h2_apply]
  · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp,
      cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp, mul_zero]

/-- The expectation `⟨x, μ x⟩ = Σ_p μ(p) |x_p|²` of the multiplier in a state with Fourier
coefficients `x`. -/
noncomputable def expect (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) : ℝ :=
  ∑' p, m.μ p * ‖x p‖ ^ 2

omit [Fintype ν] in
lemma expect_nonneg (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) : 0 ≤ m.expect x :=
  tsum_nonneg fun p => mul_nonneg (m.nonneg p) (sq_nonneg _)

/-- The expectation in a position-space state: that of its Fourier coefficients. For
`μ = A_r` this is `⟨ψ, A_r ψ⟩ = Σ_k |k_r|²/(2 m_r) |ψ̂(k)|²`, the kinetic energy of particle `r`. -/
noncomputable def posExpect (ψ : MolecularPositionL2 eta) : ℝ :=
  m.expect ((physMap eta).symm ψ)

omit [Fintype ν] in
/-- For an `H²` state the expectation is the quadratic form of `μ`:
`⟪S u, μ u⟫ = Σ_p μ(p) |c_p|²`. -/
lemma inner_stateMap_h2_self (u : MolecularFourierH2 eta) :
    ⟪molecularH2StateMap eta g u, m.h2 u⟫_ℂ = (m.expect (molecularH2StateMap eta g u) : ℂ) := by
  rw [lp.inner_eq_tsum, expect, Complex.ofReal_tsum]
  refine tsum_congr fun p => ?_
  rw [molecularH2StateMap_apply, h2_apply, RCLike.inner_apply]
  rw [mul_comm, conj_mul_ofReal_mul]

omit [Fintype ν] in
lemma hasSum_expect (u : MolecularFourierH2 eta) :
    HasSum (fun p => m.μ p * ‖molecularH2Coeff g u p‖ ^ 2)
      (m.expect (molecularH2StateMap eta g u)) := by
  have h := lp.hasSum_inner (𝕜 := ℂ) (molecularH2StateMap eta g u) (m.h2 u)
  rw [inner_stateMap_h2_self] at h
  have e : (fun i => ⟪(molecularH2StateMap eta g u : FourierConfig eta Lattice3 → ℂ) i,
      (m.h2 u : FourierConfig eta Lattice3 → ℂ) i⟫_ℂ) =
      fun p => ((m.μ p * ‖molecularH2Coeff g u p‖ ^ 2 : ℝ) : ℂ) := by
    funext p
    rw [molecularH2StateMap_apply, h2_apply, RCLike.inner_apply, mul_comm, conj_mul_ofReal_mul]
  rw [e] at h
  exact Complex.hasSum_ofReal.mp h

omit [Fintype ν] in
/-- The expectation in an `H²` state is at most `‖S u‖ ‖μ u‖`. -/
lemma expect_le_norm_mul (u : MolecularFourierH2 eta) :
    m.expect (molecularH2StateMap eta g u) ≤
      ‖molecularH2StateMap eta g u‖ * ‖m.h2 u‖ := by
  have h := norm_inner_le_norm (𝕜 := ℂ) (molecularH2StateMap eta g u) (m.h2 u)
  rw [inner_stateMap_h2_self, Complex.norm_real, Real.norm_of_nonneg (m.expect_nonneg _)] at h
  exact h

omit [Fintype ν] in
/-- **Projection identity** (`lem:mult-basic` (i)). With `δ = (1 - P) u`,
`⟨S u, μ u⟩ = ⟨P S u, μ P u⟩ + ⟨S δ, μ δ⟩`: the cross terms vanish exactly. -/
lemma expect_split (n : ℕ) (u : MolecularFourierH2 eta) :
    m.expect (molecularH2StateMap eta g u) =
      m.expect (molecularH2StateMap eta g (molecularH2Truncate n u)) +
        m.expect (molecularH2StateMap eta g (u - molecularH2Truncate n u)) := by
  apply Complex.ofReal_injective
  push_cast
  rw [← inner_stateMap_h2_self, ← inner_stateMap_h2_self, ← inner_stateMap_h2_self]
  set S := molecularH2StateMap eta g
  set a := molecularH2Truncate n u
  have hd : u = a + (u - a) := by abel
  have e1 : S u = S a + S (u - a) := by rw [← map_add, ← hd]
  have e2 : m.h2 u = m.h2 a + m.h2 (u - a) := by rw [← map_add, ← hd]
  -- the cross terms
  have hSa : S a = molecularH2Truncate n (S u) := stateMap_truncate g n u
  have hSd : S (u - a) = S u - molecularH2Truncate n (S u) := by rw [map_sub, hSa]
  have hμa : m.h2 a = molecularH2Truncate n (m.h2 u) := m.h2_truncate n u
  have hμd : m.h2 (u - a) = m.h2 u - molecularH2Truncate n (m.h2 u) := by rw [map_sub, hμa]
  have c1 : ⟪S a, m.h2 (u - a)⟫_ℂ = 0 := by
    rw [hSa, hμd, ← inner_conj_symm, inner_sub_truncate_truncate, map_zero]
  have c2 : ⟪S (u - a), m.h2 a⟫_ℂ = 0 := by
    rw [hSd, hμa, inner_sub_truncate_truncate]
  rw [e1, e2, inner_add_left, inner_add_right, inner_add_right, c1, c2]
  ring

omit [Fintype ν] in
lemma expect_tail_nonneg (n : ℕ) (u : MolecularFourierH2 eta) :
    0 ≤ m.expect (molecularH2StateMap eta g (u - molecularH2Truncate n u)) :=
  m.expect_nonneg _

omit [Fintype ν] in
/-- **The size of the projection term** (`eq:mult-I`):
`0 ≤ ⟨δ, μ δ⟩ ≤ ‖(1 - P) S u‖ ‖(1 - P) T u‖`. -/
lemma expect_tail_le (n : ℕ) (u : MolecularFourierH2 eta) :
    m.expect (molecularH2StateMap eta g (u - molecularH2Truncate n u)) ≤
      ‖molecularH2StateMap eta g u - molecularH2Truncate n (molecularH2StateMap eta g u)‖ *
        ‖coulombFourierKineticH2 sys g u -
          molecularH2Truncate n (coulombFourierKineticH2 sys g u)‖ := by
  have h := m.expect_le_norm_mul (u - molecularH2Truncate n u)
  have hS : molecularH2StateMap eta g (u - molecularH2Truncate n u) =
      molecularH2StateMap eta g u - molecularH2Truncate n (molecularH2StateMap eta g u) := by
    rw [map_sub, stateMap_truncate]
  have hT : coulombFourierKineticH2 sys g (u - molecularH2Truncate n u) =
      coulombFourierKineticH2 sys g u -
        molecularH2Truncate n (coulombFourierKineticH2 sys g u) := by
    rw [map_sub, kinetic_truncate]
  rw [← hS, ← hT]
  exact h.trans (mul_le_mul_of_nonneg_left (m.norm_h2_le _) (norm_nonneg _))

end KinMult

/-! ## The kinetic energy of one particle -/

section Register

variable (sys : CoulombSystem eta ν) (g : ℝ)

/-- The kinetic symbol of particle `r`: `|k_r|²/(2 m_r)` at `k = g p`. -/
noncomputable def regSymbol (r : Fin eta) (p : FourierConfig eta Lattice3) : ℝ :=
  (1 / 2 : ℝ) * (g ^ 2 * latticeNormSq (p r) / sys.mass r)

omit [Fintype ν] in
lemma regSymbol_nonneg (r : Fin eta) (p : FourierConfig eta Lattice3) :
    0 ≤ regSymbol sys g r p := by
  unfold regSymbol
  have := sys.mass_pos r
  have := latticeNormSq_nonneg (p r)
  positivity

omit [Fintype ν] in
lemma regSymbol_le_kin (r : Fin eta) (p : FourierConfig eta Lattice3) :
    regSymbol sys g r p ≤ coulombKineticEnergySymbol sys g p := by
  unfold regSymbol coulombKineticEnergySymbol
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  exact Finset.single_le_sum (f := fun i => g ^ 2 * latticeNormSq (p i) / sys.mass i)
    (fun i _ => div_nonneg (mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg _))
      (sys.mass_pos i).le) (Finset.mem_univ r)

omit [Fintype ν] in
lemma sum_regSymbol (p : FourierConfig eta Lattice3) :
    ∑ r, regSymbol sys g r p = coulombKineticEnergySymbol sys g p := by
  unfold regSymbol coulombKineticEnergySymbol
  rw [Finset.mul_sum]

/-- The kinetic energy `A_r` of particle `r` as a kinetic multiplier. -/
noncomputable def regKin (r : Fin eta) : KinMult sys g where
  μ := regSymbol sys g r
  nonneg := regSymbol_nonneg sys g r
  le_kin := regSymbol_le_kin sys g r

omit [Fintype ν] in
/-- The kinetic energies of the particles add up to the kinetic energy of the certificate:
`Σ_r ⟨S u, A_r u⟩ = ⟪S u, T u⟫`. -/
lemma sum_expect_regKin (u : MolecularFourierH2 eta) :
    ((∑ r, (regKin sys g r).expect (molecularH2StateMap eta g u) : ℝ) : ℂ) =
      ⟪molecularH2StateMap eta g u, coulombFourierKineticH2 sys g u⟫_ℂ := by
  have h1 : HasSum (fun p => coulombKineticEnergySymbol sys g p * ‖molecularH2Coeff g u p‖ ^ 2)
      (∑ r, (regKin sys g r).expect (molecularH2StateMap eta g u)) := by
    have h := hasSum_sum (s := Finset.univ) fun r _ => (regKin sys g r).hasSum_expect u
    convert h using 1
    funext p
    rw [← Finset.sum_mul]
    congr 1
    exact (sum_regSymbol sys g p).symm
  have h2 := lp.hasSum_inner (𝕜 := ℂ) (molecularH2StateMap eta g u)
    (coulombFourierKineticH2 sys g u)
  have e : (fun i => ⟪(molecularH2StateMap eta g u : FourierConfig eta Lattice3 → ℂ) i,
      (coulombFourierKineticH2 sys g u : FourierConfig eta Lattice3 → ℂ) i⟫_ℂ) =
      fun p => ((coulombKineticEnergySymbol sys g p * ‖molecularH2Coeff g u p‖ ^ 2 : ℝ) : ℂ) := by
    funext p
    rw [molecularH2StateMap_apply, coulombFourierKineticH2_apply, RCLike.inner_apply, mul_comm,
      conj_mul_ofReal_mul]
  rw [e] at h2
  exact (Complex.hasSum_ofReal.mpr h1).unique h2

end Register

