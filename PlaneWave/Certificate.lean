/-- Relabel all electron registers by a permutation. -/
def particlePermuteConfig {eta : ℕ} {μ : Type*}
    (σ : Equiv.Perm (Fin eta)) (p : FourierConfig eta μ) : FourierConfig eta μ :=
  p ∘ σ

/-- The induced bijection of the complete finite configuration space. -/
def particlePermuteConfigEquiv {eta : ℕ} {μ : Type*}
    (σ : Equiv.Perm (Fin eta)) : FourierConfig eta μ ≃ FourierConfig eta μ where
  toFun := particlePermuteConfig σ
  invFun := particlePermuteConfig σ.symm
  left_inv := by intro p; funext i; simp [particlePermuteConfig]
  right_inv := by intro p; funext i; simp [particlePermuteConfig]

@[simp] lemma particlePermuteConfigEquiv_apply {eta : ℕ} {μ : Type*}
    (σ : Equiv.Perm (Fin eta)) (p : FourierConfig eta μ) :
    particlePermuteConfigEquiv σ p = p ∘ σ := rfl

/-- Complex-linear pullback of a coefficient vector by particle relabeling. -/
noncomputable def particlePermutationOperator {eta : ℕ} {μ : Type*} [Fintype μ]
    (σ : Equiv.Perm (Fin eta)) :
    EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ) where
  toFun u := WithLp.toLp 2 (fun p => u.ofLp (p ∘ σ))
  map_add' := by intro u v; ext p; rfl
  map_smul' := by intro z u; ext p; rfl

@[simp] lemma particlePermutationOperator_apply {eta : ℕ} {μ : Type*} [Fintype μ]
    (σ : Equiv.Perm (Fin eta))
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) (p : FourierConfig eta μ) :
    (particlePermutationOperator σ u).ofLp p = u.ofLp (p ∘ σ) := rfl

/-- Exact kernel covariance implies covariance of the finite matrix action.
The two kernels may differ; this is useful for a single named electron or pair. -/
lemma finiteCoefficientKernelOperator_particlePermutation_covariant
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (σ : Equiv.Perm (Fin eta))
    (kernel target : FourierConfig eta μ → FourierConfig eta μ → ℂ)
    (hKernel : ∀ q p, kernel (q ∘ σ) (p ∘ σ) = target q p)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    finiteCoefficientKernelOperator target (particlePermutationOperator σ u) =
      particlePermutationOperator σ (finiteCoefficientKernelOperator kernel u) := by
  classical
  ext q
  simp only [finiteCoefficientKernelOperator_apply, particlePermutationOperator_apply]
  apply Fintype.sum_equiv (particlePermuteConfigEquiv σ)
  intro p
  simp only [particlePermuteConfigEquiv_apply]
  rw [hKernel q p]

/-- A permutation-invariant kernel commutes with the pullback action. -/
lemma finiteCoefficientKernelOperator_particlePermutation_commute
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (σ : Equiv.Perm (Fin eta))
    (kernel : FourierConfig eta μ → FourierConfig eta μ → ℂ)
    (hKernel : ∀ q p, kernel (q ∘ σ) (p ∘ σ) = kernel q p)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    finiteCoefficientKernelOperator kernel (particlePermutationOperator σ u) =
      particlePermutationOperator σ (finiteCoefficientKernelOperator kernel u) :=
  finiteCoefficientKernelOperator_particlePermutation_covariant σ kernel kernel hKernel u

/-- Equality of spectator configurations is preserved under relabeling. -/
lemma outerConfigOf_eq_permute_iff
    {eta : ℕ} {μ : Type*} (σ : Equiv.Perm (Fin eta)) (i : Fin eta)
    (q p : FourierConfig eta μ) :
    outerConfigOf i (q ∘ σ) = outerConfigOf i (p ∘ σ) ↔
      outerConfigOf (σ i) q = outerConfigOf (σ i) p := by
  constructor
  · intro h
    funext k
    have hk : σ.symm k.1 ≠ i := by
      intro heq
      apply k.2
      have := congrArg σ heq
      simpa using this
    have hv := congrFun h ⟨σ.symm k.1, hk⟩
    simpa [outerConfigOf, Function.comp_apply] using hv
  · intro h
    funext k
    have hk : σ k.1 ≠ σ i := fun heq => k.2 (σ.injective heq)
    exact congrFun h ⟨σ k.1, hk⟩

/-- One-body kernel covariance is independent of its charge, sign, or phase. -/
lemma referenceConfigurationKernel_permute
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (σ : Equiv.Perm (Fin eta)) (i : Fin eta) (kernel : μ → μ → ℂ)
    (q p : FourierConfig eta μ) :
    referenceConfigurationKernel i kernel (q ∘ σ) (p ∘ σ) =
      referenceConfigurationKernel (σ i) kernel q p := by
  classical
  by_cases h : outerConfigOf (σ i) q = outerConfigOf (σ i) p
  · have hp := (outerConfigOf_eq_permute_iff σ i q p).mpr h
    rw [referenceConfigurationKernel_of_outer_eq i kernel _ _ hp,
      referenceConfigurationKernel_of_outer_eq (σ i) kernel _ _ h]
    rfl
  · have hp : outerConfigOf i (q ∘ σ) ≠ outerConfigOf i (p ∘ σ) := by
      intro heq
      exact h ((outerConfigOf_eq_permute_iff σ i q p).mp heq)
    rw [referenceConfigurationKernel_of_outer_ne i kernel _ _ hp,
      referenceConfigurationKernel_of_outer_ne (σ i) kernel _ _ h]

lemma referenceKernelConvolutionOperator_eq_finiteCoefficientKernelOperator
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (i : Fin eta) (kernel : μ → μ → ℂ) :
    referenceKernelConvolutionOperator i kernel =
      finiteCoefficientKernelOperator (referenceConfigurationKernel i kernel) := by
  apply LinearMap.ext
  intro u
  ext q
  exact referenceKernelConvolutionOperator_apply i kernel u q

lemma referenceKernelConvolutionOperator_particlePermutation_covariant
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (σ : Equiv.Perm (Fin eta)) (i : Fin eta) (kernel : μ → μ → ℂ)
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) :
    referenceKernelConvolutionOperator (σ i) kernel (particlePermutationOperator σ u) =
      particlePermutationOperator σ (referenceKernelConvolutionOperator i kernel u) := by
  rw [referenceKernelConvolutionOperator_eq_finiteCoefficientKernelOperator,
    referenceKernelConvolutionOperator_eq_finiteCoefficientKernelOperator]
  exact finiteCoefficientKernelOperator_particlePermutation_covariant σ _ _
    (referenceConfigurationKernel_permute σ i kernel) u

end
