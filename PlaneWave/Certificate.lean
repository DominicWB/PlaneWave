/-! A compactly supported quadratic taper of the specified Coulomb
singularity. Its Fourier transform is a separate analytic obligation: none
of the following lemmas assumes that transform identity. -/

noncomputable def unitTorus3QuadraticCoulombCutoff
    (R : ℝ) (x : UnitTorus3) : ℝ :=
  (max 0 (1 - Real.sqrt (unitTorus3RadiusSq x) / R)) ^ 2

lemma unitTorus3QuadraticCoulombCutoff_nonneg
    (R : ℝ) (x : UnitTorus3) :
    0 ≤ unitTorus3QuadraticCoulombCutoff R x := by
  exact sq_nonneg _

lemma unitTorus3QuadraticCoulombCutoff_le_one
    {R : ℝ} (hR : 0 < R) (x : UnitTorus3) :
    unitTorus3QuadraticCoulombCutoff R x ≤ 1 := by
  have hr : 0 ≤ Real.sqrt (unitTorus3RadiusSq x) / R :=
    div_nonneg (Real.sqrt_nonneg _) hR.le
  have h0 : 0 ≤ max 0 (1 - Real.sqrt (unitTorus3RadiusSq x) / R) :=
    le_max_left _ _
  have h1 : max 0 (1 - Real.sqrt (unitTorus3RadiusSq x) / R) ≤ 1 :=
    max_le (by norm_num) (by linarith)
  unfold unitTorus3QuadraticCoulombCutoff
  nlinarith [mul_nonneg h0 (sub_nonneg.mpr h1)]

lemma unitTorus3QuadraticCoulombCutoff_measurable (R : ℝ) :
    Measurable (unitTorus3QuadraticCoulombCutoff R) := by
  have hRadius : Measurable (fun x : UnitTorus3 =>
      Real.sqrt (unitTorus3RadiusSq x)) := by
    apply Real.continuous_sqrt.measurable.comp
    unfold unitTorus3RadiusSq
    refine Finset.measurable_sum Finset.univ ?_
    intro i _hi
    exact (measurable_pi_apply i).norm.pow_const 2
  exact ((measurable_const.max ((hRadius.div_const R).const_sub 1)).pow_const 2)

/-- The taper is multiplied by the existing canonical pi/r singularity,
so its value at the origin follows the same division-by-zero convention. -/
noncomputable def unitTorus3QuadraticCoulombSingular
    (R : ℝ) (x : UnitTorus3) : ℂ :=
  (unitTorus3QuadraticCoulombCutoff R x : ℂ) *
    unitTorus3CanonicalCoulombSingular x

lemma unitTorus3QuadraticCoulombSingular_memLp
    {R : ℝ} (hR : 0 < R) :
    MemLp (unitTorus3QuadraticCoulombSingular R) 2 volume := by
  have hCutMeas : AEStronglyMeasurable
      (fun x : UnitTorus3 => (unitTorus3QuadraticCoulombCutoff R x : ℂ)) volume :=
    (unitTorus3QuadraticCoulombCutoff_measurable R).complex_ofReal.aestronglyMeasurable
  have hMeas : AEStronglyMeasurable
      (unitTorus3QuadraticCoulombSingular R) volume :=
    hCutMeas.fun_mul unitTorus3CanonicalCoulombSingular_memLp.aestronglyMeasurable
  refine unitTorus3CanonicalCoulombSingular_memLp.of_le hMeas ?_
  filter_upwards with x
  unfold unitTorus3QuadraticCoulombSingular
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (unitTorus3QuadraticCoulombCutoff_nonneg R x)]
  simpa only [one_mul] using
    mul_le_mul_of_nonneg_right (unitTorus3QuadraticCoulombCutoff_le_one hR x)
      (norm_nonneg (unitTorus3CanonicalCoulombSingular x))

/-- A scalar calculation for the error introduced by the quadratic taper.
Only a first-order zero of `1-chi` at the origin is needed for boundedness. -/
lemma quadraticCoulombCutoff_inverseRadius_difference_bound
    {R : ℝ} (hR : 0 < R) (r : ℝ) (hr : 0 ≤ r) :
    |(max 0 (1 - r / R)) ^ 2 * (Real.pi * (1 / r)) -
      Real.pi * (1 / r)| ≤ 2 * Real.pi / R := by
  by_cases hr0 : r = 0
  · simp only [hr0, div_zero, mul_zero, sub_self, abs_zero]
    positivity
  by_cases hrR : r ≤ R
  · have hRatio0 : 0 ≤ r / R := div_nonneg hr hR.le
    have hRatio1 : r / R ≤ 1 :=
      (div_le_iff₀ hR).2 (by simpa using hrR)
    rw [max_eq_right (by linarith)]
    have hIdentity :
        (1 - r / R) ^ 2 * (Real.pi * (1 / r)) - Real.pi * (1 / r) =
          -(Real.pi / R * (2 - r / R)) := by
      field_simp [hr0, hR.ne']
      ring
    rw [hIdentity, abs_neg,
      abs_of_nonneg (mul_nonneg (div_nonneg Real.pi_pos.le hR.le)
        (by linarith))]
    calc
      Real.pi / R * (2 - r / R) ≤ Real.pi / R * 2 :=
        mul_le_mul_of_nonneg_left (by linarith)
          (div_nonneg Real.pi_pos.le hR.le)
      _ = 2 * Real.pi / R := by ring
  · have hRr : R ≤ r := le_of_lt (lt_of_not_ge hrR)
    have hRatio : 1 ≤ r / R :=
      (le_div_iff₀ hR).2 (by simpa using hRr)
    rw [max_eq_left (by linarith)]
    simp only [zero_pow (by decide : (2 : ℕ) ≠ 0), zero_mul, zero_sub, abs_neg]
    rw [abs_of_nonneg (mul_nonneg Real.pi_pos.le (one_div_nonneg.mpr hr))]
    calc
      Real.pi * (1 / r) ≤ Real.pi * (1 / R) :=
        mul_le_mul_of_nonneg_left (one_div_le_one_div_of_le hR hRr)
          Real.pi_pos.le
      _ = Real.pi / R := by ring
      _ ≤ Real.pi / R + Real.pi / R :=
        le_add_of_nonneg_right (div_nonneg Real.pi_pos.le hR.le)
      _ = 2 * Real.pi / R := by ring

/-- The localized singularity differs from the specified global intrinsic
singularity by an explicitly bounded function. This comparison avoids any
Fourier-decay claim for the nonsmooth minimum-image boundary. -/
lemma unitTorus3QuadraticCoulombSingular_sub_canonical_norm_le
    {R : ℝ} (hR : 0 < R) (x : UnitTorus3) :
    ‖unitTorus3QuadraticCoulombSingular R x -
      unitTorus3CanonicalCoulombSingular x‖ ≤ 2 * Real.pi / R := by
  unfold unitTorus3QuadraticCoulombSingular
    unitTorus3CanonicalCoulombSingular unitTorus3QuadraticCoulombCutoff
    unitTorus3InverseRadius
  rw [← Complex.ofReal_mul, ← Complex.ofReal_sub,
    Complex.norm_real, Real.norm_eq_abs]
  exact quadraticCoulombCutoff_inverseRadius_difference_bound hR _
    (Real.sqrt_nonneg _)

/-- An explicit intermediate reduction: a bounded correction for the
quadratically localized singularity gives a bound for the canonical remainder.
The equality premise must still be established by its Fourier transform. -/
lemma canonicalUnitTorus3CoulombRemainder_bound_of_quadratic_localization
    {R B : ℝ} (hR : 0 < R) (correction : UnitTorus3 → ℂ)
    (hNorm : ∀ᵐ x : UnitTorus3 ∂volume, ‖correction x‖ ≤ B)
    (hEq : canonicalUnitTorus3CoulombPotential.potential =ᵐ[volume]
      fun x => unitTorus3QuadraticCoulombSingular R x + correction x) :
    ∀ᵐ x : UnitTorus3 ∂volume,
      ‖canonicalUnitTorus3CoulombRemainder x‖ ≤ 2 * Real.pi / R + B := by
  filter_upwards [hNorm, hEq] with x hxNorm hxEq
  unfold canonicalUnitTorus3CoulombRemainder
  rw [hxEq]
  calc
    ‖unitTorus3QuadraticCoulombSingular R x + correction x -
        unitTorus3CanonicalCoulombSingular x‖ =
      ‖(unitTorus3QuadraticCoulombSingular R x -
        unitTorus3CanonicalCoulombSingular x) + correction x‖ := by congr 1; ring
    _ ≤ ‖unitTorus3QuadraticCoulombSingular R x -
        unitTorus3CanonicalCoulombSingular x‖ + ‖correction x‖ := norm_add_le _ _
    _ ≤ 2 * Real.pi / R + B := add_le_add
      (unitTorus3QuadraticCoulombSingular_sub_canonical_norm_le hR x) hxNorm

end

