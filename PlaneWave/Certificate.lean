  simp_rw [fourier_coe_apply]
  apply contDiff_prod
  intro a _ha
  have hEval : ContDiff ℝ 2 (fun y : d → ℝ => (y a : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_apply ℝ ℝ a)
  exact ((contDiff_const.mul hEval).div_const (1 : ℂ)).cexp

