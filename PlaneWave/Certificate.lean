/-!
# Dynamics: `eq:dyn-main` and `eq:dyn-simple` under `(Hχ)`

`thm_dyn_rates` bounds the smooth-tail term by `A₃ K^{-5/2} τ_χ(K/2)`, with the Euclidean
coefficient tail `τ_χ(K/2) = Σ_{|k_ν| > K/2} |χ̂(ν)|`. Under the manuscript's hypothesis `(Hχ)` —
`Σ_ν |χ̂(ν)| < ∞` and `Σ_{‖k_ν‖∞ > ρ} |χ̂(ν)| ≤ C_{χ,M} ρ^{-M}` for every `M ≥ 1` and `ρ ≥ 1`
(`HChi`) — the tail is at most `(2√3)^M C_{χ,M} K^{-M}` for `K ≥ 2√3` (`tail_decay`). This gives
`eq:dyn-main` in the manuscript's shape, `A₁ K^{-5} + A₂ t K^{-3} + A₃ (2√3)^M C_{χ,M} K^{-5/2-M}`
for every `M ≥ 1`, with constants independent of `K`, `t` and `M` (`thm_dyn_hchi`). This is sharper
than the manuscript's remainder `C C_{χ,M} Ξ K^{-M}` by the factor `K^{-5/2}`, and keeps explicit
the factor `(2√3)^M` that `lem:chitail` absorbs into `C_{χ,M}`. Because of the factor `K^{-5/2}`,
already `M = 3` absorbs the remainder into the `K^{-5}` term (the manuscript uses `M ≥ 5`):
`eq:dyn-simple`, `(A₁ + A₃ (2√3)³ C_{χ,3}) K^{-5} + A₂ t K^{-3}` (`thm_dyn_simple`). The derivative
bound `D_χ < ∞` of `(Hχ)` is not assumed: it follows from the decay clause, which with `M = 6`
gives `Σ_ν (1 + g²|ν|²) |χ̂(ν)| < ∞` (`summable_weighted_of_decay`). The constants are the
explicit `obsConsts` at the norms of the initial data. The same holds on the spin-inclusive space
(`thm_dyn_spin_hchi`, `thm_dyn_spin_simple`, spin-inclusive norms). For the observable
`Σ_{a∈S} χ(x_a)` summed over a set `S` of registers, e.g. the particles of one species, the bounds
of the registers add up (`obs_sum_le`; `thm_dyn_spin_species` for the bound of `thm_dyn_spin`,
`thm_dyn_spin_species_hchi` for the form of `thm_dyn_spin_hchi`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveDynamics

open PlaneWaveCertificate

/-- The manuscript's `(Hχ)` for the coefficients `c = χ̂` on the lattice `g ℤ³`:
`Σ_ν |c ν| < ∞` and `Σ_{g‖ν‖∞ > ρ} |c ν| ≤ C_M ρ^{-M}` for every `M ≥ 1` and `ρ ≥ 1`. The
derivative bound `D_χ < ∞` of `(Hχ)` is left out: it follows from the decay clause. -/
def HChi (g : ℝ) (c : Lattice3 → ℂ) (CM : ℕ → ℝ) : Prop :=
  Summable (fun ν => ‖c ν‖) ∧
    ∀ M : ℕ, 1 ≤ M → ∀ ρ : ℝ, 1 ≤ ρ →
      ρ ^ M * (∑' ν, if ρ < g * latticeSupNorm ν then ‖c ν‖ else 0) ≤ CM M

variable {eta : ℕ} {ν : Type} [Fintype ν]

lemma obsConsts_nonneg_three (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ) (a : Fin eta)
    (χ : Lattice3 → ℂ) (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    {s0 hu hs hv : ℝ} (h0 : 0 ≤ s0) (h1 : 0 ≤ hu) (h2 : 0 ≤ hs) (h3 : 0 ≤ hv) :
    0 ≤ (obsConsts sys L Hunit Blow Cs Bker a χ s0 hu hs hv).2.2 := by
  have hb := relB_nonneg sys L Hunit hC
  have hM := sys.one_le_maxMass
  have hκ : 0 ≤ finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
      (sys.maxMass * (s0 + 2 * (2 * hu + 2 * relB sys L Hunit * s0))) :=
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker (by positivity)
  simp only [obsConsts]
  positivity

/-- **The smooth-tail term under `(Hχ)`.** For nonnegative data and coefficients `c` satisfying
`HChi`, at `ρ = K^{-1/2}` with `K = 2πn/L ≥ 2√3`,
`obsRateBound ≤ A₁ K^{-5} + A₂ t K^{-3} + A₃ (2√3)^M C_{χ,M} K^{-5/2-M}` with the constants
`(A₁, A₂, A₃) = obsConsts`, for every `M ≥ 1`. -/
lemma obsRateBound_hchi_le (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (Hunit Blow Cs Bker : ℝ) (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (n : ℕ) (a : Fin eta)
    {c : Lattice3 → ℂ} {CM : ℕ → ℝ} (hc : HChi (2 * Real.pi / L) c CM) {M : ℕ} (hM : 1 ≤ M)
    (hK : 2 * Real.sqrt 3 ≤ (2 * Real.pi / L) * n)
    {s0 hu hs hv : ℝ} (h0 : 0 ≤ s0) (h1 : 0 ≤ hu) (h2 : 0 ≤ hs) (h3 : 0 ≤ hv) (t : ℝ) :
    obsRateBound sys L Hunit Blow Cs Bker (Real.sqrt (1 / ((2 * Real.pi / L) * n))) n a c
        s0 hu hs hv t ≤
      (obsConsts sys L Hunit Blow Cs Bker a c s0 hu hs hv).1 *
          (1 / ((2 * Real.pi / L) * n)) ^ 5 +
        (obsConsts sys L Hunit Blow Cs Bker a c s0 hu hs hv).2.1 * t *
          (1 / ((2 * Real.pi / L) * n)) ^ 3 +
        (obsConsts sys L Hunit Blow Cs Bker a c s0 hu hs hv).2.2 * (2 * Real.sqrt 3) ^ M *
          CM M * Real.sqrt (1 / ((2 * Real.pi / L) * n)) ^ 5 *
          (1 / ((2 * Real.pi / L) * n)) ^ M := by
  have hA3 := obsConsts_nonneg_three sys L Hunit Blow Cs Bker a c hC hBlow hCs hBker h0 h1 h2 h3
  set A := obsConsts sys L Hunit Blow Cs Bker a c s0 hu hs hv with hA
  set K := (2 * Real.pi / L) * n with hKdef
  have h3pos : 0 < Real.sqrt 3 := by positivity
  have hKpos : 0 < K := lt_of_lt_of_le (by positivity) hK
  rw [obsRateBound_eq]
  have hρ2 : Real.sqrt (1 / K) ^ 2 = 1 / K := Real.sq_sqrt (by positivity)
  have e10 : Real.sqrt (1 / K) ^ 10 = (1 / K) ^ 5 := by
    rw [show (10 : ℕ) = 2 * 5 by norm_num, pow_mul, hρ2]
  have e6 : Real.sqrt (1 / K) ^ 6 = (1 / K) ^ 3 := by
    rw [show (6 : ℕ) = 2 * 3 by norm_num, pow_mul, hρ2]
  rw [e10, e6]
  have htail := tail_decay hc.1 (by positivity : (0 : ℝ) ≤ 2 * Real.pi / L) M (CM M)
    (hc.2 M hM) hK
  have hprod : ((2 * Real.sqrt 3) * (1 / K)) ^ M * (K / (2 * Real.sqrt 3)) ^ M = 1 := by
    rw [← mul_pow]
    rw [show (2 * Real.sqrt 3) * (1 / K) * (K / (2 * Real.sqrt 3)) = 1 by field_simp]
    exact one_pow M
  have hτ : obsTail L n c ≤ (2 * Real.sqrt 3) ^ M * CM M * (1 / K) ^ M := by
    calc obsTail L n c
        = ((2 * Real.sqrt 3) * (1 / K)) ^ M * ((K / (2 * Real.sqrt 3)) ^ M * obsTail L n c) := by
          rw [← mul_assoc, hprod, one_mul]
      _ ≤ ((2 * Real.sqrt 3) * (1 / K)) ^ M * CM M :=
          mul_le_mul_of_nonneg_left htail (by positivity)
      _ = (2 * Real.sqrt 3) ^ M * CM M * (1 / K) ^ M := by
          rw [mul_pow]
          ring
  have hs5 : 0 ≤ Real.sqrt (1 / K) ^ 5 := by positivity
  have key : A.2.2 * Real.sqrt (1 / K) ^ 5 * obsTail L n c ≤
      A.2.2 * (2 * Real.sqrt 3) ^ M * CM M * Real.sqrt (1 / K) ^ 5 * (1 / K) ^ M := by
    calc A.2.2 * Real.sqrt (1 / K) ^ 5 * obsTail L n c
        ≤ A.2.2 * Real.sqrt (1 / K) ^ 5 * ((2 * Real.sqrt 3) ^ M * CM M * (1 / K) ^ M) :=
          mul_le_mul_of_nonneg_left hτ (mul_nonneg hA3 hs5)
      _ = A.2.2 * (2 * Real.sqrt 3) ^ M * CM M * Real.sqrt (1 / K) ^ 5 * (1 / K) ^ M := by ring
  linarith only [key]

/-- `K^{-5/2-3} ≤ K^{-5}` for `K ≥ 1`. -/
lemma sqrt_pow_five_mul_le {K : ℝ} (hK : 1 ≤ K) :
    Real.sqrt (1 / K) ^ 5 * (1 / K) ^ 3 ≤ (1 / K) ^ 5 := by
  have hKpos : 0 < K := lt_of_lt_of_le one_pos hK
  have hr0 : 0 ≤ Real.sqrt (1 / K) := Real.sqrt_nonneg _
  have hinv : 1 / K ≤ 1 := by
    rw [div_le_one hKpos]
    exact hK
  have hr1 : Real.sqrt (1 / K) ≤ 1 := by
    have h := Real.sqrt_le_sqrt hinv
    rwa [Real.sqrt_one] at h
  have hr2 : Real.sqrt (1 / K) ^ 2 = 1 / K := Real.sq_sqrt (by positivity)
  have h5 : Real.sqrt (1 / K) ^ 5 ≤ Real.sqrt (1 / K) ^ 4 :=
    pow_le_pow_of_le_one hr0 hr1 (by norm_num)
  have h4 : Real.sqrt (1 / K) ^ 4 = (1 / K) ^ 2 := by
    rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul, hr2]
  calc Real.sqrt (1 / K) ^ 5 * (1 / K) ^ 3 ≤ (1 / K) ^ 2 * (1 / K) ^ 3 :=
        mul_le_mul_of_nonneg_right (h5.trans h4.le) (by positivity)
    _ = (1 / K) ^ 5 := by ring

lemma two_le_of_two_sqrt_three_le {K : ℝ} (hK : 2 * Real.sqrt 3 ≤ K) : 2 ≤ K := by
  have h3 : 1 ≤ Real.sqrt 3 := by
    rw [← Real.sqrt_one]
    exact Real.sqrt_le_sqrt (by norm_num)
  linarith

/-- **`thm:dyn` in the manuscript's form** (`eq:dyn-main` under `(Hχ)`). With the propagators of
`thm_dyn`: for every `ψ₀ ∈ D(H²)` (`H ψ₀ = h₀`, `H h₀ = h₁`), register `a` and real continuous `χ`
satisfying `(Hχ)` with constants `C_{χ,M}`, and with `(A₁, A₂, A₃) = obsConsts` at
`(‖ψ₀‖, ‖h₀‖, ‖h₀‖, ‖h₁‖)` (independent of `K`, `t` and `M`): for every `M ≥ 1`, every cube
`n ≥ 4` with `K = 2πn/L ≥ 2√3` and every `t ≥ 0`,
`|⟪ψ(t), χ(x_a) ψ(t)⟫ - ⟪ψ_N(t), χ(x_a) ψ_N(t)⟫|`
`≤ A₁ K^{-5} + A₂ t K^{-3} + A₃ (2√3)^M C_{χ,M} K^{-5/2-M}`. -/
theorem thm_dyn_hchi (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ ψ₀ h₀ h₁ : MolecularPositionL2 eta, HasCoulombHamiltonian sys L ψ₀ h₀ →
          HasCoulombHamiltonian sys L h₀ h₁ →
          ∀ (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)) (CM : ℕ → ℝ),
          HChi (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ) CM →
          (∀ y, conj (χ y) = χ y) →
          let A := obsConsts sys L molecularCanonicalUnitHardyConstant
            (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
            (molecularCanonicalKernelConstant L) a (UnitAddTorus.mFourierCoeff χ)
            ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖
          ∀ M : ℕ, 1 ≤ M → ∀ n : ℕ, 4 ≤ n →
            2 * Real.sqrt 3 ≤ (2 * Real.pi / L) * n → ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            let ψN := physMap eta (finiteFourierLpIsometry eta n
              (UN n t (extractCLM n ((physMap eta).symm ψ₀))))
            ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
              A.1 * (1 / K) ^ 5 + A.2.1 * t * (1 / K) ^ 3 +
                A.2.2 * (2 * Real.sqrt 3) ^ M * CM M * Real.sqrt (1 / K) ^ 5 * (1 / K) ^ M := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hrest⟩ := thm_dyn sys L hL
  choose UN hN0 hNadd hNderiv hbound using hrest
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, UN, hN0, hNadd, hNderiv, ?_⟩
  intro ψ₀ h₀ h₁ hψ₀ hh₀ a χ CM hc hreal A M hM n hn hK t ht K ψN
  obtain ⟨hBlow, hCs, hBker, -⟩ := molecularCanonicalTailConstants_spec L hL
  have hC := finiteCoulombPhysicalMassConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  have hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖ :=
    summable_weighted_of_decay hc.1 (by positivity) (CM 6) (hc.2 6 (by norm_num))
  refine le_trans (hbound n hn (two_le_of_two_sqrt_three_le hK) ψ₀ h₀ h₁ hψ₀ hh₀ a χ hχ2 hreal t
    ht) ?_
  exact obsRateBound_hchi_le sys L hL _ _ _ _ hC hBlow hCs hBker n a hc hM hK (norm_nonneg _)
    (norm_nonneg _) (norm_nonneg _) (norm_nonneg _) t

/-- **`eq:dyn-simple`.** Under `(Hχ)` (used with `M = 3` and `M = 6`), with the propagators of
`thm_dyn` and `(A₁, A₂, A₃) = obsConsts` as in `thm_dyn_hchi`: for every cube `n ≥ 4` with
`K = 2πn/L ≥ 2√3` and every `t ≥ 0`,
`|⟪ψ(t), χ(x_a) ψ(t)⟫ - ⟪ψ_N(t), χ(x_a) ψ_N(t)⟫| ≤ (A₁ + A₃ (2√3)³ C_{χ,3}) K^{-5} + A₂ t K^{-3}`
(`K^{-5/2-3} ≤ K^{-5}`). This is the `K`-form of `eq:dyn-simple`: with `N = (2n + 1)³` plane waves
per particle and `n ≥ 4`, `N^{1/3} ≤ 9n/4`, so `K^{-1} ≤ (9L/8π) N^{-1/3}` and the bound is
`O(N^{-5/3} + t N^{-1})`. -/
theorem thm_dyn_simple (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ ψ₀ h₀ h₁ : MolecularPositionL2 eta, HasCoulombHamiltonian sys L ψ₀ h₀ →
          HasCoulombHamiltonian sys L h₀ h₁ →
          ∀ (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)) (CM : ℕ → ℝ),
          HChi (2 * Real.pi / L) (UnitAddTorus.mFourierCoeff χ) CM →
          (∀ y, conj (χ y) = χ y) →
          let A := obsConsts sys L molecularCanonicalUnitHardyConstant
            (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
            (molecularCanonicalKernelConstant L) a (UnitAddTorus.mFourierCoeff χ)
            ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖
          ∀ n : ℕ, 4 ≤ n → 2 * Real.sqrt 3 ≤ (2 * Real.pi / L) * n →
            ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            let ψN := physMap eta (finiteFourierLpIsometry eta n
              (UN n t (extractCLM n ((physMap eta).symm ψ₀))))
            ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
              (A.1 + A.2.2 * (2 * Real.sqrt 3) ^ 3 * CM 3) * (1 / K) ^ 5 +
                A.2.1 * t * (1 / K) ^ 3 := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, UN, hN0, hNadd, hNderiv, hrest⟩ :=
    thm_dyn_hchi sys L hL
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, UN, hN0, hNadd, hNderiv, ?_⟩
  intro ψ₀ h₀ h₁ hψ₀ hh₀ a χ CM hc hreal A n hn hK t ht K ψN
  have h := hrest ψ₀ h₀ h₁ hψ₀ hh₀ a χ CM hc hreal 3 (by norm_num) n hn hK t ht
  obtain ⟨hBlow, hCs, hBker, -⟩ := molecularCanonicalTailConstants_spec L hL
  have hA₃ : 0 ≤ A.2.2 :=
    obsConsts_nonneg_three sys L _ _ _ _ a _
      (finiteCoulombPhysicalMassConstant_nonneg _ _ _) hBlow hCs hBker (norm_nonneg _)
      (norm_nonneg _) (norm_nonneg _) (norm_nonneg _)
  have hCM3 : 0 ≤ CM 3 := by
    have h1 := hc.2 3 (by norm_num) 1 le_rfl
    have hnn : 0 ≤ (∑' ν, if 1 < (2 * Real.pi / L) * latticeSupNorm ν then
        ‖UnitAddTorus.mFourierCoeff χ ν‖ else 0) :=
      tsum_nonneg fun _ => by split_ifs <;> simp
    rw [one_pow, one_mul] at h1
    exact hnn.trans h1
  have hK1 : 1 ≤ K := le_trans (by norm_num) (two_le_of_two_sqrt_three_le hK)
  have hrem := mul_le_mul_of_nonneg_left (sqrt_pow_five_mul_le hK1)
    (mul_nonneg (mul_nonneg hA₃ (by positivity : (0 : ℝ) ≤ (2 * Real.sqrt 3) ^ 3)) hCM3)
  have h' : ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
      A.1 * (1 / K) ^ 5 + A.2.1 * t * (1 / K) ^ 3 +
        A.2.2 * (2 * Real.sqrt 3) ^ 3 * CM 3 * (Real.sqrt (1 / K) ^ 5 * (1 / K) ^ 3) := by
    refine h.trans (le_of_eq ?_)
    ring
  have e : (A.1 + A.2.2 * (2 * Real.sqrt 3) ^ 3 * CM 3) * (1 / K) ^ 5 + A.2.1 * t * (1 / K) ^ 3 =
      A.1 * (1 / K) ^ 5 + A.2.1 * t * (1 / K) ^ 3 +
        A.2.2 * (2 * Real.sqrt 3) ^ 3 * CM 3 * (1 / K) ^ 5 := by ring
  rw [e]
  linarith only [h', hrem]

/-- `thm_dyn_hchi` on the spin-inclusive space: the same constants `obsConsts`, at the
spin-inclusive norms `(‖Ψ₀‖, ‖H₀‖, ‖H₀‖, ‖H₁‖)`. -/
theorem thm_dyn_spin_hchi (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (D : ℕ) :
    ∃ U : ℝ → CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D,
