def molecularLatticeHamiltonianKernel {ν : Type*} [Fintype ν]
    (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (q p : FourierConfig eta Lattice3) : ℂ :=
  molecularLatticeKineticKernel eta L q p +
    (molecularLatticeNuclearKernel eta data (coulombCellAmplitude L) q p +
      molecularLatticeElectronKernel eta (coulombCellAmplitude L) q p)

