completion reduces to its finite Fourier core. The passage to the full domain
has been proved by closedness of pointwise multiplication. -/
theorem molecularPositionPotentialH2_pointwise_iff_core (eta : ℕ) (g : ℝ)
    (V : MolecularPositionTorus eta → ℂ)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    (∀ u : MolecularFourierH2 eta,
      HasL2PointwisePotential volume V
        (molecularPositionH2StateMap eta g u) (molecularPositionPotentialH2 g H u)) ↔
    (∀ (N : ℕ) (u : MolecularFourierH2 eta),
      HasL2PointwisePotential volume V
        (molecularPositionH2StateMap eta g (molecularH2Truncate N u))
        (molecularPositionPotentialH2 g H (molecularH2Truncate N u))) :=
  molecularPositionH2Operator_pointwise_iff_core eta g V (molecularPositionPotentialH2 g H)

