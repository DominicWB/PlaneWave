  constructor
  · intro h k hki
    exact congrArg (finitePlaneWaveLatticeIndex count) (congrFun h ⟨k, hki⟩)
  · intro h
    funext k
    exact finitePlaneWaveLatticeIndex_injective count (h k.1 k.2)

