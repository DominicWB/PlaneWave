/-! ### The actual admissible count N=(2*m+1)^3 and the N^-1 conversion -/

/-- Sharp elementary factor for admissible odd-side cubes with m >= 1.
The result is expressed using the exact NATURAL basis count, not a real-valued
basis surrogate.  It is independent of the particular energy estimate used. -/
lemma cubic_basis_count_energy_bound_of_cutoff
    (m : ℕ) (K L err A : ℝ) (hm : 1 ≤ m) (hL : 0 < L) (hErr : 0 ≤ err)
    (hCutoff : K * L = 2 * Real.pi * (m : ℝ))
    (hRate : K ^ 3 * err ≤ A) :
    (((2 * m + 1) ^ 3 : ℕ) : ℝ) * err ≤ (3 * L / (2 * Real.pi)) ^ 3 * A := by
  have hmReal : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hCount : (((2 * m + 1) ^ 3 : ℕ) : ℝ) ≤ (3 * (m : ℝ)) ^ 3 := by
    push_cast
    gcongr
    linarith only [hmReal]
  have hPi : (2 * Real.pi) ≠ 0 := ne_of_gt (mul_pos (by norm_num) Real.pi_pos)
  have hmEq : (m : ℝ) = (K * L) / (2 * Real.pi) := by
    apply (eq_div_iff hPi).mpr
    calc
      (m : ℝ) * (2 * Real.pi) = 2 * Real.pi * (m : ℝ) := mul_comm _ _
      _ = K * L := hCutoff.symm
  have hIdentity : (3 * (m : ℝ)) ^ 3 = (3 * L / (2 * Real.pi)) ^ 3 * K ^ 3 := by
    rw [hmEq]
    ring
  have hFactor : 0 ≤ (3 * L / (2 * Real.pi)) ^ 3 := by positivity
  calc
    (((2 * m + 1) ^ 3 : ℕ) : ℝ) * err ≤ (3 * (m : ℝ)) ^ 3 * err :=
      mul_le_mul_of_nonneg_right hCount hErr
    _ = (3 * L / (2 * Real.pi)) ^ 3 * (K ^ 3 * err) := by
      rw [hIdentity]
      ring
    _ ≤ (3 * L / (2 * Real.pi)) ^ 3 * A :=
      mul_le_mul_of_nonneg_left hRate hFactor

