/-! ## A generic Duhamel bound in finite dimension -/

section Generic

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]

/-- **Duhamel bound.** Let `U` be a unitary group generated by the symmetric `T`
(`d/dt U t x = -i U t (T x)`, `U t T = T U t`), and let `a` solve the perturbed equation
`a' = -i (T a + r)`. If `‖r s‖ ≤ B` on `[0, t]`, then `‖a t - U t (a 0)‖ ≤ B t`. -/
theorem norm_sub_prop_le {T : V →ₗ[ℂ] V} (hT : T.IsSymmetric) (U : ℝ → V ≃ₗᵢ[ℂ] V)
    (h0 : ∀ x, U 0 x = x) (hadd : ∀ s t x, U (s + t) x = U s (U t x))
    (hcomm : ∀ t x, U t (T x) = T (U t x))
    (hderiv : ∀ t x, HasDerivAt (fun s => U s x) (-(Complex.I • U t (T x))) t)
    {a r : ℝ → V} (ha : ∀ s, HasDerivAt a (-(Complex.I • (T (a s) + r s))) s)
    {B t : ℝ} (ht : 0 ≤ t) (hB : ∀ s ∈ Icc 0 t, ‖r s‖ ≤ B) :
    ‖a t - U t (a 0)‖ ≤ B * t := by
  set η := a t - U t (a 0)
  set w := U (-t) η
  have hUw : U t w = η := by rw [← hadd, add_neg_cancel, h0]
  -- the scalar function `G s = ⟪U s w, a s⟫`
  set G : ℝ → ℂ := fun s => ⟪U s w, a s⟫_ℂ
  have hG : ∀ s, HasDerivAt G (-(Complex.I * ⟪U s w, r s⟫_ℂ)) s := by
    intro s
    have h := (hderiv s w).inner ℂ (ha s)
    have e : ⟪U s w, -(Complex.I • (T (a s) + r s))⟫_ℂ + ⟪-(Complex.I • U s (T w)), a s⟫_ℂ =
        -(Complex.I * ⟪U s w, r s⟫_ℂ) := by
      rw [inner_neg_left, inner_smul_left, inner_neg_right, inner_smul_right, inner_add_right,
        hcomm, ← hT, Complex.conj_I]
      ring
    rw [e] at h
    exact h
  have hbound : ∀ s ∈ Ico 0 t, ‖-(Complex.I * ⟪U s w, r s⟫_ℂ)‖ ≤ ‖η‖ * B := by
    intro s hs
    rw [norm_neg, norm_mul, Complex.norm_I, one_mul]
    calc ‖⟪U s w, r s⟫_ℂ‖ ≤ ‖U s w‖ * ‖r s‖ := norm_inner_le_norm _ _
      _ = ‖η‖ * ‖r s‖ := by rw [LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map]
      _ ≤ ‖η‖ * B := mul_le_mul_of_nonneg_left (hB s (Ico_subset_Icc_self hs)) (norm_nonneg _)
  have hmv := norm_image_sub_le_of_norm_deriv_le_segment'
    (fun s _ => (hG s).hasDerivWithinAt) hbound t (right_mem_Icc.mpr ht)
  have hdiff : G t - G 0 = ⟪η, η⟫_ℂ := by
    simp only [G, h0]
    rw [hUw]
    have : ⟪w, a 0⟫_ℂ = ⟪η, U t (a 0)⟫_ℂ := by
      rw [← hUw, LinearIsometryEquiv.inner_map_map]
    rw [this, ← inner_sub_right]
  have hn : ‖⟪η, η⟫_ℂ‖ = ‖η‖ ^ 2 := by
    rw [inner_self_eq_norm_sq_to_K]
    simp
  rw [hdiff, hn, sub_zero] at hmv
