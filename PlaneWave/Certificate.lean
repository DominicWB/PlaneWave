    (he : 0 ≤ e) (hm : 1 ≤ m) (hΞ₁ : 0 ≤ Ξ₁) (hc0 : 0 ≤ c0) (hρ : 0 ≤ ρ) (hρK : ρ ^ 2 * K = 1)
    (hK : 2 ≤ K) (hC : 0 ≤ C) (hCχ : 0 ≤ Cχ) (hτχ : 0 ≤ τχ) (hS0 : 0 ≤ S0) (hCO : 0 ≤ CO)
    (hc1 : 0 ≤ c1) (hc2 : 0 ≤ c2) (ht : 0 ≤ t)
    (hB : B = (2 * m / K ^ 2) * Ξ₁ + c0 * ρ) (htK : tK = (2 * m / K ^ 2) * B)
    (htK' : tK' = (2 * m / (K / 2) ^ 2) * ((2 * m / (K / 2) ^ 2) * Ξ₁ + c0 * (Real.sqrt 2 * ρ)))
