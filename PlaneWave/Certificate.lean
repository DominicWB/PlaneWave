/-!
# Dynamics: the propagator of an operator with compact resolvent

Abstract layer for `thm:dyn`: a self-adjoint operator with compact resolvent, given through its
resolvent `R = (A + c)⁻¹` (compact, symmetric, injective), has a Hilbert basis of eigenvectors,
and the diagonal unitary group `e^{-itA}` on that basis solves the Schrödinger equation on the
domain `ran R`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal
open Module End

namespace PlaneWaveDynamics

universe u

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-! ## Part B: a Hilbert basis of eigenvectors of a compact symmetric operator -/

section Eigenbasis

variable {T : E →L[ℂ] E}

instance (μ : ℂ) : CompleteSpace (eigenspace (T : Module.End ℂ E) μ) :=
  (ContinuousLinearMap.isClosed_eigenspace T μ).completeSpace_coe

omit [CompleteSpace E] in
/-- If `x` is orthogonal to a Hilbert basis of a closed subspace `F`, it is orthogonal to `F`. -/
lemma inner_eq_zero_of_hilbertBasis {F : Submodule ℂ E} [CompleteSpace F] {ι : Type*}
    (b : HilbertBasis ι ℂ F) {x : E} (hx : ∀ i, ⟪x, (b i : E)⟫_ℂ = 0) (y : F) :
    ⟪x, (y : E)⟫_ℂ = 0 := by
  have h1 : HasSum (fun i => (b.repr y i) • (b i : E)) (y : E) := by
    have := (b.hasSum_repr y).mapL F.subtypeL
    simpa using this
  have h2 := h1.mapL (innerSL ℂ x)
  simp only [innerSL_apply_apply, inner_smul_right, hx, mul_zero] at h2
  exact (hasSum_zero.unique h2).symm

/-- **Hilbert basis of eigenvectors.** A compact symmetric operator on a complex Hilbert space
has a Hilbert basis of eigenvectors. -/
theorem exists_eigen_hilbertBasis (hT : IsCompactOperator T)
    (hT' : (T : E →ₗ[ℂ] E).IsSymmetric) :
    ∃ (ι : Type u) (b : HilbertBasis ι ℂ E) (μ : ι → ℂ), ∀ i, T (b i) = μ i • b i := by
  classical
  have hw : ∀ μ : ℂ, ∃ (w : Set (eigenspace (T : Module.End ℂ E) μ))
      (b : HilbertBasis w ℂ (eigenspace (T : Module.End ℂ E) μ)), ⇑b = ((↑) : w → _) :=
    fun μ => exists_hilbertBasis ℂ (eigenspace (T : Module.End ℂ E) μ)
  choose w b' _ using hw
  let v : (Σ μ : ℂ, w μ) → E := fun a => ((b' a.1 a.2 : eigenspace (T : Module.End ℂ E) a.1) : E)
  have hv : Orthonormal ℂ v :=
    hT'.orthogonalFamily_eigenspaces.orthonormal_sigma_orthonormal fun μ => (b' μ).orthonormal
  have hsp : (Submodule.span ℂ (Set.range v))ᗮ = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro x hx
    have hx' : ∀ a, ⟪x, v a⟫_ℂ = 0 := by
      intro a
      have h := (Submodule.mem_orthogonal _ x).mp hx (v a) (Submodule.subset_span ⟨a, rfl⟩)
      rw [← inner_conj_symm, h, map_zero]
    have hmem : x ∈ (⨆ μ, eigenspace (T : Module.End ℂ E) μ)ᗮ := by
      rw [← Submodule.iInf_orthogonal, Submodule.mem_iInf]
      intro μ
      rw [Submodule.mem_orthogonal]
      intro y hy
      have h := inner_eq_zero_of_hilbertBasis (b' μ) (x := x) (fun i => hx' ⟨μ, i⟩) ⟨y, hy⟩
      rw [← inner_conj_symm, h, map_zero]
    rwa [ContinuousLinearMap.orthogonalComplement_iSup_eigenspaces_eq_bot hT hT',
      Submodule.mem_bot] at hmem
  refine ⟨Σ μ : ℂ, w μ, HilbertBasis.mkOfOrthogonalEqBot hv hsp, fun a => a.1, fun a => ?_⟩
  rw [HilbertBasis.coe_mkOfOrthogonalEqBot]
  exact mem_eigenspace_iff.mp (b' a.1 a.2).2

end Eigenbasis

/-! ## Part A: the diagonal unitary group on a Hilbert basis -/

section Diagonal

variable {ι : Type*} (b : HilbertBasis ι ℂ E) (f : ι → ℝ)

/-- The phase factor `e^{-i t f_i}`. -/
noncomputable def phase (t : ℝ) (i : ι) : ℂ := Complex.exp (Complex.I * ((-(t * f i) : ℝ) : ℂ))

lemma norm_phase (t : ℝ) (i : ι) : ‖phase f t i‖ = 1 := by
  rw [phase, Complex.norm_exp]
  simp

lemma phase_add (s t : ℝ) (i : ι) : phase f (s + t) i = phase f s i * phase f t i := by
  rw [phase, phase, phase, ← Complex.exp_add]
  congr 1
  push_cast
  ring

lemma phase_zero (i : ι) : phase f 0 i = 1 := by
  simp [phase]

lemma continuous_phase (i : ι) : Continuous fun t => phase f t i := by
  unfold phase
  fun_prop

omit [CompleteSpace E] in
lemma l2_norm_sq (w : ℓ²(ι, ℂ)) : ‖w‖ ^ 2 = ∑' i, ‖w i‖ ^ 2 := by
  have h := lp.norm_rpow_eq_tsum (p := 2) (by norm_num) w
  simpa [Real.rpow_two] using h

omit [CompleteSpace E] in
lemma l2_summable_sq (w : ℓ²(ι, ℂ)) : Summable fun i => ‖w i‖ ^ 2 := by
  have h := (lp.memℓp w).summable (p := 2) (by norm_num)
  simpa [Real.rpow_two] using h

/-- Multiplication of an `ℓ²` sequence by the phases at time `t`. -/
noncomputable def phaseMulL (t : ℝ) : ℓ²(ι, ℂ) →ₗ[ℂ] ℓ²(ι, ℂ) where
  toFun a := ⟨fun i => phase f t i * a i, (lp.memℓp a).mono' fun i => by
    rw [norm_mul, norm_phase, one_mul]⟩
  map_add' a a' := by
    ext i
    simp [mul_add]
  map_smul' c a := by
    ext i
    simp only [lp.coeFn_smul, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    change phase f t i * (c * a i) = c * (phase f t i * a i)
    ring

omit [CompleteSpace E] in
lemma phaseMulL_apply (t : ℝ) (a : ℓ²(ι, ℂ)) (i : ι) :
    phaseMulL f t a i = phase f t i * a i := rfl

omit [CompleteSpace E] in
lemma norm_phaseMulL (t : ℝ) (a : ℓ²(ι, ℂ)) : ‖phaseMulL f t a‖ = ‖a‖ := by
  have h1 := l2_norm_sq (phaseMulL f t a)
  have h2 := l2_norm_sq a
  simp only [phaseMulL_apply, norm_mul, norm_phase, one_mul] at h1
  rw [← h2] at h1
  exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h1

/-- The phase multiplication as a unitary map of `ℓ²`. -/
noncomputable def phaseMul (t : ℝ) : ℓ²(ι, ℂ) ≃ₗᵢ[ℂ] ℓ²(ι, ℂ) :=
  { toLinearEquiv := LinearEquiv.ofLinear (phaseMulL f t) (phaseMulL f (-t))
      (LinearMap.ext fun a => lp.ext <| funext fun i => by
        simp only [LinearMap.coe_comp, Function.comp_apply, phaseMulL_apply, LinearMap.id_coe,
          id_eq]
        rw [← mul_assoc, ← phase_add, add_neg_cancel, phase_zero, one_mul])
      (LinearMap.ext fun a => lp.ext <| funext fun i => by
        simp only [LinearMap.coe_comp, Function.comp_apply, phaseMulL_apply, LinearMap.id_coe,
          id_eq]
        rw [← mul_assoc, ← phase_add, neg_add_cancel, phase_zero, one_mul])
    norm_map' := norm_phaseMulL f t }

/-- The propagator `e^{-itA}` of the diagonal operator `A b_i = f_i b_i`. -/
noncomputable def prop (t : ℝ) : E ≃ₗᵢ[ℂ] E :=
  (b.repr.trans (phaseMul f t)).trans b.repr.symm

omit [CompleteSpace E] in
lemma repr_prop (t : ℝ) (x : E) (i : ι) :
    b.repr (prop b f t x) i = phase f t i * b.repr x i := by
  simp only [prop, LinearIsometryEquiv.trans_apply, LinearIsometryEquiv.apply_symm_apply]
  rfl

lemma prop_zero (x : E) : prop b f 0 x = x := by
  apply b.repr.injective
  ext i
  rw [repr_prop, phase_zero, one_mul]

lemma prop_add (s t : ℝ) (x : E) : prop b f (s + t) x = prop b f s (prop b f t x) := by
  apply b.repr.injective
  ext i
  rw [repr_prop, repr_prop, repr_prop, phase_add, mul_assoc]

lemma norm_sq_eq_tsum_repr (x : E) : ‖x‖ ^ 2 = ∑' i, ‖b.repr x i‖ ^ 2 := by
  rw [← b.repr.norm_map x]
  exact l2_norm_sq _

lemma summable_repr_sq (x : E) : Summable fun i => ‖b.repr x i‖ ^ 2 :=
  l2_summable_sq _

/-- Strong continuity of the propagator. -/
theorem continuous_prop (x : E) : Continuous fun t => prop b f t x := by
  rw [continuous_iff_continuousAt]
  intro s
  rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
  have key : ∀ t, ‖prop b f t x - prop b f s x‖ ^ 2 =
      ∑' i, ‖phase f t i - phase f s i‖ ^ 2 * ‖b.repr x i‖ ^ 2 := by
    intro t
    rw [norm_sq_eq_tsum_repr b]
    congr 1
    funext i
    rw [map_sub, lp.coeFn_sub, Pi.sub_apply, repr_prop, repr_prop, ← sub_mul, norm_mul, mul_pow]
  have hsum : Filter.Tendsto
      (fun t => ∑' i, ‖phase f t i - phase f s i‖ ^ 2 * ‖b.repr x i‖ ^ 2) (nhds s) (nhds 0) := by
    have h := tendsto_tsum_of_dominated_convergence (𝓕 := nhds s)
      (f := fun t i => ‖phase f t i - phase f s i‖ ^ 2 * ‖b.repr x i‖ ^ 2)
      (g := fun _ => (0 : ℝ)) (bound := fun i => 4 * ‖b.repr x i‖ ^ 2)
      ((summable_repr_sq b x).mul_left 4)
      (fun i => by
        have hc : Continuous fun t => ‖phase f t i - phase f s i‖ ^ 2 * ‖b.repr x i‖ ^ 2 := by
          have := continuous_phase f i
          fun_prop
        have := hc.tendsto s
        simpa using this)
      (Filter.Eventually.of_forall fun t i => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        have h1 : ‖phase f t i - phase f s i‖ ≤ 2 := by
          calc ‖phase f t i - phase f s i‖ ≤ ‖phase f t i‖ + ‖phase f s i‖ := norm_sub_le _ _
            _ = 2 := by rw [norm_phase, norm_phase]; norm_num
        have h2 : ‖phase f t i - phase f s i‖ ^ 2 ≤ 4 := by
          have := pow_le_pow_left₀ (norm_nonneg _) h1 2
          linarith
        exact mul_le_mul_of_nonneg_right h2 (by positivity))
    simpa using h
  have hsqrt := hsum.sqrt
  rw [Real.sqrt_zero] at hsqrt
  refine hsqrt.congr fun t => ?_
  rw [← key, Real.sqrt_sq (norm_nonneg _)]

/-- The phase factor has derivative `-i f_i` at `t = 0`. -/
lemma hasDerivAt_phase (i : ι) :
    HasDerivAt (fun h : ℝ => phase f h i) (-(Complex.I * f i)) 0 := by
  have h1 : HasDerivAt (fun h : ℝ => ((-(h * f i) : ℝ) : ℂ)) ((-(1 * f i) : ℝ) : ℂ) 0 :=
    ((hasDerivAt_id (0 : ℝ)).mul_const (f i)).neg.ofReal_comp
  have h2 := (h1.const_mul Complex.I).cexp
  unfold phase
  convert h2 using 1
  push_cast
  simp

/-- The bound `‖h⁻¹ (e^{-ihf} - 1)‖ ≤ |f|` on the difference quotient of a phase. -/
lemma norm_inv_mul_phase_sub_one_le (h : ℝ) (i : ι) :
    ‖((h⁻¹ : ℝ) : ℂ) * (phase f h i - 1)‖ ≤ |f i| := by
  rcases eq_or_ne h 0 with rfl | hh
  · simp
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have h1 : ‖phase f h i - 1‖ ≤ |h| * |f i| := by
      unfold phase
      have := Real.norm_exp_I_mul_ofReal_sub_one_le (x := -(h * f i))
      rwa [Real.norm_eq_abs, abs_neg, abs_mul] at this
    calc |h⁻¹| * ‖phase f h i - 1‖ ≤ |h⁻¹| * (|h| * |f i|) :=
          mul_le_mul_of_nonneg_left h1 (abs_nonneg _)
      _ = |f i| := by
          rw [← mul_assoc, ← abs_mul, inv_mul_cancel₀ hh, abs_one, one_mul]

/-- **Schrödinger equation.** If `z` has the coordinates `f_i x_i` (that is, `z = A x`), then
`t ↦ e^{-itA} x` is differentiable with derivative `-i e^{-itA} z`. -/
theorem hasDerivAt_prop {x z : E} (hz : ∀ i, b.repr z i = (f i : ℂ) * b.repr x i) (t : ℝ) :
    HasDerivAt (fun s => prop b f s x) (-(Complex.I • prop b f t z)) t := by
  rw [hasDerivAt_iff_tendsto_slope_zero, tendsto_iff_norm_sub_tendsto_zero]
  set q : ℝ → ι → ℂ := fun h i => ((h⁻¹ : ℝ) : ℂ) * (phase f h i - 1) + Complex.I * f i
    with hq
  have hcoord : ∀ (h : ℝ) (i : ι),
      b.repr (h⁻¹ • (prop b f (t + h) x - prop b f t x) - -(Complex.I • prop b f t z)) i =
        phase f t i * q h i * b.repr x i := by
    intro h i
    rw [← Complex.coe_smul]
    simp only [map_sub, map_neg, map_smul, lp.coeFn_sub, lp.coeFn_neg, lp.coeFn_smul,
      Pi.sub_apply, Pi.neg_apply, Pi.smul_apply, smul_eq_mul, repr_prop, hz, phase_add, hq]
    ring
  have key : ∀ h : ℝ,
      ‖h⁻¹ • (prop b f (t + h) x - prop b f t x) - -(Complex.I • prop b f t z)‖ ^ 2 =
        ∑' i, ‖q h i‖ ^ 2 * ‖b.repr x i‖ ^ 2 := by
    intro h
    rw [norm_sq_eq_tsum_repr b]
    congr 1
    funext i
    rw [hcoord, norm_mul, norm_mul, norm_phase, one_mul, mul_pow]
  have hsum : Filter.Tendsto (fun h => ∑' i, ‖q h i‖ ^ 2 * ‖b.repr x i‖ ^ 2)
      (nhdsWithin 0 {0}ᶜ) (nhds 0) := by
    have h := tendsto_tsum_of_dominated_convergence (𝓕 := nhdsWithin (0 : ℝ) {0}ᶜ)
      (f := fun h i => ‖q h i‖ ^ 2 * ‖b.repr x i‖ ^ 2)
      (g := fun _ => (0 : ℝ)) (bound := fun i => 4 * ‖b.repr z i‖ ^ 2)
      ((summable_repr_sq b z).mul_left 4)
      (fun i => by
        have hd := (hasDerivAt_phase f i).tendsto_slope_zero
        simp only [zero_add, phase_zero] at hd
        have hd' : Filter.Tendsto (fun h : ℝ => q h i) (nhdsWithin 0 {0}ᶜ)
            (nhds (-(Complex.I * f i) + Complex.I * f i)) := by
          refine (hd.add_const (Complex.I * f i)).congr fun h => ?_
          simp only [hq]
          rw [← Complex.coe_smul, smul_eq_mul]
        rw [neg_add_cancel] at hd'
        have := ((hd'.norm.pow 2).mul_const (‖b.repr x i‖ ^ 2))
        simpa using this)
      (Filter.Eventually.of_forall fun h i => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        have h1 : ‖q h i‖ ≤ 2 * |f i| := by
          calc ‖q h i‖ ≤ ‖((h⁻¹ : ℝ) : ℂ) * (phase f h i - 1)‖ + ‖Complex.I * f i‖ :=
                norm_add_le _ _
            _ ≤ |f i| + |f i| := by
                gcongr
                · exact norm_inv_mul_phase_sub_one_le f h i
                · rw [norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs]
            _ = 2 * |f i| := by ring
        have h2 : ‖b.repr z i‖ = |f i| * ‖b.repr x i‖ := by
          rw [hz, norm_mul, Complex.norm_real, Real.norm_eq_abs]
        rw [h2]
        have h3 : ‖q h i‖ ^ 2 ≤ (2 * |f i|) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) h1 2
        nlinarith [sq_nonneg ‖b.repr x i‖, sq_nonneg (|f i|)])
    simpa using h
  have hsqrt := hsum.sqrt
  rw [Real.sqrt_zero] at hsqrt
  refine hsqrt.congr fun h => ?_
  rw [← key, Real.sqrt_sq (norm_nonneg _)]

end Diagonal

/-! ## Part C: the propagator of the operator `A = R⁻¹ - c` -/

section Resolvent

variable {R : E →L[ℂ] E} {ι : Type*} (b : HilbertBasis ι ℂ E) (μ : ι → ℂ)

/-- The eigenvalues of a symmetric operator on an eigenbasis are real. -/
lemma eigen_real (hR : (R : E →ₗ[ℂ] E).IsSymmetric) (hb : ∀ i, R (b i) = μ i • b i) (i : ι) :
    ((μ i).re : ℂ) = μ i := by
  have h1 : ⟪b i, R (b i)⟫_ℂ = μ i := by
    rw [hb, inner_smul_right, inner_self_eq_norm_sq_to_K, b.orthonormal.1 i]
    simp
  have h2 : ⟪R (b i), b i⟫_ℂ = conj (μ i) := by
    rw [hb, inner_smul_left, inner_self_eq_norm_sq_to_K, b.orthonormal.1 i]
    simp
  have h3 : ⟪R (b i), b i⟫_ℂ = ⟪b i, R (b i)⟫_ℂ := hR (b i) (b i)
  rw [h1, h2] at h3
  exact Complex.conj_eq_iff_re.mp h3

/-- Coordinates of `R y` in an eigenbasis of a symmetric `R`. -/
lemma repr_apply_of_eigen (hR : (R : E →ₗ[ℂ] E).IsSymmetric) (hb : ∀ i, R (b i) = μ i • b i)
    (y : E) (i : ι) : b.repr (R y) i = μ i * b.repr y i := by
  rw [b.repr_apply_apply, b.repr_apply_apply]
  have h3 : ⟪R (b i), y⟫_ℂ = ⟪b i, R y⟫_ℂ := hR (b i) y
  rw [← h3, hb, inner_smul_left, ← eigen_real b μ hR hb i, Complex.conj_ofReal]

/-- The generator eigenvalues `f_i = 1/μ_i - c` of `A = R⁻¹ - c`. -/
noncomputable def genVal (c : ℝ) (i : ι) : ℝ := ((μ i).re)⁻¹ - c

/-- The propagator commutes with `R`. -/
lemma prop_resolvent_comm (hR : (R : E →ₗ[ℂ] E).IsSymmetric) (hb : ∀ i, R (b i) = μ i • b i)
    (c t : ℝ) (y : E) :
    prop b (genVal μ c) t (R y) = R (prop b (genVal μ c) t y) := by
  apply b.repr.injective
  ext i
  rw [repr_prop, repr_apply_of_eigen b μ hR hb, repr_apply_of_eigen b μ hR hb, repr_prop]
  ring

/-- **Schrödinger equation for `A = R⁻¹ - c`** on the domain `ran R`: for `x = R y`,
`A x = y - c x`, and `t ↦ e^{-itA} x` has derivative `-i e^{-itA} (A x)`. -/
theorem hasDerivAt_prop_resolvent (hR : (R : E →ₗ[ℂ] E).IsSymmetric)
    (hb : ∀ i, R (b i) = μ i • b i) (hμ : ∀ i, μ i ≠ 0) (c : ℝ) (y : E) (t : ℝ) :
    HasDerivAt (fun s => prop b (genVal μ c) s (R y))
      (-(Complex.I • prop b (genVal μ c) t (y - (c : ℂ) • R y))) t := by
  refine hasDerivAt_prop b (genVal μ c) (fun i => ?_) t
  have hμr : μ i = ((μ i).re : ℂ) := (eigen_real b μ hR hb i).symm
  have hre' : (μ i).re ≠ 0 := by
    intro h0
    apply hμ i
    rw [hμr, h0, Complex.ofReal_zero]
  rw [map_sub, map_smul, lp.coeFn_sub, lp.coeFn_smul, Pi.sub_apply, Pi.smul_apply, smul_eq_mul,
    repr_apply_of_eigen b μ hR hb, genVal]
  set r := (μ i).re with hr
  have hrC : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hre'
  rw [hμr]
  push_cast
  field_simp

/-- **Uniqueness.** A differentiable curve in `ran R` that solves the Schrödinger equation of
`A = R⁻¹ - c` is the propagator applied to its initial value. -/
theorem eq_prop_of_hasDerivAt (hR : (R : E →ₗ[ℂ] E).IsSymmetric)
    (hb : ∀ i, R (b i) = μ i • b i) (hμ : ∀ i, μ i ≠ 0) (c : ℝ) {φ η : ℝ → E}
    (hφ : ∀ t, φ t = R (η t))
    (hd : ∀ t, HasDerivAt φ (-(Complex.I • (η t - (c : ℂ) • φ t))) t) (t : ℝ) :
    φ t = prop b (genVal μ c) t (φ 0) := by
  apply b.repr.injective
  ext i
  rw [repr_prop]
  set f := genVal μ c
  set g : ℝ → ℂ := fun s => b.repr (φ s) i with hgdef
  have hμr : μ i = ((μ i).re : ℂ) := (eigen_real b μ hR hb i).symm
  set r : ℝ := (μ i).re with hr
  have hre' : r ≠ 0 := by
    intro h0
    apply hμ i
    rw [hμr, h0, Complex.ofReal_zero]
  have hrC : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hre'
  have hfi : f i = r⁻¹ - c := rfl
  -- the coordinate satisfies `g' = -i f_i g`
  have hg : ∀ s, HasDerivAt g (-(Complex.I * f i) * g s) s := by
    intro s
    have h1 := ((innerSL ℂ (b i)).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt s (hd s)
    have hcoord : ∀ x : E, b.repr x i = ⟪b i, x⟫_ℂ := fun x => b.repr_apply_apply x i
    have hfun : (⇑((innerSL ℂ (b i)).restrictScalars ℝ) ∘ φ) = g := by
      funext s'
      simp only [Function.comp_apply, ContinuousLinearMap.coe_restrictScalars',
        innerSL_apply_apply, hgdef, hcoord]
    have hη : b.repr (η s) i * r = b.repr (φ s) i := by
      have := repr_apply_of_eigen b μ hR hb (η s) i
      rw [← hφ s, hμr] at this
      rw [this, mul_comm]
    have hval : ((innerSL ℂ (b i)).restrictScalars ℝ) (-(Complex.I • (η s - (c : ℂ) • φ s))) =
        -(Complex.I * f i) * g s := by
      simp only [ContinuousLinearMap.coe_restrictScalars', innerSL_apply_apply, inner_neg_right,
        inner_smul_right, inner_sub_right]
      rw [← hcoord, ← hcoord, hfi, hgdef]
      simp only
      rw [← hη]
      push_cast
      field_simp
    rw [hfun, hval] at h1
    exact h1
  -- `e^{i t f_i} g(t)` is constant
  have hw : ∀ s, HasDerivAt (fun s => phase f (-s) i * g s) 0 s := by
    intro s
    have hp : HasDerivAt (fun s : ℝ => phase f (-s) i) (Complex.I * f i * phase f (-s) i) s := by
      unfold phase
      have h1 : HasDerivAt (fun s : ℝ => ((-(-s * f i) : ℝ) : ℂ)) ((-(-(1 : ℝ) * f i) : ℝ) : ℂ)
          s := ((hasDerivAt_id s).neg.mul_const (f i)).neg.ofReal_comp
      have h2 := (h1.const_mul Complex.I).cexp
      convert h2 using 1
      push_cast
      ring
    have h3 := hp.mul (hg s)
    have h0 : Complex.I * (f i : ℂ) * phase f (-s) i * g s +
        phase f (-s) i * (-(Complex.I * (f i : ℂ)) * g s) = 0 := by ring
    rw [h0] at h3
    exact h3
  have hconst := is_const_of_deriv_eq_zero (fun s => (hw s).differentiableAt)
    (fun s => (hw s).deriv) t 0
  simp only [neg_zero, phase_zero, one_mul] at hconst
  have hpt : phase f t i * phase f (-t) i = 1 := by
    rw [← phase_add, add_neg_cancel, phase_zero]
  calc b.repr (φ t) i = phase f t i * (phase f (-t) i * g t) := by
        rw [← mul_assoc, hpt, one_mul]
    _ = phase f t i * b.repr (φ 0) i := by rw [hconst]

end Resolvent

/-! ## Summary: the propagator of an operator with compact resolvent -/

/-- **Propagator of an operator with compact resolvent.** Let `R` be compact, symmetric and
injective, and let `A = R⁻¹ - c` on `ran R`, so that `A (R y) = y - c R y`. There is a strongly
continuous unitary group `U` that commutes with `R` and solves the Schrödinger equation
`d/dt U(t) x = -i A U(t) x` for every `x = R y ∈ ran R` (note `A (U t (R y)) = U t (y - c R y)`),
and every differentiable curve in `ran R` that solves this equation is `U t` applied to its
initial value. -/
theorem exists_propagator {R : E →L[ℂ] E} (hc : IsCompactOperator R)
    (hs : (R : E →ₗ[ℂ] E).IsSymmetric) (hi : Function.Injective R) (c : ℝ) :
    ∃ U : ℝ → E ≃ₗᵢ[ℂ] E,
      (∀ x, U 0 x = x) ∧
      (∀ s t x, U (s + t) x = U s (U t x)) ∧
      (∀ x, Continuous fun t => U t x) ∧
      (∀ t y, U t (R y) = R (U t y)) ∧
      (∀ t y, HasDerivAt (fun s => U s (R y)) (-(Complex.I • U t (y - (c : ℂ) • R y))) t) ∧
      (∀ φ η : ℝ → E, (∀ t, φ t = R (η t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • (η t - (c : ℂ) • φ t))) t) →
        ∀ t, φ t = U t (φ 0)) := by
  obtain ⟨ι, b, μ, hb⟩ := exists_eigen_hilbertBasis hc hs
  have hμ : ∀ i, μ i ≠ 0 := by
    intro i h0
    have h1 : R (b i) = R 0 := by rw [hb, h0, zero_smul, map_zero]
    have h2 := hi h1
    have h3 := b.orthonormal.1 i
    rw [h2, norm_zero] at h3
    exact zero_ne_one h3
  refine ⟨prop b (genVal μ c), prop_zero b _, prop_add b _, continuous_prop b _,
    prop_resolvent_comm b μ hs hb c, fun t y => hasDerivAt_prop_resolvent b μ hs hb hμ c y t, ?_⟩
  intro φ η hφ hd t
  exact eq_prop_of_hasDerivAt b μ hs hb hμ c hφ hd t

end PlaneWaveDynamics

