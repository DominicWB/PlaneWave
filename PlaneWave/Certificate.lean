/-- The Coulomb coefficient on the unrestricted reciprocal lattice. The square
root convention agrees exactly with the existing finite operators. -/
def latticeCoulombKernel (C : ℝ) (q p : Lattice3) : ℂ :=
  (Real.sqrt (latticeCoulombSquareWeight C (latticeSub q p)) : ℝ)

lemma latticeCoulombKernel_of_amplitude_sq
    (gamma : ℝ) (hGamma : 0 ≤ gamma) (q p : Lattice3) :
    latticeCoulombKernel (gamma ^ 2) q p =
