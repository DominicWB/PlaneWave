section DevK2

/-!
# Kinetic-energy observable under Galerkin evolution: `thm:mult-gal`, `cor:stopping`

For a kinetic multiplier `μ` (`0 ≤ μ ≤ A`; e.g. the kinetic energy `A_p` of the projectile) and
`ψ₀ ∈ D(H²)`:

  `|⟨ψ(t), μ ψ(t)⟩ - ⟨ψ_N(t), μ ψ_N(t)⟩| ≤ A₁ K^{-3} + A₂ t K^{-3/2}`

(`eq:mult-gal`), with no smoothing hypothesis and no observable norm in the constants.

* `expect_sub_le`: `|⟨S a, μ a⟩ - ⟨S b, μ b⟩| ≤ ‖S (a - b)‖ (‖μ a‖ + ‖μ b‖)` (the exact linear
  identity with the trivial pairing).
* `kinetic_galerkin_error`: the explicit bound
  `(η t_K)(η B) + C √((η t_K)(η (t_K + 2B))) t (Ξ₀ + T_N)`: the projection term `⟨δ, μ δ⟩`
  (`lem:mult-basic` (i)), the norm-level error of `prop:duhamel`, and the bounds
  `‖μ P ψ(t)‖ ≤ Ξ₀`, `‖μ ψ_N(t)‖ ≤ T_N` (`lem:mult-basic` (ii) with the elliptic estimate in the
  cube and the conservation of `‖H_N ψ_N(t)‖`).
* `kin_rate_arith`, `kinConsts`: the rates at `ρ = K^{-1/2}`, with constants depending only on
  `‖ψ₀‖, ‖H ψ₀‖, ‖H² ψ₀‖` and the system.
* `kinetic_galerkin_position`, `thm_mult_gal`: position space, with the propagators.
* `stopping_galerkin` (`cor:stopping`, Galerkin): the secant slope over `[0, T]` deviates by at
  most `(A₂ K^{-3/2} + 2 A₁ K^{-3}/T)/v_p`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveKinetic

open PlaneWaveCertificate PlaneWaveDynamics

variable {eta : ℕ} {ν : Type} [Fintype ν]

/-! ## The retained-space difference -/

omit [Fintype ν] in
/-- `|⟨S a, μ a⟩ - ⟨S b, μ b⟩| ≤ ‖S a - S b‖ (‖μ a‖ + ‖μ b‖)`. -/
lemma expect_sub_le {sys : CoulombSystem eta ν} {g : ℝ} (m : KinMult sys g)
    (a b : MolecularFourierH2 eta) :
    |m.expect (molecularH2StateMap eta g a) - m.expect (molecularH2StateMap eta g b)| ≤
      ‖molecularH2StateMap eta g a - molecularH2StateMap eta g b‖ * (‖m.h2 a‖ + ‖m.h2 b‖) := by
  have e : ((m.expect (molecularH2StateMap eta g a) - m.expect (molecularH2StateMap eta g b) :
      ℝ) : ℂ) = ⟪molecularH2StateMap eta g a - molecularH2StateMap eta g b, m.h2 a⟫_ℂ +
        ⟪m.h2 b, molecularH2StateMap eta g (a - b)⟫_ℂ := by
    push_cast
    rw [← m.inner_stateMap_h2_self, ← m.inner_stateMap_h2_self, ← m.inner_stateMap_h2,
      map_sub, inner_sub_left, inner_sub_right]
    ring
  have h : ‖((m.expect (molecularH2StateMap eta g a) - m.expect (molecularH2StateMap eta g b) :
      ℝ) : ℂ)‖ ≤ ‖molecularH2StateMap eta g a - molecularH2StateMap eta g b‖ * ‖m.h2 a‖ +
        ‖m.h2 b‖ * ‖molecularH2StateMap eta g a - molecularH2StateMap eta g b‖ := by
    rw [e]
    refine (norm_add_le _ _).trans (add_le_add (norm_inner_le_norm _ _) ?_)
    rw [map_sub]
    exact norm_inner_le_norm _ _
  rw [Complex.norm_real, Real.norm_eq_abs] at h
  linarith

/-! ## The explicit bound on the Fourier side -/

section Fourier

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **The Galerkin kinetic-energy error, explicit form** (`thm:mult-gal`). For `ψ₀ = S u₀ ∈ D(H²)`
(`H u₀ = S v₀`) and a kinetic multiplier `μ`, the expectations of `μ` in `ψ(t) = U t ψ₀` and in
`ψ_N(t) = e^{-iH_N t} P ψ₀` differ by at most
`(η t_K)(η B) + C √((η t_K)(η (t_K + 2B))) t (Ξ₀ + T_N)`, where `B` bounds the kinetic tails and
`t_K = (2m̄/K²) B` the state tails of `ψ(s)` at `K` (uniformly in `s`), `Ξ₀ = 2 ‖H ψ₀‖ + 2b ‖ψ₀‖`
bounds `‖T ψ(t)‖`, and `T_N = 2 (2 Ξ₀ + 2b ‖ψ₀‖) + 2b ‖ψ₀‖` bounds `‖T ψ_N(t)‖`. -/
theorem kinetic_galerkin_error (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK1 : 1 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (m : KinMult sys (2 * Real.pi / L)) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let b := relB sys L Hunit
    let S0 := ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖
    let Ξ₀ := 2 * ‖H u₀‖ + 2 * b * S0
    let B := (2 * sys.maxMass / K ^ 2) * (2 * ‖H v₀‖ + 2 * relB sys L Hunit *
            ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖) +
          finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
            (sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ +
              2 * (2 * ‖H u₀‖ + 2 * relB sys L Hunit *
                ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖))) * rho
    let tK := (2 * sys.maxMass / K ^ 2) * B
    |m.expect (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) -
        m.expect (finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀))))| ≤
      (eta * tK) * (eta * B) + finiteCoulombPhysicalMassConstant sys L Hunit *
        Real.sqrt ((eta * tK) * (eta * (tK + 2 * B))) * t *
          (Ξ₀ + (2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0)) := by
  intro K b S0 Ξ₀ B tK
  have hg : 0 < 2 * Real.pi / L := by positivity
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set T := coulombFourierKineticH2 sys (2 * Real.pi / L)
  have hM := sys.one_le_maxMass
  have hb : 0 ≤ b := relB_nonneg sys L Hunit hC
  -- the state at time `t`
  obtain ⟨u, hu1, hu2⟩ := hgraph t u₀
  rw [← hu1]
  have htails := fun a => tails_at_time sys L H hKernel Hunit hL hPeriodic hC U hgraph a K rho Blow
    Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude hBkerScale hCsScale u₀ v₀ huv t u
    hu1 hu2
  -- the projection term
  have hδS : ‖S u - molecularH2Truncate n (S u)‖ ≤ eta * tK := by
    refine (norm_sub_truncate_le hg n _).trans ?_
    calc ∑ a : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a (S u)‖ ≤
          ∑ _a : Fin eta, tK :=
          Finset.sum_le_sum fun a _ => (htails a).2
      _ = eta * tK := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hδT : ‖T u - molecularH2Truncate n (T u)‖ ≤ eta * B := by
    refine (norm_sub_truncate_le hg n _).trans ?_
    calc ∑ a : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a (T u)‖ ≤
          ∑ _a : Fin eta, B :=
          Finset.sum_le_sum fun a _ => (htails a).1
      _ = eta * B := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have htK0 : 0 ≤ eta * tK := (norm_nonneg _).trans hδS
  have hP1 : m.expect (S (u - molecularH2Truncate n u)) ≤ (eta * tK) * (eta * B) :=
    (m.expect_tail_le n u).trans (mul_le_mul hδS hδT (norm_nonneg _) htK0)
  have hP0 := m.expect_tail_nonneg n u
  -- the retained part
  set x := extractCLM n (S u)
  set y := UN t (extractCLM n (S u₀))
  have hSa : S (molecularH2Truncate n u) = finiteFourierLpIsometry eta n x := by
    rw [stateMap_truncate, emb_extractCLM]
  have hSb : S (cubeLift (2 * Real.pi / L) n y) = finiteFourierLpIsometry eta n y :=
    stateMap_cubeLift (2 * Real.pi / L) n y
  have hdiff := expect_sub_le m (molecularH2Truncate n u) (cubeLift (2 * Real.pi / L) n y)
  rw [hSa, hSb, ← map_sub, LinearIsometry.norm_map] at hdiff
  have hnl := coulomb_normlevel sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph hderiv n UN hN0
    hNadd hNcomm hNderiv rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
    hBkerScale hCsScale u₀ v₀ huv ht
  rw [← hu1] at hnl
  -- the multiplier norms
  have hTu : ‖T u‖ ≤ Ξ₀ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u
    rwa [hu1, hu2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
  have hMa : ‖m.h2 (molecularH2Truncate n u)‖ ≤ Ξ₀ := by
    refine (m.norm_h2_le _).trans ?_
    rw [kinetic_truncate]
    exact (molecularH2Truncate_norm_le n _).trans hTu
  have hMb : ‖m.h2 (cubeLift (2 * Real.pi / L) n y)‖ ≤
      2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0 := by
    refine (m.norm_h2_le _).trans ?_
    have h := elliptic_cube sys L H hKernel Hunit hL hPeriodic hC n y
    have hy : ‖finiteCoulombHamiltonian sys L n y‖ =
        ‖finiteCoulombHamiltonian sys L n (extractCLM n (S u₀))‖ := by
      rw [← hNcomm, LinearIsometryEquiv.norm_map]
    have hy2 : ‖y‖ = ‖extractCLM n (S u₀)‖ := LinearIsometryEquiv.norm_map _ _
    have hH := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n u₀
    have hT0 : ‖T u₀‖ ≤ Ξ₀ := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u₀
    have hE : ‖extractCLM n (S u₀)‖ ≤ S0 := norm_extractCLM_le n (S u₀)
    have hbE : b * ‖extractCLM n (S u₀)‖ ≤ b * S0 := mul_le_mul_of_nonneg_left hE hb
    rw [hy, hy2] at h
    linarith
  have hX0 : 0 ≤ Ξ₀ + (2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0) := by
    have := (norm_nonneg _).trans hMa
    have : 0 ≤ S0 := norm_nonneg _
    positivity
  have hR : |m.expect (finiteFourierLpIsometry eta n x) -
      m.expect (finiteFourierLpIsometry eta n y)| ≤
      finiteCoulombPhysicalMassConstant sys L Hunit *
        Real.sqrt ((eta * tK) * (eta * (tK + 2 * B))) * t *
          (Ξ₀ + (2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0)) :=
    hdiff.trans (mul_le_mul hnl (add_le_add hMa hMb) (add_nonneg (norm_nonneg _) (norm_nonneg _))
      (by positivity))
  -- assembly
  have hsplit := m.expect_split n u
  rw [hSa] at hsplit
  rw [hsplit]
  have e : m.expect (finiteFourierLpIsometry eta n x) + m.expect (S (u - molecularH2Truncate n u)) -
      m.expect (finiteFourierLpIsometry eta n y) =
      m.expect (S (u - molecularH2Truncate n u)) +
        (m.expect (finiteFourierLpIsometry eta n x) -
          m.expect (finiteFourierLpIsometry eta n y)) := by
    ring
  rw [e]
  refine (abs_add_le _ _).trans ?_
  rw [abs_of_nonneg hP0]
  exact add_le_add hP1 hR

end Fourier

/-! ## The rates -/

/-- The arithmetic of the rates: with `ρ² K = 1` and `K ≥ 1`, the explicit bound of
`kinetic_galerkin_error` is at most `A₁ ρ⁶ + A₂ t ρ³`, i.e. `A₁ K^{-3} + A₂ t K^{-3/2}`. -/
lemma kin_rate_arith {e m Ξ₁ c0 ρ K C X t B tK : ℝ}
    (he : 0 ≤ e) (hm : 1 ≤ m) (hΞ₁ : 0 ≤ Ξ₁) (hc0 : 0 ≤ c0) (hρ : 0 ≤ ρ) (hρK : ρ ^ 2 * K = 1)
    (hK : 1 ≤ K) (hC : 0 ≤ C) (hX : 0 ≤ X) (ht : 0 ≤ t)
    (hB : B = (2 * m / K ^ 2) * Ξ₁ + c0 * ρ) (htK : tK = (2 * m / K ^ 2) * B) :
    (e * tK) * (e * B) + C * Real.sqrt ((e * tK) * (e * (tK + 2 * B))) * t * X ≤
      (2 * m * e ^ 2 * (2 * m * Ξ₁ + c0) ^ 2) * ρ ^ 6 +
        (C * e * Real.sqrt (2 * m * (2 * m + 2)) * (2 * m * Ξ₁ + c0) * X) * t * ρ ^ 3 := by
  set β := 2 * m * Ξ₁ + c0 with hβ
  have hm0 : 0 ≤ m := by linarith
  have hβ0 : 0 ≤ β := by positivity
  have hρ2 : ρ ^ 2 ≤ 1 := by nlinarith only [hρK, hK, sq_nonneg ρ]
  have hρ1 : ρ ≤ 1 := by nlinarith only [hρ2, hρ]
  have hKpos : 0 < K := by linarith
  have hK4 : K ^ 2 * ρ ^ 4 = 1 := by
    calc K ^ 2 * ρ ^ 4 = (ρ ^ 2 * K) ^ 2 := by ring
      _ = 1 := by rw [hρK]; norm_num
  have hinv : 2 * m / K ^ 2 = 2 * m * ρ ^ 4 := by
    rw [div_eq_iff (pow_pos hKpos 2).ne']
    linear_combination (-(2 * m)) * hK4
  have hρ4 : ρ ^ 4 ≤ ρ := by
    calc ρ ^ 4 = ρ * ρ ^ 3 := by ring
      _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ hρ1) hρ
      _ = ρ := mul_one _
  have hρ5 : ρ ^ 5 ≤ ρ := by
    calc ρ ^ 5 = ρ * ρ ^ 4 := by ring
      _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ hρ1) hρ
      _ = ρ := mul_one _
  have hB' : B ≤ β * ρ := by
    rw [hB, hinv, hβ]
    have := mul_le_mul_of_nonneg_left hρ4 (mul_nonneg (by linarith : (0:ℝ) ≤ 2 * m) hΞ₁)
    nlinarith only [this]
  have hB0 : 0 ≤ B := by rw [hB, hinv]; positivity
  have htK1 : tK ≤ 2 * m * β * ρ ^ 5 := by
    rw [htK, hinv]
    calc 2 * m * ρ ^ 4 * B ≤ 2 * m * ρ ^ 4 * (β * ρ) :=
          mul_le_mul_of_nonneg_left hB' (by positivity)
      _ = 2 * m * β * ρ ^ 5 := by ring
  have htK0 : 0 ≤ tK := by rw [htK, hinv]; positivity
  -- the projection term
  have h1 : (e * tK) * (e * B) ≤ (2 * m * e ^ 2 * β ^ 2) * ρ ^ 6 := by
    calc (e * tK) * (e * B) ≤ (e * (2 * m * β * ρ ^ 5)) * (e * (β * ρ)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left htK1 he) (mul_le_mul_of_nonneg_left hB' he)
            (mul_nonneg he hB0) (mul_nonneg he (by positivity))
      _ = (2 * m * e ^ 2 * β ^ 2) * ρ ^ 6 := by ring
  -- the retained term
  have hprod : (e * tK) * (e * (tK + 2 * B)) ≤
      (e * β * ρ ^ 3) ^ 2 * (2 * m * (2 * m + 2)) := by
    have hsum : tK + 2 * B ≤ (2 * m + 2) * β * ρ := by
      have := mul_le_mul_of_nonneg_left hρ5 (by positivity : (0:ℝ) ≤ 2 * m * β)
      nlinarith only [htK1, hB', this]
    calc (e * tK) * (e * (tK + 2 * B)) ≤ (e * (2 * m * β * ρ ^ 5)) * (e * ((2 * m + 2) * β * ρ)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left htK1 he) (mul_le_mul_of_nonneg_left hsum he)
            (mul_nonneg he (by positivity)) (mul_nonneg he (by positivity))
      _ = (e * β * ρ ^ 3) ^ 2 * (2 * m * (2 * m + 2)) := by ring
  have hsqrt : Real.sqrt ((e * tK) * (e * (tK + 2 * B))) ≤
      e * β * ρ ^ 3 * Real.sqrt (2 * m * (2 * m + 2)) := by
    calc Real.sqrt ((e * tK) * (e * (tK + 2 * B))) ≤
          Real.sqrt ((e * β * ρ ^ 3) ^ 2 * (2 * m * (2 * m + 2))) := Real.sqrt_le_sqrt hprod
      _ = e * β * ρ ^ 3 * Real.sqrt (2 * m * (2 * m + 2)) := by
          rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by positivity)]
  have h2 : C * Real.sqrt ((e * tK) * (e * (tK + 2 * B))) * t * X ≤
      (C * e * Real.sqrt (2 * m * (2 * m + 2)) * β * X) * t * ρ ^ 3 := by
    calc C * Real.sqrt ((e * tK) * (e * (tK + 2 * B))) * t * X ≤
          C * (e * β * ρ ^ 3 * Real.sqrt (2 * m * (2 * m + 2))) * t * X := by
          gcongr
      _ = (C * e * Real.sqrt (2 * m * (2 * m + 2)) * β * X) * t * ρ ^ 3 := by ring
  linarith

/-! ## Position space -/

section Position

/-- The constants `(A₁, A₂)` of `thm:mult-gal` for the data norms `‖ψ₀‖ = s0`, `‖H ψ₀‖ = hu`,
`‖H² ψ₀‖ = hv`; they do not depend on the cube, the time or the multiplier. -/
noncomputable def kinConsts (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ)
    (s0 hu hv : ℝ) : ℝ × ℝ :=
  let b : ℝ := relB sys L Hunit
  let m : ℝ := sys.maxMass
  let Ξ₀ : ℝ := 2 * hu + 2 * b * s0
  let Ξ₁ : ℝ := 2 * hv + 2 * b * hu
  let c0 : ℝ := finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker (m * (s0 + 2 * Ξ₀))
  let β : ℝ := 2 * m * Ξ₁ + c0
  let X : ℝ := Ξ₀ + (2 * (2 * Ξ₀ + 2 * b * s0) + 2 * b * s0)
  (2 * m * (eta : ℝ) ^ 2 * β ^ 2,
    finiteCoulombPhysicalMassConstant sys L Hunit * eta * Real.sqrt (2 * m * (2 * m + 2)) * β * X)

omit [Fintype ν] in
lemma posExpect_physMap {sys : CoulombSystem eta ν} {g : ℝ} (m : KinMult sys g)
    (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    m.posExpect (physMap eta x) = m.expect x := by
  rw [KinMult.posExpect, LinearIsometryEquiv.symm_apply_apply]

/-- **`thm:mult-gal` in position space.** Let `U t` be unitaries on `L²((T³)^η)` with `U 0 = 1`
that preserve the graph of the Coulomb Hamiltonian and solve the Schrödinger equation on it, and
`U_N` the propagator of `H_N` on the cube of radius `n ≥ 2` with `K = 2πn/L ≥ 1`. For
`ψ₀ ∈ D(H²)` (`H ψ₀ = h₀`, `H h₀ = h₁`) and every kinetic multiplier `μ` (`0 ≤ μ ≤ A`; e.g. the
kinetic energy `A_p` of the projectile),
`|⟨ψ(t), μ ψ(t)⟩ - ⟨ψ_N(t), μ ψ_N(t)⟩| ≤ A₁ K^{-3} + A₂ t K^{-3/2}` for all `t ≥ 0`, with
`(A₁, A₂) = kinConsts` at `(‖ψ₀‖, ‖h₀‖, ‖h₁‖)`. -/
theorem kinetic_galerkin_position (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (hn : 2 ≤ n) (hK1 : 1 ≤ (2 * Real.pi / L) * n)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁)
    (m : KinMult sys (2 * Real.pi / L)) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let ψN := physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n ((physMap eta).symm ψ₀))))
    let A := kinConsts sys L molecularCanonicalUnitHardyConstant
      (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
      (molecularCanonicalKernelConstant L) ‖ψ₀‖ ‖h₀‖ ‖h₁‖
    |m.posExpect (U t ψ₀) - m.posExpect ψN| ≤
      A.1 * (1 / K) ^ 3 + A.2 * t * Real.sqrt (1 / K) ^ 3 := by
  intro K ψN A
  have hPeriodic := canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨H, hKernel, -⟩ :=
    exists_coulombFourierH2Operator sys L molecularCanonicalUnitHardyConstant hL hPeriodic
  have hiff := hasCoulombHamiltonian_iff_phys sys L hL H hKernel
  have hC := finiteCoulombPhysicalMassConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  -- the propagator on the Fourier side
  set UF : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
    fun s => ((physMap eta).trans (U s)).trans (physMap eta).symm with hUFdef
  have hUF : ∀ s x, UF s x = (physMap eta).symm (U s (physMap eta x)) := fun s x => rfl
  have h0F : ∀ x, UF 0 x = x := by
    intro x
    rw [hUF, hU0, LinearIsometryEquiv.symm_apply_apply]
  have hgraphF : ∀ s u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        UF s (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = UF s (H u) := by
    intro s u
    obtain ⟨u', h1, h2⟩ := (hiff _ _).mp (hUgraph s _ _ ((hiff _ _).mpr ⟨u, rfl, rfl⟩))
    refine ⟨u', ?_, ?_⟩
    · rw [hUF, ← h1, LinearIsometryEquiv.symm_apply_apply]
    · rw [hUF, ← h2, LinearIsometryEquiv.symm_apply_apply]
  have hderivF : ∀ s u, HasDerivAt (fun r => UF r (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • UF s (H u))) s := by
    intro s u
    have h := hUderiv s _ _ ((hiff _ _).mpr ⟨u, rfl, rfl⟩)
    have h2 := (((physMap eta).symm.toContinuousLinearEquiv.toContinuousLinearMap).restrictScalars
      ℝ).hasFDerivAt.comp_hasDerivAt s h
    simp only [ContinuousLinearMap.coe_restrictScalars'] at h2
    rw [map_neg, map_smul] at h2
    exact h2
  -- the initial state in `D(H²)`
  obtain ⟨u₀, hu₀1, hu₀2⟩ := (hiff ψ₀ h₀).mp hψ₀
  obtain ⟨v₀, hv₀1, hv₀2⟩ := (hiff h₀ h₁).mp hh₀
  have huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀ :=
    (physMap eta).injective (hu₀2.trans hv₀1.symm)
  -- the canonical constants
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hKpos : 0 < K := by linarith
  obtain ⟨hBlow, hCs, hBker, hLow, hKernelScale, hSobolev⟩ :=
    molecularCanonicalTailConstants_spec L hL
  have hRhoScale : Real.sqrt (1 / K) ^ 2 * K = 1 := by
    rw [Real.sq_sqrt (by positivity)]
    field_simp
  have h2g : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n := by
    have : (2 : ℝ) ≤ n := by exact_mod_cast hn
    nlinarith
  have h := kinetic_galerkin_error sys L H hKernel molecularCanonicalUnitHardyConstant hL hPeriodic
    hC UF h0F hgraphF hderivF n UN hN0 hNadd hNcomm hNderiv (Real.sqrt (1 / K))
    (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
    (molecularCanonicalKernelConstant L) hK1 (Real.sqrt_nonneg _) hRhoScale hBlow hCs hBker h2g
    hLow hKernelScale hSobolev u₀ v₀ huv m ht
