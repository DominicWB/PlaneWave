lemma normalized_eigen_quadratic
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (H : V →ₗ[ℂ] V) (E : ℝ) (u : V)
    (hNorm : ‖u‖ = 1) (hEigen : H u = (E : ℂ) • u) :
    (inner ℂ u (H u)).re = E := by
  rw [hEigen, inner_smul_right, inner_self_eq_norm_sq_to_K]
  simp [hNorm]

end
