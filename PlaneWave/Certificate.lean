/-- The physical kinetic energy of a many-particle reciprocal mode. -/
def molecularKineticEnergySymbol (eta : ℕ) (g : ℝ)
    (p : FourierConfig eta Lattice3) : ℝ :=
  (1 / 2 : ℝ) * (molecularFourierH2Weight eta g p - 1)

lemma molecularKineticEnergySymbol_eq_sum (eta : ℕ) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    molecularKineticEnergySymbol eta g p =
      (1 / 2 : ℝ) * ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) := by
  simp only [molecularKineticEnergySymbol, molecularFourierH2Weight,
    add_sub_cancel_left]

/-- Kinetic energy on the complete weighted H2 coordinate space.  The identity
here acts on weighted coordinates; the state map removes the H2 weight. -/
def molecularFourierKineticH2 (eta : ℕ) (g : ℝ) :
    MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  (1 / 2 : ℂ) •
    (ContinuousLinearMap.id ℂ (MolecularFourierH2 eta) - molecularH2StateMap eta g)

@[simp] theorem molecularFourierKineticH2_apply (eta : ℕ) (g : ℝ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    molecularFourierKineticH2 eta g u p =
      (molecularKineticEnergySymbol eta g p : ℂ) * molecularH2Coeff g u p := by
  change (1 / 2 : ℂ) * (u p - molecularH2StateMap eta g u p) = _
  rw [molecularH2StateMap_apply, ← molecularH2Coeff_weight_mul g u p]
  unfold molecularKineticEnergySymbol
  push_cast
  ring

/-- The completed kinetic term on actual torus L2 states. -/
def molecularPositionKineticH2 (eta : ℕ) (g : ℝ) :
    MolecularFourierH2 eta →L[ℂ] MolecularPositionL2 eta :=
  molecularPositionHamiltonianH2 (molecularFourierKineticH2 eta g)

@[simp] theorem molecularPositionKineticH2_apply (eta : ℕ) (g : ℝ)
    (u : MolecularFourierH2 eta) :
    molecularPositionKineticH2 eta g u =
      molecularPositionSynthesis eta (molecularFourierKineticH2 eta g u) := rfl

/-- Fourier coefficients of the actual state reconstructed from H2 coordinates. -/
theorem molecularPositionH2StateMap_fourierCoeff (eta : ℕ) (g : ℝ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    (molecularPositionSynthesis eta).symm (molecularPositionH2StateMap eta g u) p =
      molecularH2Coeff g u p := by
  rw [molecularPositionH2StateMap_apply, (molecularPositionSynthesis eta).symm_apply_apply,
    molecularH2StateMap_apply]

/-- Exact Fourier coefficients of the position-space kinetic output. -/
theorem molecularPositionKineticH2_fourierCoeff (eta : ℕ) (g : ℝ)
    (u : MolecularFourierH2 eta) (p : FourierConfig eta Lattice3) :
    (molecularPositionSynthesis eta).symm (molecularPositionKineticH2 eta g u) p =
      (molecularKineticEnergySymbol eta g p : ℂ) * molecularH2Coeff g u p := by
  rw [molecularPositionKineticH2_apply, (molecularPositionSynthesis eta).symm_apply_apply]
  exact molecularFourierKineticH2_apply eta g u p

/-- On every Fourier polynomial this is precisely the previously established
physical kinetic kernel, including all output modes outside the input cube. -/
theorem molecularFourierKineticH2_core (eta : ℕ) (L : ℝ)
    (N : ℕ) (u : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    molecularFourierKineticH2 eta (2 * Real.pi / L) (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeKineticKernel eta L) N u q := by
  classical
  rw [molecularFourierKineticH2_apply, molecularH2Coeff_truncate,
    molecularKineticEnergySymbol_eq_sum]
  simp only [fourierCubeKernelAction, molecularLatticeKineticKernel,
    mul_ite, mul_zero, Finset.sum_ite_eq', cubicLatticeCoeffTruncate]
  by_cases hq : q ∈ fourierConfigCube eta N
  · simp only [if_pos hq]
    push_cast
    ring
  · simp only [if_neg hq]

/-- The signed potential part of a completed Fourier Hamiltonian.  Its exact
Coulomb core kernel is proved below; no multiplication identification is assumed. -/
def molecularFourierPotentialH2 {eta : ℕ} (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  H - molecularFourierKineticH2 eta g

/-- An exact split on the full H2 domain, not only on finite Fourier inputs. -/
theorem molecularFourierHamiltonianH2_decomposition {eta : ℕ} (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (u : MolecularFourierH2 eta) :
    H u = molecularFourierKineticH2 eta g u + molecularFourierPotentialH2 g H u := by
  change H u = molecularFourierKineticH2 eta g u + (H u - molecularFourierKineticH2 eta g u)
  abel

/-- The residual has exactly the attractive nuclear plus repulsive electron
kernel on the dense Fourier core. -/
theorem molecularFourierPotentialH2_core
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeHamiltonianKernel eta L data) N u q)
    (N : ℕ) (u : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    molecularFourierPotentialH2 (2 * Real.pi / L) H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (fun q p => molecularLatticeNuclearKernel eta data (coulombCellAmplitude L) q p +
          molecularLatticeElectronKernel eta (coulombCellAmplitude L) q p) N u q := by
  change H (molecularH2Truncate N u) q -
    molecularFourierKineticH2 eta (2 * Real.pi / L) (molecularH2Truncate N u) q = _
  rw [hKernel, molecularFourierKineticH2_core]
  simp only [fourierCubeKernelAction, molecularLatticeHamiltonianKernel,
    mul_add, Finset.sum_add_distrib]
  ring

/-- The corresponding signed potential completion in actual position L2. -/
def molecularPositionPotentialH2 {eta : ℕ} (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    MolecularFourierH2 eta →L[ℂ] MolecularPositionL2 eta :=
  molecularPositionHamiltonianH2 (molecularFourierPotentialH2 g H)

/-- The full position Hamiltonian splits into the explicit kinetic operator
and a continuous potential completion whose Coulomb core was proved above. -/
theorem molecularPositionHamiltonianH2_decomposition {eta : ℕ} (g : ℝ)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (u : MolecularFourierH2 eta) :
    molecularPositionHamiltonianH2 H u =
      molecularPositionKineticH2 eta g u + molecularPositionPotentialH2 g H u := by
  change molecularPositionSynthesis eta (H u) =
    molecularPositionSynthesis eta (molecularFourierKineticH2 eta g u) +
      molecularPositionSynthesis eta (molecularFourierPotentialH2 g H u)
  rw [← map_add]
  exact congrArg (molecularPositionSynthesis eta)
    (molecularFourierHamiltonianH2_decomposition g H u)

end
