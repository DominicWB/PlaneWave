/-! ## One-hundred-twelfth milestone: fermionic-sector variational hypotheses

The manuscript minimizes energy on the antisymmetric sector, whereas the old
`IsGroundEnergy` and `IsGalerkinGroundEnergy` predicates quantify over every
coefficient vector.  Those older results are valid under their stronger
hypotheses, but a fermionic ground energy need not be a lower bound on the
whole tensor-product space.

This section gives the sector-correct finite variational argument.  It proves
that the existing cutoff preserves antisymmetry, uses a normalized Ritz witness
in that same sector, and reuses the previously proved quantitative estimates.
For the current two-register operator, the potential-tail estimate is assembled
independently of any spectral hypothesis before invoking the sector theorem.

This does not prove the continuum background or assemble the full molecular
interaction.  In particular no fermionic spectral hypothesis is inferred from
an unrestricted-space one, and no existence of the required eigenpair is asserted.
-/

/-- Exchange antisymmetry of Fourier coefficients within the blocks of the
particle labelling `lab`: exchanging two distinct registers with equal labels
changes the sign. The constant labelling gives full antisymmetry. The spatial
component of a spin-antisymmetric state with spin pattern `σ` satisfies this
condition for `lab = σ`. For zero or one particle the condition is vacuous. -/
def IsFermionicCoeff
    {eta : ℕ} {μ : Type*} (lab : Fin eta → ℕ) (coeff : FourierConfig eta μ → ℂ) : Prop :=
  ∀ i j : Fin eta, i ≠ j → lab i = lab j → ∀ p : FourierConfig eta μ,
    coeff (swapConfig i j p) = -coeff p

/-- The corresponding condition on a finite coefficient vector. -/
def IsFermionicVector
    {eta : ℕ} (lab : Fin eta → ℕ) {μ : Type*} [Fintype μ]
    (u : EuclideanSpace ℂ (FourierConfig eta μ)) : Prop :=
  IsFermionicCoeff lab (fun p => u.ofLp p)

/-- The discarded set is invariant under exchanging any two registers.
Only the use of the same one-particle cutoff in every register is needed. -/
lemma discardedConfigFinset_swap_mem_iff
    {eta : ℕ} {μ : Type*} [Fintype μ] [DecidableEq μ]
    (K : ℝ) (kabs : μ → ℝ) (i j : Fin eta)
    (p : FourierConfig eta μ) :
    swapConfig i j p ∈ discardedConfigFinset K kabs ↔
      p ∈ discardedConfigFinset K kabs := by
  classical
  simp only [discardedConfigFinset, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨a, ha⟩
    exact ⟨(Equiv.swap i j) a, ha⟩
  · rintro ⟨a, ha⟩
    refine ⟨(Equiv.swap i j) a, ?_⟩
    simpa [swapConfig] using ha

/-! ### Analytic tail estimates extracted independently of spectral hypotheses -/

/-- The compiled low-pass shell count and Schur estimates, assembled as a direct
operator theorem.  This is a low-pass estimate, not a cutoff-growing bound on
the full Coulomb operator. -/
lemma finiteLowPassCoulombOperator_norm_le_of_amplitudeScale
    {eta : ℕ} (r : Fin eta) (K g C Blow : ℝ) (count : ℕ)
    (hK : 0 ≤ K) (hg : 0 < g) (hC : 0 ≤ C) (hBlow : 0 ≤ Blow)
    (h2gK : 2 * g ≤ K) (hAmplitude : 54 * Real.sqrt C ≤ Blow * g)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    ‖referenceKernelConvolutionOperator r (finiteLowPassCoulombKernel K g C count) u‖ ≤
      (Blow * K) * ‖u‖ := by
  have hTransfer : finiteLowPassTransferL1 K g C (2 * count) ≤ Blow * K :=
    (finiteLowPassTransferL1_le_cutoffShellCount_mul K g C (2 * count) hK hg hC).trans
      (lowPassScale_of_amplitudeScale K g C Blow hK hg h2gK hBlow hAmplitude)
  have hRow : HasReferenceKernelRowL1Bound
      (finiteLowPassCoulombKernel K g C count) (Blow * K) := by
    intro v
    exact (finiteLowPassCoulombKernel_rowL1_le_transferL1 K g C count v).trans hTransfer
  have hColumn : HasReferenceKernelColumnL1Bound
      (finiteLowPassCoulombKernel K g C count) (Blow * K) := by
    intro v
    exact (finiteLowPassCoulombKernel_columnL1_le_transferL1 K g C count v).trans hTransfer
  exact referenceKernelConvolutionOperator_norm_le_of_schur r _ (Blow * K)
    (mul_nonneg hBlow hK)
    (referenceConfigurationKernel_rowL1Bound_of_oneParticle r _ _ hRow)
    (referenceConfigurationKernel_columnL1Bound_of_oneParticle r _ _ hColumn) u

/-- The full high-pass estimate, using the existing explicit column, shell, and
slice-Sobolev theorems.  It uses H2 regularity but no eigenpair or Ritz premise. -/
lemma explicitHighPassCoulombOperator_norm_le_of_h2
    {eta : ℕ} (r : Fin eta) (K g C rho Cs Bker M2 : ℝ) (basisExtra : ℕ)
    (coeff : FourierConfig eta
      (FinitePlaneWaveMode (cutoffShellIndex K g + basisExtra)) → ℂ)
    (hK1 : 1 ≤ K) (hg : 0 < g) (hC : 0 ≤ C)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (hBkerScale : 432 * C * g ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / g ^ 4 ≤ Cs ^ 2)
    (hH2 : fullH2Sq (finitePlaneWaveKabs g (cutoffShellIndex K g + basisExtra)) coeff ≤ M2 ^ 2) :
    ‖explicitHighPassCoulombOperator eta r K g C
        (cutoffShellIndex K g + basisExtra) (fullCoeffVector coeff)‖ ≤
      (Cs * Bker * M2) * rho := by
  let m := cutoffShellIndex K g
  let count := m + basisExtra
  let transfers := coulombTransferShellCount m basisExtra
  let Q := finiteHighPassKernelTailSq K g C m transfers
  let kabs := finitePlaneWaveKabs g count
  let kernel := finiteHighPassCoulombKernel K g C count
  let A := explicitHighPassCoulombOperator eta r K g C count
  have hK : 0 ≤ K := le_trans (by norm_num : (0 : ℝ) ≤ 1) hK1
  have hQ : 0 ≤ Q := finiteHighPassKernelTailSq_nonneg K g C m transfers hC
  have hColumnSq : HasReferenceKernelColumnSqBound kernel Q :=
    finiteHighPassCoulombKernel_hasColumnSqBound K g C m basisExtra hC
  have hColumn := referenceSliceKernelColumnNormBound_of_sq r kernel Q hQ hColumnSq
  have hExpansion := explicitHighPassCoulombOperator_hasExpansion eta r K g C count coeff
  have hAtoms := hasSliceKernelAtomRepresentation_of_referenceKernel
    r kernel A coeff (Real.sqrt Q) hExpansion hColumn
  have hHolder := sliceHolderBound_of_sqrt_kernel_atom_representation
    (outerConfigOf r) A coeff Q hQ hAtoms
  have hOne := finitePlaneWave_hasOneParticleInverseH2WeightBound g Cs count hg hCsScale
  have hWeight := sliceInverseH2WeightBound_of_oneParticleBound r kabs Cs hOne
  have hSobolev := sliceSobolevBound_of_inverseH2Weight (outerConfigOf r) kabs coeff Cs hWeight
  have hSlice := highPassSliceBound_of_slice_holder_sobolev (outerConfigOf r)
    kabs A coeff (sliceFourierL1Sq (outerConfigOf r) coeff) Cs Q hQ hHolder hSobolev
  rcases cutoffShellIndex_placement K g hK hg with ⟨hUpper, hLower⟩
  have hCutBudget := cutoff_and_budget_from_shell_index_placement K g C Bker m
    hK (le_of_lt hg) hC hUpper hLower hBkerScale
  have hBelow := all_earlier_cubic_shells_below_half_cutoff K g m hCutBudget.1
  have hCover := finiteHighPassKernelTailSq_shell_cover K g C m transfers hC hBelow
  have hDecay := finiteShellMass_decay_on_range cubicSupShell
    (latticeCoulombSquareWeight C) 54 C m transfers (by norm_num) hC
    cubicSupShell_hasQuadraticShellCount (cubicSupShell_hasInverseFourthCoulombWeight C hC)
  have hKernelTail := kernel_tail_bound_from_inverse_square_shells K Q Bker (54 * C)
    (finiteShellMass cubicSupShell (latticeCoulombSquareWeight C)) m transfers
    hK (mul_nonneg (by norm_num) hC) hCover hDecay hCutBudget.2
  exact high_pass_bound_from_kernel_and_slice K rho Cs Bker M2 Q kabs coeff A
    hK1 hRho hRhoScale hCs hBker hM2 hQ hKernelTail hH2 hSlice

/-!
## One-hundred-twelfth milestone: assumption audit

The fermionic variational predicates are now different from the earlier
unrestricted-space predicates.  The lower-bound proof tests the fermionic Ritz
minimizer, and the upper-bound proof tests the retained fermionic target.
The invariance of the coefficient mask under all particle exchanges is proved,
not supplied as a spectral assumption.  No spectral gap or nondegeneracy is used.

The main specialization introduces neither hPotential nor hPT as an extra
assumption: its form estimate and its tail estimate are assembled from the
already proved Coulomb estimates and the agreed scalar remainder/H2 inputs.
The main theorem does not use bo_onehundredeleven_milestone, because that theorem
retains the stronger unrestricted-space ground and Ritz hypotheses.  Instead it
uses bo_eighth_milestone only after proving the two required variational
inequalities within the antisymmetric sector.

The numerical K^-3 and basis-scale constants are unchanged.  The existing
cutoff and planeWaveBasisScale conventions are also unchanged; this section is
not a new identification of a spherical cutoff with the manuscript's cubic one.

The generic sector theorem accepts any symmetric finite W once its tail and
form estimates are supplied.  The current background-specialized theorem still
uses finiteTwoRegisterCoulombPotential.  Signed electron--nucleus assembly,
electron--electron pair transfers, their full tail estimate, and the final
physical/continuum interpretation are not supplied by this sector correction.
They must not be replaced by an identification with the two-register model.
-/

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

open MeasureTheory

/-! ## One-hundred-thirteenth milestone: signed nuclear and momentum-conserving pair assembly

The manuscript uses phi_p(r) = exp(-i k_p.r)/sqrt(Omega).  With output index v
and input index u, a nucleus at normalized position R/L therefore contributes
exp(+2*pi*i*(v-u).R/L), not its conjugate.  We retain this phase and the
attractive minus sign.  Electron--electron terms conserve the SUM of the two
integer lattice momenta and leave all other registers unchanged.  Both input
and output are in the original finite mode type: there is no cyclic wrapping.

This section constructs the full finite fixed-nucleus potential and proves its
symmetry.  The nuclear H1/form bound is also proved, uniformly in basis size,
from the existing one-particle estimate.  No electron--electron H1 or tail
estimate is assumed or claimed here.  Those pair estimates are the next use of
the exact conserved-momentum fibers constructed below.  In particular the old
two-register error theorem is not relabeled as a full molecular error theorem.
-/

/-! ### A literal finite coefficient action -/

/-- Matrix action with output-first kernel convention. -/
noncomputable def finiteCoefficientKernelOperator
    {ι : Type*} [Fintype ι] (kernel : ι → ι → ℂ) :
    EuclideanSpace ℂ ι →ₗ[ℂ] EuclideanSpace ℂ ι where
  toFun u := WithLp.toLp 2 (fun q => ∑ p : ι, u.ofLp p * kernel q p)
  map_add' := by
    intro u v
    ext q
    simp [add_mul, Finset.sum_add_distrib]
  map_smul' := by
    intro z u
    ext q
    simp [smul_eq_mul, mul_assoc, Finset.mul_sum]

@[simp] lemma finiteCoefficientKernelOperator_apply
    {ι : Type*} [Fintype ι] (kernel : ι → ι → ℂ)
    (u : EuclideanSpace ℂ ι) (q : ι) :
    (finiteCoefficientKernelOperator kernel u).ofLp q =
      ∑ p : ι, u.ofLp p * kernel q p := by
  rfl

lemma finiteCoefficientKernelOperator_isSymmetric
    {ι : Type*} [Fintype ι] (kernel : ι → ι → ℂ)
    (h : ∀ q p, (starRingEnd ℂ) (kernel q p) = kernel p q) :
    (finiteCoefficientKernelOperator kernel).IsSymmetric := by
  exact coefficientKernelAction_isSymmetric _ kernel
    (finiteCoefficientKernelOperator_apply kernel) h

/-! ### The signed electron--nucleus coefficients -/

/-- Positions are on the unit torus, i.e. the physical positions divided by L.
Zero charges are allowed; strictly positive physical charges are a special case. -/
structure FiniteBONuclearData (ν : Type*) where
  charge : ν → ℝ
  charge_nonneg : ∀ ell, 0 ≤ charge ell
  position : ν → UnitTorus3

noncomputable def FiniteBONuclearData.totalCharge
    {ν : Type*} [Fintype ν] (data : FiniteBONuclearData ν) : ℝ :=
  ∑ ell : ν, data.charge ell

lemma FiniteBONuclearData.totalCharge_nonneg
    {ν : Type*} [Fintype ν] (data : FiniteBONuclearData ν) :
    0 ≤ data.totalCharge := by
  exact Finset.sum_nonneg (fun ell _ => data.charge_nonneg ell)

/-- Positive-character value at the normalized nuclear position. -/
noncomputable def finiteNuclearFourierPhase
    (count : ℕ) (R : UnitTorus3) (v : FinitePlaneWaveMode count) : ℂ :=
  UnitAddTorus.mFourier (finitePlaneWaveLatticeIndex count v) R

/-- The continuous-character supremum bound suffices for coefficient domination. -/
lemma finiteNuclearFourierPhase_norm_le_one
    (count : ℕ) (R : UnitTorus3) (v : FinitePlaneWaveMode count) :
    ‖finiteNuclearFourierPhase count R v‖ ≤ 1 := by
  exact (ContinuousMap.norm_coe_le_norm
    (UnitAddTorus.mFourier (finitePlaneWaveLatticeIndex count v)) R).trans_eq
      UnitAddTorus.mFourier_norm

/-- Gauge factors combine into the character of the actual integer transfer. -/
lemma finiteNuclearFourierPhase_transfer
    (count : ℕ) (R : UnitTorus3) (v u : FinitePlaneWaveMode count) :
    finiteNuclearFourierPhase count R v *
        (starRingEnd ℂ) (finiteNuclearFourierPhase count R u) =
      UnitAddTorus.mFourier (finitePlaneWaveTransfer count v u) R := by
  have hTransfer : finitePlaneWaveTransfer count v u =
      finitePlaneWaveLatticeIndex count v + (-finitePlaneWaveLatticeIndex count u) := by
    funext k
    simp [finitePlaneWaveTransfer, latticeSub, sub_eq_add_neg]
  rw [hTransfer, UnitAddTorus.mFourier_add, UnitAddTorus.mFourier_neg]
  rfl

/-- The translated Coulomb kernel before multiplication by the nuclear charge.
C remains the squared-strength parameter used by the earlier Coulomb estimates. -/
noncomputable def finiteTranslatedCoulombKernel
    (C : ℝ) (count : ℕ) (R : UnitTorus3)
    (v u : FinitePlaneWaveMode count) : ℂ :=
  (finiteNuclearFourierPhase count R v *
    (starRingEnd ℂ) (finiteNuclearFourierPhase count R u)) *
      finiteCoulombKernel C count v u

lemma finiteTranslatedCoulombKernel_eq_transfer_character
    (C : ℝ) (count : ℕ) (R : UnitTorus3)
    (v u : FinitePlaneWaveMode count) :
    finiteTranslatedCoulombKernel C count R v u =
      UnitAddTorus.mFourier (finitePlaneWaveTransfer count v u) R *
        finiteCoulombKernel C count v u := by
  unfold finiteTranslatedCoulombKernel
  rw [finiteNuclearFourierPhase_transfer]

lemma finiteTranslatedCoulombKernel_conj_swap
    (C : ℝ) (count : ℕ) (R : UnitTorus3)
    (v u : FinitePlaneWaveMode count) :
    (starRingEnd ℂ) (finiteTranslatedCoulombKernel C count R v u) =
      finiteTranslatedCoulombKernel C count R u v := by
  unfold finiteTranslatedCoulombKernel
  simp only [map_mul, starRingEnd_self_apply, finiteCoulombKernel_conj_swap]
  ring

/-- No position-dependent factor enters the Coulomb majorant. -/
lemma finiteTranslatedCoulombKernel_norm_le
    (C : ℝ) (count : ℕ) (R : UnitTorus3)
    (v u : FinitePlaneWaveMode count) :
    ‖finiteTranslatedCoulombKernel C count R v u‖ ≤
      Real.sqrt (finiteCoulombDifferenceSquareWeight C count v u) := by
  have hPhase : ‖finiteNuclearFourierPhase count R v‖ *
      ‖finiteNuclearFourierPhase count R u‖ ≤ 1 := by
    calc
      _ ≤ 1 * 1 := mul_le_mul
        (finiteNuclearFourierPhase_norm_le_one count R v)
        (finiteNuclearFourierPhase_norm_le_one count R u) (norm_nonneg _) (by norm_num)
      _ = 1 := one_mul 1
  have hKernel : ‖finiteCoulombKernel C count v u‖ =
      Real.sqrt (finiteCoulombDifferenceSquareWeight C count v u) := by
    simp [finiteCoulombKernel, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.sqrt_nonneg _)]
  have hConj : ‖(starRingEnd ℂ) (finiteNuclearFourierPhase count R u)‖ =
      ‖finiteNuclearFourierPhase count R u‖ := by simp
  unfold finiteTranslatedCoulombKernel
  rw [norm_mul, norm_mul, hConj, hKernel]
  exact (mul_le_mul_of_nonneg_right hPhase (Real.sqrt_nonneg _)).trans_eq (one_mul _)

@[simp] lemma finiteCoulombKernel_diagonal
    (C : ℝ) (count : ℕ) (v : FinitePlaneWaveMode count) :
    finiteCoulombKernel C count v v = 0 := by
  simp [finiteCoulombKernel, finiteCoulombDifferenceSquareWeight,
    finitePlaneWaveTransfer_self, latticeCoulombSquareWeight, latticeNormSq]

/-- The attractive, signed one-nucleus coefficient in the manuscript convention. -/
noncomputable def finiteElectronNuclearKernel
    {ν : Type*} (data : FiniteBONuclearData ν)
    (gamma : ℝ) (count : ℕ) (ell : ν)
    (v u : FinitePlaneWaveMode count) : ℂ :=
  (-(data.charge ell : ℂ)) *
    finiteTranslatedCoulombKernel (gamma ^ 2) count (data.position ell) v u

lemma finiteElectronNuclearKernel_conj_swap
    {ν : Type*} (data : FiniteBONuclearData ν)
    (gamma : ℝ) (count : ℕ) (ell : ν) (v u : FinitePlaneWaveMode count) :
    (starRingEnd ℂ) (finiteElectronNuclearKernel data gamma count ell v u) =
      finiteElectronNuclearKernel data gamma count ell u v := by
  simp [finiteElectronNuclearKernel, finiteTranslatedCoulombKernel_conj_swap]

@[simp] lemma finiteElectronNuclearKernel_diagonal
    {ν : Type*} (data : FiniteBONuclearData ν)
    (gamma : ℝ) (count : ℕ) (ell : ν) (v : FinitePlaneWaveMode count) :
    finiteElectronNuclearKernel data gamma count ell v v = 0 := by
  simp [finiteElectronNuclearKernel, finiteTranslatedCoulombKernel]

/-- Multiplication by a scalar coefficient commutes with the reference-register
kernel lift.  This is an equality of actual complex operators. -/
lemma referenceKernelConvolutionOperator_smul_kernel
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (r : Fin eta) (z : ℂ) (kernel : μ → μ → ℂ) :
    referenceKernelConvolutionOperator r (fun v u => z * kernel v u) =
      z • referenceKernelConvolutionOperator r kernel := by
  classical
  apply LinearMap.ext
  intro u
  ext q
  change (referenceKernelConvolutionOperator r (fun v w => z * kernel v w) u).ofLp q =
    z * (referenceKernelConvolutionOperator r kernel u).ofLp q
  have hq := referenceSliceConfig_of_outerConfig_eq r (outerConfigOf r q) q rfl
  rw [← hq, referenceKernelConvolutionOperator_apply_referenceSlice,
    referenceKernelConvolutionOperator_apply_referenceSlice, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro w hw
  ring

/-- All electrons interact with all nuclei, with the attractive sign retained. -/
noncomputable def finiteElectronNuclearPotential
    {ν : Type*} [Fintype ν] (eta : ℕ)
    (data : FiniteBONuclearData ν) (gamma : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  ∑ i : Fin eta, ∑ ell : ν,
    referenceKernelConvolutionOperator i (finiteElectronNuclearKernel data gamma count ell)

lemma finiteElectronNuclearPotential_isSymmetric
    {ν : Type*} [Fintype ν] (eta : ℕ)
    (data : FiniteBONuclearData ν) (gamma : ℝ) (count : ℕ) :
    (finiteElectronNuclearPotential eta data gamma count).IsSymmetric := by
  unfold finiteElectronNuclearPotential
  apply LinearMap.isSymmetric_sum
  intro i hi
  apply LinearMap.isSymmetric_sum
  intro ell hell
  exact referenceKernelConvolutionOperator_isSymmetric_of_conj i _
    (finiteElectronNuclearKernel_conj_swap data gamma count ell)

/-! ### Uniform H1 and form estimates for the assembled nuclear interaction -/

lemma hasH1OperatorBound_smul_complex
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ)
    (A : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ))
    (z : ℂ) {B : ℝ} (hA : HasH1OperatorBound kabs A B) :
    HasH1OperatorBound kabs (z • A) (‖z‖ * B) := by
  intro u
  change ‖z • A u‖ ^ 2 ≤ (‖z‖ * B) ^ 2 * fourierH1Sq kabs u
  rw [norm_smul, mul_pow, mul_pow]
  calc
    ‖z‖ ^ 2 * ‖A u‖ ^ 2 ≤ ‖z‖ ^ 2 * (B ^ 2 * fourierH1Sq kabs u) :=
      mul_le_mul_of_nonneg_left (hA u) (sq_nonneg _)
    _ = _ := by ring

/-- A finite sum of H1-bounded operators has the sum of the unsquared constants.
No factor equal to the number of terms is lost by squaring early. -/
lemma hasH1OperatorBound_finset_sum
    {eta : ℕ} {μ ι : Type*} [Fintype μ]
    (kabs : μ → ℝ) (s : Finset ι)
    (A : ι → EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ))
    (B : ι → ℝ) (hB : ∀ i ∈ s, 0 ≤ B i)
    (hA : ∀ i ∈ s, HasH1OperatorBound kabs (A i) (B i)) :
    HasH1OperatorBound kabs (∑ i ∈ s, A i) (∑ i ∈ s, B i) := by
  classical
  intro u
  have hN : ‖(∑ i ∈ s, A i) u‖ ≤
      (∑ i ∈ s, B i) * Real.sqrt (fourierH1Sq kabs u) := by
    calc
      ‖(∑ i ∈ s, A i) u‖ = ‖∑ i ∈ s, A i u‖ := by
        rw [LinearMap.sum_apply]
      _ ≤ ∑ i ∈ s, ‖A i u‖ := norm_sum_le _ _
      _ ≤ ∑ i ∈ s, B i * Real.sqrt (fourierH1Sq kabs u) := by
        apply Finset.sum_le_sum
        intro i hi
        exact norm_le_sqrt_fourierH1Sq_of_operatorBound kabs (A i)
          (hB i hi) (hA i hi) u
      _ = (∑ i ∈ s, B i) * Real.sqrt (fourierH1Sq kabs u) :=
        (Finset.sum_mul s B _).symm
  have hSq := sq_le_sq_of_nonneg (norm_nonneg _) hN
  rw [mul_pow, Real.sq_sqrt (fourierH1Sq_nonneg kabs u)] at hSq
  exact hSq

lemma finiteTranslatedCoulombOperator_h1Bound
    {eta : ℕ} (r : Fin eta) (g C B : ℝ) (count : ℕ) (R : UnitTorus3)
    (hOne : HasOneParticleCoulombH1Bound g C B count) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (referenceKernelConvolutionOperator r (finiteTranslatedCoulombKernel C count R)) B := by
  apply referenceKernelConvolutionOperator_h1Bound_of_oneParticle
  intro a
  exact coulomb_dominated_kernel_oneParticle_h1 g C B count _
    (finiteTranslatedCoulombKernel_norm_le C count R) hOne a

lemma finiteElectronNuclearTerm_h1Bound
    {ν : Type*} {eta : ℕ} (r : Fin eta) (data : FiniteBONuclearData ν)
    (g gamma B : ℝ) (count : ℕ) (ell : ν)
    (hOne : HasOneParticleCoulombH1Bound g (gamma ^ 2) B count) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (referenceKernelConvolutionOperator r (finiteElectronNuclearKernel data gamma count ell))
      (data.charge ell * B) := by
  unfold finiteElectronNuclearKernel
  rw [referenceKernelConvolutionOperator_smul_kernel]
  have h := hasH1OperatorBound_smul_complex (finitePlaneWaveKabs g count) _
    (-(data.charge ell : ℂ))
    (finiteTranslatedCoulombOperator_h1Bound r g (gamma ^ 2) B count
      (data.position ell) hOne)
  simpa only [norm_neg, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (data.charge_nonneg ell)] using h

/-- The full nuclear contribution has H1 constant eta * totalCharge * B.
The constant is independent of the nuclear positions and of the finite cutoff. -/
lemma finiteElectronNuclearPotential_h1Bound
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (g gamma B : ℝ) (count : ℕ) (hB : 0 ≤ B)
    (hOne : HasOneParticleCoulombH1Bound g (gamma ^ 2) B count) :
    HasH1OperatorBound (finitePlaneWaveKabs g count)
      (finiteElectronNuclearPotential eta data gamma count)
      ((eta : ℝ) * data.totalCharge * B) := by
  classical
  have hChargeB : ∀ ell : ν, 0 ≤ data.charge ell * B :=
    fun ell => mul_nonneg (data.charge_nonneg ell) hB
  have hInner : ∀ i : Fin eta, HasH1OperatorBound (finitePlaneWaveKabs g count)
      (∑ ell : ν, referenceKernelConvolutionOperator i
        (finiteElectronNuclearKernel data gamma count ell))
      (∑ ell : ν, data.charge ell * B) := by
    intro i
    exact hasH1OperatorBound_finset_sum (finitePlaneWaveKabs g count) Finset.univ _ _
      (fun ell _ => hChargeB ell)
      (fun ell _ => finiteElectronNuclearTerm_h1Bound i data g gamma B count ell hOne)
  have hTotal := hasH1OperatorBound_finset_sum (finitePlaneWaveKabs g count)
    (Finset.univ : Finset (Fin eta))
    (fun i => ∑ ell : ν, referenceKernelConvolutionOperator i
      (finiteElectronNuclearKernel data gamma count ell))
    (fun _ => ∑ ell : ν, data.charge ell * B)
    (fun i _ => Finset.sum_nonneg (fun ell _ => hChargeB ell))
    (fun i _ => hInner i)
  have hBudget : (∑ _i : Fin eta, ∑ ell : ν, data.charge ell * B) =
      (eta : ℝ) * data.totalCharge * B := by
    rw [← Finset.sum_mul]
    simp [FiniteBONuclearData.totalCharge, mul_assoc]
  rw [hBudget] at hTotal
  exact hTotal

/-! ### Actual two-electron transfers and their conserved-momentum fibers -/

/-- Spectator momenta outside the selected pair, together with the EXACT total
integer pair momentum.  This is not total momentum modulo the register size. -/
noncomputable def finiteElectronPairSliceLabel
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (p : FourierConfig eta (FinitePlaneWaveMode count)) :
    ({k : Fin eta // k ≠ i ∧ k ≠ j} → FinitePlaneWaveMode count) × Lattice3 :=
  ((fun k => p k.1),
    finitePlaneWaveLatticeIndex count (p i) + finitePlaneWaveLatticeIndex count (p j))

/-- In a conserved-momentum fiber, one electron momentum determines the other.
This is the injectivity needed by the subsequent one-particle norm reduction. -/
lemma finiteElectronPairSliceLabel_with_first_injective
    {eta : ℕ} (i j : Fin eta) (hij : i ≠ j) (count : ℕ) :
    Function.Injective (fun p : FourierConfig eta (FinitePlaneWaveMode count) =>
      (finiteElectronPairSliceLabel i j count p, p i)) := by
  intro p q hpq
  have hLabel := congrArg Prod.fst hpq
  have hFirst : p i = q i := congrArg Prod.snd hpq
  have hSpectator : (fun k : {k : Fin eta // k ≠ i ∧ k ≠ j} => p k.1) =
      (fun k : {k : Fin eta // k ≠ i ∧ k ≠ j} => q k.1) := congrArg Prod.fst hLabel
  have hTotal : finitePlaneWaveLatticeIndex count (p i) +
      finitePlaneWaveLatticeIndex count (p j) =
      finitePlaneWaveLatticeIndex count (q i) + finitePlaneWaveLatticeIndex count (q j) :=
    congrArg Prod.snd hLabel
  have hSecond : p j = q j := by
    apply finitePlaneWaveLatticeIndex_injective count
    rw [hFirst] at hTotal
    exact add_left_cancel hTotal
  funext k
  by_cases hki : k = i
  · simpa only [hki] using hFirst
  · by_cases hkj : k = j
    · simpa only [hkj] using hSecond
    · exact congrFun hSpectator ⟨k, hki, hkj⟩

lemma finiteElectronPairSliceLabel_eq_iff
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p ↔
      (∀ k : Fin eta, k ≠ i → k ≠ j → q k = p k) ∧
        (finitePlaneWaveLatticeIndex count (q i) + finitePlaneWaveLatticeIndex count (q j) =
          finitePlaneWaveLatticeIndex count (p i) + finitePlaneWaveLatticeIndex count (p j)) := by
  constructor
  · intro h
    refine ⟨?_, congrArg Prod.snd h⟩
    intro k hki hkj
    exact congrFun (congrArg Prod.fst h) ⟨k, hki, hkj⟩
  · rintro ⟨hOther, hSum⟩
    apply Prod.ext
    · funext k
      exact hOther k.1 k.2.1 k.2.2
    · exact hSum

/-- Conservation of total pair momentum is equivalent to opposite integer
transfers on the two affected registers. -/
lemma finiteElectronPairSliceLabel_opposite_transfers
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count))
    (h : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p) :
    finitePlaneWaveTransfer count (q i) (p i) =
      -finitePlaneWaveTransfer count (q j) (p j) := by
  have hTotal := ((finiteElectronPairSliceLabel_eq_iff i j count q p).mp h).2
  funext k
  have hk := congrFun hTotal k
  simp only [Pi.add_apply] at hk
  change finitePlaneWaveLatticeIndex count (q i) k - finitePlaneWaveLatticeIndex count (p i) k =
    -(finitePlaneWaveLatticeIndex count (q j) k - finitePlaneWaveLatticeIndex count (p j) k)
  omega

/-- A genuine pair-interaction coefficient.  It changes two momenta with
opposite transfers and keeps every other register fixed. -/
noncomputable def finiteElectronPairConfigurationKernel
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) : ℂ := by
  classical
  exact if finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
    then finiteCoulombKernel C count (q i) (p i) else 0

lemma finiteElectronPairConfigurationKernel_of_same_fiber
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count))
    (h : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p) :
    finiteElectronPairConfigurationKernel i j C count q p =
      finiteCoulombKernel C count (q i) (p i) := by
  simp only [finiteElectronPairConfigurationKernel, if_pos h]

lemma finiteElectronPairConfigurationKernel_of_other_fiber
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count))
    (h : finiteElectronPairSliceLabel i j count q ≠ finiteElectronPairSliceLabel i j count p) :
    finiteElectronPairConfigurationKernel i j C count q p = 0 := by
  simp only [finiteElectronPairConfigurationKernel, if_neg h]

lemma finiteElectronPairConfigurationKernel_conj_swap
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) :
    (starRingEnd ℂ) (finiteElectronPairConfigurationKernel i j C count q p) =
      finiteElectronPairConfigurationKernel i j C count p q := by
  classical
  by_cases h : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
  · rw [finiteElectronPairConfigurationKernel_of_same_fiber i j C count q p h,
      finiteElectronPairConfigurationKernel_of_same_fiber i j C count p q h.symm]
    exact finiteCoulombKernel_conj_swap C count (q i) (p i)
  · simp only [finiteElectronPairConfigurationKernel_of_other_fiber i j C count q p h,
      finiteElectronPairConfigurationKernel_of_other_fiber i j C count p q (Ne.symm h), map_zero]

@[simp] lemma finiteElectronPairConfigurationKernel_diagonal
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ)
    (p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteElectronPairConfigurationKernel i j C count p p = 0 := by
  simp [finiteElectronPairConfigurationKernel]

/-- Exchanging the two named electrons preserves the conserved-momentum
relation.  This will allow unordered-pair reindexing under particle exchange. -/
lemma finiteElectronPairSliceLabel_eq_swap_iff
    {eta : ℕ} (i j : Fin eta) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p ↔
      finiteElectronPairSliceLabel j i count q = finiteElectronPairSliceLabel j i count p := by
  rw [finiteElectronPairSliceLabel_eq_iff, finiteElectronPairSliceLabel_eq_iff]
  constructor
  · rintro ⟨hOther, hTotal⟩
    refine ⟨(fun k hkj hki => hOther k hki hkj), ?_⟩
    calc
      finitePlaneWaveLatticeIndex count (q j) + finitePlaneWaveLatticeIndex count (q i) =
          finitePlaneWaveLatticeIndex count (q i) + finitePlaneWaveLatticeIndex count (q j) :=
        add_comm _ _
      _ = finitePlaneWaveLatticeIndex count (p i) + finitePlaneWaveLatticeIndex count (p j) := hTotal
      _ = finitePlaneWaveLatticeIndex count (p j) + finitePlaneWaveLatticeIndex count (p i) :=
        add_comm _ _
  · rintro ⟨hOther, hTotal⟩
    refine ⟨(fun k hki hkj => hOther k hkj hki), ?_⟩
    calc
      finitePlaneWaveLatticeIndex count (q i) + finitePlaneWaveLatticeIndex count (q j) =
          finitePlaneWaveLatticeIndex count (q j) + finitePlaneWaveLatticeIndex count (q i) :=
        add_comm _ _
      _ = finitePlaneWaveLatticeIndex count (p j) + finitePlaneWaveLatticeIndex count (p i) := hTotal
      _ = finitePlaneWaveLatticeIndex count (p i) + finitePlaneWaveLatticeIndex count (p j) :=
        add_comm _ _

/-- A pair is physically unordered: either electron gives the same Coulomb
amplitude because its transfer is the negative of the other one's transfer. -/
lemma finiteElectronPairConfigurationKernel_swap_particles
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteElectronPairConfigurationKernel i j C count q p =
      finiteElectronPairConfigurationKernel j i C count q p := by
  classical
  by_cases h : finiteElectronPairSliceLabel i j count q = finiteElectronPairSliceLabel i j count p
  · have hBack := (finiteElectronPairSliceLabel_eq_swap_iff i j count q p).mp h
    rw [finiteElectronPairConfigurationKernel_of_same_fiber i j C count q p h,
      finiteElectronPairConfigurationKernel_of_same_fiber j i C count q p hBack]
    have hTransfer := finiteElectronPairSliceLabel_opposite_transfers i j count q p h
    have hNorm : latticeNormSq (finitePlaneWaveTransfer count (q i) (p i)) =
        latticeNormSq (finitePlaneWaveTransfer count (q j) (p j)) := by
      rw [hTransfer]
      simp [latticeNormSq]
    unfold finiteCoulombKernel finiteCoulombDifferenceSquareWeight latticeCoulombSquareWeight
    rw [hNorm]
  · have hBack : finiteElectronPairSliceLabel j i count q ≠ finiteElectronPairSliceLabel j i count p := by
      intro hBack
      exact h ((finiteElectronPairSliceLabel_eq_swap_iff i j count q p).mpr hBack)
    rw [finiteElectronPairConfigurationKernel_of_other_fiber i j C count q p h,
      finiteElectronPairConfigurationKernel_of_other_fiber j i C count q p hBack]

noncomputable def finiteElectronPairCoulombOperator
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  finiteCoefficientKernelOperator (finiteElectronPairConfigurationKernel i j C count)

@[simp] lemma finiteElectronPairCoulombOperator_apply
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    (finiteElectronPairCoulombOperator i j C count u).ofLp q =
      ∑ p, u.ofLp p * finiteElectronPairConfigurationKernel i j C count q p := by
  rfl

lemma finiteElectronPairCoulombOperator_isSymmetric
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ) :
    (finiteElectronPairCoulombOperator i j C count).IsSymmetric := by
  exact finiteCoefficientKernelOperator_isSymmetric _
    (finiteElectronPairConfigurationKernel_conj_swap i j C count)

/-- The operator is independent of the order used to name its two electrons. -/
lemma finiteElectronPairCoulombOperator_swap_particles
    {eta : ℕ} (i j : Fin eta) (C : ℝ) (count : ℕ) :
    finiteElectronPairCoulombOperator i j C count =
      finiteElectronPairCoulombOperator j i C count := by
  unfold finiteElectronPairCoulombOperator
  apply congrArg finiteCoefficientKernelOperator
  funext q p
  exact finiteElectronPairConfigurationKernel_swap_particles i j C count q p

/-- Every unordered electron pair is represented exactly once by i < j. -/
abbrev FiniteElectronPair (eta : ℕ) :=
  {ij : Fin eta × Fin eta // ij.1 < ij.2}

/-- All repulsive electron--electron terms; no ordered-pair factor two. -/
noncomputable def finiteElectronElectronPotential
    (eta : ℕ) (gamma : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  ∑ pair : FiniteElectronPair eta,
    finiteElectronPairCoulombOperator pair.1.1 pair.1.2 (gamma ^ 2) count

lemma finiteElectronElectronPotential_isSymmetric
    (eta : ℕ) (gamma : ℝ) (count : ℕ) :
    (finiteElectronElectronPotential eta gamma count).IsSymmetric := by
  unfold finiteElectronElectronPotential
  apply LinearMap.isSymmetric_sum
  intro pair hpair
  exact finiteElectronPairCoulombOperator_isSymmetric pair.1.1 pair.1.2 (gamma ^ 2) count

/-! ### Full fixed-nucleus finite potential and physical cell normalization -/

/-- The full finite fixed-nucleus interaction: negative nuclear attractions on
all electron registers plus the repulsion on all unordered electron pairs.
The constant nuclear--nuclear energy is omitted, as in the manuscript. -/
noncomputable def finiteMolecularCoulombPotential
    {ν : Type*} [Fintype ν] (eta : ℕ)
    (data : FiniteBONuclearData ν) (gamma : ℝ) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  finiteElectronNuclearPotential eta data gamma count +
    finiteElectronElectronPotential eta gamma count

lemma finiteMolecularCoulombPotential_isSymmetric
    {ν : Type*} [Fintype ν] (eta : ℕ)
    (data : FiniteBONuclearData ν) (gamma : ℝ) (count : ℕ) :
    (finiteMolecularCoulombPotential eta data gamma count).IsSymmetric := by
  exact (finiteElectronNuclearPotential_isSymmetric eta data gamma count).add
    (finiteElectronElectronPotential_isSymmetric eta gamma count)

/-- The physical coefficient in front of 1/|nu|^2 for a cube of side L. -/
noncomputable def coulombCellAmplitude (L : ℝ) : ℝ := 1 / (Real.pi * L)

lemma coulombCellAmplitude_pos {L : ℝ} (hL : 0 < L) :
    0 < coulombCellAmplitude L := by
  exact one_div_pos.mpr (mul_pos Real.pi_pos hL)

/-- The physical finite Hamiltonian, with the same sign convention as Eq. Hper
of the source manuscript.  This is not yet a continuum-to-finite identification. -/
noncomputable def finiteMolecularBOHamiltonian
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  boHamiltonian (finitePlaneWaveKabs (2 * Real.pi / L) count)
    (finiteMolecularCoulombPotential eta data (coulombCellAmplitude L) count)

lemma finiteMolecularBOHamiltonian_isSymmetric
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (count : ℕ) :
    (finiteMolecularBOHamiltonian eta L data count).IsSymmetric := by
  exact boHamiltonian_isSymmetric _ _
    (finiteMolecularCoulombPotential_isSymmetric eta data (coulombCellAmplitude L) count)

