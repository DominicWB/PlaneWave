noncomputable section

/-! ## Eighty-fifth milestone: explicit Fourier main-gradient states -/

/--
The radial cutoff is measurable.  This is used to turn it into an explicit
bounded multiplier on the centered fundamental cube.
-/
lemma centeredCube3RadialCutoff_measurable
    (rho R : ℝ) :
    Measurable (centeredCube3RadialCutoff rho R) := by
  unfold centeredCube3RadialCutoff

  have hRadius :
      Measurable centeredCube3Radius :=
    centeredCube3Radius_measurable

  have hInnerSet :
      MeasurableSet
        {y : CenteredCube3 | centeredCube3Radius y ≤ rho} :=
    measurableSet_Iic.preimage hRadius

  have hOuterSet :
      MeasurableSet
        {y : CenteredCube3 | R ≤ centeredCube3Radius y} :=
    measurableSet_Ici.preimage hRadius

  have hAnnulus :
      Measurable
        (fun y : CenteredCube3 =>
          (R - centeredCube3Radius y) / (R - rho)) := by
    exact
      (hRadius.const_sub R).div_const (R - rho)

  exact
    Measurable.ite hInnerSet measurable_const
      (Measurable.ite hOuterSet measurable_const hAnnulus)

/-- The linear radial cutoff is nonnegative whenever `rho < R`. -/
lemma centeredCube3RadialCutoff_nonneg
    {rho R : ℝ}
    (hRhoR : rho < R)
    (y : CenteredCube3) :
    0 ≤ centeredCube3RadialCutoff rho R y := by
  unfold centeredCube3RadialCutoff
  by_cases hInner : centeredCube3Radius y ≤ rho
  · simp [hInner]
  · by_cases hOuter : R ≤ centeredCube3Radius y
    · simp [hInner, hOuter]
    · simp only [if_neg hInner, if_neg hOuter]
      have hNum : 0 ≤ R - centeredCube3Radius y := by
        have hlt : centeredCube3Radius y < R := lt_of_not_ge hOuter
        linarith
      have hDen : 0 ≤ R - rho := by
        linarith
      exact div_nonneg hNum hDen

/-- The linear radial cutoff is at most one whenever `rho < R`. -/
lemma centeredCube3RadialCutoff_le_one
    {rho R : ℝ}
    (hRhoR : rho < R)
    (y : CenteredCube3) :
    centeredCube3RadialCutoff rho R y ≤ 1 := by
  unfold centeredCube3RadialCutoff
  by_cases hInner : centeredCube3Radius y ≤ rho
  · simp [hInner]
  · by_cases hOuter : R ≤ centeredCube3Radius y
    · simp [hInner, hOuter]
    · simp only [if_neg hInner, if_neg hOuter]
      have hDen : 0 < R - rho := sub_pos.mpr hRhoR
      apply (div_le_iff₀ hDen).2
      have hrho : rho < centeredCube3Radius y := lt_of_not_ge hInner
      linarith

/--
The explicit radial cutoff, viewed as a complex-valued centered-cube
multiplier, has operator bound one.
-/
noncomputable def centeredCube3RadialCutoffMultiplier
    (rho R : ℝ)
    (hRhoR : rho < R) :
    CenteredCube3BoundedMultiplier 1 where

  multiplier :=
    fun y : CenteredCube3 =>
      (centeredCube3RadialCutoff rho R y : ℂ)

  multiplier_aestronglyMeasurable :=
    (centeredCube3RadialCutoff_measurable rho R).complex_ofReal.aestronglyMeasurable

  bound_nonneg := by
    norm_num

  norm_le := by
    intro y
    simp only [Complex.norm_real, Real.norm_eq_abs]
    rw [abs_of_nonneg
      (centeredCube3RadialCutoff_nonneg hRhoR y)]
    exact centeredCube3RadialCutoff_le_one hRhoR y

/--
The coefficient of the `j`-th ordinary derivative of a unit-torus Fourier
polynomial.  For the mode `exp(2*pi*i*n.x)` this is `2*pi*i*n_j` times the
original coefficient.
-/
noncomputable def torus3FourierPartialCoeff
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (p : α) : ℂ :=
  Complex.I *
    (((2 * Real.pi * (index p j : ℝ)) : ℝ) : ℂ) *
    f p

/-- The concrete finite Fourier polynomial representing `partial_j psi`. -/
noncomputable def torus3FourierPartial
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) : UnitTorus3L2 :=
  torus3FourierPolynomial index
    (torus3FourierPartialCoeff index f j)

/--
Exact Parseval norm of one coordinate Fourier derivative.
-/
lemma torus3FourierPartial_norm_sq
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ)
    (j : Fin 3) :
    ‖torus3FourierPartial index f j‖ ^ 2
      =
    (2 * Real.pi) ^ 2 *
      (∑ p : α,
        (index p j : ℝ) ^ 2 * ‖f p‖ ^ 2) := by
  unfold torus3FourierPartial
  rw [torus3FourierPolynomial_norm_sq index hInjective]
  unfold finiteSupportL2Sq
  unfold torus3FourierPartialCoeff
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p hp
  simp only [norm_mul, Complex.norm_I, Complex.norm_real,
    Real.norm_eq_abs, one_mul, mul_pow, sq_abs]
  ring

/-- The sum of the three coordinate squares is `latticeNormSq`. -/
lemma sum_lattice_coordinate_sq
    (nu : Lattice3) :
    (∑ j : Fin 3, (nu j : ℝ) ^ 2) = latticeNormSq nu := by
  simp [Fin.sum_univ_succ, latticeNormSq, add_assoc]

/--
Summing the exact Parseval identities for the three coordinate derivatives
recovers the spectral gradient mass, including the physical `(2*pi)^2`
factor for the unit torus.
-/
lemma torus3FourierPartial_sum_norm_sq
    {α : Type}
    [Fintype α]
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ) :
    (∑ j : Fin 3,
        ‖torus3FourierPartial index f j‖ ^ 2)
      =
    (2 * Real.pi) ^ 2 *
      torus3FourierGradientSq
        (torus3FourierPolynomial index f) := by

  rw [
    torus3FourierGradientSq_fourierPolynomial
      index hInjective f
  ]

  calc
    (∑ j : Fin 3,
        ‖torus3FourierPartial index f j‖ ^ 2)
        =
      ∑ j : Fin 3,
        (2 * Real.pi) ^ 2 *
          (∑ p : α,
            (index p j : ℝ) ^ 2 * ‖f p‖ ^ 2) := by
          apply Finset.sum_congr rfl
          intro j hj
          exact torus3FourierPartial_norm_sq
            index hInjective f j
    _ =
      (2 * Real.pi) ^ 2 *
        (∑ j : Fin 3,
          ∑ p : α,
            (index p j : ℝ) ^ 2 * ‖f p‖ ^ 2) := by
          rw [Finset.mul_sum]
    _ =
      (2 * Real.pi) ^ 2 *
        (∑ p : α,
          ∑ j : Fin 3,
            (index p j : ℝ) ^ 2 * ‖f p‖ ^ 2) := by
          rw [Finset.sum_comm]
    _ =
      (2 * Real.pi) ^ 2 * finiteSupportGradSq index f := by
          congr 1
          unfold finiteSupportGradSq
          apply Finset.sum_congr rfl
          intro p hp
          rw [← Finset.sum_mul]
          rw [sum_lattice_coordinate_sq]

/--
The explicit main term `chi * partial_j psi` in the gradient product rule.
The derivative is first built on the torus, transported isometrically to the
centered cube, and then multiplied by the radial cutoff.
-/
noncomputable def centeredCube3RadialCutoffMainGradientState
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) : CenteredCube3L2 :=
  (centeredCube3RadialCutoffMultiplier rho R hRhoR).productState
    (centeredCube3StateFromTorus
      (torus3FourierPartial index f j))

/--
Multiplication by the radial cutoff cannot increase the sum of the three
Fourier-derivative `L²` norms.  Parseval therefore proves the entire
`main_gradient_sq_bound` field from milestone 84.
-/
lemma centeredCube3RadialCutoffMainGradientState_sum_norm_sq_le
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (hInjective : Function.Injective index)
    (f : α → ℂ) :
    (∑ j : Fin 3,
        ‖centeredCube3RadialCutoffMainGradientState
            rho R hRhoR index f j‖ ^ 2)
      ≤
    ((2 * Real.pi) ^ 2) *
      torus3FourierGradientSq
        (torus3FourierPolynomial index f) := by

  have hComponent :
      ∀ j : Fin 3,
        ‖centeredCube3RadialCutoffMainGradientState
            rho R hRhoR index f j‖ ^ 2
          ≤
        ‖torus3FourierPartial index f j‖ ^ 2 := by
    intro j
    unfold centeredCube3RadialCutoffMainGradientState
    have hBound :=
      (centeredCube3RadialCutoffMultiplier
        rho R hRhoR).productState_norm_sq_le
          (centeredCube3StateFromTorus
            (torus3FourierPartial index f j))
    rw [centeredCube3StateFromTorus_norm] at hBound
    simpa using hBound

  calc
    (∑ j : Fin 3,
        ‖centeredCube3RadialCutoffMainGradientState
            rho R hRhoR index f j‖ ^ 2)
        ≤
      ∑ j : Fin 3,
        ‖torus3FourierPartial index f j‖ ^ 2 := by
          apply Finset.sum_le_sum
          intro j hj
          exact hComponent j
    _ =
      ((2 * Real.pi) ^ 2) *
        torus3FourierGradientSq
          (torus3FourierPolynomial index f) :=
      torus3FourierPartial_sum_norm_sq
        index hInjective f

end

end PlaneWaveCertificate

namespace PlaneWaveCertificate

noncomputable section

/-! ## Eighty-sixth milestone: explicit radial-cutoff gradient states -/

/--
Every coordinate of a point in the centered cube is bounded in absolute
value by its Euclidean radius.
-/
lemma centeredCube3_abs_coord_le_radius
    (y : CenteredCube3)
    (j : Fin 3) :
    |(y.1 j : ℝ)| ≤ centeredCube3Radius y := by

  have hsq :
      (y.1 j : ℝ) ^ 2 ≤ centeredCube3RadiusSq y := by
    unfold centeredCube3RadiusSq
    exact
      Finset.single_le_sum
        (fun i hi => sq_nonneg (y.1 i))
        (Finset.mem_univ j)

  have hrSq :
      centeredCube3Radius y ^ 2 = centeredCube3RadiusSq y := by
    unfold centeredCube3Radius
    exact Real.sq_sqrt (centeredCube3RadiusSq_nonneg y)

  have habsSq :
      |(y.1 j : ℝ)| ^ 2 = (y.1 j : ℝ) ^ 2 := by
    exact sq_abs (y.1 j : ℝ)

  have habs0 : 0 ≤ |(y.1 j : ℝ)| := abs_nonneg _
  have hr0 : 0 ≤ centeredCube3Radius y := centeredCube3Radius_nonneg y

  rw [← hrSq] at hsq
  rw [← habsSq] at hsq
  nlinarith

/--
The `j`-th a.e. derivative of the piecewise-linear radial cutoff.

On the annulus `rho < |y| < R`,

`partial_j chi = - y_j / ((R-rho) |y|)`,

and it is set to zero on the inner and outer constant regions.  The sphere
boundaries are irrelevant for the eventual weak-gradient statement.
-/
noncomputable def centeredCube3RadialCutoffPartial
    (rho R : ℝ)
    (j : Fin 3)
    (y : CenteredCube3) : ℝ :=
  if centeredCube3Radius y ≤ rho then
    0
  else if R ≤ centeredCube3Radius y then
    0
  else
    (-(y.1 j : ℝ) * centeredCube3InverseRadius y) / (R - rho)

lemma centeredCube3RadialCutoffPartial_measurable
    (rho R : ℝ)
    (j : Fin 3) :
    Measurable (centeredCube3RadialCutoffPartial rho R j) := by

  unfold centeredCube3RadialCutoffPartial

  have hRadius :
      Measurable centeredCube3Radius :=
    centeredCube3Radius_measurable

  have hInnerSet :
      MeasurableSet
        {y : CenteredCube3 | centeredCube3Radius y ≤ rho} :=
    measurableSet_Iic.preimage hRadius

  have hOuterSet :
      MeasurableSet
        {y : CenteredCube3 | R ≤ centeredCube3Radius y} :=
    measurableSet_Ici.preimage hRadius

  have hCoord :
      Measurable (fun y : CenteredCube3 => (y.1 j : ℝ)) :=
    (measurable_pi_apply j).comp measurable_subtype_coe

  have hAnnulus :
      Measurable
        (fun y : CenteredCube3 =>
          (-(y.1 j : ℝ) * centeredCube3InverseRadius y) /
            (R - rho)) := by
    exact
      (hCoord.neg.mul centeredCube3InverseRadius_measurable).div_const
        (R - rho)

  exact
    Measurable.ite hInnerSet measurable_const
      (Measurable.ite hOuterSet measurable_const hAnnulus)

/--
Each coordinate derivative of the radial cutoff is bounded by
`1 / (R-rho)`.  We deliberately use this coordinatewise estimate below;
summing the three coordinates costs only a harmless factor `3` and avoids
introducing a separate vector-valued `L²` Fubini interface.
-/
lemma centeredCube3RadialCutoffPartial_abs_le
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (j : Fin 3)
    (y : CenteredCube3) :
    |centeredCube3RadialCutoffPartial rho R j y|
      ≤ 1 / (R - rho) := by

  unfold centeredCube3RadialCutoffPartial

  have hRhoRle : rho ≤ R := le_of_lt hRhoR

  by_cases hInner : centeredCube3Radius y ≤ rho
  · simp [hInner, hRhoRle]

  · by_cases hOuter : R ≤ centeredCube3Radius y
    · simp [hInner, hOuter, hRhoRle]

    · simp only [if_neg hInner, if_neg hOuter]

      have hRadiusPos :
          0 < centeredCube3Radius y := by
        have hrhoRadius : rho < centeredCube3Radius y := lt_of_not_ge hInner
        exact lt_trans hrho hrhoRadius

      have hGapPos : 0 < R - rho := sub_pos.mpr hRhoR

      have hInvNonneg :
          0 ≤ centeredCube3InverseRadius y := by
        rw [centeredCube3InverseRadius_eq_one_div_radius]
        exact one_div_nonneg.mpr (le_of_lt hRadiusPos)

      have hCoord :
          |(y.1 j : ℝ)| ≤ centeredCube3Radius y :=
        centeredCube3_abs_coord_le_radius y j

      have hRatio :
          |(y.1 j : ℝ)| * centeredCube3InverseRadius y ≤ 1 := by
        rw [centeredCube3InverseRadius_eq_one_div_radius]
        have hDiv :
            |(y.1 j : ℝ)| / centeredCube3Radius y ≤ 1 :=
          (div_le_one hRadiusPos).2 hCoord
        simpa [div_eq_mul_inv] using hDiv

      rw [abs_div, abs_mul, abs_neg]
      rw [abs_of_nonneg hInvNonneg]
      rw [abs_of_pos hGapPos]

      exact (div_le_div_iff_of_pos_right hGapPos).2 hRatio

/--
The `j`-th cutoff derivative as a bounded complex multiplier.
-/
noncomputable def centeredCube3RadialCutoffPartialMultiplier
    (rho R : ℝ)
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (j : Fin 3) :
    CenteredCube3BoundedMultiplier (1 / (R - rho)) where

  multiplier :=
    fun y : CenteredCube3 =>
      (centeredCube3RadialCutoffPartial rho R j y : ℂ)

  multiplier_aestronglyMeasurable :=
    (centeredCube3RadialCutoffPartial_measurable rho R j).complex_ofReal.aestronglyMeasurable

  bound_nonneg := by
    exact one_div_nonneg.mpr
      (sub_nonneg.mpr (le_of_lt hRhoR))

  norm_le := by
    intro y
    simp only [Complex.norm_real, Real.norm_eq_abs]
    exact centeredCube3RadialCutoffPartial_abs_le hrho hRhoR j y

/--
The explicit `(partial_j chi) * psi` term of the cutoff product rule.
-/
noncomputable def centeredCube3RadialCutoffGradientState
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) : CenteredCube3L2 :=
  (centeredCube3RadialCutoffPartialMultiplier
      rho R hrho hRhoR j).productState
    (centeredCube3StateFromTorus
      (torus3FourierPolynomial index f))

/--
The three explicit cutoff-gradient components satisfy the coarse but fully
sufficient estimate

`sum_j ||(partial_j chi) psi||_2^2
   <= 3 (R-rho)^(-2) ||psi||_2^2`.
-/
lemma centeredCube3RadialCutoffGradientState_sum_norm_sq_le
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hrho : 0 < rho)
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ) :
    (∑ j : Fin 3,
        ‖centeredCube3RadialCutoffGradientState
            rho R hrho hRhoR index f j‖ ^ 2)
      ≤
    3 * (1 / (R - rho)) ^ 2 *
      ‖torus3FourierPolynomial index f‖ ^ 2 := by

  have hComponent :
      ∀ j : Fin 3,
        ‖centeredCube3RadialCutoffGradientState
            rho R hrho hRhoR index f j‖ ^ 2
          ≤
        (1 / (R - rho)) ^ 2 *
          ‖torus3FourierPolynomial index f‖ ^ 2 := by
    intro j
    unfold centeredCube3RadialCutoffGradientState
    have hBound :=
      (centeredCube3RadialCutoffPartialMultiplier
        rho R hrho hRhoR j).productState_norm_sq_le
          (centeredCube3StateFromTorus
            (torus3FourierPolynomial index f))
    rw [centeredCube3StateFromTorus_norm] at hBound
    exact hBound

  calc
    (∑ j : Fin 3,
        ‖centeredCube3RadialCutoffGradientState
            rho R hrho hRhoR index f j‖ ^ 2)
        ≤
      ∑ j : Fin 3,
        ((1 / (R - rho)) ^ 2 *
          ‖torus3FourierPolynomial index f‖ ^ 2) := by
            apply Finset.sum_le_sum
            intro j hj
            exact hComponent j
    _ =
      3 * (1 / (R - rho)) ^ 2 *
        ‖torus3FourierPolynomial index f‖ ^ 2 := by
          simp [Fin.sum_univ_succ]
          ring

/--
A slightly coarser explicit inner Hardy constant.  The only difference from
milestone 83 is the harmless factor `3` multiplying the cutoff-gradient
budget.
-/
noncomputable def centeredCube3RadialCutoffAinnerCoarse
    (rho R : ℝ) : ℝ :=
  Real.sqrt
    (8 *
      ((2 * Real.pi) ^ 2 +
        3 * (1 / (R - rho)) ^ 2))

lemma centeredCube3RadialCutoffAinnerCoarse_sq
    (rho R : ℝ) :
    centeredCube3RadialCutoffAinnerCoarse rho R ^ 2
      =
    8 *
      ((2 * Real.pi) ^ 2 +
        3 * (1 / (R - rho)) ^ 2) := by
  unfold centeredCube3RadialCutoffAinnerCoarse
  rw [Real.sq_sqrt]
  exact
    mul_nonneg (by norm_num)
      (add_nonneg
        (sq_nonneg (2 * Real.pi))
        (mul_nonneg (by norm_num)
          (sq_nonneg (1 / (R - rho)))))

/--
After both product-rule terms have been made explicit, the only remaining
near-origin analytic statement is Hardy applied to their assembled formal
gradient.
-/
structure CenteredCube3RadialCutoffExplicitGradientData
    (rho R : ℝ) where

  rho_pos : 0 < rho
  rho_lt_outer : rho < R
  outer_lt_half : R < (1 / 2 : ℝ)

  localizedState :
    ∀ (α : Type) [Fintype α],
      (α → Lattice3) → (α → ℂ) → CenteredCube3L2

  localized_eq_ae :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          ∀ᵐ y : CenteredCube3 ∂centeredCube3Measure,
            localizedState α index f y
              =
            (centeredCube3InverseRadius y : ℂ) *
              (centeredCube3RadialCutoff rho R y : ℂ) *
              torus3FourierPolynomial index f
                (unitTorus3CenteredEquiv.symm y)

  hardy_norm_sq_le_explicit_gradient :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖localizedState α index f‖ ^ 2
            ≤
          4 *
            (∑ j : Fin 3,
              ‖centeredCube3RadialCutoffMainGradientState
                    rho R rho_lt_outer index f j +
                  centeredCube3RadialCutoffGradientState
                    rho R rho_pos rho_lt_outer index f j‖ ^ 2)

/--
The explicit-gradient data imply milestone 82's localized Hardy bound, now
with no remaining product-rule norm hypotheses.
-/
noncomputable def
    CenteredCube3RadialCutoffExplicitGradientData.toRadialCutoffHardyData
    {rho R : ℝ}
    (data : CenteredCube3RadialCutoffExplicitGradientData rho R) :
    CenteredCube3RadialCutoffHardyData
      rho R (centeredCube3RadialCutoffAinnerCoarse rho R) where

  rho_pos := data.rho_pos
  rho_lt_outer := data.rho_lt_outer
  outer_lt_half := data.outer_lt_half
  localizedState := data.localizedState
  localized_eq_ae := data.localized_eq_ae

  localized_norm_sq_le_h1 := by
    intro α inst index hInjective f

    let ψ : UnitTorus3L2 :=
      torus3FourierPolynomial index f
    let N : ℝ := ‖ψ‖ ^ 2
    let G : ℝ := torus3FourierGradientSq ψ
    let Q : ℝ := N + G
    let P2 : ℝ := (2 * Real.pi) ^ 2
    let D2 : ℝ := (1 / (R - rho)) ^ 2

    have hN0 : 0 ≤ N := by
      dsimp [N]
      exact sq_nonneg _

    have hG0 : 0 ≤ G := by
      dsimp [G, ψ]
      exact
        torus3FourierGradientSq_nonneg
          (torus3FourierPolynomial index f)

    have hQ0 : 0 ≤ Q := by
      dsimp [Q]
      exact add_nonneg hN0 hG0

    have hNleQ : N ≤ Q := by
      dsimp [Q]
      exact le_add_of_nonneg_right hG0

    have hGleQ : G ≤ Q := by
      dsimp [Q]
      exact le_add_of_nonneg_left hN0

    have hP20 : 0 ≤ P2 := by
      dsimp [P2]
      exact sq_nonneg _

    have hD20 : 0 ≤ D2 := by
      dsimp [D2]
      exact sq_nonneg _

    have h3D20 : 0 ≤ 3 * D2 :=
      mul_nonneg (by norm_num) hD20

    have hBudget :
        P2 * G + (3 * D2) * N
          ≤
        (P2 + 3 * D2) * Q := by
      calc
        P2 * G + (3 * D2) * N
            ≤
          P2 * Q + (3 * D2) * Q :=
            add_le_add
              (mul_le_mul_of_nonneg_left hGleQ hP20)
              (mul_le_mul_of_nonneg_left hNleQ h3D20)
        _ = (P2 + 3 * D2) * Q := by
          ring

    have hHardy :
        ‖data.localizedState α index f‖ ^ 2
          ≤
        4 *
          (∑ j : Fin 3,
            ‖centeredCube3RadialCutoffMainGradientState
                  rho R data.rho_lt_outer index f j +
                centeredCube3RadialCutoffGradientState
                  rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2) :=
      data.hardy_norm_sq_le_explicit_gradient
        α index hInjective f

    have hMain :
        (∑ j : Fin 3,
          ‖centeredCube3RadialCutoffMainGradientState
              rho R data.rho_lt_outer index f j‖ ^ 2)
          ≤ P2 * G := by
      dsimp [P2, G, ψ]
      exact
        centeredCube3RadialCutoffMainGradientState_sum_norm_sq_le
          data.rho_lt_outer index hInjective f

    have hCutoff :
        (∑ j : Fin 3,
          ‖centeredCube3RadialCutoffGradientState
              rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2)
          ≤ (3 * D2) * N := by
      dsimp [D2, N, ψ]
      simpa [mul_assoc] using
        (centeredCube3RadialCutoffGradientState_sum_norm_sq_le
          data.rho_pos data.rho_lt_outer index f)

    have hProduct :
        (∑ j : Fin 3,
            ‖centeredCube3RadialCutoffMainGradientState
                  rho R data.rho_lt_outer index f j +
                centeredCube3RadialCutoffGradientState
                  rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2)
          ≤
        2 * (P2 * G + (3 * D2) * N) := by

      calc
        (∑ j : Fin 3,
            ‖centeredCube3RadialCutoffMainGradientState
                  rho R data.rho_lt_outer index f j +
                centeredCube3RadialCutoffGradientState
                  rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2)
            ≤
          ∑ j : Fin 3,
            2 *
              (‖centeredCube3RadialCutoffMainGradientState
                    rho R data.rho_lt_outer index f j‖ ^ 2 +
                ‖centeredCube3RadialCutoffGradientState
                    rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2) := by
              apply Finset.sum_le_sum
              intro j hj
              exact norm_add_sq_le_two_mul _ _
        _ =
          2 *
            ((∑ j : Fin 3,
                ‖centeredCube3RadialCutoffMainGradientState
                    rho R data.rho_lt_outer index f j‖ ^ 2) +
              (∑ j : Fin 3,
                ‖centeredCube3RadialCutoffGradientState
                    rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2)) := by
              calc
                (∑ j : Fin 3,
                    2 *
                      (‖centeredCube3RadialCutoffMainGradientState
                            rho R data.rho_lt_outer index f j‖ ^ 2 +
                        ‖centeredCube3RadialCutoffGradientState
                            rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2))
                    =
                  2 *
                    (∑ j : Fin 3,
                      (‖centeredCube3RadialCutoffMainGradientState
                            rho R data.rho_lt_outer index f j‖ ^ 2 +
                        ‖centeredCube3RadialCutoffGradientState
                            rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2)) := by
                      rw [Finset.mul_sum]
                _ =
                  2 *
                    ((∑ j : Fin 3,
                        ‖centeredCube3RadialCutoffMainGradientState
                            rho R data.rho_lt_outer index f j‖ ^ 2) +
                      (∑ j : Fin 3,
                        ‖centeredCube3RadialCutoffGradientState
                            rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2)) := by
                      rw [Finset.sum_add_distrib]
        _ ≤ 2 * (P2 * G + (3 * D2) * N) := by
              exact
                mul_le_mul_of_nonneg_left
                  (add_le_add hMain hCutoff)
                  (by norm_num)

    have hAinnerSq :
        centeredCube3RadialCutoffAinnerCoarse rho R ^ 2
          =
        8 * (P2 + 3 * D2) := by
      dsimp [P2, D2]
      exact centeredCube3RadialCutoffAinnerCoarse_sq rho R

    calc
      ‖data.localizedState α index f‖ ^ 2
          ≤
        4 *
          (∑ j : Fin 3,
            ‖centeredCube3RadialCutoffMainGradientState
                  rho R data.rho_lt_outer index f j +
                centeredCube3RadialCutoffGradientState
                  rho R data.rho_pos data.rho_lt_outer index f j‖ ^ 2) :=
        hHardy
      _ ≤ 4 * (2 * (P2 * G + (3 * D2) * N)) :=
        mul_le_mul_of_nonneg_left hProduct (by norm_num)
      _ = 8 * (P2 * G + (3 * D2) * N) := by
        ring
      _ ≤ 8 * ((P2 + 3 * D2) * Q) :=
        mul_le_mul_of_nonneg_left hBudget (by norm_num)
      _ = (8 * (P2 + 3 * D2)) * Q := by
        ring
      _ =
        centeredCube3RadialCutoffAinnerCoarse rho R ^ 2 * Q := by
        rw [hAinnerSq]
      _ =
        centeredCube3RadialCutoffAinnerCoarse rho R ^ 2 *
          (‖torus3FourierPolynomial index f‖ ^ 2 +
            torus3FourierGradientSq
              (torus3FourierPolynomial index f)) := by
        rfl

end

