/-- A quantitative reciprocal error bound implies norm convergence. -/
theorem tendsto_of_norm_sub_lt_one_div_nat
    {X : Type*} [NormedAddCommGroup X]
    (u : ℕ → X) (x : X)
    (hError : ∀ n : ℕ, ‖u n - x‖ < 1 / ((n : ℝ) + 1)) :
    Tendsto u atTop (𝓝 x) := by
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
  refine ⟨N, ?_⟩
  intro n hn
  have hCast : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
  have hDenom : (N : ℝ) + 1 ≤ (n : ℝ) + 1 := by
    linarith only [hCast]
  have hRecip : 1 / ((n : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
    one_div_le_one_div_of_le (by positivity) hDenom
  rw [dist_eq_norm]
  exact lt_trans (lt_of_lt_of_le (hError n) hRecip) hN

/-- Simultaneous approximation of a vector and its Hamiltonian image gives
an approximating sequence in the graph of the Hamiltonian. No continuity or
boundedness of the Hamiltonian is assumed. -/
theorem exists_graph_approximating_sequence
    {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X]
    (D : Submodule ℂ X) (H : D →ₗ[ℂ] X) (psi : D) (S : Set D)
    (hApprox : ∀ ε : ℝ, 0 < ε → ∃ v : D, v ∈ S ∧
      ‖(v : X) - (psi : X)‖ < ε ∧ ‖H v - H psi‖ < ε) :
    ∃ trial : ℕ → D, (∀ n, trial n ∈ S) ∧
      Tendsto (fun n => (trial n : X)) atTop (𝓝 (psi : X)) ∧
      Tendsto (fun n => H (trial n)) atTop (𝓝 (H psi)) := by
  classical
  have hExists (n : ℕ) : ∃ v : D, v ∈ S ∧
      ‖(v : X) - (psi : X)‖ < 1 / ((n : ℝ) + 1) ∧
      ‖H v - H psi‖ < 1 / ((n : ℝ) + 1) :=
    hApprox (1 / ((n : ℝ) + 1)) (by positivity)
  choose trial hMem hVector hImage using hExists
  exact ⟨trial, hMem,
    tendsto_of_norm_sub_lt_one_div_nat (fun n => (trial n : X)) (psi : X) hVector,
    tendsto_of_norm_sub_lt_one_div_nat (fun n => H (trial n)) (H psi) hImage⟩

