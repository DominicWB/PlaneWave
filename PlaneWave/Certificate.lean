      torusCoordinateLine (torusRealQuotient d y) a t := by
  funext b
  change ((y b + t * (Pi.single a (1 : ℝ) : d → ℝ) b : ℝ) : UnitAddCircle) =
    (y b : UnitAddCircle) + if b = a then (t : UnitAddCircle) else 0
  by_cases hb : b = a
  · subst b
    rw [Pi.single_eq_same, mul_one, if_pos rfl, AddCircle.coe_add]
  · rw [Pi.single_eq_of_ne hb, mul_zero, add_zero, if_neg hb, add_zero]

/-- An intrinsic first coordinate derivative, defined by the usual derivative
on a real line in the torus. It is defined without a Fourier representation. -/
def torusCoordinateDerivative {d : Type*} [Fintype d]
    (f : UnitAddTorus d → ℂ) (a : d) (x : UnitAddTorus d) : ℂ :=
  deriv (fun t : ℝ => f (torusCoordinateLine x a t)) 0

/-- Lifting the intrinsic coordinate derivative gives the ordinary Fréchet
coordinate derivative of the real lift. -/
theorem torusCoordinateDerivative_realLift {d : Type*} [Fintype d]
    (f : UnitAddTorus d → ℂ) (hf : Differentiable ℝ (torusRealLift f))
    (a : d) (y : d → ℝ) :
    torusCoordinateDerivative f a (torusRealQuotient d y) =
      coordinateRealDerivative (torusRealLift f) a y := by
  unfold torusCoordinateDerivative
  simpa only [torusRealLift, torusRealQuotient_coordinateLine] using
    (coordinateRealDerivative_eq_deriv hf a y).symm

/-- A coordinate derivative descends continuously when the periodic lift is
`C¹`; quotient descent does not add a continuity assumption. -/
theorem continuous_torusCoordinateDerivative {d : Type*} [Fintype d]
    (f : UnitAddTorus d → ℂ) (hf : ContDiff ℝ 1 (torusRealLift f))
    (a : d) : Continuous (torusCoordinateDerivative f a) := by
  apply (isOpenQuotientMap_torusRealQuotient d).isQuotientMap.continuous_iff.mpr
  change Continuous (fun y => torusCoordinateDerivative f a (torusRealQuotient d y))
  simp_rw [torusCoordinateDerivative_realLift f hf.differentiable_one a]
  exact continuous_coordinateRealDerivative hf a

/-- The intrinsic derivative field satisfies the coordinate-line chain rule
at every base point and every line parameter. -/
theorem torusCoordinateDerivative_hasDerivAt {d : Type*} [Fintype d]
    (f : UnitAddTorus d → ℂ) (hf : Differentiable ℝ (torusRealLift f))
    (x : UnitAddTorus d) (a : d) (t : ℝ) :
    HasDerivAt (fun r : ℝ => f (torusCoordinateLine x a r))
      (torusCoordinateDerivative f a (torusCoordinateLine x a t)) t := by
  obtain ⟨y, rfl⟩ := torusRealQuotient_surjective d x
  rw [← torusRealQuotient_coordinateLine y a t,
    torusCoordinateDerivative_realLift f hf a]
  simpa only [torusRealLift, torusRealQuotient_coordinateLine] using
    coordinateRealDerivative_hasDerivAt hf y a t

/-- For a `C²` periodic lift the first intrinsic coordinate derivative has
an ordinary `C¹` periodic lift. -/
theorem contDiff_torusCoordinateDerivative_realLift {d : Type*} [Fintype d]
    (f : UnitAddTorus d → ℂ) (hf : ContDiff ℝ 2 (torusRealLift f))
    (a : d) : ContDiff ℝ 1 (torusRealLift (torusCoordinateDerivative f a)) := by
  have hf1 : ContDiff ℝ 1 (torusRealLift f) := hf.of_le (by norm_num)
  have heq : torusRealLift (torusCoordinateDerivative f a) =
      coordinateRealDerivative (torusRealLift f) a := by
    funext y
    exact torusCoordinateDerivative_realLift f hf1.differentiable_one a y
  rw [heq]
  exact contDiff_coordinateRealDerivative hf a

/-- A continuous torus function with a usual `ContDiff ℝ 2` periodic real lift
belongs to the classical coordinate test space. First and second derivative
fields are constructed from ordinary derivatives, with continuity proved by
open quotient descent. No Fourier decay or domain condition is assumed. -/
def TorusCoordinateC2Test.ofContDiffLift {d : Type*} [Fintype d]
    (f : C(UnitAddTorus d, ℂ)) (hf : ContDiff ℝ 2 (torusRealLift f)) :
    TorusCoordinateC2Test d := by
  have hf1 : ContDiff ℝ 1 (torusRealLift f) := hf.of_le (by norm_num)
  let first (a : d) : C(UnitAddTorus d, ℂ) :=
    ⟨torusCoordinateDerivative f a, continuous_torusCoordinateDerivative f hf1 a⟩
  have hfirst : ∀ a : d, ContDiff ℝ 1 (torusRealLift (first a)) := by
    intro a
    exact contDiff_torusCoordinateDerivative_realLift f hf a
  exact
    { toContinuousMap := f
      first := first
      second := fun a =>
        ⟨torusCoordinateDerivative (first a) a,
          continuous_torusCoordinateDerivative (first a) (hfirst a) a⟩
      hasFirst := fun a x t =>
        torusCoordinateDerivative_hasDerivAt f hf1.differentiable_one x a t
      hasSecond := fun a x t =>
        torusCoordinateDerivative_hasDerivAt (first a)
          (hfirst a).differentiable_one x a t }

@[simp]
theorem TorusCoordinateC2Test.ofContDiffLift_toContinuousMap
    {d : Type*} [Fintype d] (f : C(UnitAddTorus d, ℂ))
    (hf : ContDiff ℝ 2 (torusRealLift f)) :
    (TorusCoordinateC2Test.ofContDiffLift f hf).toContinuousMap = f := rfl

end

