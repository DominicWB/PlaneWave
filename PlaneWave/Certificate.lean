/-! ## Ninety-sixth milestone: actual line derivatives of the regularized Hardy field -/

/-- The candidate coordinate divergence is the actual line derivative of the
`j`-th regularized field component in the `j`-th coordinate direction.

We prove this directly at the `HasLineDerivAt` level.  After unfolding that
predicate, Mathlib has already fixed the canonical real normed-space structure
on the scalar codomain, avoiding the competing bare `Module ℝ ℝ` instance that
appears if one states intermediate `HasDerivAt` lemmas separately. -/
lemma hardyRegularizedFieldComponent_hasLineDerivAt
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    @HasLineDerivAt ℝ _ ℝ Real.normedAddCommGroup _
      CenteredCube3Ambient _ _
      (hardyRegularizedFieldComponent eps j)
      (hardyRegularizedCoordinateDivergence eps j x)
      x
      (hardyCoordinateDirection j) := by

  unfold HasLineDerivAt

  have hNumConst :=
    hasDerivAt_const (0 : ℝ) (x j)
  have hNumId :=
    hasDerivAt_id' (0 : ℝ)
  have hNum := hNumConst.add hNumId

  have hDenConst :=
    hasDerivAt_const (0 : ℝ) (hardyRegularizedDenominator eps x)

  have hDenLinear :=
    (hasDerivAt_const_mul (x := (0 : ℝ)) (2 : ℝ)).mul_const (x j)

  have hDenSquare :=
    hasDerivAt_pow 2 (0 : ℝ)

  have hDen := (hDenConst.add hDenLinear).add hDenSquare

  have hQuot :=
    hNum.fun_div hDen (by
      simpa using
        (ne_of_gt (hardyRegularizedDenominator_pos heps x)))

  have hDerivValue :
      (((0 + 1) *
          (((fun _ : ℝ => hardyRegularizedDenominator eps x) +
              fun y : ℝ => 2 * y * x j) +
              fun y : ℝ => y ^ 2) 0 -
        ((fun _ : ℝ => x j) + fun y : ℝ => y) 0 *
          (0 + 2 * x j + (2 : ℝ) * 0 ^ (2 - 1))) /
        ((((fun _ : ℝ => hardyRegularizedDenominator eps x) +
              fun y : ℝ => 2 * y * x j) +
              fun y : ℝ => y ^ 2) 0) ^ 2)
        = hardyRegularizedCoordinateDivergence eps j x := by
    rw [hardyRegularizedCoordinateDivergence_as_line_derivative_value heps x j]
    simp
    ring

  have hQuot' := hQuot.congr_deriv hDerivValue

  have hFunction :
      (fun t : ℝ =>
        hardyRegularizedFieldComponent eps j
          (x + t • hardyCoordinateDirection j))
        =
      (fun y : ℝ =>
        ((fun _ : ℝ => x j) + fun t : ℝ => t) y /
          ((((fun _ : ℝ => hardyRegularizedDenominator eps x) +
                fun t : ℝ => 2 * t * x j) +
                fun t : ℝ => t ^ 2) y)) := by
    funext t
    rw [hardyRegularizedFieldComponent_coordinateLine]
    simp [
      hardyRegularizedCoordinateLine,
      hardyRegularizedCoordinateLineNumerator,
      hardyRegularizedCoordinateLineDenominator
    ]

  rw [hFunction]
  exact hQuot'

/-!
## Ninety-sixth milestone

The regularized vector field is now connected to Mathlib's differential
calculus.  For every coordinate `j`, Lean proves the scalar quotient-rule
calculation

`d/dt F_j(x + t e_j)|_{t=0}
   = (d - 2 x_j^2) / d^2`,

where `d = |x|^2 + eps^2`, and then packages this as an actual
`HasLineDerivAt` statement.  Together with milestone 94, the sum of these
actual coordinate derivatives is exactly the regularized divergence.

The next step can therefore focus on integration by parts.  The remaining
subtlety is entirely on the cutoff-wave side: its piecewise-linear radial
cutoff is nondifferentiable on the two spheres `r = rho` and `r = R`, so the
proof must use an almost-everywhere/weak derivative or an equivalent
region-splitting argument rather than a globally pointwise derivative claim.
-/

end

end PlaneWaveCertificate

