lemma weightedNormSq_extract_le_tsum (x : MolecularFourierH2 eta) (count : ℕ) :
    weightedNormSq (fun p => 1 + massKineticSymbol sys.mass
        (finitePlaneWaveKabs (2 * Real.pi / L) count) p)
      (fullCoeffVector (finiteFourierCoeffExtract count
        (molecularH2Coeff (2 * Real.pi / L) x))) ≤ ∑' p, h1f sys L x p := by
  classical
  have hfin : weightedNormSq (fun p => 1 + massKineticSymbol sys.mass
      (finitePlaneWaveKabs (2 * Real.pi / L) count) p)
      (fullCoeffVector (finiteFourierCoeffExtract count (molecularH2Coeff (2 * Real.pi / L) x))) =
      ∑ q ∈ fourierConfigCube eta count, h1f sys L x q := by
    unfold weightedNormSq fourierConfigCube
    rw [Finset.sum_image (fun p _ q _ h => finiteConfigLatticeIndex_injective eta count h)]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp only [fullCoeffVector_apply]
    rw [massKineticSymbol_eq_lattice_sum]
    simp only [h1f, finiteFourierCoeffExtract, coulombKineticEnergySymbol]
    congr 1
    rw [Finset.mul_sum, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  rw [hfin]
  exact (summable_h1f sys L x).sum_le_tsum _ (fun q _ => h1f_nonneg sys L x q)

