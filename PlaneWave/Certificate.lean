      (mul_nonneg hNη0 ht) (by positivity)
  have e5 : δ * (e * (c2 * ρ)) * t ≤ (δ₁ * ρ ^ 5) * (e * (c2 * ρ)) * t :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hδ' (by positivity)) ht
  have hρ86 : ρ ^ 8 ≤ ρ ^ 6 := pow_le_pow_of_le_one hρ hρ1 (by norm_num)
  have hlast : 2 * CO * δ₁ * N₁ * t * ρ ^ 8 ≤ 2 * CO * δ₁ * N₁ * t * ρ ^ 6 :=
    mul_le_mul_of_nonneg_left hρ86 (by positivity)
  have e : 2 * ((δ₁ * ρ ^ 5) * (Cχ * (τ₁ * ρ ^ 5) + τχ * S0 + CO * (δ₁ * ρ ^ 5)) +
          (δ₁ * ρ ^ 5) * (e * (c1 * ρ)) * t) +
        CO * (δ₁ * ρ ^ 5) ^ 2 + 2 * (CO * (δ₁ * ρ ^ 5) * ((N₁ * ρ ^ 3) * t)) +
        (δ₁ * ρ ^ 5) * (e * (c2 * ρ)) * t =
      A₁ * ρ ^ 10 + (A₂ * t * ρ ^ 6 - 2 * CO * δ₁ * N₁ * t * ρ ^ 6) +
        2 * CO * δ₁ * N₁ * t * ρ ^ 8 + A₃ * ρ ^ 5 * τχ := by
    rw [hA₁, hA₂, hA₃]
    ring
  linarith only [e1, e2, e3, e4, e5, e, hlast]

end Split

open PlaneWaveCertificate

/-! ## The observable error for a periodic Coulomb system -/

section Observable

variable {eta : ℕ} {ν : Type} [Fintype ν]
variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **Observable error after Coulomb evolution** (`thm:dyn`, `eq:dyn-main`, Fourier side).
For `ψ₀ = S u₀ ∈ D(H²)` (`H u₀ = S v₀`), the exact state `ψ(t) = U t ψ₀`, the Galerkin state
`ψ_N(t) = e^{-iH_N t} P ψ₀` of the cube of radius `n` (`K = g n ≥ 2`, `n ≥ 4`) and the observable
`O = χ(x_a)` (`convOp a χ̂` with a real `χ` whose coefficients are summable with weight
`1 + g² |ν|²`),
`|⟪ψ(t), O ψ(t)⟫ - ⟪ψ_N(t), O ψ_N(t)⟫|` is at most
`2 (δ (C_χ t_{K/2} + τ_χ ‖ψ₀‖ + ‖O‖ δ) + t δ η_tot C_tail(M₁) ρ) + ‖O‖ δ² + 2 t ‖O‖ δ N_η
  + t δ η_tot C_tail(M₂) ρ` (`η_tot = eta` particles),
where `ρ = K^{-1/2}`, `δ = η_tot t_K` bounds the never-projected tail `‖(1 - P) ψ(s)‖`, `t_K` and
`t_{K/2}` are the register tails at `K` and `K/2` (`O(K^{-5/2})`), `N_η t` is the norm-level error
(`O(t K^{-3/2})`), `τ_χ` is the tail `Σ_{g|ν| > K/2} |χ̂(ν)|`, and `M₁`, `M₂` are the `H²` budgets
of
the two backward discrete flows of the duality argument, built from `‖O‖` and the commutator
constant `D_χ`. Every term is `O(K^{-5})`, `O(t K^{-3})` or `O(K^{-5/2}) τ_χ`. -/
theorem coulomb_observable_error (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h4g : 4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (a : Fin eta) (χ : Lattice3 → ℂ)
    (hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) * ‖χ ν‖)
    (hreal : ∀ ν, χ (-ν) = conj (χ ν)) {t : ℝ} (ht : 0 ≤ t) :
    let g : ℝ := 2 * Real.pi / L
    let K : ℝ := g * n
    let b : ℝ := relB sys L Hunit
    let S0 : ℝ := ‖molecularH2StateMap eta g u₀‖
    let Ξ₀ : ℝ := 2 * ‖H u₀‖ + 2 * b * S0
    let Ξ₁ : ℝ := 2 * ‖H v₀‖ + 2 * b * ‖molecularH2StateMap eta g v₀‖
    let Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
    let B : ℝ := (2 * sys.maxMass / K ^ 2) * Ξ₁ + Ct (sys.maxMass * (S0 + 2 * Ξ₀)) * rho
    let tK : ℝ := (2 * sys.maxMass / K ^ 2) * B
    let tK' : ℝ := (2 * sys.maxMass / (K / 2) ^ 2) *
      ((2 * sys.maxMass / (K / 2) ^ 2) * Ξ₁ +
        Ct (sys.maxMass * (S0 + 2 * Ξ₀)) * (Real.sqrt 2 * rho))
    let CO : ℝ := ‖convOp (eta := eta) a χ‖
    let Cχ : ℝ := ∑' ν, ‖χ ν‖
    let τχ : ℝ := ∑' ν, if K / 2 < g * Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0
    let D : ℝ := commConst g a χ
    let δ : ℝ := eta * tK
    let Nη : ℝ := finiteCoulombPhysicalMassConstant sys L Hunit *
      Real.sqrt ((eta * tK) * (eta * (tK + 2 * B)))
    let Hw1 : ℝ := 2 * ((CO + 2 * D) * Ξ₀ + D * S0) + 2 * b * (CO * S0)
    let M1 : ℝ := sys.maxMass * (CO * S0 + 2 * (2 * Hw1 + 2 * b * (CO * S0)))
    let Tη : ℝ := 2 * (2 * (2 * Ξ₀ + 2 * b * S0)) + 2 * b * (2 * S0)
    let Hw2 : ℝ := 2 * ((CO + 2 * D) * Tη + D * (2 * S0)) + 2 * b * (CO * (2 * S0))
    let M2 : ℝ := sys.maxMass * (CO * (2 * S0) + 2 * (2 * Hw2 + 2 * b * (CO * (2 * S0))))
    ‖⟪U t (molecularH2StateMap eta g u₀),
        convOp a χ (U t (molecularH2StateMap eta g u₀))⟫_ℂ -
      ⟪finiteFourierLpIsometry eta n (UN t (extractCLM n (molecularH2StateMap eta g u₀))),
        convOp a χ (finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta g u₀))))⟫_ℂ‖ ≤
      2 * (δ * (Cχ * tK' + τχ * S0 + CO * δ) + δ * (eta * (Ct M1 * rho)) * t) +
        CO * δ ^ 2 + 2 * (CO * δ * (Nη * t)) + δ * (eta * (Ct M2 * rho)) * t := by
  intro g K b S0 Ξ₀ Ξ₁ Ct B tK tK' CO Cχ τχ D δ Nη Hw1 M1 Tη Hw2 M2
  have hM := sys.one_le_maxMass
  have hb : 0 ≤ b := relB_nonneg sys L Hunit hC
  have hgpos : 0 < 2 * Real.pi / L := by positivity
  have hχ : Summable fun ν => ‖χ ν‖ := summable_norm_of_weighted _ hχ2
  have hK1 : 1 ≤ (2 * Real.pi / L) * n := by linarith
  have h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n := by linarith
  have hS0 : 0 ≤ S0 := norm_nonneg _
  have hCO : 0 ≤ CO := norm_nonneg _
  have hD : 0 ≤ D := commConst_nonneg _ _ _
  have hΞ₀ : 0 ≤ Ξ₀ := add_nonneg (mul_nonneg zero_le_two (norm_nonneg _))
    (mul_nonneg (mul_nonneg zero_le_two hb) hS0)
  -- the state at time `t`
  obtain ⟨u, hu1, hu2⟩ := hgraph t u₀
  have hψ : U t (molecularH2StateMap eta g u₀) = molecularH2StateMap eta g u := hu1.symm
  have hSu : ‖molecularH2StateMap eta g u‖ = S0 := by
    rw [← hψ, LinearIsometryEquiv.norm_map]
  have hTu : ‖coulombFourierKineticH2 sys g u‖ ≤ Ξ₀ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u
    rw [hu1, hu2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
    exact h
  have hTu₀ : ‖coulombFourierKineticH2 sys g u₀‖ ≤ Ξ₀ :=
    kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u₀
  -- tails at `K` and at `K/2`
  have htK := fun c => tails_at_time sys L H hKernel Hunit hL hPeriodic hC U hgraph c K rho Blow Cs
    Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude hBkerScale hCsScale u₀
        v₀ huv t u hu1 hu2
  have hRho' : 0 ≤ Real.sqrt 2 * rho := mul_nonneg (Real.sqrt_nonneg _) hRho
  have hRhoScale' : (Real.sqrt 2 * rho) ^ 2 * (K / 2) = 1 := by
    rw [mul_pow, Real.sq_sqrt zero_le_two]
    have : rho ^ 2 * K = 1 := hRhoScale
    linarith
  have htK' := tails_at_time sys L H hKernel Hunit hL hPeriodic hC U hgraph a (K / 2)
    (Real.sqrt 2 * rho) Blow Cs Bker (by show 1 ≤ (2 * Real.pi / L) * n / 2; linarith) hRho'
    hRhoScale' hBlow hCs hBker (by show 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n / 2; linarith)
    hAmplitude hBkerScale hCsScale u₀ v₀ huv t u hu1 hu2
  have hB0 : 0 ≤ B := by
    have hM2 : 0 ≤ sys.maxMass * (S0 + 2 * Ξ₀) := mul_nonneg (by linarith) (by linarith)
    exact add_nonneg (mul_nonneg (div_nonneg (by linarith) (sq_nonneg _))
      (add_nonneg (mul_nonneg zero_le_two (norm_nonneg _))
        (mul_nonneg (mul_nonneg zero_le_two hb) (norm_nonneg _))))
      (mul_nonneg (finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker hM2) hRho)
  have htK0 : 0 ≤ tK := mul_nonneg (div_nonneg (by linarith) (sq_nonneg _)) hB0
  have hδ0 : 0 ≤ δ := mul_nonneg (Nat.cast_nonneg _) htK0
  -- the never-projected tail `δ(t) = (1 - P) ψ(t)`
  set ψ := molecularH2StateMap eta g u with hψdef
  have hδ : ‖ψ - molecularH2Truncate n ψ‖ ≤ δ := by
    refine (norm_sub_truncate_le hgpos n _).trans ?_
    calc ∑ c : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) c ψ‖
        ≤ ∑ _c : Fin eta, tK := Finset.sum_le_sum fun c _ => (htK c).2
      _ = δ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  -- the retained-space error `η(t)`
  set ηE := extractCLM n ψ - UN t (extractCLM n (molecularH2StateMap eta g u₀)) with hηE
  have hη : ‖ηE‖ ≤ Nη * t := by
    have h := coulomb_normlevel sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph hderiv n UN hN0
      hNadd hNcomm hNderiv rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
      hBkerScale hCsScale u₀ v₀ huv ht
    rw [hψ] at h
    exact h
  have hηS : ‖ηE‖ ≤ 2 * S0 := by
    refine (norm_sub_le _ _).trans ?_
    rw [LinearIsometryEquiv.norm_map]
    have h1 := norm_extractCLM_le n ψ
    have h2 := norm_extractCLM_le n (molecularH2StateMap eta g u₀)
    rw [hSu] at h1
    linarith
  -- the split
  set O := convOp (eta := eta) a χ
  have hO : ∀ x y, ⟪O x, y⟫_ℂ = ⟪x, O y⟫_ℂ := convOp_symm a hχ hreal
  have hsplit : ψ - finiteFourierLpIsometry eta n
      (UN t (extractCLM n (molecularH2StateMap eta g u₀))) =
      (ψ - molecularH2Truncate n ψ) + finiteFourierLpIsometry eta n ηE := by
    rw [hηE, map_sub, ← emb_extractCLM]
    abel
  rw [hψ]
  refine (obs_split_le O hO _ _ _ _ hsplit).trans ?_
  -- (1) the never-projected tail against `O ψ`
  have hT1 : ‖⟪ψ - molecularH2Truncate n ψ, O ψ⟫_ℂ‖ ≤ δ * (Cχ * tK' + τχ * S0 + CO * δ) := by
    rw [inner_sub_truncate_left]
    refine (norm_inner_le_norm _ _).trans (mul_le_mul hδ ?_ (norm_nonneg _) hδ0)
    refine (chitail hgpos n a hχ ψ).trans ?_
    have hsum : ∑ c : Fin eta, ‖tailMask g (g * n) c ψ‖ ≤ δ := by
      calc ∑ c : Fin eta, ‖tailMask g (g * n) c ψ‖ ≤ ∑ _c : Fin eta, tK :=
            Finset.sum_le_sum fun c _ => (htK c).2
        _ = δ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have hCχ : 0 ≤ Cχ := tsum_nonneg fun ν => norm_nonneg _
    have hτχ : 0 ≤ τχ := tsum_nonneg fun ν => by split_ifs <;> simp
    have h1 : Cχ * ‖tailMask g (g * n / 2) a ψ‖ ≤ Cχ * tK' := mul_le_mul_of_nonneg_left htK'.2 hCχ
    have h2 : τχ * ‖ψ‖ ≤ τχ * S0 := by rw [hSu]
    have h3 : CO * ∑ c : Fin eta, ‖tailMask g (g * n) c ψ‖ ≤ CO * δ :=
        mul_le_mul_of_nonneg_left hsum hCO
    exact add_le_add (add_le_add h1 h2) h3
  -- monotonicity of the `H²` budgets
  have hbudget : ∀ (w : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) (X Y : ℝ),
      ‖w‖ ≤ X → ‖finiteCoulombHamiltonian sys L n w‖ ≤ Y →
      sys.maxMass * (‖w‖ + 2 * (2 * ‖finiteCoulombHamiltonian sys L n w‖ +
        2 * relB sys L Hunit * ‖w‖)) ≤ sys.maxMass * (X + 2 * (2 * Y + 2 * b * X)) := by
    intro w X Y hX hY
    apply mul_le_mul_of_nonneg_left _ (by linarith)
    have := mul_le_mul_of_nonneg_left hX hb
    change ‖w‖ + 2 * (2 * ‖finiteCoulombHamiltonian sys L n w‖ + 2 * b * ‖w‖) ≤
      X + 2 * (2 * Y + 2 * b * X)
    linarith only [this, hX, hY]
  -- (2) the retained-space error against `O ψ`, by duality
  have hOψ : O ψ = molecularH2StateMap eta g (convH2 g a χ u) :=
    (stateMap_convH2 g a hχ2 u).symm
  have hOψn : ‖O ψ‖ ≤ CO * S0 := by
    rw [← hSu]
    exact O.le_opNorm _
  have hT2 : ‖⟪finiteFourierLpIsometry eta n ηE, O ψ⟫_ℂ‖ ≤ δ * (eta * (Ct M1 * rho)) * t := by
    rw [inner_emb_left]
    have hw : ‖extractCLM n (O ψ)‖ ≤ CO * S0 := (norm_extractCLM_le n _).trans hOψn
    have hHw : ‖finiteCoulombHamiltonian sys L n (extractCLM n (O ψ))‖ ≤ Hw1 := by
      rw [hOψ]
      refine (finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n _).trans ?_
      have hTc := norm_kinetic_convH2_le sys g a hχ2 u
      rw [hSu] at hTc
      have hTc' : ‖coulombFourierKineticH2 sys g (convH2 g a χ u)‖ ≤ (CO + 2 * D) * Ξ₀ + D * S0 :=
        hTc.trans (by
          have := mul_le_mul_of_nonneg_left hTu (by linarith : 0 ≤ CO + 2 * D)
          change (CO + 2 * D) * ‖coulombFourierKineticH2 sys g u‖ + D * S0 ≤ _
          linarith)
      have hSc : ‖molecularH2StateMap eta g (convH2 g a χ u)‖ ≤ CO * S0 := by
        rw [← hOψ]
        exact hOψn
      have := mul_le_mul_of_nonneg_left hSc (mul_nonneg zero_le_two hb)
      change 2 * ‖coulombFourierKineticH2 sys g (convH2 g a χ u)‖ +
        2 * b * ‖molecularH2StateMap eta g (convH2 g a χ u)‖ ≤ _
      change _ ≤ 2 * ((CO + 2 * D) * Ξ₀ + D * S0) + 2 * b * (CO * S0)
      linarith
    have h := coulomb_duality sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph
        hderiv n UN hN0 hNcomm
      hNderiv rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
          hBkerScale hCsScale
      u₀ v₀ huv (extractCLM n (O ψ)) M1 (hbudget _ _ _ hw hHw) ht
    rw [hψ] at h
    exact h
  -- (3)--(5) the quadratic terms with a never-projected factor
  have hOn : ∀ x, ‖O x‖ ≤ CO * ‖x‖ := fun x => O.le_opNorm x
  have hιη : ‖finiteFourierLpIsometry eta n ηE‖ ≤ Nη * t := by
    rw [LinearIsometry.norm_map]
    exact hη
  have hT3 : ‖⟪ψ - molecularH2Truncate n ψ, O (ψ - molecularH2Truncate n ψ)⟫_ℂ‖ ≤ CO * δ ^ 2 := by
    refine (norm_inner_le_norm _ _).trans ?_
    have h1 := hOn (ψ - molecularH2Truncate n ψ)
    have h2 := norm_nonneg (ψ - molecularH2Truncate n ψ)
    calc ‖ψ - molecularH2Truncate n ψ‖ * ‖O (ψ - molecularH2Truncate n ψ)‖ ≤
          ‖ψ - molecularH2Truncate n ψ‖ * (CO * ‖ψ - molecularH2Truncate n ψ‖) :=
          mul_le_mul_of_nonneg_left h1 h2
      _ = CO * ‖ψ - molecularH2Truncate n ψ‖ ^ 2 := by ring
      _ ≤ CO * δ ^ 2 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ h2 hδ 2) hCO
  have hT4 : ‖⟪ψ - molecularH2Truncate n ψ, O (finiteFourierLpIsometry eta n ηE)⟫_ℂ‖ ≤
      CO * δ * (Nη * t) := by
    refine (norm_inner_le_norm _ _).trans ?_
    have h1 := hOn (finiteFourierLpIsometry eta n ηE)
    calc ‖ψ - molecularH2Truncate n ψ‖ * ‖O (finiteFourierLpIsometry eta n ηE)‖ ≤
          δ * (CO * ‖finiteFourierLpIsometry eta n ηE‖) :=
          mul_le_mul hδ h1 (norm_nonneg _) hδ0
      _ ≤ δ * (CO * (Nη * t)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hιη hCO) hδ0
      _ = CO * δ * (Nη * t) := by ring
  have hT5 : ‖⟪finiteFourierLpIsometry eta n ηE, O (ψ - molecularH2Truncate n ψ)⟫_ℂ‖ ≤
      CO * δ * (Nη * t) := by
    refine (norm_inner_le_norm _ _).trans ?_
    have h1 := hOn (ψ - molecularH2Truncate n ψ)
    have hηt : 0 ≤ Nη * t := (norm_nonneg _).trans hιη
    calc ‖finiteFourierLpIsometry eta n ηE‖ * ‖O (ψ - molecularH2Truncate n ψ)‖ ≤
          (Nη * t) * (CO * δ) :=
          mul_le_mul hιη (h1.trans (mul_le_mul_of_nonneg_left hδ hCO)) (norm_nonneg _) hηt
      _ = CO * δ * (Nη * t) := by ring
  -- (6) the retained-space error against `O η`, by duality
  set l := cubeLift g n ηE
  have hιl : finiteFourierLpIsometry eta n ηE = molecularH2StateMap eta g l :=
    (stateMap_cubeLift g n ηE).symm
  have hOη : O (finiteFourierLpIsometry eta n ηE) = molecularH2StateMap eta g (convH2 g a χ l) := by
    rw [hιl, stateMap_convH2 g a hχ2 l]
  have hOηn : ‖O (finiteFourierLpIsometry eta n ηE)‖ ≤ CO * (2 * S0) := by
    refine (hOn _).trans (mul_le_mul_of_nonneg_left ?_ hCO)
    rw [LinearIsometry.norm_map]
    exact hηS
  have hT6 : ‖⟪finiteFourierLpIsometry eta n ηE, O (finiteFourierLpIsometry eta n ηE)⟫_ℂ‖ ≤
      δ * (eta * (Ct M2 * rho)) * t := by
    rw [inner_emb_left]
    have hw : ‖extractCLM n (O (finiteFourierLpIsometry eta n ηE))‖ ≤ CO * (2 * S0) :=
      (norm_extractCLM_le n _).trans hOηn
    -- `H_N`-regularity of `η(t)`
    have hHη : ‖finiteCoulombHamiltonian sys L n ηE‖ ≤ 2 * (2 * Ξ₀ + 2 * b * S0) := by
      have e : finiteCoulombHamiltonian sys L n ηE =
          finiteCoulombHamiltonian sys L n (extractCLM n ψ) -
            UN t (finiteCoulombHamiltonian sys L n
                (extractCLM n (molecularH2StateMap eta g u₀))) := by
        rw [hηE, map_sub, hNcomm]
      rw [e]
      refine (norm_sub_le _ _).trans ?_
      rw [LinearIsometryEquiv.norm_map]
      have h1 := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n u
      have h2 := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n u₀
      rw [hSu] at h1
      change ‖finiteCoulombHamiltonian sys L n (extractCLM n (molecularH2StateMap eta g u))‖ ≤
