/-! ## reflection unitary -/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped Topology

noncomputable section

local instance unitAddCircleMeasureSpaceForReflection139 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

local instance molecularPositionNegInvariantForReflection139 (eta : ℕ) :
    Measure.IsNegInvariant (volume : Measure (MolecularPositionTorus eta)) :=
  Measure.pi.isNegInvariant (fun _ : Fin eta × Fin 3 => AddCircle.haarAddCircle)

/-- Simultaneous reflection of all particle coordinates preserves the
normalized product Haar measure. -/
theorem molecularPosition_neg_measurePreserving (eta : ℕ) :
    MeasurePreserving (fun x : MolecularPositionTorus eta => -x) volume volume :=
  Measure.measurePreserving_neg (volume : Measure (MolecularPositionTorus eta))

/-- The linear isometry induced by literal reflection of the position
coordinates. It is an isometry because reflection preserves Haar measure. -/
def molecularPositionReflectionLinearIsometry (eta : ℕ) :
    MolecularPositionL2 eta →ₗᵢ[ℂ] MolecularPositionL2 eta :=
  Lp.compMeasurePreservingₗᵢ ℂ (fun x : MolecularPositionTorus eta => -x)
    (molecularPosition_neg_measurePreserving eta)

lemma molecularPositionReflectionLinearIsometry_involutive (eta : ℕ)
    (f : MolecularPositionL2 eta) :
    molecularPositionReflectionLinearIsometry eta
        (molecularPositionReflectionLinearIsometry eta f) = f := by
  apply Lp.ext
  filter_upwards [Lp.coeFn_compMeasurePreserving
      (molecularPositionReflectionLinearIsometry eta f)
      (molecularPosition_neg_measurePreserving eta),
    (molecularPosition_neg_measurePreserving eta).quasiMeasurePreserving.ae
      (Lp.coeFn_compMeasurePreserving f
        (molecularPosition_neg_measurePreserving eta))] with x hOuter hInner
  change (molecularPositionReflectionLinearIsometry eta
      (molecularPositionReflectionLinearIsometry eta f)) x =
    (molecularPositionReflectionLinearIsometry eta f) (-x) at hOuter
  change (molecularPositionReflectionLinearIsometry eta f) (-x) =
    f (-(-x)) at hInner
  rw [neg_neg] at hInner
  exact hOuter.trans hInner

/-- Reflection is a constructed complex-linear unitary on the actual position
L2 space. Its inverse is the same reflection. -/
def molecularPositionReflection (eta : ℕ) :
    MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta :=
  LinearIsometryEquiv.ofSurjective (molecularPositionReflectionLinearIsometry eta)
    (fun f => ⟨molecularPositionReflectionLinearIsometry eta f,
      molecularPositionReflectionLinearIsometry_involutive eta f⟩)

/-- An L2 representative of the reflected state is literal composition with
x ↦ -x, almost everywhere. -/
theorem molecularPositionReflection_coeFn (eta : ℕ)
    (f : MolecularPositionL2 eta) :
    (molecularPositionReflection eta f : MolecularPositionTorus eta → ℂ)
      =ᵐ[volume] fun x => f (-x) :=
  Lp.coeFn_compMeasurePreserving f (molecularPosition_neg_measurePreserving eta)

@[simp]
theorem molecularPositionReflection_involutive (eta : ℕ)
    (f : MolecularPositionL2 eta) :
    molecularPositionReflection eta (molecularPositionReflection eta f) = f :=
  molecularPositionReflectionLinearIsometry_involutive eta f

@[simp]
theorem molecularPositionReflection_symm (eta : ℕ) :
    (molecularPositionReflection eta).symm = molecularPositionReflection eta := by
  ext1 f
  apply (molecularPositionReflection eta).injective
  rw [LinearIsometryEquiv.apply_symm_apply, molecularPositionReflection_involutive]

/-- Reflection reverses each molecular Fourier frequency. This identity
holds for arbitrary functions, using the measure-preserving change of
variables in the integral. -/
theorem molecularPosition_fourierCoeff_reflect (eta : ℕ)
    (f : MolecularPositionTorus eta → ℂ) (n : (Fin eta × Fin 3) → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => f (-x)) n =
      UnitAddTorus.mFourierCoeff f (-n) := by
  unfold UnitAddTorus.mFourierCoeff
  calc
    (∫ x, UnitAddTorus.mFourier (-n) x • f (-x)) =
        ∫ x, UnitAddTorus.mFourier (-n) (-x) • f (-(-x)) :=
      (integral_neg_eq_self
        (fun x : MolecularPositionTorus eta =>
          UnitAddTorus.mFourier (-n) x • f (-x)) volume).symm
    _ = _ := by simp only [mFourier_neg_argument, neg_neg]

/-- Ordinary Fourier coefficients of the reflected L2 state. -/
theorem molecularPositionReflection_fourierCoeff (eta : ℕ)
    (f : MolecularPositionL2 eta) (n : (Fin eta × Fin 3) → ℤ) :
    UnitAddTorus.mFourierCoeff (molecularPositionReflection eta f) n =
      UnitAddTorus.mFourierCoeff f (-n) := by
  rw [torus_mFourierCoeff_congr_ae (molecularPositionReflection_coeFn eta f) n]
  exact molecularPosition_fourierCoeff_reflect eta f n

/-- In project momentum indexing the reflection acts by p ↦ -p. -/
theorem molecularPositionReflection_fourier (eta : ℕ)
    (f : MolecularPositionL2 eta) (p : FourierConfig eta Lattice3) :
    (molecularPositionSynthesis eta).symm (molecularPositionReflection eta f) p =
      (molecularPositionSynthesis eta).symm f (-p) := by
  rw [molecularPositionSynthesis_symm_apply,
    molecularPositionSynthesis_symm_apply, molecularPositionReflection_fourierCoeff]
  rfl

end
end PlaneWaveCertificate

/-! ## physical potential -/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped BigOperators Topology

noncomputable section

local instance unitAddCircleMeasureSpaceForPhysicalPotential139 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-- The usual relative coordinate between an electron and a nucleus. -/
def molecularPositionNuclearDifference {eta : ℕ} (i : Fin eta)
    (R : UnitTorus3) (x : MolecularPositionTorus eta) : UnitTorus3 :=
  molecularPositionParticle i x - R

theorem molecularPositionNuclearDifference_measurePreserving {eta : ℕ}
    (i : Fin eta) (R : UnitTorus3) :
    MeasurePreserving (molecularPositionNuclearDifference i R)
      (volume : Measure (MolecularPositionTorus eta)) volume := by
  have hMap : molecularPositionNuclearDifference i R =
      molecularPositionNuclearArgument i (-R) := by
    funext x
    exact sub_eq_add_neg (molecularPositionParticle i x) R
  rw [hMap]
  exact molecularPositionNuclearArgument_measurePreserving i (-R)

/-- The signed molecular Coulomb potential in the usual position convention.
Each electron pair appears once, and the attraction to a nucleus at `R` is
evaluated at the electron's position minus `R`. This pointwise definition is
independent of the Fourier Hamiltonian and of its continuous extension. -/
def molecularCoulombPotential
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (x : MolecularPositionTorus eta) : ℂ :=
  (coulombCellAmplitude L : ℂ) *
    ((∑ pair : FiniteElectronPair eta,
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 x)) -
      ∑ i : Fin eta, ∑ ell : ν,
        (data.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearDifference i (data.position ell) x))

theorem molecularPositionDifference_neg {eta : ℕ}
    (i j : Fin eta) (x : MolecularPositionTorus eta) :
    molecularPositionDifference i j (-x) =
      -(molecularPositionDifference i j x) := by
  funext a
  change -x (i, a) - -x (j, a) = -(x (i, a) - x (j, a))
  abel

theorem molecularPositionNuclearArgument_neg {eta : ℕ}
    (i : Fin eta) (R : UnitTorus3) (x : MolecularPositionTorus eta) :
    molecularPositionNuclearArgument i R (-x) =
      -(molecularPositionNuclearDifference i R x) := by
  funext a
  change -x (i, a) + R a = -(x (i, a) - R a)
  abel

/-- Scalar Coulomb evenness can be pulled back across a genuine pair
coordinate. This does not assert pointwise equality on collision sets. -/
theorem molecularPositionPairCoulomb_reflect_ae {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) :
    (fun x : MolecularPositionTorus eta =>
      canonicalUnitTorus3CoulombPotential.potential
        (molecularPositionDifference i j (-x))) =ᵐ[volume]
      (fun x => canonicalUnitTorus3CoulombPotential.potential
        (molecularPositionDifference i j x)) := by
  have h := (molecularPositionDifference_measurePreserving i j hij).quasiMeasurePreserving.ae
    canonicalUnitTorus3CoulombPotential_even_ae
  filter_upwards [h] with x hx
  simpa only [molecularPositionDifference_neg] using hx

/-- Reflection changes the established positive nuclear shift into the
physical electron-minus-nucleus convention, using proved scalar evenness. -/
theorem molecularPositionNuclearCoulomb_reflect_ae {eta : ℕ}
    (i : Fin eta) (R : UnitTorus3) :
    (fun x : MolecularPositionTorus eta =>
      canonicalUnitTorus3CoulombPotential.potential
        (molecularPositionNuclearArgument i R (-x))) =ᵐ[volume]
      (fun x => canonicalUnitTorus3CoulombPotential.potential
        (molecularPositionNuclearDifference i R x)) := by
  have h := (molecularPositionNuclearDifference_measurePreserving i R).quasiMeasurePreserving.ae
    canonicalUnitTorus3CoulombPotential_even_ae
  filter_upwards [h] with x hx
  simpa only [molecularPositionNuclearArgument_neg] using hx

/-- The conventional signed molecular potential is the reflection of the
potential previously identified in the positive Fourier synthesis convention.
The scalar evenness and all measure-preserving pullbacks are proved, so no
additional symmetry or multiplication hypothesis enters this identification. -/
theorem molecularFourierConventionCoulombPotential_reflect_ae
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) :
    (fun x : MolecularPositionTorus eta =>
      molecularFourierConventionCoulombPotential eta L data (-x)) =ᵐ[volume]
      molecularCoulombPotential eta L data := by
  have hPair : ∀ᵐ x : MolecularPositionTorus eta ∂volume,
      ∀ pair : FiniteElectronPair eta,
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 (-x)) =
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 x) :=
    ae_all_iff.mpr fun pair => molecularPositionPairCoulomb_reflect_ae
      pair.1.1 pair.1.2 (ne_of_lt pair.2)
  have hNuclear : ∀ᵐ x : MolecularPositionTorus eta ∂volume,
      ∀ i : Fin eta, ∀ ell : ν,
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionNuclearArgument i (data.position ell) (-x)) =
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionNuclearDifference i (data.position ell) x) :=
    ae_all_iff.mpr fun i => ae_all_iff.mpr fun ell =>
      molecularPositionNuclearCoulomb_reflect_ae i (data.position ell)
  filter_upwards [hPair, hNuclear] with x hPx hNx
  simp only [molecularFourierConventionCoulombPotential,
    molecularCoulombPotential, hPx, hNx]

end
end PlaneWaveCertificate

/-! ## kinetic reflection -/

/-! ## Reflection preserves the ordinary weak kinetic graph -/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-- Global momentum reversal preserves the kinetic energy, including at zero
scale. The proof uses the explicit sum of coordinate squares. -/
lemma molecularKineticEnergySymbol_neg (eta : ℕ) (g : ℝ)
    (p : FourierConfig eta Lattice3) :
    molecularKineticEnergySymbol eta g (-p) =
      molecularKineticEnergySymbol eta g p := by
  simp only [molecularKineticEnergySymbol_eq_sum, latticeNormSq,
    Pi.neg_apply, Int.cast_neg, neg_sq]

/-- Reflection transports the polynomial-test kinetic equation. -/
theorem HasMolecularWeakKinetic.reflection {eta : ℕ} {g : ℝ}
    {f k : MolecularPositionL2 eta} (h : HasMolecularWeakKinetic eta g f k) :
    HasMolecularWeakKinetic eta g
      (molecularPositionReflection eta f) (molecularPositionReflection eta k) := by
  apply (hasMolecularWeakKinetic_iff_coeff eta g _ _).mpr
  intro p
  rw [molecularPositionReflection_fourier, molecularPositionReflection_fourier]
  simpa only [molecularKineticEnergySymbol_neg] using
    (hasMolecularWeakKinetic_iff_coeff eta g f k).mp h (-p)

/-- Global spatial reflection preserves the ordinary C2-test weak Laplacian.
The already established equivalence with Fourier tests supplies the proof
without assuming a derivative transformation law. -/
theorem HasMolecularContDiffWeakKinetic.reflection {eta : ℕ} {L : ℝ}
    {f k : MolecularPositionL2 eta}
    (h : HasMolecularContDiffWeakKinetic eta L f k) :
    HasMolecularContDiffWeakKinetic eta L
      (molecularPositionReflection eta f) (molecularPositionReflection eta k) :=
  (hasMolecularContDiffWeakKinetic_iff eta L _ _).mpr
    ((hasMolecularContDiffWeakKinetic_iff eta L f k).mp h).reflection

end
end PlaneWaveCertificate

/-! ## domain reflection -/

/-! ## The reflected operator has the same H2 domain -/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

/-- Global spatial reflection preserves membership in the existing H2 domain.
This holds at every real scale, including the degenerate zero scale. -/
theorem molecularPositionReflection_mem_H2Domain (eta : ℕ) (g : ℝ)
    (f : MolecularPositionL2 eta) :
    molecularPositionReflection eta f ∈ molecularPositionH2Domain eta g ↔
      f ∈ molecularPositionH2Domain eta g := by
  constructor
  · intro hf
    obtain ⟨k, hk⟩ :=
      (molecularPositionH2Domain_iff_weakKinetic eta g _).mp hf
    apply (molecularPositionH2Domain_iff_weakKinetic eta g f).mpr
    refine ⟨molecularPositionReflection eta k, ?_⟩
    simpa only [molecularPositionReflection_involutive] using hk.reflection
  · intro hf
    obtain ⟨k, hk⟩ :=
      (molecularPositionH2Domain_iff_weakKinetic eta g f).mp hf
    exact (molecularPositionH2Domain_iff_weakKinetic eta g _).mpr
      ⟨molecularPositionReflection eta k, hk.reflection⟩

/-- Unitary reflection leaves the H2 submodule itself unchanged. In
particular, switching the plane-wave sign convention does not change the
operator domain. -/
theorem molecularPositionH2Domain_map_reflection (eta : ℕ) (g : ℝ) :
    (molecularPositionH2Domain eta g).map
        (molecularPositionReflection eta).toLinearEquiv.toLinearMap =
      molecularPositionH2Domain eta g := by
  ext f
  constructor
  · rintro ⟨u, hu, huf⟩
    change molecularPositionReflection eta u = f at huf
    rw [← huf]
    exact (molecularPositionReflection_mem_H2Domain eta g u).mpr hu
  · intro hf
    refine ⟨molecularPositionReflection eta f,
      (molecularPositionReflection_mem_H2Domain eta g f).mpr hf, ?_⟩
    exact molecularPositionReflection_involutive eta f

end
end PlaneWaveCertificate

/-! ## sector reflection -/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped Topology

noncomputable section

/-- Reflecting every reciprocal lattice coordinate leaves physical cubic
support unchanged, including its boundary. -/
theorem isLatticeCubicCoeff_neg_iff (eta : ℕ) (K g : ℝ)
    (coeff : FourierConfig eta Lattice3 → ℂ) :
    IsLatticeCubicCoeff eta K g (fun p => coeff (-p)) ↔
      IsLatticeCubicCoeff eta K g coeff := by
  constructor
  · intro h p hp
    have hOut : ∃ i : Fin eta, ∃ d : Fin 3,
        K < |g * ((-p) i d : ℝ)| := by
      rcases hp with ⟨i, d, hd⟩
      refine ⟨i, d, ?_⟩
      simpa only [Pi.neg_apply, Int.cast_neg, mul_neg, abs_neg] using hd
    simpa only [neg_neg] using h (-p) hOut
  · intro h p hp
    apply h (-p)
    rcases hp with ⟨i, d, hd⟩
    refine ⟨i, d, ?_⟩
    simpa only [Pi.neg_apply, Int.cast_neg, mul_neg, abs_neg] using hd

/-- Reflection preserves the usual cubic support condition on the ordinary
Fourier coefficients of an actual position-space L2 state. -/
theorem molecularPositionReflection_isCubic_iff (eta : ℕ) (K g : ℝ)
    (f : MolecularPositionL2 eta) :
    IsLatticeCubicCoeff eta K g
        (fun p => (molecularPositionSynthesis eta).symm
          (molecularPositionReflection eta f) p) ↔
      IsLatticeCubicCoeff eta K g
        (fun p => (molecularPositionSynthesis eta).symm f p) := by
  simp only [molecularPositionReflection_fourier]
  exact isLatticeCubicCoeff_neg_iff eta K g _

end
end PlaneWaveCertificate

/-! ## physical graph -/

namespace PlaneWaveCertificate

open MeasureTheory

noncomputable section

local instance unitAddCircleMeasureSpaceForPhysicalGraph139 :
    MeasureSpace UnitAddCircle := instMeasureSpaceUnitAddCircle

/-- Reflection carries a literal multiplication graph to multiplication by
the reflected potential. The a.e. potential identity suffices. -/
theorem HasL2PointwisePotential.reflection {eta : ℕ}
    {V W : MolecularPositionTorus eta → ℂ}
    (hVW : (fun x => V (-x)) =ᵐ[volume] W)
    {f v : MolecularPositionL2 eta}
    (hv : HasL2PointwisePotential volume V f v) :
    HasL2PointwisePotential volume W
      (molecularPositionReflection eta f) (molecularPositionReflection eta v) := by
  filter_upwards [molecularPositionReflection_coeFn eta f,
    molecularPositionReflection_coeFn eta v,
    (molecularPosition_neg_measurePreserving eta).quasiMeasurePreserving.ae hv,
    hVW] with x hF hV hProduct hPotentialValue
  rw [hV, hF, ← hPotentialValue]
  exact hProduct

/-- Literal multiplication is carried in both directions by the reflection
unitary; the potential relation is a.e. and no boundedness is required. -/
theorem hasL2PointwisePotential_reflection_iff (eta : ℕ)
    (V W : MolecularPositionTorus eta → ℂ)
    (hVW : (fun x => V (-x)) =ᵐ[volume] W)
    (f v : MolecularPositionL2 eta) :
    HasL2PointwisePotential volume W
        (molecularPositionReflection eta f) (molecularPositionReflection eta v) ↔
      HasL2PointwisePotential volume V f v := by
  constructor
  · intro h
    have hWV : (fun x => W (-x)) =ᵐ[volume] V := by
      filter_upwards
        [(molecularPosition_neg_measurePreserving eta).quasiMeasurePreserving.ae hVW]
        with x hx
      simpa only [neg_neg] using hx.symm
    have hBack := h.reflection hWV
    simpa only [molecularPositionReflection_involutive] using hBack
  · intro h
    exact h.reflection hVW

/-- The molecular Hamiltonian in the usual position convention. The attractive
terms are the actual functions V(x_i - R_A), each repulsive pair appears once,
and the residual satisfies the ordinary C2 periodic weak kinetic equation.
This definition has no reference to the Fourier completion or a unitary. -/
def HasMolecularCoulombHamiltonian
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (f h : MolecularPositionL2 eta) : Prop :=
  ∃ v : MolecularPositionL2 eta,
    HasL2PointwisePotential volume (molecularCoulombPotential eta L data) f v ∧
    HasMolecularContDiffWeakKinetic eta L f (h - v)

/-- Global coordinate reflection changes the existing positive nuclear-phase
convention to the usual nuclear differences, preserving the weak kinetic term. -/
theorem hasMolecularFourierConventionCoulombHamiltonian_reflection_iff
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (f h : MolecularPositionL2 eta) :
    HasMolecularCoulombHamiltonian eta L data
        (molecularPositionReflection eta f) (molecularPositionReflection eta h) ↔
      HasMolecularFourierConventionCoulombHamiltonian eta L data f h := by
  constructor
  · rintro ⟨v, hv, hweak⟩
    refine ⟨molecularPositionReflection eta v, ?_, ?_⟩
    · apply (hasL2PointwisePotential_reflection_iff eta
        (molecularFourierConventionCoulombPotential eta L data)
        (molecularCoulombPotential eta L data)
        (molecularFourierConventionCoulombPotential_reflect_ae eta L data)
        f (molecularPositionReflection eta v)).mp
      simpa only [molecularPositionReflection_involutive] using hv
    · simpa only [map_sub, molecularPositionReflection_involutive] using hweak.reflection
  · rintro ⟨v, hv, hweak⟩
    refine ⟨molecularPositionReflection eta v, ?_, ?_⟩
    · exact hv.reflection
        (molecularFourierConventionCoulombPotential_reflect_ae eta L data)
    · simpa only [map_sub] using hweak.reflection

/-- The independently defined conventional molecular Hamiltonian is precisely
the reflected completed Hamiltonian on H2. All multiplication and kinetic
identifications are proved; the only kernel input is the existing completion's
core certificate, supplied by the final construction. -/
theorem hasMolecularCoulombHamiltonian_iff_reflectedH2
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (hL : 0 < L)
    (H : MolecularFourierH2 eta →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
      fourierCubeKernelAction (2 * Real.pi / L)
        (molecularLatticeHamiltonianKernel eta L data) N u q)
    (f h : MolecularPositionL2 eta) :
    HasMolecularCoulombHamiltonian eta L data f h ↔
      ∃ u : MolecularFourierH2 eta,
        molecularPositionReflection eta
          (molecularPositionH2StateMap eta (2 * Real.pi / L) u) = f ∧
        molecularPositionReflection eta (molecularPositionHamiltonianH2 H u) = h := by
  constructor
  · intro hPhysical
    have hTwice : HasMolecularCoulombHamiltonian eta L data
        (molecularPositionReflection eta (molecularPositionReflection eta f))
        (molecularPositionReflection eta (molecularPositionReflection eta h)) := by
      simpa only [molecularPositionReflection_involutive] using hPhysical
    have hPlus :=
      (hasMolecularFourierConventionCoulombHamiltonian_reflection_iff eta L data
        (molecularPositionReflection eta f) (molecularPositionReflection eta h)).mp hTwice
    obtain ⟨u, huState, huAction⟩ :=
      (hasMolecularFourierConventionCoulombHamiltonian_iff_H2 eta L data hL H hKernel
        (molecularPositionReflection eta f) (molecularPositionReflection eta h)).mp hPlus
    refine ⟨u, ?_, ?_⟩
    · simpa only [molecularPositionReflection_involutive] using
        congrArg (molecularPositionReflection eta) huState
    · simpa only [molecularPositionReflection_involutive] using
        congrArg (molecularPositionReflection eta) huAction
  · rintro ⟨u, rfl, rfl⟩
    exact (hasMolecularFourierConventionCoulombHamiltonian_reflection_iff eta L data
      (molecularPositionH2StateMap eta (2 * Real.pi / L) u)
      (molecularPositionHamiltonianH2 H u)).mpr
        (molecularPositionHamiltonianH2_fourierConventionCoulomb eta L data hL H hKernel u)

end
end PlaneWaveCertificate

/-! ## final transport -/

namespace PlaneWaveCertificate

open MeasureTheory
open scoped BigOperators

noncomputable section

/-- Reflection transports the actual H2 domain into the convention with the
usual nuclear differences x_i - R_A. -/
def molecularPhysicalH2Domain (eta : ℕ) (g : ℝ) :
    Submodule ℂ (MolecularPositionL2 eta) :=
  (molecularPositionH2Domain eta g).map
    (molecularPositionReflection eta).toLinearEquiv.toLinearMap

/-- Reflection preserves the H2 set; the transported domain is the same
submodule of position-space L2. -/
theorem molecularPhysicalH2Domain_eq (eta : ℕ) (g : ℝ) :
    molecularPhysicalH2Domain eta g = molecularPositionH2Domain eta g :=
  molecularPositionH2Domain_map_reflection eta g

/-- The isometric domain identification used to transport all Galerkin data. -/
def molecularPhysicalDomainEquiv (eta : ℕ) (g : ℝ) :
    molecularPositionH2Domain eta g ≃ₗᵢ[ℂ] molecularPhysicalH2Domain eta g :=
  continuumDomainUnitaryEquiv (molecularPositionReflection eta)
    (molecularPositionH2Domain eta g)

@[simp] theorem molecularPhysicalDomainEquiv_apply_coe
    (eta : ℕ) (g : ℝ) (z : molecularPositionH2Domain eta g) :
    ((molecularPhysicalDomainEquiv eta g z : molecularPhysicalH2Domain eta g) :
      MolecularPositionL2 eta) = molecularPositionReflection eta (z : MolecularPositionL2 eta) :=
  continuumDomainUnitaryEquiv_apply_coe (molecularPositionReflection eta)
    (molecularPositionH2Domain eta g) z

/-- Weighted H2 coordinates parametrize the physical domain without a new
regularity hypothesis or an additional operator realization. -/
def molecularPhysicalH2DomainEquiv (eta : ℕ) (g : ℝ) :
