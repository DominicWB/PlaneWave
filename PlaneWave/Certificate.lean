/-- The coordinatewise quotient from real space to the unit torus. -/
def torusRealQuotient (d : Type*) [Fintype d] (y : d → ℝ) : UnitAddTorus d :=
  fun a => (y a : UnitAddCircle)

/-- The ordinary periodic real lift of a torus function. -/
def torusRealLift {d : Type*} [Fintype d]
    (f : UnitAddTorus d → ℂ) : (d → ℝ) → ℂ :=
  fun y => f (torusRealQuotient d y)

