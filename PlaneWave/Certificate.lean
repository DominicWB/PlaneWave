    calc (c + 2 * (((coulombKineticEnergySymbol sys (2 * Real.pi / L) p : ℝ) : ℂ) * c)) *
          (starRingEnd ℂ) c
        = (starRingEnd ℂ) c * c *
            (1 + 2 * ((coulombKineticEnergySymbol sys (2 * Real.pi / L) p : ℝ) : ℂ)) := by ring
      _ = _ := by rw [hcc]; push_cast; ring
  have h := norm_inner_le_norm (𝕜 := ℂ) a b
  rw [hinner, Complex.norm_real, Real.norm_eq_abs] at h
  exact (le_abs_self _).trans h

variable (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
