lemma boHamiltonian_norm_le_sqrt_fullH2Sq
    {eta : ℕ} {μ : Type*} [Fintype μ]
    (kabs : μ → ℝ) (coeff : FourierConfig eta μ → ℂ)
    (W : EuclideanSpace ℂ (FourierConfig eta μ) →ₗ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta μ))
    {B : ℝ} (hB : 0 ≤ B) (hBound : HasH1OperatorBound kabs W B) :
    ‖boHamiltonian kabs W (fullCoeffVector coeff)‖ ≤
      ((1 / 2 : ℝ) + B) * Real.sqrt (fullH2Sq kabs coeff) := by
  have hKinetic : ‖boKineticOperator kabs (fullCoeffVector coeff)‖ ≤
      Real.sqrt (fullH2Sq kabs coeff) := by
    have hSquare := boKineticOperator_norm_sq_le_fullH2Sq kabs coeff
    have hRootSq := Real.sq_sqrt (fullH2Sq_nonneg kabs coeff)
    have hRoot0 := Real.sqrt_nonneg (fullH2Sq kabs coeff)
