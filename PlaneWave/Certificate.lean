/-- Ordinary Fourier coefficients depend only on the almost-everywhere class. -/
theorem torus_mFourierCoeff_congr_ae {d : Type*} [Fintype d]
    {f g : UnitAddTorus d → ℂ} (h : f =ᵐ[volume] g) (q : d → ℤ) :
    UnitAddTorus.mFourierCoeff f q = UnitAddTorus.mFourierCoeff g q := by
  unfold UnitAddTorus.mFourierCoeff
  apply integral_congr_ae
  filter_upwards [h] with x hx
  rw [hx]

/-- Character intertwining identifies the pullback of each L2 Fourier basis
vector. This is derived from the literal composition representatives. -/
theorem torusFourierPullback_basis {d e : Type*} [Fintype d] [Fintype e]
    (F : UnitAddTorus d → UnitAddTorus e)
    (hF : MeasurePreserving F (volume : Measure (UnitAddTorus d)) volume)
    (J : (e → ℤ) → (d → ℤ))
    (hChar : ∀ n x, UnitAddTorus.mFourier n (F x) = UnitAddTorus.mFourier (J n) x)
    (n : e → ℤ) :
    (Lp.compMeasurePreservingₗᵢ ℂ F hF) (UnitAddTorus.mFourierLp 2 n) =
      UnitAddTorus.mFourierLp 2 (J n) := by
  apply Lp.ext
  filter_upwards [Lp.coeFn_compMeasurePreserving (UnitAddTorus.mFourierLp 2 n) hF,
    hF.quasiMeasurePreserving.ae (UnitAddTorus.coeFn_mFourierLp 2 n),
    UnitAddTorus.coeFn_mFourierLp 2 (J n)] with x hComp hSource hTarget
  exact hComp.trans (hSource.trans ((hChar n x).trans hTarget.symm))

