noncomputable section

/-- Reindex a sum over a finite Fourier cube by the actual finite mode type. -/
lemma sum_fourierConfigCube {A : Type*} [AddCommMonoid A]
    (eta count : ℕ) (f : FourierConfig eta Lattice3 → A) :
    (∑ p ∈ fourierConfigCube eta count, f p) =
      ∑ p : FourierConfig eta (FinitePlaneWaveMode count),
        f (finiteConfigLatticeIndex eta count p) := by
  classical
  change (∑ p ∈ Finset.univ.image (finiteConfigLatticeIndex eta count), f p) = _
  apply Finset.sum_image
  intro p _hp q _hq hpq
  exact finiteConfigLatticeIndex_injective eta count hpq

/-- Apply an infinite matrix to an actual finite H2 Fourier input.  The input
sum is finite, while the output coordinate may be anywhere in the lattice. -/
def fourierCubeKernelAction {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (inputCutoff : ℕ) (u : MolecularFourierH2 eta)
    (q : FourierConfig eta Lattice3) : ℂ :=
  ∑ p ∈ fourierConfigCube eta inputCutoff,
    molecularH2Coeff g u p * kernel q p

/-- Once the ambient cube contains the input support, its finite sum gives
exactly the same output coefficient.  This is algebraic compatibility, with
no continuity or convergence premise. -/
lemma finite_sum_eq_fourierCubeKernelAction {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (inputCutoff count : ℕ) (hCount : inputCutoff ≤ count)
    (u : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    (∑ p : FourierConfig eta (FinitePlaneWaveMode count),
      molecularH2Coeff g (molecularH2Truncate inputCutoff u)
        (finiteConfigLatticeIndex eta count p) *
          kernel q (finiteConfigLatticeIndex eta count p)) =
      fourierCubeKernelAction g kernel inputCutoff u q := by
  classical
  rw [← sum_fourierConfigCube eta count
    (fun p => molecularH2Coeff g (molecularH2Truncate inputCutoff u) p * kernel q p)]
  simp only [molecularH2Coeff_truncate]
  calc
    (∑ p ∈ fourierConfigCube eta count,
      cubicLatticeCoeffTruncate inputCutoff (molecularH2Coeff g u) p * kernel q p) =
        ∑ p ∈ fourierConfigCube eta inputCutoff,
          cubicLatticeCoeffTruncate inputCutoff (molecularH2Coeff g u) p * kernel q p := by
      symm
      apply Finset.sum_subset (fourierConfigCube_mono eta hCount)
      intro p _hp hpNot
      rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem inputCutoff _ p hpNot, zero_mul]
    _ = fourierCubeKernelAction g kernel inputCutoff u q := by
      unfold fourierCubeKernelAction
      apply Finset.sum_congr rfl
      intro p hp
      rw [cubicLatticeCoeffTruncate_eq_of_mem inputCutoff _ p hp]

/-- The core action depends only on the finite input vector, not on the cutoff
or ambient weighted vector used to describe that input. -/
lemma fourierCubeKernelAction_eq_of_truncate_eq {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (N M : ℕ) (u w : MolecularFourierH2 eta)
    (hInput : molecularH2Truncate N u = molecularH2Truncate M w) :
    fourierCubeKernelAction g kernel N u = fourierCubeKernelAction g kernel M w := by
  funext q
  rw [← finite_sum_eq_fourierCubeKernelAction g kernel N (max N M)
    (le_max_left N M) u q]
  rw [← finite_sum_eq_fourierCubeKernelAction g kernel M (max N M)
    (le_max_right N M) w q]
  rw [hInput]

/-- The coefficient formula is additive in the weighted input. -/
lemma fourierCubeKernelAction_add {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (N : ℕ) (u w : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    fourierCubeKernelAction g kernel N (u + w) q =
      fourierCubeKernelAction g kernel N u q + fourierCubeKernelAction g kernel N w q := by
  classical
  unfold fourierCubeKernelAction
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro p _hp
  change ((u p + w p) / (molecularFourierH2Weight eta g p : ℂ)) * kernel q p =
    (u p / (molecularFourierH2Weight eta g p : ℂ)) * kernel q p +
      (w p / (molecularFourierH2Weight eta g p : ℂ)) * kernel q p
  rw [add_div, add_mul]

/-- The coefficient formula respects complex scalar multiplication. -/
lemma fourierCubeKernelAction_smul {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (N : ℕ) (a : ℂ) (u : MolecularFourierH2 eta) (q : FourierConfig eta Lattice3) :
    fourierCubeKernelAction g kernel N (a • u) q =
      a * fourierCubeKernelAction g kernel N u q := by
  classical
  unfold fourierCubeKernelAction
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p _hp
  change ((a * u p) / (molecularFourierH2Weight eta g p : ℂ)) * kernel q p =
    a * ((u p / (molecularFourierH2Weight eta g p : ℂ)) * kernel q p)
  ring

/-- The finite matrix output on the fixed finite input, at any ambient cutoff.
The molecular specialization below identifies this with the literal physical
Hamiltonian, rather than assuming a matrix representation. -/
def fourierKernelFiniteOutput {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (inputCutoff : ℕ) (u : MolecularFourierH2 eta) (count : ℕ) :
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) :=
  fullCoeffVector (fun q =>
    ∑ p : FourierConfig eta (FinitePlaneWaveMode count),
      molecularH2Coeff g (molecularH2Truncate inputCutoff u)
        (finiteConfigLatticeIndex eta count p) *
          kernel (finiteConfigLatticeIndex eta count q)
            (finiteConfigLatticeIndex eta count p))

lemma fourierKernelFiniteOutput_apply {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (inputCutoff count : ℕ) (hCount : inputCutoff ≤ count)
    (u : MolecularFourierH2 eta)
    (q : FourierConfig eta (FinitePlaneWaveMode count)) :
    (fourierKernelFiniteOutput g kernel inputCutoff u count).ofLp q =
      fourierCubeKernelAction g kernel inputCutoff u
        (finiteConfigLatticeIndex eta count q) := by
  change (∑ p : FourierConfig eta (FinitePlaneWaveMode count),
