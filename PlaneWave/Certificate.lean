section DevU15

/-!
# Dynamics: `thm:dyn` and `cor:norm` with internal spin

The manuscript's dynamics acts on `L²(T^{η_tot}; 𝒱)` (`eta` is `η_tot`) with the finite spin space
`𝒱 = ⊗_a ℂ^{d_a}`; the Hamiltonian, the projector `P` and the observable `χ(x_a)` do not act on the
spin, so they act on each spin component. The certificate's spin-inclusive space is
`CoulombSpinL2 eta D` (one `L²` component for each spin configuration `σ : Fin eta → Fin D`, norms
combined in `ℓ²`; when every `d_a ≤ D` it contains `L²(T^{η_tot}; 𝒱)` isometrically, as the states
whose components at invalid spin values vanish), with the spin-independent Hamiltonian
`HasCoulombSpinHamiltonian` acting on each component.

* `obsRateBound_eq_mul`, `obsRateBound_sum_le`: for nonnegative data, `obsRateBound` is the
  product `δ₁ · ℓ` of two linear forms with nonnegative coefficients in
  `(‖ψ₀‖, ‖H ψ₀‖, ‖H ψ₀‖, ‖H² ψ₀‖)`, so it is superadditive under the `ℓ²` combination of the
  data (Cauchy–Schwarz, `sum_bilinear_le`).
* `thm_dyn_spin`, `thm_dyn_spin_rates`: `thm:dyn` on `CoulombSpinL2 eta D`: the propagator
  `e^{-iHt}` (characterised as in `thm_dyn`; it acts on every spin component by one and the same
  isometry), the Galerkin propagator and the observable `χ(x_a) ⊗ 1` (`spinLift`) on each
  component, and the bound of `thm_dyn` at the spin-inclusive norms, with the same constants
  `obsConsts`.
* `coulomb_observable_normalised_spin`, `coulomb_normalisation_threshold_spin`: `cor:norm` on
  `CoulombSpinL2 eta D`; the defect `‖(1 - P) Ψ₀‖² ≤ (δ₁ K^{-5/2})²` at the spin-inclusive norms
  follows from the component bounds by Minkowski's inequality (`obsTailConst_sum_sq_le`).

The exchange sector plays no role: the bounds hold for every `Ψ₀ ∈ D(H²)` of the spin-inclusive
space, in particular for the physical states (`IsCoulombSpinSector sys dim Ψ₀` with every
`dim s ≤ D`), i.e. for `Ψ₀ ∈ D(H²) ∩ 𝒮`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveDynamics

open PlaneWaveCertificate

/-! ## Products of nonnegative linear forms are superadditive under `ℓ²` combination -/

/-- `Σ_i (a · x_i)(b · x_i) ≤ (a · X)(b · X)` with `X_j = (Σ_i x_{ij}²)^{1/2}`, for `a, b ≥ 0`. -/
lemma sum_bilinear_le {ι m : Type*} [Fintype m] (s : Finset ι) (x : ι → m → ℝ) (a b : m → ℝ)
    (ha : ∀ j, 0 ≤ a j) (hb : ∀ j, 0 ≤ b j) :
    ∑ i ∈ s, (∑ j, a j * x i j) * (∑ k, b k * x i k) ≤
      (∑ j, a j * Real.sqrt (∑ i ∈ s, x i j ^ 2)) *
          (∑ k, b k * Real.sqrt (∑ i ∈ s, x i k ^ 2)) := by
  have h1 : ∀ i, (∑ j, a j * x i j) * (∑ k, b k * x i k) =
      ∑ j, ∑ k, (a j * b k) * (x i j * x i k) := by
    intro i
    rw [Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => ?_
    ring
  have h2 : (∑ j, a j * Real.sqrt (∑ i ∈ s, x i j ^ 2)) *
      (∑ k, b k * Real.sqrt (∑ i ∈ s, x i k ^ 2)) =
      ∑ j, ∑ k, (a j * b k) * (Real.sqrt (∑ i ∈ s, x i j ^ 2) * Real.sqrt
          (∑ i ∈ s, x i k ^ 2)) := by
    rw [Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [h2, Finset.sum_congr rfl fun i _ => h1 i, Finset.sum_comm]
  refine Finset.sum_le_sum fun j _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_le_sum fun k _ => ?_
  rw [← Finset.mul_sum]
  exact mul_le_mul_of_nonneg_left (Real.sum_mul_le_sqrt_mul_sqrt s _ _)
    (mul_nonneg (ha j) (hb k))

/-! ## The bound as a product of two linear forms -/

variable {eta : ℕ} {ν : Type} [Fintype ν]

lemma tailConstant_linear (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker M : ℝ) :
    finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M =
      M * finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1 := by
  unfold finiteCoulombPhysicalTailConstant finiteCoulombTailConstant
  ring

/-- The first linear form: `δ₁` of `obsRateBound` as a function of the data
`x = (‖ψ₀‖, ‖H ψ₀‖, ‖H ψ₀‖, ‖H² ψ₀‖)`. -/
noncomputable def deltaLin (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ)
    (x : Fin 4 → ℝ) : ℝ :=
  let b := relB sys L Hunit
  let κ := finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1
  let m := sys.maxMass
  eta * (2 * m * (2 * m * (2 * x 3 + 2 * b * x 2) + κ * (m * (x 0 + 2 * (2 * x 1 + 2 * b * x 0)))))

/-- The second linear form. -/
noncomputable def ellLin (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ)
    (a : Fin eta) (χ : Lattice3 → ℂ) (t : ℝ) (x : Fin 4 → ℝ) : ℝ :=
  let g : ℝ := 2 * Real.pi / L
  let K : ℝ := g * n
  let b := relB sys L Hunit
  let κ := finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1
  let m := sys.maxMass
  let C := finiteCoulombPhysicalMassConstant sys L Hunit
  let CO : ℝ := ‖convOp (eta := eta) a χ‖
  let Cχ : ℝ := ∑' ν, ‖χ ν‖
  let τχ : ℝ := ∑' ν, if K / 2 < g * Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0
  let D : ℝ := commConst g a χ
  let Ξ₀ := 2 * x 1 + 2 * b * x 0
  let Ξ₁ := 2 * x 3 + 2 * b * x 2
  let M20 := m * (x 0 + 2 * Ξ₀)
  let β := 2 * m * Ξ₁ + κ * M20
  let δ₁ := eta * (2 * m * β)
  let τ₁ := 8 * m * (8 * m * Ξ₁ + 2 * (κ * M20))
  let N₁ := C * eta * Real.sqrt (2 * m * (2 * m + 2)) * β
  let Hw1 := 2 * ((CO + 2 * D) * Ξ₀ + D * x 0) + 2 * b * (CO * x 0)
  let M1 := m * (CO * x 0 + 2 * (2 * Hw1 + 2 * b * (CO * x 0)))
  let Tη := 2 * (2 * (2 * Ξ₀ + 2 * b * x 0)) + 2 * b * (2 * x 0)
  let Hw2 := 2 * ((CO + 2 * D) * Tη + D * (2 * x 0)) + 2 * b * (CO * (2 * x 0))
  let M2 := m * (CO * (2 * x 0) + 2 * (2 * Hw2 + 2 * b * (CO * (2 * x 0))))
  (2 * (Cχ * τ₁) + 3 * (CO * δ₁)) * rho ^ 10 +
    (2 * (eta * (κ * M1)) + 2 * (CO * N₁) + eta * (κ * M2)) * t * rho ^ 6 +
    2 * x 0 * rho ^ 5 * τχ

lemma deltaLin_eq (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ) (x : Fin 4 → ℝ) :
    deltaLin sys L Hunit Blow Cs Bker x =
      ∑ j, deltaLin sys L Hunit Blow Cs Bker (Pi.single j 1) * x j := by
  simp only [deltaLin, Fin.sum_univ_four]
  simp
  ring

lemma ellLin_eq (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ) (a : Fin eta)
    (χ : Lattice3 → ℂ) (t : ℝ) (x : Fin 4 → ℝ) :
    ellLin sys L Hunit Blow Cs Bker rho n a χ t x =
      ∑ j, ellLin sys L Hunit Blow Cs Bker rho n a χ t (Pi.single j 1) * x j := by
  simp only [ellLin, Fin.sum_univ_four]
  simp
  ring

lemma deltaLin_nonneg (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ)
    (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) {x : Fin 4 → ℝ} (hx : ∀ j, 0 ≤ x j) :
    0 ≤ deltaLin sys L Hunit Blow Cs Bker x := by
  have hb := relB_nonneg sys L Hunit hC
  have hM := sys.one_le_maxMass
  have hκ := finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker zero_le_one
  have h0 := hx 0
  have h1 := hx 1
  have h2 := hx 2
  have h3 := hx 3
  simp only [deltaLin]
  positivity

lemma ellLin_nonneg (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ)
    (a : Fin eta) (χ : Lattice3 → ℂ) (t : ℝ)
    (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) (hρ : 0 ≤ rho) (ht : 0 ≤ t) {x : Fin 4 → ℝ} (hx : ∀ j, 0 ≤ x j) :
    0 ≤ ellLin sys L Hunit Blow Cs Bker rho n a χ t x := by
  have hb := relB_nonneg sys L Hunit hC
  have hM := sys.one_le_maxMass
  have hκ := finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker zero_le_one
  have h0 := hx 0
  have h1 := hx 1
  have h2 := hx 2
  have h3 := hx 3
  have hCχ : 0 ≤ ∑' ν, ‖χ ν‖ := tsum_nonneg fun _ => norm_nonneg _
  have hτ : 0 ≤ ∑' ν, if (2 * Real.pi / L) * n / 2 < (2 * Real.pi / L) *
      Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0 :=
    tsum_nonneg fun _ => by split_ifs <;> simp
  have hD := commConst_nonneg (2 * Real.pi / L) a χ
  simp only [ellLin]
  positivity

lemma sqrt_prod_aux (e m β : ℝ) (he : 0 ≤ e) (hβ : 0 ≤ β) :
    Real.sqrt (e * (2 * m * β) * (e * ((2 * m + 2) * β))) =
      e * Real.sqrt (2 * m * (2 * m + 2)) * β := by
  have h : e * (2 * m * β) * (e * ((2 * m + 2) * β)) = (e * β) ^ 2 * (2 * m * (2 * m + 2)) := by
    ring
  rw [h, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (mul_nonneg he hβ)]
  ring

/-- **Product form.** For nonnegative data, `obsRateBound = δ₁ · ℓ`. -/
theorem obsRateBound_eq_mul (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ)
    (a : Fin eta) (χ : Lattice3 → ℂ) (t : ℝ)
        (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    {s0 hu hs hv : ℝ} (h0 : 0 ≤ s0) (h1 : 0 ≤ hu) (h2 : 0 ≤ hs) (h3 : 0 ≤ hv) :
    obsRateBound sys L Hunit Blow Cs Bker rho n a χ s0 hu hs hv t =
      deltaLin sys L Hunit Blow Cs Bker ![s0, hu, hs, hv] *
        ellLin sys L Hunit Blow Cs Bker rho n a χ t ![s0, hu, hs, hv] := by
  have hb := relB_nonneg sys L Hunit hC
  have hM := sys.one_le_maxMass
  have hκ0 := finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker zero_le_one
  obtain ⟨κ, hκdef⟩ : ∃ κ, finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1 = κ :=
    ⟨_, rfl⟩
  have hlin : ∀ M, finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M = M * κ := by
    intro M
    rw [tailConstant_linear, hκdef]
  rw [hκdef] at hκ0
  simp only [obsRateBound, deltaLin, ellLin, hlin, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val]
  rw [sqrt_prod_aux _ _ _ (Nat.cast_nonneg _) _]
  · ring
  · positivity

/-- **Superadditivity.** For nonnegative data, the sum of the bounds of a finite family is at most
the bound of the `ℓ²`-combined data. -/
theorem obsRateBound_sum_le (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ)
    (a : Fin eta) (χ : Lattice3 → ℂ) (t : ℝ)
        (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hρ : 0 ≤ rho) (ht : 0 ≤ t)
    {ι : Type*} (s : Finset ι) (x0 x1 x2 x3 : ι → ℝ) (h0 : ∀ i, 0 ≤ x0 i) (h1 : ∀ i, 0 ≤ x1 i)
    (h2 : ∀ i, 0 ≤ x2 i) (h3 : ∀ i, 0 ≤ x3 i) :
    ∑ i ∈ s, obsRateBound sys L Hunit Blow Cs Bker rho n a χ (x0 i) (x1 i) (x2 i) (x3 i) t ≤
      obsRateBound sys L Hunit Blow Cs Bker rho n a χ (Real.sqrt (∑ i ∈ s, x0 i ^ 2))
        (Real.sqrt (∑ i ∈ s, x1 i ^ 2)) (Real.sqrt (∑ i ∈ s, x2 i ^ 2))
        (Real.sqrt (∑ i ∈ s, x3 i ^ 2)) t := by
  have hsingle : ∀ j k : Fin 4, 0 ≤ (Pi.single j (1 : ℝ) : Fin 4 → ℝ) k := fun j k =>
    (Pi.single_nonneg.2 zero_le_one : (0 : Fin 4 → ℝ) ≤ Pi.single j (1 : ℝ)) k
  have key := sum_bilinear_le s (fun i => ![x0 i, x1 i, x2 i, x3 i])
    (fun j => deltaLin sys L Hunit Blow Cs Bker (Pi.single j 1))
    (fun j => ellLin sys L Hunit Blow Cs Bker rho n a χ t (Pi.single j 1))
    (fun j => deltaLin_nonneg sys L Hunit Blow Cs Bker hC hBlow hCs hBker (hsingle j))
    (fun j => ellLin_nonneg sys L Hunit Blow Cs Bker rho n a χ t hC hBlow hCs hBker hρ ht
      (hsingle j))
  have hX : ∀ j : Fin 4, Real.sqrt (∑ i ∈ s, (![x0 i, x1 i, x2 i, x3 i] : Fin 4 → ℝ) j ^ 2) =
      (![Real.sqrt (∑ i ∈ s, x0 i ^ 2), Real.sqrt (∑ i ∈ s, x1 i ^ 2),
        Real.sqrt (∑ i ∈ s, x2 i ^ 2), Real.sqrt (∑ i ∈ s, x3 i ^ 2)] : Fin 4 → ℝ) j := by
    intro j
    fin_cases j <;> rfl
  calc ∑ i ∈ s, obsRateBound sys L Hunit Blow Cs Bker rho n a χ (x0 i) (x1 i) (x2 i) (x3 i) t
      = ∑ i ∈ s, (∑ j, deltaLin sys L Hunit Blow Cs Bker (Pi.single j 1) *
            (![x0 i, x1 i, x2 i, x3 i] : Fin 4 → ℝ) j) *
          (∑ k, ellLin sys L Hunit Blow Cs Bker rho n a χ t (Pi.single k 1) *
            (![x0 i, x1 i, x2 i, x3 i] : Fin 4 → ℝ) k) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [obsRateBound_eq_mul sys L Hunit Blow Cs Bker rho n a χ t hC hBlow hCs hBker (h0 i)
          (h1 i) (h2 i) (h3 i), deltaLin_eq sys L Hunit Blow Cs Bker,
          ellLin_eq sys L Hunit Blow Cs Bker rho n a χ t]
    _ ≤ _ := key
    _ = _ := by
        rw [obsRateBound_eq_mul sys L Hunit Blow Cs Bker rho n a χ t hC hBlow hCs hBker
          (Real.sqrt_nonneg _) (Real.sqrt_nonneg _) (Real.sqrt_nonneg _) (Real.sqrt_nonneg _),
          deltaLin_eq sys L Hunit Blow Cs Bker, ellLin_eq sys L Hunit Blow Cs Bker rho n a χ t]
        simp only [hX]

/-! ## The spin-inclusive space -/

/-- An operator on `L²((T³)^η)` acting on each spin component of `CoulombSpinL2 eta D`
(`A ⊗ 1` on `L²((T³)^η) ⊗ 𝒱`). -/
noncomputable def spinLift {D : ℕ} (A : MolecularPositionL2 eta →L[ℂ] MolecularPositionL2 eta) :
    CoulombSpinL2 eta D →L[ℂ] CoulombSpinL2 eta D :=
  ((PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).symm :
      ((Fin eta → Fin D) → MolecularPositionL2 eta) →L[ℂ] CoulombSpinL2 eta D).comp
    ((ContinuousLinearMap.pi fun σ => A.comp (ContinuousLinearMap.proj σ)).comp
      (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin eta → Fin D => MolecularPositionL2 eta) :
        CoulombSpinL2 eta D →L[ℂ] ((Fin eta → Fin D) → MolecularPositionL2 eta)))

lemma spinLift_apply {D : ℕ} (A : MolecularPositionL2 eta →L[ℂ] MolecularPositionL2 eta)
    (Ψ : CoulombSpinL2 eta D) (σ : Fin eta → Fin D) : spinLift A Ψ σ = A (Ψ σ) :=
  rfl

/-- A family of isometries `U(t)` of `L²((T³)^η)` applied to each spin component (`U(t) ⊗ 1`). -/
noncomputable def spinProp {D : ℕ} (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta)
    (t : ℝ) : CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D :=
  LinearIsometryEquiv.piLpCongrRight 2 fun _ => U t

lemma spinProp_apply {D : ℕ} (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta)
    (t : ℝ) (Ψ : CoulombSpinL2 eta D) (σ : Fin eta → Fin D) : spinProp U t Ψ σ = U t (Ψ σ) :=
  rfl

/-- The componentwise action of an operator has at most its norm. -/
lemma norm_spinLift_le {D : ℕ} (A : MolecularPositionL2 eta →L[ℂ] MolecularPositionL2 eta) :
    ‖(spinLift A : CoulombSpinL2 eta D →L[ℂ] CoulombSpinL2 eta D)‖ ≤ ‖A‖ := by
  refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _) fun Ψ => ?_
  rw [PiLp.norm_eq_of_L2 (spinLift A Ψ), PiLp.norm_eq_of_L2 Ψ]
  calc Real.sqrt (∑ σ, ‖spinLift A Ψ σ‖ ^ 2) ≤ Real.sqrt (∑ σ, (‖A‖ * ‖Ψ σ‖) ^ 2) := by
        refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun σ _ => ?_)
        rw [spinLift_apply]
        exact pow_le_pow_left₀ (norm_nonneg _) (A.le_opNorm _) 2
    _ = ‖A‖ * Real.sqrt (∑ σ, ‖Ψ σ‖ ^ 2) := by
        have e : (∑ σ, (‖A‖ * ‖Ψ σ‖) ^ 2) = ‖A‖ ^ 2 * ∑ σ, ‖Ψ σ‖ ^ 2 := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun σ _ => by ring
        rw [e, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (norm_nonneg _)]

/-- **From the spin components to the spin-inclusive state.** If the observable error of every
spin component is bounded by `obsRateBound` at the norms of that component, the observable error
of the spin-inclusive state is bounded by `obsRateBound` at the spin-inclusive norms. -/
theorem spin_obs_le {D : ℕ} (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ)
    (a : Fin eta) (χ : Lattice3 → ℂ) (t : ℝ)
        (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hρ : 0 ≤ rho) (ht : 0 ≤ t)
    (O : MolecularPositionL2 eta →L[ℂ] MolecularPositionL2 eta)
    (Ψt ΨN Ψ₀ H₀ H₁ : CoulombSpinL2 eta D)
    (hcomp : ∀ σ, ‖⟪Ψt σ, O (Ψt σ)⟫_ℂ - ⟪ΨN σ, O (ΨN σ)⟫_ℂ‖ ≤
      obsRateBound sys L Hunit Blow Cs Bker rho n a χ ‖Ψ₀ σ‖ ‖H₀ σ‖ ‖H₀ σ‖ ‖H₁ σ‖ t) :
    ‖⟪Ψt, spinLift O Ψt⟫_ℂ - ⟪ΨN, spinLift O ΨN⟫_ℂ‖ ≤
      obsRateBound sys L Hunit Blow Cs Bker rho n a χ ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ t := by
  have hsplit : ⟪Ψt, spinLift O Ψt⟫_ℂ - ⟪ΨN, spinLift O ΨN⟫_ℂ =
      ∑ σ, (⟪Ψt σ, O (Ψt σ)⟫_ℂ - ⟪ΨN σ, O (ΨN σ)⟫_ℂ) := by
    rw [PiLp.inner_apply, PiLp.inner_apply, ← Finset.sum_sub_distrib]
    rfl
  rw [hsplit]
  refine (norm_sum_le _ _).trans ((Finset.sum_le_sum fun σ _ => hcomp σ).trans ?_)
  rw [PiLp.norm_eq_of_L2 Ψ₀, PiLp.norm_eq_of_L2 H₀, PiLp.norm_eq_of_L2 H₁]
  exact obsRateBound_sum_le sys L Hunit Blow Cs Bker rho n a χ t hC hBlow hCs hBker hρ ht
    Finset.univ (fun σ => ‖Ψ₀ σ‖) (fun σ => ‖H₀ σ‖) (fun σ => ‖H₀ σ‖) (fun σ => ‖H₁ σ‖)
    (fun _ => norm_nonneg _) (fun _ => norm_nonneg _) (fun _ => norm_nonneg _)
    (fun _ => norm_nonneg _)

/-- **`thm:dyn` with internal spin.** On the spin-inclusive space `CoulombSpinL2 eta D`
(`L²((T³)^η) ⊗ (ℂ^D)^{⊗η}`, one component for each spin configuration; it contains
`L²((T³)^η; 𝒱)` with `𝒱 = ⊗_a ℂ^{d_a}` when every `d_a ≤ D`), the propagator `e^{-iHt}` of the
spin-independent Coulomb Hamiltonian is a strongly continuous unitary group that preserves the
graph of `H`, solves the Schrödinger equation on it and is the only evolution that does; it acts
on every spin component by one and the same isometry. The Galerkin propagator `e^{-iH_N t}` acts
on each spin component, and for `n ≥ 4` with `K = 2πn/L ≥ 2`, every
`Ψ₀ ∈ D(H²)` (`H Ψ₀ = H₀`, `H H₀ = H₁`), every register `a`, every real continuous `χ` on the unit
torus with `Σ_ν (1 + g²|ν|²) |χ̂(ν)| < ∞` and every `t ≥ 0`,
`|⟪Ψ(t), χ(x_a) Ψ(t)⟫ - ⟪Ψ_N(t), χ(x_a) Ψ_N(t)⟫|` is bounded by `obsRateBound` at the
spin-inclusive norms `‖Ψ₀‖, ‖H₀‖, ‖H₀‖, ‖H₁‖`: the bound of `thm_dyn`, with the same constants. -/
theorem thm_dyn_spin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (D : ℕ) :
    ∃ U : ℝ → CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D,
      (∀ Ψ, U 0 Ψ = Ψ) ∧
      (∀ s t Ψ, U (s + t) Ψ = U s (U t Ψ)) ∧
      (∀ Ψ, Continuous fun t => U t Ψ) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasCoulombSpinHamiltonian sys L (U t Ψ) (U t Φ)) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasDerivAt (fun s => U s Ψ) (-(Complex.I • U t Φ)) t) ∧
      (∀ φ ζ : ℝ → CoulombSpinL2 eta D, (∀ t, HasCoulombSpinHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      (∀ t, ∃ V : MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
        ∀ Ψ σ, U t Ψ σ = V (Ψ σ)) ∧
      ∀ n : ℕ, ∃ UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ x, UN 0 x = x) ∧ (∀ s t x, UN (s + t) x = UN s (UN t x)) ∧
        (∀ t x, HasDerivAt (fun s => UN s x)
          (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t) ∧
        (4 ≤ n → 2 ≤ (2 * Real.pi / L) * n →
          ∀ Ψ₀ H₀ H₁ : CoulombSpinL2 eta D, HasCoulombSpinHamiltonian sys L Ψ₀ H₀ →
          HasCoulombSpinHamiltonian sys L H₀ H₁ →
          ∀ (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)),
          Summable (fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
            ‖UnitAddTorus.mFourierCoeff χ ν‖) →
          (∀ y, conj (χ y) = χ y) → ∀ t : ℝ, 0 ≤ t →
          let ΨN : CoulombSpinL2 eta D := WithLp.toLp 2 fun σ => physMap eta
            (finiteFourierLpIsometry eta n (UN t (extractCLM n ((physMap eta).symm (Ψ₀ σ)))))
          ‖⟪U t Ψ₀, spinLift (mulCLM (regFun a χ)) (U t Ψ₀)⟫_ℂ -
              ⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ‖ ≤
            obsRateBound sys L molecularCanonicalUnitHardyConstant
              (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
              (molecularCanonicalKernelConstant L) (Real.sqrt (1 / ((2 * Real.pi / L) * n))) n a
              (UnitAddTorus.mFourierCoeff χ) ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ t) := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hrest⟩ := thm_dyn sys L hL
  refine ⟨spinProp U, fun Ψ => ?_, fun s t Ψ => ?_, fun Ψ => ?_, fun t Ψ Φ hH => ?_,
    fun t Ψ Φ hH => ?_, fun φ ζ hH hφ t => ?_, fun t => ⟨U t, fun Ψ σ => spinProp_apply U t Ψ σ⟩,
    fun n => ?_⟩
  · refine PiLp.ext fun σ => ?_
    rw [spinProp_apply]
    exact h0 _
  · refine PiLp.ext fun σ => ?_
    rw [spinProp_apply, spinProp_apply, spinProp_apply]
    exact hadd s t _
  · exact (PiLp.continuous_toLp 2 (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).comp
      (continuous_pi fun σ => hcont (Ψ σ))
  · intro σ
    rw [spinProp_apply, spinProp_apply]
    exact hgraph t _ _ (hH σ)
  · have hd : HasDerivAt (fun s => (fun σ => U s (Ψ σ) : (Fin eta → Fin D) →
      MolecularPositionL2 eta))
        (fun σ => -(Complex.I • U t (Φ σ))) t :=
      hasDerivAt_pi.2 fun σ => hderiv t (Ψ σ) (Φ σ) (hH σ)
    have hd2 := (PiLp.continuousLinearEquiv 2 ℝ
      (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).symm.hasFDerivAt.comp_hasDerivAt t hd
    have e1 : (fun s => spinProp (D := D) U s Ψ) = (PiLp.continuousLinearEquiv 2 ℝ
        (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).symm ∘ fun s σ => U s (Ψ σ) :=
      rfl
    have e2 : -(Complex.I • spinProp U t Φ) = (PiLp.continuousLinearEquiv 2 ℝ
        (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)).symm
          (fun σ => -(Complex.I • U t (Φ σ))) :=
      rfl
    rw [e1, e2]
    exact hd2
  · refine PiLp.ext fun σ => ?_
    rw [spinProp_apply]
    have hd : ∀ s, HasDerivAt (fun r => φ r σ) (-(Complex.I • ζ s σ)) s := fun s =>
      (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin eta → Fin D => MolecularPositionL2 eta)
        σ).hasFDerivAt.comp_hasDerivAt s (hφ s)
    exact huniq (fun r => φ r σ) (fun r => ζ r σ) (fun r => hH r σ) hd t
  · obtain ⟨UN, hN0, hNadd, hNderiv, hbound⟩ := hrest n
    refine ⟨UN, hN0, hNadd, hNderiv, ?_⟩
    intro hn hK2 Ψ₀ H₀ H₁ hΨ₀ hH₀ a χ hχ2 hreal t ht ΨN
    obtain ⟨hBlow, hCs, hBker, -⟩ := molecularCanonicalTailConstants_spec L hL
    exact spin_obs_le sys L molecularCanonicalUnitHardyConstant (molecularCanonicalLowConstant L)
      (molecularCanonicalSobolevConstant L) (molecularCanonicalKernelConstant L)
      (Real.sqrt (1 / ((2 * Real.pi / L) * n))) n a (UnitAddTorus.mFourierCoeff χ) t
      (finiteCoulombPhysicalMassConstant_nonneg _ _ _) hBlow hCs hBker (Real.sqrt_nonneg _) ht
      (mulCLM (regFun a χ)) (spinProp U t Ψ₀) ΨN Ψ₀ H₀ H₁ fun σ =>
        hbound hn hK2 (Ψ₀ σ) (H₀ σ) (H₁ σ) (hΨ₀ σ) (hH₀ σ) a χ hχ2 hreal t ht

/-- `thm_dyn_spin` with constants independent of `K` and `t` (`eq:dyn-main` on the
spin-inclusive space): the constants `(A₁, A₂, A₃) = obsConsts` of `thm_dyn_rates`, at the
spin-inclusive norms `(‖Ψ₀‖, ‖H₀‖, ‖H₀‖, ‖H₁‖)`. -/
theorem thm_dyn_spin_rates (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (D : ℕ) :
    ∃ U : ℝ → CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D,
      (∀ Ψ, U 0 Ψ = Ψ) ∧
      (∀ s t Ψ, U (s + t) Ψ = U s (U t Ψ)) ∧
      (∀ Ψ, Continuous fun t => U t Ψ) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasCoulombSpinHamiltonian sys L (U t Ψ) (U t Φ)) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasDerivAt (fun s => U s Ψ) (-(Complex.I • U t Φ)) t) ∧
      (∀ φ ζ : ℝ → CoulombSpinL2 eta D, (∀ t, HasCoulombSpinHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      (∀ t, ∃ V : MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
        ∀ Ψ σ, U t Ψ σ = V (Ψ σ)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ Ψ₀ H₀ H₁ : CoulombSpinL2 eta D, HasCoulombSpinHamiltonian sys L Ψ₀ H₀ →
          HasCoulombSpinHamiltonian sys L H₀ H₁ →
          ∀ (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)),
          Summable (fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
            ‖UnitAddTorus.mFourierCoeff χ ν‖) →
          (∀ y, conj (χ y) = χ y) →
          let A := obsConsts sys L molecularCanonicalUnitHardyConstant
            (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
            (molecularCanonicalKernelConstant L) a (UnitAddTorus.mFourierCoeff χ)
            ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖
          ∀ n : ℕ, 4 ≤ n → 2 ≤ (2 * Real.pi / L) * n → ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            let ΨN : CoulombSpinL2 eta D := WithLp.toLp 2 fun σ => physMap eta
              (finiteFourierLpIsometry eta n (UN n t (extractCLM n ((physMap eta).symm (Ψ₀ σ)))))
            ‖⟪U t Ψ₀, spinLift (mulCLM (regFun a χ)) (U t Ψ₀)⟫_ℂ -
                ⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ‖ ≤
              A.1 * (1 / K) ^ 5 + A.2.1 * t * (1 / K) ^ 3 +
                A.2.2 * Real.sqrt (1 / K) ^ 5 * obsTail L n (UnitAddTorus.mFourierCoeff χ) := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hcompo, hrest⟩ := thm_dyn_spin sys L hL D
  choose UN hN0 hNadd hNderiv hbound using hrest
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hcompo, UN, hN0, hNadd, hNderiv, ?_⟩
  intro Ψ₀ H₀ H₁ hΨ₀ hH₀ a χ hχ2 hreal A n hn hK2 t ht K ΨN
  have h := hbound n hn hK2 Ψ₀ H₀ H₁ hΨ₀ hH₀ a χ hχ2 hreal t ht
  rw [obsRateBound_eq] at h
  have hKpos : 0 < K := by
    have : (0 : ℝ) < 2 := two_pos
    linarith
  have hρ2 : Real.sqrt (1 / K) ^ 2 = 1 / K := Real.sq_sqrt (by positivity)
  have e10 : Real.sqrt (1 / K) ^ 10 = (1 / K) ^ 5 := by
    rw [show (10 : ℕ) = 2 * 5 by norm_num, pow_mul, hρ2]
  have e6 : Real.sqrt (1 / K) ^ 6 = (1 / K) ^ 3 := by
    rw [show (6 : ℕ) = 2 * 3 by norm_num, pow_mul, hρ2]
  rw [e10, e6] at h
  exact h

/-! ## The normalised Galerkin state with spin (`cor:norm`) -/

lemma obsTailConst_eq (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker s0 hu hs hv : ℝ) :
    obsTailConst sys L Hunit Blow Cs Bker s0 hu hs hv =
      deltaLin sys L Hunit Blow Cs Bker ![s0, hu, hs, hv] := by
  obtain ⟨κ, hκdef⟩ : ∃ κ, finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker 1 = κ :=
    ⟨_, rfl⟩
  have hlin : ∀ M, finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M = M * κ := by
    intro M
    rw [tailConstant_linear, hκdef]
  simp only [obsTailConst, deltaLin, hlin, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val]
  ring

/-- The squares of the tail constants of a finite family sum to at most the square of the tail
constant of the `ℓ²`-combined data (Minkowski). -/
theorem obsTailConst_sum_sq_le (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ)
    (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs)
    (hBker : 0 ≤ Bker) {ι : Type*} (s : Finset ι) (x0 x1 x2 x3 : ι → ℝ) :
    ∑ i ∈ s, obsTailConst sys L Hunit Blow Cs Bker (x0 i) (x1 i) (x2 i) (x3 i) ^ 2 ≤
      obsTailConst sys L Hunit Blow Cs Bker (Real.sqrt (∑ i ∈ s, x0 i ^ 2))
        (Real.sqrt (∑ i ∈ s, x1 i ^ 2)) (Real.sqrt (∑ i ∈ s, x2 i ^ 2))
        (Real.sqrt (∑ i ∈ s, x3 i ^ 2)) ^ 2 := by
  have hsingle : ∀ j k : Fin 4, 0 ≤ (Pi.single j (1 : ℝ) : Fin 4 → ℝ) k := fun j k =>
    (Pi.single_nonneg.2 zero_le_one : (0 : Fin 4 → ℝ) ≤ Pi.single j (1 : ℝ)) k
  have hA : ∀ j, 0 ≤ deltaLin sys L Hunit Blow Cs Bker (Pi.single j 1) := fun j =>
    deltaLin_nonneg sys L Hunit Blow Cs Bker hC hBlow hCs hBker (hsingle j)
  have key := sum_bilinear_le s (fun i => ![x0 i, x1 i, x2 i, x3 i])
    (fun j => deltaLin sys L Hunit Blow Cs Bker (Pi.single j 1))
    (fun j => deltaLin sys L Hunit Blow Cs Bker (Pi.single j 1)) hA hA
  have hX : ∀ j : Fin 4, Real.sqrt (∑ i ∈ s, (![x0 i, x1 i, x2 i, x3 i] : Fin 4 → ℝ) j ^ 2) =
      (![Real.sqrt (∑ i ∈ s, x0 i ^ 2), Real.sqrt (∑ i ∈ s, x1 i ^ 2),
        Real.sqrt (∑ i ∈ s, x2 i ^ 2), Real.sqrt (∑ i ∈ s, x3 i ^ 2)] : Fin 4 → ℝ) j := by
    intro j
    fin_cases j <;> rfl
  calc ∑ i ∈ s, obsTailConst sys L Hunit Blow Cs Bker (x0 i) (x1 i) (x2 i) (x3 i) ^ 2
      = ∑ i ∈ s, (∑ j, deltaLin sys L Hunit Blow Cs Bker (Pi.single j 1) *
            (![x0 i, x1 i, x2 i, x3 i] : Fin 4 → ℝ) j) *
          (∑ k, deltaLin sys L Hunit Blow Cs Bker (Pi.single k 1) *
            (![x0 i, x1 i, x2 i, x3 i] : Fin 4 → ℝ) k) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [obsTailConst_eq, deltaLin_eq sys L Hunit Blow Cs Bker, sq]
    _ ≤ _ := key
    _ = _ := by
        rw [obsTailConst_eq, deltaLin_eq sys L Hunit Blow Cs Bker, sq]
        simp only [hX]

/-- `initial_tail_le` in position space: `‖(1 - P) ψ₀‖ ≤ δ₁ K^{-5/2}` for `ψ₀ ∈ D(H²)`. -/
theorem initial_tail_phys (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (n : ℕ)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁) :
    ‖(physMap eta).symm ψ₀ - molecularH2Truncate n ((physMap eta).symm ψ₀)‖ ≤
      obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖ *
        rho ^ 5 := by
  have hPeriodic := canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨H, hKernel, -⟩ := exists_coulombFourierH2Operator sys L
      molecularCanonicalUnitHardyConstant
    hL hPeriodic
  have hiff := hasCoulombHamiltonian_iff_phys sys L hL H hKernel
  obtain ⟨u₀, hu₀1, hu₀2⟩ := (hiff ψ₀ h₀).mp hψ₀
  obtain ⟨v₀, hv₀1, hv₀2⟩ := (hiff h₀ h₁).mp hh₀
  have huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀ :=
    (physMap eta).injective (hu₀2.trans hv₀1.symm)
  have htail := initial_tail_le sys L H hKernel molecularCanonicalUnitHardyConstant hL hPeriodic
    (finiteCoulombPhysicalMassConstant_nonneg _ _ _) n rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs
    hBker h2gK hAmplitude hBkerScale hCsScale u₀ v₀ huv
  have hx₀u : (physMap eta).symm ψ₀ = molecularH2StateMap eta (2 * Real.pi / L) u₀ := by
    rw [← hu₀1, LinearIsometryEquiv.symm_apply_apply]
  have e1 : ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ = ‖ψ₀‖ := by
    rw [← hu₀1, LinearIsometryEquiv.norm_map]
  have e2 : ‖H u₀‖ = ‖h₀‖ := by rw [← hu₀2, LinearIsometryEquiv.norm_map]
  have e3 : ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ = ‖h₀‖ := by
    rw [← hv₀1, LinearIsometryEquiv.norm_map]
  have e4 : ‖H v₀‖ = ‖h₁‖ := by rw [← hv₀2, LinearIsometryEquiv.norm_map]
  rw [e1, e2, e3, e4, ← hx₀u] at htail
  exact htail

/-- **The projection defect with spin.** For `Ψ₀ ∈ D(H²)` on the spin-inclusive space and the
Galerkin projection `P Ψ₀` (`P ⊗ 1`): `‖P Ψ₀‖ ≤ ‖Ψ₀‖` and `‖Ψ₀‖² - ‖P Ψ₀‖² ≤ (δ₁ K^{-5/2})²` with
`δ₁` at the spin-inclusive norms (Pythagoras on each component, `initial_tail_phys`, and
Minkowski's inequality). -/
theorem spin_proj_defect {D : ℕ} (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (n : ℕ)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁) :
    let ΨP : CoulombSpinL2 eta D := WithLp.toLp 2 fun σ =>
      physMap eta (molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ)))
    ‖ΨP‖ ^ 2 ≤ ‖Ψ₀‖ ^ 2 ∧
      ‖Ψ₀‖ ^ 2 - ‖ΨP‖ ^ 2 ≤
        (obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ *
          rho ^ 5) ^ 2 := by
  intro ΨP
  have hPσ : ∀ σ, ‖ΨP σ‖ = ‖molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ))‖ := fun σ =>
    LinearIsometryEquiv.norm_map (physMap eta) (molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ)))
  have hpyth : ∀ σ, ‖Ψ₀ σ‖ ^ 2 = ‖ΨP σ‖ ^ 2 +
      ‖(physMap eta).symm (Ψ₀ σ) - molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ))‖ ^ 2 := by
    intro σ
    have h := norm_sq_truncate_add n ((physMap eta).symm (Ψ₀ σ))
    rw [LinearIsometryEquiv.norm_map] at h
    rw [h, hPσ σ]
  have hsum : ‖Ψ₀‖ ^ 2 = ‖ΨP‖ ^ 2 + ∑ σ, ‖(physMap eta).symm (Ψ₀ σ) -
      molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ))‖ ^ 2 := by
    rw [PiLp.norm_sq_eq_of_L2 _ Ψ₀, PiLp.norm_sq_eq_of_L2 _ ΨP, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun σ _ => hpyth σ
  have hT : ∑ σ, obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀ σ‖
      ‖H₀ σ‖ ‖H₀ σ‖ ‖H₁ σ‖ ^ 2 ≤
      obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀‖ ‖H₀‖
          ‖H₀‖ ‖H₁‖ ^ 2 := by
    rw [PiLp.norm_eq_of_L2 Ψ₀, PiLp.norm_eq_of_L2 H₀, PiLp.norm_eq_of_L2 H₁]
    exact obsTailConst_sum_sq_le sys L _ Blow Cs Bker
      (finiteCoulombPhysicalMassConstant_nonneg _ _ _) hBlow hCs hBker Finset.univ
      (fun σ => ‖Ψ₀ σ‖) (fun σ => ‖H₀ σ‖) (fun σ => ‖H₀ σ‖) (fun σ => ‖H₁ σ‖)
  have htail2 : ∑ σ, ‖(physMap eta).symm (Ψ₀ σ) -
      molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ))‖ ^ 2 ≤
      (obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ *
        rho ^ 5) ^ 2 := by
    calc ∑ σ, ‖(physMap eta).symm (Ψ₀ σ) - molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ))‖ ^ 2
        ≤ ∑ σ, (obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀ σ‖
            ‖H₀ σ‖ ‖H₀ σ‖ ‖H₁ σ‖ * rho ^ 5) ^ 2 :=
          Finset.sum_le_sum fun σ _ => pow_le_pow_left₀ (norm_nonneg _)
            (initial_tail_phys sys L hL n rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h2gK
              hAmplitude hBkerScale hCsScale (Ψ₀ σ) (H₀ σ) (H₁ σ) (hΨ₀ σ) (hH₀ σ)) 2
      _ = (∑ σ, obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀ σ‖
            ‖H₀ σ‖ ‖H₀ σ‖ ‖H₁ σ‖ ^ 2) * (rho ^ 5) ^ 2 := by
          rw [Finset.sum_mul]
          exact Finset.sum_congr rfl fun σ _ => by ring
      _ ≤ obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker ‖Ψ₀‖ ‖H₀‖ ‖H₀‖
            ‖H₁‖ ^ 2 * (rho ^ 5) ^ 2 := mul_le_mul_of_nonneg_right hT (by positivity)
      _ = _ := by ring
  have hnn : 0 ≤ ∑ σ, ‖(physMap eta).symm (Ψ₀ σ) -
      molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ))‖ ^ 2 :=
    Finset.sum_nonneg fun σ _ => sq_nonneg _
  exact ⟨by linarith only [hsum, hnn], by linarith only [hsum, htail2]⟩

/-- **`cor:norm` with spin.** Under the hypotheses of `coulomb_observable_position`, on the
spin-inclusive space with `Ψ(t) = (U(t) ⊗ 1) Ψ₀` (`spinProp U t Ψ₀`), `‖Ψ₀‖ = 1`, `|χ| ≤ 1` and
`P Ψ₀ ≠ 0`, the normalised Galerkin state `Ψ̃_N(t) = Ψ_N(t)/‖P Ψ₀‖` satisfies the bound of
`thm:dyn` up to `‖(1 - P) Ψ₀‖² ≤ δ₁² K^{-5}`, all at the spin-inclusive norms. -/
theorem coulomb_observable_normalised_spin {D : ℕ} (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h4g : 4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (Ψ₀ H₀ H₁ : CoulombSpinL2 eta D) (hΨ₀ : HasCoulombSpinHamiltonian sys L Ψ₀ H₀)
    (hH₀ : HasCoulombSpinHamiltonian sys L H₀ H₁) (hnorm : ‖Ψ₀‖ = 1)
    (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ))
    (hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖)
    (hreal : ∀ y, conj (χ y) = χ y) (hχ1 : ∀ y, ‖χ y‖ ≤ 1) {t : ℝ} (ht : 0 ≤ t) :
    let ΨP : CoulombSpinL2 eta D := WithLp.toLp 2 fun σ =>
      physMap eta (molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ)))
    let c : ℝ := ‖ΨP‖
    let ΨN : CoulombSpinL2 eta D := WithLp.toLp 2 fun σ => physMap eta
      (finiteFourierLpIsometry eta n (UN t (extractCLM n ((physMap eta).symm (Ψ₀ σ)))))
    let ΨNt := ((c : ℂ)⁻¹) • ΨN
    let δ₁ := obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker
        ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖
    ΨP ≠ 0 →
    ‖⟪spinProp U t Ψ₀, spinLift (mulCLM (regFun a χ)) (spinProp U t Ψ₀)⟫_ℂ -
        ⟪ΨNt, spinLift (mulCLM (regFun a χ)) ΨNt⟫_ℂ‖ ≤
      obsRateBound sys L molecularCanonicalUnitHardyConstant Blow Cs Bker rho n a
        (UnitAddTorus.mFourierCoeff χ) ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ t + (δ₁ * rho ^ 5) ^ 2 := by
  intro ΨP c ΨN ΨNt δ₁ hP
  have hg : 0 < 2 * Real.pi / L := by positivity
  have h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n := by linarith only [h4g, hg]
  have hmain : ‖⟪spinProp U t Ψ₀, spinLift (mulCLM (regFun a χ)) (spinProp U t Ψ₀)⟫_ℂ -
      ⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ‖ ≤
      obsRateBound sys L molecularCanonicalUnitHardyConstant Blow Cs Bker rho n a
        (UnitAddTorus.mFourierCoeff χ) ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ t :=
    spin_obs_le sys L molecularCanonicalUnitHardyConstant Blow Cs Bker rho n a _ t
      (finiteCoulombPhysicalMassConstant_nonneg _ _ _) hBlow hCs hBker hRho ht
      (mulCLM (regFun a χ)) (spinProp U t Ψ₀) ΨN Ψ₀ H₀ H₁ fun σ =>
        coulomb_observable_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm hNderiv
          rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h4g hAmplitude hBkerScale hCsScale
          (Ψ₀ σ) (H₀ σ) (H₁ σ) (hΨ₀ σ) (hH₀ σ) a χ hχ2 hreal ht
  have hNσ : ∀ σ, ‖ΨN σ‖ = ‖ΨP σ‖ := fun σ => by
    show ‖physMap eta (finiteFourierLpIsometry eta n
        (UN t (extractCLM n ((physMap eta).symm (Ψ₀ σ)))))‖ =
      ‖physMap eta (molecularH2Truncate n ((physMap eta).symm (Ψ₀ σ)))‖
    rw [LinearIsometryEquiv.norm_map, LinearIsometry.norm_map, LinearIsometryEquiv.norm_map,
      norm_extract_eq, LinearIsometryEquiv.norm_map]
  have hc : ‖ΨN‖ = c := by
    show ‖ΨN‖ = ‖ΨP‖
    rw [PiLp.norm_eq_of_L2 ΨN, PiLp.norm_eq_of_L2 ΨP]
    simp only [hNσ]
  have hc0 : 0 < c := norm_pos_iff.mpr hP
  obtain ⟨hle, hdef⟩ := spin_proj_defect sys L hL n rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs
    hBker h2gK hAmplitude hBkerScale hCsScale Ψ₀ H₀ H₁ hΨ₀ hH₀
  have h1 : ‖Ψ₀‖ ^ 2 = 1 := by rw [hnorm]; norm_num
  have hle' : c ^ 2 ≤ ‖Ψ₀‖ ^ 2 := hle
  have hdef' : ‖Ψ₀‖ ^ 2 - c ^ 2 ≤ (δ₁ * rho ^ 5) ^ 2 := hdef
  have hc1 : c ≤ 1 := by
    have hc2 : c ^ 2 ≤ 1 := by linarith only [hle', h1]
    exact (pow_le_one_iff_of_nonneg hc0.le (by norm_num : (2 : ℕ) ≠ 0)).mp hc2
  have hM1 : ‖(spinLift (mulCLM (regFun a χ)) : CoulombSpinL2 eta D →L[ℂ] CoulombSpinL2 eta D)‖ ≤
      1 :=
    (norm_spinLift_le _).trans ((norm_mulCLM_le _).trans ((norm_regFun_le a χ).trans
      ((ContinuousMap.norm_le _ zero_le_one).mpr hχ1)))
  have hnormal := norm_inner_normalize_sub_le (E := CoulombSpinL2 eta D)
    (spinLift (mulCLM (regFun a χ))) hM1 ΨN hc hc0 hc1
  have hnormal' : ‖⟪ΨNt, spinLift (mulCLM (regFun a χ)) ΨNt⟫_ℂ -
      ⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ‖ ≤ 1 - c ^ 2 := hnormal
  have htri := norm_sub_le_norm_sub_add_norm_sub
    ⟪spinProp U t Ψ₀, spinLift (mulCLM (regFun a χ)) (spinProp U t Ψ₀)⟫_ℂ
    ⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ ⟪ΨNt, spinLift (mulCLM (regFun a χ)) ΨNt⟫_ℂ
  have hswap : ‖⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ -
      ⟪ΨNt, spinLift (mulCLM (regFun a χ)) ΨNt⟫_ℂ‖ =
