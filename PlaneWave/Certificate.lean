/-- Multiplying any square-integrable torus function by a Fourier character
preserves square integrability. -/
theorem torus_memLp_mul_mFourier {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume) (n : d → ℤ) :
    MemLp (fun x => V x * UnitAddTorus.mFourier n x) 2 volume := by
  have hMeas : AEStronglyMeasurable
      (fun x => V x * UnitAddTorus.mFourier n x) volume :=
    hV.aestronglyMeasurable.fun_mul
      (UnitAddTorus.mFourier n).continuous.aestronglyMeasurable
  refine hV.of_le hMeas ?_
  filter_upwards [] with x
  rw [norm_mul]
  calc
    ‖V x‖ * ‖UnitAddTorus.mFourier n x‖ ≤
        ‖V x‖ * ‖UnitAddTorus.mFourier n‖ :=
      mul_le_mul_of_nonneg_left
        (ContinuousMap.norm_coe_le_norm (UnitAddTorus.mFourier n) x) (norm_nonneg _)
    _ = ‖V x‖ := by rw [UnitAddTorus.mFourier_norm, mul_one]

/-- The Fourier shift identity is a pointwise character calculation and
requires no assumed Fourier formula for the potential. -/
theorem torus_mFourierCoeff_mul_mFourier {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (n q : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => V x * UnitAddTorus.mFourier n x) q =
      UnitAddTorus.mFourierCoeff V (q - n) := by
  have hfreq : -(q - n) = n + (-q) := by
    ext a
    simp only [Pi.neg_apply, Pi.sub_apply, Pi.add_apply]
    ring
  unfold UnitAddTorus.mFourierCoeff
  apply integral_congr_ae
  filter_upwards [] with x
  simp only [smul_eq_mul]
  rw [hfreq, UnitAddTorus.mFourier_add]
  ring

/-- Actual L2 multiplication of a potential by one Fourier character. -/
def torusPotentialBasisProduct {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume) (n : d → ℤ) :
    Lp ℂ 2 (volume : Measure (UnitAddTorus d)) :=
  (torus_memLp_mul_mFourier V hV n).toLp
    (fun x => V x * UnitAddTorus.mFourier n x)

theorem torusPotentialBasisProduct_coeFn {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume) (n : d → ℤ) :
    (torusPotentialBasisProduct V hV n : UnitAddTorus d → ℂ) =ᵐ[volume]
      (fun x => V x * UnitAddTorus.mFourier n x) := by
  unfold torusPotentialBasisProduct
  exact MemLp.coeFn_toLp (torus_memLp_mul_mFourier V hV n)

/-- Relating the ordinary Fourier integral to the L2 Fourier basis. -/
theorem torus_mFourier_inner_eq_coeff {d : Type*} [Fintype d]
    (f : Lp ℂ 2 (volume : Measure (UnitAddTorus d))) (q : d → ℤ) :
    inner ℂ (UnitAddTorus.mFourierLp 2 q) f = UnitAddTorus.mFourierCoeff f q := by
  have h := UnitAddTorus.mFourierBasis_repr f q
  rw [HilbertBasis.repr_apply_apply] at h
  simpa only [UnitAddTorus.coe_mFourierBasis] using h

theorem torusPotentialBasisProduct_fourier {d : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume) (n q : d → ℤ) :
    inner ℂ (UnitAddTorus.mFourierLp 2 q) (torusPotentialBasisProduct V hV n) =
      UnitAddTorus.mFourierCoeff V (q - n) := by
  rw [torus_mFourier_inner_eq_coeff]
  calc
    UnitAddTorus.mFourierCoeff (torusPotentialBasisProduct V hV n) q =
        UnitAddTorus.mFourierCoeff (fun x => V x * UnitAddTorus.mFourier n x) q := by
      unfold UnitAddTorus.mFourierCoeff
      apply integral_congr_ae
      filter_upwards [torusPotentialBasisProduct_coeFn V hV n] with x hx
      rw [hx]
    _ = _ := torus_mFourierCoeff_mul_mFourier V n q

/-- Multiplication of a finite Fourier polynomial by an L2 potential, as an
actual L2 class. No coefficient specification is included in the definition. -/
def torusPotentialFourierProduct {d α : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume)
    (s : Finset α) (index : α → d → ℤ) (c : α → ℂ) :
    Lp ℂ 2 (volume : Measure (UnitAddTorus d)) :=
  ∑ p ∈ s, c p • torusPotentialBasisProduct V hV (index p)

/-- The finite sum construction is literal multiplication almost everywhere. -/
theorem torusPotentialFourierProduct_coeFn {d α : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume)
    (s : Finset α) (index : α → d → ℤ) (c : α → ℂ) :
    (torusPotentialFourierProduct V hV s index c : UnitAddTorus d → ℂ) =ᵐ[volume]
      (fun x => V x * ∑ p ∈ s, c p * UnitAddTorus.mFourier (index p) x) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp only [torusPotentialFourierProduct, Finset.sum_empty, mul_zero]
      exact Lp.coeFn_zero _ _ _
  | @insert p s hp ih =>
      have hInsert : torusPotentialFourierProduct V hV (insert p s) index c =
          c p • torusPotentialBasisProduct V hV (index p) +
            torusPotentialFourierProduct V hV s index c := by
        simp only [torusPotentialFourierProduct, Finset.sum_insert hp]
      rw [hInsert]
      filter_upwards [Lp.coeFn_add
          (c p • torusPotentialBasisProduct V hV (index p))
          (torusPotentialFourierProduct V hV s index c),
        Lp.coeFn_smul (c p) (torusPotentialBasisProduct V hV (index p)),
        torusPotentialBasisProduct_coeFn V hV (index p), ih] with x hAdd hSmul hBasis hTail
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at hAdd hSmul
      rw [hAdd, hSmul, hBasis, hTail, Finset.sum_insert hp]
      ring

/-- The finite-core convolution formula is derived from actual multiplication. -/
theorem torusPotentialFourierProduct_fourier {d α : Type*} [Fintype d]
    (V : UnitAddTorus d → ℂ) (hV : MemLp V 2 volume)
    (s : Finset α) (index : α → d → ℤ) (c : α → ℂ) (q : d → ℤ) :
    UnitAddTorus.mFourierCoeff (torusPotentialFourierProduct V hV s index c) q =
      ∑ p ∈ s, c p * UnitAddTorus.mFourierCoeff V (q - index p) := by
  rw [← torus_mFourier_inner_eq_coeff, torusPotentialFourierProduct, inner_sum]
  apply Finset.sum_congr rfl
  intro p _hp
  rw [inner_smul_right, torusPotentialBasisProduct_fourier]

/-- The product construction on the actual molecular configuration torus. -/
def molecularPositionPotentialFourierProduct (eta : ℕ)
    (V : MolecularPositionTorus eta → ℂ) (hV : MemLp V 2 volume)
    (s : Finset (FourierConfig eta Lattice3))
    (c : FourierConfig eta Lattice3 → ℂ) : MolecularPositionL2 eta :=
  torusPotentialFourierProduct V hV s (molecularFourierIndexEquiv eta) c

theorem molecularPositionPotentialFourierProduct_coeFn (eta : ℕ)
    (V : MolecularPositionTorus eta → ℂ) (hV : MemLp V 2 volume)
    (s : Finset (FourierConfig eta Lattice3))
    (c : FourierConfig eta Lattice3 → ℂ) :
    (molecularPositionPotentialFourierProduct eta V hV s c : MolecularPositionTorus eta → ℂ)
      =ᵐ[volume] (fun x => V x * molecularPositionFourierTest eta s c x) := by
  simpa only [molecularPositionPotentialFourierProduct, molecularPositionFourierTest_apply] using
    torusPotentialFourierProduct_coeFn V hV s (molecularFourierIndexEquiv eta) c

/-- Exact coefficients of multiplication on every molecular Fourier test. -/
theorem molecularPositionPotentialFourierProduct_fourier (eta : ℕ)
    (V : MolecularPositionTorus eta → ℂ) (hV : MemLp V 2 volume)
    (s : Finset (FourierConfig eta Lattice3))
    (c : FourierConfig eta Lattice3 → ℂ) (q : FourierConfig eta Lattice3) :
    (molecularPositionSynthesis eta).symm
        (molecularPositionPotentialFourierProduct eta V hV s c) q =
      ∑ p ∈ s, c p * UnitAddTorus.mFourierCoeff V
        (molecularFourierIndexEquiv eta q - molecularFourierIndexEquiv eta p) := by
  rw [molecularPositionSynthesis_symm_apply]
  exact torusPotentialFourierProduct_fourier V hV s (molecularFourierIndexEquiv eta) c _

