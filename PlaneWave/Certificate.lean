/-! ## Ninety-second milestone: ambient zero extension and the regularized Hardy field -/

/-- Squared Euclidean radius on the ambient copy of `ℝ³`. -/
noncomputable def centeredCube3AmbientRadiusSq
    (x : CenteredCube3Ambient) : ℝ :=
  ∑ i : Fin 3, (x i) ^ 2

lemma centeredCube3AmbientRadiusSq_nonneg
    (x : CenteredCube3Ambient) :
    0 ≤ centeredCube3AmbientRadiusSq x := by
  unfold centeredCube3AmbientRadiusSq
  exact Finset.sum_nonneg (fun i hi => sq_nonneg (x i))

/-- Euclidean radius on the ambient copy of `ℝ³`. -/
noncomputable def centeredCube3AmbientRadius
    (x : CenteredCube3Ambient) : ℝ :=
  Real.sqrt (centeredCube3AmbientRadiusSq x)

lemma centeredCube3AmbientRadius_nonneg
    (x : CenteredCube3Ambient) :
    0 ≤ centeredCube3AmbientRadius x := by
  unfold centeredCube3AmbientRadius
  exact Real.sqrt_nonneg _

@[simp] lemma centeredCube3AmbientRadius_subtype
    (y : CenteredCube3) :
    centeredCube3AmbientRadius (y.1 : CenteredCube3Ambient) =
      centeredCube3Radius y := by
  unfold centeredCube3AmbientRadius centeredCube3AmbientRadiusSq
  unfold centeredCube3Radius centeredCube3RadiusSq
  rfl

/-- Every ambient coordinate is bounded by the Euclidean radius. -/
lemma centeredCube3Ambient_abs_coord_le_radius
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    |x j| ≤ centeredCube3AmbientRadius x := by
  have hsq :
      (x j) ^ 2 ≤ centeredCube3AmbientRadiusSq x := by
    unfold centeredCube3AmbientRadiusSq
    exact
      Finset.single_le_sum
        (fun i hi => sq_nonneg (x i))
        (Finset.mem_univ j)
  have hrSq :
      centeredCube3AmbientRadius x ^ 2 =
        centeredCube3AmbientRadiusSq x := by
    unfold centeredCube3AmbientRadius
    exact Real.sq_sqrt (centeredCube3AmbientRadiusSq_nonneg x)
  have habsSq : |x j| ^ 2 = (x j) ^ 2 := sq_abs (x j)
  have habs0 : 0 ≤ |x j| := abs_nonneg _
  have hr0 : 0 ≤ centeredCube3AmbientRadius x :=
    centeredCube3AmbientRadius_nonneg x
  rw [← hrSq] at hsq
  rw [← habsSq] at hsq
  nlinarith

/-- The compactly supported wavefunction `χ ψ`, before multiplication by `1/r`. -/
noncomputable def centeredCube3RadialCutoffWaveFunction
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (y : CenteredCube3) : ℂ :=
  (centeredCube3RadialCutoff rho R y : ℂ) *
    torus3FourierContinuousPolynomial index f
      (unitTorus3CenteredEquiv.symm y)

/-- Zero extension of `χ ψ` from the centered fundamental cube to ambient `ℝ³`. -/
noncomputable def centeredCube3RadialCutoffWaveZeroExtension
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ) :
    CenteredCube3Ambient → ℂ :=
  Function.extend
    (Subtype.val : CenteredCube3 → CenteredCube3Ambient)
    (centeredCube3RadialCutoffWaveFunction rho R index f)
    0

@[simp] lemma centeredCube3RadialCutoffWaveZeroExtension_subtype
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (y : CenteredCube3) :
    centeredCube3RadialCutoffWaveZeroExtension rho R index f y.1 =
      centeredCube3RadialCutoffWaveFunction rho R index f y := by
  unfold centeredCube3RadialCutoffWaveZeroExtension
  exact Function.extend_val_apply y.2

/-- Zero extension of the explicit `j`-th product-rule gradient. -/
noncomputable def centeredCube3RadialCutoffRawGradientZeroExtension
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3) :
    CenteredCube3Ambient → ℂ :=
  Function.extend
    (Subtype.val : CenteredCube3 → CenteredCube3Ambient)
    (centeredCube3RadialCutoffRawGradientFunction rho R index f j)
    0

@[simp] lemma centeredCube3RadialCutoffRawGradientZeroExtension_subtype
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (y : CenteredCube3) :
    centeredCube3RadialCutoffRawGradientZeroExtension
        rho R index f j y.1 =
      centeredCube3RadialCutoffRawGradientFunction
        rho R index f j y := by
  unfold centeredCube3RadialCutoffRawGradientZeroExtension
  exact Function.extend_val_apply y.2

lemma centeredCube3RadialCutoffWaveZeroExtension_eq_zero_of_outer_le
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (x : CenteredCube3Ambient)
    (hOuter : R ≤ centeredCube3AmbientRadius x) :
    centeredCube3RadialCutoffWaveZeroExtension rho R index f x = 0 := by
  classical
  unfold centeredCube3RadialCutoffWaveZeroExtension
  by_cases hx :
      ∀ i : Fin 3,
        x i ∈ Set.Ioc
          (centeredCube3Base i)
          (centeredCube3Base i + 1)
  · rw [Function.extend_val_apply hx]
    let y : CenteredCube3 := ⟨x, hx⟩
    have hOuter' : R ≤ centeredCube3Radius y := by
      change R ≤ centeredCube3AmbientRadius y.1 at hOuter
      simpa using hOuter
    unfold centeredCube3RadialCutoffWaveFunction
    rw [centeredCube3RadialCutoff_eq_zero_of_outer_le hRhoR y hOuter']
    simp
  · rw [Function.extend_val_apply' hx]
    simp

lemma centeredCube3RadialCutoffRawGradientZeroExtension_eq_zero_of_outer_le
    {α : Type}
    [Fintype α]
    {rho R : ℝ}
    (hRhoR : rho < R)
    (index : α → Lattice3)
    (f : α → ℂ)
    (j : Fin 3)
    (x : CenteredCube3Ambient)
    (hOuter : R ≤ centeredCube3AmbientRadius x) :
    centeredCube3RadialCutoffRawGradientZeroExtension
        rho R index f j x = 0 := by
  classical
  unfold centeredCube3RadialCutoffRawGradientZeroExtension
  by_cases hx :
      ∀ i : Fin 3,
        x i ∈ Set.Ioc
          (centeredCube3Base i)
          (centeredCube3Base i + 1)
  · rw [Function.extend_val_apply hx]
    let y : CenteredCube3 := ⟨x, hx⟩
    have hOuter' : R ≤ centeredCube3Radius y := by
      change R ≤ centeredCube3AmbientRadius y.1 at hOuter
      simpa using hOuter
    have hNotInner : ¬ centeredCube3Radius y ≤ rho := by
      exact not_le.mpr (lt_of_lt_of_le hRhoR hOuter')
    have hCutoff : centeredCube3RadialCutoff rho R y = 0 :=
      centeredCube3RadialCutoff_eq_zero_of_outer_le hRhoR y hOuter'
    have hPartial : centeredCube3RadialCutoffPartial rho R j y = 0 := by
      unfold centeredCube3RadialCutoffPartial
      simp [hNotInner, hOuter']
    unfold centeredCube3RadialCutoffRawGradientFunction
    unfold centeredCube3RadialCutoffMainGradientFunction
    unfold centeredCube3RadialCutoffCutoffGradientFunction
    rw [hCutoff, hPartial]
    simp
  · rw [Function.extend_val_apply' hx]
    simp

/-! ### The regularized Hardy vector field -/

/-- Positive denominator `|x|² + ε²` used to regularize `x / |x|²`. -/
noncomputable def hardyRegularizedDenominator
    (eps : ℝ)
    (x : CenteredCube3Ambient) : ℝ :=
  centeredCube3AmbientRadiusSq x + eps ^ 2

lemma hardyRegularizedDenominator_pos
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    0 < hardyRegularizedDenominator eps x := by
  unfold hardyRegularizedDenominator
  have hepsSq : 0 < eps ^ 2 := by positivity
  nlinarith [centeredCube3AmbientRadiusSq_nonneg x]

/-- The regularized Hardy weight `1 / (|x|² + ε²)`. -/
noncomputable def hardyRegularizedWeight
    (eps : ℝ)
    (x : CenteredCube3Ambient) : ℝ :=
  1 / hardyRegularizedDenominator eps x

/-- Squared Euclidean norm of the regularized vector field
`x / (|x|² + ε²)`. -/
noncomputable def hardyRegularizedFieldNormSq
    (eps : ℝ)
    (x : CenteredCube3Ambient) : ℝ :=
  centeredCube3AmbientRadiusSq x /
    (hardyRegularizedDenominator eps x) ^ 2

/-- Divergence of the regularized vector field in dimension three:
`(|x|² + 3 ε²) / (|x|² + ε²)²`.  The derivative identity itself will be
proved when applying Mathlib's integration-by-parts theorem; this definition
isolates the scalar expression needed for the estimates. -/
noncomputable def hardyRegularizedDivergence
    (eps : ℝ)
    (x : CenteredCube3Ambient) : ℝ :=
  (centeredCube3AmbientRadiusSq x + 3 * eps ^ 2) /
    (hardyRegularizedDenominator eps x) ^ 2

/-- The regularized field has squared norm at most its Hardy weight. -/
lemma hardyRegularizedFieldNormSq_le_weight
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    hardyRegularizedFieldNormSq eps x ≤
      hardyRegularizedWeight eps x := by
  let d : ℝ := hardyRegularizedDenominator eps x
  have hd : 0 < d := by
    dsimp [d]
    exact hardyRegularizedDenominator_pos heps x
  have hd2 : 0 < d ^ 2 := by positivity
  have hsle : centeredCube3AmbientRadiusSq x ≤ d := by
    dsimp [d, hardyRegularizedDenominator]
    nlinarith [sq_nonneg eps]
  have hWeight : hardyRegularizedWeight eps x = d / d ^ 2 := by
    unfold hardyRegularizedWeight
    dsimp [d]
    field_simp [ne_of_gt hd]
  rw [hWeight]
  unfold hardyRegularizedFieldNormSq
  change centeredCube3AmbientRadiusSq x / d ^ 2 ≤ d / d ^ 2
  exact (div_le_div_iff_of_pos_right hd2).2 hsle

/-- In dimension three the divergence of the regularized field dominates the
regularized Hardy weight. -/
lemma hardyRegularizedWeight_le_divergence
    {eps : ℝ}
    (heps : 0 < eps)
    (x : CenteredCube3Ambient) :
    hardyRegularizedWeight eps x ≤
      hardyRegularizedDivergence eps x := by
  let d : ℝ := hardyRegularizedDenominator eps x
  have hd : 0 < d := by
    dsimp [d]
    exact hardyRegularizedDenominator_pos heps x
  have hd2 : 0 < d ^ 2 := by positivity
  have hNum :
      d ≤ centeredCube3AmbientRadiusSq x + 3 * eps ^ 2 := by
    dsimp [d, hardyRegularizedDenominator]
    nlinarith [sq_nonneg eps]
  have hWeight : hardyRegularizedWeight eps x = d / d ^ 2 := by
    unfold hardyRegularizedWeight
    dsimp [d]
    field_simp [ne_of_gt hd]
  rw [hWeight]
  unfold hardyRegularizedDivergence
  change
    d / d ^ 2 ≤
      (centeredCube3AmbientRadiusSq x + 3 * eps ^ 2) / d ^ 2
  exact (div_le_div_iff_of_pos_right hd2).2 hNum

/-!
## Ninety-second milestone

The cutoff Fourier function and each explicit product-rule gradient component now
have canonical zero extensions to ambient `ℝ³`, and Lean proves that these zero
extensions are compactly supported in the closed ball of radius `R`.

The regularized Hardy field has also been reduced to two pointwise scalar facts:

* `|x/(|x|²+ε²)|² ≤ 1/(|x|²+ε²)`;
* `1/(|x|²+ε²) ≤ div(x/(|x|²+ε²))` in dimension three.

Thus the next analytic step is precisely to combine Mathlib's multidimensional
integration-by-parts theorem with these compact-support and pointwise estimates.
-/

end

end PlaneWaveCertificate

