noncomputable section

/-- A pointwise contractive complex multiplier on square-summable sequences. -/
def lp2DiagonalLinearMap {ι : Type*} (a : ι → ℂ)
    (ha : ∀ i, ‖a i‖ ≤ 1) :
    lp (fun _ : ι => ℂ) 2 →ₗ[ℂ] lp (fun _ : ι => ℂ) 2 where
  toFun u := ⟨fun i => a i * u i, (lp.memℓp u).mono' (by
    intro i
    calc
      ‖a i * u i‖ = ‖a i‖ * ‖u i‖ := norm_mul _ _
      _ ≤ 1 * ‖u i‖ := mul_le_mul_of_nonneg_right (ha i) (norm_nonneg _)
      _ = ‖u i‖ := one_mul _)⟩
  map_add' u v := by
    apply lp.ext
    funext i
    change a i * (u i + v i) = a i * u i + a i * v i
    exact mul_add _ _ _
  map_smul' c u := by
    apply lp.ext
    funext i
    change a i * (c * u i) = c * (a i * u i)
    ring

theorem lp2DiagonalLinearMap_norm_le {ι : Type*} (a : ι → ℂ)
    (ha : ∀ i, ‖a i‖ ≤ 1) (u : lp (fun _ : ι => ℂ) 2) :
    ‖lp2DiagonalLinearMap a ha u‖ ≤ ‖u‖ := by
  apply lp.norm_mono (by norm_num : (2 : ENNReal) ≠ 0)
  intro i
  change ‖a i * u i‖ ≤ ‖u i‖
  calc
    ‖a i * u i‖ = ‖a i‖ * ‖u i‖ := norm_mul _ _
    _ ≤ 1 * ‖u i‖ := mul_le_mul_of_nonneg_right (ha i) (norm_nonneg _)
    _ = ‖u i‖ := one_mul _

def lp2DiagonalCLM {ι : Type*} (a : ι → ℂ) (ha : ∀ i, ‖a i‖ ≤ 1) :
    lp (fun _ : ι => ℂ) 2 →L[ℂ] lp (fun _ : ι => ℂ) 2 :=
  (lp2DiagonalLinearMap a ha).mkContinuous 1 (by
    intro u
    simpa only [one_mul] using lp2DiagonalLinearMap_norm_le a ha u)

@[simp] theorem lp2DiagonalCLM_apply {ι : Type*} (a : ι → ℂ)
    (ha : ∀ i, ‖a i‖ ≤ 1) (u : lp (fun _ : ι => ℂ) 2) (i : ι) :
    lp2DiagonalCLM a ha u i = a i * u i := rfl

end
end PlaneWaveCertificate

