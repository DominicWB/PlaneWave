/-! ## Observables summed over registers -/

/-- The observable error of `Σ_{a∈S} O_a` is at most the sum of the errors of the `O_a`. -/
lemma obs_sum_le {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {ι : Type*}
    (S : Finset ι) (O : ι → E →L[ℂ] E) (x y : E) (B : ι → ℝ)
    (h : ∀ a ∈ S, ‖⟪x, O a x⟫_ℂ - ⟪y, O a y⟫_ℂ‖ ≤ B a) :
    ‖⟪x, (∑ a ∈ S, O a) x⟫_ℂ - ⟪y, (∑ a ∈ S, O a) y⟫_ℂ‖ ≤ ∑ a ∈ S, B a := by
  rw [sum_apply, sum_apply, inner_sum, inner_sum,
    ← Finset.sum_sub_distrib]
  exact (norm_sum_le _ _).trans (Finset.sum_le_sum h)

/-- **Species-summed observables** (the remark before `thm:dyn`). With the propagators of
`thm_dyn_spin`, under its hypotheses (`n ≥ 4`, `K = 2πn/L ≥ 2`, `Ψ₀ ∈ D(H²)`, real continuous `χ`
with `Σ_ν (1 + g²|ν|²) |χ̂(ν)| < ∞`, `t ≥ 0`): for a set `S` of registers (e.g. the particles of
one species) and the observable `Σ_{a∈S} χ(x_a) ⊗ 1`, the observable error is at most `Σ_{a∈S}`
of the bound of `thm_dyn_spin` for register `a`. -/
theorem thm_dyn_spin_species (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) (D : ℕ) :
    ∃ U : ℝ → CoulombSpinL2 eta D ≃ₗᵢ[ℂ] CoulombSpinL2 eta D,
      (∀ Ψ, U 0 Ψ = Ψ) ∧
      (∀ s t Ψ, U (s + t) Ψ = U s (U t Ψ)) ∧
      (∀ Ψ, Continuous fun t => U t Ψ) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasCoulombSpinHamiltonian sys L (U t Ψ) (U t Φ)) ∧
      (∀ t Ψ Φ, HasCoulombSpinHamiltonian sys L Ψ Φ →
        HasDerivAt (fun s => U s Ψ) (-(Complex.I • U t Φ)) t) ∧
      (∀ φ ζ : ℝ → CoulombSpinL2 eta D, (∀ t, HasCoulombSpinHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      (∀ t, ∃ V : MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
        ∀ Ψ σ, U t Ψ σ = V (Ψ σ)) ∧
      ∀ n : ℕ, ∃ UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ x, UN 0 x = x) ∧ (∀ s t x, UN (s + t) x = UN s (UN t x)) ∧
        (∀ t x, HasDerivAt (fun s => UN s x)
          (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t) ∧
        (4 ≤ n → 2 ≤ (2 * Real.pi / L) * n →
          ∀ Ψ₀ H₀ H₁ : CoulombSpinL2 eta D, HasCoulombSpinHamiltonian sys L Ψ₀ H₀ →
          HasCoulombSpinHamiltonian sys L H₀ H₁ →
          ∀ (S : Finset (Fin eta)) (χ : C(UnitAddTorus (Fin 3), ℂ)),
          Summable (fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
            ‖UnitAddTorus.mFourierCoeff χ ν‖) →
          (∀ y, conj (χ y) = χ y) → ∀ t : ℝ, 0 ≤ t →
          let ΨN : CoulombSpinL2 eta D := WithLp.toLp 2 fun σ => physMap eta
            (finiteFourierLpIsometry eta n (UN t (extractCLM n ((physMap eta).symm (Ψ₀ σ)))))
          let O : CoulombSpinL2 eta D →L[ℂ] CoulombSpinL2 eta D :=
            ∑ a ∈ S, spinLift (mulCLM (regFun a χ))
          ‖⟪U t Ψ₀, O (U t Ψ₀)⟫_ℂ - ⟪ΨN, O ΨN⟫_ℂ‖ ≤
            ∑ a ∈ S, obsRateBound sys L molecularCanonicalUnitHardyConstant
              (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
              (molecularCanonicalKernelConstant L) (Real.sqrt (1 / ((2 * Real.pi / L) * n))) n a
              (UnitAddTorus.mFourierCoeff χ) ‖Ψ₀‖ ‖H₀‖ ‖H₀‖ ‖H₁‖ t) := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hcompo, hrest⟩ := thm_dyn_spin sys L hL D
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hcompo, fun n => ?_⟩
  obtain ⟨UN, hN0, hNadd, hNderiv, hbound⟩ := hrest n
  refine ⟨UN, hN0, hNadd, hNderiv, ?_⟩
  intro hn hK2 Ψ₀ H₀ H₁ hΨ₀ hH₀ S χ hχ2 hreal t ht ΨN O
  exact obs_sum_le (E := CoulombSpinL2 eta D) S (fun a => spinLift (mulCLM (regFun a χ)))
    (U t Ψ₀) ΨN _ fun a _ => hbound hn hK2 Ψ₀ H₀ H₁ hΨ₀ hH₀ a χ hχ2 hreal t ht

/-- **Species-summed observables under `(Hχ)`.** With the propagators of `thm_dyn_spin` and the
