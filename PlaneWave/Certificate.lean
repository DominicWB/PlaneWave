/-- Background spectral identification of the continuum molecular operator.

`D` is its linear operator domain inside the continuum inner-product space `X`.
Every finite Fourier space is embedded isometrically into that domain.  The
quadratic form agrees exactly with the already constructed signed molecular
Hamiltonian, including the nuclear positions and charges.  `cubic_lift` is the
surjectivity of the full cube once the ambient horizon contains it.

No analytically quantitative operator estimate is a field of this structure.
-/
structure ContinuumMolecularGalerkinBridge
    {ν : Type*} [Fintype ν] (eta : ℕ) (lab : Fin eta → ℕ) (L : ℝ) (data : FiniteBONuclearData ν)
    (X : Type*) [NormedAddCommGroup X] [InnerProductSpace ℂ X]
    (D : Submodule ℂ X) where
  hamiltonian : D →ₗ[ℂ] X
  fermionic : X → Prop
  cubic : ℝ → X → Prop
  embed : (count : ℕ) →
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)) →ₗᵢ[ℂ] D
  form_eq : ∀ (count : ℕ) u,
    (inner ℂ ((embed count u : D) : X) (hamiltonian (embed count u))).re =
      (inner ℂ u (finiteMolecularBOHamiltonian eta L data count u)).re
  fermionic_iff : ∀ (count : ℕ) u,
    fermionic ((embed count u : D) : X) ↔ IsFermionicVector lab u
  cubic_iff : ∀ (K : ℝ) (count : ℕ) u,
    cubic K ((embed count u : D) : X) ↔
      IsCubicRetainedVector eta K (2 * Real.pi / L) count u
  cubic_lift : ∀ (K : ℝ) (count m : ℕ),
    K * L = 2 * Real.pi * (m : ℝ) → m ≤ count →
    ∀ u : D, fermionic (u : X) → cubic K (u : X) →
      ∃ v : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)),
        embed count v = u

/-- Convergence alone supplies the eventual absolute-energy bound needed for a
uniform finite H2 estimate.  Its margin is fixed independently of the cutoff. -/
lemma convergent_energy_eventually_abs_le
    (energy : ℕ → ℝ) (E : ℝ) (hEnergy : Tendsto energy atTop (𝓝 E)) :
    ∀ᶠ n in atTop, |energy n| ≤ |E| + 1 := by
  have h : ∀ᶠ n in atTop, |energy n| < |E| + 1 :=
    hEnergy.abs.eventually (gt_mem_nhds (by linarith : |E| < |E| + 1))
  exact h.mono (fun _ hn => hn.le)

/-- A uniform H2 constant deduced from the physical H1 estimate, using the
fixed eventual spectral budget |E|+1.  It is independent of K and all ambient
basis sizes. -/
noncomputable def continuumMolecularBOH2Constant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (E L Hunit : ℝ) : ℝ :=
  uniformBOEigenH2Constant (|E| + 1)
    (finiteMolecularCoulombPhysicalFormConstant eta data L Hunit)

/-- Explicit continuum cubic error constant.  H2 regularity of finite
approximants is a theorem, not an external assumption hidden in this constant. -/
noncomputable def continuumMolecularBOCubicConstant
    {ν : Type*} [Fintype ν] (eta : ℕ) (data : FiniteBONuclearData ν)
    (E L Hunit Blow Cs Bker : ℝ) : ℝ :=
  64 * ((1 / 2 : ℝ) + finiteMolecularCoulombPhysicalFormConstant eta data L Hunit + |E|) *
    (eta : ℝ) ^ 2 *
    (finiteMolecularCoulombPhysicalTailConstant eta data L Hunit Blow Cs Bker
      (continuumMolecularBOH2Constant eta data E L Hunit)) ^ 2

end
