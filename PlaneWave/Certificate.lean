      ‖W (fullCoeffVector coeff)‖ ≤
          B * Real.sqrt (fourierH1Sq kabs (fullCoeffVector coeff)) :=
        norm_le_sqrt_fourierH1Sq_of_operatorBound kabs W hB hBound _
