/-! ## Eighty-seventh milestone: make the localized Hardy state canonical -/

/--
The raw pointwise localized inverse-radius function used in the inner Hardy
argument.  Unlike the earlier milestones, there is no freely chosen `L²`
state here: this is the actual function

`(1 / |y|) * chi_{rho,R}(y) * psi(y)`

on the centered fundamental cube.
-/
noncomputable def centeredCube3RadialCutoffLocalizedFunction
    {α : Type}
    [Fintype α]
    (rho R : ℝ)
    (index : α → Lattice3)
    (f : α → ℂ)
    (y : CenteredCube3) : ℂ :=
  (centeredCube3InverseRadius y : ℂ) *
    (centeredCube3RadialCutoff rho R y : ℂ) *
    torus3FourierPolynomial index f
      (unitTorus3CenteredEquiv.symm y)

/--
Raw Hardy data for the explicit localized function.

Compared with milestone 86, the abstract fields `localizedState` and
`localized_eq_ae` have disappeared.  The only two analytic obligations are
now:

* the actual pointwise function is in `L²`;
* the standard three-dimensional Hardy inequality holds for it with the
  explicit assembled gradient.

The `L²` state used by all later milestones is constructed canonically with
`MemLp.toLp`, and its representative identity is then a theorem rather than
an assumption.
-/
structure CenteredCube3RadialCutoffRawHardyData
    (rho R : ℝ) where

  rho_pos : 0 < rho
  rho_lt_outer : rho < R
  outer_lt_half : R < (1 / 2 : ℝ)

  localized_memLp :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        ∀ f : α → ℂ,
          MeasureTheory.MemLp
            (centeredCube3RadialCutoffLocalizedFunction
              rho R index f)
            2 centeredCube3Measure

  hardy_norm_sq_le_explicit_gradient :
    ∀ (α : Type) [Fintype α],
      ∀ index : α → Lattice3,
        Function.Injective index →
        ∀ f : α → ℂ,
          ‖(localized_memLp α index f).toLp
              (centeredCube3RadialCutoffLocalizedFunction
                rho R index f)‖ ^ 2
            ≤
          4 *
            (∑ j : Fin 3,
              ‖centeredCube3RadialCutoffMainGradientState
                    rho R rho_lt_outer index f j +
                  centeredCube3RadialCutoffGradientState
                    rho R rho_pos rho_lt_outer index f j‖ ^ 2)

/--
The raw pointwise Hardy data canonically produce milestone 86's explicit
`L²` gradient data.  In particular, the a.e. identity is discharged directly
by `MemLp.coeFn_toLp`.
-/
noncomputable def
    CenteredCube3RadialCutoffRawHardyData.toExplicitGradientData
    {rho R : ℝ}
    (data : CenteredCube3RadialCutoffRawHardyData rho R) :
    CenteredCube3RadialCutoffExplicitGradientData rho R where

  rho_pos := data.rho_pos
  rho_lt_outer := data.rho_lt_outer
  outer_lt_half := data.outer_lt_half

  localizedState :=
    fun α _ index f =>
      (data.localized_memLp α index f).toLp
        (centeredCube3RadialCutoffLocalizedFunction
          rho R index f)

  localized_eq_ae := by
    intro α inst index f
    have hCoe :=
      MeasureTheory.MemLp.coeFn_toLp
        (data.localized_memLp α index f)
    filter_upwards [hCoe] with y hy
    rw [hy]
    rfl

  hardy_norm_sq_le_explicit_gradient := by
    intro α inst index hInjective f
    exact
      data.hardy_norm_sq_le_explicit_gradient
        α index hInjective f

end

end PlaneWaveCertificate

