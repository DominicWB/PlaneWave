  have h := potential_sq_le sys L H hKernel Hunit hL hPeriodic hα u
  have h1 : C ^ 2 * (1 / (4 * C ^ 2 + 1)) ≤ 1 / 4 := by
    rw [← mul_div_assoc, mul_one, div_le_div_iff₀ (by positivity) (by norm_num)]
    nlinarith [sq_nonneg C]
  have h2 : 1 + 1 / (1 / (4 * C ^ 2 + 1)) = 4 * C ^ 2 + 2 := by
    rw [one_div_one_div]
    ring
  rw [h2] at h
  have hT := sq_nonneg ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖
  calc _ ≤ C ^ 2 * (1 / (4 * C ^ 2 + 1) * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ ^ 2 +
          (4 * C ^ 2 + 2) * ‖molecularH2StateMap eta (2 * Real.pi / L) u‖ ^ 2) := h
    _ = (C ^ 2 * (1 / (4 * C ^ 2 + 1))) * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ ^ 2 +
          C ^ 2 * (4 * C ^ 2 + 2) * ‖molecularH2StateMap eta (2 * Real.pi / L) u‖ ^ 2 := by ring
    _ ≤ _ := by gcongr

end Potential

/-! ## Bounded diagonal operators on `ℓ²` -/

section DiagCLM

variable {ι : Type*}

omit [Fintype ν] in
lemma l2_norm_le_of_le (a b : ℓ²(ι, ℂ)) {k : ℝ} (hk : 0 ≤ k) (h : ∀ i, ‖a i‖ ≤ k * ‖b i‖) :
    ‖a‖ ≤ k * ‖b‖ := by
  have h1 : ‖a‖ ^ 2 ≤ (k * ‖b‖) ^ 2 := by
    rw [l2_norm_sq, mul_pow, l2_norm_sq, ← tsum_mul_left]
    refine (l2_summable_sq a).tsum_le_tsum (fun i => ?_) ((l2_summable_sq b).mul_left _)
    have := h i
    have h0 := norm_nonneg (a i)
    rw [← mul_pow]
    exact pow_le_pow_left₀ h0 this 2
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp h1

omit [Fintype ν] in
lemma memℓp_diag (d : ι → ℂ) {C : ℝ} (hd : ∀ i, ‖d i‖ ≤ C) (a : ℓ²(ι, ℂ)) :
    Memℓp (fun i => d i * a i) 2 := by
  refine Memℓp.mono (g := fun i => C * ‖a i‖) ?_ (fun i => ?_)
  · have h := (lp.memℓp a).norm
    exact h.const_mul C
  · rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hd i) (norm_nonneg _)

/-- A bounded diagonal operator on `ℓ²`. -/
noncomputable def diagCLM (d : ι → ℂ) (C : ℝ) (hC : 0 ≤ C) (hd : ∀ i, ‖d i‖ ≤ C) :
    ℓ²(ι, ℂ) →L[ℂ] ℓ²(ι, ℂ) :=
  LinearMap.mkContinuous
    { toFun := fun a => ⟨fun i => d i * a i, memℓp_diag d hd a⟩
      map_add' := fun a b => by
        ext i
        simp only [lp.coeFn_add, Pi.add_apply]
        change d i * (a i + b i) = d i * a i + d i * b i
        ring
      map_smul' := fun z a => by
        ext i
        simp only [lp.coeFn_smul, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
        change d i * (z * a i) = z * (d i * a i)
        ring }
    C (fun a => l2_norm_le_of_le _ a hC (fun i => by
      change ‖d i * a i‖ ≤ C * ‖a i‖
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hd i) (norm_nonneg _)))

omit [Fintype ν] in
@[simp] lemma diagCLM_apply (d : ι → ℂ) (C : ℝ) (hC : 0 ≤ C) (hd : ∀ i, ‖d i‖ ≤ C)
    (a : ℓ²(ι, ℂ)) (i : ι) : diagCLM d C hC hd a i = d i * a i := rfl

end DiagCLM

/-! ## D3, D4: the resolvent of the Coulomb Hamiltonian -/

section Resolvent

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ)

/-- The shift `c = 4 C² + 2` of the resolvent `(H + c)⁻¹`. -/
noncomputable def shiftC : ℝ := 4 * finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 + 2

lemma two_le_shiftC : 2 ≤ shiftC sys L Hunit := by
  unfold shiftC
  nlinarith [sq_nonneg (finiteCoulombPhysicalMassConstant sys L Hunit)]

omit [Fintype ν] in
lemma dInv_entry_le (c : ℝ) (hc : 1 / 2 ≤ c) (p : FourierConfig eta Lattice3) :
    ‖(((molecularFourierH2Weight eta (2 * Real.pi / L) p /
        (coulombKineticEnergySymbol sys (2 * Real.pi / L) p + c)) : ℝ) : ℂ)‖ ≤
      2 * sys.maxMass := by
  have hk := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
  have hw := molecularFourierH2Weight_pos eta (2 * Real.pi / L) p
  have hwm := molecularFourierH2Weight_le_maxMass_mul sys (2 * Real.pi / L) p
  have hM := sys.one_le_maxMass
  have hden : 0 < coulombKineticEnergySymbol sys (2 * Real.pi / L) p + c := by linarith
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hw.le hden.le),
    div_le_iff₀ hden]
  nlinarith

/-- The diagonal inverse of `T + c S`: multiplication by `w/(kin + c)`. -/
noncomputable def dInv : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  diagCLM (fun p => (((molecularFourierH2Weight eta (2 * Real.pi / L) p /
      (coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit)) : ℝ) : ℂ))
    (2 * sys.maxMass) (by have := sys.one_le_maxMass; positivity)
    (dInv_entry_le sys L (shiftC sys L Hunit) (by linarith [two_le_shiftC sys L Hunit]))

lemma dInv_apply (f : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (p : FourierConfig eta Lattice3) :
    dInv sys L Hunit f p = (((molecularFourierH2Weight eta (2 * Real.pi / L) p /
      (coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit)) : ℝ) : ℂ) *
        f p := rfl

lemma coeff_dInv (f : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (p : FourierConfig eta Lattice3) :
    molecularH2Coeff (2 * Real.pi / L) (dInv sys L Hunit f) p =
      f p / ((coulombKineticEnergySymbol sys (2 * Real.pi / L) p +
          shiftC sys L Hunit : ℝ) : ℂ) := by
  have hk := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
  have hc := two_le_shiftC sys L Hunit
  have hw : ((molecularFourierH2Weight eta (2 * Real.pi / L) p : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (molecularFourierH2Weight_pos eta _ p).ne'
  have hd : ((coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit : ℝ) : ℂ) ≠
      0 := Complex.ofReal_ne_zero.mpr (by linarith)
  rw [molecularH2Coeff, dInv_apply]
  push_cast at hd ⊢
  field_simp

/-- `(T + c S) dInv = 1`. -/
lemma kinetic_dInv_add (f : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    coulombFourierKineticH2 sys (2 * Real.pi / L) (dInv sys L Hunit f) +
      (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) (dInv sys L Hunit f) =
        f := by
  ext p
  have hk := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
  have hc := two_le_shiftC sys L Hunit
  have hd : ((coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit : ℝ) : ℂ) ≠
      0 := Complex.ofReal_ne_zero.mpr (by linarith)
  simp only [lp.coeFn_add, lp.coeFn_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
    coulombFourierKineticH2_apply, molecularH2StateMap_apply, coeff_dInv]
  push_cast at hd ⊢
  field_simp

/-- `dInv (T + c S) = 1`. -/
lemma dInv_kinetic_add (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    dInv sys L Hunit (coulombFourierKineticH2 sys (2 * Real.pi / L) x +
      (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) x) = x := by
  ext p
  have hk := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
  have hc := two_le_shiftC sys L Hunit
  have hd : ((coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit : ℝ) : ℂ) ≠
      0 := Complex.ofReal_ne_zero.mpr (by linarith)
  have hw : ((molecularFourierH2Weight eta (2 * Real.pi / L) p : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (molecularFourierH2Weight_pos eta _ p).ne'
  rw [dInv_apply]
  simp only [lp.coeFn_add, lp.coeFn_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
    coulombFourierKineticH2_apply, molecularH2StateMap_apply, molecularH2Coeff]
  push_cast at hd hw ⊢
  field_simp

lemma norm_kinetic_dInv_le (f : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖coulombFourierKineticH2 sys (2 * Real.pi / L) (dInv sys L Hunit f)‖ ≤ ‖f‖ := by
  have h := l2_norm_le_of_le (coulombFourierKineticH2 sys (2 * Real.pi / L) (dInv sys L Hunit f))
    f zero_le_one (fun p => ?_)
  · simpa using h
  have hk := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
  have hc := two_le_shiftC sys L Hunit
  have hden : 0 < coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit := by
    linarith
  rw [coulombFourierKineticH2_apply, coeff_dInv, norm_mul, norm_div, Complex.norm_real,
    Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hk,
    abs_of_pos hden, one_mul]
  rw [← mul_div_assoc, div_le_iff₀ hden]
  nlinarith [norm_nonneg (f p)]

lemma norm_stateMap_dInv_le (f : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖molecularH2StateMap eta (2 * Real.pi / L) (dInv sys L Hunit f)‖ ≤
      (1 / shiftC sys L Hunit) * ‖f‖ := by
  have hc := two_le_shiftC sys L Hunit
  refine l2_norm_le_of_le _ f (by positivity) (fun p => ?_)
  have hk := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
  have hden : 0 < coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit := by
    linarith
  rw [molecularH2StateMap_apply, coeff_dInv, norm_div, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hden, div_le_iff₀ hden]
  have : 1 / shiftC sys L Hunit * ‖f p‖ *
      (coulombKineticEnergySymbol sys (2 * Real.pi / L) p + shiftC sys L Hunit) =
      ‖f p‖ + ‖f p‖ * coulombKineticEnergySymbol sys (2 * Real.pi / L) p / shiftC sys L Hunit := by
    field_simp
    ring
  rw [this]
  have : 0 ≤ ‖f p‖ * coulombKineticEnergySymbol sys (2 * Real.pi / L) p / shiftC sys L Hunit := by
    positivity
  linarith

include hKernel in
/-- `‖W dInv f‖ ≤ (3/4) ‖f‖`. -/
lemma norm_potential_dInv_le (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (f : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H (dInv sys L Hunit f)‖ ≤ (3 / 4) * ‖f‖ := by
  set C := finiteCoulombPhysicalMassConstant sys L Hunit
  have h := potential_sq_le_quarter sys L H hKernel Hunit hL hPeriodic (dInv sys L Hunit f)
  have hT := norm_kinetic_dInv_le sys L Hunit f
  have hS := norm_stateMap_dInv_le sys L Hunit f
  have hc : shiftC sys L Hunit = 4 * C ^ 2 + 2 := rfl
  rw [hc] at hS
  have hT2 : ‖coulombFourierKineticH2 sys (2 * Real.pi / L) (dInv sys L Hunit f)‖ ^ 2 ≤ ‖f‖ ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) hT 2
  have hS2 : ‖molecularH2StateMap eta (2 * Real.pi / L) (dInv sys L Hunit f)‖ ^ 2 ≤
      (1 / (4 * C ^ 2 + 2) * ‖f‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hS 2
  have hpos : 0 < 4 * C ^ 2 + 2 := by positivity
  have key : C ^ 2 * (4 * C ^ 2 + 2) * (1 / (4 * C ^ 2 + 2) * ‖f‖) ^ 2 ≤ 1 / 4 * ‖f‖ ^ 2 := by
    have e : C ^ 2 * (4 * C ^ 2 + 2) * (1 / (4 * C ^ 2 + 2) * ‖f‖) ^ 2 =
        C ^ 2 / (4 * C ^ 2 + 2) * ‖f‖ ^ 2 := by
      field_simp
    rw [e]
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    rw [div_le_iff₀ hpos]
    nlinarith
  have hCC : 0 ≤ C ^ 2 * (4 * C ^ 2 + 2) := by positivity
  have hW2 : ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H (dInv sys L Hunit f)‖ ^ 2 ≤
      (3 / 4 * ‖f‖) ^ 2 := by
    calc _ ≤ 1 / 4 * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) (dInv sys L Hunit f)‖ ^ 2 +
          C ^ 2 * (4 * C ^ 2 + 2) *
            ‖molecularH2StateMap eta (2 * Real.pi / L) (dInv sys L Hunit f)‖ ^ 2 := h
      _ ≤ 1 / 4 * ‖f‖ ^ 2 + C ^ 2 * (4 * C ^ 2 + 2) * (1 / (4 * C ^ 2 + 2) * ‖f‖) ^ 2 := by
          gcongr
      _ ≤ 1 / 4 * ‖f‖ ^ 2 + 1 / 4 * ‖f‖ ^ 2 := by linarith
      _ ≤ (3 / 4 * ‖f‖) ^ 2 := by nlinarith [sq_nonneg ‖f‖]
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hW2

/-- The operator `K = W dInv`. -/
noncomputable def kOp : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  (coulombFourierPotentialH2 sys (2 * Real.pi / L) H).comp (dInv sys L Hunit)

include hKernel in
lemma norm_kOp_lt_one (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    ‖kOp sys L H Hunit‖ < 1 := by
  have h : ‖kOp sys L H Hunit‖ ≤ 3 / 4 :=
    ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
      (fun f => norm_potential_dInv_le sys L H hKernel Hunit hL hPeriodic f)
  linarith

/-- The unit `1 + K` (Neumann series). -/
noncomputable def resolventUnit (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    (lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)ˣ :=
  Units.oneSub (-kOp sys L H Hunit)
      (by rw [norm_neg]; exact norm_kOp_lt_one sys L H hKernel Hunit hL hPeriodic)

lemma resolventUnit_val (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    (resolventUnit sys L H hKernel Hunit hL hPeriodic).val v = v + kOp sys L H Hunit v := by
  simp [resolventUnit, Units.val_oneSub]

/-- The resolvent `(H + c S)⁻¹ : ℓ² → H²` (weighted coordinates). -/
noncomputable def resolventG (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) :
    lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
  (dInv sys L Hunit).comp ((resolventUnit sys L H hKernel Hunit hL hPeriodic)⁻¹).val

/-- `(H + c S) G = 1`. -/
lemma H_add_shift_resolventG (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (f : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    H (resolventG sys L H hKernel Hunit hL hPeriodic f) +
      (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L)
        (resolventG sys L H hKernel Hunit hL hPeriodic f) = f := by
  set U := resolventUnit sys L H hKernel Hunit hL hPeriodic
  set v := (U⁻¹).val f
  have hG : resolventG sys L H hKernel Hunit hL hPeriodic f = dInv sys L Hunit v := rfl
  rw [hG, coulombFourierHamiltonianH2_decomposition sys (2 * Real.pi / L) H]
  have h1 := kinetic_dInv_add sys L Hunit v
  have h2 : U.val v = f := by
    change (U.val * (U⁻¹).val) f = f
    rw [Units.mul_inv]
    rfl
  rw [resolventUnit_val] at h2
  calc coulombFourierKineticH2 sys (2 * Real.pi / L) (dInv sys L Hunit v) +
        coulombFourierPotentialH2 sys (2 * Real.pi / L) H (dInv sys L Hunit v) +
        (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) (dInv sys L Hunit v)
      = (coulombFourierKineticH2 sys (2 * Real.pi / L) (dInv sys L Hunit v) +
          (shiftC sys L Hunit : ℂ) •
            molecularH2StateMap eta (2 * Real.pi / L) (dInv sys L Hunit v)) +
        coulombFourierPotentialH2 sys (2 * Real.pi / L) H (dInv sys L Hunit v) := by abel
    _ = v + kOp sys L H Hunit v := by rw [h1]; rfl
    _ = f := h2

/-- `G (H + c S) = 1`. -/
lemma resolventG_H_add_shift (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)
    (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    resolventG sys L H hKernel Hunit hL hPeriodic
      (H x + (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) x) = x := by
  set U := resolventUnit sys L H hKernel Hunit hL hPeriodic
  set y := coulombFourierKineticH2 sys (2 * Real.pi / L) x +
    (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) x
  have hy : dInv sys L Hunit y = x := dInv_kinetic_add sys L Hunit x
  have hsum : H x + (shiftC sys L Hunit : ℂ) • molecularH2StateMap eta (2 * Real.pi / L) x =
      U.val y := by
    rw [resolventUnit_val]
    simp only [kOp, ContinuousLinearMap.coe_comp, Function.comp_apply, hy]
    rw [coulombFourierHamiltonianH2_decomposition sys (2 * Real.pi / L) H]
    simp only [y]
    abel
  rw [hsum]
  change dInv sys L Hunit (((U⁻¹).val * U.val) y) = x
  rw [Units.inv_mul]
  exact hy

end Resolvent

/-! ## D5: the decoding map `S` is compact -/

section Compact

omit [Fintype ν] in
/-- Outside the cube of radius `n` the `H²` weight is at least `1 + g² (n+1)²`. -/
lemma weight_ge_of_not_mem_cube (g : ℝ) (n : ℕ) {p : FourierConfig eta Lattice3}
    (hp : p ∉ fourierConfigCube eta n) :
    1 + g ^ 2 * ((n : ℝ) + 1) ^ 2 ≤ molecularFourierH2Weight eta g p := by
  rw [mem_fourierConfigCube_iff] at hp
  push Not at hp
  obtain ⟨i, d, hid⟩ := hp
  have hsq : ((n : ℝ) + 1) ^ 2 ≤ ((p i d : ℤ) : ℝ) ^ 2 := by
    have h1 : (n : ℤ) + 1 ≤ |p i d| := by
      by_cases h : -(n : ℤ) ≤ p i d
      · have := hid h
        rw [abs_of_pos (by omega)]
        omega
      · push Not at h
        rw [abs_of_neg (by omega)]
        omega
    have h2 : ((n : ℝ) + 1) ≤ |((p i d : ℤ) : ℝ)| := by
      have := (Int.cast_le (R := ℝ)).mpr h1
      push_cast at this
      exact this
    calc ((n : ℝ) + 1) ^ 2 ≤ |((p i d : ℤ) : ℝ)| ^ 2 :=
          pow_le_pow_left₀ (by positivity) h2 2
      _ = ((p i d : ℤ) : ℝ) ^ 2 := sq_abs _
  have hlat : ((p i d : ℤ) : ℝ) ^ 2 ≤ latticeNormSq (p i) := by
    unfold latticeNormSq
    fin_cases d <;> simp <;> nlinarith [sq_nonneg ((p i 0 : ℤ) : ℝ), sq_nonneg ((p i 1 : ℤ) : ℝ),
      sq_nonneg ((p i 2 : ℤ) : ℝ)]
  have hsum : g ^ 2 * latticeNormSq (p i) ≤ ∑ j : Fin eta, g ^ 2 * latticeNormSq (p j) :=
    Finset.single_le_sum (f := fun j => g ^ 2 * latticeNormSq (p j))
      (fun j _ => mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg (p j))) (Finset.mem_univ i)
  unfold molecularFourierH2Weight
  nlinarith [sq_nonneg g]

/-- The cubic extraction as a bounded operator into the finite Euclidean space. -/
noncomputable def extractCLM (n : ℕ) : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
    EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) :=
  LinearMap.mkContinuous
    { toFun := fun x => fullCoeffVector (finiteFourierCoeffExtract n (fun p => x p))
      map_add' := fun x y => by
        ext q
        simp [fullCoeffVector_apply, finiteFourierCoeffExtract]
      map_smul' := fun a x => by
        ext q
        simp [fullCoeffVector_apply, finiteFourierCoeffExtract] }
    1 (fun x => by
      change ‖fullCoeffVector (finiteFourierCoeffExtract n (fun p => x p))‖ ≤ 1 * ‖x‖
      rw [one_mul, ← finiteFourierLpEmbed_norm_eq_fullCoeffVector,
        finiteFourierLpEmbed_extract_eq_truncate]
      exact lpTruncate_norm_le _ x)

lemma emb_extractCLM (n : ℕ) (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    finiteFourierLpIsometry eta n (extractCLM n x) = molecularH2Truncate n x := by
  rw [finiteFourierLpIsometry_apply]
  exact finiteFourierLpEmbed_extract_eq_truncate n x

/-- Cubic truncation is a compact operator (finite rank). -/
lemma isCompactOperator_truncate (n : ℕ) :
    IsCompactOperator (fun x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 =>
      molecularH2Truncate n x) := by
  have hid : IsCompactOperator
      (id : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) →
        EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :=
    (isCompactOperator_id_iff_finiteDimensional (𝕜 := ℂ)).mpr inferInstance
  have h := (hid.comp_clm (extractCLM n)).clm_comp
    (finiteFourierLpIsometry eta n).toContinuousLinearMap
  have hfun : (fun x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 => molecularH2Truncate n x) =
      ⇑(finiteFourierLpIsometry eta n).toContinuousLinearMap ∘ id ∘ ⇑(extractCLM n) :=
    funext fun x => (emb_extractCLM n x).symm
  rw [hfun]
  exact h

/-- **The decoding map is compact.** -/
theorem isCompactOperator_stateMap (g : ℝ) (hg : 0 < g) :
    IsCompactOperator (molecularH2StateMap eta g) := by
  classical
  set S := molecularH2StateMap eta g
  set F : ℕ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
    fun n => S.comp (lpTruncateCLM (fourierConfigCube eta n))
  have hFapply : ∀ n x, F n x = S (molecularH2Truncate n x) := fun n x => rfl
  refine isCompactOperator_of_tendsto (F := F) (l := atTop) ?_ (Eventually.of_forall fun n => ?_)
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    set ε : ℕ → ℝ := fun n => 1 / (1 + g ^ 2 * ((n : ℝ) + 1) ^ 2)
    have hbound : ∀ n, ‖F n - S‖ ≤ ε n := by
      intro n
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun x => ?_)
      rw [sub_apply, hFapply]
      refine l2_norm_le_of_le _ x (by positivity) (fun p => ?_)
      rw [lp.coeFn_sub, Pi.sub_apply, molecularH2StateMap_apply, molecularH2StateMap_apply,
        molecularH2Coeff, molecularH2Coeff, molecularH2Truncate_apply]
      by_cases hp : p ∈ fourierConfigCube eta n
      · rw [cubicLatticeCoeffTruncate_eq_of_mem n _ p hp, sub_self, norm_zero]
        positivity
      · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp, zero_div, zero_sub, norm_neg,
