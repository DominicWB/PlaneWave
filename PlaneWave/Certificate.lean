      (Measure.map f (volume : Measure (UnitAddTorus d))) Set.univ = 1 := by
    rw [Measure.map_apply hf.measurable MeasurableSet.univ,
      Set.preimage_univ, measure_univ]
  simpa only [hmass, measure_univ, div_one, one_smul] using h

/-- The actual three-dimensional position of particle `i`. -/
def molecularPositionParticle {eta : ℕ} (i : Fin eta)
    (x : MolecularPositionTorus eta) : UnitTorus3 :=
  fun a => x (i, a)

/-- The actual relative coordinate of two particles. -/
def molecularPositionDifference {eta : ℕ} (i j : Fin eta)
    (x : MolecularPositionTorus eta) : UnitTorus3 :=
  molecularPositionParticle i x - molecularPositionParticle j x

/-- The positive nuclear shift required by the already fixed Fourier-kernel
convention. With positive Fourier synthesis the existing positive nuclear phase
corresponds to `x_i + R`. This definition records that convention explicitly. -/
def molecularPositionNuclearArgument {eta : ℕ} (i : Fin eta)
    (R : UnitTorus3) (x : MolecularPositionTorus eta) : UnitTorus3 :=
  molecularPositionParticle i x + R

theorem molecularPositionParticle_continuous {eta : ℕ} (i : Fin eta) :
    Continuous (molecularPositionParticle i) :=
  continuous_pi fun a => continuous_apply (i, a)

theorem molecularPositionDifference_continuous {eta : ℕ} (i j : Fin eta) :
    Continuous (molecularPositionDifference i j) :=
  (molecularPositionParticle_continuous i).sub
    (molecularPositionParticle_continuous j)

/-- A single particle has normalized uniform position distribution under
configuration-space Haar measure. -/
theorem molecularPositionParticle_measurePreserving {eta : ℕ} (i : Fin eta) :
    MeasurePreserving (molecularPositionParticle i)
      (volume : Measure (MolecularPositionTorus eta)) volume := by
  let f : MolecularPositionTorus eta →+ UnitTorus3 :=
    { toFun := molecularPositionParticle i
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  apply unitAddTorus_measurePreserving_of_surjective_addHom f
    (molecularPositionParticle_continuous i)
  intro z
  exact ⟨fun a => z a.2, rfl⟩

/-- The difference of two distinct particle positions has normalized uniform
distribution. Distinctness is necessary: a self-difference is constant. -/
theorem molecularPositionDifference_measurePreserving {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) :
    MeasurePreserving (molecularPositionDifference i j)
      (volume : Measure (MolecularPositionTorus eta)) volume := by
  classical
  let f : MolecularPositionTorus eta →+ UnitTorus3 :=
    { toFun := molecularPositionDifference i j
      map_zero' := by
        funext a
        exact sub_self 0
      map_add' := by
        intro x y
        funext a
        change x (i, a) + y (i, a) - (x (j, a) + y (j, a)) =
          (x (i, a) - x (j, a)) + (y (i, a) - y (j, a))
        abel }
  apply unitAddTorus_measurePreserving_of_surjective_addHom f
    (molecularPositionDifference_continuous i j)
  intro z
  refine ⟨fun a => if a.1 = i then z a.2 else 0, ?_⟩
  funext a
  change (if i = i then z a else 0) - (if j = i then z a else 0) = z a
  simp [Ne.symm hij]

/-- A fixed nuclear translation preserves the same normalized marginal. -/
theorem molecularPositionNuclearArgument_measurePreserving {eta : ℕ}
    (i : Fin eta) (R : UnitTorus3) :
    MeasurePreserving (molecularPositionNuclearArgument i R)
      (volume : Measure (MolecularPositionTorus eta)) volume :=
  (measurePreserving_add_right (volume : Measure UnitTorus3) R).comp
    (molecularPositionParticle_measurePreserving i)

/-- The singular scalar Coulomb potential can be pulled back to a nuclear
relative coordinate without losing square integrability. -/
theorem molecularPositionNuclearCoulomb_memLp {eta : ℕ}
    (i : Fin eta) (R : UnitTorus3) :
    MemLp (fun x : MolecularPositionTorus eta =>
      canonicalUnitTorus3CoulombPotential.potential
        (molecularPositionNuclearArgument i R x)) 2 volume :=
  canonicalUnitTorus3CoulombPotential.potential_memLp.comp_measurePreserving
    (molecularPositionNuclearArgument_measurePreserving i R)

/-- The pair-collision Coulomb potential is square integrable on the full
configuration torus, including when other particle coordinates are present. -/
theorem molecularPositionPairCoulomb_memLp {eta : ℕ}
    (i j : Fin eta) (hij : i ≠ j) :
    MemLp (fun x : MolecularPositionTorus eta =>
      canonicalUnitTorus3CoulombPotential.potential
        (molecularPositionDifference i j x)) 2 volume :=
  canonicalUnitTorus3CoulombPotential.potential_memLp.comp_measurePreserving
    (molecularPositionDifference_measurePreserving i j hij)

/-- The literal signed molecular multiplication function in the existing
Fourier convention: each electron pair appears once and the nuclear terms
carry negative charges. Nuclear positions enter as `x_i + R`, matching the
positive character in `latticeElectronNuclearKernel`; a change to the usual
`x_i - R` coordinate convention requires an additional parity identification.

This definition is independent of the completed Hamiltonian and its potential
part. It is a finite sum of the canonical scalar Coulomb potential evaluated
at actual position differences and nuclear translates. -/
def molecularFourierConventionCoulombPotential
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) (x : MolecularPositionTorus eta) : ℂ :=
  (coulombCellAmplitude L : ℂ) *
    ((∑ pair : FiniteElectronPair eta,
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 x)) -
      ∑ i : Fin eta, ∑ ell : ν,
        (data.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearArgument i (data.position ell) x))

/-- The full signed many-particle Coulomb potential is square integrable.
This is a proved property of the pointwise expression, not an assumption about
the Hamiltonian completion. -/
theorem molecularFourierConventionCoulombPotential_memLp
    {ν : Type*} [Fintype ν] (eta : ℕ) (L : ℝ)
    (data : FiniteBONuclearData ν) :
    MemLp (molecularFourierConventionCoulombPotential eta L data) 2 volume := by
  have hPair : MemLp (fun x : MolecularPositionTorus eta =>
      ∑ pair : FiniteElectronPair eta,
        canonicalUnitTorus3CoulombPotential.potential
          (molecularPositionDifference pair.1.1 pair.1.2 x)) 2 volume := by
    apply memLp_finsetSum
    intro pair _
    exact molecularPositionPairCoulomb_memLp pair.1.1 pair.1.2 (ne_of_lt pair.2)
  have hNuclear : MemLp (fun x : MolecularPositionTorus eta =>
      ∑ i : Fin eta, ∑ ell : ν,
        (data.charge ell : ℂ) *
          canonicalUnitTorus3CoulombPotential.potential
            (molecularPositionNuclearArgument i (data.position ell) x)) 2 volume := by
    apply memLp_finsetSum
    intro i _
    apply memLp_finsetSum
    intro ell _
    exact (molecularPositionNuclearCoulomb_memLp i (data.position ell)).const_mul
      (data.charge ell : ℂ)
  exact (hPair.sub hNuclear).const_mul (coulombCellAmplitude L : ℂ)

end
end PlaneWaveCertificate

