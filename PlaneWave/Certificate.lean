/-- **`thm:mult-gal` with its propagators.** For a periodic Coulomb system there is a propagator
`U` on `L²((T³)^η)` (unitary group, strongly continuous, preserving the graph of the Hamiltonian,
solving the Schrödinger equation on it, and the only evolution that does so), and for every cube
`n` a Galerkin propagator `U_N` of `H_N`, such that for all `ψ₀ ∈ D(H²)` (`H ψ₀ = h₀`,
`H h₀ = h₁`), with `(A₁, A₂) = kinConsts` at `(‖ψ₀‖, ‖h₀‖, ‖h₁‖)` fixed before the cube and the
time: for every kinetic multiplier `μ`, every cube `n ≥ 2` with `K = 2πn/L ≥ 1` and every
`t ≥ 0`, `|⟨ψ(t), μ ψ(t)⟩ - ⟨ψ_N(t), μ ψ_N(t)⟩| ≤ A₁ K^{-3} + A₂ t K^{-3/2}`. -/
theorem thm_mult_gal (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      ∃ UN : (n : ℕ) → ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ n x, UN n 0 x = x) ∧ (∀ n s t x, UN n (s + t) x = UN n s (UN n t x)) ∧
        (∀ n t x, HasDerivAt (fun s => UN n s x)
          (-(Complex.I • UN n t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ ψ₀ h₀ h₁ : MolecularPositionL2 eta, HasCoulombHamiltonian sys L ψ₀ h₀ →
          HasCoulombHamiltonian sys L h₀ h₁ →
          let A := kinConsts sys L molecularCanonicalUnitHardyConstant
            (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
            (molecularCanonicalKernelConstant L) ‖ψ₀‖ ‖h₀‖ ‖h₁‖
          ∀ (m : KinMult sys (2 * Real.pi / L)) (n : ℕ), 2 ≤ n → 1 ≤ (2 * Real.pi / L) * n →
            ∀ t : ℝ, 0 ≤ t →
            let K : ℝ := (2 * Real.pi / L) * n
            let ψN := physMap eta (finiteFourierLpIsometry eta n
              (UN n t (extractCLM n ((physMap eta).symm ψ₀))))
            |m.posExpect (U t ψ₀) - m.posExpect ψN| ≤
              A.1 * (1 / K) ^ 3 + A.2 * t * Real.sqrt (1 / K) ^ 3 := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, -, -⟩ := exists_coulombPropagator sys L hL
  choose UN hN0 hNadd _ hNcomm hNderiv _ using
    fun n => exists_finitePropagator (finiteCoulombHamiltonian_isSymmetric sys L n)
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, UN, hN0, hNadd, hNderiv, ?_⟩
  intro ψ₀ h₀ h₁ hψ₀ hh₀ A m n hn hK1 t ht
  exact kinetic_galerkin_position sys L hL U h0 hgraph hderiv n (UN n) (hN0 n) (hNadd n) (hNcomm n)
    (hNderiv n) hn hK1 ψ₀ h₀ h₁ hψ₀ hh₀ m ht

end Position

/-! ## `cor:stopping`, Galerkin route -/

/-- The secant-slope estimator: if two trajectories of an observable differ by at most `D₀` at
time `0` and by at most `D_T` at time `T > 0`, their secant slopes over `[0, T]` divided by the
projectile speed `v_p > 0` differ by at most `(D₀ + D_T)/(v_p T)`. -/
lemma secant_slope_le {E₀ E_T F₀ F_T D₀ D_T v T : ℝ} (hv : 0 < v) (hT : 0 < T)
    (h0 : |E₀ - F₀| ≤ D₀) (hT' : |E_T - F_T| ≤ D_T) :
    |(E_T - E₀) / (v * T) - (F_T - F₀) / (v * T)| ≤ (D₀ + D_T) / (v * T) := by
  rw [← sub_div, abs_div, abs_of_pos (mul_pos hv hT)]
  apply div_le_div_of_nonneg_right _ (mul_pos hv hT).le
  have e : E_T - E₀ - (F_T - F₀) = (E_T - F_T) - (E₀ - F₀) := by ring
  rw [e]
  refine (abs_sub _ _).trans ?_
  linarith

lemma stopping_arith {a1 a2 k r v T : ℝ} (hv : 0 < v) (hT : 0 < T) :
    (a1 * k + a2 * 0 * r + (a1 * k + a2 * T * r)) / (v * T) = (a2 * r + 2 * a1 * k / T) / v := by
  field_simp
  ring

/-- **`cor:stopping`, Galerkin route.** In the setting of `thm_mult_gal`, the secant-slope
estimator `Ŝ = (⟨A_p⟩(T) - ⟨A_p⟩(0))/(v_p T)` of the stopping power over a window `[0, T]`,
evaluated on the Galerkin trajectory, deviates from the same functional of the exact trajectory by
at most `(A₂ K^{-3/2} + 2 A₁ K^{-3}/T)/v_p`. -/
theorem stopping_galerkin (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (hn : 2 ≤ n) (hK1 : 1 ≤ (2 * Real.pi / L) * n)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁)
    (m : KinMult sys (2 * Real.pi / L)) {vp T : ℝ} (hvp : 0 < vp) (hT : 0 < T) :
    let K := (2 * Real.pi / L) * n
    let ψN : ℝ → MolecularPositionL2 eta := fun s => physMap eta (finiteFourierLpIsometry eta n
      (UN s (extractCLM n ((physMap eta).symm ψ₀))))
    let A := kinConsts sys L molecularCanonicalUnitHardyConstant
      (molecularCanonicalLowConstant L) (molecularCanonicalSobolevConstant L)
      (molecularCanonicalKernelConstant L) ‖ψ₀‖ ‖h₀‖ ‖h₁‖
    |(m.posExpect (U T ψ₀) - m.posExpect (U 0 ψ₀)) / (vp * T) -
        (m.posExpect (ψN T) - m.posExpect (ψN 0)) / (vp * T)| ≤
      (A.2 * Real.sqrt (1 / K) ^ 3 + 2 * A.1 * (1 / K) ^ 3 / T) / vp := by
  intro K ψN A
  have h0 := kinetic_galerkin_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm hNderiv
    hn hK1 ψ₀ h₀ h₁ hψ₀ hh₀ m (le_refl 0)
  have hT' := kinetic_galerkin_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
    hNderiv hn hK1 ψ₀ h₀ h₁ hψ₀ hh₀ m hT.le
  exact (secant_slope_le hvp hT h0 hT').trans (le_of_eq (stopping_arith hvp hT))

end PlaneWaveKinetic

