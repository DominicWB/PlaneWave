theorem isOpenQuotientMap_torusRealQuotient (d : Type*) [Fintype d] :
    IsOpenQuotientMap (torusRealQuotient d) := by
  exact IsOpenQuotientMap.piMap (fun _ : d =>
    (QuotientAddGroup.isOpenQuotientMap_mk :
      IsOpenQuotientMap (fun t : ℝ => (t : UnitAddCircle))))

/-- Every point of the torus has a real representative. -/
theorem torusRealQuotient_surjective (d : Type*) [Fintype d] :
    Function.Surjective (torusRealQuotient d) :=
  (isOpenQuotientMap_torusRealQuotient d).surjective

