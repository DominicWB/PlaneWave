local instance unitAddCircleMeasureSpaceForNormalised : MeasureSpace UnitAddCircle :=
  instMeasureSpaceUnitAddCircle

/-! ## Normalisation -/

section Generic

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- Normalising a state of norm `c ∈ (0, 1]` changes the expectation of a contraction by at most
`1 - c²`. -/
lemma norm_inner_normalize_sub_le (O : E →L[ℂ] E) (hO : ‖O‖ ≤ 1) (f : E) {c : ℝ} (hc : ‖f‖ = c)
    (hc0 : 0 < c) (hc1 : c ≤ 1) :
    ‖⟪((c : ℂ)⁻¹) • f, O (((c : ℂ)⁻¹) • f)⟫_ℂ - ⟪f, O f⟫_ℂ‖ ≤ 1 - c ^ 2 := by
  have e : ⟪((c : ℂ)⁻¹) • f, O (((c : ℂ)⁻¹) • f)⟫_ℂ - ⟪f, O f⟫_ℂ =
      (((c ^ 2)⁻¹ - 1 : ℝ) : ℂ) * ⟪f, O f⟫_ℂ := by
    rw [map_smul, inner_smul_left, inner_smul_right, map_inv₀, Complex.conj_ofReal]
    push_cast
    ring
  rw [e, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have hinner : ‖⟪f, O f⟫_ℂ‖ ≤ c ^ 2 := by
    calc ‖⟪f, O f⟫_ℂ‖ ≤ ‖f‖ * ‖O f‖ := norm_inner_le_norm _ _
      _ ≤ ‖f‖ * (‖O‖ * ‖f‖) := mul_le_mul_of_nonneg_left (O.le_opNorm f) (norm_nonneg _)
      _ ≤ ‖f‖ * (1 * ‖f‖) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hO (norm_nonneg _)) (norm_nonneg _)
      _ = c ^ 2 := by rw [hc]; ring
  have hc2 : c ^ 2 ≤ 1 := by nlinarith
  have hpos : 0 ≤ (c ^ 2)⁻¹ - 1 := by
    rw [sub_nonneg, one_le_inv₀ (pow_pos hc0 2)]
    exact hc2
  rw [abs_of_nonneg hpos]
  calc ((c ^ 2)⁻¹ - 1) * ‖⟪f, O f⟫_ℂ‖ ≤ ((c ^ 2)⁻¹ - 1) * c ^ 2 :=
        mul_le_mul_of_nonneg_left hinner hpos
    _ = 1 - c ^ 2 := by
        have : c ^ 2 ≠ 0 := (pow_pos hc0 2).ne'
        field_simp

end Generic

variable {eta : ℕ}

/-- `‖x‖² = ‖P x‖² + ‖(1 - P) x‖²`. -/
lemma norm_sq_truncate_add (n : ℕ) (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖x‖ ^ 2 = ‖molecularH2Truncate n x‖ ^ 2 + ‖x - molecularH2Truncate n x‖ ^ 2 := by
  have h0 : ⟪molecularH2Truncate n x, x - molecularH2Truncate n x⟫_ℂ = 0 := by
    rw [← inner_conj_symm, inner_sub_truncate_truncate, map_zero]
  have h := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ h0
  rw [add_sub_cancel] at h
  rw [sq, sq, sq, h]

lemma norm_extract_eq (n : ℕ) (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖extractCLM n x‖ = ‖molecularH2Truncate n x‖ := by
  rw [← (finiteFourierLpIsometry eta n).norm_map, emb_extractCLM]

/-! ## The tail of the initial state -/

lemma tail_arith {e m Ξ₁ c0 ρ K B tK : ℝ} (he : 0 ≤ e) (hm : 1 ≤ m) (hΞ₁ : 0 ≤ Ξ₁)
    (hρ : 0 ≤ ρ) (hρK : ρ ^ 2 * K = 1) (hK : 2 ≤ K)
    (hB : B = (2 * m / K ^ 2) * Ξ₁ + c0 * ρ) (htK : tK = (2 * m / K ^ 2) * B) :
    e * tK ≤ e * (2 * m * (2 * m * Ξ₁ + c0)) * ρ ^ 5 := by
  have hρ2 : ρ ^ 2 ≤ 1 := by nlinarith only [hρK, hK, sq_nonneg ρ]
  have hρ1 : ρ ≤ 1 := by nlinarith only [hρ2, hρ]
  have hKpos : 0 < K := by linarith
  have hK4 : K ^ 2 * ρ ^ 4 = 1 := by
    calc K ^ 2 * ρ ^ 4 = (ρ ^ 2 * K) ^ 2 := by ring
      _ = 1 := by rw [hρK]; norm_num
  have hinv : 2 * m / K ^ 2 = 2 * m * ρ ^ 4 := by
    rw [div_eq_iff (pow_pos hKpos 2).ne']
    linear_combination (-(2 * m)) * hK4
  have hρ4 : ρ ^ 4 ≤ ρ := by
    calc ρ ^ 4 = ρ * ρ ^ 3 := by ring
      _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ hρ1) hρ
      _ = ρ := mul_one _
  have hB' : B ≤ (2 * m * Ξ₁ + c0) * ρ := by
    rw [hB, hinv]
    have := mul_le_mul_of_nonneg_left hρ4 (mul_nonneg (by linarith : (0:ℝ) ≤ 2 * m) hΞ₁)
    linarith only [this]
  have htK1 : tK ≤ 2 * m * (2 * m * Ξ₁ + c0) * ρ ^ 5 := by
    rw [htK, hinv]
    calc 2 * m * ρ ^ 4 * B ≤ 2 * m * ρ ^ 4 * ((2 * m * Ξ₁ + c0) * ρ) :=
          mul_le_mul_of_nonneg_left hB' (by positivity)
      _ = 2 * m * (2 * m * Ξ₁ + c0) * ρ ^ 5 := by ring
  calc e * tK ≤ e * (2 * m * (2 * m * Ξ₁ + c0) * ρ ^ 5) := mul_le_mul_of_nonneg_left htK1 he
    _ = e * (2 * m * (2 * m * Ξ₁ + c0)) * ρ ^ 5 := by ring

section Coulomb

variable {ν : Type} [Fintype ν]

/-- The constant `δ₁` of `obsRateBound`: `‖(1 - P) ψ₀‖ ≤ δ₁ K^{-5/2}` (`initial_tail_le`; the
proof of `coulomb_observable_rate` gives the same bound for `ψ(s)` at every time `s`). -/
def obsTailConst (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker s0 hu hs hv : ℝ) : ℝ :=
  eta * (2 * sys.maxMass * (2 * sys.maxMass * (2 * hv + 2 * relB sys L Hunit * hs) +
    finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
      (sys.maxMass * (s0 + 2 * (2 * hu + 2 * relB sys L Hunit * s0)))))

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **The never-projected tail of `ψ₀ ∈ D(H²)`** (`eq:dyn-t` at `t = 0`):
`‖(1 - P) S u₀‖ ≤ δ₁ K^{-5/2}`. -/
theorem initial_tail_le (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (n : ℕ)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀) :
    ‖molecularH2StateMap eta (2 * Real.pi / L) u₀ -
        molecularH2Truncate n (molecularH2StateMap eta (2 * Real.pi / L) u₀)‖ ≤
      obsTailConst sys L Hunit Blow Cs Bker ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ ‖H u₀‖
        ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ ‖H v₀‖ * rho ^ 5 := by
  have hM := sys.one_le_maxMass
  have hb := relB_nonneg sys L Hunit hC
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hK1 : 1 ≤ (2 * Real.pi / L) * n := by linarith
  set U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 := fun _ => LinearIsometryEquiv.refl ℂ _
  have hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u) :=
    fun t u => ⟨u, rfl, rfl⟩
  have htails := fun a => tails_at_time sys L H hKernel Hunit hL hPeriodic hC U hgraph a
    ((2 * Real.pi / L) * n) rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
    hBkerScale hCsScale u₀ v₀ huv 0 u₀ rfl rfl
  set Ξ₁ := 2 * ‖H v₀‖ + 2 * relB sys L Hunit * ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖
  set c0 := finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
    (sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ +
      2 * (2 * ‖H u₀‖ + 2 * relB sys L Hunit * ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖)))
  set K := (2 * Real.pi / L) * n
  set B := (2 * sys.maxMass / K ^ 2) * Ξ₁ + c0 * rho
  set tK := (2 * sys.maxMass / K ^ 2) * B
  have hsum : ‖molecularH2StateMap eta (2 * Real.pi / L) u₀ -
      molecularH2Truncate n (molecularH2StateMap eta (2 * Real.pi / L) u₀)‖ ≤ eta * tK := by
    refine (norm_sub_truncate_le hg n _).trans ?_
    calc ∑ a : Fin eta, ‖tailMask (2 * Real.pi / L) ((2 * Real.pi / L) * n) a
          (molecularH2StateMap eta (2 * Real.pi / L) u₀)‖
        ≤ ∑ _a : Fin eta, tK := Finset.sum_le_sum fun a _ => (htails a).2
      _ = eta * tK := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hΞ₁ : 0 ≤ Ξ₁ := add_nonneg (mul_nonneg zero_le_two (norm_nonneg _))
    (mul_nonneg (mul_nonneg zero_le_two hb) (norm_nonneg _))
  exact hsum.trans (tail_arith (Nat.cast_nonneg eta) hM hΞ₁ hRho hRhoScale hK2 rfl rfl)

end Coulomb

/-! ## The normalised Galerkin state in position space -/

section Normalised

variable {ν : Type} [Fintype ν]

/-- **Normalised Galerkin state** (`cor:norm`). Under the hypotheses of
`coulomb_observable_position`, with `‖ψ₀‖ = 1`, `|χ| ≤ 1` and `P ψ₀ ≠ 0`, the normalised Galerkin
state `ψ̃_N(t) = ψ_N(t)/‖P ψ₀‖` satisfies the same bound up to `‖(1 - P) ψ₀‖² ≤ δ₁² K^{-5}`. -/
theorem coulomb_observable_normalised (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h4g : 4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁) (hnorm : ‖ψ₀‖ = 1)
    (hP : molecularH2Truncate n ((physMap eta).symm ψ₀) ≠ 0)
    (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ))
    (hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖)
    (hreal : ∀ y, conj (χ y) = χ y) (hχ1 : ∀ y, ‖χ y‖ ≤ 1) {t : ℝ} (ht : 0 ≤ t) :
    let c : ℝ := ‖molecularH2Truncate n ((physMap eta).symm ψ₀)‖
    let ψN := physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n ((physMap eta).symm ψ₀))))
    let ψNt := ((c : ℂ)⁻¹) • ψN
    let δ₁ := obsTailConst sys L molecularCanonicalUnitHardyConstant Blow Cs Bker
        ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖
    ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψNt, mulCLM (regFun a χ) ψNt⟫_ℂ‖ ≤
      obsRateBound sys L molecularCanonicalUnitHardyConstant Blow Cs Bker rho n a
        (UnitAddTorus.mFourierCoeff χ) ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖ t + (δ₁ * rho ^ 5) ^ 2 := by
  intro c ψN ψNt δ₁
  have hmain := coulomb_observable_position sys L hL U hU0 hUgraph hUderiv n UN hN0 hNadd hNcomm
    hNderiv rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h4g hAmplitude hBkerScale hCsScale
    ψ₀ h₀ h₁ hψ₀ hh₀ a χ hχ2 hreal ht
  -- the normalisation
  set x₀ := (physMap eta).symm ψ₀
  have hc : ‖ψN‖ = c := by
    simp only [ψN]
    rw [LinearIsometryEquiv.norm_map, LinearIsometry.norm_map, LinearIsometryEquiv.norm_map,
      norm_extract_eq]
  have hc0 : 0 < c := norm_pos_iff.mpr hP
  have hx₀ : ‖x₀‖ = 1 := by rw [LinearIsometryEquiv.norm_map]; exact hnorm
  have hc1 : c ≤ 1 := by
    rw [← hx₀]
    exact molecularH2Truncate_norm_le n x₀
  have hM1 : ‖mulCLM (regFun a χ)‖ ≤ 1 :=
    (norm_mulCLM_le _).trans ((norm_regFun_le a χ).trans
      ((ContinuousMap.norm_le _ zero_le_one).mpr hχ1))
  have hnormal := norm_inner_normalize_sub_le (mulCLM (regFun a χ)) hM1 ψN hc hc0 hc1
  have hpyth : 1 - c ^ 2 = ‖x₀ - molecularH2Truncate n x₀‖ ^ 2 := by
    have := norm_sq_truncate_add n x₀
    rw [hx₀] at this
    linarith
  -- the tail of the initial state
  have hPeriodic := canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨H, hKernel, -⟩ := exists_coulombFourierH2Operator sys L
      molecularCanonicalUnitHardyConstant
    hL hPeriodic
  have hiff := hasCoulombHamiltonian_iff_phys sys L hL H hKernel
  obtain ⟨u₀, hu₀1, hu₀2⟩ := (hiff ψ₀ h₀).mp hψ₀
  obtain ⟨v₀, hv₀1, hv₀2⟩ := (hiff h₀ h₁).mp hh₀
  have huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀ :=
    (physMap eta).injective (hu₀2.trans hv₀1.symm)
  have htail := initial_tail_le sys L H hKernel molecularCanonicalUnitHardyConstant hL hPeriodic
    (finiteCoulombPhysicalMassConstant_nonneg _ _ _) n rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs
    hBker (by linarith [show 0 < 2 * Real.pi / L by positivity]) hAmplitude hBkerScale hCsScale
    u₀ v₀ huv
  have hx₀u : x₀ = molecularH2StateMap eta (2 * Real.pi / L) u₀ := by
    simp only [x₀]
    rw [← hu₀1, LinearIsometryEquiv.symm_apply_apply]
  have e1 : ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ = ‖ψ₀‖ := by
    rw [← hu₀1, LinearIsometryEquiv.norm_map]
  have e2 : ‖H u₀‖ = ‖h₀‖ := by rw [← hu₀2, LinearIsometryEquiv.norm_map]
  have e3 : ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ = ‖h₀‖ := by
    rw [← hv₀1, LinearIsometryEquiv.norm_map]
  have e4 : ‖H v₀‖ = ‖h₁‖ := by rw [← hv₀2, LinearIsometryEquiv.norm_map]
  rw [e1, e2, e3, e4, ← hx₀u] at htail
  have htail2 : ‖x₀ - molecularH2Truncate n x₀‖ ^ 2 ≤ (δ₁ * rho ^ 5) ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) htail 2
  -- combine
  have htri := norm_sub_le_norm_sub_add_norm_sub
    ⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ
    ⟪ψNt, mulCLM (regFun a χ) ψNt⟫_ℂ
  have hswap : ‖⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ - ⟪ψNt, mulCLM (regFun a χ) ψNt⟫_ℂ‖ =
      ‖⟪ψNt, mulCLM (regFun a χ) ψNt⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ := norm_sub_rev _ _
  have hmain' : ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
      obsRateBound sys L molecularCanonicalUnitHardyConstant Blow Cs Bker rho n a
        (UnitAddTorus.mFourierCoeff χ) ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖ t := hmain
  have hnormal' : ‖⟪ψNt, mulCLM (regFun a χ) ψNt⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
      1 - c ^ 2 := hnormal
  linarith

end Normalised

/-! ## The constants of `χ`: `(Hχ)` and `D_χ` -/

section Constants

/-- The sup norm `‖ν‖∞` of a lattice vector. -/
def latticeSupNorm (ν : Lattice3) : ℝ := max
    (max |((ν 0 : ℤ) : ℝ)| |((ν 1 : ℤ) : ℝ)|) |((ν 2 : ℤ) : ℝ)|

lemma latticeSupNorm_nonneg (ν : Lattice3) : 0 ≤ latticeSupNorm ν :=
  le_max_of_le_right (abs_nonneg _)

lemma sqrt_latticeNormSq_le_sup (ν : Lattice3) :
    Real.sqrt (latticeNormSq ν) ≤ Real.sqrt 3 * latticeSupNorm ν := by
  have hs := latticeSupNorm_nonneg ν
