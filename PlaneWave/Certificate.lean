        ((z + w : S) : MolecularFourierH2 eta) := by
      change molecularH2Truncate N
        ((z : MolecularFourierH2 eta) + (w : MolecularFourierH2 eta)) =
          (z : MolecularFourierH2 eta) + (w : MolecularFourierH2 eta)
