/-! ### Coordinate geometry and the actual cubic retained subspace -/

/-- Every squared lattice coordinate is at most the squared Euclidean norm. -/
lemma lattice_coordinate_sq_le_latticeNormSq
    (nu : Lattice3) (d : Fin 3) :
    (nu d : ℝ) ^ 2 ≤ latticeNormSq nu := by
  rw [← sum_lattice_coordinate_sq]
  exact Finset.single_le_sum
    (fun k hk => sq_nonneg (nu k : ℝ)) (Finset.mem_univ d)

/-- Physical coordinate magnitude is dominated by the existing radial momentum. -/
lemma finitePlaneWave_coordinate_abs_le_kabs
    (g : ℝ) (count : ℕ) (hg : 0 ≤ g)
    (v : FinitePlaneWaveMode count) (d : Fin 3) :
    |g * (finitePlaneWaveLatticeIndex count v d : ℝ)| ≤
      finitePlaneWaveKabs g count v := by
  have hSq : |g * (finitePlaneWaveLatticeIndex count v d : ℝ)| ^ 2 ≤
      (finitePlaneWaveKabs g count v) ^ 2 := by
    rw [sq_abs, mul_pow, finitePlaneWaveKabs_sq_eq_g_sq_mul_latticeNormSq]
    exact mul_le_mul_of_nonneg_left
      (lattice_coordinate_sq_le_latticeNormSq (finitePlaneWaveLatticeIndex count v) d)
      (sq_nonneg g)
  have hRadial := finitePlaneWaveKabs_nonneg g count hg v
  have hAbs := abs_nonneg (g * (finitePlaneWaveLatticeIndex count v d : ℝ))
  nlinarith only [hSq, hRadial, hAbs]

/-- The exact cube in the current ambient one-particle mode set.  Coordinate
boundary points are retained, and no radial cutoff occurs in this definition. -/
noncomputable def finiteCubicPlaneWaveModes
    (K g : ℝ) (count : ℕ) : Finset (FinitePlaneWaveMode count) := by
  classical
  exact Finset.univ.filter (fun v =>
    ∀ d : Fin 3, |g * (finitePlaneWaveLatticeIndex count v d : ℝ)| ≤ K)

lemma mem_finiteCubicPlaneWaveModes_iff
    (K g : ℝ) (count : ℕ) (v : FinitePlaneWaveMode count) :
    v ∈ finiteCubicPlaneWaveModes K g count ↔
      ∀ d : Fin 3, |g * (finitePlaneWaveLatticeIndex count v d : ℝ)| ≤ K := by
  classical
  simp only [finiteCubicPlaneWaveModes, Finset.mem_filter, Finset.mem_univ, true_and]

/-- A many-electron coefficient vector is supported on the tensor-product cube.
A coefficient must vanish if ANY coordinate of ANY electron lies outside it. -/
def IsCubicRetainedVector
    (eta : ℕ) (K g : ℝ) (count : ℕ)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) : Prop :=
  ∀ p : FourierConfig eta (FinitePlaneWaveMode count),
    (∃ i : Fin eta, ∃ d : Fin 3,
      K < |g * (finitePlaneWaveLatticeIndex count (p i) d : ℝ)|) → u.ofLp p = 0

/-- The coordinate-support predicate is exactly support on the cube mode set. -/
lemma isCubicRetainedVector_iff_mode_support
    (eta : ℕ) (K g : ℝ) (count : ℕ)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count))) :
    IsCubicRetainedVector eta K g count u ↔
      ∀ p : FourierConfig eta (FinitePlaneWaveMode count), u.ofLp p ≠ 0 →
        ∀ i : Fin eta, p i ∈ finiteCubicPlaneWaveModes K g count := by
  classical
  constructor
  · intro h p hp i
    apply (mem_finiteCubicPlaneWaveModes_iff K g count (p i)).mpr
    intro d
    by_contra hNot
    exact hp (h p ⟨i, d, lt_of_not_ge hNot⟩)
  · intro h p hOut
    by_contra hp
    rcases hOut with ⟨i, d, hd⟩
    have hInside := (mem_finiteCubicPlaneWaveModes_iff K g count (p i)).mp (h p hp i)
    exact (not_lt_of_ge (hInside d)) hd

/-- The radial retained subspace is contained in the cubic retained subspace
at the same physical threshold.  No assumption about a radial Ritz minimum. -/
lemma radial_retained_isCubicRetained
    (eta : ℕ) (K g : ℝ) (count : ℕ) (hg : 0 ≤ g)
    (u : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode count)))
    (hRetained : IsRetainedVector eta K (finitePlaneWaveKabs g count) u) :
    IsCubicRetainedVector eta K g count u := by
  classical
  intro p hOut
  rcases hOut with ⟨i, d, hd⟩
  apply hRetained p
  have hRadial : K < finitePlaneWaveKabs g count (p i) :=
    hd.trans_le (finitePlaneWave_coordinate_abs_le_kabs g count hg (p i) d)
  simp only [discardedConfigFinset, Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨i, hRadial⟩

lemma retainedGalerkinVector_isCubicRetained
    (eta : ℕ) (K g : ℝ) (count : ℕ) (hg : 0 ≤ g)
    (coeff : FourierConfig eta (FinitePlaneWaveMode count) → ℂ) :
    IsCubicRetainedVector eta K g count
      (retainedGalerkinVector K (finitePlaneWaveKabs g count) coeff) := by
  exact radial_retained_isCubicRetained eta K g count hg _
    (retainedGalerkinVector_isRetained eta K (finitePlaneWaveKabs g count) coeff)

/-! ### Exact lattice-box cardinality and inclusion in the finite ambient basis -/

/-- Three independent integer coordinates, each with exactly 2*m+1 choices. -/
abbrev CubicPlaneWaveOrdinal (m : ℕ) := Fin 3 → Fin (2 * m + 1)

def cubicPlaneWaveOrdinalIndex (m : ℕ) (p : CubicPlaneWaveOrdinal m) : Lattice3 :=
  fun d => ((p d).val : ℤ) - (m : ℤ)

lemma cubicPlaneWaveOrdinalIndex_bounds
    (m : ℕ) (p : CubicPlaneWaveOrdinal m) (d : Fin 3) :
    -(m : ℤ) ≤ cubicPlaneWaveOrdinalIndex m p d ∧
      cubicPlaneWaveOrdinalIndex m p d ≤ (m : ℤ) := by
  have hd := (p d).isLt
  unfold cubicPlaneWaveOrdinalIndex
  constructor <;> omega

lemma cubicPlaneWaveOrdinalIndex_injective (m : ℕ) :
    Function.Injective (cubicPlaneWaveOrdinalIndex m) := by
  intro p q hpq
  funext d
  apply Fin.ext
  have hd := congrFun hpq d
  change ((p d).val : ℤ) - (m : ℤ) = ((q d).val : ℤ) - (m : ℤ) at hd
  omega

lemma exists_cubicPlaneWaveOrdinal_of_bounds
    (m : ℕ) (nu : Lattice3)
    (hBounds : ∀ d : Fin 3, -(m : ℤ) ≤ nu d ∧ nu d ≤ (m : ℤ)) :
    ∃ p : CubicPlaneWaveOrdinal m, cubicPlaneWaveOrdinalIndex m p = nu := by
  let p : CubicPlaneWaveOrdinal m := fun d =>
    ⟨(nu d + (m : ℤ)).toNat, by
      have hd := hBounds d
      omega⟩
  refine ⟨p, ?_⟩
  funext d
  have hd := hBounds d
  change (((nu d + (m : ℤ)).toNat : ℤ) - (m : ℤ)) = nu d
  omega

/-- The COMPLETE integer cube [-m,m]^3, independently of the ambient horizon. -/
noncomputable def cubicPlaneWaveBox (m : ℕ) : Finset Lattice3 := by
  classical
  exact Finset.univ.image (cubicPlaneWaveOrdinalIndex m)

lemma mem_cubicPlaneWaveBox_iff (m : ℕ) (nu : Lattice3) :
    nu ∈ cubicPlaneWaveBox m ↔
      ∀ d : Fin 3, -(m : ℤ) ≤ nu d ∧ nu d ≤ (m : ℤ) := by
  classical
  constructor
  · intro h
    rcases Finset.mem_image.mp h with ⟨p, hp, rfl⟩
    exact cubicPlaneWaveOrdinalIndex_bounds m p
  · intro h
    rcases exists_cubicPlaneWaveOrdinal_of_bounds m nu h with ⟨p, hp⟩
    exact Finset.mem_image.mpr ⟨p, Finset.mem_univ p, hp⟩

lemma cubicPlaneWaveBox_card (m : ℕ) :
    (cubicPlaneWaveBox m).card = (2 * m + 1) ^ 3 := by
  classical
  unfold cubicPlaneWaveBox
  rw [Finset.card_image_of_injective _ (cubicPlaneWaveOrdinalIndex_injective m)]
  change Fintype.card (CubicPlaneWaveOrdinal m) = (2 * m + 1) ^ 3
  simp [CubicPlaneWaveOrdinal]

/-- All lattice points within the shell horizon occur in the existing mode type.
The zero point uses `none`; nonzero points use their established cubic shell. -/
lemma exists_finitePlaneWaveMode_of_coord_bounds
    (count : ℕ) (nu : Lattice3)
    (hBounds : ∀ d : Fin 3, -(count : ℤ) ≤ nu d ∧ nu d ≤ (count : ℤ)) :
    ∃ v : FinitePlaneWaveMode count, finitePlaneWaveLatticeIndex count v = nu := by
  classical
  by_cases hZero : nu = (fun _ => 0)
  · refine ⟨none, ?_⟩
    rw [finitePlaneWaveLatticeIndex_none]
    exact hZero.symm
  · rcases exists_cubicSupShell_of_nonzero_coord_bounds count nu hZero hBounds with
      ⟨n, hn, hnu⟩
    let shell : FiniteShellIndex count := ⟨n, Finset.mem_range.mpr hn⟩
    let point : ↥(cubicSupShell (shell : ℕ)) := ⟨nu, hnu⟩
    exact ⟨some ⟨shell, point⟩, rfl⟩

/-- Exact conversion of a physical coordinate cutoff K=g*m to integer bounds. -/
lemma scaled_integer_coordinate_le_iff
    (g : ℝ) (hg : 0 < g) (m : ℕ) (z : ℤ) :
    |g * (z : ℝ)| ≤ g * (m : ℝ) ↔ -(m : ℤ) ≤ z ∧ z ≤ (m : ℤ) := by
  rw [abs_mul, abs_of_pos hg, mul_le_mul_iff_right₀ hg, abs_le]
  constructor
  · rintro ⟨hLo, hHi⟩
    exact ⟨by exact_mod_cast hLo, by exact_mod_cast hHi⟩
  · rintro ⟨hLo, hHi⟩
    exact ⟨by exact_mod_cast hLo, by exact_mod_cast hHi⟩

lemma mem_finiteCubicPlaneWaveModes_at_integer_cutoff
    (g : ℝ) (hg : 0 < g) (m count : ℕ) (v : FinitePlaneWaveMode count) :
    v ∈ finiteCubicPlaneWaveModes (g * (m : ℝ)) g count ↔
      finitePlaneWaveLatticeIndex count v ∈ cubicPlaneWaveBox m := by
  rw [mem_finiteCubicPlaneWaveModes_iff, mem_cubicPlaneWaveBox_iff]
  constructor
  · intro h d
    exact (scaled_integer_coordinate_le_iff g hg m _).mp (h d)
  · intro h d
    exact (scaled_integer_coordinate_le_iff g hg m _).mpr (h d)

/-- The selected ambient modes map onto the ENTIRE manuscript cube once the
ambient shell horizon contains it.  This is not merely a cardinal upper bound. -/
lemma finiteCubicPlaneWaveModes_image_eq_box
    (g : ℝ) (hg : 0 < g) (m count : ℕ) (hFits : m ≤ count) :
    (finiteCubicPlaneWaveModes (g * (m : ℝ)) g count).image
      (finitePlaneWaveLatticeIndex count) = cubicPlaneWaveBox m := by
  classical
  ext nu
  constructor
  · intro h
    rcases Finset.mem_image.mp h with ⟨v, hv, rfl⟩
    exact (mem_finiteCubicPlaneWaveModes_at_integer_cutoff g hg m count v).mp hv
  · intro hnu
    have hBounds := (mem_cubicPlaneWaveBox_iff m nu).mp hnu
    have hCountBounds : ∀ d : Fin 3, -(count : ℤ) ≤ nu d ∧ nu d ≤ (count : ℤ) := by
      intro d
      have hd := hBounds d
      omega
    rcases exists_finitePlaneWaveMode_of_coord_bounds count nu hCountBounds with ⟨v, hv⟩
    refine Finset.mem_image.mpr ⟨v, ?_, hv⟩
    apply (mem_finiteCubicPlaneWaveModes_at_integer_cutoff g hg m count v).mpr
    rw [hv]
    exact hnu

/-- The actual retained one-particle count is (2*m+1)^3, including the zero mode.
The containment hypothesis is necessary: a smaller ambient space clips the cube. -/
lemma finiteCubicPlaneWaveModes_card
    (g : ℝ) (hg : 0 < g) (m count : ℕ) (hFits : m ≤ count) :
    (finiteCubicPlaneWaveModes (g * (m : ℝ)) g count).card = (2 * m + 1) ^ 3 := by
  classical
  calc
    (finiteCubicPlaneWaveModes (g * (m : ℝ)) g count).card =
        ((finiteCubicPlaneWaveModes (g * (m : ℝ)) g count).image
          (finitePlaneWaveLatticeIndex count)).card :=
      (Finset.card_image_of_injective _ (finitePlaneWaveLatticeIndex_injective count)).symm
    _ = (cubicPlaneWaveBox m).card :=
      congrArg Finset.card (finiteCubicPlaneWaveModes_image_eq_box g hg m count hFits)
    _ = (2 * m + 1) ^ 3 := cubicPlaneWaveBox_card m

