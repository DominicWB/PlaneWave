/-- Absolute Fourier coefficient budget for the explicit regular correction. -/
def quadraticCoulombCorrectionBudget (R : ℝ) : ℝ :=
  Real.pi ^ 2 * R ^ 2 / 3 + 108 / (Real.pi ^ 2 * R ^ 2)

@[simp] lemma quadraticCoulombCorrectionCoeff_zero (R : ℝ) :
    quadraticCoulombCorrectionCoeff R 0 = -((Real.pi ^ 2 * R ^ 2 / 3 : ℝ) : ℂ) := by
  classical
  simp [quadraticCoulombCorrectionCoeff]

/-- The oscillatory factor lies between zero and one, so the nonzero
correction coefficients have inverse-fourth lattice decay. -/
lemma quadraticCoulombCorrectionCoeff_norm_le_nonzero (R : ℝ)
    (n : Lattice3) (hn : n ≠ 0) :
    ‖quadraticCoulombCorrectionCoeff R n‖ ≤
      (1 / (Real.pi ^ 2 * R ^ 2)) * ‖unitLatticeCoulombKernel n‖ ^ 2 := by
  classical
  let t := 2 * Real.pi * R * Real.sqrt (latticeNormSq n)
  have ha : 0 ≤ (1 - Real.cos t) / 2 := by
    have hc := Real.cos_le_one t
    linarith
  have ha1 : (1 - Real.cos t) / 2 ≤ 1 := by
    have hc := Real.neg_one_le_cos t
    linarith
  have hC : 0 ≤ 1 / (Real.pi ^ 2 * R ^ 2) := by positivity
  have hw : 0 ≤ latticeCoulombSquareWeight 1 n :=
    latticeCoulombSquareWeight_nonneg 1 (by norm_num) n
  have hProduct : 0 ≤ ((1 - Real.cos t) / 2) *
      (1 / (Real.pi ^ 2 * R ^ 2)) * latticeCoulombSquareWeight 1 n :=
    mul_nonneg (mul_nonneg ha hC) hw
  rw [quadraticCoulombCorrectionCoeff, if_neg hn]
  change ‖((((1 - Real.cos t) / 2) * (1 / (Real.pi ^ 2 * R ^ 2)) *
    latticeCoulombSquareWeight 1 n : ℝ) : ℂ)‖ ≤ _
  rw [Complex.norm_of_nonneg hProduct, unitLatticeCoulombKernel_norm_sq]
  calc
    ((1 - Real.cos t) / 2) * (1 / (Real.pi ^ 2 * R ^ 2)) *
        latticeCoulombSquareWeight 1 n ≤
      (1 * (1 / (Real.pi ^ 2 * R ^ 2))) * latticeCoulombSquareWeight 1 n :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right ha1 hC) hw
    _ = _ := by rw [one_mul]

lemma quadraticCoulombCorrectionCoeff_norm_le (R : ℝ) (n : Lattice3) :
    ‖quadraticCoulombCorrectionCoeff R n‖ ≤
      (if n = 0 then Real.pi ^ 2 * R ^ 2 / 3 else 0) +
        (1 / (Real.pi ^ 2 * R ^ 2)) * ‖unitLatticeCoulombKernel n‖ ^ 2 := by
  classical
  by_cases hn : n = 0
  · subst n
    have hB : 0 ≤ Real.pi ^ 2 * R ^ 2 / 3 := by positivity
    rw [quadraticCoulombCorrectionCoeff_zero, norm_neg,
      Complex.norm_of_nonneg hB, if_pos rfl]
    exact le_add_of_nonneg_right (by positivity)
  · rw [if_neg hn, zero_add]
    exact quadraticCoulombCorrectionCoeff_norm_le_nonzero R n hn

/-- The existing discrete Coulomb square-mass estimate controls every finite
partial sum of the new regular correction, including its zero mode. -/
theorem quadraticCoulombCorrectionCoeff_sum_norm_le (R : ℝ) (s : Finset Lattice3) :
    (∑ n ∈ s, ‖quadraticCoulombCorrectionCoeff R n‖) ≤
      quadraticCoulombCorrectionBudget R := by
  classical
  have hB : 0 ≤ Real.pi ^ 2 * R ^ 2 / 3 := by positivity
  have hC : 0 ≤ 1 / (Real.pi ^ 2 * R ^ 2) := by positivity
  have hZero :
      (∑ n ∈ s, if n = 0 then Real.pi ^ 2 * R ^ 2 / 3 else 0) ≤
        Real.pi ^ 2 * R ^ 2 / 3 := by
    by_cases hz : (0 : Lattice3) ∈ s
    · simp [hz]
    · simp [hz, hB]
  calc
    (∑ n ∈ s, ‖quadraticCoulombCorrectionCoeff R n‖) ≤
        ∑ n ∈ s, ((if n = 0 then Real.pi ^ 2 * R ^ 2 / 3 else 0) +
          (1 / (Real.pi ^ 2 * R ^ 2)) * ‖unitLatticeCoulombKernel n‖ ^ 2) :=
      Finset.sum_le_sum (fun n _ => quadraticCoulombCorrectionCoeff_norm_le R n)
    _ = (∑ n ∈ s, if n = 0 then Real.pi ^ 2 * R ^ 2 / 3 else 0) +
        (1 / (Real.pi ^ 2 * R ^ 2)) * (∑ n ∈ s, ‖unitLatticeCoulombKernel n‖ ^ 2) := by
      rw [Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ Real.pi ^ 2 * R ^ 2 / 3 + (1 / (Real.pi ^ 2 * R ^ 2)) * 108 :=
      add_le_add hZero (mul_le_mul_of_nonneg_left
        (finite_unitLatticeCoulombKernel_norm_sq_sum_le_108 s) hC)
    _ = quadraticCoulombCorrectionBudget R := by
      unfold quadraticCoulombCorrectionBudget
      ring

/-- Absolute summability is proved from the lattice estimate, not assumed. -/
theorem quadraticCoulombCorrectionCoeff_summable_norm (R : ℝ) :
    Summable (fun n => ‖quadraticCoulombCorrectionCoeff R n‖) := by
  exact summable_of_sum_le (fun n => norm_nonneg _)
    (quadraticCoulombCorrectionCoeff_sum_norm_le R)

theorem quadraticCoulombCorrectionCoeff_tsum_norm_le (R : ℝ) :
    (∑' n, ‖quadraticCoulombCorrectionCoeff R n‖) ≤
      quadraticCoulombCorrectionBudget R := by
  exact Real.tsum_le_of_sum_le (fun n => norm_nonneg _)
    (quadraticCoulombCorrectionCoeff_sum_norm_le R)

/-- A convenient fixed localization radius for the eventual canonical bound. -/
lemma quadraticCoulombCorrectionBudget_quarter :
    quadraticCoulombCorrectionBudget (1 / 4 : ℝ) =
      Real.pi ^ 2 / 48 + 1728 / Real.pi ^ 2 := by
  unfold quadraticCoulombCorrectionBudget
  ring

end
end PlaneWaveCertificate

