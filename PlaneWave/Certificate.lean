/-- Coordinate truncation in square-summable complex coefficient space. -/
def lpTruncate {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (u : lp (fun _ : ι => ℂ) 2) : lp (fun _ : ι => ℂ) 2 :=
  ∑ i ∈ s, lp.single 2 i (u i)

/-- The finite sum truncation keeps exactly the coordinates belonging to `s`. -/
@[simp] theorem lpTruncate_apply {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (u : lp (fun _ : ι => ℂ) 2) (i : ι) :
    lpTruncate s u i = if i ∈ s then u i else 0 := by
  rw [lpTruncate, lp.coeFn_sum, Finset.sum_apply]
  by_cases hi : i ∈ s
  · rw [if_pos hi]
    calc
      (∑ j ∈ s, (lp.single 2 j (u j) : lp (fun _ : ι => ℂ) 2) i) =
          (lp.single 2 i (u i) : lp (fun _ : ι => ℂ) 2) i := by
        apply Finset.sum_eq_single i
        · intro j _ hji
          exact lp.single_apply_ne (E := fun _ : ι => ℂ) 2 j (u j) hji.symm
        · intro hi'
          exact (hi' hi).elim
      _ = u i := lp.single_apply_self (E := fun _ : ι => ℂ) 2 i (u i)
  · rw [if_neg hi]
    apply Finset.sum_eq_zero
    intro j hj
    apply lp.single_apply_ne (E := fun _ : ι => ℂ) 2 j (u j)
    intro hij
    apply hi
    simpa only [hij] using hj

/-- Discarding coordinates cannot increase the square-summable norm. -/
theorem lpTruncate_norm_le {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (u : lp (fun _ : ι => ℂ) 2) :
    ‖lpTruncate s u‖ ≤ ‖u‖ := by
  apply lp.norm_mono (by norm_num : (2 : ENNReal) ≠ 0)
  intro i
  by_cases hi : i ∈ s
  · simp only [lpTruncate_apply, if_pos hi, le_refl]
  · simp only [lpTruncate_apply, if_neg hi, norm_zero]
    exact norm_nonneg (u i)

/-- The truncation norm is exactly the finite sum of coefficient masses. -/
theorem lpTruncate_norm_sq {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (u : lp (fun _ : ι => ℂ) 2) :
    ‖lpTruncate s u‖ ^ 2 = ∑ i ∈ s, ‖u i‖ ^ 2 := by
  simpa [lpTruncate, Real.rpow_two] using
    (lp.norm_sum_single (p := (2 : ENNReal)) (by norm_num) (fun i => u i) s)

/-- Finite coordinate truncation as a complex-linear map. -/
def lpTruncateLinearMap {ι : Type*} [DecidableEq ι] (s : Finset ι) :
    lp (fun _ : ι => ℂ) 2 →ₗ[ℂ] lp (fun _ : ι => ℂ) 2 where
  toFun := lpTruncate s
  map_add' u v := by
    apply lp.ext
    funext i
    by_cases hi : i ∈ s <;> simp [lpTruncate_apply, hi]
  map_smul' a u := by
    apply lp.ext
    funext i
    by_cases hi : i ∈ s <;> simp [lpTruncate_apply, hi]

/-- Coordinate truncations are bounded linear operators of norm at most one. -/
def lpTruncateCLM {ι : Type*} [DecidableEq ι] (s : Finset ι) :
    lp (fun _ : ι => ℂ) 2 →L[ℂ] lp (fun _ : ι => ℂ) 2 :=
  (lpTruncateLinearMap s).mkContinuous 1 (by
    intro u
    change ‖lpTruncate s u‖ ≤ 1 * ‖u‖
    rw [one_mul]
    exact lpTruncate_norm_le s u)

/-- Any increasing exhaustive sequence of finite coordinate sets yields
convergence of its actual coordinate truncations in the square-summable norm. -/
theorem lp_norm_truncation_tendsto {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (u : lp (fun _ : ι => ℂ) 2) :
    Tendsto (fun n => lpTruncate (S n) u) atTop (𝓝 u) := by
  have hSum : Tendsto
      (fun s : Finset ι => ∑ i ∈ s, lp.single 2 i (u i)) atTop (𝓝 u) :=
    lp.hasSum_single (by norm_num : (2 : ENNReal) ≠ ⊤) u
  exact hSum.comp (Filter.tendsto_atTop_finset_of_monotone hMono hExhaust)

end

end PlaneWaveCertificate

