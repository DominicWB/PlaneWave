/-- On the cube the mask is the finite tail operator. -/
lemma tailMask_embed (g K : ℝ) (r : Fin eta) (n : ℕ)
    (v : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    tailMask g K r (finiteFourierLpEmbed eta n v.ofLp) =
