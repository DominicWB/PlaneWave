/-- A continuous classical coordinate derivative has the expected Fourier
coefficient. The argument integrates the derivative of the product with a
plane wave, so it also covers zero frequency without division. -/
theorem mFourierCoeff_coordinateDerivative {d : Type*} [Fintype d]
    (f df : C(UnitAddTorus d, ℂ)) (a : d) (n : d → ℤ)
    (hd : ∀ x t, HasDerivAt
      (fun s : ℝ => f (torusCoordinateLine x a s))
      (df (torusCoordinateLine x a t)) t) :
    UnitAddTorus.mFourierCoeff df n =
      (2 * (Real.pi : ℂ) * Complex.I * (n a : ℂ)) *
        UnitAddTorus.mFourierCoeff f n := by
  let ω : ℂ := 2 * (Real.pi : ℂ) * Complex.I * (n a : ℂ)
  let w : C(UnitAddTorus d, ℂ) := UnitAddTorus.mFourier (-n)
  let F : C(UnitAddTorus d, ℂ) := w * f
  let dF : C(UnitAddTorus d, ℂ) := (-ω) • F + w * df
  have hNeg : 2 * (Real.pi : ℂ) * Complex.I * ((-n) a : ℂ) = -ω := by
    simp [ω]
  have hD : ∀ x t, HasDerivAt
      (fun s : ℝ => F (torusCoordinateLine x a s))
      (dF (torusCoordinateLine x a t)) t := by
    intro x t
    change HasDerivAt
      (fun s : ℝ => UnitAddTorus.mFourier (-n) (torusCoordinateLine x a s) *
        f (torusCoordinateLine x a s))
      ((-ω) * (UnitAddTorus.mFourier (-n) (torusCoordinateLine x a t) *
        f (torusCoordinateLine x a t)) +
        UnitAddTorus.mFourier (-n) (torusCoordinateLine x a t) *
          df (torusCoordinateLine x a t)) t
    have hWave := mFourier_hasDerivAt_coordinateLine (-n) x a t
    rw [hNeg] at hWave
    have hProduct := hWave.mul (hd x t)
    rw [mul_assoc] at hProduct
    with_reducible_and_instances exact hProduct
  have hFint : Integrable (fun x => w x * f x) :=
    memLp_one_iff_integrable.mp
      (ContinuousMap.memLp (p := 1) volume ℂ (w * f))
  have hdfint : Integrable (fun x => w x * df x) :=
    memLp_one_iff_integrable.mp
      (ContinuousMap.memLp (p := 1) volume ℂ (w * df))
  have hz := integral_torusCoordinateDerivative_eq_zero F dF a hD
  change (∫ x, (-ω) * (w x * f x) + w x * df x) = 0 at hz
  rw [integral_add (hFint.const_mul (-ω)) hdfint, integral_const_mul] at hz
  change (-ω) * UnitAddTorus.mFourierCoeff f n +
    UnitAddTorus.mFourierCoeff df n = 0 at hz
  change UnitAddTorus.mFourierCoeff df n = ω * UnitAddTorus.mFourierCoeff f n
  calc
    UnitAddTorus.mFourierCoeff df n =
        ω * UnitAddTorus.mFourierCoeff f n +
          ((-ω) * UnitAddTorus.mFourierCoeff f n +
            UnitAddTorus.mFourierCoeff df n) := by ring
    _ = ω * UnitAddTorus.mFourierCoeff f n := by rw [hz, add_zero]

/-- Two genuine continuous coordinate derivatives yield the standard negative
squared-frequency multiplier on every Fourier coefficient. -/
theorem mFourierCoeff_coordinateSecondDerivative {d : Type*} [Fintype d]
    (f df ddf : C(UnitAddTorus d, ℂ)) (a : d) (n : d → ℤ)
    (hd : ∀ x t, HasDerivAt
      (fun s : ℝ => f (torusCoordinateLine x a s))
      (df (torusCoordinateLine x a t)) t)
    (hdd : ∀ x t, HasDerivAt
      (fun s : ℝ => df (torusCoordinateLine x a s))
      (ddf (torusCoordinateLine x a t)) t) :
    UnitAddTorus.mFourierCoeff ddf n =
      -(4 * (Real.pi : ℂ) ^ 2 * (n a : ℂ) ^ 2) *
        UnitAddTorus.mFourierCoeff f n := by
  rw [mFourierCoeff_coordinateDerivative df ddf a n hdd,
    mFourierCoeff_coordinateDerivative f df a n hd]
  calc
    (2 * (Real.pi : ℂ) * Complex.I * (n a : ℂ)) *
        ((2 * (Real.pi : ℂ) * Complex.I * (n a : ℂ)) *
          UnitAddTorus.mFourierCoeff f n) =
        (4 * (Real.pi : ℂ) ^ 2 * (n a : ℂ) ^ 2 * Complex.I ^ 2) *
          UnitAddTorus.mFourierCoeff f n := by ring
    _ = _ := by rw [Complex.I_sq]; ring

end

