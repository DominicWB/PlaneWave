/-! ### Exact exchange covariance of the unordered electron-pair interaction -/

/-- Relabel the electrons in an unordered pair and sort its two endpoints.
The sorting changes only the choice of representative of the physical pair. -/
noncomputable def finiteElectronPairMap
    {eta : ℕ} (σ : Equiv.Perm (Fin eta))
    (pair : FiniteElectronPair eta) : FiniteElectronPair eta := by
  classical
  exact if h : σ pair.1.1 < σ pair.1.2 then
    ⟨(σ pair.1.1, σ pair.1.2), h⟩
  else
    ⟨(σ pair.1.2, σ pair.1.1), by
      have hne : σ pair.1.1 ≠ σ pair.1.2 :=
        fun heq => (ne_of_lt pair.2) (σ.injective heq)
      exact (lt_or_gt_of_ne hne).resolve_left h⟩

lemma finiteElectronPairMap_symm_apply
    {eta : ℕ} (σ : Equiv.Perm (Fin eta)) (pair : FiniteElectronPair eta) :
    finiteElectronPairMap σ.symm (finiteElectronPairMap σ pair) = pair := by
  classical
  rcases pair with ⟨⟨i, j⟩, hij⟩
  apply Subtype.ext
  by_cases h : σ i < σ j
  · simp [finiteElectronPairMap, h, hij]
  · simp [finiteElectronPairMap, h, hij, not_lt_of_gt hij]

/-- Electron relabelling is a bijection of the actual `i < j` pair index set;
there is no ordered-pair factor of two. -/
noncomputable def finiteElectronPairEquiv
    {eta : ℕ} (σ : Equiv.Perm (Fin eta)) :
    FiniteElectronPair eta ≃ FiniteElectronPair eta where
  toFun := finiteElectronPairMap σ
  invFun := finiteElectronPairMap σ.symm
  left_inv := finiteElectronPairMap_symm_apply σ
  right_inv := by
    intro pair
    simpa only [Equiv.symm_symm] using finiteElectronPairMap_symm_apply σ.symm pair

/-- A symmetric two-electron quantity summed once over unordered pairs is
invariant under every permutation of the electron registers. -/
lemma sum_finiteElectronPair_permute
    {eta : ℕ} {M : Type*} [AddCommMonoid M]
    (σ : Equiv.Perm (Fin eta)) (f : Fin eta → Fin eta → M)
    (hSwap : ∀ i j, f i j = f j i) :
    (∑ pair : FiniteElectronPair eta, f (σ pair.1.1) (σ pair.1.2)) =
      ∑ pair : FiniteElectronPair eta, f pair.1.1 pair.1.2 := by
  classical
  have hEach : ∀ pair : FiniteElectronPair eta,
      f (σ pair.1.1) (σ pair.1.2) =
        f (finiteElectronPairEquiv σ pair).1.1
          (finiteElectronPairEquiv σ pair).1.2 := by
    intro pair
    change f (σ pair.1.1) (σ pair.1.2) =
      f (finiteElectronPairMap σ pair).1.1 (finiteElectronPairMap σ pair).1.2
    by_cases h : σ pair.1.1 < σ pair.1.2
    · simp only [finiteElectronPairMap, dif_pos h]
    · simpa only [finiteElectronPairMap, dif_neg h] using
        hSwap (σ pair.1.1) (σ pair.1.2)
  calc
    (∑ pair : FiniteElectronPair eta, f (σ pair.1.1) (σ pair.1.2)) =
        ∑ pair : FiniteElectronPair eta,
          f (finiteElectronPairEquiv σ pair).1.1
            (finiteElectronPairEquiv σ pair).1.2 := by
      apply Finset.sum_congr rfl
      intro pair hpair
      exact hEach pair
    _ = _ := Equiv.sum_comp (finiteElectronPairEquiv σ)
      (fun pair : FiniteElectronPair eta => f pair.1.1 pair.1.2)

/-- The exact spectator and conserved-total-momentum relation is covariant
under simultaneous relabelling of input and output configurations. -/
lemma finiteElectronPairSliceLabel_eq_permute_iff
    {eta : ℕ} (σ : Equiv.Perm (Fin eta)) (i j : Fin eta) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteElectronPairSliceLabel i j count (q ∘ σ) =
        finiteElectronPairSliceLabel i j count (p ∘ σ) ↔
      finiteElectronPairSliceLabel (σ i) (σ j) count q =
        finiteElectronPairSliceLabel (σ i) (σ j) count p := by
  rw [finiteElectronPairSliceLabel_eq_iff, finiteElectronPairSliceLabel_eq_iff]
  constructor
  · rintro ⟨hOther, hTotal⟩
    refine ⟨?_, hTotal⟩
    intro k hki hkj
    have hi : σ.symm k ≠ i := by
      intro h
      apply hki
      calc
        k = σ (σ.symm k) := (σ.apply_symm_apply k).symm
        _ = σ i := congrArg σ h
    have hj : σ.symm k ≠ j := by
      intro h
      apply hkj
      calc
        k = σ (σ.symm k) := (σ.apply_symm_apply k).symm
        _ = σ j := congrArg σ h
    simpa only [Function.comp_apply, Equiv.apply_symm_apply] using
      hOther (σ.symm k) hi hj
  · rintro ⟨hOther, hTotal⟩
    refine ⟨?_, hTotal⟩
    intro k hki hkj
    exact hOther (σ k)
      (fun h => hki (σ.injective h)) (fun h => hkj (σ.injective h))

/-- Equality of the actual Coulomb coefficients, including the exact
opposite-transfer constraint; no absolute-value domination is used. -/
lemma finiteElectronPairConfigurationKernel_permute
    {eta : ℕ} (σ : Equiv.Perm (Fin eta)) (i j : Fin eta)
    (C : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) :
    finiteElectronPairConfigurationKernel i j C count (q ∘ σ) (p ∘ σ) =
      finiteElectronPairConfigurationKernel (σ i) (σ j) C count q p := by
  classical
  simp only [finiteElectronPairConfigurationKernel,
    finiteElectronPairSliceLabel_eq_permute_iff, Function.comp_apply]

/-- Kernel-to-matrix conversion is additive.  This packages finite sums
without making a new assumption about the molecular decomposition. -/
noncomputable def finiteCoefficientKernelOperatorAddHom
    {ι : Type*} [Fintype ι] :
    (ι → ι → ℂ) →+
      (EuclideanSpace ℂ ι →ₗ[ℂ] EuclideanSpace ℂ ι) where
  toFun := finiteCoefficientKernelOperator
  map_zero' := by
    apply LinearMap.ext
    intro u
    ext q
    simp [finiteCoefficientKernelOperator]
  map_add' := by
    intro A D
    apply LinearMap.ext
    intro u
    ext q
    change (finiteCoefficientKernelOperator (A + D) u).ofLp q =
      (finiteCoefficientKernelOperator A u).ofLp q +
        (finiteCoefficientKernelOperator D u).ofLp q
    simp only [finiteCoefficientKernelOperator_apply, Pi.add_apply,
      mul_add, Finset.sum_add_distrib]

lemma finiteCoefficientKernelOperator_sum
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (kernel : κ → ι → ι → ℂ) :
    finiteCoefficientKernelOperator (fun q p => ∑ k : κ, kernel k q p) =
      ∑ k : κ, finiteCoefficientKernelOperator (kernel k) := by
  classical
  have h := map_sum (finiteCoefficientKernelOperatorAddHom (ι := ι)) kernel Finset.univ
  change finiteCoefficientKernelOperator (∑ k : κ, kernel k) =
    ∑ k : κ, finiteCoefficientKernelOperator (kernel k) at h
  have hPointwise : (∑ k : κ, kernel k) =
      (fun q p => ∑ k : κ, kernel k q p) := by
    funext q p
    simp only [Finset.sum_apply]
  rw [hPointwise] at h
  exact h

/-- Output-first kernel of the complete repulsive electron--electron term. -/
noncomputable def finiteElectronElectronConfigurationKernel
    (eta : ℕ) (gamma : ℝ) (count : ℕ)
    (q p : FourierConfig eta (FinitePlaneWaveMode count)) : ℂ :=
  ∑ pair : FiniteElectronPair eta,
    finiteElectronPairConfigurationKernel pair.1.1 pair.1.2 (gamma ^ 2) count q p

lemma finiteElectronElectronPotential_eq_kernel
    (eta : ℕ) (gamma : ℝ) (count : ℕ) :
    finiteElectronElectronPotential eta gamma count =
      finiteCoefficientKernelOperator
        (finiteElectronElectronConfigurationKernel eta gamma count) := by
  exact (finiteCoefficientKernelOperator_sum
    (fun pair : FiniteElectronPair eta =>
      finiteElectronPairConfigurationKernel pair.1.1 pair.1.2 (gamma ^ 2) count)).symm

end
end PlaneWaveCertificate

