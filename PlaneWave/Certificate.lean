section DevU10

/-!
# Dynamics: the observable in position space

The observable of `thm:dyn` is the multiplication by `χ(x_a)` on the position space
`L²((T³)^η)`. This section builds the multiplication operator by a continuous function, shows that
in the physical Fourier coordinates (`physMap`) the multiplication by `χ(x_a)` is the
convolution `convOp a χ̂` of the Fourier side when the Fourier coefficients `χ̂` of `χ` are
summable, and derives `‖O‖ ≤ sup |χ|` and the symmetry condition for a real `χ`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set MeasureTheory

namespace PlaneWaveDynamics

open PlaneWaveCertificate

noncomputable section

local instance unitAddCircleMeasureSpaceForObservable : MeasureSpace UnitAddCircle :=
  instMeasureSpaceUnitAddCircle

variable {eta : ℕ}

/-! ## Multiplication by a continuous function -/

lemma mul_memLp (G : C(MolecularPositionTorus eta, ℂ)) (f : MolecularPositionL2 eta) :
    MemLp (fun x => G x * f x) 2 (volume : Measure (MolecularPositionTorus eta)) := by
  have hmeas : AEStronglyMeasurable (fun x => G x * f x)
      (volume : Measure (MolecularPositionTorus eta)) :=
    G.continuous.aestronglyMeasurable.mul (Lp.aestronglyMeasurable f)
  refine ((Lp.memLp f).const_mul (‖G‖ : ℂ)).of_le hmeas ?_
  filter_upwards [] with x
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_norm]
  exact mul_le_mul_of_nonneg_right (G.norm_coe_le_norm x) (norm_nonneg _)

/-- The product `G f` as an element of `L²`. -/
def mulLp (G : C(MolecularPositionTorus eta, ℂ)) (f : MolecularPositionL2 eta) :
    MolecularPositionL2 eta :=
  (mul_memLp G f).toLp _

lemma mulLp_ae (G : C(MolecularPositionTorus eta, ℂ)) (f : MolecularPositionL2 eta) :
    (mulLp G f : MolecularPositionTorus eta → ℂ) =ᵐ[volume] fun x => G x * f x :=
  MemLp.coeFn_toLp _

/-- The multiplication operator by a continuous function on the position torus. -/
def mulCLM (G : C(MolecularPositionTorus eta, ℂ)) :
    MolecularPositionL2 eta →L[ℂ] MolecularPositionL2 eta :=
  LinearMap.mkContinuous
    { toFun := mulLp G
      map_add' := fun f g => by
        apply Lp.ext
        filter_upwards [mulLp_ae G (f + g), mulLp_ae G f, mulLp_ae G g, Lp.coeFn_add f g,
          Lp.coeFn_add (mulLp G f) (mulLp G g)] with x h1 h2 h3 h4 h5
        rw [h5, Pi.add_apply, h1, h2, h3, h4, Pi.add_apply, mul_add]
      map_smul' := fun c f => by
        apply Lp.ext
        filter_upwards [mulLp_ae G (c • f), mulLp_ae G f, Lp.coeFn_smul c f,
          Lp.coeFn_smul c (mulLp G f)] with x h1 h2 h3 h4
        rw [RingHom.id_apply, h4, Pi.smul_apply, h1, h2, h3, Pi.smul_apply, smul_eq_mul,
          smul_eq_mul]
        ring }
    ‖G‖ (fun f => by
      refine Lp.norm_le_mul_norm_of_ae_le_mul ?_
      filter_upwards [mulLp_ae G f] with x hx
      change ‖(mulLp G f : MolecularPositionTorus eta → ℂ) x‖ ≤ ‖G‖ * ‖f x‖
      rw [hx, norm_mul]
      exact mul_le_mul_of_nonneg_right (G.norm_coe_le_norm x) (norm_nonneg _))

lemma norm_mulCLM_le (G : C(MolecularPositionTorus eta, ℂ)) : ‖mulCLM G‖ ≤ ‖G‖ :=
  LinearMap.mkContinuous_norm_le _ (norm_nonneg _) _

lemma mulCLM_ae (G : C(MolecularPositionTorus eta, ℂ)) (f : MolecularPositionL2 eta) :
    (mulCLM G f : MolecularPositionTorus eta → ℂ) =ᵐ[volume] fun x => G x * f x :=
  mulLp_ae G f

/-- Multiplying two torus characters adds their frequencies. -/
lemma mulCLM_mFourier (m q : (Fin eta × Fin 3) → ℤ) :
    mulCLM (UnitAddTorus.mFourier m) (UnitAddTorus.mFourierLp 2 q) =
      UnitAddTorus.mFourierLp 2 (m + q) := by
  apply Lp.ext
  filter_upwards [mulCLM_ae (UnitAddTorus.mFourier m) (UnitAddTorus.mFourierLp 2 q),
    UnitAddTorus.coeFn_mFourierLp 2 q, UnitAddTorus.coeFn_mFourierLp 2 (m + q)] with x h1 h2 h3
  rw [h1, h2, h3, UnitAddTorus.mFourier_add]

lemma mulCLM_add (G G' : C(MolecularPositionTorus eta, ℂ)) :
    mulCLM (G + G') = mulCLM G + mulCLM G' := by
  ext1 f
  apply Lp.ext
  filter_upwards [mulCLM_ae (G + G') f, mulCLM_ae G f, mulCLM_ae G' f,
    Lp.coeFn_add (mulCLM G f) (mulCLM G' f)] with x h1 h2 h3 h4
  rw [add_apply, h4, Pi.add_apply, h1, h2, h3, ContinuousMap.add_apply, add_mul]

lemma mulCLM_smul (c : ℂ) (G : C(MolecularPositionTorus eta, ℂ)) :
    mulCLM (c • G) = c • mulCLM G := by
  ext1 f
  apply Lp.ext
  filter_upwards [mulCLM_ae (c • G) f, mulCLM_ae G f, Lp.coeFn_smul c (mulCLM G f)] with x h1 h2 h3
  rw [smul_apply, h3, Pi.smul_apply, h1, h2, ContinuousMap.smul_apply,
    smul_eq_mul, smul_eq_mul]
  ring

/-- Multiplication operators depend continuously and linearly on the multiplier. -/
def mulCLML : C(MolecularPositionTorus eta, ℂ) →L[ℂ]
    (MolecularPositionL2 eta →L[ℂ] MolecularPositionL2 eta) :=
  LinearMap.mkContinuous
    { toFun := mulCLM
      map_add' := mulCLM_add
      map_smul' := mulCLM_smul }
    1 (fun G => by
      change ‖mulCLM G‖ ≤ 1 * ‖G‖
      rw [one_mul]
      exact norm_mulCLM_le G)

/-! ## The register observable `χ(x_a)` -/

/-- The position of register `a`, as a continuous map to the unit torus. -/
def regPos (a : Fin eta) : C(MolecularPositionTorus eta, UnitAddTorus (Fin 3)) :=
  ⟨molecularPositionParticle a, by
    unfold molecularPositionParticle
    fun_prop⟩

/-- The observable `χ(x_a)` as a function on the position torus. -/
def regFun (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)) : C(MolecularPositionTorus eta, ℂ) :=
  χ.comp (regPos a)

lemma norm_regFun_le (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)) : ‖regFun a χ‖ ≤ ‖χ‖ :=
  (ContinuousMap.norm_le _ (norm_nonneg _)).mpr fun _ => χ.norm_coe_le_norm _

lemma index_single (a : Fin eta) (ν : Lattice3) :
    molecularFourierIndexEquiv eta (Pi.single a ν) = molecularParticleFrequency a ν := by
  funext bd
  rcases bd with ⟨b, d⟩
  simp only [molecularFourierIndexEquiv_apply, molecularParticleFrequency]
  by_cases hb : b = a
  · subst hb
    simp
  · simp [hb]

lemma mFourier_comp_regPos (a : Fin eta) (ν : Lattice3) :
    (UnitAddTorus.mFourier ν).comp (regPos a) =
      UnitAddTorus.mFourier (molecularFourierIndexEquiv eta (Pi.single a ν)) := by
  ext x
  rw [index_single, mFourier_molecularParticleFrequency]
  rfl

/-- The Fourier series of `χ(x_a)`. -/
lemma hasSum_regFun (a : Fin eta) {χ : C(UnitAddTorus (Fin 3), ℂ)}
    (hχ : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖) :
    HasSum (fun ν => UnitAddTorus.mFourierCoeff χ ν •
      UnitAddTorus.mFourier (molecularFourierIndexEquiv eta (Pi.single a ν))) (regFun a χ) := by
  have h := (UnitAddTorus.hasSum_mFourier_series_of_summable hχ.of_norm).map
    (ContinuousMap.compRightAlgHom ℂ ℂ (regPos a))
      (ContinuousMap.compRightAlgHom_continuous ℂ ℂ (regPos a))
  simp only [Function.comp_def] at h
  have e : (fun ν => (ContinuousMap.compRightAlgHom ℂ ℂ (regPos a))
      (UnitAddTorus.mFourierCoeff χ ν • UnitAddTorus.mFourier ν)) =
      fun ν => UnitAddTorus.mFourierCoeff χ ν •
        UnitAddTorus.mFourier (molecularFourierIndexEquiv eta (Pi.single a ν)) := by
    funext ν
    rw [map_smul, ContinuousMap.compRightAlgHom_apply, mFourier_comp_regPos]
  rw [e] at h
  exact h

/-- The physical Fourier mode `p` is the torus character of frequency `-p`. -/
lemma physMap_single (p : FourierConfig eta Lattice3) :
    physMap eta (lp.single 2 p (1 : ℂ)) =
      UnitAddTorus.mFourierLp 2 (-(molecularFourierIndexEquiv eta p)) := by
  change molecularPositionReflection eta (molecularPositionSynthesis eta (lp.single 2 p 1)) = _
  rw [molecularPositionSynthesis_single, one_smul]
  apply Lp.ext
  filter_upwards [molecularPositionReflection_coeFn eta
      (UnitAddTorus.mFourierLp 2 (molecularFourierIndexEquiv eta p)),
    (molecularPosition_neg_measurePreserving eta).quasiMeasurePreserving.ae
      (UnitAddTorus.coeFn_mFourierLp 2 (molecularFourierIndexEquiv eta p)),
    UnitAddTorus.coeFn_mFourierLp 2 (-(molecularFourierIndexEquiv eta p))] with x h1 h2 h3
  rw [h1, h2, h3, mFourier_neg_position]

lemma index_sub (p q : FourierConfig eta Lattice3) :
    molecularFourierIndexEquiv eta (p - q) =
      molecularFourierIndexEquiv eta p - molecularFourierIndexEquiv eta q := by
  funext bd
  simp

lemma shiftCLM_single (a : Fin eta) (ν : Lattice3) (p : FourierConfig eta Lattice3) :
    shiftCLM a ν (lp.single 2 p (1 : ℂ)) = lp.single 2 (p - Pi.single a ν) (1 : ℂ) := by
  classical
  ext q
  rw [shiftCLM_apply, lp.single_apply, lp.single_apply]
  by_cases h : q = p - Pi.single a ν
  · subst h
    simp
  · have h' : q + Pi.single a ν ≠ p := fun h'' => h (by rw [← h'']; abel)
    simp [h, h']

/-- **The observable in Fourier coordinates.** For a continuous `χ` with summable Fourier
coefficients, the multiplication by `χ(x_a)` on position space is, in the physical Fourier
coordinates, the convolution `convOp a χ̂`. -/
theorem physMap_mulCLM (a : Fin eta) {χ : C(UnitAddTorus (Fin 3), ℂ)}
    (hχ : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖)
    (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    (physMap eta).symm (mulCLM (regFun a χ) (physMap eta x)) =
      convOp a (UnitAddTorus.mFourierCoeff χ) x := by
  set A : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 →L[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
    ((physMap eta).symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
      (mulCLM (regFun a χ))).comp (physMap eta).toContinuousLinearEquiv.toContinuousLinearMap
    with hA
  have hAapply : ∀ y, A y = (physMap eta).symm (mulCLM (regFun a χ) (physMap eta y)) :=
    fun y => rfl
  -- agreement on the Fourier modes
  have hmode : ∀ p : FourierConfig eta Lattice3,
      A (lp.single 2 p (1 : ℂ)) = convOp a (UnitAddTorus.mFourierCoeff χ) (lp.single 2 p 1) := by
    intro p
    have hM := ((hasSum_regFun a hχ).mapL mulCLML).mapL
      (ContinuousLinearMap.apply ℂ (MolecularPositionL2 eta) (physMap eta (lp.single 2 p 1)))
    have hL := hM.mapL (physMap eta).symm.toContinuousLinearEquiv.toContinuousLinearMap
    have hR := hasSum_convOp_apply a hχ (lp.single 2 p (1 : ℂ))
    have e : ∀ ν, (physMap eta).symm.toContinuousLinearEquiv.toContinuousLinearMap
        ((ContinuousLinearMap.apply ℂ (MolecularPositionL2 eta) (physMap eta (lp.single 2 p 1)))
          (mulCLML (UnitAddTorus.mFourierCoeff χ ν •
            UnitAddTorus.mFourier (molecularFourierIndexEquiv eta (Pi.single a ν))))) =
        UnitAddTorus.mFourierCoeff χ ν • shiftCLM a ν (lp.single 2 p 1) := by
      intro ν
      change (physMap eta).symm (mulCLM (UnitAddTorus.mFourierCoeff χ ν •
        UnitAddTorus.mFourier (molecularFourierIndexEquiv eta (Pi.single a ν)))
          (physMap eta (lp.single 2 p 1))) = _
      rw [mulCLM_smul, smul_apply, physMap_single, mulCLM_mFourier, map_smul,
        shiftCLM_single]
      have hfreq : molecularFourierIndexEquiv eta (Pi.single a ν) +
          -molecularFourierIndexEquiv eta p =
          -molecularFourierIndexEquiv eta (p - Pi.single a ν) := by
        rw [index_sub]
        abel
      rw [hfreq, ← physMap_single, LinearIsometryEquiv.symm_apply_apply]
    simp only [e] at hL
    exact hL.unique hR
  -- extension by linearity and continuity
  have hsingle : ∀ (p : FourierConfig eta Lattice3) (c : ℂ),
      A (lp.single 2 p c) = convOp a (UnitAddTorus.mFourierCoeff χ) (lp.single 2 p c) := by
    intro p c
    have hs : lp.single (E := fun _ : FourierConfig eta Lattice3 => ℂ) 2 p c =
        c • lp.single 2 p (1 : ℂ) := by
      simpa only [smul_eq_mul, mul_one] using
        lp.single_smul (E := fun _ : FourierConfig eta Lattice3 => ℂ) 2 p c (1 : ℂ)
    rw [hs, map_smul, map_smul, hmode]
  have hx := lp.hasSum_single (E := fun _ : FourierConfig eta Lattice3 => ℂ) (p := 2)
    (by norm_num) x
  have h1 := hx.mapL A
  have h2 := hx.mapL (convOp a (UnitAddTorus.mFourierCoeff χ))
  simp only [hsingle] at h1
  rw [← hAapply]
  exact h1.unique h2

/-- `‖O‖ ≤ sup |χ|`. -/
theorem norm_convOp_le_sup (a : Fin eta) {χ : C(UnitAddTorus (Fin 3), ℂ)}
    (hχ : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖) :
    ‖convOp (eta := eta) a (UnitAddTorus.mFourierCoeff χ)‖ ≤ ‖χ‖ := by
  refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _) (fun x => ?_)
  rw [← physMap_mulCLM a hχ x, LinearIsometryEquiv.norm_map]
  refine ((mulCLM (regFun a χ)).le_opNorm _).trans ?_
  rw [LinearIsometryEquiv.norm_map]
  exact mul_le_mul_of_nonneg_right ((norm_mulCLM_le _).trans (norm_regFun_le a χ)) (norm_nonneg _)

/-- A real function has conjugate-symmetric Fourier coefficients. -/
theorem mFourierCoeff_neg_of_real {χ : C(UnitAddTorus (Fin 3), ℂ)} (hreal : ∀ y, conj (χ y) = χ y)
    (ν : Lattice3) :
    UnitAddTorus.mFourierCoeff χ (-ν) = conj (UnitAddTorus.mFourierCoeff χ ν) := by
  unfold UnitAddTorus.mFourierCoeff
  rw [← integral_conj]
  congr 1
  funext y
  rw [neg_neg, smul_eq_mul, smul_eq_mul, map_mul, hreal, UnitAddTorus.mFourier_neg,
      Complex.conj_conj]

/-! ## The bound of `thm:dyn` as a function of the data -/

section Bound

variable {ν : Type} [Fintype ν]

/-- The bound `A₁ K^{-5} + A₂ t K^{-3} + A₃ K^{-5/2} τ_χ(K/2)` of `coulomb_observable_rate`
(`ρ = K^{-1/2}`), as a function of the scalar data `s0 = ‖ψ₀‖`, `hu = ‖H ψ₀‖`, `hs = ‖H ψ₀‖`
(as the decoded state of `H ψ₀`) and `hv = ‖H² ψ₀‖`, the coefficients `χ̂` and the time. -/
def obsRateBound (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker rho : ℝ) (n : ℕ) (a : Fin eta)
    (χ : Lattice3 → ℂ) (s0 hu hs hv t : ℝ) : ℝ :=
  let g : ℝ := 2 * Real.pi / L
  let K : ℝ := g * n
  let b : ℝ := relB sys L Hunit
  let S0 : ℝ := s0
  let Ξ₀ : ℝ := 2 * hu + 2 * b * S0
  let Ξ₁ : ℝ := 2 * hv + 2 * b * hs
  let Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
  let CO : ℝ := ‖convOp (eta := eta) a χ‖
  let Cχ : ℝ := ∑' ν, ‖χ ν‖
  let τχ : ℝ := ∑' ν, if K / 2 < g * Real.sqrt (latticeNormSq ν) then ‖χ ν‖ else 0
  let D : ℝ := commConst g a χ
  let Hw1 : ℝ := 2 * ((CO + 2 * D) * Ξ₀ + D * S0) + 2 * b * (CO * S0)
  let M1 : ℝ := sys.maxMass * (CO * S0 + 2 * (2 * Hw1 + 2 * b * (CO * S0)))
  let Tη : ℝ := 2 * (2 * (2 * Ξ₀ + 2 * b * S0)) + 2 * b * (2 * S0)
  let Hw2 : ℝ := 2 * ((CO + 2 * D) * Tη + D * (2 * S0)) + 2 * b * (CO * (2 * S0))
  let M2 : ℝ := sys.maxMass * (CO * (2 * S0) + 2 * (2 * Hw2 + 2 * b * (CO * (2 * S0))))
  let β : ℝ := 2 * sys.maxMass * Ξ₁ + Ct (sys.maxMass * (S0 + 2 * Ξ₀))
  let δ₁ : ℝ := eta * (2 * sys.maxMass * β)
  let τ₁ : ℝ := 8 * sys.maxMass * (8 * sys.maxMass * Ξ₁ + 2 * Ct (sys.maxMass * (S0 + 2 * Ξ₀)))
  let N₁ : ℝ := finiteCoulombPhysicalMassConstant sys L Hunit *
    Real.sqrt (δ₁ * (eta * ((2 * sys.maxMass + 2) * β)))
  let A₁ : ℝ := 2 * δ₁ * (Cχ * τ₁ + CO * δ₁) + CO * δ₁ ^ 2
  let A₂ : ℝ := 2 * δ₁ * (eta * Ct M1) + 2 * CO * δ₁ * N₁ + δ₁ * (eta * Ct M2)
  let A₃ : ℝ := 2 * δ₁ * S0
  A₁ * rho ^ 10 + A₂ * t * rho ^ 6 + A₃ * rho ^ 5 * τχ

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- `coulomb_observable_rate` with the bound written as `obsRateBound`. -/
theorem coulomb_observable_rate_bound (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h4g : 4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (a : Fin eta) (χ : Lattice3 → ℂ)
    (hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) * ‖χ ν‖)
    (hreal : ∀ ν, χ (-ν) = conj (χ ν)) {t : ℝ} (ht : 0 ≤ t) :
    ‖⟪U t (molecularH2StateMap eta (2 * Real.pi / L) u₀),
        convOp a χ (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀))⟫_ℂ -
      ⟪finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀))),
        convOp a χ (finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀))))⟫_ℂ‖ ≤
      obsRateBound sys L Hunit Blow Cs Bker rho n a χ ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖
        ‖H u₀‖ ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ ‖H v₀‖ t :=
  coulomb_observable_rate sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph hderiv n UN hN0 hNadd
    hNcomm hNderiv rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h4g hAmplitude hBkerScale
    hCsScale u₀ v₀ huv a χ hχ2 hreal ht

end Bound

/-! ## `thm:dyn` in position space -/

section PositionTheorem

variable {ν : Type} [Fintype ν]

/-- **Observable error after Coulomb evolution, position space** (`thm:dyn`, `eq:dyn-main`).
Let `U t` be unitaries on `L²((T³)^η)` with `U 0 = 1` that preserve the graph of the Coulomb
Hamiltonian and solve the Schrödinger equation on it (by uniqueness of strong solutions, the
propagator `e^{-iHt}` of `exists_coulombPropagator`), and `U_N` the propagator of the Galerkin
Hamiltonian `H_N` of the cube of radius `n` (`K = 2πn/L`, `n ≥ 4`, `K ≥ 2`). For `ψ₀ ∈ D(H²)`
(`H ψ₀ = h₀`,
`H h₀ = h₁`), a register `a` and a real continuous `χ` on the unit torus whose Fourier
coefficients are summable with weight `1 + g²|ν|²`, the expectations of the multiplication by
`χ(x_a)` in the exact state `ψ(t) = U t ψ₀` and in the Galerkin state
`ψ_N(t) = e^{-iH_N t} P ψ₀` differ by at most
`A₁ K^{-5} + A₂ t K^{-3} + A₃ K^{-5/2} τ_χ(K/2)` (`obsRateBound`), with constants depending on
`‖ψ₀‖, ‖H ψ₀‖, ‖H² ψ₀‖`, on the system, on `χ` and on the auxiliary constants `Blow, Cs, Bker`
(which depend on `L` only), but not on `K` or `t`. -/
theorem coulomb_observable_position (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L)
    (U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta) (hU0 : ∀ ψ, U 0 ψ = ψ)
    (hUgraph : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasCoulombHamiltonian sys L (U t f) (U t h))
    (hUderiv : ∀ t f h, HasCoulombHamiltonian sys L f h →
      HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x) (hNadd : ∀ s t x, UN (s + t) x = UN s (UN t x))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK2 : 2 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h4g : 4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (ψ₀ h₀ h₁ : MolecularPositionL2 eta) (hψ₀ : HasCoulombHamiltonian sys L ψ₀ h₀)
    (hh₀ : HasCoulombHamiltonian sys L h₀ h₁)
    (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ))
    (hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖)
    (hreal : ∀ y, conj (χ y) = χ y) {t : ℝ} (ht : 0 ≤ t) :
    let ψN := physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n ((physMap eta).symm ψ₀))))
    ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
      obsRateBound sys L molecularCanonicalUnitHardyConstant Blow Cs Bker rho n a
        (UnitAddTorus.mFourierCoeff χ) ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖ t := by
  intro ψN
  have hPeriodic := canonicalPeriodicCoulombHardyBound_explicit
  obtain ⟨H, hKernel, -⟩ := exists_coulombFourierH2Operator sys L
      molecularCanonicalUnitHardyConstant
    hL hPeriodic
  have hiff := hasCoulombHamiltonian_iff_phys sys L hL H hKernel
  -- the propagator on the Fourier side
  set UF : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 :=
    fun s => ((physMap eta).trans (U s)).trans (physMap eta).symm with hUFdef
  have hUF : ∀ s x, UF s x = (physMap eta).symm (U s (physMap eta x)) := fun s x => rfl
  have h0F : ∀ x, UF 0 x = x := by
    intro x
    rw [hUF, hU0, LinearIsometryEquiv.symm_apply_apply]
  have hgraphF : ∀ s u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        UF s (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = UF s (H u) := by
    intro s u
    obtain ⟨u', h1, h2⟩ := (hiff _ _).mp (hUgraph s _ _ ((hiff _ _).mpr ⟨u, rfl, rfl⟩))
    refine ⟨u', ?_, ?_⟩
    · rw [hUF, ← h1, LinearIsometryEquiv.symm_apply_apply]
    · rw [hUF, ← h2, LinearIsometryEquiv.symm_apply_apply]
  have hderivF : ∀ s u, HasDerivAt (fun r => UF r (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • UF s (H u))) s := by
    intro s u
    have h := hUderiv s _ _ ((hiff _ _).mpr ⟨u, rfl, rfl⟩)
    have h2 := (((physMap eta).symm.toContinuousLinearEquiv.toContinuousLinearMap).restrictScalars
      ℝ).hasFDerivAt.comp_hasDerivAt s h
    simp only [ContinuousLinearMap.coe_restrictScalars'] at h2
    rw [map_neg, map_smul] at h2
    exact h2
  -- the initial state in `D(H²)`
  obtain ⟨u₀, hu₀1, hu₀2⟩ := (hiff ψ₀ h₀).mp hψ₀
  obtain ⟨v₀, hv₀1, hv₀2⟩ := (hiff h₀ h₁).mp hh₀
  have huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀ :=
    (physMap eta).injective (hu₀2.trans hv₀1.symm)
  -- the observable
  have hχ : Summable fun ν => ‖UnitAddTorus.mFourierCoeff χ ν‖ := summable_norm_of_weighted _ hχ2
  have hO : ∀ x, ⟪physMap eta x, mulCLM (regFun a χ) (physMap eta x)⟫_ℂ =
      ⟪x, convOp a (UnitAddTorus.mFourierCoeff χ) x⟫_ℂ := by
    intro x
    rw [← physMap_mulCLM a hχ x, ← LinearIsometryEquiv.inner_map_map (physMap eta),
      LinearIsometryEquiv.apply_symm_apply]
  have hψt : U t ψ₀ = physMap eta (UF t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) := by
    rw [hUF, LinearIsometryEquiv.apply_symm_apply, hu₀1]
  have hψN : ψN = physMap eta (finiteFourierLpIsometry eta n
      (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀)))) := by
    simp only [ψN]
    rw [← hu₀1, LinearIsometryEquiv.symm_apply_apply]
  rw [hψt, hψN, hO, hO]
  have h := coulomb_observable_rate_bound sys L H hKernel molecularCanonicalUnitHardyConstant hL
    hPeriodic (finiteCoulombPhysicalMassConstant_nonneg _ _ _) UF h0F hgraphF hderivF n UN hN0
    hNadd hNcomm hNderiv rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h4g hAmplitude
    hBkerScale hCsScale u₀ v₀ huv a (UnitAddTorus.mFourierCoeff χ) hχ2
    (fun ν => mFourierCoeff_neg_of_real hreal ν) ht
  have e1 : ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ = ‖ψ₀‖ := by
    rw [← hu₀1, LinearIsometryEquiv.norm_map]
  have e2 : ‖H u₀‖ = ‖h₀‖ := by rw [← hu₀2, LinearIsometryEquiv.norm_map]
  have e3 : ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ = ‖h₀‖ := by
    rw [← hv₀1, LinearIsometryEquiv.norm_map]
  have e4 : ‖H v₀‖ = ‖h₁‖ := by rw [← hv₀2, LinearIsometryEquiv.norm_map]
  rw [e1, e2, e3, e4] at h
  exact h

/-- **`thm:dyn` with its propagators.** For a periodic Coulomb system there is a propagator
`U` on `L²((T³)^η)` (unitary group, strongly continuous, preserving the graph of the Hamiltonian,
solving the Schrödinger equation on it, and the only evolution that does so), and for every cube
`n` a Galerkin propagator `U_N` of `H_N`, such that the observable error of
`coulomb_observable_position` holds for all data. -/
theorem coulomb_observable_propagators (sys : CoulombSystem eta ν) (L : ℝ) (hL : 0 < L) :
    ∃ U : ℝ → MolecularPositionL2 eta ≃ₗᵢ[ℂ] MolecularPositionL2 eta,
      (∀ ψ, U 0 ψ = ψ) ∧
      (∀ s t ψ, U (s + t) ψ = U s (U t ψ)) ∧
      (∀ ψ, Continuous fun t => U t ψ) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasCoulombHamiltonian sys L (U t f) (U t h)) ∧
      (∀ t f h, HasCoulombHamiltonian sys L f h →
        HasDerivAt (fun s => U s f) (-(Complex.I • U t h)) t) ∧
      (∀ φ ζ : ℝ → MolecularPositionL2 eta, (∀ t, HasCoulombHamiltonian sys L (φ t) (ζ t)) →
        (∀ t, HasDerivAt φ (-(Complex.I • ζ t)) t) → ∀ t, φ t = U t (φ 0)) ∧
      ∀ n : ℕ, ∃ UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
          EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)),
        (∀ x, UN 0 x = x) ∧ (∀ s t x, UN (s + t) x = UN s (UN t x)) ∧
        (∀ t x, HasDerivAt (fun s => UN s x)
          (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t) ∧
        ∀ (rho Blow Cs Bker : ℝ), 2 ≤ (2 * Real.pi / L) * n → 0 ≤ rho →
          rho ^ 2 * ((2 * Real.pi / L) * n) = 1 → 0 ≤ Blow → 0 ≤ Cs → 0 ≤ Bker →
          4 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n →
          54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L) →
          432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2 →
          1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2 →
          ∀ ψ₀ h₀ h₁ : MolecularPositionL2 eta, HasCoulombHamiltonian sys L ψ₀ h₀ →
          HasCoulombHamiltonian sys L h₀ h₁ →
          ∀ (a : Fin eta) (χ : C(UnitAddTorus (Fin 3), ℂ)),
          Summable (fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
            ‖UnitAddTorus.mFourierCoeff χ ν‖) →
          (∀ y, conj (χ y) = χ y) → ∀ t : ℝ, 0 ≤ t →
          let ψN := physMap eta (finiteFourierLpIsometry eta n
            (UN t (extractCLM n ((physMap eta).symm ψ₀))))
          ‖⟪U t ψ₀, mulCLM (regFun a χ) (U t ψ₀)⟫_ℂ - ⟪ψN, mulCLM (regFun a χ) ψN⟫_ℂ‖ ≤
            obsRateBound sys L molecularCanonicalUnitHardyConstant Blow Cs Bker rho n a
              (UnitAddTorus.mFourierCoeff χ) ‖ψ₀‖ ‖h₀‖ ‖h₀‖ ‖h₁‖ t := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, -, -⟩ := exists_coulombPropagator sys L hL
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, fun n => ?_⟩
  obtain ⟨UN, hN0, hNadd, -, hNcomm, hNderiv, -⟩ :=
    exists_finitePropagator (finiteCoulombHamiltonian_isSymmetric sys L n)
  refine ⟨UN, hN0, hNadd, hNderiv, ?_⟩
  intro rho Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h4g hAmplitude hBkerScale hCsScale
    ψ₀ h₀ h₁ hψ₀ hh₀ a χ hχ2 hreal t ht
  exact coulomb_observable_position sys L hL U h0 hgraph hderiv n UN hN0 hNadd hNcomm hNderiv rho
    Blow Cs Bker hK2 hRho hRhoScale hBlow hCs hBker h4g hAmplitude hBkerScale hCsScale ψ₀ h₀ h₁ hψ₀
    hh₀ a χ hχ2 hreal ht

end PositionTheorem

