/-- A coordinate that solves `g' = -i f g` is `e^{-itf} g(0)`. -/
lemma coord_ode_unique (f : ℝ) {g : ℝ → ℂ} (hg : ∀ s, HasDerivAt g (-(Complex.I * f) * g s) s)
    (t : ℝ) : g t = Complex.exp (Complex.I * ((-(t * f) : ℝ) : ℂ)) * g 0 := by
  set ph : ℝ → ℂ := fun s => Complex.exp (Complex.I * ((-(s * f) : ℝ) : ℂ))
  have hw : ∀ s, HasDerivAt (fun s => ph (-s) * g s) 0 s := by
    intro s
    have hp : HasDerivAt (fun s : ℝ => ph (-s)) (Complex.I * f * ph (-s)) s := by
      simp only [ph]
      have h1 : HasDerivAt (fun s : ℝ => ((-(-s * f) : ℝ) : ℂ)) ((-(-(1 : ℝ) * f) : ℝ) : ℂ) s :=
        ((hasDerivAt_id s).neg.mul_const f).neg.ofReal_comp
      have h2 := (h1.const_mul Complex.I).cexp
      convert h2 using 1
      push_cast
      ring
    have h3 := hp.mul (hg s)
    have h0 : Complex.I * (f : ℂ) * ph (-s) * g s + ph (-s) *
        (-(Complex.I * (f : ℂ)) * g s) = 0 := by
      ring
    rw [h0] at h3
    exact h3
  have hconst := is_const_of_deriv_eq_zero (fun s => (hw s).differentiableAt)
    (fun s => (hw s).deriv) t 0
  have hph0 : ph (-0) = 1 := by simp [ph]
  rw [hph0, one_mul] at hconst
  have hpt : ph t * ph (-t) = 1 := by
    simp only [ph, ← Complex.exp_add]
    rw [← Complex.exp_zero]
    congr 1
    push_cast
