/-!
# Capped kinetic observable under Galerkin evolution: `thm:mult-cap` for a fixed cap

`cube_tails_rate` is `lem:disc-tails` in its stated form: for `1 ≤ λ`, `2g ≤ λ ≤ K`, the tails of
`A ψ̂_N(s)`, `ψ̂_N(s)` and `(1 + A) ψ̂_N(s)` beyond `λ` are at most `β_N λ^{-1/2}`,
`(2m̄/λ²) β_N λ^{-1/2}` and `(1 + 2m̄) β_N λ^{-1/2}`, with `β_N = discTailConst` independent of the
cube and the time.

For the kinetic energy `A_r` of a particle `r`, a cap `κ` with `λ₀ ≤ κ ≤ K` (`λ₀ ≥ 1`,
`λ₀ ≥ 2g`), and `ψ₀ ∈ D(H²)`: split `A_r = μ_κ + (A_r - μ_κ)`.

* **Replacement** (`expect_le_tails_of_vanish` with the tails of `tails_at_time` and
  `cube_tails_rate` at `κ`): `0 ≤ ⟨u, (A_r - μ_κ) u⟩ ≤ ‖1_{>κ} û‖ ‖1_{>κ} A û‖` for
  `u ∈ {ψ(t), ψ_N(t)}`.
* **Capped projection term**: `⟨δ, μ_κ δ⟩ ≤ (η t_K)(η B)` as in `thm:mult-gal`.
* **Capped secular term** (`capped_secular_le`): the retained-space difference is a sum of two
  pairings `⟨η(t), μ_κ v⟩`, `v ∈ {P ψ(t), ψ_N(t)}` (`expect_sub_le_pairings`), each bounded by
  duality (`coulomb_duality`) with the `H²` norm of the backward flow of `μ_κ v` controlled by
  capped smearing (`norm_theta_capLift_le`, `lem:capsmear`): `O(t (1 + κ^{3/2}) K^{-3})`.

`kinetic_capped_error` assembles the explicit bound.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveKinetic

open PlaneWaveCertificate PlaneWaveDynamics

variable {eta : ℕ} {ν : Type} [Fintype ν]

omit [Fintype ν] in
/-- `|⟨S a, μ a⟩ - ⟨S b, μ b⟩| ≤ ‖⟪S a - S b, μ a⟫‖ + ‖⟪S a - S b, μ b⟫‖`. -/
lemma expect_sub_le_pairings {sys : CoulombSystem eta ν} {g : ℝ} (m : KinMult sys g)
    (a b : MolecularFourierH2 eta) :
    |m.expect (molecularH2StateMap eta g a) - m.expect (molecularH2StateMap eta g b)| ≤
      ‖⟪molecularH2StateMap eta g a - molecularH2StateMap eta g b, m.h2 a⟫_ℂ‖ +
        ‖⟪molecularH2StateMap eta g a - molecularH2StateMap eta g b, m.h2 b⟫_ℂ‖ := by
  have e : ((m.expect (molecularH2StateMap eta g a) - m.expect (molecularH2StateMap eta g b) :
      ℝ) : ℂ) = ⟪molecularH2StateMap eta g a - molecularH2StateMap eta g b, m.h2 a⟫_ℂ +
        ⟪m.h2 b, molecularH2StateMap eta g (a - b)⟫_ℂ := by
    push_cast
    rw [← m.inner_stateMap_h2_self, ← m.inner_stateMap_h2_self, ← m.inner_stateMap_h2,
      map_sub, inner_sub_left, inner_sub_right]
    ring
  have h2 : ‖⟪m.h2 b, molecularH2StateMap eta g (a - b)⟫_ℂ‖ =
      ‖⟪molecularH2StateMap eta g a - molecularH2StateMap eta g b, m.h2 b⟫_ℂ‖ := by
    rw [map_sub, norm_inner_symm]
  have h := norm_add_le ⟪molecularH2StateMap eta g a - molecularH2StateMap eta g b, m.h2 a⟫_ℂ
    ⟪m.h2 b, molecularH2StateMap eta g (a - b)⟫_ℂ
  rw [← e, h2, Complex.norm_real, Real.norm_eq_abs] at h
  exact h

/-! ## Tails of `(1 + A) û` -/

section ThetaTails

variable (sys : CoulombSystem eta ν) (L : ℝ)

omit [Fintype ν] in
/-- `‖1_{a,>λ} (1 + A) û‖ ≤ (1 + 2m̄/λ²) B` when `‖1_{a,>λ} A û‖ ≤ B`. -/
lemma theta_tail_le {lam : ℝ} (hlam : 0 < lam) (a : Fin eta) (v : MolecularFourierH2 eta) {B : ℝ}
    (hT : ‖tailMask (2 * Real.pi / L) lam a (coulombFourierKineticH2 sys (2 * Real.pi / L) v)‖ ≤
      B) :
    ‖tailMask (2 * Real.pi / L) lam a (molecularH2StateMap eta (2 * Real.pi / L) v +
        coulombFourierKineticH2 sys (2 * Real.pi / L) v)‖ ≤
      (1 + 2 * sys.maxMass / lam ^ 2) * B := by
  have hM := sys.one_le_maxMass
  rw [map_add]
  have hS := (tail_stateMap_le sys L hlam a v).trans
    (mul_le_mul_of_nonneg_left hT (by positivity))
  calc _ ≤ ‖tailMask (2 * Real.pi / L) lam a (molecularH2StateMap eta (2 * Real.pi / L) v)‖ +
        ‖tailMask (2 * Real.pi / L) lam a (coulombFourierKineticH2 sys (2 * Real.pi / L) v)‖ :=
        norm_add_le _ _
    _ ≤ (2 * sys.maxMass / lam ^ 2) * B + B := add_le_add hS hT
    _ = (1 + 2 * sys.maxMass / lam ^ 2) * B := by ring

lemma inv_sq_le_rho {lam : ℝ} (hl : 1 ≤ lam) : 1 / lam ^ 2 ≤ Real.sqrt (1 / lam) := by
  have hlpos : 0 < lam := by linarith
  set ρ := Real.sqrt (1 / lam)
  have hρ0 : 0 ≤ ρ := Real.sqrt_nonneg _
  have hρ2 : ρ ^ 2 = 1 / lam := Real.sq_sqrt (by positivity)
  have hρ1 : ρ ≤ 1 := by
    rw [Real.sqrt_le_one]
    rw [div_le_one hlpos]
    exact hl
  have e : 1 / lam ^ 2 = ρ ^ 4 := by
    rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul, hρ2]
    ring
  rw [e]
  calc ρ ^ 4 = ρ * ρ ^ 3 := by ring
    _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ0 hρ1) hρ0
    _ = ρ := mul_one _

/-- `(2m̄/λ²) X + c ρ_λ ≤ (2m̄ X + c) ρ_λ` for `λ ≥ 1`, `ρ_λ = λ^{-1/2}`. -/
lemma tail_rate_le {m X c lam : ℝ} (hm : 0 ≤ m) (hX : 0 ≤ X) (hl : 1 ≤ lam) :
    (2 * m / lam ^ 2) * X + c * Real.sqrt (1 / lam) ≤
      (2 * m * X + c) * Real.sqrt (1 / lam) := by
  have h := inv_sq_le_rho hl
  have e : 2 * m / lam ^ 2 * X = (2 * m * X) * (1 / lam ^ 2) := by ring
  rw [e, add_mul]
  have := mul_le_mul_of_nonneg_left h (by positivity : (0 : ℝ) ≤ 2 * m * X)
  linarith

end ThetaTails

/-! ## Capped smearing of a state -/

section CapTheta

variable (sys : CoulombSystem eta ν) (L : ℝ)

omit [Fintype ν] in
/-- **Capped smearing of a state** (`lem:capsmear`): if the tails of `(1 + A) û` at the
thresholds `λ₀ ≤ λ < κ` are at most `D λ^{-1/2}`, then
`Θ(μ_κ u) ≤ ½ (λ₀² Θ(u) + √15 D κ^{3/2})`. -/
lemma norm_theta_capLift_le (hL : 0 < L) (r : Fin eta) {κ lam0 D : ℝ} (hl : 1 ≤ lam0)
    (hlk : lam0 ≤ κ) (hD : 0 ≤ D) (u : MolecularFourierH2 eta)
    (htail : ∀ lam, lam0 ≤ lam → lam < κ →
      ‖tailMask (2 * Real.pi / L) lam r (molecularH2StateMap eta (2 * Real.pi / L) u +
        coulombFourierKineticH2 sys (2 * Real.pi / L) u)‖ ≤ D * Real.sqrt (1 / lam)) :
    ‖molecularH2StateMap eta (2 * Real.pi / L) (capLift sys (2 * Real.pi / L) r κ u) +
        coulombFourierKineticH2 sys (2 * Real.pi / L) (capLift sys (2 * Real.pi / L) r κ u)‖ ≤
      (1 / 2 : ℝ) * (lam0 ^ 2 * ‖molecularH2StateMap eta (2 * Real.pi / L) u +
        coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ +
          Real.sqrt 15 * D * (κ * Real.sqrt κ)) := by
  have hg : 0 ≤ 2 * Real.pi / L := by positivity
  refine norm_capped_le (2 * Real.pi / L) hg r _ _ hl hlk hD (fun p => ?_) htail
  rw [theta_vec_capLift, norm_mul, Complex.norm_real,
    Real.norm_of_nonneg (capSymbol_nonneg sys _ r κ p)]
  exact mul_le_mul_of_nonneg_right
    (capSymbol_le_min_sq sys _ r (by linarith) hg p) (norm_nonneg _)

end CapTheta

/-! ## The rate pieces -/

/-- With `ρ² K = 1`, `K ≥ 1`: `B = (2m/K²) X + c ρ ≤ (2m X + c) ρ`,
`t_K = (2m/K²) B ≤ 2m (2m X + c) ρ⁵`, and
`√((e t_K)(e (t_K + 2B))) ≤ e (2m X + c) ρ³ √(2m (2m + 2))`. -/
lemma tail_rate_pieces {e m X c ρ K B tK : ℝ} (he : 0 ≤ e) (hm : 1 ≤ m) (hX : 0 ≤ X)
    (hc : 0 ≤ c) (hρ : 0 ≤ ρ) (hρK : ρ ^ 2 * K = 1) (hK : 1 ≤ K)
    (hB : B = (2 * m / K ^ 2) * X + c * ρ) (htK : tK = (2 * m / K ^ 2) * B) :
    0 ≤ B ∧ B ≤ (2 * m * X + c) * ρ ∧ 0 ≤ tK ∧ tK ≤ 2 * m * (2 * m * X + c) * ρ ^ 5 ∧
      2 * m / K ^ 2 = 2 * m * ρ ^ 4 ∧
      Real.sqrt ((e * tK) * (e * (tK + 2 * B))) ≤
        e * (2 * m * X + c) * ρ ^ 3 * Real.sqrt (2 * m * (2 * m + 2)) := by
  set β := 2 * m * X + c with hβ
  have hm0 : 0 ≤ m := by linarith
  have hβ0 : 0 ≤ β := by positivity
  have hρ2 : ρ ^ 2 ≤ 1 := by nlinarith only [hρK, hK, sq_nonneg ρ]
  have hρ1 : ρ ≤ 1 := by nlinarith only [hρ2, hρ]
  have hKpos : 0 < K := by linarith
  have hK4 : K ^ 2 * ρ ^ 4 = 1 := by
    calc K ^ 2 * ρ ^ 4 = (ρ ^ 2 * K) ^ 2 := by ring
      _ = 1 := by rw [hρK]; norm_num
  have hinv : 2 * m / K ^ 2 = 2 * m * ρ ^ 4 := by
    rw [div_eq_iff (pow_pos hKpos 2).ne']
    linear_combination (-(2 * m)) * hK4
  have hρ4 : ρ ^ 4 ≤ ρ := by
    calc ρ ^ 4 = ρ * ρ ^ 3 := by ring
      _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ hρ1) hρ
      _ = ρ := mul_one _
  have hρ5 : ρ ^ 5 ≤ ρ := by
    calc ρ ^ 5 = ρ * ρ ^ 4 := by ring
      _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ hρ1) hρ
      _ = ρ := mul_one _
  have hB' : B ≤ β * ρ := by
    rw [hB, hinv, hβ]
    have := mul_le_mul_of_nonneg_left hρ4 (mul_nonneg (by linarith : (0:ℝ) ≤ 2 * m) hX)
    nlinarith only [this]
  have hB0 : 0 ≤ B := by rw [hB, hinv]; positivity
  have htK1 : tK ≤ 2 * m * β * ρ ^ 5 := by
    rw [htK, hinv]
    calc 2 * m * ρ ^ 4 * B ≤ 2 * m * ρ ^ 4 * (β * ρ) :=
          mul_le_mul_of_nonneg_left hB' (by positivity)
      _ = 2 * m * β * ρ ^ 5 := by ring
  have htK0 : 0 ≤ tK := by rw [htK, hinv]; positivity
  refine ⟨hB0, hB', htK0, htK1, hinv, ?_⟩
  have hprod : (e * tK) * (e * (tK + 2 * B)) ≤
      (e * β * ρ ^ 3) ^ 2 * (2 * m * (2 * m + 2)) := by
    have hsum : tK + 2 * B ≤ (2 * m + 2) * β * ρ := by
      have := mul_le_mul_of_nonneg_left hρ5 (by positivity : (0:ℝ) ≤ 2 * m * β)
      nlinarith only [htK1, hB', this]
    calc (e * tK) * (e * (tK + 2 * B)) ≤ (e * (2 * m * β * ρ ^ 5)) * (e * ((2 * m + 2) * β * ρ)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left htK1 he) (mul_le_mul_of_nonneg_left hsum he)
            (mul_nonneg he (by positivity)) (mul_nonneg he (by positivity))
      _ = (e * β * ρ ^ 3) ^ 2 * (2 * m * (2 * m + 2)) := by ring
  calc Real.sqrt ((e * tK) * (e * (tK + 2 * B))) ≤
        Real.sqrt ((e * β * ρ ^ 3) ^ 2 * (2 * m * (2 * m + 2))) := Real.sqrt_le_sqrt hprod
    _ = e * β * ρ ^ 3 * Real.sqrt (2 * m * (2 * m + 2)) := by
        rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by positivity)]

/-! ## `lem:disc-tails` in its stated form -/

/-- The constant `β_N = 2 m̄ Ξ_N + ν_N + C_tail(M_N)` of the Galerkin tails (`lem:disc-tails`), for
the data norms `‖ψ₀‖ = s0`, `‖H ψ₀‖ = hu = hs` and `‖H² ψ₀‖ = hv` (as in `capConsts`); it does not
depend on the cube, the time or the threshold. -/
noncomputable def discTailConst (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker : ℝ)
    (s0 hu hs hv : ℝ) : ℝ :=
  let b : ℝ := relB sys L Hunit
  let m : ℝ := sys.maxMass
  let Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
  let Ξ₀ : ℝ := 2 * hu + 2 * b * s0
  let Ξ₁ : ℝ := 2 * hv + 2 * b * hs
  let ΞN : ℝ := 2 * (2 * Ξ₁ + 2 * b * hs) + 2 * b * hs
  let MN : ℝ := m * (s0 + 2 * (2 * (2 * Ξ₀ + 2 * b * s0) + 2 * b * s0))
  let β : ℝ := 2 * m * Ξ₁ + Ct (m * (s0 + 2 * Ξ₀))
  let νN : ℝ := finiteCoulombPhysicalMassConstant sys L Hunit *
    ((eta : ℝ) * β * Real.sqrt (2 * m * (2 * m + 2)))
  2 * m * ΞN + νN + Ct MN

section DiscTails

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **`lem:disc-tails`** (in its stated form). For `ψ₀ = S u₀ ∈ D(H²)` (`H u₀ = S v₀`), the
Galerkin trajectory `ψ_N(s) = e^{-iH_N s} P ψ₀` on the cube `n` (`K = g n`), every time `s`,
register `a` and threshold `λ` with `1 ≤ λ` and `2g ≤ λ ≤ K`:
`‖1_{a,>λ} A ψ̂_N(s)‖ ≤ β_N λ^{-1/2}`, `‖1_{a,>λ} ψ̂_N(s)‖ ≤ (2m̄/λ²) β_N λ^{-1/2}` and
`‖1_{a,>λ} (1 + A) ψ̂_N(s)‖ ≤ (1 + 2m̄) β_N λ^{-1/2}`, with `β_N = discTailConst`, which depends
only on the system, `L` and `‖ψ₀‖, ‖H ψ₀‖, ‖H² ψ₀‖` (not on `n`, `s` or `λ`). From
`cube_tails_at_time`, with the backscattered term `‖W (1 - P) ψ₀‖ = O(K^{-3/2}) ≤ O(λ^{-1/2})`
(`backscatter_initial_le`). -/
theorem cube_tails_rate (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (Blow Cs Bker : ℝ) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (s : ℝ) (a : Fin eta) {lam : ℝ} (hl1 : 1 ≤ lam) (h2g : 2 * (2 * Real.pi / L) ≤ lam)
    (hlK : lam ≤ (2 * Real.pi / L) * n) :
    let βN := discTailConst sys L Hunit Blow Cs Bker
      ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ ‖H u₀‖
      ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ ‖H v₀‖
    let l := cubeLift (2 * Real.pi / L) n
      (UN s (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀)))
    ‖tailMask (2 * Real.pi / L) lam a (coulombFourierKineticH2 sys (2 * Real.pi / L) l)‖ ≤
        βN * Real.sqrt (1 / lam) ∧
      ‖tailMask (2 * Real.pi / L) lam a (molecularH2StateMap eta (2 * Real.pi / L) l)‖ ≤
        (2 * sys.maxMass / lam ^ 2) * (βN * Real.sqrt (1 / lam)) ∧
      ‖tailMask (2 * Real.pi / L) lam a (molecularH2StateMap eta (2 * Real.pi / L) l +
        coulombFourierKineticH2 sys (2 * Real.pi / L) l)‖ ≤
        (1 + 2 * sys.maxMass) * βN * Real.sqrt (1 / lam) := by
  intro βN l
  have hM := sys.one_le_maxMass
  have hm0 : 0 ≤ sys.maxMass := by linarith
  have hb : 0 ≤ relB sys L Hunit := relB_nonneg sys L Hunit hC
  have hK1 : 1 ≤ (2 * Real.pi / L) * n := hl1.trans hlK
  have h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n := h2g.trans hlK
  have hKpos : 0 < (2 * Real.pi / L) * n := lt_of_lt_of_le zero_lt_one hK1
  have hlam0 : 0 < lam := lt_of_lt_of_le zero_lt_one hl1
  -- the scales
  set ρ := Real.sqrt (1 / ((2 * Real.pi / L) * n)) with hρdef
  have hρ0 : 0 ≤ ρ := Real.sqrt_nonneg _
  have hρK : ρ ^ 2 * ((2 * Real.pi / L) * n) = 1 := by
    rw [hρdef, Real.sq_sqrt (one_div_nonneg.mpr hKpos.le)]
    exact one_div_mul_cancel hKpos.ne'
  have hρ1 : ρ ≤ 1 := by
    rw [hρdef, Real.sqrt_le_one, div_le_one hKpos]
    exact hK1
  have hρ3 : ρ ^ 3 ≤ ρ := by
    calc ρ ^ 3 = ρ * ρ ^ 2 := by ring
      _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ0 hρ1) hρ0
      _ = ρ := mul_one _
  have hρl : ρ ≤ Real.sqrt (1 / lam) :=
    Real.sqrt_le_sqrt (one_div_le_one_div_of_le hlam0 hlK)
  have hρl1 : Real.sqrt (1 / lam) ^ 2 * lam = 1 := by
    rw [Real.sq_sqrt (one_div_nonneg.mpr hlam0.le)]
    exact one_div_mul_cancel hlam0.ne'
  -- the data, in the forms of `cube_tails_at_time` and `discTailConst`
  set b := relB sys L Hunit
  set m := sys.maxMass
  set S0 := ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖
  set H0 := ‖H u₀‖
  set S1 := ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖
  set H1 := ‖H v₀‖
  set Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
    with hCtdef
  set Ξ₀ := 2 * H0 + 2 * b * S0 with hΞ₀def
  set Ξ₁ := 2 * H1 + 2 * b * S1 with hΞ₁def
  set ΞN := 2 * (2 * Ξ₁ + 2 * b * S1) + 2 * b * S1 with hΞNdef
  set MN := m * (S0 + 2 * (2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0)) with hMNdef
  set c0 := Ct (m * (S0 + 2 * Ξ₀)) with hc0def
  set β := 2 * m * Ξ₁ + c0 with hβdef
  set νN := finiteCoulombPhysicalMassConstant sys L Hunit *
    ((eta : ℝ) * β * Real.sqrt (2 * m * (2 * m + 2))) with hνNdef
  have hβN : βN = 2 * m * ΞN + νN + Ct MN := rfl
  have hS00 : 0 ≤ S0 := norm_nonneg _
  have hH00 : 0 ≤ H0 := norm_nonneg _
  have hS10 : 0 ≤ S1 := norm_nonneg _
  have hH10 : 0 ≤ H1 := norm_nonneg _
  have h2b : 0 ≤ 2 * b := mul_nonneg zero_le_two hb
  have h2m : 0 ≤ 2 * m := mul_nonneg zero_le_two hm0
  have hΞ₀ : 0 ≤ Ξ₀ := add_nonneg (mul_nonneg zero_le_two hH00) (mul_nonneg h2b hS00)
  have hΞ₁ : 0 ≤ Ξ₁ := add_nonneg (mul_nonneg zero_le_two hH10) (mul_nonneg h2b hS10)
  have hΞN : 0 ≤ ΞN := add_nonneg (mul_nonneg zero_le_two (add_nonneg
    (mul_nonneg zero_le_two hΞ₁) (mul_nonneg h2b hS10))) (mul_nonneg h2b hS10)
  have hc0 : 0 ≤ c0 :=
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker
      (mul_nonneg hm0 (add_nonneg hS00 (mul_nonneg zero_le_two hΞ₀)))
  have hβ : 0 ≤ β := add_nonneg (mul_nonneg h2m hΞ₁) hc0
  have hνN : 0 ≤ νN :=
    mul_nonneg hC (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hβ) (Real.sqrt_nonneg _))
  have hTN : 0 ≤ 2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0 := add_nonneg (mul_nonneg zero_le_two
    (add_nonneg (mul_nonneg zero_le_two hΞ₀) (mul_nonneg h2b hS00))) (mul_nonneg h2b hS00)
  have hMN : 0 ≤ MN := mul_nonneg hm0 (add_nonneg hS00 (mul_nonneg zero_le_two hTN))
  have hcN : 0 ≤ Ct MN :=
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker hMN
  have hβN0 : 0 ≤ βN := by
    rw [hβN]; exact add_nonneg (add_nonneg (mul_nonneg h2m hΞN) hνN) hcN
  -- the backscattered initial term `‖W (1 - P) ψ₀‖ ≤ ν_N K^{-3/2} ≤ ν_N λ^{-1/2}`
  set B := (2 * m / ((2 * Real.pi / L) * n) ^ 2) * Ξ₁ + c0 * ρ with hBdef
  set tK := (2 * m / ((2 * Real.pi / L) * n) ^ 2) * B with htKdef
  obtain ⟨-, -, -, -, -, hsqrt⟩ := tail_rate_pieces (e := (eta : ℝ))
    (Nat.cast_nonneg eta) hM hΞ₁ hc0 hρ0 hρK hK1 hBdef htKdef
  set N₀ := finiteCoulombPhysicalMassConstant sys L Hunit *
    Real.sqrt ((eta * tK) * (eta * (tK + 2 * B))) with hN₀def
  have hN0' : ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H (u₀ - molecularH2Truncate n u₀)‖ ≤
      N₀ := backscatter_initial_le sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph n ρ Blow Cs
    Bker hK1 hρ0 hρK hBlow hCs hBker h2gK hAmplitude hBkerScale hCsScale u₀ v₀ huv
  have hN₀le : N₀ ≤ νN * Real.sqrt (1 / lam) := by
    have h1 : N₀ ≤ finiteCoulombPhysicalMassConstant sys L Hunit *
        ((eta : ℝ) * β * ρ ^ 3 * Real.sqrt (2 * m * (2 * m + 2))) :=
      mul_le_mul_of_nonneg_left hsqrt hC
    calc N₀ ≤ finiteCoulombPhysicalMassConstant sys L Hunit *
          ((eta : ℝ) * β * ρ ^ 3 * Real.sqrt (2 * m * (2 * m + 2))) := h1
      _ = νN * ρ ^ 3 := by rw [hνNdef]; ring
      _ ≤ νN * Real.sqrt (1 / lam) := mul_le_mul_of_nonneg_left (hρ3.trans hρl) hνN
  -- the tails of `cube_tails_at_time` at `λ`
  have h := cube_tails_at_time sys L H hKernel Hunit hL hPeriodic hC n UN hNcomm a lam
    (Real.sqrt (1 / lam)) Blow Cs Bker hl1 (Real.sqrt_nonneg _) hρl1 hBlow hCs hBker h2g
    hAmplitude hBkerScale hCsScale u₀ v₀ huv N₀ hN0' s
  have hBl : (2 * m / lam ^ 2) * ΞN + N₀ + Ct MN * Real.sqrt (1 / lam) ≤
      βN * Real.sqrt (1 / lam) := by
    have h1 := tail_rate_le (c := Ct MN) hm0 hΞN hl1
    have e : βN * Real.sqrt (1 / lam) = (2 * m * ΞN + Ct MN) * Real.sqrt (1 / lam) +
        νN * Real.sqrt (1 / lam) := by rw [hβN]; ring
    rw [e]
    linarith only [h1, hN₀le]
  have hT : ‖tailMask (2 * Real.pi / L) lam a (coulombFourierKineticH2 sys (2 * Real.pi / L) l)‖ ≤
      βN * Real.sqrt (1 / lam) := h.1.trans hBl
  have hS : ‖tailMask (2 * Real.pi / L) lam a (molecularH2StateMap eta (2 * Real.pi / L) l)‖ ≤
      (2 * m / lam ^ 2) * (βN * Real.sqrt (1 / lam)) :=
    h.2.trans (mul_le_mul_of_nonneg_left hBl (div_nonneg h2m (sq_nonneg lam)))
  refine ⟨hT, hS, ?_⟩
  -- the `(1 + A)` form
  have hw : 2 * m / lam ^ 2 ≤ 2 * m := by
    have hl2 : 1 ≤ lam ^ 2 := one_le_pow₀ hl1
    exact div_le_self h2m hl2
  have hβl : 0 ≤ βN * Real.sqrt (1 / lam) := mul_nonneg hβN0 (Real.sqrt_nonneg _)
  calc ‖tailMask (2 * Real.pi / L) lam a (molecularH2StateMap eta (2 * Real.pi / L) l +
        coulombFourierKineticH2 sys (2 * Real.pi / L) l)‖
      ≤ ‖tailMask (2 * Real.pi / L) lam a (molecularH2StateMap eta (2 * Real.pi / L) l)‖ +
          ‖tailMask (2 * Real.pi / L) lam a (coulombFourierKineticH2 sys (2 * Real.pi / L) l)‖ := by
        rw [map_add]; exact norm_add_le _ _
    _ ≤ (2 * m / lam ^ 2) * (βN * Real.sqrt (1 / lam)) + βN * Real.sqrt (1 / lam) :=
        add_le_add hS hT
    _ ≤ 2 * m * (βN * Real.sqrt (1 / lam)) + βN * Real.sqrt (1 / lam) := by
        have := mul_le_mul_of_nonneg_right hw hβl
        linarith only [this]
    _ = (1 + 2 * m) * βN * Real.sqrt (1 / lam) := by ring

end DiscTails

/-! ## The capped secular term -/

section Secular

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **The capped secular term.** With `v ∈ {P ψ(t), ψ_N(t)}` and the tails of `(1 + A) v̂` at the
thresholds `λ₀ ≤ λ < κ` at most `D λ^{-1/2}`, the retained-space difference of the capped
expectations is at most `t (η t_K)(η C_tail(M_a) K^{-1/2}) + t (η t_K)(η C_tail(M_b) K^{-1/2})`,
where `M_a`, `M_b` bound the `H²` norms of the backward flows of `μ_κ v` (by capped smearing). -/
theorem capped_secular_le (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x)
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (rho Blow Cs Bker : ℝ) (hK1 : 1 ≤ (2 * Real.pi / L) * n)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * ((2 * Real.pi / L) * n) = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ (2 * Real.pi / L) * n)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (r : Fin eta) {κ lam0 Da Db : ℝ} (hl : 1 ≤ lam0) (hlk : lam0 ≤ κ) (hDa : 0 ≤ Da)
    (hDb : 0 ≤ Db) {t : ℝ} (ht : 0 ≤ t) (u : MolecularFourierH2 eta)
    (hu1 : molecularH2StateMap eta (2 * Real.pi / L) u =
      U t (molecularH2StateMap eta (2 * Real.pi / L) u₀))
    (hu2 : H u = U t (H u₀))
    (htA : ∀ lam, lam0 ≤ lam → lam < κ →
      ‖tailMask (2 * Real.pi / L) lam r (molecularH2StateMap eta (2 * Real.pi / L) u +
        coulombFourierKineticH2 sys (2 * Real.pi / L) u)‖ ≤ Da * Real.sqrt (1 / lam))
    (htB : ∀ lam, lam0 ≤ lam → lam < κ →
      ‖tailMask (2 * Real.pi / L) lam r (molecularH2StateMap eta (2 * Real.pi / L)
          (cubeLift (2 * Real.pi / L) n (UN t (extractCLM n
            (molecularH2StateMap eta (2 * Real.pi / L) u₀)))) +
        coulombFourierKineticH2 sys (2 * Real.pi / L) (cubeLift (2 * Real.pi / L) n
          (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀)))))‖ ≤
        Db * Real.sqrt (1 / lam)) :
    let K := (2 * Real.pi / L) * n
    let b := relB sys L Hunit
    let S0 := ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖
    let Ξ₀ := 2 * ‖H u₀‖ + 2 * b * S0
    let TN := 2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0
    let Ma := sys.maxMass * (Ξ₀ + 2 * (2 * (2 * ((1 / 2 : ℝ) * (lam0 ^ 2 * (S0 + Ξ₀) +
      Real.sqrt 15 * Da * (κ * Real.sqrt κ))) + 2 * b * Ξ₀) + 2 * b * Ξ₀))
    let Mb := sys.maxMass * (TN + 2 * (2 * (2 * ((1 / 2 : ℝ) * (lam0 ^ 2 * (S0 + TN) +
      Real.sqrt 15 * Db * (κ * Real.sqrt κ))) + 2 * b * TN) + 2 * b * TN))
    let B := (2 * sys.maxMass / K ^ 2) * (2 * ‖H v₀‖ + 2 * relB sys L Hunit *
            ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖) +
          finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
            (sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ +
              2 * (2 * ‖H u₀‖ + 2 * relB sys L Hunit *
                ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖))) * rho
    let tK := (2 * sys.maxMass / K ^ 2) * B
    |(capKin sys (2 * Real.pi / L) r κ).expect (molecularH2StateMap eta (2 * Real.pi / L)
        (molecularH2Truncate n u)) -
      (capKin sys (2 * Real.pi / L) r κ).expect (molecularH2StateMap eta (2 * Real.pi / L)
        (cubeLift (2 * Real.pi / L) n (UN t (extractCLM n
          (molecularH2StateMap eta (2 * Real.pi / L) u₀)))))| ≤
      ((eta * tK) * (eta * (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker Ma * rho))) *
          t +
        ((eta * tK) *
          (eta * (finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker Mb * rho))) * t := by
  intro K b S0 Ξ₀ TN Ma Mb B tK
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hM := sys.one_le_maxMass
  have hb : 0 ≤ b := relB_nonneg sys L Hunit hC
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set T := coulombFourierKineticH2 sys (2 * Real.pi / L)
  set μ := capKin sys (2 * Real.pi / L) r κ
  set y := UN t (extractCLM n (S u₀))
  set l := cubeLift (2 * Real.pi / L) n y
  -- the data
  have hS0 : ‖S u‖ = S0 := by rw [hu1, LinearIsometryEquiv.norm_map]
  have hTu : ‖T u‖ ≤ Ξ₀ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u
    rwa [hu1, hu2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
  have hE : ‖extractCLM n (S u₀)‖ ≤ S0 := norm_extractCLM_le n (S u₀)
  have hTl : ‖T l‖ ≤ TN := by
    have h := elliptic_cube sys L H hKernel Hunit hL hPeriodic hC n y
    have hy : ‖finiteCoulombHamiltonian sys L n y‖ =
        ‖finiteCoulombHamiltonian sys L n (extractCLM n (S u₀))‖ := by
      rw [← hNcomm, LinearIsometryEquiv.norm_map]
    have hy2 : ‖y‖ = ‖extractCLM n (S u₀)‖ := LinearIsometryEquiv.norm_map _ _
    have hH := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n u₀
    have hT0 : ‖T u₀‖ ≤ Ξ₀ := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u₀
    have hbE : b * ‖extractCLM n (S u₀)‖ ≤ b * S0 := mul_le_mul_of_nonneg_left hE hb
    rw [hy, hy2] at h
    linarith
  have hSl : ‖S l‖ ≤ S0 := by
    rw [stateMap_cubeLift, LinearIsometry.norm_map, LinearIsometryEquiv.norm_map]
    exact hE
  have hΞ₀ : 0 ≤ Ξ₀ := (norm_nonneg _).trans hTu
  have hTN : 0 ≤ TN := (norm_nonneg _).trans hTl
  have hS00 : 0 ≤ S0 := norm_nonneg _
  -- the pairing identity
  have hpair := expect_sub_le_pairings μ (molecularH2Truncate n u) l
  have hSa : S (molecularH2Truncate n u) = finiteFourierLpIsometry eta n (extractCLM n (S u)) := by
    rw [stateMap_truncate, emb_extractCLM]
  have hSb : S l = finiteFourierLpIsometry eta n y := stateMap_cubeLift _ n y
  rw [hSa, hSb, ← LinearIsometry.map_sub, inner_emb_left, inner_emb_left] at hpair
  have hwa : extractCLM n (μ.h2 (molecularH2Truncate n u)) =
      extractCLM n (S (capLift sys (2 * Real.pi / L) r κ u)) := by
    rw [μ.h2_truncate, extract_truncate, stateMap_capLift]
  have hwb : extractCLM n (μ.h2 l) = extractCLM n (S (capLift sys (2 * Real.pi / L) r κ l)) := by
    rw [stateMap_capLift]
  rw [hwa, hwb, hu1] at hpair
  -- the test vectors
  have hFa : ‖S u + T u‖ ≤ S0 + Ξ₀ := (norm_add_le _ _).trans (by rw [hS0]; linarith)
  have hFb : ‖S l + T l‖ ≤ S0 + TN := (norm_add_le _ _).trans (add_le_add hSl hTl)
  have hGa := norm_theta_capLift_le sys L hL r hl hlk hDa u htA
  have hGb := norm_theta_capLift_le sys L hL r hl hlk hDb l htB
  have hMgen : ∀ (v : MolecularFourierH2 eta) (W0 F0 D : ℝ), ‖T v‖ ≤ W0 →
      ‖S v + T v‖ ≤ F0 → 0 ≤ D →
      ‖S (capLift sys (2 * Real.pi / L) r κ v) + T (capLift sys (2 * Real.pi / L) r κ v)‖ ≤
        (1 / 2 : ℝ) * (lam0 ^ 2 * ‖S v + T v‖ + Real.sqrt 15 * D * (κ * Real.sqrt κ)) →
      sys.maxMass * (‖extractCLM n (S (capLift sys (2 * Real.pi / L) r κ v))‖ +
        2 * (2 * ‖finiteCoulombHamiltonian sys L n
          (extractCLM n (S (capLift sys (2 * Real.pi / L) r κ v)))‖ +
          2 * relB sys L Hunit * ‖extractCLM n (S (capLift sys (2 * Real.pi / L) r κ v))‖)) ≤
      sys.maxMass * (W0 + 2 * (2 * (2 * ((1 / 2 : ℝ) * (lam0 ^ 2 * F0 +
        Real.sqrt 15 * D * (κ * Real.sqrt κ))) + 2 * b * W0) + 2 * b * W0)) := by
    intro v W0 F0 D hTv hFv hD hG
    have hw : ‖extractCLM n (S (capLift sys (2 * Real.pi / L) r κ v))‖ ≤ W0 := by
      refine (norm_extractCLM_le n _).trans ?_
      rw [stateMap_capLift]
      exact (μ.norm_h2_le v).trans hTv
    have hH := finiteH_extract_le sys L H hKernel Hunit hL hPeriodic hC n
      (capLift sys (2 * Real.pi / L) r κ v)
    have hTc : ‖T (capLift sys (2 * Real.pi / L) r κ v)‖ ≤
        (1 / 2 : ℝ) * (lam0 ^ 2 * F0 + Real.sqrt 15 * D * (κ * Real.sqrt κ)) := by
      refine (norm_kinetic_le_theta sys _ _).trans (hG.trans ?_)
      have : lam0 ^ 2 * ‖S v + T v‖ ≤ lam0 ^ 2 * F0 :=
        mul_le_mul_of_nonneg_left hFv (sq_nonneg _)
      linarith
    have hSc : ‖S (capLift sys (2 * Real.pi / L) r κ v)‖ ≤ W0 := by
      rw [stateMap_capLift]
      exact (μ.norm_h2_le v).trans hTv
    have hbS : b * ‖S (capLift sys (2 * Real.pi / L) r κ v)‖ ≤ b * W0 :=
      mul_le_mul_of_nonneg_left hSc hb
    have hbw : b * ‖extractCLM n (S (capLift sys (2 * Real.pi / L) r κ v))‖ ≤ b * W0 :=
      mul_le_mul_of_nonneg_left hw hb
    apply mul_le_mul_of_nonneg_left _ (by linarith)
    have hb2 : relB sys L Hunit = b := rfl
    rw [hb2]
    linarith
  have hMa := hMgen u Ξ₀ (S0 + Ξ₀) Da hTu hFa hDa hGa
  have hMb := hMgen l TN (S0 + TN) Db hTl hFb hDb hGb
  have hda := coulomb_duality sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph hderiv n UN hN0
    hNcomm hNderiv rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
    hBkerScale hCsScale u₀ v₀ huv _ Ma hMa ht
  have hdb := coulomb_duality sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph hderiv n UN hN0
    hNcomm hNderiv rho Blow Cs Bker hK1 hRho hRhoScale hBlow hCs hBker h2gK hAmplitude
    hBkerScale hCsScale u₀ v₀ huv _ Mb hMb ht
  rw [hSa, hSb, hu1]
  exact hpair.trans (add_le_add hda hdb)

end Secular

/-! ## The capped bound in rate form -/

/-- The constants `(c₁, c₂, c₃)` of the capped bound
`c₁ K^{-3} + c₂ κ^{-3} + c₃ t κ^{3/2} K^{-3}`, for the data norms `‖ψ₀‖ = s0`,
`‖H ψ₀‖ = hu = hs` (two copies, as in `obsConsts`) and `‖H² ψ₀‖ = hv`, and the lowest threshold
`λ₀`; they do not depend on `K`, `κ` or `t`. -/
noncomputable def capConsts (sys : CoulombSystem eta ν) (L Hunit Blow Cs Bker lam0 : ℝ)
    (s0 hu hs hv : ℝ) : ℝ × ℝ × ℝ :=
  let b : ℝ := relB sys L Hunit
  let m : ℝ := sys.maxMass
  let Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
  let Ξ₀ : ℝ := 2 * hu + 2 * b * s0
  let Ξ₁ : ℝ := 2 * hv + 2 * b * hs
  let TN : ℝ := 2 * (2 * Ξ₀ + 2 * b * s0) + 2 * b * s0
  let ΞN : ℝ := 2 * (2 * Ξ₁ + 2 * b * hs) + 2 * b * hs
  let MN : ℝ := m * (s0 + 2 * (2 * (2 * Ξ₀ + 2 * b * s0) + 2 * b * s0))
  let β : ℝ := 2 * m * Ξ₁ + Ct (m * (s0 + 2 * Ξ₀))
  let νN : ℝ := finiteCoulombPhysicalMassConstant sys L Hunit *
    ((eta : ℝ) * β * Real.sqrt (2 * m * (2 * m + 2)))
  let βN : ℝ := 2 * m * ΞN + νN + Ct MN
  let Da : ℝ := (1 + 2 * m) * β
  let Db : ℝ := (1 + 2 * m) * βN
  let α₀ : ℝ := m * (Ξ₀ + 4 * lam0 ^ 2 * (s0 + Ξ₀) + 12 * b * Ξ₀) +
    m * (TN + 4 * lam0 ^ 2 * (s0 + TN) + 12 * b * TN)
  let α₁ : ℝ := 4 * m * Real.sqrt 15 * (Da + Db)
  (2 * m * (eta : ℝ) ^ 2 * β ^ 2, 2 * m * β ^ 2 + 2 * m * βN ^ 2,
    2 * m * (eta : ℝ) ^ 2 * β * Ct 1 * (α₀ + α₁))

section CappedError

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **`thm:mult-cap`, Galerkin, for a fixed cap.** For `ψ₀ = S u₀ ∈ D(H²)` (`H u₀ = S v₀`), a
particle `r` and a cap `κ` with `λ₀ ≤ κ ≤ K` (`1 ≤ λ₀`, `2g ≤ λ₀`),
`|⟨ψ(t), A_r ψ(t)⟩ - ⟨ψ_N(t), A_r ψ_N(t)⟩| ≤ c₁ K^{-3} + c₂ κ^{-3} + c₃ t κ^{3/2} K^{-3}`
with `(c₁, c₂, c₃) = capConsts`. -/
theorem kinetic_capped_error (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) (h0 : ∀ x, U 0 x = x)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (hderiv : ∀ t u, HasDerivAt (fun s => U s (molecularH2StateMap eta (2 * Real.pi / L) u))
      (-(Complex.I • U t (H u))) t)
    (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hN0 : ∀ x, UN 0 x = x)
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (hNderiv : ∀ t x, HasDerivAt (fun s => UN s x)
      (-(Complex.I • UN t (finiteCoulombHamiltonian sys L n x))) t)
    (Blow Cs Bker : ℝ) (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (r : Fin eta) {κ lam0 : ℝ} (hl : 1 ≤ lam0) (h2g : 2 * (2 * Real.pi / L) ≤ lam0)
    (hlk : lam0 ≤ κ) (hκK : κ ≤ (2 * Real.pi / L) * n) {t : ℝ} (ht : 0 ≤ t) :
    let K := (2 * Real.pi / L) * n
    let c := capConsts sys L Hunit Blow Cs Bker lam0
      ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ ‖H u₀‖
      ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖ ‖H v₀‖
    |(regKin sys (2 * Real.pi / L) r).expect (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀)) -
        (regKin sys (2 * Real.pi / L) r).expect (finiteFourierLpIsometry eta n
          (UN t (extractCLM n (molecularH2StateMap eta (2 * Real.pi / L) u₀))))| ≤
      c.1 * (1 / K) ^ 3 + c.2.1 * (1 / κ) ^ 3 + c.2.2 * t * (κ * Real.sqrt κ) * (1 / K) ^ 3 := by
  intro K c
  have hg : 0 < 2 * Real.pi / L := by positivity
  have hM := sys.one_le_maxMass
  have hm0 : 0 ≤ sys.maxMass := by linarith
  have hb : 0 ≤ relB sys L Hunit := relB_nonneg sys L Hunit hC
  have hK1 : 1 ≤ K := hl.trans (hlk.trans hκK)
  have h2gK : 2 * (2 * Real.pi / L) ≤ K := h2g.trans (hlk.trans hκK)
  have hκ1 : 1 ≤ κ := hl.trans hlk
  have h2gκ : 2 * (2 * Real.pi / L) ≤ κ := h2g.trans hlk
  have hKpos : 0 < K := by linarith
  have hκpos : 0 < κ := by linarith
  -- the scales
  set ρ := Real.sqrt (1 / K) with hρdef
  set ρκ := Real.sqrt (1 / κ) with hρκdef
  have hρ0 : 0 ≤ ρ := Real.sqrt_nonneg _
  have hρκ0 : 0 ≤ ρκ := Real.sqrt_nonneg _
  have hρK : ρ ^ 2 * K = 1 := by
    rw [hρdef, Real.sq_sqrt (one_div_nonneg.mpr hKpos.le)]; field_simp
  have hρκκ : ρκ ^ 2 * κ = 1 := by
    rw [hρκdef, Real.sq_sqrt (one_div_nonneg.mpr hκpos.le)]; field_simp
  have hρ6 : ρ ^ 6 = (1 / K) ^ 3 := by
    rw [show (6 : ℕ) = 2 * 3 by norm_num, pow_mul, hρdef,
      Real.sq_sqrt (one_div_nonneg.mpr hKpos.le)]
  have hρκ6 : ρκ ^ 6 = (1 / κ) ^ 3 := by
    rw [show (6 : ℕ) = 2 * 3 by norm_num, pow_mul, hρκdef,
      Real.sq_sqrt (one_div_nonneg.mpr hκpos.le)]
  have hinvκ : 2 * sys.maxMass / κ ^ 2 = 2 * sys.maxMass * ρκ ^ 4 := by
    have hk4 : κ ^ 2 * ρκ ^ 4 = 1 := by
      calc κ ^ 2 * ρκ ^ 4 = (ρκ ^ 2 * κ) ^ 2 := by ring
        _ = 1 := by rw [hρκκ]; norm_num
    rw [div_eq_iff (pow_pos hκpos 2).ne']
    linear_combination (-(2 * sys.maxMass)) * hk4
  have hκs : 1 ≤ κ * Real.sqrt κ := by
    have : 1 ≤ Real.sqrt κ := by rw [Real.le_sqrt (by norm_num) hκpos.le]; linarith
    exact one_le_mul_of_one_le_of_one_le hκ1 this
  -- notation for the data (in the forms of the lemmas used below)
  set S := molecularH2StateMap eta (2 * Real.pi / L)
  set T := coulombFourierKineticH2 sys (2 * Real.pi / L)
  set b := relB sys L Hunit
  set m := sys.maxMass
  set S0 := ‖S u₀‖
  set H0 := ‖H u₀‖
  set S1 := ‖S v₀‖
  set H1 := ‖H v₀‖
  set Ct : ℝ → ℝ := fun M => finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M
    with hCtdef
  have hCt : ∀ M, Ct M = M * Ct 1 := fun M => tailConstant_linear sys L Hunit Blow Cs Bker M
  have hCt1 : 0 ≤ Ct 1 := finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker
    zero_le_one
  set Ξ₀ := 2 * H0 + 2 * b * S0 with hΞ₀def
  set Ξ₁ := 2 * H1 + 2 * b * S1 with hΞ₁def
  set TN := 2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0 with hTNdef
  set ΞN := 2 * (2 * Ξ₁ + 2 * b * S1) + 2 * b * S1 with hΞNdef
  set MN := m * (S0 + 2 * (2 * (2 * Ξ₀ + 2 * b * S0) + 2 * b * S0)) with hMNdef
  set c0 := Ct (m * (S0 + 2 * Ξ₀)) with hc0def
  set β := 2 * m * Ξ₁ + c0 with hβdef
  set νN := finiteCoulombPhysicalMassConstant sys L Hunit *
    ((eta : ℝ) * β * Real.sqrt (2 * m * (2 * m + 2))) with hνNdef
  set βN := 2 * m * ΞN + νN + Ct MN with hβNdef
  set Da := (1 + 2 * m) * β with hDadef
  set Db := (1 + 2 * m) * βN with hDbdef
  have hS00 : 0 ≤ S0 := norm_nonneg _
  have hH00 : 0 ≤ H0 := norm_nonneg _
  have hS10 : 0 ≤ S1 := norm_nonneg _
  have hH10 : 0 ≤ H1 := norm_nonneg _
  have h2b : 0 ≤ 2 * b := mul_nonneg zero_le_two hb
  have h2m : 0 ≤ 2 * m := mul_nonneg zero_le_two hm0
  have hΞ₀ : 0 ≤ Ξ₀ := add_nonneg (mul_nonneg zero_le_two hH00) (mul_nonneg h2b hS00)
  have hΞ₁ : 0 ≤ Ξ₁ := add_nonneg (mul_nonneg zero_le_two hH10) (mul_nonneg h2b hS10)
  have hΞN : 0 ≤ ΞN := add_nonneg (mul_nonneg zero_le_two (add_nonneg
    (mul_nonneg zero_le_two hΞ₁) (mul_nonneg h2b hS10))) (mul_nonneg h2b hS10)
  have hTN : 0 ≤ TN := add_nonneg (mul_nonneg zero_le_two (add_nonneg
    (mul_nonneg zero_le_two hΞ₀) (mul_nonneg h2b hS00))) (mul_nonneg h2b hS00)
  have hMN : 0 ≤ MN := mul_nonneg hm0 (add_nonneg hS00 (mul_nonneg zero_le_two hTN))
  have hc0 : 0 ≤ c0 :=
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker
      (mul_nonneg hm0 (add_nonneg hS00 (mul_nonneg zero_le_two hΞ₀)))
  have hβ : 0 ≤ β := add_nonneg (mul_nonneg h2m hΞ₁) hc0
  have hνN : 0 ≤ νN :=
    mul_nonneg hC (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hβ) (Real.sqrt_nonneg _))
  have hcN : 0 ≤ Ct MN :=
    finiteCoulombPhysicalTailConstant_nonneg sys L Hunit hBlow hCs hBker hMN
  have hβN : 0 ≤ βN := add_nonneg (add_nonneg (mul_nonneg h2m hΞN) hνN) hcN
  have hDa : 0 ≤ Da := mul_nonneg (add_nonneg zero_le_one h2m) hβ
  have hDb : 0 ≤ Db := mul_nonneg (add_nonneg zero_le_one h2m) hβN
  -- the tails at the cube momentum
  set B := (2 * m / K ^ 2) * Ξ₁ + c0 * ρ with hBdef
  set tK := (2 * m / K ^ 2) * B with htKdef
  obtain ⟨hB0, hBle, htK0, htKle, hinvK, -⟩ := tail_rate_pieces (e := (eta : ℝ))
    (Nat.cast_nonneg eta) hM hΞ₁ hc0 hρ0 hρK hK1 hBdef htKdef
  -- the state at time `t`
  obtain ⟨u, hu1, hu2⟩ := hgraph t u₀
  rw [← hu1]
  set y := UN t (extractCLM n (S u₀))
  set l := cubeLift (2 * Real.pi / L) n y
  have hSl : finiteFourierLpIsometry eta n y = S l := (stateMap_cubeLift _ n y).symm
  rw [hSl, expect_regKin_eq sys _ r κ u, expect_regKin_eq sys _ r κ l,
    (capKin sys _ r κ).expect_split n u]
  -- the exact tails at a threshold `λ`
  have hexact : ∀ lam, 1 ≤ lam → 2 * (2 * Real.pi / L) ≤ lam →
      ‖tailMask (2 * Real.pi / L) lam r (T u)‖ ≤ β * Real.sqrt (1 / lam) ∧
      ‖tailMask (2 * Real.pi / L) lam r (S u)‖ ≤ (2 * m / lam ^ 2) * (β * Real.sqrt (1 / lam)) := by
    intro lam hlam1 hlam2
    have hlam0 : 0 < lam := lt_of_lt_of_le zero_lt_one hlam1
    have hρl : Real.sqrt (1 / lam) ^ 2 * lam = 1 := by
      rw [Real.sq_sqrt (one_div_nonneg.mpr hlam0.le)]; field_simp
    have h := tails_at_time sys L H hKernel Hunit hL hPeriodic hC U hgraph r lam
      (Real.sqrt (1 / lam)) Blow Cs Bker hlam1 (Real.sqrt_nonneg _) hρl hBlow hCs hBker hlam2
      hAmplitude hBkerScale hCsScale u₀ v₀ huv t u hu1 hu2
    have hBl : (2 * m / lam ^ 2) * Ξ₁ + c0 * Real.sqrt (1 / lam) ≤ β * Real.sqrt (1 / lam) :=
      tail_rate_le hm0 hΞ₁ hlam1
    exact ⟨h.1.trans hBl,
      h.2.trans (mul_le_mul_of_nonneg_left hBl (div_nonneg h2m (sq_nonneg lam)))⟩
  -- the Galerkin tails at a threshold `λ ≤ κ` (`lem:disc-tails`, `cube_tails_rate`)
  have hcube : ∀ lam, 1 ≤ lam → 2 * (2 * Real.pi / L) ≤ lam → lam ≤ κ →
      ‖tailMask (2 * Real.pi / L) lam r (T l)‖ ≤ βN * Real.sqrt (1 / lam) ∧
      ‖tailMask (2 * Real.pi / L) lam r (S l)‖ ≤
        (2 * m / lam ^ 2) * (βN * Real.sqrt (1 / lam)) := by
    intro lam hlam1 hlam2 hlamκ
    have h := cube_tails_rate sys L H hKernel Hunit hL hPeriodic hC U h0 hgraph n UN hNcomm Blow
      Cs Bker hBlow hCs hBker hAmplitude hBkerScale hCsScale u₀ v₀ huv t r hlam1 hlam2
      (hlamκ.trans hκK)
    exact ⟨h.1, h.2.1⟩
  -- (A) the exact replacement term
  have hA : (capRest sys (2 * Real.pi / L) r κ).expect (S u) ≤ 2 * m * β ^ 2 * (1 / κ) ^ 3 := by
    refine ((capRest sys _ r κ).expect_le_tails_of_vanish r κ
      (capRest_vanish sys _ r κ hg.le) u).trans ?_
    obtain ⟨h1, h2⟩ := hexact κ hκ1 h2gκ
    calc ‖tailMask (2 * Real.pi / L) κ r (S u)‖ * ‖tailMask (2 * Real.pi / L) κ r (T u)‖
        ≤ ((2 * m / κ ^ 2) * (β * ρκ)) * (β * ρκ) :=
          mul_le_mul h2 h1 (norm_nonneg _)
            (mul_nonneg (div_nonneg h2m (sq_nonneg κ)) (mul_nonneg hβ hρκ0))
      _ = 2 * m * β ^ 2 * ρκ ^ 6 := by rw [hinvκ]; ring
      _ = 2 * m * β ^ 2 * (1 / κ) ^ 3 := by rw [hρκ6]
  -- (B) the Galerkin replacement term
  have hB' : (capRest sys (2 * Real.pi / L) r κ).expect (S l) ≤ 2 * m * βN ^ 2 * (1 / κ) ^ 3 := by
    refine ((capRest sys _ r κ).expect_le_tails_of_vanish r κ
