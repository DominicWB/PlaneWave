/-!
# Trajectory tails of the Galerkin evolution at every threshold: `lem:disc-tails`

For `ψ₀ = S u₀ ∈ D(H²)` (`H u₀ = S v₀`) and the Galerkin trajectory
`ψ_N(s) = e^{-iH_N s} P ψ₀` on the cube of radius `n`, the register tails of `T ψ_N(s)` and of
`ψ_N(s)` beyond every threshold `λ ≥ max(1, 2g)` are bounded uniformly in `s`
(`cube_tails_at_time`):

  `‖1_{a,>λ} T ψ_N(s)‖ ≤ B_N(λ) = (2m̄/λ²) Ξ_N + N₀ + C_tail(M_N) λ^{-1/2}`,
  `‖1_{a,>λ} ψ_N(s)‖ ≤ (2m̄/λ²) B_N(λ)`,

where `N₀ ≥ ‖W (1 - P) ψ₀‖` (`O(K^{-3/2})` by `eq:secular` at `s = 0`, `backscatter_initial_le`).
The proof is the manuscript's: `H_N ψ_N(s) = χ_N(s) - ρ_N(s)` with
`χ_N(s) = e^{-iH_N s} P H ψ₀` (whose `H_N`-norm is conserved, so `Θ(χ_N(s))` is bounded by the
data) and `ρ_N(s) = e^{-iH_N s} P W δ₀` (small in norm); on the cube
`T ψ_N = H_N ψ_N - P W ψ_N`, and the potential term has the tail `eq:lam-gen` at every threshold.
The `λ^{-1/2}` form of `eq:disc-tails`, with a constant independent of the cube, is
`cube_tails_rate` (DevK5).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveKinetic

open PlaneWaveCertificate PlaneWaveDynamics

variable {eta : ℕ} {ν : Type} [Fintype ν]

section Tails

variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel in
/-- On the cube, `T φ = H_N φ - P W φ` (in `ℓ²`, for the lift of a cube vector `φ`). -/
lemma kinetic_cubeLift_eq (n : ℕ)
    (φ : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    coulombFourierKineticH2 sys (2 * Real.pi / L) (cubeLift (2 * Real.pi / L) n φ) =
      finiteFourierLpIsometry eta n (finiteCoulombHamiltonian sys L n φ) -
        molecularH2Truncate n (coulombFourierPotentialH2 sys (2 * Real.pi / L) H
          (cubeLift (2 * Real.pi / L) n φ)) := by
  set u := cubeLift (2 * Real.pi / L) n φ
  have hT : coulombFourierKineticH2 sys (2 * Real.pi / L) u =
      finiteFourierLpIsometry eta n
        (extractCLM n (coulombFourierKineticH2 sys (2 * Real.pi / L) u)) := by
    rw [emb_extractCLM, kinetic_cubeLift_truncate]
  have hdec : extractCLM n (coulombFourierKineticH2 sys (2 * Real.pi / L) u) =
      finiteCoulombHamiltonian sys L n φ -
        extractCLM n (coulombFourierPotentialH2 sys (2 * Real.pi / L) H u) := by
    rw [finiteH_eq_extract sys L H hKernel n φ,
      coulombFourierHamiltonianH2_decomposition sys (2 * Real.pi / L) H u, map_add]
    abel
  rw [hT, hdec, map_sub, emb_extractCLM]

include hKernel hL hPeriodic in
/-- **Trajectory tails, Galerkin evolution** (`lem:disc-tails`). For every register `a` and every
threshold `λ ≥ 1` with `λ ≥ 2g` (`ρ'² λ = 1`), uniformly in `s`,
`‖1_{a,>λ} T ψ_N(s)‖ ≤ B_N` and `‖1_{a,>λ} ψ_N(s)‖ ≤ (2m̄/λ²) B_N` with
`B_N = (2m̄/λ²) Ξ_N + N₀ + C_tail(M_N) ρ'`, `Ξ_N = 2 (2 Ξ₁ + 2b ‖H ψ₀‖) + 2b ‖H ψ₀‖`,
`Ξ₁ = 2 ‖H² ψ₀‖ + 2b ‖H ψ₀‖`, `M_N = m̄ (‖ψ₀‖ + 2 (2 (2 Ξ₀ + 2b ‖ψ₀‖) + 2b ‖ψ₀‖))`,
`Ξ₀ = 2 ‖H ψ₀‖ + 2b ‖ψ₀‖`, for any `N₀ ≥ ‖W (1 - P) ψ₀‖`. -/
theorem cube_tails_at_time (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (a : Fin eta) (lam rho' Blow Cs Bker : ℝ) (hlam1 : 1 ≤ lam)
    (hRho' : 0 ≤ rho') (hRhoScale' : rho' ^ 2 * lam = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2glam : 2 * (2 * Real.pi / L) ≤ lam)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (N₀ : ℝ) (hN₀ : ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H
      (u₀ - molecularH2Truncate n u₀)‖ ≤ N₀) (s : ℝ) :
    let b := relB sys L Hunit
    let S0 := ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖
    let S1 := ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖
    let Ξ₀ := 2 * ‖H u₀‖ + 2 * b * S0
    let Ξ₁ := 2 * ‖H v₀‖ + 2 * b * S1
    let ΞN := 2 * (2 * Ξ₁ + 2 * b * S1) + 2 * b * S1
