structure TorusCoordinateC2Test (d : Type*) [Fintype d] where
  toContinuousMap : C(UnitAddTorus d, ℂ)
  first : d → C(UnitAddTorus d, ℂ)
  second : d → C(UnitAddTorus d, ℂ)
  hasFirst : ∀ (a : d) (x : UnitAddTorus d) (t : ℝ),
    HasDerivAt
      (fun r : ℝ => toContinuousMap (torusCoordinateLine x a r))
      (first a (torusCoordinateLine x a t)) t
  hasSecond : ∀ (a : d) (x : UnitAddTorus d) (t : ℝ),
    HasDerivAt
      (fun r : ℝ => first a (torusCoordinateLine x a r))
      (second a (torusCoordinateLine x a t)) t

