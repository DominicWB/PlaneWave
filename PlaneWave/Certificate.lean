/-! ## multiplication closure -/

/-!
# Closed graph of pointwise multiplication on L2

The potential is a complex-valued function, so it is finite at every point.
The graph relation is an almost-everywhere identity and is unchanged by
altering the potential on a null set. Its sequential closedness needs no
boundedness hypothesis: two successive subsequences give simultaneous
almost-everywhere convergence of the input and output representatives.
-/

noncomputable section

open MeasureTheory Filter
open scoped Topology

namespace PlaneWaveCertificate

/-- The actual pointwise multiplication graph on L2, expressed independently
of any completed Fourier operator. -/
def HasL2PointwisePotential {α : Type*} [MeasurableSpace α]
    (μ : Measure α) (V : α → ℂ) (f g : Lp ℂ 2 μ) : Prop :=
  ∀ᵐ x ∂μ, g x = V x * f x

namespace HasL2PointwisePotential

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}
variable {V W : α → ℂ} {f g h : Lp ℂ 2 μ}

/-- Pointwise multiplication has at most one L2 output. -/
theorem unique (hg : HasL2PointwisePotential μ V f g)
    (hh : HasL2PointwisePotential μ V f h) : g = h := by
  apply Lp.ext
  filter_upwards [hg, hh] with x hgx hhx
  exact hgx.trans hhx.symm

/-- An L2 graph output proves square-integrability of the actual product. -/
theorem memLp (hf : HasL2PointwisePotential μ V f g) :
    MemLp (fun x => V x * f x) 2 μ := by
  exact (memLp_congr_ae hf).mp (Lp.memLp g)

/-- The zero input has zero output. -/
theorem zero (μ : Measure α) (V : α → ℂ) :
    HasL2PointwisePotential μ V 0 0 := by
  filter_upwards [Lp.coeFn_zero ℂ 2 μ] with x hx
  simp only [Pi.zero_apply] at hx
  simp only [hx, mul_zero]

/-- Addition of two graph pairs preserves the pointwise identity. -/
theorem add {f₁ f₂ g₁ g₂ : Lp ℂ 2 μ}
    (h₁ : HasL2PointwisePotential μ V f₁ g₁)
    (h₂ : HasL2PointwisePotential μ V f₂ g₂) :
    HasL2PointwisePotential μ V (f₁ + f₂) (g₁ + g₂) := by
  filter_upwards [h₁, h₂, Lp.coeFn_add f₁ f₂, Lp.coeFn_add g₁ g₂]
    with x h₁x h₂x hfx hgx
  change (g₁ + g₂) x = V x * (f₁ + f₂) x
  rw [hfx, hgx]
  change g₁ x + g₂ x = V x * (f₁ x + f₂ x)
  rw [h₁x, h₂x, mul_add]

/-- Simultaneous L2 convergence of inputs and outputs preserves the
pointwise multiplication identity, even for an unbounded potential. -/
theorem of_tendsto {fseq gseq : ℕ → Lp ℂ 2 μ} {f g : Lp ℂ 2 μ}
    (hseq : ∀ n, HasL2PointwisePotential μ V (fseq n) (gseq n))
    (hf : Tendsto fseq atTop (𝓝 f))
    (hg : Tendsto gseq atTop (𝓝 g)) :
    HasL2PointwisePotential μ V f g := by
  obtain ⟨s, hs, hsf⟩ :=
    (tendstoInMeasure_of_tendsto_Lp hf).exists_seq_tendsto_ae
  obtain ⟨t, ht, htg⟩ :=
    (tendstoInMeasure_of_tendsto_Lp (hg.comp hs.tendsto_atTop)).exists_seq_tendsto_ae
  have hall : ∀ᵐ x ∂μ, ∀ n, gseq n x = V x * fseq n x :=
    ae_all_iff.mpr hseq
  filter_upwards [hsf, htg, hall] with x hfx hgx heq
  have hmul : Tendsto (fun n => V x * fseq (s (t n)) x) atTop
      (𝓝 (V x * f x)) :=
    tendsto_const_nhds.mul (hfx.comp ht.tendsto_atTop)
  have heqseq : (fun n => gseq (s (t n)) x) =
      (fun n => V x * fseq (s (t n)) x) :=
    funext fun n => heq (s (t n))
  change Tendsto (fun n => gseq (s (t n)) x) atTop (𝓝 (g x)) at hgx
  rw [heqseq] at hgx
  exact tendsto_nhds_unique hgx hmul

end HasL2PointwisePotential

