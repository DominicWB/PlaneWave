noncomputable section

/-! ## Ninety-ninth milestone: coordinate slices and finite radial crossing sets -/

/-- The monic quadratic whose roots are the parameter values where the
coordinate line meets the sphere of squared radius `s^2`. -/
noncomputable def hardyRadialSlicePolynomial
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (s : ℝ) : Polynomial ℝ :=
  Polynomial.X ^ 2 +
    Polynomial.C (2 * x j) * Polynomial.X +
    Polynomial.C (centeredCube3AmbientRadiusSq x - s ^ 2)

/-- Evaluating the radial slice polynomial gives exactly the squared-radius
difference along the coordinate line. -/
lemma hardyRadialSlicePolynomial_eval
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (s t : ℝ) :
    Polynomial.eval t (hardyRadialSlicePolynomial x j s) =
      centeredCube3AmbientRadiusSq
          (x + t • hardyCoordinateDirection j) -
        s ^ 2 := by
  rw [centeredCube3AmbientRadiusSq_add_coordinate]
  simp [hardyRadialSlicePolynomial]
  ring

/-- The radial slice polynomial is nonzero: its quadratic coefficient is one. -/
lemma hardyRadialSlicePolynomial_ne_zero
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (s : ℝ) :
    hardyRadialSlicePolynomial x j s ≠ 0 := by
  intro hzero
  have hCoeff :=
    congrArg (fun p : Polynomial ℝ => p.coeff 2) hzero
  unfold hardyRadialSlicePolynomial at hCoeff
  rw [Polynomial.coeff_add, Polynomial.coeff_add] at hCoeff
  rw [Polynomial.coeff_X_pow] at hCoeff
  rw [Polynomial.coeff_C_mul_X] at hCoeff
  rw [Polynomial.coeff_C] at hCoeff
  norm_num at hCoeff

/-- Exceptional parameters on a coordinate line: roots corresponding to either
cutoff sphere.  This formulation is preferable to writing the quadratic formula
because only finiteness is needed for one-dimensional integration by parts. -/
noncomputable def hardyRadialSliceExceptionalSet
    (rho R : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3) : Set ℝ :=
  {t : ℝ | (hardyRadialSlicePolynomial x j rho).IsRoot t} ∪
    {t : ℝ | (hardyRadialSlicePolynomial x j R).IsRoot t}

/-- A coordinate line meets the two cutoff spheres at only finitely many
parameter values. -/
lemma hardyRadialSliceExceptionalSet_finite
    (rho R : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3) :
    (hardyRadialSliceExceptionalSet rho R x j).Finite := by
  unfold hardyRadialSliceExceptionalSet
  exact
    (Polynomial.finite_setOf_isRoot
      (hardyRadialSlicePolynomial_ne_zero x j rho)).union
    (Polynomial.finite_setOf_isRoot
      (hardyRadialSlicePolynomial_ne_zero x j R))

/-- Equality with any radius `s` forces the corresponding coordinate-line
parameter to be a root of the radial quadratic. -/
lemma hardyRadialSlicePolynomial_isRoot_of_radius_eq
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (s t : ℝ)
    (hRadius :
      centeredCube3AmbientRadius
        (x + t • hardyCoordinateDirection j) = s) :
    (hardyRadialSlicePolynomial x j s).IsRoot t := by
  rw [Polynomial.IsRoot.def]
  rw [hardyRadialSlicePolynomial_eval]
  have hSq :
      centeredCube3AmbientRadius
          (x + t • hardyCoordinateDirection j) ^ 2 =
        centeredCube3AmbientRadiusSq
          (x + t • hardyCoordinateDirection j) := by
    unfold centeredCube3AmbientRadius
    exact
      Real.sq_sqrt
        (centeredCube3AmbientRadiusSq_nonneg
          (x + t • hardyCoordinateDirection j))
  rw [← hSq, hRadius]
  ring

/-- Meeting the inner cutoff sphere puts the coordinate parameter in the finite
exceptional set. -/
lemma mem_hardyRadialSliceExceptionalSet_of_radius_eq_rho
    (rho R : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ)
    (hRadius :
      centeredCube3AmbientRadius
        (x + t • hardyCoordinateDirection j) = rho) :
    t ∈ hardyRadialSliceExceptionalSet rho R x j := by
  unfold hardyRadialSliceExceptionalSet
  apply Set.mem_union_left
  exact hardyRadialSlicePolynomial_isRoot_of_radius_eq x j rho t hRadius

/-- Meeting the outer cutoff sphere likewise puts the coordinate parameter in
the finite exceptional set. -/
lemma mem_hardyRadialSliceExceptionalSet_of_radius_eq_outer
    (rho R : ℝ)
    (x : CenteredCube3Ambient)
    (j : Fin 3)
    (t : ℝ)
    (hRadius :
      centeredCube3AmbientRadius
        (x + t • hardyCoordinateDirection j) = R) :
    t ∈ hardyRadialSliceExceptionalSet rho R x j := by
  unfold hardyRadialSliceExceptionalSet
  apply Set.mem_union_right
  exact hardyRadialSlicePolynomial_isRoot_of_radius_eq x j R t hRadius

/-!
## Ninety-ninth milestone

For every ambient base point and coordinate direction, the zero-extended cutoff
wave and its explicit raw gradient are now represented as ordinary functions of
one real variable.  The only radial nonsmoothness along such a line can occur
when the line meets `r = rho` or `r = R`.

Those crossing parameters lie in the union of the root sets of two monic
quadratic polynomials, hence form a finite set.  This is precisely the
one-dimensional exceptional-set structure needed to replace an unavailable
global pointwise derivative by intervalwise/away-from-finitely-many-points
calculus.

The next milestone can prove that away from this finite set the derivative of
the wave slice is exactly the raw-gradient slice.
-/

end

end PlaneWaveCertificate

