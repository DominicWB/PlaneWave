def latticeReferenceConfigurationKernel {eta : ℕ} (i : Fin eta)
    (kernel : Lattice3 → Lattice3 → ℂ)
    (q p : FourierConfig eta Lattice3) : ℂ := by
  classical
  exact if (∀ k : Fin eta, k ≠ i → q k = p k) then kernel (q i) (p i) else 0

