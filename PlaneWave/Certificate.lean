noncomputable section

/-! ## Eighty-fourth milestone: make the cutoff product-rule norm algebraic -/

/--
For any two Hilbert-space vectors, the squared norm of their sum is at most
`2` times the sum of their squared norms.  This is the elementary inequality
used in the cutoff product rule.
-/
lemma norm_add_sq_le_two_mul
    {V : Type*}
    [NormedAddCommGroup V]
    (u v : V) :
    ‖u + v‖ ^ 2 ≤ 2 * (‖u‖ ^ 2 + ‖v‖ ^ 2) := by
  have htri : ‖u + v‖ ≤ ‖u‖ + ‖v‖ := norm_add_le u v
  have hsum0 : 0 ≤ ‖u‖ + ‖v‖ :=
    add_nonneg (norm_nonneg _) (norm_nonneg _)
  have hgap0 : 0 ≤ (‖u‖ + ‖v‖) - ‖u + v‖ :=
    sub_nonneg.mpr htri
  have hplus0 : 0 ≤ (‖u‖ + ‖v‖) + ‖u + v‖ :=
    add_nonneg hsum0 (norm_nonneg _)
  have hsq :
      ‖u + v‖ ^ 2 ≤ (‖u‖ + ‖v‖) ^ 2 := by
    have hprod :
        0 ≤ ((‖u‖ + ‖v‖) - ‖u + v‖) *
          ((‖u‖ + ‖v‖) + ‖u + v‖) :=
      mul_nonneg hgap0 hplus0
    nlinarith
  have hdiff : 0 ≤ (‖u‖ - ‖v‖) ^ 2 := sq_nonneg _
  nlinarith

/-!
Milestone 84 removes the monolithic `product_rule_gradient_bound` hypothesis
from milestone 83.  The cutoff gradient norm is now an explicit sum of three
formal component norms, and Lean proves the factor-2 product-rule inequality.
The next step is to instantiate `mainGradientState` with the cutoff times the
three coefficientwise Fourier derivatives and prove `main_gradient_sq_bound`
by Parseval and the bound `|chi| <= 1`; then instantiate
`cutoffGradientState` with `(partial_j chi) psi` and prove its bound from
`|grad chi| <= 1/(R-rho)`.
-/

end

