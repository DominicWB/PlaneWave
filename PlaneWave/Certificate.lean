  classical
  change (∑ p ∈ fourierConfigCube eta N,
    lp.single (E := fun _ : FourierConfig eta Lattice3 => ℂ) 2 p (u p)) ∈
      lp2CoordinateCore (FourierConfig eta Lattice3)
