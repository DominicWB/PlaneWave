  have hβ0 : 0 ≤ β := by rw [hβ]; positivity
  have hδ₁0 : 0 ≤ δ₁ := by rw [hδ₁]; positivity
  have hρ2 : ρ ^ 2 ≤ 1 := by nlinarith only [hρK, hK, sq_nonneg ρ]
  have hρ1 : ρ ≤ 1 := by nlinarith only [hρ2, hρ]
