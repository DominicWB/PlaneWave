/-! ## One-hundred-seventh milestone: the uniform regularized Hardy inequality

The ambient integration-by-parts theorem from milestone 106 is now combined
with an energy estimate.  We use the square-completion (scaled Young) form of
Cauchy--Schwarz, rather than constructing a new vector-valued L2 space.

Crucially, the squared field components are summed *before* bounding them by
the Hardy weight.  This retains the constant four, with no extra factor three.
All integrability premises of the generic helpers are discharged for the
original cutoff wave and original raw-gradient zero extensions.
-/

/-- A scalar complex square-completion estimate.  The real number `a` may have
either sign.  This is the bound associated with the nonnegative square
`(|a| * |z| - 2 * |v|)^2`; no division by a norm is needed. -/
lemma hardyComplex_cross_completion_bound
    (a : ℝ) (z v : ℂ) :
    -4 * (((a : ℂ) * (starRingEnd ℂ) z * v).re) ≤
      a ^ 2 * ‖z‖ ^ 2 + 4 * ‖v‖ ^ 2 := by
  have hNorm :
      ‖(a : ℂ) * (starRingEnd ℂ) z * v‖ = |a| * ‖z‖ * ‖v‖ := by
    simp [norm_mul, Real.norm_eq_abs]
  have hRe :
      -(((a : ℂ) * (starRingEnd ℂ) z * v).re) ≤ |a| * ‖z‖ * ‖v‖ := by
    calc
      -(((a : ℂ) * (starRingEnd ℂ) z * v).re) ≤
          |((a : ℂ) * (starRingEnd ℂ) z * v).re| := neg_le_abs _
      _ ≤ ‖(a : ℂ) * (starRingEnd ℂ) z * v‖ := Complex.abs_re_le_norm _
      _ = |a| * ‖z‖ * ‖v‖ := hNorm
  have hSquare : (|a| * ‖z‖) ^ 2 = a ^ 2 * ‖z‖ ^ 2 := by
    rw [mul_pow, sq_abs]
  have hYoung :
      4 * (|a| * ‖z‖ * ‖v‖) ≤ a ^ 2 * ‖z‖ ^ 2 + 4 * ‖v‖ ^ 2 := by
    nlinarith only [sq_nonneg (|a| * ‖z‖ - 2 * ‖v‖), hSquare]
  linarith only [hRe, hYoung]

/-- Pointwise energy estimate for the sum of all three regularized cross terms.
Using the full sum of field squares is what avoids losing a dimension factor. -/
lemma hardyRegularizedCrossSum_completion_bound
    {eps : ℝ} (heps : 0 < eps)
    (u : CenteredCube3Ambient → ℂ)
    (v : Fin 3 → CenteredCube3Ambient → ℂ)
    (x : CenteredCube3Ambient) :
    -4 * (∑ j : Fin 3, (hardyRegularizedComplexCrossTerm eps j u (v j) x).re) ≤
      hardyRegularizedWeight eps x * ‖u x‖ ^ 2 +
        4 * (∑ j : Fin 3, ‖v j x‖ ^ 2) := by
  classical
  have hField :
      (∑ j : Fin 3, (hardyRegularizedFieldComponent eps j x) ^ 2) ≤
        hardyRegularizedWeight eps x := by
    simpa only [hardyRegularizedField] using
      hardyRegularizedField_sum_sq_le_weight heps x
  calc
    -4 * (∑ j : Fin 3,
        (hardyRegularizedComplexCrossTerm eps j u (v j) x).re) =
        ∑ j : Fin 3, -4 * (hardyRegularizedComplexCrossTerm eps j u (v j) x).re := by
      rw [Finset.mul_sum]
    _ ≤ ∑ j : Fin 3,
        ((hardyRegularizedFieldComponent eps j x) ^ 2 * ‖u x‖ ^ 2 +
          4 * ‖v j x‖ ^ 2) := by
      apply Finset.sum_le_sum
      intro j hj
      exact hardyComplex_cross_completion_bound
        (hardyRegularizedFieldComponent eps j x) (u x) (v j x)
    _ = (∑ j : Fin 3, (hardyRegularizedFieldComponent eps j x) ^ 2) * ‖u x‖ ^ 2 +
        4 * (∑ j : Fin 3, ‖v j x‖ ^ 2) := by
      simp only [Finset.sum_add_distrib, Finset.sum_mul, Finset.mul_sum]
    _ ≤ hardyRegularizedWeight eps x * ‖u x‖ ^ 2 +
        4 * (∑ j : Fin 3, ‖v j x‖ ^ 2) :=
      add_le_add (mul_le_mul_of_nonneg_right hField (sq_nonneg ‖u x‖)) (le_refl _)

/-- Integrated square-completion bound.  Integrability of the weighted wave,
each gradient energy, and each real cross term is required before using
linearity or monotonicity of the Bochner integral. -/
lemma hardyRegularizedCrossSum_integral_completion_bound
    {eps : ℝ} (heps : 0 < eps)
    (u : CenteredCube3Ambient → ℂ)
    (v : Fin 3 → CenteredCube3Ambient → ℂ)
    (hWeighted : Integrable
      (fun x : CenteredCube3Ambient => hardyRegularizedWeight eps x * ‖u x‖ ^ 2) volume)
    (hGradient : ∀ j : Fin 3,
      Integrable (fun x : CenteredCube3Ambient => ‖v j x‖ ^ 2) volume)
    (hCross : ∀ j : Fin 3, Integrable
      (fun x : CenteredCube3Ambient =>
        (hardyRegularizedComplexCrossTerm eps j u (v j) x).re) volume) :
    -4 * (∫ x : CenteredCube3Ambient,
      ∑ j : Fin 3, (hardyRegularizedComplexCrossTerm eps j u (v j) x).re) ≤
      (∫ x : CenteredCube3Ambient, hardyRegularizedWeight eps x * ‖u x‖ ^ 2) +
        4 * (∑ j : Fin 3, ∫ x : CenteredCube3Ambient, ‖v j x‖ ^ 2) := by
  have hCrossSum : Integrable
      (fun x : CenteredCube3Ambient =>
        ∑ j : Fin 3, (hardyRegularizedComplexCrossTerm eps j u (v j) x).re) volume := by
    exact integrable_finsetSum (Finset.univ : Finset (Fin 3)) (fun j _ => hCross j)
  have hGradientSum : Integrable
      (fun x : CenteredCube3Ambient => ∑ j : Fin 3, ‖v j x‖ ^ 2) volume := by
    exact integrable_finsetSum (Finset.univ : Finset (Fin 3)) (fun j _ => hGradient j)
  have hIntegral :
      (∫ x : CenteredCube3Ambient,
        -4 * (∑ j : Fin 3, (hardyRegularizedComplexCrossTerm eps j u (v j) x).re)) ≤
      (∫ x : CenteredCube3Ambient,
        hardyRegularizedWeight eps x * ‖u x‖ ^ 2 +
          4 * (∑ j : Fin 3, ‖v j x‖ ^ 2)) := by
    apply integral_mono (hCrossSum.const_mul (-4))
      (hWeighted.add (hGradientSum.const_mul 4))
    intro x
    exact hardyRegularizedCrossSum_completion_bound heps u v x
  rw [integral_const_mul] at hIntegral
  rw [integral_add hWeighted (hGradientSum.const_mul 4)] at hIntegral
  rw [integral_const_mul] at hIntegral
  rw [integral_finsetSum (Finset.univ : Finset (Fin 3))
    (fun j _ => hGradient j)] at hIntegral
  exact hIntegral

/-- Regularized weighted energy of the original zero-extended cutoff wave. -/
noncomputable def centeredCube3RadialCutoffRegularizedEnergy
    {α : Type} [Fintype α]
    (rho R eps : ℝ) (index : α → Lattice3) (f : α → ℂ) : ℝ :=
  ∫ x : CenteredCube3Ambient,
    hardyRegularizedWeight eps x *
      ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2

/-- Total ambient squared-gradient energy of the original raw-gradient zero
extensions.  This quantity is independent of the regularization parameter. -/
noncomputable def centeredCube3RadialCutoffAmbientGradientEnergy
    {α : Type} [Fintype α]
    (rho R : ℝ) (index : α → Lattice3) (f : α → ℂ) : ℝ :=
  ∑ j : Fin 3, ∫ x : CenteredCube3Ambient,
    ‖centeredCube3RadialCutoffRawGradientZeroExtension rho R index f j x‖ ^ 2

/-- The regularized weighted energy is bounded by the divergence energy.  Both
integrals are integrals of integrable functions, not merely totalized notation. -/
lemma centeredCube3RadialCutoffRegularizedEnergy_le_divergenceIntegral
    {α : Type} [Fintype α]
    {rho R eps : ℝ} (hRhoR : rho < R) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) :
    centeredCube3RadialCutoffRegularizedEnergy rho R eps index f ≤
      ∫ x : CenteredCube3Ambient,
        hardyRegularizedDivergence eps x *
          ‖centeredCube3RadialCutoffWaveZeroExtension rho R index f x‖ ^ 2 := by
  unfold centeredCube3RadialCutoffRegularizedEnergy
  apply integral_mono
    (centeredCube3RadialCutoffWaveZeroExtension_regularized_integrable
      heps hRhoR index f)
    (centeredCube3RadialCutoffRegularizedDivergenceEnergy_integrable
      hRhoR heps index f)
  intro x
  exact mul_le_mul_of_nonneg_right
    (hardyRegularizedWeight_le_divergence heps x) (sq_nonneg _)

/-- The uniform finite-epsilon Hardy inequality for the actual cutoff wave.
No Hardy, cross-estimate, or integration-by-parts assumption is introduced.
The constant four is independent of epsilon and of the Fourier coefficients. -/
lemma centeredCube3RadialCutoff_regularized_hardy
    {α : Type} [Fintype α]
    {rho R eps : ℝ}
    (hrho : 0 < rho) (hRhoR : rho < R)
    (hOuterHalf : R < (1 / 2 : ℝ)) (heps : 0 < eps)
    (index : α → Lattice3) (f : α → ℂ) :
    centeredCube3RadialCutoffRegularizedEnergy rho R eps index f ≤
      4 * centeredCube3RadialCutoffAmbientGradientEnergy rho R index f := by
  let u : CenteredCube3Ambient → ℂ :=
    centeredCube3RadialCutoffWaveZeroExtension rho R index f
  let v : Fin 3 → CenteredCube3Ambient → ℂ :=
    centeredCube3RadialCutoffRawGradientZeroExtension rho R index f
  have hWeighted : Integrable
      (fun x : CenteredCube3Ambient => hardyRegularizedWeight eps x * ‖u x‖ ^ 2)
      volume :=
    centeredCube3RadialCutoffWaveZeroExtension_regularized_integrable
      heps hRhoR index f
  have hGradient : ∀ j : Fin 3,
      Integrable (fun x : CenteredCube3Ambient => ‖v j x‖ ^ 2) volume := by
    intro j
    exact centeredCube3RadialCutoffRawGradientZeroExtension_sq_integrable
      hrho hRhoR index f j
  have hCross : ∀ j : Fin 3, Integrable
      (fun x : CenteredCube3Ambient =>
        (hardyRegularizedComplexCrossTerm eps j u (v j) x).re) volume := by
    intro j
    exact centeredCube3RadialCutoffRegularizedCrossTerm_re_integrable
      hrho hRhoR heps index f j
  have hCompletion := hardyRegularizedCrossSum_integral_completion_bound
    heps u v hWeighted hGradient hCross
  have hIntegrationByParts :=
    centeredCube3RadialCutoff_regularized_integrationByParts_integral_sum
      hrho hRhoR hOuterHalf heps index f
  have hWeightLeDiv :=
    centeredCube3RadialCutoffRegularizedEnergy_le_divergenceIntegral
      hRhoR heps index f
  dsimp [u, v] at hCompletion
  unfold centeredCube3RadialCutoffRegularizedEnergy at hWeightLeDiv
  unfold centeredCube3RadialCutoffRegularizedEnergy
    centeredCube3RadialCutoffAmbientGradientEnergy
  linarith only [hCompletion, hIntegrationByParts, hWeightLeDiv]

/-- For nonnegative energies the constant-four estimate also gives the
pre-squared Hardy energy bound.  This direction does not divide by the energy,
so it includes the zero-energy case. -/
lemma hardy_cross_bound_of_four_mul_bound
    {A G : ℝ} (hA : 0 ≤ A) (hG : 0 ≤ G) (hBound : A ≤ 4 * G) :
    A ≤ 2 * Real.sqrt A * Real.sqrt G := by
  have hRoot : Real.sqrt A ≤ 2 * Real.sqrt G := by
    calc
      Real.sqrt A ≤ Real.sqrt (4 * G) := Real.sqrt_le_sqrt hBound
      _ = 2 * Real.sqrt G := by
        rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
        norm_num
  calc
    A = Real.sqrt A * Real.sqrt A := by
      rw [← pow_two, Real.sq_sqrt hA]
    _ ≤ Real.sqrt A * (2 * Real.sqrt G) :=
      mul_le_mul_of_nonneg_left hRoot (Real.sqrt_nonneg A)
    _ = 2 * Real.sqrt A * Real.sqrt G := by ring

/-!
## One-hundred-seventh milestone

Let A_epsilon be the integral of w_epsilon |U|^2, let G be the sum of the three
raw-gradient energy integrals, and let C be the integral of the summed real
cross terms.  The new pointwise square-completion estimate, after summing field
squares and integrating, gives

  -4 C <= A_epsilon + 4 G.

Milestone 106 gives D = -2 C for the divergence energy, and the already-proved
weight/divergence comparison gives A_epsilon <= D.  Linear arithmetic now
proves A_epsilon <= 4 G, uniformly for every epsilon > 0.

This proves the quantitative regularized Hardy inequality for the *actual*
cutoff wave.  In particular no cross estimate, vector-valued Cauchy--Schwarz
identity, or Hardy inequality is assumed.  The constant is four, not twelve;
the bound for the sum of field squares is used only once.

We also record nonnegativity, the equivalent pre-squared energy estimate, and
monotonicity as epsilon decreases.  No injectivity of the Fourier index map is
required for these analytic inequalities.

The singular limit epsilon -> 0 and the exact comparison of ambient energy
integrals with the centered-cube L2 norms are still to be formalized.  Thus the
existing nonregularized Hardy interface and conditional BO end-to-end theorem
are not yet replaced in this milestone.
-/

end

