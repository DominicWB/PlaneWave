/-!
# Dynamics: duality and the regularity of the discrete backward flow

`lem:smear` and `prop:duality` of `thm:dyn` for a periodic Coulomb system, in Fourier
coordinates: the cube projection, the symmetry of the potential on `H²`, the elliptic estimate
inside the cube, the `H_N`-regularity of a projected state, and the duality bound
`|⟨η(t), w⟩| ≤ t · sup_s ‖δ(s)‖ · sup_s ‖(1 - P) W φ_w(s)‖` for the backward discrete flow
`φ_w(s) = e^{i H_N (t - s)} w`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped InnerProductSpace ComplexConjugate lp ENNReal Topology
open Filter Set

namespace PlaneWaveDynamics

/-! ## A generic duality bound -/

section Generic

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]

/-- **Duality.** Let `U t` be unitaries with `U 0 = 1` that commute with the symmetric `T` and
solve `d/dt U t x = -i U t (T x)` (the group `e^{-iTt}`), and let `a` solve `a' = -i (T a + r)`.
Then for every `w`,
`‖⟪a t - U t (a 0), w⟫‖ ≤ t · sup_{s ∈ [0,t]} ‖⟪r s, U (s - t) w⟫‖`: the error is only ever
paired with the backward flow of `w`. -/
theorem duality_pairing_le {T : V →ₗ[ℂ] V} (hT : T.IsSymmetric) (U : ℝ → V ≃ₗᵢ[ℂ] V)
    (h0 : ∀ x, U 0 x = x) (hcomm : ∀ t x, U t (T x) = T (U t x))
    (hderiv : ∀ t x, HasDerivAt (fun s => U s x) (-(Complex.I • U t (T x))) t)
    {a r : ℝ → V} (ha : ∀ s, HasDerivAt a (-(Complex.I • (T (a s) + r s))) s)
    (w : V) {B t : ℝ} (ht : 0 ≤ t) (hB : ∀ s ∈ Icc 0 t, ‖⟪r s, U (s - t) w⟫_ℂ‖ ≤ B) :
    ‖⟪a t - U t (a 0), w⟫_ℂ‖ ≤ B * t := by
  set F : ℝ → ℂ := fun s => ⟪a s - U s (a 0), U (s - t) w⟫_ℂ
  have hF : ∀ s, HasDerivAt F (Complex.I * ⟪r s, U (s - t) w⟫_ℂ) s := by
    intro s
    have hx : HasDerivAt (fun s => a s - U s (a 0))
        (-(Complex.I • (T (a s - U s (a 0)) + r s))) s := by
      have h := (ha s).sub (hderiv s (a 0))
      have e : -(Complex.I • (T (a s) + r s)) - -(Complex.I • U s (T (a 0))) =
          -(Complex.I • (T (a s - U s (a 0)) + r s)) := by
        rw [hcomm, map_sub, smul_add, smul_add, smul_sub]
        abel
      rw [e] at h
      exact h
    have hy : HasDerivAt (fun s => U (s - t) w) (-(Complex.I • T (U (s - t) w))) s := by
      have h := HasDerivAt.comp_sub_const s t (hderiv (s - t) w)
      rw [hcomm] at h
      exact h
    have h := hx.inner ℂ hy
    have e : ⟪a s - U s (a 0), -(Complex.I • T (U (s - t) w))⟫_ℂ +
        ⟪-(Complex.I • (T (a s - U s (a 0)) + r s)), U (s - t) w⟫_ℂ =
        Complex.I * ⟪r s, U (s - t) w⟫_ℂ := by
      rw [inner_neg_right, inner_smul_right, inner_neg_left, inner_smul_left, inner_add_left,
        ← hT, Complex.conj_I]
      ring
    rw [e] at h
    exact h
  have hbound : ∀ s ∈ Ico 0 t, ‖Complex.I * ⟪r s, U (s - t) w⟫_ℂ‖ ≤ B := by
    intro s hs
    rw [norm_mul, Complex.norm_I, one_mul]
    exact hB s (Ico_subset_Icc_self hs)
  have hmv := norm_image_sub_le_of_norm_deriv_le_segment'
    (fun s _ => (hF s).hasDerivWithinAt) hbound t (right_mem_Icc.mpr ht)
  have hF0 : F 0 = 0 := by
    simp only [F, h0, sub_self, inner_zero_left]
  have hFt : F t = ⟪a t - U t (a 0), w⟫_ℂ := by
    simp only [F, sub_self, h0]
  rw [hF0, hFt, sub_zero, sub_zero] at hmv
  exact hmv

end Generic

open PlaneWaveCertificate

/-! ## The cube projection -/

section Projection

variable {eta : ℕ}

lemma truncate_truncate (n : ℕ) (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    molecularH2Truncate n (molecularH2Truncate n x) = molecularH2Truncate n x := by
  classical
  ext p
  rw [molecularH2Truncate_apply, molecularH2Truncate_apply]
  by_cases hp : p ∈ fourierConfigCube eta n
  · rw [cubicLatticeCoeffTruncate_eq_of_mem n _ p hp, cubicLatticeCoeffTruncate_eq_of_mem n _ p hp,
      molecularH2Truncate_apply, cubicLatticeCoeffTruncate_eq_of_mem n _ p hp]
  · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp,
      cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp]

/-- The discarded part is orthogonal to the cube. -/
lemma inner_sub_truncate_truncate (n : ℕ) (x y : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ⟪x - molecularH2Truncate n x, molecularH2Truncate n y⟫_ℂ = 0 := by
  classical
  rw [lp.inner_eq_tsum]
  refine (tsum_congr fun p => ?_).trans tsum_zero
  have e1 : (x - molecularH2Truncate n x) p = x p - molecularH2Truncate n x p := rfl
  rw [e1, molecularH2Truncate_apply, molecularH2Truncate_apply]
  by_cases hp : p ∈ fourierConfigCube eta n
  · rw [cubicLatticeCoeffTruncate_eq_of_mem n _ p hp, sub_self, inner_zero_left]
  · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp,
      cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp, inner_zero_right]

lemma inner_sub_truncate_left (n : ℕ) (x y : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ⟪x - molecularH2Truncate n x, y⟫_ℂ =
      ⟪x - molecularH2Truncate n x, y - molecularH2Truncate n y⟫_ℂ := by
  rw [inner_sub_right, inner_sub_truncate_truncate, sub_zero]

lemma norm_sub_truncate_le_self (n : ℕ) (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ‖x - molecularH2Truncate n x‖ ≤ ‖x‖ := by
  classical
  have h := l2_norm_le_of_le (x - molecularH2Truncate n x) x zero_le_one (fun p => by
    rw [one_mul, lp.coeFn_sub, Pi.sub_apply, molecularH2Truncate_apply]
    by_cases hp : p ∈ fourierConfigCube eta n
    · rw [cubicLatticeCoeffTruncate_eq_of_mem n _ p hp, sub_self, norm_zero]
      exact norm_nonneg _
    · rw [cubicLatticeCoeffTruncate_eq_zero_of_not_mem n _ p hp, sub_zero])
  rwa [one_mul] at h

lemma truncate_emb (n : ℕ) (y : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    molecularH2Truncate n (finiteFourierLpIsometry eta n y) = finiteFourierLpIsometry eta n y := by
  rw [← emb_extractCLM]
  congr 1
  rw [finiteFourierLpIsometry_apply, extract_embed]

/-- The zero extension is the adjoint of the cube extraction. -/
lemma inner_emb_left (n : ℕ) (y : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2) :
    ⟪finiteFourierLpIsometry eta n y, x⟫_ℂ = ⟪y, extractCLM n x⟫_ℂ := by
  have h1 : ⟪finiteFourierLpIsometry eta n y, x - molecularH2Truncate n x⟫_ℂ = 0 := by
    rw [← inner_conj_symm, ← truncate_emb n y, inner_sub_truncate_truncate, map_zero]
  calc ⟪finiteFourierLpIsometry eta n y, x⟫_ℂ =
        ⟪finiteFourierLpIsometry eta n y, molecularH2Truncate n x⟫_ℂ := by
        rw [← sub_eq_zero, ← inner_sub_right, h1]
    _ = ⟪finiteFourierLpIsometry eta n y, finiteFourierLpIsometry eta n (extractCLM n x)⟫_ℂ := by
        rw [emb_extractCLM]
    _ = ⟪y, extractCLM n x⟫_ℂ := LinearIsometry.inner_map_map _ _ _

lemma inner_extract_left (n : ℕ) (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (y : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    ⟪extractCLM n x, y⟫_ℂ = ⟪x, finiteFourierLpIsometry eta n y⟫_ℂ := by
  rw [← inner_conj_symm, ← inner_emb_left, inner_conj_symm]

lemma norm_extract_of_truncate (n : ℕ) (x : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hx : molecularH2Truncate n x = x) : ‖extractCLM n x‖ = ‖x‖ := by
  rw [← (finiteFourierLpIsometry eta n).norm_map, emb_extractCLM, hx]

end Projection

/-! ## The Coulomb system: symmetry, the elliptic estimate in the cube, smeared states -/

section Coulomb

variable {eta : ℕ} {ν : Type} [Fintype ν]
variable (sys : CoulombSystem eta ν) (L : ℝ)
  (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

omit [Fintype ν] in
lemma kinetic_symm (g : ℝ) (u u' : MolecularFourierH2 eta) :
    ⟪molecularH2StateMap eta g u, coulombFourierKineticH2 sys g u'⟫_ℂ =
      ⟪coulombFourierKineticH2 sys g u, molecularH2StateMap eta g u'⟫_ℂ := by
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
  refine tsum_congr fun p => ?_
  rw [molecularH2StateMap_apply, molecularH2StateMap_apply, coulombFourierKineticH2_apply,
    coulombFourierKineticH2_apply]
  simp only [RCLike.inner_apply, map_mul, Complex.conj_ofReal]
  ring

include hKernel in
/-- **Symmetry of the potential on `H²`.** `⟪S u, W u'⟫ = ⟪W u, S u'⟫`. -/
lemma potential_symm (u u' : MolecularFourierH2 eta) :
    ⟪molecularH2StateMap eta (2 * Real.pi / L) u,
        coulombFourierPotentialH2 sys (2 * Real.pi / L) H u'⟫_ℂ =
      ⟪coulombFourierPotentialH2 sys (2 * Real.pi / L) H u,
        molecularH2StateMap eta (2 * Real.pi / L) u'⟫_ℂ := by
  change ⟪molecularH2StateMap eta (2 * Real.pi / L) u,
      H u' - coulombFourierKineticH2 sys (2 * Real.pi / L) u'⟫_ℂ =
    ⟪H u - coulombFourierKineticH2 sys (2 * Real.pi / L) u,
      molecularH2StateMap eta (2 * Real.pi / L) u'⟫_ℂ
  rw [inner_sub_right, inner_sub_left, coulombH2_symm sys L H hKernel, kinetic_symm]

/-- Weighted coordinates of a vector of the cube. -/
noncomputable abbrev cubeLift (g : ℝ) (n : ℕ)
    (φ : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) : MolecularFourierH2 eta :=
  finiteFourierH2Lift eta g n φ.ofLp

lemma stateMap_cubeLift (g : ℝ) (n : ℕ)
    (φ : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    molecularH2StateMap eta g (cubeLift g n φ) = finiteFourierLpIsometry eta n φ :=
  molecularH2StateMap_finiteFourierH2Lift eta g n φ.ofLp

lemma truncate_cubeLift (g : ℝ) (n : ℕ)
    (φ : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    molecularH2Truncate n (cubeLift g n φ) = cubeLift g n φ := by
  apply molecularH2StateMap_injective eta g
  rw [stateMap_truncate, stateMap_cubeLift, truncate_emb]

omit [Fintype ν] in
lemma kinetic_cubeLift_truncate (g : ℝ) (n : ℕ)
    (φ : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    molecularH2Truncate n (coulombFourierKineticH2 sys g (cubeLift g n φ)) =
      coulombFourierKineticH2 sys g (cubeLift g n φ) := by
  rw [← kinetic_truncate, truncate_cubeLift]

include hKernel in
/-- On the cube, `H_N φ` is the cube part of `H` applied to the lift of `φ`. -/
lemma finiteH_eq_extract (n : ℕ) (φ : EuclideanSpace ℂ
    (FourierConfig eta (FinitePlaneWaveMode n))) :
    finiteCoulombHamiltonian sys L n φ = extractCLM n (H (cubeLift (2 * Real.pi / L) n φ)) := by
  rw [extract_H_eq sys L H hKernel n, stateMap_cubeLift, finiteFourierLpIsometry_apply,
    extract_embed, truncate_cubeLift, sub_self, map_zero, map_zero, add_zero]

include hKernel hL hPeriodic in
/-- **Elliptic estimate in the cube.** `‖T φ‖ ≤ 2 ‖H_N φ‖ + 2b ‖φ‖` for `φ ∈ ran P`. -/
theorem elliptic_cube (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (n : ℕ)
    (φ : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) :
    ‖coulombFourierKineticH2 sys (2 * Real.pi / L) (cubeLift (2 * Real.pi / L) n φ)‖ ≤
      2 * ‖finiteCoulombHamiltonian sys L n φ‖ + 2 * relB sys L Hunit * ‖φ‖ := by
  set g := 2 * Real.pi / L
  set u := cubeLift g n φ
  set T := coulombFourierKineticH2 sys g
  set W := coulombFourierPotentialH2 sys g H
  have hW := potential_le_half sys L H hKernel Hunit hL hPeriodic hC u
  have hS : ‖molecularH2StateMap eta g u‖ = ‖φ‖ := by
    rw [stateMap_cubeLift, LinearIsometry.norm_map]
  have hT : ‖T u‖ = ‖extractCLM n (T u)‖ :=
    (norm_extract_of_truncate n _ (kinetic_cubeLift_truncate sys g n φ)).symm
  have hdec : extractCLM n (T u) = finiteCoulombHamiltonian sys L n φ - extractCLM n (W u) := by
    rw [finiteH_eq_extract sys L H hKernel n φ, coulombFourierHamiltonianH2_decomposition sys g H u,
      map_add]
    abel
  have h1 : ‖T u‖ ≤ ‖finiteCoulombHamiltonian sys L n φ‖ + ‖W u‖ := by
    rw [hT, hdec]
    exact (norm_sub_le _ _).trans (add_le_add le_rfl (norm_extractCLM_le n _))
  rw [hS] at hW
  linarith

include hKernel hL hPeriodic in
/-- **`H_N`-regularity of a projected state** (`lem:smear`, main step):
`‖H_N P S u‖ ≤ 2 ‖T u‖ + 2b ‖S u‖`. -/
theorem finiteH_extract_le (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (n : ℕ)
    (u : MolecularFourierH2 eta) :
    ‖finiteCoulombHamiltonian sys L n (extractCLM n
        (molecularH2StateMap eta (2 * Real.pi / L) u))‖ ≤
      2 * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ +
        2 * relB sys L Hunit * ‖molecularH2StateMap eta (2 * Real.pi / L) u‖ := by
  set g := 2 * Real.pi / L
  set T := coulombFourierKineticH2 sys g
  set W := coulombFourierPotentialH2 sys g H
  set S := molecularH2StateMap eta g
  set b := relB sys L Hunit
  have hb := relB_nonneg sys L Hunit hC
  have hdec := extract_H_eq sys L H hKernel n u
  have heq : finiteCoulombHamiltonian sys L n (extractCLM n (S u)) =
      extractCLM n (H u) - extractCLM n (W (u - molecularH2Truncate n u)) := by
    rw [hdec]
    abel
  have hH : ‖H u‖ ≤ (3 / 2) * ‖T u‖ + b * ‖S u‖ := by
    have hW := potential_le_half sys L H hKernel Hunit hL hPeriodic hC u
    rw [coulombFourierHamiltonianH2_decomposition sys g H u]
    exact (norm_add_le _ _).trans (by linarith)
  have hWt : ‖W (u - molecularH2Truncate n u)‖ ≤ (1 / 2) * ‖T u‖ + b * ‖S u‖ := by
    have hW := potential_le_half sys L H hKernel Hunit hL hPeriodic hC (u - molecularH2Truncate n u)
    have hT1 : ‖T (u - molecularH2Truncate n u)‖ ≤ ‖T u‖ := by
      rw [map_sub, kinetic_truncate]
      exact norm_sub_truncate_le_self n _
    have hS1 : ‖S (u - molecularH2Truncate n u)‖ ≤ ‖S u‖ := by
      rw [map_sub, stateMap_truncate]
      exact norm_sub_truncate_le_self n _
    have := mul_le_mul_of_nonneg_left hS1 hb
    linarith
  rw [heq]
  refine (norm_sub_le _ _).trans ?_
  have h1 := norm_extractCLM_le n (H u)
  have h2 := norm_extractCLM_le n (W (u - molecularH2Truncate n u))
  linarith

include hKernel hL hPeriodic in
/-- The `H²` norm of the backward discrete flow of `w` is at most
`m̄ (‖w‖ + 2 (2 ‖H_N w‖ + 2b ‖w‖))`, uniformly in time (`eq:testreg`). -/
theorem cubeFlow_h2norm_le (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit) (n : ℕ)
    (UN : ℝ → EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)) ≃ₗᵢ[ℂ]
      EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n)))
    (hNcomm : ∀ t x, UN t (finiteCoulombHamiltonian sys L n x) =
      finiteCoulombHamiltonian sys L n (UN t x))
    (w : EuclideanSpace ℂ (FourierConfig eta (FinitePlaneWaveMode n))) (τ : ℝ) :
    ‖cubeLift (2 * Real.pi / L) n (UN τ w)‖ ≤
      sys.maxMass * (‖w‖ + 2 * (2 * ‖finiteCoulombHamiltonian sys L n w‖ +
        2 * relB sys L Hunit * ‖w‖)) := by
  have hM := sys.one_le_maxMass
