discharged by the molecular Hamiltonian estimates from milestone 123. -/
theorem exists_fourierKernelH2Operator {eta : ℕ} (g : ℝ)
    (kernel : FourierConfig eta Lattice3 → FourierConfig eta Lattice3 → ℂ)
    (C : ℝ) (hC : 0 ≤ C)
    (hCore : ∀ N (u : MolecularFourierH2 eta),
      ∃ v : lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2,
