    (data : FiniteBONuclearData ν) (gamma : ℝ)
    (q p : FourierConfig eta Lattice3) : ℂ :=
  ∑ i : Fin eta, ∑ ell : ν,
    latticeReferenceConfigurationKernel i (latticeElectronNuclearKernel data gamma ell) q p

