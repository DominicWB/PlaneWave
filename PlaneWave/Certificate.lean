            ‖⟪U t Ψ₀, spinLift (mulCLM (regFun a χ)) (U t Ψ₀)⟫_ℂ -
                ⟪ΨN, spinLift (mulCLM (regFun a χ)) ΨN⟫_ℂ‖ ≤
              A.1 * (1 / K) ^ 5 + A.2.1 * t * (1 / K) ^ 3 +
                A.2.2 * (2 * Real.sqrt 3) ^ M * CM M * Real.sqrt (1 / K) ^ 5 * (1 / K) ^ M := by
  obtain ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hcompo, hrest⟩ := thm_dyn_spin sys L hL D
  choose UN hN0 hNadd hNderiv hbound using hrest
  refine ⟨U, h0, hadd, hcont, hgraph, hderiv, huniq, hcompo, UN, hN0, hNadd, hNderiv, ?_⟩
  intro Ψ₀ H₀ H₁ hΨ₀ hH₀ a χ CM hc hreal A M hM n hn hK t ht K ΨN
  obtain ⟨hBlow, hCs, hBker, -⟩ := molecularCanonicalTailConstants_spec L hL
  have hC := finiteCoulombPhysicalMassConstant_nonneg sys L molecularCanonicalUnitHardyConstant
  have hχ2 : Summable fun ν => (1 + (2 * Real.pi / L) ^ 2 * latticeNormSq ν) *
      ‖UnitAddTorus.mFourierCoeff χ ν‖ :=
    summable_weighted_of_decay hc.1 (by positivity) (CM 6) (hc.2 6 (by norm_num))
  refine le_trans (hbound n hn (two_le_of_two_sqrt_three_le hK) Ψ₀ H₀ H₁ hΨ₀ hH₀ a χ hχ2 hreal t
    ht) ?_
  exact obsRateBound_hchi_le sys L hL _ _ _ _ hC hBlow hCs hBker n a hc hM hK (norm_nonneg _)
    (norm_nonneg _) (norm_nonneg _) (norm_nonneg _) t

