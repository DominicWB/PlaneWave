noncomputable section

/-- An increasing exhaustion by finite sets eventually contains every finite
set.  No enumeration of the coefficient index type is needed. -/
theorem finset_subset_of_monotone_exhaustion {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n) (s : Finset ι) :
    ∃ n : ℕ, s ⊆ S n := by
  refine Finset.induction_on s ?_ ?_
  · exact ⟨0, Finset.empty_subset _⟩
  · intro i t _hi ht
    rcases hExhaust i with ⟨n, hn⟩
    rcases ht with ⟨m, hm⟩
    refine ⟨max n m, ?_⟩
    intro j hj
    rcases Finset.mem_insert.mp hj with hij | hjt
    · subst j
      exact (hMono (le_max_left n m)) hn
    · exact (hMono (le_max_right n m)) (hm hjt)

/-- Bounds on an exhaustive sequence of coefficient masses control every
finite partial sum. -/
theorem norm_sq_sum_le_of_exhaustive_sum_bound {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (f : ι → ℂ) (C : ℝ)
    (hBound : ∀ n : ℕ, ∑ i ∈ S n, ‖f i‖ ^ 2 ≤ C ^ 2)
    (s : Finset ι) :
    ∑ i ∈ s, ‖f i‖ ^ 2 ≤ C ^ 2 := by
  rcases finset_subset_of_monotone_exhaustion S hMono hExhaust s with ⟨n, hn⟩
  calc
    (∑ i ∈ s, ‖f i‖ ^ 2) ≤ ∑ i ∈ S n, ‖f i‖ ^ 2 := by
      apply Finset.sum_le_sum_of_subset_of_nonneg hn
      intro i _hi _his
      exact sq_nonneg ‖f i‖
    _ ≤ C ^ 2 := hBound n

/-- A coefficient family with uniformly bounded masses on increasing
exhaustive finite sets is square-summable. -/
theorem memℓp_two_of_exhaustive_sum_bound {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (f : ι → ℂ) (C : ℝ)
    (hBound : ∀ n : ℕ, ∑ i ∈ S n, ‖f i‖ ^ 2 ≤ C ^ 2) :
    Memℓp f 2 := by
  apply memℓp_gen' (C := C ^ 2)
  intro s
  simpa [Real.rpow_two] using
    norm_sq_sum_le_of_exhaustive_sum_bound S hMono hExhaust f C hBound s

/-- Reconstruct a square-summable vector from coefficient data and verified
finite mass bounds.  Its coordinates are the original data definitionally. -/
def lp2OfExhaustiveSumBound {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (f : ι → ℂ) (C : ℝ)
    (hBound : ∀ n : ℕ, ∑ i ∈ S n, ‖f i‖ ^ 2 ≤ C ^ 2) :
    lp (fun _ : ι => ℂ) 2 :=
  ⟨f, memℓp_two_of_exhaustive_sum_bound S hMono hExhaust f C hBound⟩

@[simp] theorem lp2OfExhaustiveSumBound_apply {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (f : ι → ℂ) (C : ℝ)
    (hBound : ∀ n : ℕ, ∑ i ∈ S n, ‖f i‖ ^ 2 ≤ C ^ 2) (i : ι) :
    lp2OfExhaustiveSumBound S hMono hExhaust f C hBound i = f i := rfl

/-- The reconstructed vector retains the uniform finite norm bound. -/
theorem lp2OfExhaustiveSumBound_norm_le {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (f : ι → ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hBound : ∀ n : ℕ, ∑ i ∈ S n, ‖f i‖ ^ 2 ≤ C ^ 2) :
    ‖lp2OfExhaustiveSumBound S hMono hExhaust f C hBound‖ ≤ C := by
  apply lp.norm_le_of_forall_sum_le
    (by norm_num : 0 < (2 : ENNReal).toReal) hC
  intro s
  simpa [Real.rpow_two] using
    norm_sq_sum_le_of_exhaustive_sum_bound S hMono hExhaust f C hBound s

/-- The finite output truncations converge in norm to the reconstructed vector.
This turns compatible finite coefficient data into an actual Hilbert-space
output, rather than merely a family of compressed outputs. -/
theorem lp2OfExhaustiveSumBound_truncation_tendsto
    {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (f : ι → ℂ) (C : ℝ)
    (hBound : ∀ n : ℕ, ∑ i ∈ S n, ‖f i‖ ^ 2 ≤ C ^ 2) :
    Tendsto (fun n => lpTruncate (S n)
      (lp2OfExhaustiveSumBound S hMono hExhaust f C hBound)) atTop
      (𝓝 (lp2OfExhaustiveSumBound S hMono hExhaust f C hBound)) := by
  exact lp_norm_truncation_tendsto S hMono hExhaust _

/-- Bundled form of square-summable reconstruction, including the exact
coordinates, the norm bound, and convergence of finite truncations. -/
theorem exists_lp2_of_exhaustive_sum_bound {ι : Type*} [DecidableEq ι]
    (S : ℕ → Finset ι) (hMono : Monotone S)
    (hExhaust : ∀ i : ι, ∃ n : ℕ, i ∈ S n)
    (f : ι → ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hBound : ∀ n : ℕ, ∑ i ∈ S n, ‖f i‖ ^ 2 ≤ C ^ 2) :
    ∃ u : lp (fun _ : ι => ℂ) 2,
      (∀ i : ι, u i = f i) ∧ ‖u‖ ≤ C ∧
        Tendsto (fun n => lpTruncate (S n) u) atTop (𝓝 u) := by
  refine ⟨lp2OfExhaustiveSumBound S hMono hExhaust f C hBound,
    (fun _ => rfl), ?_, ?_⟩
  · exact lp2OfExhaustiveSumBound_norm_le S hMono hExhaust f C hC hBound
  · exact lp2OfExhaustiveSumBound_truncation_tendsto S hMono hExhaust f C hBound

end

