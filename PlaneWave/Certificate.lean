/-! These are one-dimensional radial integral identities. The passage from a
three-dimensional Fourier integral to these radial integrals is a separate
change-of-variables theorem and is not assumed or asserted here. -/

/-- An antiderivative of the sine transform of a quadratic radial taper. -/
def quadraticRadialSinePrimitive (R k x : ℝ) : ℝ :=
  -((1 - x / R) ^ 2 * Real.cos (k * x)) / k -
    2 * ((1 - x / R) * Real.sin (k * x)) / (R * k ^ 2) +
    2 * Real.cos (k * x) / (R ^ 2 * k ^ 3)

/-- The cancellation in the radial sine transform is established by differentiating
an explicit primitive, rather than by an asymptotic estimate. -/
theorem hasDerivAt_quadraticRadialSinePrimitive
    (R k x : ℝ) (hR : R ≠ 0) (hk : k ≠ 0) :
    HasDerivAt (quadraticRadialSinePrimitive R k)
      ((1 - x / R) ^ 2 * Real.sin (k * x)) x := by
  have hLinear : HasDerivAt (fun y : ℝ => 1 - y / R) (-1 / R) x := by
    exact ((hasDerivAt_const x (1 : ℝ)).sub
      ((hasDerivAt_id x).div_const R)).congr_deriv (by ring)
  have hFrequency : HasDerivAt (fun y : ℝ => k * y) k x :=
    hasDerivAt_const_mul k
  have hFirst := ((hLinear.pow 2).mul hFrequency.cos).neg.div_const k
  have hSecond := (HasDerivAt.const_mul (2 : ℝ)
    (hLinear.mul hFrequency.sin)).div_const (R * k ^ 2)
  have hThird := (HasDerivAt.const_mul (2 : ℝ)
    hFrequency.cos).div_const (R ^ 2 * k ^ 3)
  unfold quadraticRadialSinePrimitive
  refine ((hFirst.sub hSecond).add hThird).congr_deriv ?_
  dsimp
  norm_num
  field_simp [hR, hk]
  ring

