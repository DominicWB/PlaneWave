/-! ## The observable split `eq:obs-split` -/

section Split

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- `⟪ψ, O ψ⟫ - ⟪ψ_N, O ψ_N⟫ = 2 Re ⟪e, O ψ⟫ - ⟪e, O e⟫` for a symmetric `O` and `e = ψ - ψ_N`,
with `e = δ + η` expanded and every term estimated by its absolute value. -/
lemma obs_split_le (O : E →L[ℂ] E) (hO : ∀ x y, ⟪O x, y⟫_ℂ = ⟪x, O y⟫_ℂ) (ψ ψN δ η : E)
    (he : ψ - ψN = δ + η) :
    ‖⟪ψ, O ψ⟫_ℂ - ⟪ψN, O ψN⟫_ℂ‖ ≤
      2 * (‖⟪δ, O ψ⟫_ℂ‖ + ‖⟪η, O ψ⟫_ℂ‖) +
        (‖⟪δ, O δ⟫_ℂ‖ + ‖⟪δ, O η⟫_ℂ‖ + ‖⟪η, O δ⟫_ℂ‖ + ‖⟪η, O η⟫_ℂ‖) := by
  have hN : ψN = ψ - (δ + η) := by rw [← he]; abel
  set e := δ + η
  have hexp : ⟪ψ, O ψ⟫_ℂ - ⟪ψN, O ψN⟫_ℂ = ⟪ψ, O e⟫_ℂ + ⟪e, O ψ⟫_ℂ - ⟪e, O e⟫_ℂ := by
    rw [hN, map_sub, inner_sub_left, inner_sub_right, inner_sub_right]
    ring
  have h1 : ‖⟪ψ, O e⟫_ℂ‖ = ‖⟪e, O ψ⟫_ℂ‖ := by
    rw [← hO, ← inner_conj_symm, RCLike.norm_conj]
  have h2 : ‖⟪e, O ψ⟫_ℂ‖ ≤ ‖⟪δ, O ψ⟫_ℂ‖ + ‖⟪η, O ψ⟫_ℂ‖ := by
    rw [inner_add_left]
    exact norm_add_le _ _
  have h3 : ‖⟪e, O e⟫_ℂ‖ ≤ ‖⟪δ, O δ⟫_ℂ‖ + ‖⟪δ, O η⟫_ℂ‖ + ‖⟪η, O δ⟫_ℂ‖ + ‖⟪η, O η⟫_ℂ‖ := by
    rw [map_add, inner_add_left, inner_add_right, inner_add_right]
    refine (norm_add_le _ _).trans ?_
    have := norm_add_le ⟪δ, O δ⟫_ℂ ⟪δ, O η⟫_ℂ
    have := norm_add_le ⟪η, O δ⟫_ℂ ⟪η, O η⟫_ℂ
    linarith
  rw [hexp]
  refine (norm_sub_le _ _).trans ?_
  have h4 := norm_add_le ⟪ψ, O e⟫_ℂ ⟪e, O ψ⟫_ℂ
  rw [h1] at h4
  linarith

/-- The arithmetic of the rates: with `ρ² K = 1` and `K ≥ 2`, the explicit bound of
