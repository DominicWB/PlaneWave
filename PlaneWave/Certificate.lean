/-! ## Real coordinate differentiation -/

namespace PlaneWaveCertificate

noncomputable section

attribute [local instance] Classical.propDecidable

/-- The ordinary real Fréchet derivative in a single coordinate direction.
This definition contains no Fourier data. -/
def coordinateRealDerivative {d : Type*} [Fintype d]
    (F : (d → ℝ) → ℂ) (a : d) (x : d → ℝ) : ℂ :=
  fderiv ℝ F x (Pi.single a 1)

/-- Restriction to a real coordinate line obeys the usual chain rule. -/
theorem coordinateRealDerivative_hasDerivAt {d : Type*} [Fintype d]
    {F : (d → ℝ) → ℂ} (hF : Differentiable ℝ F)
    (x : d → ℝ) (a : d) (t : ℝ) :
    HasDerivAt (fun r : ℝ => F (x + r • Pi.single a 1))
      (coordinateRealDerivative F a (x + t • Pi.single a 1)) t := by
  have hline :=
    ((hasDerivAt_id t).smul_const (Pi.single a (1 : ℝ) : d → ℝ)).const_add x
  rw [one_smul] at hline
  exact (hF (x + t • Pi.single a 1)).hasFDerivAt.comp_hasDerivAt t hline

/-- The coordinate derivative equals the univariate derivative at line parameter zero. -/
theorem coordinateRealDerivative_eq_deriv {d : Type*} [Fintype d]
    {F : (d → ℝ) → ℂ} (hF : Differentiable ℝ F)
    (a : d) (x : d → ℝ) :
    coordinateRealDerivative F a x =
      deriv (fun t : ℝ => F (x + t • Pi.single a 1)) 0 := by
  simpa only [zero_smul, add_zero] using
    (coordinateRealDerivative_hasDerivAt hF x a 0).deriv.symm

/-- A coordinate derivative of a `C²` real lift is `C¹`. -/
theorem contDiff_coordinateRealDerivative {d : Type*} [Fintype d]
    {F : (d → ℝ) → ℂ} (hF : ContDiff ℝ 2 F) (a : d) :
    ContDiff ℝ 1 (coordinateRealDerivative F a) := by
  exact (hF.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const

/-- A coordinate derivative of a `C¹` real lift is continuous. -/
theorem continuous_coordinateRealDerivative {d : Type*} [Fintype d]
    {F : (d → ℝ) → ℂ} (hF : ContDiff ℝ 1 F) (a : d) :
    Continuous (coordinateRealDerivative F a) := by
  have hd : ContDiff ℝ 0 (coordinateRealDerivative F a) :=
    (hF.fderiv_right (m := 0) (by norm_num)).clm_apply contDiff_const
  exact hd.continuous

