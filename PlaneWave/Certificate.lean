/-- On the tail of register `a` beyond `K`, the kinetic energy is at least `K²/(2 m̄)`. -/
lemma kin_ge_of_tail {K : ℝ} (hK : 0 ≤ K) (a : Fin eta) {p : FourierConfig eta Lattice3}
    (hp : K < (2 * Real.pi / L) * Real.sqrt (latticeNormSq (p a))) :
    K ^ 2 / (2 * sys.maxMass) ≤ coulombKineticEnergySymbol sys (2 * Real.pi / L) p := by
  set g := 2 * Real.pi / L
  have hM := sys.one_le_maxMass
  have hma := sys.mass_pos a
  have hmle := sys.mass_le_maxMass a
  have hlat := latticeNormSq_nonneg (p a)
  have hsq : K ^ 2 ≤ g ^ 2 * latticeNormSq (p a) := by
    have h1 : K ^ 2 ≤ (g * Real.sqrt (latticeNormSq (p a))) ^ 2 :=
      pow_le_pow_left₀ hK hp.le 2
    rwa [mul_pow, Real.sq_sqrt hlat] at h1
  have hterm : g ^ 2 * latticeNormSq (p a) / sys.maxMass ≤ g ^ 2 * latticeNormSq
      (p a) / sys.mass a :=
    div_le_div_of_nonneg_left (mul_nonneg (sq_nonneg g) hlat) hma hmle
  have hsum : g ^ 2 * latticeNormSq (p a) / sys.mass a ≤
      ∑ i : Fin eta, g ^ 2 * latticeNormSq (p i) / sys.mass i :=
    Finset.single_le_sum (f := fun i => g ^ 2 * latticeNormSq (p i) / sys.mass i)
      (fun i _ => div_nonneg (mul_nonneg (sq_nonneg g) (latticeNormSq_nonneg (p i)))
        (sys.mass_pos i).le) (Finset.mem_univ a)
  unfold coulombKineticEnergySymbol
  have h3 : K ^ 2 / sys.maxMass ≤ g ^ 2 * latticeNormSq (p a) / sys.maxMass :=
    div_le_div_of_nonneg_right hsq (by linarith)
  rw [div_mul_eq_div_div_swap]
  linarith

omit [Fintype ν] in
/-- **A priori tail.** `‖1_{a,>K} S u‖ ≤ (2 m̄ / K²) ‖1_{a,>K} T u‖`. -/
lemma tail_stateMap_le {K : ℝ} (hK : 0 < K) (a : Fin eta) (u : MolecularFourierH2 eta) :
    ‖tailMask (2 * Real.pi / L) K a (molecularH2StateMap eta (2 * Real.pi / L) u)‖ ≤
      (2 * sys.maxMass / K ^ 2) *
        ‖tailMask (2 * Real.pi / L) K a (coulombFourierKineticH2 sys (2 * Real.pi / L) u)‖ := by
  have hM := sys.one_le_maxMass
  refine l2_norm_le_of_le _ _ (by positivity) (fun p => ?_)
  rw [tailMask_apply, tailMask_apply, molecularH2StateMap_apply, coulombFourierKineticH2_apply]
  split_ifs with hp
  · have hkin := kin_ge_of_tail sys L hK.le a hp
    have hk0 := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
    rw [one_mul, one_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hk0,
      ← mul_assoc]
    have h1 : 1 ≤ 2 * sys.maxMass / K ^ 2 * coulombKineticEnergySymbol sys (2 * Real.pi / L) p := by
      rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
      rw [div_le_iff₀ (by positivity)] at hkin
      linarith
    have hc := norm_nonneg (molecularH2Coeff (2 * Real.pi / L) u p)
    nlinarith
  · simp

variable (H : MolecularFourierH2 eta →L[ℂ] lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
  (hKernel : ∀ N u q, H (molecularH2Truncate N u) q =
    fourierCubeKernelAction (2 * Real.pi / L) (coulombLatticeHamiltonianKernel sys L) N u q)
  (Hunit : ℝ) (hL : 0 < L) (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit)

include hKernel hL hPeriodic in
/-- **Kinetic tail** (`eq:dyn-wtail`, kinetic part). If `H u = S v` (the state is in `D(H²)`),
then `‖1_{a,>K} T u‖ ≤ (2 m̄/K²) ‖T v‖ + C_tail(M₂) K^{-1/2}` for `‖u‖ ≤ M₂`. -/
theorem tail_kinetic_le (a : Fin eta) (K rho Blow Cs Bker M2 : ℝ) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker) (hM2 : 0 ≤ M2)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u v : MolecularFourierH2 eta) (hu : ‖u‖ ≤ M2)
    (huv : H u = molecularH2StateMap eta (2 * Real.pi / L) v) :
    ‖tailMask (2 * Real.pi / L) K a (coulombFourierKineticH2 sys (2 * Real.pi / L) u)‖ ≤
      (2 * sys.maxMass / K ^ 2) * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) v‖ +
        finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker M2 * rho := by
  set g := 2 * Real.pi / L
  have hK : 0 < K := by linarith
  have hdec : coulombFourierKineticH2 sys g u = H u - coulombFourierPotentialH2 sys g H u := by
    rw [coulombFourierHamiltonianH2_decomposition sys g H u]
    abel
  have hW := potential_tail_le sys L H hKernel Hunit hL hPeriodic a K rho Blow Cs Bker M2 hK1 hRho
    hRhoScale hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale u hu
  have hHv : ‖tailMask g K a (H u)‖ ≤ (2 * sys.maxMass / K ^ 2) *
      ‖coulombFourierKineticH2 sys g v‖ := by
    rw [huv]
    refine (tail_stateMap_le sys L hK a v).trans ?_
    have hM := sys.one_le_maxMass
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    have := (tailMask g K a).le_opNorm (coulombFourierKineticH2 sys g v)
    have hnorm : ‖tailMask g K a‖ ≤ 1 := ContinuousLinearMap.opNorm_le_bound _ zero_le_one
      (fun x => l2_norm_le_of_le _ x zero_le_one (fun p => by
        rw [tailMask_apply]
        split_ifs <;> simp))
    nlinarith [norm_nonneg (coulombFourierKineticH2 sys g v), norm_nonneg (tailMask g K a)]
  rw [hdec, map_sub]
  exact (norm_sub_le _ _).trans (add_le_add hHv hW)

omit [Fintype ν] in
/-- The `H²` norm is controlled by the kinetic energy: `‖u‖ ≤ m̄ (‖S u‖ + 2 ‖T u‖)`. -/
lemma h2norm_le (u : MolecularFourierH2 eta) :
    ‖u‖ ≤ sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u‖ +
      2 * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖) := by
  have hM := sys.one_le_maxMass
  have h := l2_norm_le_of_le u (molecularH2StateMap eta (2 * Real.pi / L) u +
    (2 : ℂ) • coulombFourierKineticH2 sys (2 * Real.pi / L) u) (by positivity) (fun p => by
      rw [lp.coeFn_add, lp.coeFn_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        molecularH2StateMap_apply, coulombFourierKineticH2_apply]
      have hk0 := coulombKineticEnergySymbol_nonneg sys (2 * Real.pi / L) p
      have hw := molecularFourierH2Weight_pos eta (2 * Real.pi / L) p
      have hwm := molecularFourierH2Weight_le_maxMass_mul sys (2 * Real.pi / L) p
      have he : molecularH2Coeff (2 * Real.pi / L) u p +
          2 * ((coulombKineticEnergySymbol sys (2 * Real.pi / L) p : ℂ) *
            molecularH2Coeff (2 * Real.pi / L) u p) =
          ((1 + 2 * coulombKineticEnergySymbol sys (2 * Real.pi / L) p : ℝ) : ℂ) *
            molecularH2Coeff (2 * Real.pi / L) u p := by
        push_cast
        ring
      rw [he, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith),
        ← molecularH2Coeff_weight_mul (2 * Real.pi / L) u p, norm_mul, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg hw.le, ← mul_assoc]
      exact mul_le_mul_of_nonneg_right hwm (norm_nonneg _))
  refine h.trans (mul_le_mul_of_nonneg_left ?_ (by linarith))
  refine (norm_add_le _ _).trans ?_
  rw [norm_smul]
  norm_num

include hKernel hL hPeriodic in
/-- **Time-uniform tails** (`eq:dyn-t`). For `ψ₀ = S u₀` in `D(H²)` (`H u₀ = S v₀`), the tail of
`ψ(t) = U t ψ₀` in register `a` beyond `K` is at most
`(2m̄/K²) ((2m̄/K²) Ξ₁ + C_tail(M₂) K^{-1/2})` for all `t`, with
`Ξ₁ = 2 ‖H v₀‖ + 2b ‖S v₀‖` and `M₂ = m̄ (‖S u₀‖ + 2 (2 ‖H u₀‖ + 2b ‖S u₀‖))`. -/
theorem tail_propagated (hC : 0 ≤ finiteCoulombPhysicalMassConstant sys L Hunit)
    (U : ℝ → lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2 ≃ₗᵢ[ℂ]
      lp (fun _ : FourierConfig eta Lattice3 => ℂ) 2)
    (hgraph : ∀ t u, ∃ u' : MolecularFourierH2 eta,
      molecularH2StateMap eta (2 * Real.pi / L) u' =
        U t (molecularH2StateMap eta (2 * Real.pi / L) u) ∧ H u' = U t (H u))
    (a : Fin eta) (K rho Blow Cs Bker : ℝ) (hK1 : 1 ≤ K)
    (hRho : 0 ≤ rho) (hRhoScale : rho ^ 2 * K = 1)
    (hBlow : 0 ≤ Blow) (hCs : 0 ≤ Cs) (hBker : 0 ≤ Bker)
    (h2gK : 2 * (2 * Real.pi / L) ≤ K)
    (hAmplitude : 54 * Real.sqrt ((coulombCellAmplitude L) ^ 2) ≤ Blow * (2 * Real.pi / L))
    (hBkerScale : 432 * (coulombCellAmplitude L) ^ 2 * (2 * Real.pi / L) ≤ Bker ^ 2)
    (hCsScale : 1 + 108 / (2 * Real.pi / L) ^ 4 ≤ Cs ^ 2)
    (u₀ v₀ : MolecularFourierH2 eta) (huv : H u₀ = molecularH2StateMap eta (2 * Real.pi / L) v₀)
    (t : ℝ) :
    ‖tailMask (2 * Real.pi / L) K a (U t (molecularH2StateMap eta (2 * Real.pi / L) u₀))‖ ≤
      (2 * sys.maxMass / K ^ 2) *
        ((2 * sys.maxMass / K ^ 2) * (2 * ‖H v₀‖ + 2 * relB sys L Hunit *
            ‖molecularH2StateMap eta (2 * Real.pi / L) v₀‖) +
          finiteCoulombPhysicalTailConstant sys L Hunit Blow Cs Bker
            (sys.maxMass * (‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖ +
              2 * (2 * ‖H u₀‖ + 2 * relB sys L Hunit *
                ‖molecularH2StateMap eta (2 * Real.pi / L) u₀‖))) * rho) := by
  set g := 2 * Real.pi / L
  set S := molecularH2StateMap eta g
  set T := coulombFourierKineticH2 sys g
  set b := relB sys L Hunit
  have hM := sys.one_le_maxMass
  have hK : 0 < K := by linarith
  have hb := relB_nonneg sys L Hunit hC
  obtain ⟨u, hu1, hu2⟩ := hgraph t u₀
  obtain ⟨v, hv1, hv2⟩ := hgraph t v₀
  have huv' : H u = S v := by rw [hu2, huv, hv1]
  -- the elliptic estimates along the flow
  have hTu : ‖T u‖ ≤ 2 * ‖H u₀‖ + 2 * b * ‖S u₀‖ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC u
    rwa [hu1, hu2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
  have hTv : ‖T v‖ ≤ 2 * ‖H v₀‖ + 2 * b * ‖S v₀‖ := by
    have h := kinetic_le_elliptic sys L H hKernel Hunit hL hPeriodic hC v
    rwa [hv1, hv2, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map] at h
  have hu_le : ‖u‖ ≤ sys.maxMass * (‖S u₀‖ + 2 * (2 * ‖H u₀‖ + 2 * b * ‖S u₀‖)) := by
    have h := h2norm_le sys L u
    rw [hu1, LinearIsometryEquiv.norm_map] at h
    refine h.trans (mul_le_mul_of_nonneg_left ?_ (by linarith))
    linarith
  set M2 := sys.maxMass * (‖S u₀‖ + 2 * (2 * ‖H u₀‖ + 2 * b * ‖S u₀‖))
  have hM2 : 0 ≤ M2 := (norm_nonneg u).trans hu_le
  have hkin := tail_kinetic_le sys L H hKernel Hunit hL hPeriodic a K rho Blow Cs Bker M2 hK1 hRho
    hRhoScale hBlow hCs hBker hM2 h2gK hAmplitude hBkerScale hCsScale u v hu_le huv'
  have hstate := tail_stateMap_le sys L hK a u
  rw [hu1] at hstate
  refine hstate.trans (mul_le_mul_of_nonneg_left (hkin.trans ?_) (by positivity))
  gcongr

end Bootstrap

