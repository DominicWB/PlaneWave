/-! ## Ordinary derivatives along position coordinate lines -/

namespace PlaneWaveCertificate

open scoped BigOperators

noncomputable section

/-- Move one coordinate through the quotient map from the real line to the unit
circle. This is an actual position-space path, independent of Fourier analysis. -/
def torusCoordinateLine {d : Type*} [Fintype d]
    (x : UnitAddTorus d) (a : d) (t : ℝ) : UnitAddTorus d := by
  classical
  exact fun b => x b + if b = a then (t : UnitAddCircle) else 0

@[simp]
lemma torusCoordinateLine_zero {d : Type*} [Fintype d]
    (x : UnitAddTorus d) (a : d) : torusCoordinateLine x a 0 = x := by
  classical
  funext b
  simp [torusCoordinateLine]

lemma fourier_add_argument (n : ℤ) (x y : UnitAddCircle) :
    fourier n (x + y) = fourier n x * fourier n y := by
  simp only [fourier_apply, smul_add, AddCircle.toCircle_add, Circle.coe_mul]

/-- Restricting a multivariate plane wave to a coordinate line leaves one
ordinary one-dimensional Fourier character. -/
lemma mFourier_coordinateLine {d : Type*} [Fintype d]
    (n : d → ℤ) (x : UnitAddTorus d) (a : d) (t : ℝ) :
    UnitAddTorus.mFourier n (torusCoordinateLine x a t) =
      UnitAddTorus.mFourier n x * fourier (n a) (t : UnitAddCircle) := by
  classical
  change (∏ b, fourier (n b) (x b + if b = a then (t : UnitAddCircle) else 0)) =
    (∏ b, fourier (n b) (x b)) * fourier (n a) (t : UnitAddCircle)
  simp_rw [fourier_add_argument]
  rw [Finset.prod_mul_distrib]
  congr 1
  rw [Finset.prod_eq_single a]
  · simp
  · intro b _hb hba
    rw [if_neg hba, fourier_eval_zero]
  · intro ha
    exact (ha (Finset.mem_univ a)).elim

/-- The first derivative along a genuine torus coordinate line. -/
lemma mFourier_hasDerivAt_coordinateLine {d : Type*} [Fintype d]
    (n : d → ℤ) (x : UnitAddTorus d) (a : d) (t : ℝ) :
    HasDerivAt (fun r : ℝ => UnitAddTorus.mFourier n (torusCoordinateLine x a r))
      ((2 * (Real.pi : ℂ) * Complex.I * (n a : ℂ)) *
        UnitAddTorus.mFourier n (torusCoordinateLine x a t)) t := by
  simp_rw [mFourier_coordinateLine]
  simpa [mul_left_comm] using
    (hasDerivAt_fourier 1 (n a) t).const_mul (UnitAddTorus.mFourier n x)

end

end PlaneWaveCertificate

/-! ## Completed kinetic operator and signed potential residual -/

namespace PlaneWaveCertificate

