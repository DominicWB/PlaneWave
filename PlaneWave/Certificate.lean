  exact le_of_tendsto_of_tendsto' hL1 hR1 hN

include hKernel in
/-- The relative bound with constant `1/4` in front of `‖T u‖²`. -/
theorem potential_sq_le_quarter (Hunit : ℝ) (hL : 0 < L)
    (hPeriodic : HasCanonicalPeriodicCoulombHardyBound Hunit) (u : MolecularFourierH2 eta) :
    ‖coulombFourierPotentialH2 sys (2 * Real.pi / L) H u‖ ^ 2 ≤
      (1 / 4) * ‖coulombFourierKineticH2 sys (2 * Real.pi / L) u‖ ^ 2 +
        finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 *
          (4 * finiteCoulombPhysicalMassConstant sys L Hunit ^ 2 + 2) *
